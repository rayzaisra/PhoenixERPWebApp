<link href="~/vendors/custom/query-builder/css/query-builder.default.css?@DateTime.Now" rel="stylesheet" />

<input hidden name="entity_id" value="@ViewBag.EntityId" />

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Approval Request-<strong>Journal Entry</strong></h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Approval</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="@Url.Content("~/ApprovalFinance/List")" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Journal Entry</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="m-portlet">
                <div class="m-portlet__body" id="m_blockui_list">
                    <div class="row m-row--col-separator-xl">
                        <div class="col-lg-12">
                            <hr />
                            <div class="col-lg-12 row">
                                <div id="builder" style="width:100%"></div>
                            </div>
                            <div class="col-lg-12 row">
                                <button id="btn-view" type="button" class="btn btn-sm btn-primary">Find</button>
                                <button id="btn-reset" type="button" class="btn btn-sm btn-info">Reset</button>
                            </div>
                            <hr />
                        </div>
                        <div class="col-lg-12" style="padding-top:20px">
                            <table class="m-timeline-approval-table" id="dt_basic">
                                <thead>
                                    <tr style="bottom:5px">
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody class="m-timeline-2__items"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/vendors/custom/datatables/datatables.bundle.js"></script>
    <script src="~/vendors/custom/query-builder/js/doT.min.js"></script>
    <script src="~/vendors/custom/query-builder/js/jQuery.extendext.js"></script>
    <script src="~/vendors/custom/query-builder/src/interact.min.js"></script>
    <script src="~/vendors/custom/query-builder/src/query-builder.standalone.js?@DateTime.Now" asp-append-version="true"></script>
    <script src="~/scripts/query-builder-entity/Finance/vw_approval_financial_transaction.js?@DateTime.Now" asp-append-version="true"></script>


    @*    <script src="~/Areas/Core/Scripts/Approval.Details.js?@DateTime.Now" asp-append-version="true"></script>*@
    <script>
        (function ($) {
            'use strict';
            var dt_basic = $('#dt_basic');
            var ListChecked = [];
            var ListNotChecked = [];

            var $entityId = $('input[name="entity_id"]');
            var $qbuilder = $('#builder');

            var pageFunction = function () {


                $qbuilder.queryBuilder({
                    "filters": $.helper.querybuilder.vw_approval_financial_transaction.filterSettings(),
                    "plugins": []
                });

                var options2 = {
                    pageLength: 5,
                    queryBuilder: {
                        active: true,
                        target: $('#builder')
                    },
                    url: $.helper.resolveApi('~/approval/finance/JournalEntry/Requested/listdatatables'),
                    keys: {
                        rowId: "id",
                        recordId: "record_id"
                    },
                    viewGroup: function (buildView) {
                        return $(buildView).attr('transaction_number') + "</br>" + moment($(buildView).attr('transaction_datetime')).format('DD-MMM-YYYY');
                    },
                    attributte: ["transaction_datetime", "transaction_number"],
                    onApprove: function (approvalId) {
                        
                        $.ajax({
                            type: "POST",
                            contentType: "application/json; charset=utf-8",
                            url: $.helper.resolveApi("~/core/Approval/SetApprovalStatus/" + approvalId + "?ApprovalStatus=APPROVED"),
                            success: function (result) {
                                $.helper.Approval.build(dt_basic, options2);
                            },
                            error: function () {
                                alert('err');

                                //BootstrapDialog.alert({ message: "Ajax failed", type: BootstrapDialog.TYPE_DANGER });
                            }
                        });
                    },
                    onReject: function (approvalId) {
                        alert('re : ' + approvalId);
                    }
                }      

                //BEGIN::EVENT BUTTON
                $('#btn-view').click(function () {
                    $.helper.Approval.build(dt_basic, options2);
                });

                //END::EVENT BUTTON


                return {
                    init: function () {
                        //initialize
                        $.helper.Approval.build(dt_basic, options2);
                    }
                };
            }();


            $("#m_datepicker_5").datepicker({
                rtl: mUtil.isRTL(),
                todayHighlight: !0,
                templates: {
                    leftArrow: '<i class="la la-angle-left"></i>',
                    rightArrow: '<i class="la la-angle-right"></i>'
                }
            });
            $(document).ready(function () {
                pageFunction.init();
            });
        }(jQuery));

    </script>
}
