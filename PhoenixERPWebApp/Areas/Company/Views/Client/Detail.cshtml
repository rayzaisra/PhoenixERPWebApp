<!-- Begin:: Bank Dynamic -->
<div class="row bank" style="display: none;">
    <div class="col-lg-12 row">
        <input hidden name="company_bank.id[%index%]" />
        <!-- Begin: Input Bank-->
        <div class="col-lg-4 m-form__group-sub">
            <div class="form-group">
                <label>Bank :</label>
                <select id="bank[%index%]" name="company_bank.bank_id[%index%]" class="form-control form-control-sm m-input m--margin-bottom-30 bank-lookup"></select>
            </div>
        </div>
        <!-- End: Input Bank-->
        <!-- Begin: Input Account-->
        <div class="col-lg-4 m-form__group-sub">
            <div class="form-group">
                <label>Account :</label>
                <input id="account[%index%]" name="company_bank.account_number[%index%]" type="text" class="form-control m--margin-bottom-30 form-control-sm m-input"
                       placeholder="Enter Account">
            </div>
        </div>
        <!-- End: Input Account-->
        <!-- Begin: Input Currency-->
        <div class="col-lg-3 m-form__group-sub">
            <div class="form-group">
                <label>Currency :</label>
                <select id="currency_id[%index%]" name="company_bank.currency_id[%index%]" class="form-control form-control-sm m-input m--margin-bottom-30 currency-lookup"></select>
            </div>
        </div>
        <!-- End: Input Currency-->
        <div class="col-lg-1 m-form__group-sub">
            <div class="form-group">
                <label></label>
                <button data-index="%index%" type="button" class="btn-sm btn btn-danger m-btn m-btn--icon removeit" style="margin-top:5px">
                    <span>
                        <i class="la la-trash-o"></i>
                        <span>Delete</span>
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>
<!-- End:: Bank Dynamic-->
<!-- Begin:: Contact Person Dynamic-->
<div class="row contact-person" style="display: none;">
    <div class="col-lg-12 row">
        <input hidden name="company_contact.id[%index%]" />
