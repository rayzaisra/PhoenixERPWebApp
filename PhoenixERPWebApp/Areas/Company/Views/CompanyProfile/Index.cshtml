<!-- Begin:: Contact Person Dynamic -->
<div class="row contact-person" style="display: none;">
    <input hidden name="company_contact.id[%index%]" />
    <!-- Begin: Name -->
    <div class="col-lg-3 m-form__group-sub">
        <div class="form-group">
            <label>Name :</label>
            <input id="name[%index%]" name="company_contact.contact_name[%index%]" type="text" class="form-control m--margin-bottom-30 form-control-sm m-input"
                   placeholder="Enter Name">
        </div>
    </div>
    <!-- End: Name -->
    <!-- Begin: Title -->


    <div class="col-lg-3 m-form__group-sub">
        <div class="form-group">
            <label>Title :</label>
            <select id="salutation_id[%index%]" name="company_contact.salutation_id[%index%]" class="form-control form-control-sm m-input m--margin-bottom-30 salutation-lookup"></select>
        </div>
    </div>
    <!-- End: Title -->
    <!-- Begin: Phone -->
    <div class="col-lg-3 m-form__group-sub">
        <div class="form-group">
            <label>Phone :</label>
            <input name="company_contact.phone[%index%]" type="text" class="form-control m--margin-bottom-30 form-control-sm m-input"
                   placeholder="Enter Phone">
        </div>
    </div>
    <!-- End: Phone -->
    <!-- Begin: Email -->
    <div class="col-lg-3 m-form__group-sub">
        <div class="form-group">
            <label>Email :</label>
            <input name="company_contact.email[%index%]" type="email" class="form-control m--margin-bottom-30 form-control-sm m-input"
                   placeholder="Enter Email">
        </div>
    </div>
    <!-- End: Email -->
    <!-- Begin: Position Title -->
    <div class="col-lg-3 m-form__group-sub">
        <div class="form-group">
            <label>Position Title :</label>
            <input name="company_contact.position_title[%index%]" type="text" class="form-control m--margin-bottom-30 form-control-sm m-input"
                   placeholder="Enter Position Title">
        </div>
    </div>
    <!-- End: Position Title -->
    <div class="col-lg-3 m-form__group-sub">
        <div class="form-group">
            <label>&nbsp;</label>
            <button data-index="%index%" type="button" class="btn btn-danger btn-sm m-btn m-btn--icon btn-remove-bank m--margin-top-25">
                <span>
                    <i class="la la-save"></i>
                    <span>Remove</span>
                </span>
            </button>
        </div>
    </div>
</div>
<!-- End:: Contact Person Dynamic -->
<!-- Begin:: Bank Dynamic -->
