@{
    ViewData["Title"] = "Job Card";
}


<link href="~/bundles/css/datatable.min.css" rel="stylesheet" />

<input hidden id="detail-id" value="@ViewBag.RecordID" />

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Job Card</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-file-invoice-dollar"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance View</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="@Url.Content("~/Company/JobCard")" class="m-nav__link">
                        <span class="m-nav__link-text">Job Card</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

<div class="m-content">
    <div class="row">
        <div class="col-xl-12 col-lg-12">
            <div class="m-portlet">
                <div class="m-portlet__body">
                    <form id="form-client" class="m-form m-form--fit m-form--label-align-right m-form--group-seperator-dashed">
                        <div class="m-form__group-sub m--margin-bottom-30">
                            <h3>PT. Daya Maha Berkarya</h3>
                            Gd. oleos 1 Jl. Mampang Prapatan Raya No.139 4th Floor Jakarta Selatan
                        </div>
                        <input hidden name="id" value="" />

                        <div class="row">
                            <!-- Begin: Input Date -->
                            <div class="col-lg-3 m-form__group-sub">
                                <label class="form-control-label">Date :</label>
                                <div class="input-group input-group-sm date">
                                    <input type="text" class="form-control m--margin-bottom-30 form-control-sm m-input" readonly="" placeholder="Select Date" id="m_datepicker_2">
                                    <div class="input-group-append">
                                        <span class="input-group-text">
                                            <i class="la la-calendar"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <!-- End: Input Date -->
                            <!-- Begin: Input Job Started -->
                            <div class="col-lg-3 m-form__group-sub">
                                <label class="form-control-label">Job Started :</label>
                                <div class="input-group input-group-sm date">
                                    <input type="text" class="form-control m--margin-bottom-30 form-control-sm m-input" readonly="" placeholder="Select Date" id="m_datepicker_2">
                                    <div class="input-group-append">
                                        <span class="input-group-text">
                                            <i class="la la-calendar"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <!-- End: Input Job Started -->
                            <!-- Begin: Attn-->
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label class="">Attn :</label>
                                    <input type="text" id="attn" name="attn" class="form-control m--margin-bottom-30 form-control-sm m-input"
                                           placeholder="Enter Attn">
                                </div>
                            </div>
                            <!-- End: Attend -->
                            <!-- Begin: Job Number -->
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label class="">Job Number :</label>
                                    <input type="text" id="job_number" name="job_number" class="form-control m--margin-bottom-30 form-control-sm m-input"
                                           placeholder="Enter Job Number">
                                </div>
                            </div>
                            <!-- End: Job Number -->
                        </div>

                        <div class="row">
                            <!-- Begin: Current Status -->
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label>Current Status :</label>
                                    <input id="current_status" name="current_status" type="text" class="form-control m--margin-bottom-30 form-control-sm m-input"
                                           placeholder="Enter Current Status">
                                </div>
                            </div>
                            <!-- End: Current Status -->
                            <!-- Begin: Product -->
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label>Product :</label>
                                    <input id="product" name="product" type="text" class="form-control m--margin-bottom-30 form-control-sm m-input"
                                           placeholder="Enter Product">
                                </div>
                            </div>
                            <!-- End: Product-->
                            <!-- Begin: Aging up to day -->
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label>Aging Up To Day :</label>
                                    <input id="aging_up_to_day" name="aging_up_to_day" type="text" class="form-control m--margin-bottom-30 form-control-sm m-input"
                                           placeholder="Enter Aging Up To Day">
                                </div>
                            </div>
                            <!-- End: Aging up to day -->
                            <!-- Begin: Currency -->
                            <div class="col-lg-3 m-form__group-sub">
                                <label>Currency</label>
                                <div class="input-group input-group-sm ">
                                    <div class="input-group-prepend">
                                        <button type="button" class="btn btn-secondary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            Rp
                                        </button>
                                        <div class="dropdown-menu" x-placement="bottom-start" style="position: absolute; will-change: transform; top: 0px; left: 0px; transform: translate3d(0px, 40px, 0px);">
                                            <a class="dropdown-item" href="#">Dollars</a>
                                        </div>
                                    </div>
                                    <input type="text" class="form-control" aria-label="Text input with dropdown button">
                                </div>
                            </div>
                            <!-- End: Currency -->
                        </div>

                        <div class="row">
                            <div class="col-lg-6 m-form__group-sub">
                                <div class="form-group">
                                    <label>Client :</label>
                                    <textarea class="form-control m--margin-bottom-30 m-input" id="exampleTextarea" rows="5"
                                              placeholder="Enter Client"></textarea>
                                </div>
                            </div>
                            <div class="col-lg-6 m-form__group-sub">
                                <div class="form-group">
                                    <label>Job Title :</label>
                                    <textarea class="form-control m--margin-bottom-30 m-input" id="exampleTextarea" rows="5"
                                              placeholder="Enter Job Title"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="m-portlet__body m--margin-bottom-30" id="m_blockui_list">
                            <!--begin: Datatable -->

                            <table class="table table-striped- table-bordered table-hover table-checkable" id="dt_basic">
                                <thead>
                                    <tr>
                                        <th>Description</th>
                                        <th>PE Amount</th>
                                        <th>Billed</th>
                                        <th>Balanced</th>
                                        <th>*</th>
                                        <th>Date</th>
                                        <th>REF</th>
                                        <th>Cost Insured Paid</th>
                                        <th>Estimated</th>
                                        <th>Actual</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>

                        <h4>Billing Progress</h4>
                        <hr />
                        <div class="m-portlet__body m--margin-bottom-30" id="m_blockui_list">
                            <!--begin: Datatable -->

                            <table class="table table-striped- table-bordered table-hover table-checkable" id="dt_basic">
                                <thead>
                                    <tr>
                                        <th>Billing</th>
                                        <th>Invoice</th>
                                        <th>Amount</th>
                                        <th>Paid</th>
                                        <th>Date</th>
                                        <th>CRV No</th>
                                        <th>Note</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>

                        <h4>Account Payable</h4>
                        <hr />
                        <div class="m-portlet__body m--margin-bottom-30" id="m_blockui_list">
                            <!--begin: Datatable -->

                            <table class="table table-striped- table-bordered table-hover table-checkable" id="dt_basic">
                                <thead>
                                    <tr>
                                        <th>Cost</th>
                                        <th>Invoice</th>
                                        <th>Amount</th>
                                        <th>Paid</th>
                                        <th>Date</th>
                                        <th>CRV No</th>
                                        <th>Note</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>

                        <div class="m-form__group-sub">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="float-right">
                                        <a href="#" class="btn btn-success m-btn m-btn--icon">
                                            <span>
                                                <i class="la la-search"></i>
                                                <span>Preview</span>
                                            </span>
                                        </a>
                                        <a href="#" class="btn btn-info m-btn m-btn--icon">
                                            <span>
                                                <i class="la la-print"></i>
                                                <span>Print</span>
                                            </span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/demo/demo_12/custom/crud/forms/widgets/bootstrap-datepicker.js" type="text/javascript"></script>
    <script src="~/vendors/custom/datatables/datatables.bundle.js"></script>
}
