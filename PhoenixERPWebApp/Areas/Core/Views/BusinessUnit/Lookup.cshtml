@{
    Layout = null;
}

<!-- Modal -->
<div class="modal fade" id="m_modal_business_unit" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="exampleModalLongTitle">Select Business Unit</h6>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body row">
                <div class="col-md-12">
                    <div class="btn-group m-btn-group" style="display:none" role="group" aria-label="..." id="btn-group-selectected">
                        <button id="btn-addselected" type="button" class="btn btn-sm btn-primary">Add Selected</button>
                        <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</button>
                    </div>
                </div>


                <div class="col-xl-12">
                    <div id="tree_businessunit" class="tree-demo"> </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/Areas/Core/Scripts/BusinessUnit.Lookup.js"></script>

