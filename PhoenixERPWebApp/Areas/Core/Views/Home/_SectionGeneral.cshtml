<div class="row">


    <div class="col-lg-4 col-xs-4">
        <!--begin::Total Profit-->
        <div class="kt-widget24">
            <div class="kt-widget24__details">
                <div class="kt-widget24__info">
                    <h4 class="kt-widget24__title">
                        Total Timesheet
                    </h4>
                </div>
                <span class="kt-widget24__stats kt-font-brand">
                    <span class="sp-th-tm-ds">20</span> hour
                </span>
            </div>

            <div class="progress progress--sm">
                <div class="progress-bar kt-bg-brand pb-tm-ds" role="progressbar" style="width: 99%;" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100"></div>
            </div>

            <div class="kt-widget24__action">
                <span class="kt-widget24__change">
                    Completed
                </span>
                <span class="kt-widget24__number">
                    <span class="sp-tp-tm-ds">20</span>% (> 40 hour/week = 100%)
                </span>
            </div>
        </div>
        <!--end::Total Profit-->
    </div>


    <div class="col-lg-4 col-xs-4">
        <!--begin::New Feedbacks-->
        <div class="kt-widget24">
            <div class="kt-widget24__details">
                <div class="kt-widget24__info">
                    <h4 class="kt-widget24__title">
                        Leave Balance
                    </h4>
                </div>

                <span class="kt-widget24__stats kt-font-warning">
                    Total Leave <span class="sp-tl-lv-ds">20</span>
                </span>
            </div>

            <div class="progress progress--sm">
                <div class="progress-bar bg-warning pgb-tl-ds" role="progressbar" style="width: 99%;" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
            </div>

            <div class="kt-widget24__action">
                <span class="kt-widget24__change">
                    Used
                </span>
                <span class="kt-widget24__number sp-user-tl-ds">
                </span>
            </div>
        </div>
        <!--end::New Feedbacks-->
    </div>

    <div class="col-lg-4 col-xs-4">
        <!--begin::New Orders-->
        <div class="kt-widget24">
            <div class="kt-widget24__details">
                <div class="kt-widget24__info">
                    <h4 class="kt-widget24__title">
                        Settlement
                    </h4>
                </div>
                3
            </div>

            <div class="progress progress--sm">
                <div class="progress-bar bg-danger" role="progressbar" style="width: 99%;" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100"></div>
            </div>

            <div class="kt-widget24__action">
                <span class="kt-widget24__change">
                    completed
                </span>
                <span class="kt-widget24__number">
                    4
                </span>
            </div>
        </div>
        <!--end::New Orders-->
    </div>


</div>
<hr />
<div class="row">
    <div class="col-lg-4 col-xs-4">
        <!--begin::New Orders-->
        <div class="kt-widget24">
            <div class="kt-widget24__details">
                <div class="kt-widget24__info">
                    <h4 class="kt-widget24__title">
                        Clock-In And Out
                    </h4>
                </div>

            </div>

            <div class="card" style="width: 250px;">
                <div class="card-body">
                    @*<h5 class="card-title">Clock-In And Out</h5>*@
                    <p class="card-text">You Can Create an Attendance here : </p>
                    <a class="btn btn-default" asp-action="Attendance" asp-controller="Attendance" asp-area="hrisnew">
                        <i class="la la-clock-o la-5x"></i><span>Clock-In & Out</span>
                    </a>
                </div>
            </div>
        </div>
        <!--end::New Orders-->
    </div>

    <div class="col-lg-4 col-xs-4">
        <!--begin::New Orders-->
        <div class="kt-widget24">
            <div class="kt-widget24__details">
                <div class="kt-widget24__info">
                    <h4 class="kt-widget24__title">
                        Time Sheet
                    </h4>
                </div>

            </div>

            <div class="card" style="width: 250px;">
                <div class="card-body">
                    @*<h5 class="card-title">Clock-In And Out</h5>*@
                    <p class="card-text">You Can Create Time Sheet here : </p>
                    <a class="btn btn-default" asp-action="Index" asp-controller="TimeSheet" asp-area="Pm">
                        <i class="la la-calendar-check-o la-5x"></i><span>Time Sheet</span>
                    </a>
                </div>
            </div>
        </div>
        <!--end::New Orders-->
    </div>
</div>