<div class="row">

    <div class="col-lg-4 col-xs-4" style="padding-bottom:15px">
        <div class="card" style="background:#fff !important">
            <div class="card-header '+ranBg+' text-white">
                <b style="color:#000">Employee Status Summary</b>
            </div>
            <div class="card-body">
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Total Hiring <label class="lblHiring pull-right float-right uk-text-bold" style="color:blue;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Total Promotion <label class="lblPromotion pull-right float-right" style="color:forestgreen;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Total Sanction <label class="lblSanction pull-right float-right" style="color:lightseagreen;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Total Training <label class="lblTraining pull-right float-right" style="color:deeppink;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Total End Of Contract <label class="lblEndOfContract pull-right float-right" style="color:darkorange;font-size:16px"></label></b>
                </div>
            </div>

        </div>

    </div>
    <div class="col-lg-4 col-xs-4" style="padding-bottom:15px">
        <div class="card" style="background:#fff !important">
            <div class="card-header '+ranBg+' text-white">
                <b style="color:#000">Job Status Summary</b>
            </div>
            <div class="card-body">
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Job Open <label class="lblJobOpen pull-right float-right uk-text-bold" style="color:blue;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Job in Progress <label class="lblJobInProgress pull-right float-right" style="color:forestgreen;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Job Delivered <label class="lblJobDelivered pull-right float-right" style="color:lightseagreen;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Job Closed <label class="lblJobClosed pull-right float-right" style="color:deeppink;font-size:16px"></label></b>
                </div>
               
            </div>

        </div>

    </div>
    <div class="col-lg-4 col-xs-4" style="padding-bottom:15px">
        <div class="card" style="background:#fff !important">
            <div class="card-header '+ranBg+' text-white">
                <b style="color:#000">Procurement Status Summary</b>
            </div>
            <div class="card-body">
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Total RFQ <label class="lblRFQ pull-right float-right uk-text-bold" style="color:blue;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Total PO <label class="lblPO pull-right float-right" style="color:forestgreen;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Total Good Received <label class="lblGR pull-right float-right" style="color:lightseagreen;font-size:16px"></label></b>
                </div>

            </div>

        </div>

    </div>

</div>
