@{
    Layout = null;
}

<!-- Modal -->
<div class="modal fade" id="m_modal_team_member" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="exampleModalLongTitle">Assign Member</h6>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body row">
                <div class="col-md-12">
                    <div class="btn-group m-btn-group" role="group" aria-label="...">
                        <button id="btn-addselected" type="button" class="btn btn-sm btn-primary">Add Selected</button>
                        <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal">Cancel</button>
                        <form id="form-search-dt_basic_user">
                            <div class="input-group">
                                <input autocomplete="off" type="text" name="q" class="form-control form-control-sm m-input searchbox" placeholder="Search">
                                <div class="input-group-prepend"><span class="input-group-text input-group-sm"><i class="la la-search"></i></span></div>
                            </div>
                        </form>
                    </div>
                </div>

               
                <div class="col-xl-12">
                    <table class="table" id="dt_basic_user">
                        <thead>
                            <tr>
                                <th width="15px">
                                    <label class="m-checkbox m-checkbox--single m-checkbox--solid m-checkbox--brand">
                                        <input type="checkbox" value="" class="m-group-checkable" name="select_all">
                                        <span></span>
                                    </label>
                                </th>
                                <th>User</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/Areas/Core/Scripts/TeamMember.AddTeamMember.js"></script>

