@{
    Layout = null;
}
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="col-md-12">
    <div class="btn-group m-btn-group" role="group" aria-label="...">
        <button id="btn-add-user_role_member" type="button" class="btn btn-sm btn-secondary">Add</button>
        <button id="btn-remove-user_role_member" type="button" class="btn btn-sm btn-danger">Remove</button>
        <form id="form-search-dt_basic_user_role">
            <div class="input-group">
                <input autocomplete="off" type="text" name="q" class="form-control form-control-sm m-input searchbox" placeholder="Search">
                <div class="input-group-prepend"><span class="input-group-text input-group-sm"><i class="la la-search"></i></span></div>
            </div>
        </form>
    </div>
</div>
<div class="col-xl-12" style="padding-top:20px">

    <table class="m_datatable m-datatable m-datatable--default m-datatable--loaded" id="dt_basic_user_role">
        <thead class="m-datatable__head">
            <tr>
                <th>
                    <label class="m-checkbox m-checkbox--single m-checkbox--solid m-checkbox--brand">
                        <input type="checkbox" value="" class="m-group-checkable" name="select_all">
                        <span></span>
                    </label>
                </th>
                <th>User</th>
            </tr>
        </thead>
    </table>
</div>

<script src="~/Areas/Core/Scripts/UserRole.AssignUserRoleMember.js"></script>
