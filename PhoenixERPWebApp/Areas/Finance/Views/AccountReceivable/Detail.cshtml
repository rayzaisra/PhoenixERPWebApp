                        <br/>
                        <div class="row" id="invoice_data_detail">
                            <div class="col-lg-12 m-row--no-padding">
                                <div class="m-accordion m-accordion--bordered m-accordion--solid" id="invoice_detail" role="tablist">
                                    <div class="m-accordion__item">
                                        <div class="m-accordion__item-head" role="tab" id="invoice_detail_head" data-toggle="collapse" href="#invoice_detail_body" aria-expanded="true">
                                            <span class="m-accordion__item-icon"><i class="fa flaticon-interface-3"></i></span>
                                            <span class="m-accordion__item-title">Invoice Detail</span>
                                            <span class="m-accordion__item-mode"></span>
                                        </div>
                                        <div class="m-accordion__item-body collapse show" id="invoice_detail_body" role="tabpanel" aria-labelledby="invoice_detail_head" data-parent="#invoice_detail" style="">

                                            <div class="m-accordion__item-content">
                                                <div class="row">
                                                    <div class="col-lg-6">
                                                        <div class="form-group row">
                                                            <label asp-for="InvoiceNumber" class="col-lg-3 form-label"></label>
                                                            <div class="col-lg-9">
                                                                @Html.Kendo().TextBoxFor(m => m.InvoiceNumber).HtmlAttributes(new
                                                                {
                                                                    style = "width:100%",
                                                                    @readonly = "readonly"
                                                                })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-6">
                                                        <div class="form-group row">
                                                            <div class="col-lg-3">
                                                                <label asp-for="InvoiceDate" class="form-label"></label>
                                                            </div>
                                                            <div class="col-lg-9">
                                                                @Html.Kendo().DatePickerFor(m => m.InvoiceDate).Events(evt => evt.Change("invoiceDate_change")).HtmlAttributes(new
                                                           {
                                                               style = "width:100%",
                                                               @readonly = "readonly"
                                                           })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="col-lg-6">
                                                        <div class="form-group row">
                                                            <label asp-for="POClientNo" class="col-lg-3 form-label"></label>
                                                            <div class="col-lg-9">
                                                                @Html.Kendo().TextBoxFor(m => m.POClientNo).HtmlAttributes(new
                                                                {
                                                                    style = "width:100%", 
                                                                    @readonly = "readonly"
                                                                })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-6">
