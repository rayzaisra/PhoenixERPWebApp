<script id="ExpandCollapse" type="text/x-kendo-template">
    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.InvoiceClientItemOther>()
        .Name("grid_#=PceId#")
        .Columns(columns =>
        {
            columns.Bound(p => p.TaskName).Width(200);
            columns.Bound(p => p.Quantity).Width(45).HtmlAttributes(new { style = "text-align:right" });
            columns.Bound(p => p.UnitPrice).ClientTemplate("\\#if(CurrencySymbol!=null && UnitPrice!=null){\\# \\#=CurrencySymbol\\# \\#}\\# \\#if(UnitPrice!=null){\\# \\#=kendo.format('{0:n2}', UnitPrice)\\# \\#}\\#").Width(120).HtmlAttributes(new { style = "text-align:right" });
            columns.Bound(p => p.Amount).ClientTemplate("\\#if(CurrencySymbol!=null && Amount!=null){\\# \\#=CurrencySymbol\\# \\#}\\# \\#if(Amount!=null){\\# \\#=kendo.format('{0:n2}', Amount)\\# \\#}\\#").Width(120).Format("{0:N}").HtmlAttributes(new { style = "text-align:right" });
            //columns.Bound(p => p.AmountBilled).Width(120).Format("{0:N}").HtmlAttributes(new { style = "text-align:right" });
        })
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("errorHandler"))
            .Model(m =>
            {
                m.Id(f => f.Id);
            })
            .Read(read => read.Action("ReadPceTaskDetail", "InvoiceClientMultiPce", new { pceId = "#=PceId#"}))
        )
        .NoRecords()
        .ToClientTemplate())

</script>

<script>    
    $(document).ready(function () {  
        setCurrencyValue();
        if("@Model.Status" == "@PhoenixERPWebApp.Models.ARStatus.Posted"){
            $('#linkVatDocRemoveFile').css('display', 'none');
        }
        
        var vatDocName = '@Model.VatDocFileName';
        var poDocName = '@Model.PoDocFileName';

        if (vatDocName == '') { SetVatDocUpload(); } else { $("#linkVatDocDownloadFile").text(vatDocName); }
        if (poDocName == '') {
            //SetPoDocUpload();
        } else { $("#linkPoDocDownloadFile").text(poDocName); } 
    });

    
    function VatNo_bound() {
        if("@Model.Status" == "@PhoenixERPWebApp.Models.ARStatus.Posted"){
            $('#VatNo').data("kendoDropDownList").readonly(); 
        }
    }

    function DDLBrandBound() {
        $('#BrandId').data("kendoDropDownList").readonly(); 
    }

    function grid_params() { return { Id: $("#Id").val() }; } 

    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row"));//.first()
    }
     
    function grid_multiple_params() {
        return { multipceid: $("#MultiPceId").val() };
    }

    function removeVatDoc() { SetVatDocUpload(); }

    function downloadPoDoc() { downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download" })', data: { id: $("#PoDocFileId").val() }});  }     
    function downloadVatDoc() { downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download" })', data: { id: $("#VatDocFileId").val() }}); }  

    function SetVatDocUpload() {
        var required = "";//"required" 
        $("#linkVatDocDownloadFile").empty();
        $("#linkVatDocRemoveFile").empty();
        $("#divVatDoc").empty().append("<input name='fileVatDoc' id='fileVatDoc' type='file'" + required + "/>");

        $("#fileVatDoc").kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".jpg", ".png", ".gif", ".doc", ".pdf", ".docx", ".xlsx"]
            }
        });
    }

    function ddlBrandParam() {
        var clientId = "";
        if ($('#ClientId').val() == "") clientId = "0"; else clientId = $('#ClientId').val();
        return { company_id: clientId };
    }    

    $('#btnSubmit').click(function () {
        if (!isValid()) return;       
        var gridJournal = $("#gridjournal").data("kendoGrid").dataSource.data();
        if (gridJournal.length == 0) {
            swal('Warning', 'Create journal first please !', 'warning');
            return false;
        } 
         
        callActionFile({ formId: "form", title: "posting", type: "POST", url: '@Url.Action("Submit", "AccountReceivable")', objects: result() }); 
    });

    function isValid() {
        var valid = $("#form").validate().form();
        if (valid) {

            if ($("#MultiPceId").val() != '') {
                var grid = $("#grid-multiple-pce").data("kendoGrid").dataSource.data();
                if (grid.length == 0) {
                    swal('Warning', 'Input detail data first please !', 'warning');
                    return false;
                } 
            } else {
                var grid = $("#grid-single-pce").data("kendoGrid").dataSource.data();
                if (grid.length == 0) {
                    swal('Warning', 'Input detail data first please !', 'warning');
                    return false;
                }
            }
             
            return true;
        } else {
            return false;
        }
    }

    function result() {
        if ($("#MultiPceId").val() != '') {
            var dataList = { items_other: $("#grid-multiple-pce").data("kendoGrid").dataSource.data() }
            return dataList;
        } else {
            var dataList = { tems_other: $("#grid-single-pce").data("kendoGrid").dataSource.data() }
            return dataList;
        }
        return null;
    }

    function params_vatNo() {
        return {
            legalEntityId: $("#LegalId").val(),
            invoiceDate: kendo.toString($("#InvoiceDate").data("kendoDatePicker").value(), "yyyy-MM-dd"),
            vatNo: $("#VatNo").val()
        }
    }

    function invoiceDate_change() {
        $("#VatNo").data("kendoDropDownList").dataSource.read();
    }
    
    function sumDebitJournal(sum) {
        return $("#CurrencySymbolDefault").val() + ' ' + kendo.toString(sum, '#,###.##');
    }

    function sumCreditJournal(sum) {
        return $("#CurrencySymbolDefault").val() + ' ' + kendo.toString(sum, '#,###.##');
    }
       
    function setCurrencyValue() {
        var currencySymbol = $("#CurrencySymbol").val();
        var CurrencySymbolDefault = $("#CurrencySymbolDefault").val(); 
        var totalAmount = $('#TotalAmount').data('kendoNumericTextBox');        
        var vat = $('#Vat').data('kendoNumericTextBox');
        var grandTotal = $('#GrandTotal').data('kendoNumericTextBox');
        var vatExchangeRate = $('#VatExchangeRate').data('kendoNumericTextBox');
        var exchangeRate = $('#ExchangeRate').data('kendoNumericTextBox');
         
        var totalAmountValue = totalAmount.value();
        var vatValue = vat.value();
        var grandTotalValue = grandTotal.value();
        var vatExchangeRateValue = vatExchangeRate.value();
        var exchangeRateValue = exchangeRate.value();
         
        totalAmount.setOptions({ value: totalAmountValue, format: currencySymbol + " #,###.##" });
        vat.setOptions({ value: vatValue, format: currencySymbol + " #,###.##" });
        grandTotal.setOptions({ value: grandTotalValue, format: currencySymbol + " #,###.##" });
        vatExchangeRate.setOptions({ value: vatExchangeRateValue, format: CurrencySymbolDefault + " #,###.##" });
        exchangeRate.setOptions({ value: exchangeRateValue, format: CurrencySymbolDefault + " #,###.##" });


        if("@Model.MultiPceId"==""){
            var asfAmount = $('#AsfAmount').data('kendoNumericTextBox');
            var totalamtplusasf = $('#totalamtplusasf').data('kendoNumericTextBox');

            var asfAmountValue = asfAmount.value();
            var totalamtplusasfValue = totalamtplusasf.value();

            asfAmount.setOptions({ value: asfAmountValue, format: currencySymbol + " #,###.##" });
            totalamtplusasf.setOptions({ value: totalamtplusasfValue, format: currencySymbol + " #,###.##" });
        }
    }
</script>