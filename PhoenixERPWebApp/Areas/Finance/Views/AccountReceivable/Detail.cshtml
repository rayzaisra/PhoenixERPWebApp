                                                                <div class="col-lg-9">
                                                                    @(Html.Kendo().DropDownListFor(m => m.BusinessUnitId)
                                                                        .DataTextField("Text")
                                                                        .DataValueField("Value")
                                                                        .OptionLabel("Choose Business Unit")
                                                                        .HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" })
                                                                        .Filter(FilterType.Contains)
                                                                        .DataSource(source => source
                                                                            .Custom()
                                                                            .Transport(transport => transport
                                                                            .Read(read =>
                                                                            {
                                                                                read.Action("GetDivisionFinance", "Dropdown");
                                                                            }))
                                                                            .ServerFiltering(false)
                                                                        ))
                                                                </div>
                                                            </div>
                                                        </div>                               
                                                    </div>
                           
                                                    <div class="row">
                                                        <div class="col-lg-6">
                                                            <div class="form-group row">
                                                                <div class="col-lg-3"><label>Legal Entity</label><label class="req">*</label></div>
                                                                <div class="col-lg-9">
                                                                    @(Html.Kendo().DropDownListFor(m => m.LegalId)
                                                                        .DataTextField("Text")
                                                                        .DataValueField("Value")
                                                                        .OptionLabel("Choose Legal Entity")
                                                                        .HtmlAttributes(new { style = "width:100%;", required = "required", @readonly = "readonly" })
                                                                        .Filter(FilterType.Contains)
                                                                        .DataSource(source => source
                                                                            .Custom()
                                                                            .Transport(transport => transport
                                                                            .Read(read =>
                                                                            {
                                                                                read.Action("GetLegalEntity", "Dropdown");
                                                                            }))
                                                                            .ServerFiltering(false)
                                                                        ))
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <div class="form-group row">
                                                                <label class="col-lg-3">Status Job</label>
                                                                <div class="col-lg-9">
                                                                    @Html.Kendo().TextBoxFor(m => m.JobStatus).HtmlAttributes(new
                                                                    {
                                                                        style = "width:100%",
                                                                        @readonly = "readonly"
                                                                    })
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div> 
                                                }
                                                else
                                                {
                                                    <input type="hidden" asp-for="PceId" />
