 @model PhoenixERPWebApp.Models.InvoiceClient
@{
    ViewData["Title"] = "Account Receiveable";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
} 
<style>  
    .k-numerictextbox .k-input {
        text-align: right;
        padding-right:10px;
    }
</style>
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">Account Receivable</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="@Url.Content("~/Finance/AccountReceivable")" class="m-nav__link">
                        <span class="m-nav__link-text">Account Receivable</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Detail</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div> 

<div class="m-content">
    <div class="row">
        <div class="col-xl-12 col-lg-12">
            <div class="m-portlet">
                <div class="m-portlet__head" style="background:#fafafa">
                    <div class="m-portlet__head-wrapper">
                        <div class="m-portlet__head-caption">
                            <div class="m-portlet__head-title">
                                <h3 class="m-portlet__head-text m--font-success">Account Receivable</h3> &nbsp; 
                                @if (Model.Status == PhoenixERPWebApp.Models.ARStatus.Open)
                                {<span class="m-badge m-badge--warning m-badge--wide" id="lblstatus">@Model.Status</span>}
                                @if (Model.Status == PhoenixERPWebApp.Models.ARStatus.Posted)
                                {<span class="m-badge m-badge--success m-badge--wide" id="lblstatus">@Model.Status</span> }  
                            </div>
                        </div>
                        <div class="m-portlet__head-tools">
                            <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_qf2tcah4xx"><i class="la la-expand"></i></a>
                        </div>
                    </div>
                </div>
                <div class="m-portlet__body">
                    <form id="form" class="m-form m-form--fit m-form--label-align-right m-form--group-seperator-dashed" role="form">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="MultiPceId" /> 
                        <input type="hidden" asp-for="Status" /> 
                        <input type="hidden" asp-for="CurrencySymbol" />  
                        <input type="hidden" asp-for="CurrencyIdDefault" />  
                        <input type="hidden" asp-for="CurrencySymbolDefault" />  
                                                                                 
                        <div class="row" id="data_client_detail">
                            <div class="col-lg-12 m-row--no-padding">
                                <div class="m-accordion m-accordion--bordered m-accordion--solid" id="client_detail" role="tablist">
                                    <!--begin::Item-->
                                    <div class="m-accordion__item">
                                        <div class="m-accordion__item-head collapsed" role="tab" id="client_detail_head" data-toggle="collapse" href="#client_detail_body" aria-expanded="true">
                                            <span class="m-accordion__item-icon"><i class="fa flaticon-interface-4"></i></span>
                                            <span class="m-accordion__item-title">Client Information</span>
                                            <span class="m-accordion__item-mode"></span>
                                        </div>
                                        <div class="m-accordion__item-body collapse" id="client_detail_body" role="tabpanel" aria-labelledby="client_detail_head" data-parent="#client_detail" style="">
                                            <div class="m-accordion__item-content">
                                                <div class="row">
                                                    <div class="col-lg-6 m-form__group-sub">
                                                        <div class="form-group">
                                                            <label>Client Name :</label>
                                                            <br />
                                                            @(Html.Kendo().DropDownListFor(m => m.ClientId)
                                                                    .DataTextField("Text")
                                                                    .DataValueField("Value")
                                                                    .OptionLabel("Choose client Name") 
                                                                    .HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" })
                                                                    .Filter(FilterType.Contains)
                                                                    .DataSource(source => source
                                                                        .Custom()
                                                                        .Transport(transport => transport
                                                                        .Read(read =>
                                                                        {
                                                                            read.Action("GetDDLClient", "Dropdown");
                                                                        }))
                                                                        .ServerFiltering(false)
                                                                    )) 
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-6 m-form__group-sub">
                                                        <div class="form-group">
                                                            <label>Tax Registration / NPWP :</label>
                                                            <br />
                                                            @Html.Kendo().TextBoxFor(m => m.ClientTaxNumber).HtmlAttributes(new
                                                            {
                                                                style = "width:100%",
                                                                @readonly = "readonly"
                                                            })
                                                        </div>
                                                    </div>
                                                </div>
                                                @if (string.IsNullOrEmpty(Model.MultiPceId)) { 
                                                    <div class="row">
                                                        <div class="col-lg-6 m-form__group-sub">
                                                            <div class="form-group">
                                                                <label>Client Brand</label>
                                                                <br />
                                                                @(Html.Kendo().DropDownListFor(m => m.BrandId)
                                                                        .DataTextField("Text")
                                                                        .DataValueField("Value")
                                                                        .OptionLabel("Choose Brand Name") 
                                                                        .Events(e => e.DataBound("DDLBrandBound"))
                                                                        .HtmlAttributes(new { style = "width:100%;",  @readonly = "readonly" })
                                                                        .Filter(FilterType.Contains)
                                                                        .AutoBind(false)
                                                                        .CascadeFrom("ClientId")
                                                                        .DataSource(source => source
                                                                            .Custom()
                                                                            .Transport(transport => transport
                                                                            .Read(read =>
                                                                            {
                                                                                read.Action("GetDDLBrandWithCompany", "Dropdown").Data("ddlBrandParam");
                                                                            }))
                                                                            .ServerFiltering(true)
                                                                        )  ) 
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-6 m-form__group-sub">
                                                            <div class="form-group">
                                                                <label>PIC</label>
                                                                <br />
                                                                @Html.Kendo().TextBoxFor(m => m.ClientPIC).HtmlAttributes(new
                                                                {
                                                                    style = "width:100%",
                                                                    @readonly = "readonly"
                                                                })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-lg-6 m-form__group-sub">
                                                            <div class="form-group">
                                                                <label>Address</label>
                                                                <br />
                                                                @Html.Kendo().TextBoxFor(m => m.ClientInvAddress).HtmlAttributes(new
                                                                {
                                                                    style = "width:100%",
                                                                    @readonly = "readonly"
                                                                })
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-6 m-form__group-sub">
                                                            <div class="form-group">
                                                                <label>Term Of Payment</label>
                                                                <br />
                                                                @Html.Kendo().TextBoxFor(m => m.TermOfPayment).HtmlAttributes(new
                                                                {
                                                                    style = "width:100%",
                                                                    @readonly = "readonly"
                                                                })
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="row">
                                                        <div class="col-lg-12">
                                                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.MultipleBrand>()
                                                                .Name("gridMultipleBrand")
                                                                .Columns(columns =>
                                                                {
                                                                    //columns.Bound(p => p.BrandId).Width(150);
                                                                    columns.Bound(p => p.ClientBrandName).Width(150);
                                                                    columns.Bound(p => p.ClientPIC).Width(150);
                                                                    columns.Bound(p => p.ClientInvAddress).Width(250);
                                                                    columns.Bound(p => p.TermOfPayment).Width(120);
                                                                })
                                                                .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                                                .Resizable(rsz => rsz.Columns(true))
                                                                .DataSource(dataSource => dataSource
                                                                    .Ajax()
                                                                    .Events(events => events.Error("errorHandler"))
                                                                    .Model(model => { model.Id(p => p.BrandId); })
                                                                    .Read(read => read.Action("ReadMultipleBrand", "InvoiceClientMultiPce").Data("grid_multiple_params"))
                                                                )
                                                                .NoRecords()
                                                            )
                                                        </div>
                                                    </div>
                                                }
                                            </div>
					                    </div>
				                    </div>
			                    </div>
		                    </div>
	                    </div>	
                        <br />
                        
                        <div class="row" id="data_pce_detail">
                            <div class="col-lg-12 m-row--no-padding">
                                <div class="m-accordion m-accordion--bordered m-accordion--solid" id="pce_detail" role="tablist">
                                    <!--begin::Item-->
                                    <div class="m-accordion__item">
                                        <div class="m-accordion__item-head collapsed" role="tab" id="pce_detail_head" data-toggle="collapse" href="#pce_detail_body" aria-expanded="true">
