                                <div class="m-accordion m-accordion--bordered m-accordion--solid" id="journal_detail" role="tablist">
                                    <!--begin::Item-->
                                    <div class="m-accordion__item">
                                        <div class="m-accordion__item-head" role="tab" id="journal_detail_head" data-toggle="collapse" href="#journal_detail_body" aria-expanded="true">
                                            <span class="m-accordion__item-icon"><i class="fa flaticon-interface-3"></i></span>
                                            <span class="m-accordion__item-title">Journal Detail</span>
                                            <span class="m-accordion__item-mode"></span>
                                        </div>
                                        <div class="m-accordion__item-body collapse show" id="journal_detail_body" role="tabpanel" aria-labelledby="payment_detail_head" data-parent="#journal_detail" style="">
                                            <div class="m-accordion__item-content">     
                                                <div class="row">
                                                    <div class="col-md-12">
                                                        @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Journal>()
                                                            .Name("gridjournal")
                                                            .Columns(columns =>
                                                            {
                                                                columns.Bound(p => p.CodeRec).Width(150);
                                                                columns.Bound(p => p.AccountName).Width(200);
                                                                columns.Bound(p => p.Description).Encoded(false).Width(200);
                                                                columns.Bound(p => p.JobIdName).Encoded(false).Width(250);
                                                                columns.Bound(p => p.DivisiName).Encoded(false).Width(200);
                                                                columns.Bound(p => p.LegalEntityName).Encoded(false).Width(200).ClientFooterTemplate("TOTAL").FooterHtmlAttributes(new { style = "text-align:right;" });
                                                                columns.Bound(p => p.Debit).ClientTemplate("#if(CurrencySymbol!=null && Debit!=null){# #=CurrencySymbol# #}# #if(Debit!=null){# #=kendo.format('{0:n2}', Debit)# #}#").Width(150).Format("{0:N2}").ClientFooterTemplate("#=sumDebitJournal(sum)#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                                columns.Bound(p => p.Credit).ClientTemplate("#if(CurrencySymbol!=null && Credit!=null){# #=CurrencySymbol# #}# #if(Credit!=null){# #=kendo.format('{0:n2}', Credit)# #}#").Width(150).Format("{0:N2}").ClientFooterTemplate("#=sumCreditJournal(sum)#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                            })
                                                            .NoRecords()
                                                            .DataSource(dataSource => dataSource
                                                                .Ajax()
                                                                .Aggregates(aggregates =>
                                                                {
                                                                    aggregates.Add(p => p.Debit).Sum();
                                                                    aggregates.Add(p => p.Credit).Sum();
                                                                })
                                                                .Events(events => events.Error("errorHandler"))
                                                                .Model(model => { model.Id(p => p.Id); })
                                                                .Read(read => read.Action("ReadJournal", "AccountReceivable").Data("grid_params"))
                                                            )
                                                        )
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
