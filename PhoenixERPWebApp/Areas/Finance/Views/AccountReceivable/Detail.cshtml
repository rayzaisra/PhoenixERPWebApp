                                                            <div class="col-lg-3">
                                                                <label asp-for="VatNo" class="form-label"></label>
                                                            </div>
                                                            <div class="col-lg-9">
                                                                @(Html.Kendo().DropDownListFor(m => m.VatNo)
                                                                    .DataTextField("Text")
                                                                    .DataValueField("Value")
                                                                    .OptionLabel("Choose VAT No")
                                                                    .HtmlAttributes(new { style = "width:100%;" })//, @required="required"})
                                                                    .Filter(FilterType.Contains)
                                                                    .Events(evt => evt.DataBound("VatNo_bound"))
                                                                    .DataSource(source => source
                                                                        .Custom()
                                                                        .Transport(transport => transport
                                                                        .Read(read =>
                                                                        {
                                                                            read.Action("GetEfaktur", "Dropdown").Data("params_vatNo");
                                                                        }))
                                                                        .ServerFiltering(true)
                                                                    ).CascadeFrom("LegalId"))
                                                            </div>
                                                        </div>
                                                    </div>

                                                </div>
                                                <div class="row">
                                                    <div class="col-lg-6">
                                                        <div class="form-group row">
                                                            <label class="col-lg-3 form-label">PO Doc</label>
                                                            <div class="col-lg-9">
                                                                <div id="divPoDoc"></div>
                                                                <div style="width:100%">
                                                                    <input type="hidden" asp-for="PoDocFileId" />
                                                                    <a href='javascript: void(0);' id="linkPoDocDownloadFile" onclick='downloadPoDoc()'></a> &nbsp;
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-lg-6">
                                                        <div class="form-group row">
                                                            <label class="col-lg-3 form-label">Vat Doc</label>
                                                            <div class="col-lg-9">
                                                                <div id="divVatDoc"></div>
                                                                <div style="width:100%">
