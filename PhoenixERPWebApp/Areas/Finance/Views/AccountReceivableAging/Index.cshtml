@model PhoenixERPWebApp.Models.VwAgingArFilter
@{
    ViewData["Title"] = "Aging Account Receivable";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Aging Account Receivable</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="AccountReceivableAging" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Aging Account Receivable</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>

<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">

                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formFilter" class="form-horizontal form-bordered" role="form">
                        <div class="m-form__group">
                            <div class="row">
                                <div class="col-lg-4 m-form__group-sub">
                                    <div class="form-group">
                                        <label asp-for="ClientId"></label> :
                                        @(Html.Kendo().DropDownListFor(x=>x.ClientId)
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .OptionLabel("All")
                                            .Filter(FilterType.Contains)
                                            .HtmlAttributes(new { @class = "m-input ", style = "width:100%" })
                                            .DataSource(source => source
                                                .Custom()
                                                .Transport(transport => transport
                                                .Read(read =>
                                                {
                                                    read.Action("GetDDLClient", "Dropdown", new { area = "Finance" });
                                                }))
                                                .ServerFiltering(false)
                                            ))
                                    </div>
                                </div>
                                <div class="col-lg-4 m-form__group-sub">
                                    <div class="form-group">
                                        <label asp-for="LegalEntityId"></label> :
                                        @(Html.Kendo().DropDownListFor(x=>x.LegalEntityId)
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .OptionLabel(" ")
                                            .Filter(FilterType.Contains)
                                            .HtmlAttributes(new { @class = "m-input ", style = "width:100%", required = "required" })
                                            .DataSource(source => source
                                                .Custom()
                                                .Transport(transport => transport
                                                .Read(read =>
                                                {
                                                    read.Action("GetLegalEntity", "Dropdown", new { area = "Finance" });
                                                }))
                                                .ServerFiltering(false)
                                            ))
                                    </div>
                                </div>
                                <div class="col-lg-4 m-form__group-sub">
                                    <div class="form-group">
                                        <label asp-for="MainserviceCategoryId"></label> :
                                        @(Html.Kendo().DropDownListFor(x=>x.MainserviceCategoryId)
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .OptionLabel("All")
                                            .Filter(FilterType.Contains)
                                            .HtmlAttributes(new { @class = "m-input ", style = "width:100%" })
                                            .DataSource(source => source
                                                .Custom()
                                                .Transport(transport => transport
                                                .Read(read =>
                                                {
                                                    read.Action("GetDDLMainServiceCategory", "Dropdown", new { area = "Finance" });
                                                }))
                                                .ServerFiltering(false)
                                        ))
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-4 m-form__group-sub">
                                    <div class="form-group">
                                        <label asp-for="JobId"></label> :
                                        @(Html.Kendo().DropDownListFor(x=>x.JobId)
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .OptionLabel("All")
                                            .Filter(FilterType.Contains)
                                            .HtmlAttributes(new { @class = "m-input ", style = "width:100%" })
                                            .DataSource(source => source
                                                .Custom()
                                                .Transport(transport => transport
                                                .Read(read =>
                                                {
                                                    read.Action("GetJobId", "Dropdown", new { area = "Finance" });
                                                }))
                                                .ServerFiltering(false)
                                            ))
                                    </div>
                                </div>
                                <div class="col-lg-4 m-form__group-sub">
                                    <div class="form-group">
                                        <label asp-for="TypeOfExpenseId"></label> :
                                        @(Html.Kendo().DropDownListFor(x=>x.TypeOfExpenseId)
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .OptionLabel("All")
                                            .Filter(FilterType.Contains)
                                            .HtmlAttributes(new { @class = "m-input ", style = "width:100%"})
                                            .DataSource(source => source
                                                .Custom()
                                                .Transport(transport => transport
                                                .Read(read =>
                                                {
                                                    read.Action("GetDLLTypeOfExpense", "Dropdown", new { area = "Finance" });
                                                }))
                                                .ServerFiltering(false)
                                            ))
                                    </div>
                                </div>
                                <div class="col-lg-4 m-form__group-sub">
                                    <div class="form-group">
                                        <label asp-for="CurrencyId"></label> :
                                        @(Html.Kendo().DropDownListFor(x=>x.CurrencyId)
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .OptionLabel("All")
                                            .Filter(FilterType.Contains)
                                            .HtmlAttributes(new { @class = "m-input ", style = "width:100%" })
                                            .DataSource(source => source
                                                .Custom()
                                                .Transport(transport => transport
                                                .Read(read =>
                                                {
                                                    read.Action("GetDDLCurrency", "Dropdown", new { area = "Finance" });
                                                }))
                                                .ServerFiltering(false)
                                        ))
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-4 m-form__group-sub">
                                    <div class="form-group">
                                        <label asp-for="OriginalAmount"></label> :
                                        @Html.Kendo().NumericTextBoxFor(m => m.OriginalAmount).Spinners(false).HtmlAttributes(new { style = "width:100%" })
                                    </div>
                                </div>
                                <div class="col-lg-4 m-form__group-sub" style="top:23px;">
                                    <div class="form-group">
                                        <button type="button" id="btnSearch" class="btn btn-sm btn-primary" style="width:80px"><span class="fa fa-filter"></span>   Filter</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <hr />
                    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.VwAgingAr>()
                        .Name("grid")
                        .Columns(column =>
                        {
                            column.Bound(p => p.TransactionDate).Width(180);
                            column.Bound(p => p.InvoiceReceivedDate).Width(150);
                            column.Bound(p => p.LegalEntityName).Width(200);
                            column.Bound(p => p.BusinessUnitName).Width(200);
                            column.Bound(p => p.ClientName).Width(300);
                            column.Bound(p => p.MainserviceCategoryName).Width(200);
                            column.Bound(p => p.Jobs).Width(300);
                            column.Bound(p => p.TypeOfExpenseName).Width(150);
                            column.Bound(p => p.InvoiceNumber).Width(150);
                            column.Bound(p => p.BrandName).Width(150);
                            column.Bound(p => p.DeliveryNote).Width(150);
                            column.Bound(p => p.InvoiceDeliveryDate).Width(150);
                            column.Bound(p => p.PoClientNo).Width(150);
                            column.Bound(p => p.DueDate).Width(100);
                            column.Bound(p => p.Days).Width(80).HtmlAttributes(new { @style = "text-align:center" });
                            column.Bound(p => p.CurrencyName).Width(120).ClientFooterTemplate("Total").FooterHtmlAttributes(new { @style = "text-align:right" });
                            column.Bound(p => p.Current).Width(150).ClientTemplate("#if(CurrencySymbol!=null && Current!=null){# #=CurrencySymbol# #}# #if(Current!=null){# #=kendo.format('{0:n2}', Current)# #}#").ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                            column.Bound(p => p.Value0130).Width(150).ClientTemplate("#if(CurrencySymbol!=null && Value0130!=null){# #=CurrencySymbol# #}# #if(Value0130!=null){# #=kendo.format('{0:n2}', Value0130)# #}#").ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                            column.Bound(p => p.Value3160).Width(150).ClientTemplate("#if(CurrencySymbol!=null && Value3160!=null){# #=CurrencySymbol# #}# #if(Value3160!=null){# #=kendo.format('{0:n2}', Value3160)# #}#").ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                            column.Bound(p => p.Value6190).Width(150).ClientTemplate("#if(CurrencySymbol!=null && Value6190!=null){# #=CurrencySymbol# #}# #if(Value6190!=null){# #=kendo.format('{0:n2}', Value6190)# #}#").ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                            column.Bound(p => p.ValueMoreThan90).Width(150).ClientTemplate("#if(CurrencySymbol!=null && ValueMoreThan90!=null){# #=CurrencySymbol# #}# #if(ValueMoreThan90!=null){# #=kendo.format('{0:n2}', ValueMoreThan90)# #}#").ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                            column.Bound(p => p.Id).ClientTemplateId("writeOff-template").Title(" ").Width(140);
                        })
                        .Pageable(pageable => pageable
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
                         .ToolBar(toolBar =>
                         {
                             toolBar.Excel();
                             toolBar.Pdf();
                         })
                       .Excel(excel => excel
                            .FileName("ReportAccountReceivableAging.xlsx")
                            .Filterable(true)
                            .AllPages(true)
                            .ProxyURL(Url.Action("Download", "AccountReceivableAging"))
                        )
                        .Pdf(pdf => pdf
                            .FileName("ReportAccountReceivableAging.pdf")
                            .AllPages()
                            //.AvoidLinks()
                            //.PaperSize("A2")
                            //.Margin("2cm", "1cm", "1cm", "1cm")
                            //.Landscape()
                            //.RepeatHeaders()
                            .TemplateId("page-template")
                            .ProxyURL(Url.Action("Download", "AccountReceivableAging"))
                        )
                        .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                        .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                        .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                        .Extra(false)
                        .Operators(operators => operators
                        .ForString(str => str.Clear()
                            .Contains("Contains")
                            .StartsWith("Start sWith")
                            .EndsWith("End sWith")
                        )))
                        .Resizable(rsz => rsz.Columns(true))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Model(model => { model.Id(p => p.Id); })
                            .Sort(sort => sort.Add(x => x.InvoiceDeliveryDate).Descending())
                            .Aggregates(aggregates =>
                            {
                                aggregates.Add(p => p.Current).Sum();
                                aggregates.Add(p => p.Value0130).Sum();
                                aggregates.Add(p => p.Value3160).Sum();
                                aggregates.Add(p => p.Value6190).Sum();
                                aggregates.Add(p => p.ValueMoreThan90).Sum();
                            })
                            .Events(events => events.Error("errorHandler"))
                            .Read(read => read.Action("Read", "AccountReceivableAging").Data("grid_params"))
                            )
                        .Events(e => e.ExcelExport("excelExportEvent").PdfExport("pdfExportEvent"))
                     )
                </div>
            </div>
        </div>
    </div>
</div>

<script id="writeOff-template" type="text/x-kendo-template">
    <a href='javascript: void(0);' onclick='WriteOff(this)' title='Write Off' class='edit'><span style='color:blue; text-decoration:underline;'>Write Off</span></a>
</script>

<script type="x/kendo-template" id="page-template">
    <div class="page-template">
        @*<div class="header">
        </div>*@
    <div class="watermark">@*KENDO UI*@</div>
    <div class="footer">
        Page #: pageNum # of #: totalPages #
    </div>
    </div>
</script>

<script type="text/javascript">
    $(document).ready(function () {
        $('.k-grid-excel').addClass('btn-outline-success');
        $('.k-grid-pdf').addClass('btn-outline-danger');
    });

    function WriteOff(e) {
        var item = dataItem(e);
        window.location.href = '@Url.Action("Detail", "AccountReceivableAging")?reffNo=' + item.Id;
    }
     
    $('#btnSearch').click(function () {
        var valid = $("#formFilter").validate().form();
        if (valid) {
            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $('#grid').data('kendoGrid').dataSource.read();
            $('#grid').data('kendoGrid').refresh();
            mApp.unblock("#m_blockui_list");
        }
    });

    function grid_params() {
        return {
            Filter: {
                ClientId: $("#ClientId").data("kendoDropDownList").value(),
                LegalEntityId: $("#LegalEntityId").data("kendoDropDownList").value(),
                MainserviceCategoryId: $("#MainserviceCategoryId").data("kendoDropDownList").value(),
                JobId: $("#JobId").data("kendoDropDownList").value(),
                TypeOfExpenseId: $("#TypeOfExpenseId").data("kendoDropDownList").value(),
                CurrencyId: $("#CurrencyId").data("kendoDropDownList").value(),
                OriginalAmount: $("#OriginalAmount").data("kendoNumericTextBox").value(),
            }
        }
    }
</script>