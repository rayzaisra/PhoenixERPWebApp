    function Balance() {
        var models = $("#grid").data("kendoGrid").dataSource.data();
        var totalDebit = 0;
        var totalCredit = 0;

        $.each(models, function (index, data) {
            if (data.Debit != null) {
                totalDebit += data.Debit;
            }
            if (data.Credit != null) {
                totalCredit += data.Credit;
            }
        });
        var amount = $("#Amount").data("kendoNumericTextBox").value()
        var balance = (amount == totalCredit) || (amount == totalDebit);
        if (balance) {
            $("#lblBalance").html("<span style='color:green;'>Balance</span>");
        } else {
            $("#lblBalance").html("<span style='color:red;'>Not Balance</span>");
        }
        return balance;
    }

    function GetNewDetails() {
        var costSharingAllocationId = $("#CostSharingAllocationId").data("kendoDropDownList").value();
        var condition = $("#ConditionHeader").data("kendoDropDownList").value();
        var amount = $("#Amount").data("kendoNumericTextBox").value()
        if (costSharingAllocationId != null && condition != null && amount != null) {
            var grid = $("#grid").data("kendoGrid");
            grid.dataSource.fetch(function () {
                Balance();
            });
        }
    }
