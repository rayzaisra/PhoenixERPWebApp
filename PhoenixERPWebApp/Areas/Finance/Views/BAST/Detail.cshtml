    function onSelectPO() {
        console.log("onSelectPo");
        if ($("#Id").val() != null && $("#Id").val() != "") {
            $("#grid-PurchaseOrderDetailList").data("kendoGrid").dataSource.read();
            $("#grid-PurchaseOrderDetailList").data("kendoGrid").refresh();
        } else {
            console.log("onSelectPoNewForm");
            if ($("#PurchaseOrderId").val() != "") {
                $("#grid-PurchaseOrderDetailList").data("kendoGrid").dataSource.read();
                $("#grid-PurchaseOrderDetailList").data("kendoGrid").refresh();
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetDataPO", "Bast")',
                    data: { poId: $("#PurchaseOrderId").val() },
                    success: function (data) {
                        console.log(data);
                        $("#JobName").val(data.JobName);
                        $("#BusinessUnitId").data("kendoDropDownList").value(data.BusinessUnitId);
                        $("#CompanyId").val(data.CompanyId);
                        $("#LegalEntityId").data("kendoDropDownList").value(data.LegalEntityId);
                        $("#JobId").val(data.JobId);
                        $("#PurchaseOrderNumber").val(data.PurchaseOrderNumber);
                    }
                });
            } else {
                $("#JobName").val("");
                $("#BusinessUnitId").data("kendoDropDownList").value("");
                $("#CompanyId").val("");
                $("#LegalEntityId").data("kendoDropDownList").value("");
                $("#JobId").val("");
                $("#PurchaseOrderNumber").val("");
            }
        }
    };

