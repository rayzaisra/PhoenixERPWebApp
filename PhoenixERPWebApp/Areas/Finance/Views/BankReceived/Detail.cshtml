@model PhoenixERPWebApp.Models.BankReceived
@{
    ViewData["Title"] = "Bank Received Detail";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";

    DateTime? EffectiveDate = DateTime.Now;
    DateTime? EndDate = DateTime.Now;
}
@*<style>
    .k-footer-template {
        text-align: right;
    }
</style>*@

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">Bank Received</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-suitcase"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="Index" asp-controller="BankReceived" asp-area="Finance" class="m-nav__link"><span class="m-nav__link-text">Bank Received</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="Detail" asp-controller="BankReceived" asp-area="Finance" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="Detail" asp-controller="BankReceived" asp-area="Finance" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

<div class="m-content">
    <div class="row">
        <div class="col-xl-12 col-lg-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title"> 
                            <h3 class="m-portlet__head-text m--font-success">Bank Received</h3>&nbsp;
                                @if (!string.IsNullOrEmpty(Model.Status))
                                {
                                    @if (Model.Status == @PhoenixERPWebApp.Models.PaymentRequestStatus.Open)
                                    { <span class="m-badge m-badge--info m-badge--wide" id="status">@Model.StatusDesc</span> }
                                    else if (Model.Status == @PhoenixERPWebApp.Models.PaymentRequestStatus.PayBalance)
                                    { <span class="m-badge m-badge--focus m-badge--wide" id="status">@Model.StatusDesc</span> }
                                    else if (Model.Status == @PhoenixERPWebApp.Models.PaymentRequestStatus.WaitingApproval)
                                    { <span class="m-badge m-badge--warning m-badge--wide" id="status">@Model.StatusDesc</span> }
                                    else if (Model.Status == @PhoenixERPWebApp.Models.PaymentRequestStatus.Reject)
                                    { <span class="m-badge m-badge--danger m-badge--wide" id="status">@Model.StatusDesc</span> } 
                                    else if (Model.Status == @PhoenixERPWebApp.Models.PaymentRequestStatus.Complete)
                                    { <span class="m-badge m-badge--success m-badge--wide" id="status">@Model.StatusDesc</span> }
                                    else if (Model.Status == @PhoenixERPWebApp.Models.PaymentRequestStatus.Reconsiliation)
                                    { <span class="m-badge m-badge--dark m-badge--wide" id="status">@Model.StatusDesc</span> }
                                    else
                                    { <span class="m-badge m-badge--info m-badge--wide" id="status">@Model.StatusDesc</span> }
                                }
                            </h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body">
                    @*<div class="m-form__group">*@
                    <form id="form" class="m-form m-form--fit m-form--label-align-right m-form--group-seperator-dashed">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedBy" />
                        <input type="hidden" asp-for="CreatedOn" />
                        <input type="hidden" asp-for="ModifiedBy" />
                        <input type="hidden" asp-for="ModifiedOn" />
                        <input type="hidden" asp-for="ApprovedBy" />
                        <input type="hidden" asp-for="ApprovedOn" />
                        <input type="hidden" asp-for="IsActive" />
                        <input type="hidden" asp-for="IsLocked" />
                        <input type="hidden" asp-for="IsDefault" />
                        <input type="hidden" asp-for="IsDeleted" />
                        <input type="hidden" asp-for="OwnerId" />
                        <input type="hidden" asp-for="DeletedBy" />
                        <input type="hidden" asp-for="DeletedOn" />
                        <input type="hidden" asp-for="InvoiceReceivableId" />
                        @*<input type="hidden" asp-for="BusinessUnitId" />*@
                        <input type="hidden" asp-for="LegalEntityId" />
                        <input type="hidden" asp-for="JobId" />
                        <input type="hidden" asp-for="PurchaseRequestId" />
                        <input type="hidden" asp-for="ReferenceNumberId" />
                        <input type="hidden" asp-for="DueDate" />
                        <input type="hidden" asp-for="Status" />
                        @*<input type="hidden" asp-for="PaymentRequestNumber" />*@
                        <input type="hidden" asp-for="PaymentRequestDate" />
                        @*<input type="hidden" asp-for="MainServiceCategoryId" />*@
                        <input type="hidden" asp-for="SourceDoc" />
                        <input type="hidden" asp-for="Ca_CashAdvanceId" />
                        <input type="hidden" asp-for="PairingGroupId" />
                        <input type="hidden" asp-for="isAdvancePayment" id="isAdvancePay" />
                        <input type="hidden" asp-for="Balance" id="tempBalanceValue" />
                        <input type="hidden" asp-for="Inv_VendorId" />
                        <input type="hidden" asp-for="AffilitionId" />
                        <input type="hidden" asp-for="CurrencySymbol" />  
                        <input type="hidden" asp-for="CurrencyIdDefault" />  
                        <input type="hidden" asp-for="CurrencySymbolDefault" />  

                        <div class="row" id="payment_request_data_detail" style="display:block">
                            <div class="col-lg-12 m-row--no-padding">
                                <div class="m-accordion m-accordion--bordered m-accordion--solid" id="payment_request_detail" role="tablist"> 
                                    <div class="m-accordion__item">
                                        <div class="m-accordion__item-head" role="tab" id="payment_request_detail_head" data-toggle="collapse" href="#payment_request_detail_body" aria-expanded="true">
                                            <span class="m-accordion__item-icon"><i class="fa fa-briefcase"></i></span>
                                            <span class="m-accordion__item-title">List Of Bank Received</span>
                                            <span class="m-accordion__item-mode"></span>
                                        </div>
                                        <div class="m-accordion__item-body collapse show" id="payment_request_detail_body" role="tabpanel" aria-labelledby="payment_request_detail_head" data-parent="#payment_request_detail" style="">
                                            <div class="m-accordion__item-content">
                                                @if (Model.SourceDoc != "")
                                                {
                                                    <div class="row">
                                                        <div class="col-lg-12 m-form__group-sub">
                                                            <div class="form-group">
                                                                @(Html.Kendo().Grid<PhoenixERPWebApp.Models.AccountReceivable>()
                                                                    .Name("grid-multi-ar")
                                                                    .ToolBar(x =>
                                                                    {
                                                                        if (Model.Status == PhoenixERPWebApp.Models.PaymentRequestStatus.Open)
                                                                        {
                                                                            x.ClientTemplateId("grid-toolbar-template");
                                                                        }

                                                                    })
                                                                    .Columns(columns =>
                                                                    {
                                                                        if(Model.Status == PhoenixERPWebApp.Models.PaymentRequestStatus.Open)
                                                                        {
                                                                            columns.Bound("").ClientTemplateId("btnAction-template").Title("Action").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(60);
                                                                        }
                                                                        columns.Bound(p => p.AccountReceivableNumber).Title("Reff Number").ClientTemplateId("reffno-template").Width(130);
                                                                        columns.Bound(p => p.TransactionDate).Width(100);
                                                                        columns.Bound(p => p.BusinessUnitName).Width(150);
                                                                        columns.Bound(p => p.LegalEntity).Width(150);
                                                                        columns.Bound(p => p.ClientName).Width(150);
                                                                        columns.Bound(p => p.ClientBrand).Width(150);
                                                                        columns.Bound(p => p.CurrencyName).Width(150);
                                                                        columns.Bound(p => p.Amount).ClientTemplate("#if(CurrencySymbol!=null && Amount!=null){# #=CurrencySymbol# #}# #if(Amount!=null){# #=kendo.format('{0:n2}', Amount)# #}#").Width(150).HtmlAttributes(new { style = "text-align:right;" });
                                                                    })
                                                                    .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                                                    .Resizable(rsz => rsz.Columns(true))
                                                                        .DataSource(dataSource => dataSource
                                                                        .Ajax()
                                                                        .PageSize(10)
                                                                        .Events(events => events.Error("errorHandler"))
                                                                        .Model(model => { model.Id(p => p.Id); })
                                                                        .Read(read => read.Action("ReadDetailAR", "BankReceived").Data("ar_params"))
                                                                    )
                                                                    .NoRecords()
                                                                )
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row ">
                                                        <div class="col-lg-8"><div class="pull-right">Total Bank Received</div></div>
                                                        <div class="col-lg-4">
                                                            <div class="form-group">
                                                                @(Html.Kendo().NumericTextBoxFor(m => m.Amount)
                                                                    .Spinners(false)
                                                                    .Format("{0:N0}")
                                                                    .HtmlAttributes(new
                                                                    {
                                                                        style = "width:100%; text-align: right;padding-right: 10px",
                                                                        @readonly = "readonly"
                                                                    }
                                                                ))
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row" style="display:none">
                                                        <div class="col-lg-8"><div class="pull-right">Grand Total</div></div>
                                                        <div class="col-lg-4">
                                                            <div class="form-group">
                                                                @(Html.Kendo().NumericTextBoxFor(m => m.TotalAmount)
                                                                    .Spinners(false)
                                                                    .Format("{0:N0}")
                                                                    .HtmlAttributes(new
                                                                    {
                                                                        style = "width:100%; text-align: right;padding-right: 10px",
                                                                        @readonly = "readonly"
                                                                    }
                                                                ))
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <br />
                                                    <hr />
                                                }

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <br />
                        <br />
