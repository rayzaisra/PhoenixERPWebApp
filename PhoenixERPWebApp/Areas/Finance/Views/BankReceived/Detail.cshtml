    function CalculateAmount() {
        var charges = $('#Charges').data("kendoNumericTextBox").value();
        var taxPayable = $("#TaxPayable").data("kendoNumericTextBox").value();
        var griddtldsData = $("#grid-multi-ar").data('kendoGrid').dataSource.data();

        if (griddtldsData.length > 0) {
            var amt = 0;
            for (var i = 0; i < griddtldsData.length; i++) {
                amt += griddtldsData[i].Amount;
            }

            $("#Amount").data("kendoNumericTextBox").value(amt);
            $("#TotalAmount").data("kendoNumericTextBox").value(amt);
            $("#AmountPay").data("kendoNumericTextBox").value(amt); 
            $("#TotalAmountPay").data("kendoNumericTextBox").value(amt - charges - taxPayable);  
        } else {
            var amt = $("#AmountPay").data("kendoNumericTextBox").value();
            $("#TotalAmountPay").data("kendoNumericTextBox").value(amt - charges - taxPayable);  
        }
    }
    
    function Calculate() {
        var charges = $('#Charges').data("kendoNumericTextBox").value();
        var taxPayable = $("#TaxPayable").data("kendoNumericTextBox").value();
        var amt = $("#AmountPay").data("kendoNumericTextBox").value();
        $("#TotalAmountPay").data("kendoNumericTextBox").value(amt - charges - taxPayable); 
    }
    
