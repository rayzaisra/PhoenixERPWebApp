<script>
    $(document).ready(function () {
        ActionPayToType();
        ActionType();
        setCurrencyValue();

        var grid = $("#grid-multi-ar").data("kendoGrid");
        grid.dataSource.fetch(function () {
            if (grid.dataSource.data().length > 0) {
                $('#PaytoCoaId').data("kendoDropDownList").readonly();
                $("#PayToType").data("kendoDropDownList").readonly();
                $("#PayToVendor").data("kendoDropDownList").readonly();
            } 
        }); 

        if ($('#Status').val() != '') {
            DDLCurrencyChange();

            //if ($("#PayToType").val() == "3") {
            //    $("#PayToVendor").data("kendoDropDownList").readonly(true);
            //    $('#PaytoCoaId').data("kendoDropDownList").readonly(); 
            //} else {
            //    //$('#AmountPay').data('kendoNumericTextBox').readonly(false);
            //}

            //if ($("#PayToVendor").val() != '') {
            //    $("#PayToType").data("kendoDropDownList").readonly(true);
            //    $('#PaytoCoaId').removeAttr("required");
            //}

            //if ($("#TaxPayCoaId").val() != "") {
            //    $('#TaxPayable').data('kendoNumericTextBox').readonly(false);
            //}

            //if ($("#BankChargesCoaId").val() != "") {
            //    $('#Charges').data('kendoNumericTextBox').readonly(false);
            //}

            // status != open
            if (parseInt($('#Status').val()) > 1) {
                $("[data-role]").each(function (index, el) {
                    var widget = kendo.widgetInstance($(el));
                    if (widget.enable) {
                        widget.readonly();
                    }
                });
                $('#Remarks').attr("readonly", "readonly");
                $('.k-button').css('pointer-events', 'none');
                $('#Charges').data('kendoNumericTextBox').readonly(true);
            }
        }
    });

    
    function grid_params() { return { Id: $("#Id").val() };  } 
    
    function ar_params() {
        return {
            bankReceivableId: $("#Id").val()
        }
    }

    function bank_params() {
        var legalId = "";
        var dataAR = $("#grid-multi-ar").data('kendoGrid').dataSource.data(); 
        if (dataAR.length > 0) {
            var item = dataAR[0];
            legalId = item.LegalEntityId;
        }

        return {
            legalEntityId: legalId
        }
    }
    
    function LinktoReffNumber(e) {
        var item = dataItem(e);
        window.open('@Url.Action("Detail", "AccountReceivable")?id=' + item.Id);
    }

    function deleteGridRowARList(e) {
        swal({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            type: "warning",
