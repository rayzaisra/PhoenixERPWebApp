@{
    ViewData["Title"] = "Budget Management";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<input hidden id="detail-id" value="@ViewBag.RecordID" />
<style>
    tr:nth-child(even) {
        background: #ebebe0
    }

    tr:nth-child(odd) {
        background: #FFF
    }

    td {
        white-space: nowrap;
    }

    .account {
        font-weight: bold;
        text-decoration: underline;
    }

    .percent_width {
        width: 90px;
    }

    td {
        padding: 4px !important;
    }

    input {
        height: 30px !important;
    }

    .file {
        position: relative;
        overflow: hidden;
    }

    .tombol {
        position: absolute;
        font-size: 50px;
        opacity: 0;
        right: 0;
        top: 0;
    }
</style>
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Budget Management</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="@Url.Content("~/Finance/BudgetManagement")" class="m-nav__link">
                        <span class="m-nav__link-text">Budget Management</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Detail</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

