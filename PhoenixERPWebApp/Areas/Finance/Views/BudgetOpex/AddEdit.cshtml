    function processDetail(type) { 
        RequiredDetail();
        $("#BudgetMaster_RemarksProcess").removeAttr("required");
        var valid = $("#formbudgetopex").validate().form();
        if (valid) {  
            var gridDetail = $("#grid-BudgetMasterDetail").data("kendoGrid"); 
            var dataList = {
                BudgetMasterDetail: gridDetail.dataSource.data()
            }

            if (type == 1) {
                if ($("#BudgetMaster_TotalBudget").data("kendoNumericTextBox").value() == 0 && "@Model.IsOwner" == "True") {
                    swal('Warning', "the total budget must be more than 0", 'warning');
                    return false;
                } 
                callAction({ formId: "formbudgetopex", title: "submit", type: "POST", url: '@Url.Action("SaveDetail", "budgetopex")', objects: dataList });
            } else if (type == 2) {
                $("#BudgetMaster_RemarksProcess").attr("required", "required");
                callAction({ formId: "formbudgetopex", title: "reject", type: "PUT", url: '@Url.Action("RejectDetail", "budgetopex")', objects: dataList });
            } else if (type == 3) {
                callAction({ formId: "formbudgetopex", title: "approve", type: "PUT", url: '@Url.Action("ApproveDetail", "budgetopex")', objects: dataList });
            }
        }
    }

    $('#btn-save').click(function () {
        RequiredDetailRemove();
        $("#BudgetMaster_RemarksProcess").removeAttr("required");
        if (!isValid()) return; 
        callAction({ formId: "formbudgetopex", title: "save", type: "POST", url: '@Url.Action("Save", "budgetopex")' });
    });

