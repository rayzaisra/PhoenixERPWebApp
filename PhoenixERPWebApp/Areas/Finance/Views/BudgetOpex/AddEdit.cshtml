    function calculate_change(e) {
        var percent1 = $("#BudgetMaster_PercentageSpreadMonth1").data("kendoNumericTextBox").value();
        var percent2 = $("#BudgetMaster_PercentageSpreadMonth2").data("kendoNumericTextBox").value();
        var percent3 = $("#BudgetMaster_PercentageSpreadMonth3").data("kendoNumericTextBox").value();
        var percent4 = $("#BudgetMaster_PercentageSpreadMonth4").data("kendoNumericTextBox").value();
        var percent5 = $("#BudgetMaster_PercentageSpreadMonth5").data("kendoNumericTextBox").value();
        var percent6 = $("#BudgetMaster_PercentageSpreadMonth6").data("kendoNumericTextBox").value();
        var percent7 = $("#BudgetMaster_PercentageSpreadMonth7").data("kendoNumericTextBox").value();
        var percent8 = $("#BudgetMaster_PercentageSpreadMonth8").data("kendoNumericTextBox").value();
        var percent9 = $("#BudgetMaster_PercentageSpreadMonth9").data("kendoNumericTextBox").value();
        var percent10 = $("#BudgetMaster_PercentageSpreadMonth10").data("kendoNumericTextBox").value();
        var percent11 = $("#BudgetMaster_PercentageSpreadMonth11").data("kendoNumericTextBox").value();
        var percent12 = $("#BudgetMaster_PercentageSpreadMonth12").data("kendoNumericTextBox").value();
        var total = percent1 + percent2 + percent3 + percent4 + percent5 + percent6 + percent7 + percent8 + percent9 + percent10 + percent11 + percent12;
        $("#BudgetMaster_TotalPercentageSpreadMonth").data("kendoNumericTextBox").value(Math.round(total));
    }

    function totalBudget_changeEvent() {
        var totalBudget = $("#BudgetMaster_TotalBudget").data("kendoNumericTextBox").value();
        var percent1 = $("#BudgetMaster_PercentageSpreadMonth1").data("kendoNumericTextBox").value();
        var percent2 = $("#BudgetMaster_PercentageSpreadMonth2").data("kendoNumericTextBox").value();
        var percent3 = $("#BudgetMaster_PercentageSpreadMonth3").data("kendoNumericTextBox").value();
        var percent4 = $("#BudgetMaster_PercentageSpreadMonth4").data("kendoNumericTextBox").value();
        var percent5 = $("#BudgetMaster_PercentageSpreadMonth5").data("kendoNumericTextBox").value();
        var percent6 = $("#BudgetMaster_PercentageSpreadMonth6").data("kendoNumericTextBox").value();
        var percent7 = $("#BudgetMaster_PercentageSpreadMonth7").data("kendoNumericTextBox").value();
        var percent8 = $("#BudgetMaster_PercentageSpreadMonth8").data("kendoNumericTextBox").value();
        var percent9 = $("#BudgetMaster_PercentageSpreadMonth9").data("kendoNumericTextBox").value();
        var percent10 = $("#BudgetMaster_PercentageSpreadMonth10").data("kendoNumericTextBox").value();
        var percent11 = $("#BudgetMaster_PercentageSpreadMonth11").data("kendoNumericTextBox").value();
        var percent12 = $("#BudgetMaster_PercentageSpreadMonth12").data("kendoNumericTextBox").value();
        var gridDetail = $("#grid-BudgetMasterDetail").data("kendoGrid"); 

        $.each(gridDetail.dataSource.view(), function (key, data) { 
            var result = data;
            result.Budget01 = (totalBudget * (data.CostSharingAllocationPercent / 100)) * (percent1 / 100);
            result.Budget02 = (totalBudget * (data.CostSharingAllocationPercent / 100)) * (percent2 / 100);
            result.Budget03 = (totalBudget * (data.CostSharingAllocationPercent / 100)) * (percent3 / 100);
            result.Budget04 = (totalBudget * (data.CostSharingAllocationPercent / 100)) * (percent4 / 100);
            result.Budget05 = (totalBudget * (data.CostSharingAllocationPercent / 100)) * (percent5 / 100);
            result.Budget06 = (totalBudget * (data.CostSharingAllocationPercent / 100)) * (percent6 / 100);
            result.Budget07 = (totalBudget * (data.CostSharingAllocationPercent / 100)) * (percent7 / 100);
            result.Budget08 = (totalBudget * (data.CostSharingAllocationPercent / 100)) * (percent8 / 100);
            result.Budget09 = (totalBudget * (data.CostSharingAllocationPercent / 100)) * (percent9 / 100);
            result.Budget10 = (totalBudget * (data.CostSharingAllocationPercent / 100)) * (percent10 / 100);
            result.Budget11 = (totalBudget * (data.CostSharingAllocationPercent / 100)) * (percent11 / 100);
            result.Budget12 = (totalBudget * (data.CostSharingAllocationPercent / 100)) * (percent12 / 100);
            gridDetail.dataSource.remove(data);
            gridDetail.dataSource.add(result); 
        }); 
    }

