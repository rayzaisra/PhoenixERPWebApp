@inject Phoenix.WebExtension.Attributes.MenuAuthorization menuAuthorization;
@{
    ViewData["Title"] = "Cash Advance";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";

    var privilege = await menuAuthorization.GetPrivilege("Finance", "CashAdvance");
    if (!privilege.IsRead) { throw new Exception("You have no authorization to the current access."); }
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Cash Advance</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="Index" asp-controller="CashAdvance" asp-area="Finance" class="m-nav__link">
                        <span class="m-nav__link-text">Cash Advance</span>
                    </a> 
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div>
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                @(Html.Kendo().DropDownList()
                                    .Name("LegalEntityId")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .Filter(FilterType.Contains)
                                    .DataSource(source =>
                                    {
                                        source.Read(read =>
                                        {
                                            read.Action("GetLegalEntity", "Dropdown");
                                        });
                                    })
                                    .OptionLabel("Legal Entity")
                                    .Events(e => e.Change("onFilterMode"))
                                    .HtmlAttributes(new { style = "width:100%; min-width:150px;" })
                                )
                            </li>
                            <li class="m-portlet__nav-item">
                                @(Html.Kendo().DropDownList()
                                    .Name("MainServiceCategoryId")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .OptionLabel($"Main Service Category")
                                    .HtmlAttributes(new { style = "width:100%; min-width:170px;" })
                                    .Filter(FilterType.Contains)
                                    .DataSource(source => source
                                        .Custom()
                                        .Transport(transport => transport
                                        .Read(read =>
                                        {
                                            read.Action("GetDDLMainserviceCategory", "Dropdown", new { area = "Pm" });
                                        }))
                                        .ServerFiltering(true)
                                    )
                                    .Events(e => e.Change("onFilterMode"))
                                )
                            </li>
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Finance.CashAdvance>()
                        .Name("grid")
                        .Columns(columns =>
                        {
                            columns.Bound("").Title("#").Width(50).Filterable(false)
                                 .HtmlAttributes(new { style = "text-align:center;", @class = "row-number" })
                                 .HeaderHtmlAttributes(new { style = "text-align:center;" });
                            columns.Bound(p => p.CaNumber).ClientTemplateId("code-template").Title("CA Request ID").Width(150);
                            columns.Bound(p => p.CaDate).Title("Date Request").Width(130);
                            columns.Bound(p => p.PcaId).Title("PCA ID").Width(150);
                            columns.Bound(p => p.JobName).Title("Job ID-Name").Width(250);
                            columns.Bound(p => p.RequestedBy).Title("Employee").Width(180);
                            columns.Bound(p => p.RequestBusinessUnitName).Width(200);
                            columns.Bound(p => p.BusinessUnitName).Width(200);
                            columns.Bound(p => p.LegalEntityName).Width(200);
                            columns.Bound(p => p.MainServiceCategoryName).Width(200);
                            columns.Bound(p => p.Amount).ClientTemplate("#if(CurrencySymbol!=null && Amount!=null){# #=CurrencySymbol# #}# #if(Amount!=null){# #=kendo.format('{0:n2}', Amount)# #}#").Width(150).HtmlAttributes(new { style = "text-align:right;" });
                            columns.Bound(p => p.Status).ClientTemplate("#= GetStatusButton(data) #").Width(150);
                            //columns.Bound(p => p.StatusCASettlement).Width(150);
                        })
                        .Pageable(pageable => pageable
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
                        .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                        .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                            .Extra(false)
                            .Operators(operators => operators
                            .ForString(str => str.Clear()
                                .Contains("Contains")
                                .StartsWith("Start sWith")
                                .EndsWith("End sWith")
                            )))
                        .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                        .Resizable(rsz => rsz.Columns(true))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(10)
                            .Events(events => events.Error("errorHandler"))
                            .Model(model =>
                            {
                                model.Id(p => p.Id);
                            })
                            .Read(read => read.Action("Read", "CashAdvance").Data("grid_params"))
                        )
                        .Events(x => x.DataBound("dataBoundEvent"))
                    )
                </div>
            </div>
        </div>
    </div>
</div> 

<script id="code-template" type="text/x-kendo-template">
    <a href='javascript: void(0);' onclick='View(this)' title='Edit' class='edit'><span style='color:blue; text-decoration:underline;'>#=CaNumber#</span></a>
</script>
<script>
    function GetStatusButton(data) {
        var buttonType = "";
        if (data.Status == "@PhoenixERPWebApp.Models.StatusTransactionName.Draft") buttonType = "m-badge--info";
        else if (data.Status == "@PhoenixERPWebApp.Models.StatusTransactionName.WaitingApproval") buttonType = " m-badge--warning";
        else if (data.Status == "@PhoenixERPWebApp.Models.StatusTransactionName.Rejected") buttonType = " m-badge--danger";
        else if (data.Status == "@PhoenixERPWebApp.Models.StatusTransactionName.Approved") buttonType = " m-badge--success";
        else if (data.Status == "@PhoenixERPWebApp.Models.StatusTransactionName.Completed") buttonType = " m-badge--success";
        return "<center><a href='javascript: void(0);' onclick='View(this)' class='m-badge " + buttonType + " m-badge--wide'>" + data.Status+"</a></center>";
    }

    function View(e) {
        var item = dataItem(e);
        window.location.href = '@Url.Action("Detail", "CashAdvance")?Id=' + item.Id;
    }     

    function onFilterMode() {
        mApp.block("#m_blockui_list", {
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        });

        var grid = $("#grid").data("kendoGrid");
        grid.dataSource.read();
        grid.refresh();
        mApp.unblock("#m_blockui_list");         
    };

    function grid_params() {
        return {
            legalEntityId: $("#LegalEntityId").data("kendoDropDownList").value(),
            mainServiceCategoryId: $("#MainServiceCategoryId").data("kendoDropDownList").value()
        };
    }
    
