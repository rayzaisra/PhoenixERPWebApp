@model PhoenixERPWebApp.Models.Finance.CashAdvance
<div class="row">
    <div class="col-lg-4 col-sm-6 col-xs-12 m-form__group-sub">
        <div class="form-group">
            <label>Job ID-Name</label> :
            @(Html.Kendo().ComboBoxFor(x => x.JobId)
                .DataTextField("Text")
                .DataValueField("Value") 
                .Placeholder($"Choose a {Html.DisplayNameFor(m => m.JobId)}")
                .HtmlAttributes(new { style = "width: 100%", @readonly = "readonly" })
                .Filter(FilterType.Contains)
                .DataSource(source => source
                    .Custom()
                    .Transport(transport => transport
                    .Read(read =>
                    {
                        read.Action("GetDDLJobNotExistsInPCAandJobId", "Dropdown", new { area = "Finance" }).Data("job_params");
                    }))
                    .ServerFiltering(true)
                ))
        </div>
    </div>
    <div class="col-lg-4 col-sm-6 col-xs-12 m-form__group-sub">
        <div class="form-group">
            <label asp-for="ClientId"></label> :
            @(Html.Kendo().ComboBoxFor(x => x.ClientId)
                .DataTextField("Text")
                .DataValueField("Value")
                .Filter(FilterType.Contains)
                .Suggest(true)
                .HtmlAttributes(new { style = "width: 100%", @readonly = "readonly" })
                .Placeholder($"Choose a {Html.DisplayNameFor(m => m.ClientId)}")
                .DataSource(source => source
                    .Custom()
                    .Transport(transport => transport
                    .Read(read =>
                    {
                        read.Action("GetDDLClientInv", "Dropdown", new { area = "Finance" });
                    }))
                    .ServerFiltering(true)
                )
            )
        </div>
    </div>
    <div class="col-lg-4 col-sm-6 col-xs-12 m-form__group-sub">
        <div class="form-group"> 
            <label asp-for="ClientBrandId"></label> :
            @(Html.Kendo().ComboBoxFor(x => x.ClientBrandId)
                .DataTextField("Text")
                .DataValueField("Value") 
                .HtmlAttributes(new { style = "width: 100%", @readonly = "readonly" })
                .Filter(FilterType.Contains)
                .Placeholder($"Choose a {Html.DisplayNameFor(m => m.ClientBrandId)}")
                .DataSource(source => source
                    .Custom()
                    .Transport(transport => transport
                    .Read(read =>
                    {
                        read.Action("GetDDLBrand", "Dropdown", new { area = "finance" });
                    }))
                    .ServerFiltering(true)
                ))
        </div>
    </div>
</div>

