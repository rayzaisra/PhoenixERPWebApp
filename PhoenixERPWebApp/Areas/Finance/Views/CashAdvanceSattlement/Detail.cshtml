        var dataList = { CASettlementDetail: $("#DetailGrid").data("kendoGrid").dataSource.data() } 
        callActionFile({ formId: "form-ca-settlement", title: "save", type: "POST", url: '@Url.Action("save", "CashAdvanceSattlement")', objects: dataList }); 
