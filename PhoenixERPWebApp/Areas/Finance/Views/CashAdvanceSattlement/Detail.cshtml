        }

        var FileReceiptName = '@Model.FileReceiptName';
        if (FileReceiptName == '') { 
            if ("@ViewBag.isRequestor" == "False") { 
                $("#linkDownloadFileReceipt").text("-");
            }else{
                FileReceiptNameUpload(); 
            }
        } else {
            $("#linkDownloadFileReceipt").text(FileReceiptName);
        }

        var FileEvidenceName = '@Model.SectionUploadEvidenceName';
        if (FileEvidenceName == '') {
            if ("@ViewBag.isRequestor" == "False") { 
                $("#linkDownloadFileEvidence").text("-");
            }else{
                FileEvidenceNameUpload(); 
            }
        } else {
            $("#linkDownloadFileEvidence").text(FileEvidenceName);
        }
    });
    
