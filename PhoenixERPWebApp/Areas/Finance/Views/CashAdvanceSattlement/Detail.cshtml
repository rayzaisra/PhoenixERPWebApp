    function FileEvidenceNameUpload() {
        $("#linkDownloadFileEvidence").empty();
        $("#linRemoveFileEvidence").empty();
        $("#divFileEvidence").empty().append("<input name='evidenceFile' id='evidenceFile' type='file'/>");

        $("#evidenceFile").kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".jpg", ".png", ".gif", ".doc", ".pdf", ".docx", ".rar", ".zip"]
            }
        });
    } 



