    function FileReceiptNameUpload() {
        $("#linkDownloadFileReceipt").empty();
        $("#linRemoveFileReceipt").empty();
        $("#divFileReceived").empty().append("<input name='receiptFile' id='receiptFile' type='file'/>");

        $("#receiptFile").kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".jpg", ".png", ".gif", ".doc", ".pdf", ".docx"]
            }
        });
    } 
        
