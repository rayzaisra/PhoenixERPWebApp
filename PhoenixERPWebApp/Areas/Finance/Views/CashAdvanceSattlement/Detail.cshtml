@inject Phoenix.WebExtension.Attributes.MenuAuthorization menuAuthorization;
@model PhoenixERPWebApp.Models.Finance.CASettlement
@{
    ViewData["Title"] = "Cash Advance Settlement";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";

    DateTime? EffectiveDate = DateTime.Now;
    DateTime? EndDate = DateTime.Now;

    var privilege = await menuAuthorization.GetPrivilege("Finance", "CashAdvanceSattlement");
    if (!privilege.IsRead && !ViewBag.IsRead) { throw new Exception("You have no authorization to the current access."); }
} 
<style>
    .k-numerictextbox .k-input {
        text-align: right;
        padding-right:10px;
