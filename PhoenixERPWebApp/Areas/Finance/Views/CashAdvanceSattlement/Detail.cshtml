    function isValid() {
        var valid = $("#form-ca-settlement").validate().form();
        if (valid) { 
            var grid = $("#DetailGrid").data("kendoGrid");
            grid.saveRow();
             
            var data = grid.dataSource.data(); 
            if (data.length == 0) {
                swal('Warning', 'Cash Advance Settlement Detail cannot be empty.', 'warning');
                return false;
            }

            for (var i = 0; i < data.length; i++) {
                if (data[i].UnitPrice == null) {
                    swal('Warning', "please input unit price value in settlement detail", 'warning');
                    return false;
                }
                if (data[i].Qty == null) {
                    swal('Warning', "please input qty value in settlement detail", 'warning');
                    return false;
                }

                if (data[i].PurchaseDate == null) {
                    swal('Warning', 'please input date purchasing in settlement detail', 'warning');
                    return false;
                }
            } 
            return true;
        } else {
            return false;
        }
    }

