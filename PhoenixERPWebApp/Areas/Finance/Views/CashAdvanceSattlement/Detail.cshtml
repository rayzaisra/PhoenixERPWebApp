    function vatPercent_change() {
        var gridDetail = $("#DetailGrid").data("kendoGrid");
        gridDetail.saveRow();
        CallculateAll();
    } 
     
    function SaveDetail(e) {  
        var UnitPrice = $("#UnitPrice").data("kendoNumericTextBox").value();
        var Qty = $("#Qty").data("kendoNumericTextBox").value();
        var PurchaseDate = $("#PurchaseDate").data("kendoDatePicker").value(); 

        var Amount = $("#Amount").data("kendoNumericTextBox").value();
        var TotalExchangeAmount = $("#TotalExchangeAmount").data("kendoNumericTextBox").value();
        //var ExchangeRateRequest = $("#ExchangeRate").data("kendoNumericTextBox").value();

        if (TotalExchangeAmount > e.model.TotalExchangeRequest) {
            swal('Warning', "The total price exchange value should not exceed the value of the original budget request", 'warning');
            e.preventDefault();
            return false;
        }

        e.model.set("UnitPrice", UnitPrice);
        e.model.set("Qty", Qty);
        e.model.set("Amount", Amount);
        e.model.set("TotalExchangeAmount", TotalExchangeAmount); 
        e.model.set("PurchaseDate", PurchaseDate);
        CallculateAll(); 
    }

    function removeDetail(e) {
        var models = $("#DetailGrid").data("kendoGrid").dataSource.data().filter((x) => { return x.Id != e.model.Id });
        var subTotal = 0;

        $.each(models, function (index, data) {
            if (data.Amount != 0) {
                subTotal += data.Amount;
            }
        });         
        ReCallculateAll(subTotal) 
    }

    function CallculateAll() {
        var subTotal = 0; 
        var models = $("#DetailGrid").data("kendoGrid").dataSource.data(); 
        $.each(models, function (index, data) {
            if (data.Amount != null) {
                subTotal += data.Amount;
            }
        });
        ReCallculateAll(subTotal);
    };

    function ReCallculateAll(subTotal) {
        var caAmount = $("#CashAdvance_Amount").data("kendoNumericTextBox").value();
        var vatPercent = $("#VatPercent").data("kendoNumericTextBox").value();
        var vat = subTotal * (vatPercent / 100);
        var total = subTotal + vat;
        var caBalance = caAmount - total;
        //var caBalance = caAmount - subTotal;

        $("#SubTotalAmount").data("kendoNumericTextBox").value(subTotal);
        $("#Vat").data("kendoNumericTextBox").value(vat);
        $("#TotalAmount").data("kendoNumericTextBox").value(total);
        $("#CaBalance").data("kendoNumericTextBox").value(caBalance);  
    }

    function removeFileReceipt() {
