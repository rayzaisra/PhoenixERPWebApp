<script>

    function CountVat() {
       var amount =  $("#Amount").data("kendoNumericTextBox").value();
        var varPercent = $("#VatPercent").data("kendoNumericTextBox").value();
        var vat = (amount) * (varPercent / 100);
        var total = (amount) + vat;
        $("#Vat").data("kendoNumericTextBox").value(vat);
        $("#VatOn").val((amount) + vat);
        $("#TotalAmount").data("kendoNumericTextBox").value(total);
        $("#Balance").data("kendoNumericTextBox").value($("#CashAdvanceCa").data("kendoNumericTextBox").value() - $("#TotalAmount").data("kendoNumericTextBox").value());

    }
     function ProcessData() {
            swal({
            title: "Are you sure want to Create Automatic Journal?",
            text: "You won't be able to revert this!",
            type: "warning",
            showCancelButton: !0,
            confirmButtonText: "Yes",
            cancelButtonText: "No",
            reverseButtons: !0
        }).then(function (ok) {
            if (ok.value) {
                mApp.block("#m_blockui_list", {
                    overlayColor: "#000000",
                    type: "loader",
                    state: "primary",
                    message: "Processing..."
                });

                var object = {};
                var params = $("#form-ca-settlement").serializeArray();
                $.each(params, function (i, val) {
                    object[val.name] = val.value;
                });

                var gridDetails = $("#DetailGrid").data("kendoGrid");
                gridDetails.saveRow();
                var dataList = {
                    details: gridDetails.dataSource.data()
                }


                if (dataList !== undefined) {
                    $.each(dataList, function (i, val) {
                        var arry = [];
                        for (var z = 0; z < val.length; z++) {
                            var obj = JSON.parse(JSON.stringify(val[z]));
                            arry.push(obj);
                        }
                        object[i] = arry;
                    });
                }
                $.ajax({
                    type: 'POST',
                    url:'@Url.Action("CreateAndReadAutomaticJournal", "CashAdvanceSattlement")',
                    data: object,
                    dataType: 'json',
                    success: function (result) {
                        if (result.success) {
                            var grid = $("#gridjournal").data("kendoGrid");
                            grid.dataSource.read();
                        } else {
                            swal('Warning', result.message, 'warning');
                        }

                        mApp.unblock("#m_blockui_list");
                    },
                    error: function (e, t, s) {
                        swal('Information', 'Ooops, something went wrong !', 'info');
                        mApp.unblock("#m_blockui_list");
                    }
                }).then(setTimeout(function () {
                    mApp.unblock("#m_blockui_list");
                }, 2e3));
            }
        }).then(setTimeout(function () {
            mApp.unblock("#m_blockui_list");
        }, 2e3));
    }

