    function removeCADetail(e) {
        var models = $("#DetailGrid").data("kendoGrid").dataSource.data().filter((x) => { return x.Id != e.model.Id });
        var subTotal = 0;

        $.each(models, function (index, data) {
            if (data.ActualUnitPrice != 0) {
                subTotal += data.ActualUnitPrice;
            }
        });
        var varPercent = 10;
        var amount = subTotal;
        $("#Amount").data("kendoNumericTextBox").value(amount);
        $("#VatPercent").data("kendoNumericTextBox").value(varPercent);
        var vat = (amount) * (varPercent / 100);
        var total = amount + vat;
        $("#Vat").data("kendoNumericTextBox").value(vat);
        $("#VatOn").val(amount + vat);
        $("#TotalAmount").data("kendoNumericTextBox").value(total);
    }

    function onChangeValue() {
        var varPercent = 0;
        var amount = 0;
        if ($("#Id").val() == "" || $("#Id").val() == null) {
            var models = $("#DetailGrid").data("kendoGrid").dataSource.data();
            var subTotal = 0;

            $.each(models, function (index, data) {
                if (data.ActualUnitPrice != null) {
                    subTotal += data.ActualUnitPrice;
                }
            });

            if (subTotal == 0) {
                amount = 0;
            } else {
                amount = subTotal;
            }

            $("#Amount").data("kendoNumericTextBox").value(amount);

            if ($("#VatPercent").data("kendoNumericTextBox").value() != 0 && $("#VatPercent").data("kendoNumericTextBox").value() != null) {
                $("#VatPercent").data("kendoNumericTextBox").value($("#VatPercent").data("kendoNumericTextBox").value());
            } else {
                $("#VatPercent").data("kendoNumericTextBox").value(varPercent);
            }

            var vat = (amount) * (varPercent / 100);
            var total = (amount) + vat ;
            $("#Vat").data("kendoNumericTextBox").value(vat);
            $("#VatOn").val((amount) + vat);
            $("#TotalAmount").data("kendoNumericTextBox").value(total);
            $("#Balance").data("kendoNumericTextBox").value($("#CashAdvanceCa").data("kendoNumericTextBox").value() - $("#TotalAmount").data("kendoNumericTextBox").value());
        } else {
            var models = $("#DetailGrid").data("kendoGrid").dataSource.data();
            var subTotal = 0;

            $.each(models, function (index, data) {
                if (data.ActualUnitPrice != null) {
                    subTotal += data.ActualUnitPrice;
                }
            });
            if (subTotal == 0) {
                amount = 0;
            } else {
                amount = subTotal;
            }


            $("#Amount").data("kendoNumericTextBox").value(amount);

            if ($("#VatPercent").data("kendoNumericTextBox").value() != 0 && $("#VatPercent").data("kendoNumericTextBox").value()!=null) {
                $("#VatPercent").data("kendoNumericTextBox").value($("#VatPercent").data("kendoNumericTextBox").value());
            } else {
                $("#VatPercent").data("kendoNumericTextBox").value(varPercent);
            }

            var vat = ($("#Amount").data("kendoNumericTextBox").value()) * ($("#VatPercent").data("kendoNumericTextBox").value() / 100);
            var total = ($("#Amount").data("kendoNumericTextBox").value()) + vat ;
            $("#Vat").data("kendoNumericTextBox").value(vat);
            $("#VatOn").val(($("#Amount").data("kendoNumericTextBox").value()) + vat);
            $("#TotalAmount").data("kendoNumericTextBox").value(total);
            $("#Balance").data("kendoNumericTextBox").value($("#CashAdvanceCa").data("kendoNumericTextBox").value() - $("#TotalAmount").data("kendoNumericTextBox").value());
        }
    };
