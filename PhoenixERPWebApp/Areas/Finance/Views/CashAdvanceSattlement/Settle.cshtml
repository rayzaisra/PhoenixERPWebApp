@model PhoenixERPWebApp.Models.Finance.CashAdvanceSattlement
@{
    ViewData["Title"] = "Cash Advance Settlement";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";

    DateTime? EffectiveDate = DateTime.Now;
    DateTime? EndDate = DateTime.Now;
}

<!-- BEGIN: Subheader -->
<style>
    #DetailGrid tr:not(.k-grid-edit-row) > td.client-edit-template > .edit-only {
        display: none;
    }

    #DetailGrid tr.k-grid-edit-row > td.client-edit-template > *:not(.edit-only) {
        display: none;
    }
    .k-footer-template {
        text-align: right;
    }
</style>
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Cash Advance Settlement</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="@Url.Content("~/Finance/CashAdvanceSattlement")" class="m-nav__link">
                        <span class="m-nav__link-text">Cash Advance Settlement</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Settlement</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

<div class="m-content">
    <div class="row">
        <!--NEW -->
        <div class="col-xl-12 col-lg-12">
            <!--begin::Portlet-->
            <div class="m-portlet m-portlet--last m-portlet--head-sm m-portlet--responsive-mobile" id="main_portlet">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-wrapper">
                        <div class="m-portlet__head-caption">
                            <div class="m-portlet__head-title">
                                <h3 class="m-portlet__head-text m--font-success">
                                    &nbsp;

                                </h3>
                                <h3 class="m-portlet__head-text m--font-success">
                                    <span id="status"></span>
                                    <span>Cash Advance Settlement  &nbsp;</span>
                                     @if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Draft)
                                    {<span class="m-badge m-badge--info m-badge--wide" id="lblstatus">@Model.Status</span> }
                                    else if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.WaitingApproval)
                                    { <span class="m-badge m-badge--warning m-badge--wide" id="lblstatus">@Model.Status</span> }
                                    else if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Rejected)
                                    { <span class="m-badge m-badge--danger m-badge--wide" id="lblstatus">@Model.Status</span> }
                                    else if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Approved)
                                    { <span class="m-badge m-badge--success m-badge--wide" id="lblstatus">@Model.Status</span>}
                                    else if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Completed)
                                    { <span class="m-badge m-badge--success m-badge--wide" id="lblstatus">@Model.Status</span>}
                                    <span id="status"></span>
                                </h3>
                            </div>
                        </div>
                        <div class="m-portlet__head-tools">


                            <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_qf2tcah4xx"><i class="la la-expand"></i></a>

                        </div>
                    </div>
                </div>

                <input hidden name="approval_id" />

                <div class="m-portlet__body">
                    <!--begin::Form-->
                    <form id="form-ca-settlement" class="m-form">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="SattlementNumber" />
                        <input type="hidden" asp-for="CashAdvanceId" />
                        <input type="hidden" asp-for="CashAdvanceSettleDate" />
                        <input type="hidden" asp-for="MainServiceCategoryId" />
                        <input type="hidden" asp-for="RequestEmployeeId" />
                        <input type="hidden" asp-for="BankId" />
                        <input type="hidden" asp-for="AccountNumber" />
                        <input type="hidden" asp-for="Status" />
                        <!-- Start: Header -->

                        @await Html.PartialAsync("_SettlementDetail", Model)

                        <br>
                        <div class="row" id="job_data_detail" style="display:block">
                            <div class="col-lg-12 m-row--no-padding">
                                <div class="m-accordion m-accordion--bordered m-accordion--solid" id="job_detail" role="tablist">
                                    <!--begin::Item-->
                                    <div class="m-accordion__item">
                                        <div class="m-accordion__item-head" role="tab" id="job_detail_head" data-toggle="collapse" href="#job_detail_body" aria-expanded="true">
                                            <span class="m-accordion__item-icon"><i class="fa flaticon-interface-4"></i></span>
                                            <span class="m-accordion__item-title">Job Request Detail</span>
                                            <span class="m-accordion__item-mode"></span>
                                        </div>
                                        <div class="m-accordion__item-body show" id="job_detail_body" role="tabpanel" aria-labelledby="job_detail_head" data-parent="#job_detail" style="">
                                            <div class="m-accordion__item-content">
                                                @await Html.PartialAsync("_BusinessPurposeDetail", Model)
                                                <br>
                                                <div class="alert m-alert--default" role="alert">
                                                    Advance to
                                                </div>
                                                <div class="row">
                                                    <div class="col-lg-6 m-form__group-sub">
                                                        <div class="form-group">
                                                            <label>Name / Company</label>
                                                            <br />
                                                            @(Html.Kendo().DropDownListFor(m => m.VendorId)
                                                                                                                  .DataTextField("Text")
                                                                                                                  .DataValueField("Value")
                                                                                                                  .OptionLabel("Choose Vendor Name")
                                                                                                                  .HtmlAttributes(new { style = "width:100%;", required = "required", @readonly = "readonly", @class = "ddlClass" })
                                                                                                                  .Filter(FilterType.Contains)
                                                                                                                  .DataSource(source => source
                                                                                                                      .Custom()
                                                                                                                      .Transport(transport => transport
                                                                                                                      .Read(read =>
                                                                                                                      {
                                                                                                                          read.Action("GetDDLVendorList", "Dropdown");
                                                                                                                      }))
                                                                                                                      .ServerFiltering(false)
                                                                                                                  ))
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-6 m-form__group-sub">
                                                        <div class="form-group">
                                                            <label>PIC</label>
                                                            <br />
                                                            @Html.Kendo().TextBoxFor(m => m.VendorPIC).HtmlAttributes(new
                                                            {
                                                                style = "width:100%",
                                                                @readonly = "readonly",
                                                                @class = "m-input"
                                                            })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-lg-6 m-form__group-sub">
                                                        <div class="form-group">
                                                            <label>Bank Name</label>
                                                            <br />
                                                            @Html.Kendo().TextBoxFor(m => m.PayeeBankId).HtmlAttributes(new { @class = "form-control form-control-sm", style = "width:100%", @placeholder = "Account Name", @readonly = "readonly" })

                                                        </div>
                                                    </div>
                                                    <div class="col-lg-6 m-form__group-sub">
                                                        <div class="form-group">
                                                            <label>Account Number</label>
                                                            <br />
                                                            @Html.Kendo().TextBoxFor(m => m.PayeeAccountNumber).HtmlAttributes(new { @class = "form-control form-control-sm", style = "width:100%", @placeholder = "Account Number", @readonly = "readonly" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-lg-6 m-form__group-sub">
                                                        <div class="form-group">
                                                            <label>Account Name</label>
                                                            <br />
                                                            @Html.Kendo().TextBoxFor(m => m.PayeeAccountName).HtmlAttributes(new { @class = "form-control form-control-sm", style = "width:100%", @placeholder = "Account Number", @readonly = "readonly" })
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-6 m-form__group-sub">
                                                        <div class="form-group">
                                                            <label>Tax Registration / NPWP :</label>
                                                            <br />
                                                            @Html.Kendo().TextBoxFor(m => m.VendorTaxNumber).HtmlAttributes(new
                                                            {
                                                            style = "width:100%",
                                                            @readonly = "readonly",
                                                            @class = "m-input"
                                                            })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-lg-6 m-form__group-sub">
                                                        <div class="form-group">
                                                            <label>Address</label>
                                                            <br />
                                                            @Html.Kendo().TextBoxFor(m => m.VendorAddress).HtmlAttributes(new
                                                            {
                                                                style = "width:100%",
                                                                @readonly = "readonly",
                                                                @class = "m-input"
                                                            })
                                                        </div>
                                                    </div>
                                                </div>
                                                <br>
                                                <label class="control-label">(Maximum 30 Calender Days)</label>
                                                <div class="row">
                                                    <div class="col-md-4">

                                                        <div class="form-group">
                                                            <label asp-for="CaPeriodFrom"></label> <span class="req">*</span> :
                                                            @(Html.Kendo().DatePickerFor(m => m.CaPeriodFrom)
                                                                                                          .Format("dd MMM yyyy")
                                                                                                          .Min($"{EffectiveDate}")
                                                                                                          .HtmlAttributes(new
                                                                                                          {
                                                                                                              @readonly = "readonly",
                                                                                                              style = "width:100%",
                                                                                                              @class = "form-control form-control-sm m-input",
                                                                                                              required = "required",
                                                                                                              placeholder = $"Choose a {Html.DisplayNameFor(m => m.CaPeriodFrom)}",
                                                                                                              onkeydown = "javascript:return false;"
                                                                                                          })
                                                            )

                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">

                                                        <div class="form-group">
                                                            <label asp-for="CaPeriodFrom"></label> <span class="req">*</span> :
                                                            @(Html.Kendo().DatePickerFor(m => m.CaPeriodTo)
                                                                                                          .Format("dd MMM yyyy")
                                                                                                          .Min($"{EffectiveDate}")
                                                                                                          .HtmlAttributes(new
                                                                                                          {
                                                                                                              @readonly = "readonly",
                                                                                                              style = "width:100%",
                                                                                                              @class = "form-control form-control-sm m-input",
                                                                                                              required = "required",
                                                                                                              placeholder = $"Choose a {Html.DisplayNameFor(m => m.CaPeriodTo)}",
                                                                                                              onkeydown = "javascript:return false;"
                                                                                                          })
                                                            )

                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        &nbsp;
                                                    </div>
                                                </div>
                                                <br />
                                                <div class="row">
                                                    <div class="col-sm-12">
                                                        <div class="form-group ">
                                                            <div class="alert m-alert--default" role="alert">
                                                                List Detail CA
                                                            </div>
                                                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Finance.CashAdvanceDetail>()
                                                                                                          .Name("grid")
                                                                                                          .Columns(columns =>
                                                                                                          {
                                                                                                              columns.Bound(p => p.CashAdvanceId).Hidden(true);
                                                                                                              columns.Bound(p => p.TaskId).Hidden(true);
                                                                                                              columns.Bound(p => p.TaskDetail).Width(250);
                                                                                                              columns.Bound(p => p.Qty).Width(80);
                                                                                                                                                          //columns.Bound(p => p.UnitPrice).Width(200);
                                                                                                                                                          columns.Bound(p => p.Amount).Width(200).EditorTemplateName("StringReadOnly");
                                                                                                              columns.Bound(p => p.TotalRequest).Width(200);
                                                                                                          })
                                                                                                          .AutoBind(false)
                                                                                                          .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                                                                                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                                                          .NoRecords()
                                                                                                          .DataSource(dataSource => dataSource
                                                                                                              .Ajax()
                                                                                                              .Events(events =>
                                                                                                              {
                                                                                                                  events.Error("errorHandler").Change("onChange");
                                                                                                              })
                                                                                                              .Model(model =>
                                                                                                              {
                                                                                                                  model.Id(p => p.Id);
                                                                                                                  model.Field(p => p.Id).DefaultValue("1");
                                                                                                                  model.Field(p => p.CashAdvanceId).DefaultValue("1");
                                                                                                                  model.Field(p => p.Amount).DefaultValue(0);
                                                                                                              })
                                                                                                              .Read(read => read.Action("ReadDetail2", "CashAdvance", new { caId = Model.CashAdvanceId }))
                                                                                                              .Create(update => update.Action("EditingInline_Create2", "CashAdvance"))
                                                                                                              .Update(update => update.Action("EditingInline_Update2", "CashAdvance"))
                                                                                                              .Destroy(update => update.Action("EditingInline_Destroy2", "CashAdvance"))
                                                                                                              )
                                                                                                              .Events(x => x.Save("saveCADetailList"))
                                                            )
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row ">
                                                    <div class="col-lg-8"><div class="pull-right">Cash Advance Received</div></div>
                                                    <div class="col-lg-4">
                                                        <div class="form-group">
                                                            @(Html.Kendo().NumericTextBoxFor(m => m.CashAdvanceCa)
                                                                                                          .Spinners(false)
                                                                                                          .Format("{0:N0}")
                                                                                                          .HtmlAttributes(new
                                                                                                          {
                                                                                                              style = "width:100%",
                                                                                                              @readonly = "readonly"
                                                                                                          }
                                                                                                      ))
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <br>
                        <div class="row" id="satelement_data_detail" style="display:block">
                            <div class="col-lg-12 m-row--no-padding">
                                <div class="m-accordion m-accordion--bordered m-accordion--solid" id="satelement_detail" role="tablist">
                                    <!--begin::Item-->
                                    <div class="m-accordion__item">
                                        <div class="m-accordion__item-head" role="tab" id="satelement_detail_head" data-toggle="collapse" href="#satelement_detail_body" aria-expanded="true">
                                            <span class="m-accordion__item-icon"><i class="fa flaticon-interface-4"></i></span>
                                            <span class="m-accordion__item-title">Sattlement Detail</span>
                                            <span class="m-accordion__item-mode"></span>
                                        </div>
                                        <div class="m-accordion__item-body show" id="satelement_detail_body" role="tabpanel" aria-labelledby="satelement_detail_head" data-parent="#satelement_detail" style="">
                                            <div class="m-accordion__item-content">
                                                <div class="row">
                                                    <div class="col-sm-12">
                                                        <div class="form-group ">

                                                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Finance.CashAdvanceSettlementDetail>()
                                                                                                          .Name("DetailGrid")
                                                                                                          //.ToolBar(toolBar =>
                                                                                                          //{
                                                                                                          //    if (Model.CaStatusId == PhoenixERPWebApp.Models.Enum.CashAdvanceStatus.Open)
                                                                                                          //        toolBar.Create();

                                                                                                          //})
                                                                                                          .Columns(columns =>
                                                                                                          {
                                                                                                              if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Draft)
                                                                                                              {
                                                                                                                  columns.Command(command =>
                                                                                                                  {
                                                                                                                      command.Edit().Text(" ").UpdateText(" ").CancelText(" ");
                                                                                                                  }).Title("Action").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(90);
                                                                                                              }

                                                                                                              columns.Bound(p => p.TaskName).Width(200);
                                                                                                              columns.Bound(p => p.ActualQty).Width(100);
                                                                                                              columns.Bound(p => p.ActualUnitPrice).Title("Actual Price").Width(150);
                                                                                                              columns.Bound(p => p.PurchaseDate).Title("Date Purchasing").Format("{0:dd  MMM  yyyy}").Width(150);
                                                                                                              columns.Bound(p => p.Receipt).Width(150).ClientTemplate("<a href='' onclick=\"downloadFileGrid(event)\"> #=FileReceiptNameDetail# </a>")
                                                                                                              .EditorTemplateName("Finance/CashAdvanceSettlement/Upload").Title("Upload File");
                                                                                                              //columns.Bound(p => p.AccountId).ClientTemplate("#=AccountName#")
                                                                                                              //.EditorTemplateName("Finance/CashAdvanceSettlement/COA").Title("Account Name").Width(200);
                                                                                                              //columns.Bound(p => p.AccountIdView).Title("Account Id").Width(200);
                                                                                                              columns.Bound(p => p.TempFileIdDetail).Title("File Id").Width(100).Hidden();
                                                                                                              columns.Bound(p => p.TaskId).Hidden();
                                                                                                          })
                                                                                                          .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                                                                                          .Editable(editable => editable.Mode(GridEditMode.InLine))
                                                                                                          .Resizable(rsz => rsz.Columns(true))
                                                                                                          .Scrollable(scrollable => scrollable.Height("auto"))
                                                                                                          .NoRecords()
                                                                                                          .DataSource(dataSource => dataSource
                                                                                                              .Ajax()
                                                                                                              .Events(events =>
                                                                                                              {
                                                                                                                  events.Error("errorHandler").Change("onChange");
                                                                                                              })

                                                                                                              .Model(model =>
                                                                                                              {
                                                                                                                  model.Id(p => p.Id);
                                                                                                                  model.Field(p => p.Id).DefaultValue("1").Editable(false);
                                                                                                                  //model.Field(p => p.CashAdvanceId).DefaultValue("1");
                                                                                                                  model.Field(p => p.Amount).DefaultValue(0).Editable(false);
                                                                                                                  model.Field(p => p.Qty).Editable(false);
                                                                                                                  model.Field(p => p.ActualQty).Editable(false);
                                                                                                                  model.Field(p => p.UnitPrice).Editable(false);
                                                                                                                  //model.Field(p => p.TempFileIdDetail).Editable(false);
                                                                                                                  model.Field(p => p.AccountIdView).Editable(false);
                                                                                                                  model.Field(p => p.TempFileIdDetail).DefaultValue("-").Editable(false);
                                                                                                              })
                                                                                                              .Create(update => update.Action("EditingSettlement_Create", "CashAdvanceSattlement"))
                                                                                                              .Update(update => update.Action("EditingSettlement_Update", "CashAdvanceSattlement"))
                                                                                                              //.Destroy(update => update.Action("EditingSettlement_Destroy", "CashAdvanceSattlement"))
                                                                                                              .Read(read => read.Action("ReadDetailSattelement", "CashAdvanceSattlement", new { Id = Model.CashAdvanceId })))
                                                                                                              .Events(e => e.Save("SaveCaDetail").Remove("removeCADetail"))
                                                            )
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row ">
                                                    <div class="col-lg-8"><div class="pull-right">SubTotal</div></div>
                                                    <div class="col-lg-4">
                                                        <div class="form-group">
                                                            @(Html.Kendo().NumericTextBoxFor(m => m.Amount)
                                                                                                  .Spinners(false)
                                                                                                  .Format("{0:N0}")
                                                                                                  .HtmlAttributes(new
                                                                                                  {
                                                                                                      style = "width:100%",
                                                                                                      @readonly = "readonly"
                                                                                                  }
                                                                                              ))
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row ">
                                                    <div class="col-lg-8"><div class="pull-right">Vat</div></div>
                                                    <div class="col-lg-1">
                                                        <div class="form-group">
                                                            @(Html.Kendo().NumericTextBoxFor(m => m.VatPercent)
                                                                                                  .Spinners(false)
                                                                                                  .Format("## \\%")
                                                                                                  .Events(x => x.Change("CountVat"))
                                                                                                  .HtmlAttributes(new
                                                                                                  {
                                                                                                      style = "width:100%"
                                                                                                  }
                                                                                              ))

                                                        </div>
                                                    </div>
                                                    <div class="col-lg-3">
                                                        <div class="form-group">
                                                            @(Html.Kendo().NumericTextBoxFor(m => m.Vat)
                                                                                                  .Spinners(false)
                                                                                                  .Format("{0:N0}")
                                                                                                  .HtmlAttributes(new
                                                                                                  {
                                                                                                      style = "width:100%",
                                                                                                      @readonly = "readonly"
                                                                                                  }
                                                                                              ))
                                                            <input type="hidden" asp-for="VatOn" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row ">
                                                    <div class="col-lg-8"><div class="pull-right">Total</div></div>
                                                    <div class="col-lg-4">
                                                        <div class="form-group">
                                                            @(Html.Kendo().NumericTextBoxFor(m => m.TotalAmount)
                                                                                                  .Spinners(false)
                                                                                                  .Format("{0:N0}")
                                                                                                  .HtmlAttributes(new
                                                                                                  {
                                                                                                      style = "width:100%",
                                                                                                      @readonly = "readonly"
                                                                                                  }
                                                                                              ))
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row ">
                                                    <div class="col-lg-8"><div class="pull-right">Balance</div></div>
                                                    <div class="col-lg-4">
                                                        <div class="form-group">
                                                            @(Html.Kendo().NumericTextBoxFor(m => m.Balance)
                                                                                                  .Spinners(false)
                                                                                                  .Format("{0:N0}")
                                                                                                  .HtmlAttributes(new
                                                                                                  {
                                                                                                      style = "width:100%",
                                                                                                      @readonly = "readonly"
                                                                                                  }
                                                                                              ))
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row ">
                                                    <div class="col-lg-8">
                                                    <div class="pull-right">Tax Payable</div></div>
                                                    <div class="col-lg-4">
                                                        <div class="form-group">
                                                            @(Html.Kendo().DropDownListFor(m => m.TaxPayCoaId)//coa
                                                                                          .DataTextField("Text")
                                                                                          .DataValueField("Value")
                                                                                          .Filter(FilterType.Contains)
                                                                                          .Events(e => e.Change("DDLTaxCoaChange"))
                                                                                          .DataSource(source =>
                                                                                          {
                                                                                              source.Read(read =>
                                                                                              {
                                                                                                  read.Action("GetCOAByNameLv5", "Dropdown", new { area = "Finance" });
                                                                                              });
                                                                                          })
                                                                                          .OptionLabel($"Choose a COA..")
                                                                                          .HtmlAttributes(new { style = "width:100%;", @required = "required" })
                                                            )
                                                        </div>
                                                    </div>
                                                    
                                                </div>
                                                <div class="row">
                                                    <div class="col-lg-8">
                                                        <div class="pull-right">Tax Payable Amount</div>
                                                    </div>
                                                    <div class="col-lg-4">
                                                        <div class="form-group">
                                                            @(Html.Kendo().NumericTextBoxFor(m => m.TaxPayable)
                                                                                          .Spinners(false)
                                                                                          .Format("{0:N0}")
                                                                                          .HtmlAttributes(new
                                                                                          {
                                                                                              style = "width:100%",
                                                                                              @readonly = "readonly"
                                                                                          }
                                                                                      ))
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-8">
                                                        <div class="pull-right">Transfer To</div>
