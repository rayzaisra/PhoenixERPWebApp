@model PhoenixERPWebApp.Models.CashFlow
@{
    ViewData["Title"] = "Input CashFlow";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">Input CashFlow</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                       <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Master Data</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="CashFlow" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Input CashFlow</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                     @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="CashFlow" asp-area="finance"  class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="CashFlow" asp-area="finance"  asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">@ViewBag.Header Input CashFlow</h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formCashFlow" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="CashFlow" asp-area="Finance">  
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedBy" />
                        <input type="hidden" asp-for="CreatedOn" />
                        <input type="hidden" asp-for="ModifiedBy" />
                        <input type="hidden" asp-for="ModifiedOn" />
                        <input type="hidden" asp-for="ApprovedBy" />
                        <input type="hidden" asp-for="ApprovedOn" />
                        <input type="hidden" asp-for="DeletedBy" />
                        <input type="hidden" asp-for="DeletedOn" />
                        <input type="hidden" asp-for="IsActive" />
                        <input type="hidden" asp-for="IsDefault" />
                        <input type="hidden" asp-for="IsDeleted" />
                        <input type="hidden" asp-for="OwnerId" />
                        <input type="hidden" asp-for="IsLocked" />
                        
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="Type"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().DropDownListFor(x => x.Type)
                                                 .DataTextField("Text")
                                                 .DataValueField("Value")
                                                 .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.Type)}")
                                                 .BindTo(new List<SelectListItem>() {
                                                                            new SelectListItem() { Text = "Receipt", Value = "Receipt" },
                                                                            new SelectListItem() { Text = "Disbursement", Value = "Disbursement" }
                                                 })
                                                 .HtmlAttributes(new { style = "width: 100%", @required = "required" })
                                    )
                                </div>
                                <div class="form-group">
                                    <label asp-for="BankId"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().DropDownListFor(m => m.BankId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.BankId)}")
                                                .HtmlAttributes(new { style = "width:100%;", @required = "required" })
                                                .Filter(FilterType.Contains)
                                                .Events(evt => evt.Select("bank_SelectEvent"))
                                                .DataSource(source => source
                                                    .Custom()
                                                    .Transport(transport => transport
                                                    .Read(read =>
                                                    {
                                                        read.Action("GetDDLBanksList", "Dropdown");
                                                    }))//;
                                                    .ServerFiltering(false)
                                                ))
                                </div>
                                <div class="form-group">
                                    <label asp-for="CFDate"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().DatePickerFor(m => m.CFDate)
                                        .Format("dd MMMM yyyy")
                                        .HtmlAttributes(new
                                        {
                                            style = "width: 100%",
                                            onkeydown = "javascript:return false;",
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.CFDate)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.CFDate)} is required"

                                        })
                                    )
                                </div>
                                <div class="form-group">
                                    <label asp-for="Description"></label> <span class="req">*</span>  :
                                    @Html.Kendo().TextBoxFor(m => m.Description).HtmlAttributes(new { style = "width:100%;", @placeholder = $"Input type a {Html.DisplayNameFor(m => m.Description)}", @required = "required" })
                                    @*@Html.TextAreaFor(x => x.Description, new { style = "height:100px;width:100%" })*@

                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="CurrencyId"></label> :
                                   @(Html.Kendo().DropDownListFor(m => m.CurrencyId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.CurrencyId)}")
                                        .HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" })
                                        .Filter(FilterType.Contains)
                                        .DataSource(source => source
                                            .Custom()
                                            .Transport(transport => transport
                                            .Read(read =>
                                            {
                                                read.Action("GetDDLCurrency", "Dropdown");
                                            }))
                                        .ServerFiltering(false)
                                    ))
                                </div>    
                                <div class="form-group">
                                    <label asp-for="Condition"></label> <span class="req">*</span>  :
                                   @(Html.Kendo().DropDownListFor(m => m.Condition)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.Condition)}")
                                        .HtmlAttributes(new { style = "width:100%;", @required = "required" })
                                        .Filter(FilterType.Contains)
                                        .DataSource(source => source
                                            .Custom()
                                            .Transport(transport => transport
                                            .Read(read =>
                                            {
                                                read.Action("GetDDLAccouningCondition", "Dropdown");
                                            }))
                                        .ServerFiltering(false)
                                    ))
                                </div> 
                                <div class="form-group">
                                    <label asp-for="Amount"></label> <span class="req">*</span> :                                           
                                    @(Html.Kendo().NumericTextBoxFor(m => m.Amount)
                                        .Spinners(false)
                                        .Format("{0:N2}")
                                        .HtmlAttributes(new { style = "width:100%", @required = "required" }
                                    ))
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="pull-right">
                                    <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                                    <a asp-action="index" asp-controller="CashFlow" asp-area="finance" class="fakelink btn btn-secondary">Close</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>  
    $('#btn-save').click(function () { 
        callAction({ formId:"formCashFlow", title: "save", type:"POST"});
    });

    
    function bank_SelectEvent(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;

            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $.ajax({
                type: "GET",
                dataType: "json",
                contentType: "application/x-www-form-urlencoded",
                async: false,
                data: { id: dataItem.Value },
                url: "@Url.Action("Get", "Bank")",
                success: function (result) {
                    if (result != null) {
                        $("#CurrencyId").data("kendoDropDownList").value(result.CurrencyId);
                    }
                },
                error: function (e, t, s) {
                    console.log(e)
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
            }, 2e3));
        }
    }
</script>