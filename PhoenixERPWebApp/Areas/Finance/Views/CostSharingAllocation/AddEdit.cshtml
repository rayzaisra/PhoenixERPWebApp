@model PhoenixERPWebApp.Models.CostSharingAllocation
@{
    ViewData["Title"] = "Cost Allocation Ratio";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">Cost Allocation Ratio</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                       <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Master Data</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="costsharingallocation" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Cost Allocation Ratio</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                     @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="costsharingallocation" asp-area="finance"  class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="costsharingallocation" asp-area="finance"  asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">@ViewBag.Header Cost Allocation Ratio</h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formCostSharingAllocation" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="costsharingallocation" asp-area="Finance">
                        <div class="row ">
                            <div class="col-lg-12">
                                @*<input type="hidden" asp-for="Id" />*@
                                <input type="hidden" asp-for="CreatedBy" />
                                @*<input type="hidden" asp-for="CreatedOn" />*@
                                <input type="hidden" asp-for="ModifiedBy" />
                                <input type="hidden" asp-for="ModifiedOn" />
                                <input type="hidden" asp-for="ApprovedBy" />
                                <input type="hidden" asp-for="ApprovedOn" />
                                <input type="hidden" asp-for="IsActive" />
                                <input type="hidden" asp-for="IsLocked" />
                                <input type="hidden" asp-for="IsDefault" />
                                <input type="hidden" asp-for="OwnerId" />
                                <input type="hidden" asp-for="DeletedBy" />
                                <input type="hidden" asp-for="DeletedOn" />
                                <input type="hidden" asp-for="IsDeleted" />

                                <div class="row">
                                    <div class="col-lg-6">
                                         <div class="form-group">
                                            <label asp-for="CostSharingAllocationName"></label> <span class="req">*</span>  :
                                            @(Html.Kendo().TextBoxFor(m => m.CostSharingAllocationName)
                                                .HtmlAttributes(new {
                                                    style = "width:100%",
                                                    maxlength = 400,
                                                    placeholder = $"Input type a {Html.DisplayNameFor(m => m.CostSharingAllocationName)}",
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.CostSharingAllocationName)} is required" 
                                                }
                                             ))
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label>Cost Allocatio Ratio ID</label>  :
                                            @Html.Kendo().TextBoxFor(m => m.Id).HtmlAttributes(new { style = "width:100%;", @readonly = "readonly", placeholder = $"Auto generated by system" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label>Create Date</label>  :
                                            @(Html.Kendo().DatePickerFor(m => m.CreatedOn)
                                               .HtmlAttributes(new
                                               {
                                                   style = "width:100%",
                                                   @readonly = "readonly",
                                                   placeholder = $"Auto generated by system",
                                                   onkeydown = "javascript:return false;"
                                               })
                                               .Format("dd MMMM yyyy"))
                                        </div>
                                    </div> 
                                </div>    
                                <br/>          
                                <div class="row">
                                    <div class="col-lg-12 m-row--no-padding">
                                        <div class="form-group">
                                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.CostSharingAllocationDetail>()
                                                .Name("grid-detail")
                                                .ToolBar(x => x.Create())
                                                .Columns(columns =>
                                                { 
                                                    columns.Command(command =>
                                                    {
                                                        command.Edit().Text(" ").UpdateText(" ").CancelText(" ");
                                                        command.Destroy().Text(" ");
                                                    }).Title("Action").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(50);
                                                    
                                                    columns.Bound(p => p.BusinessUnitId).ClientTemplate("#=BusinessUnitName#").EditorTemplateName("Finance/CostAllocation/DivisionIdDropdown").Width(150);
                                                    columns.Bound(p => p.CostSharingAllocationPercent).EditorTemplateName("Finance/CostAllocation/Number").ClientTemplate("#=kendo.format('{0:p2}', CostSharingAllocationPercent/100)#").Width(100);
                                                })
                                                .Editable(x => x.Mode(GridEditMode.InLine).DisplayDeleteConfirmation(true))
                                                .DataSource(dataSource => dataSource
                                                    .Ajax()
                                                    .Events(events => events.Error("errorHandler"))
                                                    .Model(model => { model.Id(p => p.Id); })
                                                    .Read(read => read.Action("ReadDetail", "costsharingallocation").Data("gridDetail_params"))
                                                    .Create(create => create.Action("CreateDetail", "costsharingallocation"))
                                                    .Update(update => update.Action("UpdateDetail", "costsharingallocation"))
                                                    .Destroy(destroy => destroy.Action("DestroyDetail", "costsharingallocation"))
                                                )
                                                .Events(e => e.Save("saveDetail_event"))
                                                .NoRecords()
                                            )
                                        </div>
                                    </div>
                                </div>
                                <div class="row ">
                                    <div class="col-lg-8"><div class="pull-right"> <label asp-for="TotalCostAllocationSharing"></label> :</div></div>
                                    <div class="col-lg-4"> 
                                        <div class="form-group">
                                            @(Html.Kendo().NumericTextBoxFor(x => x.TotalCostAllocationSharing)
                                            .Spinners(false)
                                            .Format("#,###.## \\%")
                                            .HtmlAttributes(new
                                            {
                                                style = "width:100%",
                                                @readonly = "readonly"
                                            }
                                        ))
                                        </div>
                                    </div>
                                </div>
                                <div class="row ">
                                    <div class="col-lg-8"><div class="pull-right"><label asp-for="BusinessUnitId"></label> <span class="req">*</span>  :</div></div>
                                    <div class="col-lg-4"> 
                                        <div class="form-group">
                                        @(Html.Kendo().DropDownListFor(x=>x.BusinessUnitId)
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.BusinessUnitId)}")
                                            .HtmlAttributes(new { style = "width:100%;", required = "required" })
                                            .Height(250)
                                            .Filter(FilterType.Contains)
                                            .DataSource(source => source
                                                .Custom()
                                                .Transport(transport => transport
                                                .Read(read =>
                                                {
                                                read.Action("GetDivisionFinance", "Dropdown", new { area = "Finance" });
                                            }))
                                            .ServerFiltering(false))
                                        )
                                        </div>
                                    </div>
                                </div>                                
                            </div>
                        </div> 
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="pull-right">
                                    <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                                    <a asp-action="index" asp-controller="costsharingallocation" asp-area="finance" class="fakelink btn btn-secondary">Close</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $('#btn-save').click(function () {
        if (!isValid()) return;
        callAction({ formId:"formCostSharingAllocation", title: "save", type:"POST", url: '@Url.Action("submit", "costsharingallocation")', objects: result()});
    });

    function isValid() {
        var valid = $("#formCostSharingAllocation").validate().form();
        if (valid) {
            var totalCost = $("#TotalCostAllocationSharing").data("kendoNumericTextBox").value();
            if (totalCost != 100) {
                swal('Warning', "The total cost allocation must be 100%", 'warning');
                return false;
            }

            return true;
        } else {
            return false;
        }
    }

    function result() {
        var grid = $("#grid-detail").data("kendoGrid");
        grid.saveRow();

        var dataList = {
            CostSharingAllocationDetails: grid.dataSource.data()
        }

        return dataList;
    }

    function gridDetail_params() {
        return {
            casId : "@Model.Id"
        }
    }

    function saveDetail_event(e) {
        var models = $("#grid-detail").data("kendoGrid").dataSource.data();
        var BusinessUnitId = $("#BusinessUnitId").data("kendoDropDownList").value();
        var BusinessUnitName = $("#BusinessUnitId").data("kendoDropDownList").text();
        var CostSharingAllocationPercent = $("#CostSharingAllocationPercent").data("kendoNumericTextBox").value();
        var details = models.filter((x) => { return x.BusinessUnitId == BusinessUnitId && x.Id != e.model.Id });
        if (details.length > 0) {
            swal('Warning', "Business unit " + BusinessUnitName + " already exists.", 'warning');
            e.preventDefault();
        }

        e.model.set("BusinessUnitId", BusinessUnitId);
        e.model.set("BusinessUnitName", BusinessUnitName);
        e.model.set("CostSharingAllocationPercent", CostSharingAllocationPercent);
        $("#TotalCostAllocationSharing").data("kendoNumericTextBox").value(TotalCost());
    }

    function TotalCost() { 
        var models = $("#grid-detail").data("kendoGrid").dataSource.data();
        var totalCost = 0; 

        $.each(models, function (index, data) {
            if (data.CostSharingAllocationPercent != null) {
                totalCost += data.CostSharingAllocationPercent;
            }
        });
       
        return totalCost;
    }
</script>