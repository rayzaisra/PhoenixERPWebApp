@{
    ViewData["Title"] = "Currency";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<style>
    .isdefault{
        background-color:lightgreen;
    }
</style>
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Currency</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Master Data</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="currency" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Currency</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div>
                                @if (ViewBag.isView == false)
                                {
                                    <a asp-action="addedit" asp-controller="currency" asp-area="finance" class="m-btn btn btn-primary btn-sm m-btn--sm" title="Add New Record"><i class="la la-plus"></i></a>
                                    @*<button id="btn-delete" type="button" class="m-btn btn btn-danger btn-sm m-btn--sm" title="Delete Selection"><i class="la la-trash"></i></button>*@
                                }
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Currency>()
                        .Name("grid")
                        .ToolBar(toolBar =>
                        {
                            if (ViewBag.isView == false)
                            {
                                toolBar.Custom().Text("Upload").Name("upload").HtmlAttributes(new { @id = "btnUpload", @onclick = "showUpload()" }).IconClass("k-icon k-i-upload");
                                toolBar.Custom().Text("Download").Name("download").HtmlAttributes(new { @id = "btnDownload", @onclick = $"downloadTemplate()" }).IconClass("k-icon k-i-download");
                            }
                        })
                        .Columns(columns =>
                        {
                            if (ViewBag.isView == false)
                            {
                                columns.Bound(x => x.Id).ClientTemplateId("btnAction-template").Title("Action").HtmlAttributes(new { style = "text-align:center;" })
                                .HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(90);
                            }
                            columns.Bound(x => x.Id).Title("#").Width(35).Filterable(false).HtmlAttributes(new { style = "text-align:center;", @class = "row-number" }).HeaderHtmlAttributes(new { style = "text-align:center;" });

                            columns.Bound(p => p.CurrencyCode).Width(120);
                            columns.Bound(p => p.CurrencyName).Width(250);
                            columns.Bound(p => p.CurrencySymbol).Width(150);
                            columns.Bound(p => p.Buy).ClientTemplate("#if(CurrencySymbolDefault!=null && Buy!=null){# #=CurrencySymbolDefault# #}# #if(Buy!=null){# #=kendo.format('{0:n2}', Buy)# #}#").Width(150).HtmlAttributes(new { style = "text-align:right;" });
                            columns.Bound(p => p.Sell).ClientTemplate("#if(CurrencySymbolDefault!=null && Sell!=null){# #=CurrencySymbolDefault# #}# #if(Sell!=null){# #=kendo.format('{0:n2}', Sell)# #}#").Width(150).HtmlAttributes(new { style = "text-align:right;" });
                        })
                        //.Pageable(pageable => pageable
                        //    .Refresh(true)
                        //    .PageSizes(true)
                        //    .ButtonCount(5))
                        .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                        .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                            .Extra(false)
                            .Operators(operators => operators
                            .ForString(str => str.Clear()
                                .Contains("Contains")
                                .StartsWith("Start sWith")
                                .EndsWith("End sWith")
                            )))
                        //.Scrollable(s => s.Enabled(true).Height("auto"))
                        .NoRecords()
                        .Resizable(rsz => rsz.Columns(true))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            //.PageSize(10)
                            .Events(events => events.Error("errorHandler"))
                            .Model(model => { model.Id(p => p.Id); })
                            .Read(read => read.Action("Read", "Currency"))
                        )
                        .Events(e => e.DataBound("onDataBound"))
                    )
                </div>
            </div>
        </div>
    </div>
</div>
<div id="window"></div>
<script id="btnAction-template" type="text/x-kendo-template">
    <a href='javascript: void(0);' onclick='editGridRow(this)' title='Edit' class='edit'><span style='color:green'><i class='fa fa-edit'></i></span></a>
    #if(IsDefault==false){#
    <a href='javascript: void(0);' onclick='deleteGridRow(this)' title='Delete' class='delete'><span style='color:maroon'><i class='fa fa-trash-alt'></i></span></a>
    #}#
</script>
<script>
    function onDataBound(e) {
        // iterate the table rows and apply custom row and cell styling 
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var rowLabel = $(rows[j]).find(".row-number");
            var pageSize = (e.sender.dataSource.pageSize() * (e.sender.dataSource.page() - 1));
            if (isNaN(pageSize)) { pageSize = 0; }
            var index = $(rows[j]).index() + 1 + pageSize;
            $(rowLabel).html(index);

            var dataItem = e.sender.dataItem(row); 

            //Claer Background color grid row
            row.removeClass("isdefault");
             
            if (dataItem.IsDefault === true) {
                row.addClass("isdefault");
            } 
        }
    }

    function editGridRow(e) {
        var item = dataItem(e);
        window.location.href = '@Url.Action("AddEdit", "Currency")?Id=' + item.Id;
    }

    function deleteGridRow(e) {
        deleteRow(e, '@Url.Action("Delete", "Currency")');
    }

    function downloadTemplate() {        
        window.location.href = "@Url.Action("DownloadTemplate","Currency",new { area="Finance"})";
    }

    function showUpload() {
         var window = $("#window").kendoWindow({
                width: "630px",
                actions: ["Close"],
                content: "@Url.Action("Upload", "Currency")",
                visible: false,
                modal: true
            }).data("kendoWindow").center().open();
            window.title("Upload - Currency");
    }
</script>