@model PhoenixERPWebApp.Models.EFaktur
@{
    ViewData["Title"] = "Master E-Faktur";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">Master E-Faktur</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                       <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Master Data</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="efaktur" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Master E-Faktur</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                     @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="efaktur" asp-area="finance"  class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="efaktur" asp-area="finance"  asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">@ViewBag.Header Master E-Faktur</h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formefaktur" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="efaktur" asp-area="Finance">
                        @*enctype="multipart/form-data"*@
                        <div class="row ">
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="CreatedBy" />
                            <input type="hidden" asp-for="CreatedOn" />
                            <input type="hidden" asp-for="ModifiedBy" />
                            <input type="hidden" asp-for="ModifiedOn" />
                            <input type="hidden" asp-for="ApprovedBy" />
                            <input type="hidden" asp-for="ApprovedOn" />
                            <input type="hidden" asp-for="DeletedBy" />
                            <input type="hidden" asp-for="DeletedOn" />
                            <input type="hidden" asp-for="IsActive" />
                            <input type="hidden" asp-for="IsDefault" />
                            <input type="hidden" asp-for="IsDeleted" />
                            <input type="hidden" asp-for="OwnerId" />
                            <input type="hidden" asp-for="IsLocked" />

                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="Name"></label> <span class="req">*</span> :
                                    @(Html.Kendo().TextBoxFor(m => m.Name)
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%",
                                            maxlength = 150,
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.Name)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.Name)} is required"
                                        }
                                        ))
                                </div>
                            </div>                             
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="LegalEntityId"></label> <span class="req">*</span> :
                                    @(Html.Kendo().DropDownListFor(m => m.LegalEntityId)
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .Filter(FilterType.Contains)
                                            .DataSource(source =>
                                            {
                                                source.Read(read =>
                                                {
                                                    read.Action("GetLegalEntity", "Dropdown", new { area = "Finance" });
                                                });
                                            })
                                            .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.LegalEntityId)}")
                                            .HtmlAttributes(new
                                            {
                                                style = "width:100%;",
                                                required = "required",
                                                validationmessage = $"{Html.DisplayNameFor(m => m.LegalEntityId)} is required"
                                            })
                                    )
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="StartDate"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().DatePickerFor(m=>m.StartDate)
                                            .Format("dd MMMM yyyy")
                                            //.Start(CalendarView.Year)
                                            //.Depth(CalendarView.Year)
                                            .HtmlAttributes(new {
                                                style = "width: 100%",
                                                onkeydown = "javascript:return false;",
                                                placeholder = $"Input type a {Html.DisplayNameFor(m => m.StartDate)}",
                                                required = "required",
                                                validationmessage = $"{Html.DisplayNameFor(m => m.StartDate)} is required"
                                            })
                                    )
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="EndDate"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().DatePickerFor(m=>m.EndDate)
                                            .Format("dd MMMM yyyy")
                                            //.Start(CalendarView.Year)
                                            //.Depth(CalendarView.Year)
                                            .HtmlAttributes(new {
                                                style = "width: 100%",
                                                onkeydown = "javascript:return false;",
                                                placeholder = $"Input type a {Html.DisplayNameFor(m => m.EndDate)}",
                                                required = "required",
                                                validationmessage = $"{Html.DisplayNameFor(m => m.EndDate)} is required"
                                            })
                                    )
                                </div>
                            </div>    
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="StartNumber"></label> <span class="req">*</span>  :<br/>
                                     <div class="input-group">
                                        <input type="hidden" asp-for="StartNumber" />
                                       @*@(Html.Kendo().TextBox()
                                            //.Mask("000.000-00.00000000")
                                            .Name("startnumber1")
                                            .HtmlAttributes(new {
                                                style = "width:70px;",
                                                required="required",
                                                @maxlength = 3,
                                                @minlength = 3,
                                                @class= "numberOnly"
                                            }))
                                        &nbsp;.&nbsp;*@
                                        @(Html.Kendo().TextBox()
                                            //.Mask("000.000-00.00000000")
                                            .Name("startnumber2")
                                            .HtmlAttributes(new {
                                                style = "width:70px;",
                                                required="required",
                                                @maxlength = 3,
                                                @minlength = 3,
                                                @class = "numberOnly"
                                            }))
                                        &nbsp;<b>.</b>&nbsp;
                                        @(Html.Kendo().TextBox()
                                            //.Mask("000.000-00.00000000")
                                            .Name("startnumber3")
                                            .HtmlAttributes(new {
                                                style = "width:60px;",
                                                required="required",
                                                @maxlength = 2,
                                                @minlength = 2,
                                                @class = "numberOnly"
                                            }))
                                        &nbsp;<b>.</b>&nbsp;
                                         @(Html.Kendo().TextBox()
                                            //.Mask("000.000-00.00000000")
                                            .Name("startnumber4")
                                            .HtmlAttributes(new {
                                                style = "width:100px;",
                                                required="required",
                                                @maxlength = 8,
                                                @minlength = 8,
                                                @class = "numberOnly"
                                            }))
                                         </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="EndNumber"></label> <span class="req">*</span>  :<br/>    
                                     <div class="input-group">      
                                        <input type="hidden" asp-for="EndNumber" />                       
                                         @*@(Html.Kendo().TextBox()
                                            //.Mask("000.000-00.00000000")
                                            .Name("endnumber1") 
                                            .HtmlAttributes(new {
                                                style = "width:70px;",
                                                required="required",
                                                @maxlength = 3,
                                                @minlength = 3,
                                                @readonly="readonly",
                                                @class= "numberOnly"
                                            }))
                                        &nbsp;.&nbsp;*@
                                        @(Html.Kendo().TextBox()
                                            //.Mask("000.000-00.00000000")
                                            .Name("endnumber2")
                                            .HtmlAttributes(new {
                                                style = "width:70px;",
                                                required="required",
                                                @maxlength = 3,
                                                @minlength = 3,
                                                @readonly = "readonly",
                                                @class = "numberOnly"
                                            }))
                                        &nbsp;<b>.</b>&nbsp;
                                        @(Html.Kendo().TextBox()
                                            //.Mask("000.000-00.00000000")
                                            .Name("endnumber3")
                                            .HtmlAttributes(new {
                                                style = "width:60px;",
                                                required="required",
                                                @maxlength = 2,
                                                @minlength = 2,
                                                @readonly = "readonly",
                                                @class = "numberOnly"
                                            }))
                                        &nbsp;<b>.</b>&nbsp;
                                         @(Html.Kendo().TextBox()
                                            //.Mask("000.000-00.00000000")
                                            .Name("endnumber4")
                                            .HtmlAttributes(new {
                                                style = "width:100px;",
                                                required="required",
                                                @maxlength = 8,
                                                @minlength = 8,
                                                @class = "numberOnly"
                                            }))
                                         </div>
                                    </div>
                                </div>
                        </div>  
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="pull-right">
                                    @if (Model.Used == 0)
                                    {
                                        <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                                    }
                                    <a asp-action="index" asp-controller="efaktur" asp-area="finance" class="fakelink btn btn-secondary">Close</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        var start = $("#StartNumber").val();
        var end = $("#EndNumber").val();
        //console.log(start);
        //console.log(end);
        //$("#startnumber1").val(start.substring(0, 3));
        //$("#startnumber2").val(start.substring(4, 7));
        //$("#startnumber3").val(start.substring(8, 10));
        //$("#startnumber4").val(start.substring(11, 19));

        //$("#endnumber1").val(end.substring(0, 3));
        //$("#endnumber2").val(end.substring(4, 7));
        //$("#endnumber3").val(end.substring(8, 10));
        //$("#endnumber4").val(end.substring(11, 19));

        $("#startnumber2").val(start.substring(0, 3));
        $("#startnumber3").val(start.substring(4, 6));
        $("#startnumber4").val(start.substring(7, 15));

        $("#endnumber2").val(end.substring(0, 3));
        $("#endnumber3").val(end.substring(4, 6));
        $("#endnumber4").val(end.substring(7, 15));
    });

    
    $('.numberOnly').keyup(function () {
        this.value = this.value.replace(/[^0-9\.]/g, '');
    });

    //$('#startnumber1').on("input", function () { 
    //    $("#endnumber1").val(this.value.replace(/[^0-9\.]/g, ''));
    //});

    $('#startnumber2').on("input", function () {
        $("#endnumber2").val(this.value.replace(/[^0-9\.]/g, ''));
    });

    $('#startnumber3').on("input", function () {
        $("#endnumber3").val(this.value.replace(/[^0-9\.]/g, ''));
    });

    $('#startnumber4').on("input", function () { 
        //var i = 0;
        //if (this.value.replace(/[^0-9\.]/g, '') != "") {
        //    i = parseInt(this.value.replace(/[^0-9\.]/g, '')) + 1;
        //}
        //if(i==0){
        //    $("#endnumber4").val(""); 
        //} else {
        //    $("#endnumber4").val(i); 
        //}

        $("#endnumber4").val(this.value.replace(/[^0-9\.]/g, ''));
    });

    //$('#endnumber1').on("input", function () {
    //    $("#startnumber1").val(this.value.replace(/[^0-9\.]/g, ''));
    //});

    $('#endnumber2').on("input", function () {
        $("#startnumber2").val(this.value.replace(/[^0-9\.]/g, ''));
    });

    $('#endnumber3').on("input", function () {
        $("#startnumber3").val(this.value.replace(/[^0-9\.]/g, ''));
    });

    $('#endnumber4').on("input", function () { 
        //$("#startnumber4").val(this.value-1); 
    });

    $('#btn-save').click(function () {
        //000.000-00.00000000
        //var startNumber = $("#startnumber1").val() + '.' + $("#startnumber2").val() + '-' +$("#startnumber3").val() + '.' + $("#startnumber4").val();
        //var endNumber = $("#endnumber1").val() + '.' + $("#endnumber2").val() + '-' +$("#endnumber3").val() + '.' + $("#endnumber4").val();

        var startNumber = $("#startnumber2").val() + '.' + $("#startnumber3").val() + '.' + $("#startnumber4").val();
        var endNumber = $("#endnumber2").val() + '.' + $("#endnumber3").val() + '.' + $("#endnumber4").val();
        $("#StartNumber").val(startNumber);
        $("#EndNumber").val(endNumber);
        var seqStart = parseInt($("#startnumber4").val());
        var seqEnd = parseInt($("#endnumber4").val());
        if (seqEnd < seqStart) {
            swal('Warning', "the start number must be less than the end number", 'warning');
            return false;
        }

        //if ((seqEnd-seqStart)>=500) {
        //    swal('Warning', "the maximum sequence number is 500", 'warning');
        //    return false;
        //}

        callAction({ formId:"formefaktur", title: "save", type:"POST"});
    });
</script>