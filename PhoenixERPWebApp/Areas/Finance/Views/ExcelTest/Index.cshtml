                var customDropDown1 = {
                    // Methods
                    closeEditor: function (cell, save) {
                        // Get value
                        var val = $(cell).find('.editor').val();
                        var txt = $(cell).find('.editor').text();
                        // Set visual value
                        $(cell).attr('data-value-id',val);
                        // Close edition
                        $(cell).removeClass('edition');
                        // Save history
                        return txt;
                    },
                    openEditor: function (cell) {
                        // Get current content
                        var currentValue = $(cell).val();
                        var currentText = $(cell).text();
                        console.log(currentValue);
                        // Create the editor
                        var editor = document.createElement('select');
                        $(cell).html(editor);
                        $(editor).prop('class', 'editor');
                        $(editor).cmSelect2({
                            url: $.helper.resolveApi("~/core/BusinessUnitType/lookup/"),
                            filters: ' r.business_unit_type_name LIKE @@0 ',
                            //paramaters: [],
                            result: {
                                id: 'id',
                                text: 'business_unit_type_name',
                            }
                        }).on('change', function () {
                            //var selected = $(editor).select2("val");
                            //var selectedText = $(editor).text();
                            //console.log(selected);
                            //console.log(selectedText);

                            $('#' + $.fn.jexcel.current).jexcel('closeEditor', $(cell), true);
                        });
                        //$(editor).val(currentValue);
                        $(editor).cmSetLookup(currentValue, currentText);

                    },
                    getValue: function (cell) {
                        return $(cell).attr('data-value-id');
                    },
                    setValue: function (cell, value) {
                        console.log("SET value");
                        console.log(value);
                        $(cell).html(value);
                        return true;
                    }
                }

                $('#my').jexcel({
                    //data: data,
                    colHeaders: ['Model', 'Color', 'Buy'],
                    colWidths: [300, 80, 100],
                    columns: [
                        {
                            editor: customDropDown1,
                            type: 'dropdown'
                        },
                        {
                            type: 'dropdown',
                            source: ['Apples', 'Bananas', 'Carrots', 'Oranges', 'Cheese'],
                            filter: dropdown
                        },
                        { type: 'checkbox' },
                    ]
                });
                //BEGIN::EVENT BUTTON


