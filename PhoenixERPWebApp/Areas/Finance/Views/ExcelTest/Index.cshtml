<script>
    dataSource = [
        [3, 'Cheese'],
        [1, 'Apples'],
        [2, 'Carrots'],
        [1, 'Oranges'],
    ];

    var dropdown = function (instance, cell, c, r, source) {
        var value = $('#my').jexcel('getValue', c - 1 + '-' + r);

        if (value == 1) {
            return ['Apples', 'Bananas', 'Oranges'];
        } else if (value == 2) {
            return ['Carrots'];
        } else {
            return source;
        }
    }

        (function ($) {
            'use strict';



            var pageFunction = function () {
                
                //$.get($.helper.resolveApi("~/core/BusinessUnitType/lookup?length=300"), function (data) {
