            endDate = this.value();

        if (endDate) {
            endDate = new Date(endDate);
            endDate.setDate(endDate.getDate());
            startPicker.max(endDate);
        }
    }


    *@
    function LegalEntity_SelectEvent(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            legalId = dataItem.Value;
            //if ($("#Year").data("kendoDropDownList").value() != "" && $("#FinancialYearName").val() == "") {
                var entityName = dataItem.Text;
                var year = $("#Year").data("kendoDropDownList").value();
                var fiscalYearName = entityName + ' ' + year;
                $("#FinancialYearName").val(fiscalYearName);
            //}

            $("#Year").data("kendoDropDownList").dataSource.read();

            @*$.ajax({
                type: "GET",
                dataType: "json",
                contentType: "application/x-www-form-urlencoded",
                async: false,
                data: { legalEntityId: dataItem.Value },
                url: "@Url.Action("MaxDate", "FinancialYear")",
                success: function (result) {
                    if (result != null) {
                        var min = new Date(result);
                        $("#StartDate").data("kendoDatePicker").min(min);
                        $("#EndDate").data("kendoDatePicker").min(min);
                    }
                }
            });*@
        }
    }

    function Year_SelectEvent(e) {
         if (e.dataItem) {
            var dataItem = e.dataItem;
            $.ajax({
                type: "GET",
                dataType: "json",
                contentType: "application/x-www-form-urlencoded",
                async: false,
                data: { year: dataItem.Value },
                url: "@Url.Action("GetDate", "FinancialYear")",
                success: function (result) {
                    if (result != null) {
                        $("#StartDate").data("kendoDatePicker").value(result.startDate);
                        $("#EndDate").data("kendoDatePicker").value(result.endDate);

                        /*if ($("#LegalEntityId").data("kendoDropDownList").value() != "" && $("#FinancialYearName").val() == "") {*/
                        var entityName = $("#LegalEntityId").data("kendoDropDownList").text();
                        var year = dataItem.Text;
                        var fiscalYearName = entityName + ' ' + year;
                        $("#FinancialYearName").val(fiscalYearName);
                        //}
                    }
                }
            });
        }
    }

    function year_params() {
        return {
            legalEntityId: legalId
        }
    }
</script>