@model PhoenixERPWebApp.Models.FinancialYear
@{
    ViewData["Title"] = "Fiscal Year Detail";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto"> 
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="financialyear" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Fiscal Year Detail</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                     @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="financialyear" asp-area="finance"  class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="financialyear" asp-area="finance"  asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title"> 
                                <h3 class="m-portlet__head-text m--font-success">Fiscal Year Detail</h3>&nbsp; 
                                @if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Draft)
                                {<span class="m-badge m-badge--info m-badge--wide" id="lblstatus">@Model.Status</span> }
                        else if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.WaitingApproval)
                        { <span class="m-badge m-badge--warning m-badge--wide" id="lblstatus">@Model.Status</span> }
                        else if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Rejected)
                        { <span class="m-badge m-badge--danger m-badge--wide" id="lblstatus">@Model.Status</span> }
                        else if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Close)
                        { <span class="m-badge m-badge--success m-badge--wide" id="lblstatus">@Model.Status</span>} 
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formFinancialYear" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="financialyear" asp-area="finance">
                        <div class="row ">
                            <div class="col-lg-12">
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" asp-for="CreatedBy" />
                                <input type="hidden" asp-for="CreatedOn" />
                                <input type="hidden" asp-for="ModifiedBy" />
                                <input type="hidden" asp-for="ModifiedOn" />
                                <input type="hidden" asp-for="ApprovedBy" />
                                <input type="hidden" asp-for="ApprovedOn" />
                                <input type="hidden" asp-for="DeletedBy" />
                                <input type="hidden" asp-for="DeletedOn" />
                                <input type="hidden" asp-for="IsActive" />
                                <input type="hidden" asp-for="IsLocked" />
                                <input type="hidden" asp-for="IsDefault" />
                                <input type="hidden" asp-for="IsDeleted" />
                                <input type="hidden" asp-for="OwnerId" />
                                <input type="hidden" asp-for="Status" />
                                <input type="hidden" asp-for="StatusApproval" />
                                <input type="hidden" asp-for="IsClose" />
  
                                <div class="row ">
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label asp-for="FinanceYearNumber"></label> :
                                            @(Html.Kendo().TextBoxFor(m => m.FinanceYearNumber)
                                                .HtmlAttributes(new
                                                {
                                                    style = "width:100%",
                                                    @readonly = "readonly",
                                                    placeholder = $"Auto generated by system"
                                                }))
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="FinancialYearName"></label> <span class="req">*</span>  :
                                            @(Html.Kendo().TextBoxFor(m => m.FinancialYearName)
                                                .HtmlAttributes(new {
                                                    style = "width:100%",
                                                    maxlength = 50,
                                                    placeholder = $"Input type a {Html.DisplayNameFor(m => m.FinancialYearName)}",
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.FinancialYearName)} is required" 
                                                }
                                             ))
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="LegalEntityId"></label> <span class="req">*</span> :
                                            @(Html.Kendo().DropDownListFor(m => m.LegalEntityId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Filter(FilterType.Contains)
                                                .Events(evt=>evt.Select("LegalEntity_SelectEvent"))
                                                .DataSource(source =>
                                                {
                                                    source.Read(read =>
                                                    {
                                                        read.Action("GetLegalEntity", "Dropdown", new { area = "Finance" });
                                                    });
                                                })
                                                .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.LegalEntityId)}")
                                                .HtmlAttributes(new {
                                                    style = "width:100%;",
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.LegalEntityId)} is required"
                                                })
                                            )
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label asp-for="Year"></label> <span class="req">*</span> :
                                            @(Html.Kendo().DropDownListFor(m => m.Year)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Filter(FilterType.Contains)
                                                .Events(evt=>evt.Select("Year_SelectEvent"))
                                                .DataSource(source =>
                                                {
                                                    source.Read(read =>
                                                    {
                                                        read.Action("GetYearPeriod", "Dropdown", new { area = "Finance" }).Data("year_params");
                                                    })
                                                    .ServerFiltering(true);
                                                })
                                                //.CascadeFrom("LegalEntityId")
                                                .AutoBind(false)
                                                .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.Year)}")
                                                .HtmlAttributes(new {
                                                    style = "width:100%;",
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.Year)} is required"
                                                })
                                            )
                                        </div>
                                        <div class="form-group">
                                            <div class="row m-row--no-padding">
                                                <div class="col-lg-6">
                                                    <label asp-for="StartDate"></label> <span class="req">*</span>  :
                                                    @(Html.Kendo().DatePickerFor(m=>m.StartDate)
                                                          .Format("dd MMMM yyyy")
                                                          .HtmlAttributes(new {
                                                              style = "width: 100%",
                                                              onkeydown = "javascript:return false;",
                                                              placeholder = $"Input type a {Html.DisplayNameFor(m => m.StartDate)}",
                                                              required = "required",
                                                              validationmessage = $"{Html.DisplayNameFor(m => m.StartDate)} is required",
                                                              @readonly = "readonly"
                                                          })
                                                        //.Events(e => e.Change("startChangeActual"))
                                                    )
                                                </div> 
                                                <div class="col-lg-6"> 
                                                    <label asp-for="EndDate"></label> <span class="req">*</span>  :
                                                    @(Html.Kendo().DatePickerFor(m=>m.EndDate)
                                                          .Format("dd MMMM yyyy")
                                                          .HtmlAttributes(new {
                                                              style = "width: 100%",
                                                              onkeydown = "javascript:return false;",
                                                              placeholder = $"Input type a {Html.DisplayNameFor(m => m.EndDate)}",
                                                              required = "required",
                                                              validationmessage = $"{Html.DisplayNameFor(m => m.EndDate)} is required",
                                                              @readonly="readonly"
                                                          })
                                                        //.Events(e => e.Change("endChangeActual"))
                                                    )
                                                </div>
                                            </div>
                                        </div> 
                                    </div>
                                </div>
                                
                                <div class="row ">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label asp-for="RemarksProcess"></label> :
                                            @Html.TextAreaFor(x => x.RemarksProcess, new { style = "height:100px;width:100%" })
                                        </div>
                                    </div>
                                </div> 
                                 <partial name="_HistoryApproval" />
                                 <partial name="_StatusLog" />                                
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="pull-right">
                                    @if (ViewBag.IsRequetorReOpen == true)
                                    {
                                        <button type="button" id="btnReOpen" class="btn btn-success edit"><span class="fa fa-save"></span> Re-Open</button>
                                    }
                                    else if (ViewBag.isRequestor == true)
                                    { 
                                        <button type="button" id="btnSave" class="btn btn-success edit"><span class="fa fa-save"></span> Save</button>                                       
                                        <button type="button" id="btnSubmit" class="btn btn-primary edit"><span class="fa fa-paper-plane"></span> Submit</button> 
                                    }
                                    else if (ViewBag.processApprove == true)
                                    {
                                        <button type="button" id="btnReject" class="btn btn-danger"><span class="fa fa-ban"></span> Reject</button>
                                        <button type="button" id="btnApprove" class="btn btn-primary"><span class="fa fa-bookmark"></span> Approve</button>
                                    } 
                                    <a asp-action="index" asp-controller="financialyear" asp-area="finance" class="fakelink btn btn-secondary"><span class="fa fa-arrow-circle-left"></span> Cancel</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var legalId;
    $(document).ready(function () {
        if ("@ViewBag.isRequestor" == "False") {
            $("#FinancialYearName").attr('readonly', 'readonly');
            $("#StartDate").data("kendoDatePicker").readonly();
            $("#EndDate").data("kendoDatePicker").readonly();
            $("#LegalEntityId").data("kendoDropDownList").readonly();
        }

        legalId = $("#LegalEntityId").data("kendoDropDownList").value();
        $("#Year").data("kendoDropDownList").dataSource.read();
    });

    $('#btnApprove').click(function () {
        callAction({ formId: "formFinancialYear", title: "approve", type: "PUT", url: '@Url.Action("approve", "FinancialYear")'});
    });

    $('#btnReject').click(function () {
        $("#RemarksProcess").attr("required", "required");
        callAction({ formId: "formFinancialYear", title: "reject", type: "PUT", url: '@Url.Action("reject", "FinancialYear")'});
    });

    $('#btnSubmit').click(function () {
        if (!isValid()) return;
        callAction({ formId: "formFinancialYear", title: "close", type: "POST", url: '@Url.Action("submit", "FinancialYear")'});
    });

    $('#btnReOpen').click(function () {
        $("#RemarksProcess").attr("required", "required");
        callAction({ formId: "formFinancialYear", title: "re-open", type: "PUT", url: '@Url.Action("reopen", "FinancialYear")'});
    });

    $('#btnSave').click(function () {
        if (!isValid()) return;
        callAction({ formId: "formFinancialYear", title: "open", type: "POST", url: '@Url.Action("save", "FinancialYear")'});
    });

    function isValid() {
        var valid = $("#formFinancialYear").validate().form();
        if (valid) {
            return true;
        } else {
            return false;
        }
    }

    @*
    function startChangeActual() {
        var endPicker = $("#EndDate").data("kendoDatePicker"),
            startDate = this.value();

        if (startDate) {
            startDate = new Date(startDate);
            startDate.setDate(startDate.getDate());
            endPicker.min(startDate);
        }
