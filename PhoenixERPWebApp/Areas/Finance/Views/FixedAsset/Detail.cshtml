<script>

    $(function () {
        var CurrencyId = $('#CurrencyId').data("kendoDropDownList").value();
        if (CurrencyId == "46e4d57e-5ce2-4c31-82be-f81382dc243a") {
              $("#ExchangeRate").data("kendoNumericTextBox").readonly();
              $('#ExchangeRate').data("kendoNumericTextBox").value(1);
        }
        var FileUploadName = '@Model.FileUploadName';

        if (FileUploadName == '') {
            FileUpload();
        } else {
            FileUpload();
            getImageFixedAsset();
        }
        var DataAmortizationValue = '@Model.AmortizationValue';
        $('#AmortizationValue').val(formatMoney(DataAmortizationValue,0));


    //AmortizationValue
        //$(".k-icon k-i-close").click(function () {
        //    alert("The paragraph was clicked.");
        //});
    });

    function filterInvForm() {
         return {
            type: 'FIXED ASSET'
        };
    }

    function gridLogFixetAsset_params() {
        
         return {
            id: $('#FixedAssetNumber').val()
        };
    }

    function formatMoney(amount, decimalCount = 2, decimal = ".", thousands = ",") {
        try {
            decimalCount = Math.abs(decimalCount);
            decimalCount = isNaN(decimalCount) ? 2 : decimalCount;

            const negativeSign = amount < 0 ? "-" : "";

            let i = parseInt(amount = Math.abs(Number(amount) || 0).toFixed(decimalCount)).toString();
            let j = (i.length > 3) ? i.length % 3 : 0;

            return negativeSign + (j ? i.substr(0, j) + thousands : '') + i.substr(j).replace(/(\d{3})(?=\d)/g, "$1" + thousands) + (decimalCount ? decimal + Math.abs(amount - i).toFixed(decimalCount).slice(2) : "");
        } catch (e) {
            console.log(e)
        }
    };

    var loadFile = function (event) {
        var output = document.getElementById('img-fixedasset-nava');
        output.src = URL.createObjectURL(event.target.files[0]);
