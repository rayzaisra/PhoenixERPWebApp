                                        </div>
                                        <div class="m-accordion__item-body show" id="status_body" role="tabpanel" aria-labelledby="status_head" data-parent="#status" style="">
                                            <div class="m-accordion__item-content">
                                                <div class="row">
                                                    <div class="col-sm-12">
                                                        <div class="form-group ">
                                                            <div class="row">
                                                                <table class="table table-bordered">
                                                                    <tr>
                                                                        <th width="15%">Acquired Amount</th>
                                                                        <th width="15%">Life Time (Month)</th>
                                                                        <th width="15%">Residue</th>
                                                                        <th width="15%">Deprecation Value</th>
                                                                        <th width="20%">Set Depreciation</th>
                                                                        <th width="30%">Set Accumulation Depreciation</th>
                                                                    </tr>
                                                                    <tbody>
                                                                        <tr>
                                                                            <td width="15%">
                                                                                @Html.Kendo().NumericTextBoxFor(m => m.AcquisitionAmount).Spinners(false).Format("{0:N2}").HtmlAttributes(new { @style = "width:100%;", @readonly = "readonly" })                                                                                 
                                                                            </td>
                                                                            <td  width="15%">
                                                                               @Html.Kendo().NumericTextBoxFor(m => m.LifeTime).Spinners(false).Format("{0:N0}").HtmlAttributes(new { @style = "width:100%;", @readonly = "readonly"})
                                                                            </td>
                                                                            <td width="15%">
                                                                                @(Html.Kendo().NumericTextBoxFor(a => a.Residual)
                                                                                    .Spinners(false)
                                                                                    .Format("{0:N0}")
                                                                                    .Events(evt=>evt.Change("onchangecalculatedepreciation"))
                                                                                    .HtmlAttributes(new
                                                                                    {
                                                                                        maxlength = 10,
                                                                                        @style = "width:100%;",
                                                                                        required = "required",
                                                                                        validationmessage = $"{Html.DisplayNameFor(m => m.Residual)} is required"
                                                                                    }
                                                                                )) 
                                                                            </td>
                                                                            <td width="15%">
                                                                                @(Html.Kendo().NumericTextBoxFor(a => a.DepreciationValue)
                                                                                    .Spinners(false)
                                                                                    .Format("{0:N2}")
                                                                                    .HtmlAttributes(new
                                                                                    {
                                                                                        maxlength = 10,
                                                                                        @style = "width:100%;",
                                                                                        @readonly ="readonly"
                                                                                    }
                                                                                ))  
                                                                            </td>
                                                                            <td width="20%">
                                                                                 @(Html.Kendo().DropDownListFor(m => m.AccountSetDepreceationId)
                                                                                    .DataTextField("Text")
                                                                                    .DataValueField("Value")
                                                                                    .Filter(FilterType.Contains)
                                                                                    .OptionLabel("--Select--")
