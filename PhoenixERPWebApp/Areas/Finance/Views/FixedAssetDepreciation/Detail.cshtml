    function FixedAsset_SelectEvent(e) { 
        if (e.dataItem) {
            var dataItem = e.dataItem;
            $.ajax({
                type: "GET",
                dataType: "json",
                contentType: "application/x-www-form-urlencoded",
                async: false,
                data: { id: dataItem.Value },
                url: "@Url.Action("GetFixedAssetById", "FixedAsset")",
                success: function (result) { 
                    if (result != null) {
                        $('#FixedAsset_FixedAssetNumberManual').val(result.FixedAssetNumberManual);
                        $('#FixedAsset_EvidentNumber').val(result.EvidentNumber);
                        $('#FixedAsset_Description').val(result.Description);
                        $('#FixedAsset_ConditionName').val(result.ConditionName);
                        $('#FixedAsset_Depreciation').val(result.Depreciation);
                        $('#FixedAsset_StatusDepreciation').val(result.StatusDepreciation);
                        //$('#FixedAsset_InvoiceId').val(result.InvoiceId);


                        $('#FixedAsset_ItemCategoryId').data("kendoDropDownList").value(result.ItemCategoryId);
                        $('#FixedAsset_LegalEntityId').data("kendoDropDownList").value(result.LegalEntityId);
                        $('#FixedAsset_AffiliationId').data("kendoDropDownList").value(result.AffiliationId);
                        $('#FixedAsset_BusinessUnitId').data("kendoDropDownList").value(result.BusinessUnitId);
                        $('#FixedAsset_GetFrom').data("kendoDropDownList").value(result.GetFrom);
                        $('#FixedAsset_LocationId').data("kendoDropDownList").value(result.LocationId);
                        $('#FixedAsset_Condition').data("kendoDropDownList").value(result.Condition);
                        $('#FixedAsset_CurrencyId').data("kendoDropDownList").value(result.CurrencyId);
                        $('#FixedAsset_CoaId').data("kendoDropDownList").value(result.CoaId);                        
                        //$('#FixedAsset_PurchaseOrderId ').data("kendoDropDownList").value(result.PurchaseOrderId );
                        //$('#FixedAsset_VendorId').data("kendoDropDownList").value(result.VendorId);
                        //$('#FixedAsset_DivisionId').data("kendoDropDownList").value(result.DivisionId);
                        
                        $("#FixedAsset_UnitCount").data("kendoNumericTextBox").value(result.UnitCount);
                        $("#FixedAsset_ExchangeRate").data("kendoNumericTextBox").value(result.ExchangeRate);
                        $("#FixedAsset_AcquisitionCost").data("kendoNumericTextBox").value(result.AcquisitionCost);
                        $("#FixedAsset_CurrentEstimationPrice").data("kendoNumericTextBox").value(result.CurrentEstimationPrice);
                        $("#FixedAsset_RegistrationDate").data("kendoDatePicker").value(result.RegistrationDate);
                        $("#FixedAsset_AmortizationValue").data("kendoNumericTextBox").value(result.AmortizationValue);

                        
                        $("#AcquisitionAmount").data("kendoNumericTextBox").value(result.AcquisitionCost);
                        $("#LifeTime").data("kendoNumericTextBox").value(result.LifeTimeMonth);
                        $('#AccountSetDepreceationId').data("kendoDropDownList").value(result.COADebit);
                        $('#AccountSetAccumulationDepreceationId').data("kendoDropDownList").value(result.COACredit);
                        $("#Residual").data("kendoNumericTextBox").value(0);    
                        onchangecalculatedepreciation();
                    } else {
                        alert('Data Not Found!')
                    }
                }
            });
        }
    }
    
    function onchangecalculatedepreciation() {
        var AcquiredAmount = $("#AcquisitionAmount").data("kendoNumericTextBox").value();
        var Residual = $("#Residual").data("kendoNumericTextBox").value();
        var LifeTime = $("#LifeTime").data("kendoNumericTextBox").value();
        var DepreciationValue = (AcquiredAmount - Residual) / LifeTime;

        $("#DepreciationValue").data("kendoNumericTextBox").value(DepreciationValue);
    }
     
    $('#btnSubmit').click(function () {
        var valid = $("#formDepreciation").validate().form();
        if (valid) { 
            callAction({ formId: "formDepreciation", title: "Submit", type: "POST", url: '@Url.Action("Submit", "FixedAssetDepreciation")'});
        }
    });

    
    $('#btnDelete').click(function () { 
        callAction({ formId: "formDepreciation", title: "Cancel", type: "POST", url: '@Url.Action("DeleteDetail", "FixedAssetDepreciation")'}); 
    });    

    $('#btnCalculate').click(function () {
        var valid = $("#formDepreciation").validate().form();
        if (valid) { 
            callAction({ formId: "formDepreciation", title: "Calculate", type: "POST", url: '@Url.Action("Calculate", "FixedAssetDepreciation")'});
        }
    }); 
</script>