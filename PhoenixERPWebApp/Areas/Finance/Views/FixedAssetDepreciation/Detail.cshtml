                                                                                  columns.Bound(p => p.CodeRec).Width(150);
                                                                                  columns.Bound(p => p.AccountName).Width(200);
                                                                                  //columns.Bound(p => p.Description).Width(200);
                                                                                  columns.Bound(p => p.DivisiName).Width(200);
                                                                                  columns.Bound(p => p.LegalEntityName).Width(200).ClientFooterTemplate("TOTAL").FooterHtmlAttributes(new { style = "text-align:right;" });
                                                                                  columns.Bound(p => p.Debit).Width(150).ClientFooterTemplate("#=kendo.toString(sum, '\\#\\#,\\#')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                                                  columns.Bound(p => p.Credit).Width(150).ClientFooterTemplate("#=kendo.toString(sum, '\\#\\#,\\#')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                                              })
                                                                              .NoRecords()
