    <a href='javascript: void(0);' onclick='editGridRow(this)' title='Edit' class='edit'><span style='color:green'><i class='fa fa-edit'></i></span></a>
    <a href='javascript: void(0);' onclick='deleteGridRow(this)' title='Delete' class='delete'><span style='color:maroon'><i class='fa fa-trash-alt'></i></span></a>
</script>*@

<script>
    var detailSelected = [];
    $(document).ready(function () { 
        var grid = $("#grid").data("kendoGrid");
        grid.table.on("click", ".row-checkbox", selectRow);

        $('#header-chb').change(function (ev) {
            var checked = ev.target.checked;
            $('.row-checkbox').each(function (idx, item) {
                if (checked) {
                    if (!($(item).closest('tr').is('.k-state-selected'))) {
                        $(item).click();
                    }
                } else {
                    if ($(item).closest('tr').is('.k-state-selected')) {
                        $(item).click();
                    }
                }
            });
        });
    });

    function selectRow() {
        var checked = this.checked,
            row = $(this).closest("tr"),
            grid = $("#grid").data("kendoGrid"),
            dataItem = grid.dataItem(row);

        if (checked) {
            //-select the row
            row.addClass("k-state-selected");

            var checkHeader = true;

            $.each(grid.items(), function (index, item) {
                if (!($(item).hasClass("k-state-selected"))) {
                    checkHeader = false;
                }
            });

            $("#header-chb")[0].checked = checkHeader;

            detailSelected.push(dataItem.Id);
        } else {
            //-remove selection
            row.removeClass("k-state-selected");
            $("#header-chb")[0].checked = false;

            var index = detailSelected.findIndex(function (data) { return data == dataItem.Id });
            if (index != -1) {
                detailSelected.splice(index, 1);
            }
        } 
    }

    //on dataBound event restore previous selected rows:
    function onDataBound(e) {
        var view = this.dataSource.view();
        for (var i = 0; i < view.length; i++) {
            var item = detailSelected.filter(function (data) { return data == view[i].Id });
            if (item.length > 0) {
                this.tbody.find("tr[data-uid='" + view[i].uid + "']")
                    .addClass("k-state-selected")
                    .find(".k-checkbox")
                    .attr("checked", "checked");
            }
        }
    }

    $('#btnPostJournal').click(function () {  
        var grid = $("#grid").data("kendoGrid");
        var dataSource = grid.dataSource; 
        var totalRecords = dataSource.total();
        if (totalRecords == 0) {
            swal('Warning', "Data not found.", 'warning');
        }
        else if ($("#LegalEntityId").data("kendoDropDownList").value() == "") {
            swal('Warning', "Legal Entity is required", 'warning');
        }
        else{
            swal({
                title: "Confirmation",
                text: 'Are you sure want to post journal this data?',
                type: "question",
                showCancelButton: !0,
                confirmButtonText: "Yes",
                cancelButtonText: "No",
                reverseButtons: !0
            }).then(function (ok) {
                if (ok.value) {
                    mApp.block("#m_blockui_list", {
                        overlayColor: "#000000",
                        type: "loader",
                        state: "primary",
                        message: "Processing..."
                    }); 

                    $.ajax({
                        async: false,
                        type: "POST",
                        global: false,
                        dataType: 'json',
                        url: '@Url.Action("PostJournal", "FixedAssetDepreciation")', 
                        data: { 'model': { 'LegalEntityId': $("#LegalEntityId").data("kendoDropDownList").value(),'PostingDate': $("#PostingDate").data("kendoDatePicker").value().toDateString(), 'Selected': detailSelected } },
                        success: function (data) {
                            mApp.unblock("#m_blockui_list");
                            if (data.success) {
                                swal('Information', data.message, 'success')
                                    .then(function (ok) {
                                        if (ok.value) {
                                            detailSelected = [];
                                            $("#header-chb")[0].checked = false; 
                                            $('#grid').data('kendoGrid').dataSource.read();
                                        }
                                    });
                            }
                        },
                        error: function (e, t, s) {
                            mApp.unblock("#m_blockui_list");
                        }
                    })
                }
            }).catch(swal.noop);
        }
    }); 

    function legalEntity_Select(e) {
        if(e.dataItem) {
            var dataItem = e.dataItem;

              $.ajax({
                    type: "GET",
                    dataType: "json",
                    contentType: "application/x-www-form-urlencoded",
                    async: false,
                    data: { legalEntityId: dataItem.Value },
                    url: "@Url.Action("GetPostingDate", "FixedAssetDepreciation")",
                    success: function (result) { 
                        if (result != null) {
                            $("#PostingDate").data("kendoDatePicker").value(result);
                        }
                    }
                }); 
        }
    }

     function editGridRow(e) {
        var item = dataItem(e);
        window.location.href = '@Url.Action("Detail", "FixedAssetDepreciation")?Id=' + item.Id;
     }

    @*function deleteGridRow(e) {
       deleteRow(e, '@Url.Action("Delete", "FixedAssetDepreciation")');
    }*@

    @*function GetStatusButton(data) {
        var buttonType = "";
        if (data.Status == "@PhoenixERPWebApp.Models.PaymentRequestStatus.Open") buttonType = "m-badge--info"; 
        if (data.Status == "@PhoenixERPWebApp.Models.PaymentRequestStatus.PayBalance") buttonType = "m-badge--focus"; 
        else if (data.Status == "@PhoenixERPWebApp.Models.PaymentRequestStatus.WaitingApproval") buttonType = " m-badge--warning";
        else if (data.Status == "@PhoenixERPWebApp.Models.PaymentRequestStatus.Reject") buttonType = " m-badge--danger"; 
        else if (data.Status == "@PhoenixERPWebApp.Models.PaymentRequestStatus.Complete") buttonType = " m-badge--success";
        else if (data.Status == "@PhoenixERPWebApp.Models.PaymentRequestStatus.Reconsiliation") buttonType = " m-badge--dark";
        return "<center><a href='javascript: void(0);' onclick='editGridRow(this)' class='m-badge " + buttonType + " m-badge--wide'>" + data.StatusDesc+"</a></center>";
    }*@ 
</script>


