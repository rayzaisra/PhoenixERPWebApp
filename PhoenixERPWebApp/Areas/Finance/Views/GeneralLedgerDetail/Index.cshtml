@model PhoenixERPWebApp.Models.GeneralLedgerDetailSearch
@{
    ViewData["Title"] = "General Ledger Detail";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">General Ledger Detail</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="Index" asp-controller="RequestForQuotation" asp-area="Finance" class="m-nav__link"><span class="m-nav__link-text">General Ledger Detail</span></a>                    
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div class="input-group input-group-sm">
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">                        
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                
                <div class="m-portlet__body" id="m_blockui_list">                                     
                    <form id="formSearch">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label style="width:25%" asp-for="LegalEntityId"></label>
                                    @(Html.Kendo().DropDownListFor(m => m.LegalEntityId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetLegalEntity", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel(" ")
                                        //.OptionLabel($"Choose a {Html.DisplayNameFor(m => m.LegalEntityId)}")
                                        .HtmlAttributes(new
                                        {
                                            style = "width:73%;",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.LegalEntityId)} is required"
                                        })
                                    )
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label style="width:25%" asp-for="EvdNo"></label>
                                    @(Html.Kendo().TextBoxFor(m => m.EvdNo)
                                        .HtmlAttributes(new
                                        {
                                            //@placeholder = $"Input type a {Html.DisplayNameFor(m => m.EvdNo)}",
                                            style = "width:73%"
                                        }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label style="width:25%">Start Date</label>
                                    @(Html.Kendo().DatePickerFor(m => m.PeriodeFrom)
                                        .Format("dd MMMM yyyy")
                                        .HtmlAttributes(new
                                        {
                                            style = "width: 73%",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.LegalEntityId)} is required"
                                            //onkeydown = "javascript:return false;",
                                            //placeholder = $"Input type a start date"

                                        })
                                    )
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label style="width:25%">End Date</label>
                                    @(Html.Kendo().DatePickerFor(m => m.PeriodeTo)
                                        .Format("dd MMMM yyyy")
                                        .HtmlAttributes(new
                                        {
                                            style = "width: 73%",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.LegalEntityId)} is required"
                                            //onkeydown = "javascript:return false;",
                                            //placeholder = $"Input type a end date"

                                        })
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="row ">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label style="width:25%" asp-for="BusinessUnitId"></label>
                                    @(Html.Kendo().DropDownListFor(m => m.BusinessUnitId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        //.OptionLabel($"Choose a {Html.DisplayNameFor(m => m.BusinessUnitId)}")
                                        .OptionLabel($"All {Html.DisplayNameFor(m => m.BusinessUnitId)}")
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetDivisionFinance", "DropDown", new { area = "Finance" });
                                            });
                                        })
                                        .HtmlAttributes(new { style = "width:73%;" })
                                    )
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label style="width:25%" asp-for="Level"></label>
                                    @(Html.Kendo().DropDownListFor(m=>m.Level)
                                          .DataTextField("Text")
                                          .DataValueField("Value")
                                          .BindTo(new List<SelectListItem>() {
                                              new SelectListItem() { Text = "1", Value = "1" },
                                              new SelectListItem() { Text = "2", Value = "2" },
                                              new SelectListItem() { Text = "3", Value = "3" },
                                              new SelectListItem() { Text = "4", Value = "4" },
                                              new SelectListItem() { Text = "5", Value = "5" }
                                          })
                                        .HtmlAttributes(new { style = "width:73%;" })
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="row ">
                            <div class="col-lg-6"> 
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label style="width:25%" asp-for="AccountId"></label>
                                    @(Html.Kendo().DropDownListFor(m => m.AccountId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        //.OptionLabel($"Choose a {Html.DisplayNameFor(m => m.AccountId)}")
                                        .OptionLabel($"All {Html.DisplayNameFor(m => m.AccountId)}")
                                        .DataSource(source =>
                                        {
                                            source.ServerFiltering(true).Read(read =>
                                            {
                                                read.Action("GetCOALevel", "DropDown", new { area = "Finance" }).Data("coa_param");
                                            });
                                        })
                                        .HtmlAttributes(new { style = "width:73%;" })
                                        .CascadeFrom("Level")
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <button type="button" id="btnSearch" class="btn btn-primary edit" style="padding:7px;"><span class="fa fa-filter"></span> Filter</button>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div class="row">
                        <div class="col-lg-12">
                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.GeneralLedgerDetail>()
                                .Name("grid")
                                .ToolBar(tools => tools.Excel())
                                .Columns(columns =>
                                {
                                    //columns.Select().Width(50).HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" });
                                    //columns.Bound(p => p.Id).ClientTemplate("<input type='checkbox' id='#=Id#' class='k-checkbox row-checkbox'><label class='k-checkbox-label' for='#=Id#'></label>")
                                    //   .ClientHeaderTemplate("<input type='checkbox' id='header-chb' class='k-checkbox'><label class='k-checkbox-label' for='header-chb'></label>").Width(50)
                                    //   .HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Sortable(false).Filterable(false);
                                    columns.Bound(p => p.CodeRec).Width(150);
                                    //columns.Bound(p => p.CoaLevel1).Width(200);
                                    //columns.Bound(p => p.CoaLevel2).Width(200);
                                    //columns.Bound(p => p.CoaLevel3).Width(200);
                                    //columns.Bound(p => p.CoaLevel4).Width(250);
                                    columns.Bound(p => p.CoaLevel).Title("Level 5 COA").Width(280);
                                    columns.Bound(p => p.ClientName).Width(250);
                                    columns.Bound(p => p.FiscalYear).Width(100);
                                    columns.Group(g => g.Title("PERIOD")
                                        .Columns(location =>
                                        {
                                            location.Bound(c => c.PeriodeFrom).Width(100);
                                            location.Bound(c => c.PeriodeTo).Width(100);
                                        })
                                    );
                                    //columns.Bound(p => p.EmployeeName).Width(200);
                                    columns.Bound(p => p.Referencedate).Width(100);
                                    columns.Bound(p => p.SourceType).Width(180);
                                    columns.Bound(p => p.ReffNumber).Width(150);
                                    columns.Bound(p => p.VatNo).Width(150);
                                    columns.Bound(p => p.JobNo).Width(150);
                                    columns.Bound(p => p.PceNo).Width(150);
                                    columns.Bound(p => p.PcaNo).Width(150);
                                    columns.Bound(p => p.PoNumber).Width(150);
                                    columns.Bound(p => p.InvoiceVendor).Width(200);
                                    columns.Bound(p => p.Description).Width(200);
                                    columns.Bound(p => p.BusinessUnit).Width(250);
                                    columns.Bound(p => p.LegalEntity).Width(250).ClientFooterTemplate("Total").FooterHtmlAttributes(new { style = "text-align:right;" });
                                    columns.Group(g => g.Title("AMOUNT")
                                       .Columns(location =>
                                       {
                                           location.Bound(p => p.Debit).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                           location.Bound(p => p.Credit).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                       })
                                   );
                                    columns.Group(g => g.Title("TOTAL")
                                        .Columns(location =>
                                        {
                                            location.Bound(p => p.Adjustment).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                        })
                                    );
                                    columns.Bound(p => p.ApproveBy).Width(200);
                                    columns.Bound(p => p.ApproveDate).Width(150);
                                })
                                .Groupable(true)
                                .Excel(excel => excel
                                    .FileName("Report GL.xlsx")
                                    .Filterable(true)
                                    .AllPages(true)
                                    .ProxyURL(Url.Action("Export", "GeneralLedgerDetail"))
                                )
                                //.Pageable(pageable => pageable
                                //.Refresh(true)
                                //.PageSizes(true)
                                //.ButtonCount(5))
                                //.Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                //.Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                                //.Extra(false)
                                //.Operators(operators => operators
                                //    .ForString(str => str.Clear()
                                //    .Contains("Contains")
                                //    .StartsWith("Start sWith")
                                //    .EndsWith("End sWith")
                                //)))
                                .NoRecords()
                                .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                .Resizable(rsz => rsz.Columns(true))
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    //.PageSize(10)
                                    .Events(events => events.Error("errorHandler"))
                                    .Model(model => { model.Id(p => p.Id); })
                                    .Aggregates(aggregates =>
                                    {
                                        aggregates.Add(p => p.Debit).Sum();
                                        aggregates.Add(p => p.Credit).Sum();
                                        aggregates.Add(p => p.Adjustment).Sum();
                                    })
                                    .Read(read => read.Action("Read", "GeneralLedgerDetail").Data("grid_params"))
                                )

                            //.Events(e => e.DataBound("onDataBound")).AutoBind(false)
                            //.AutoBind(false)
                            ) 
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
