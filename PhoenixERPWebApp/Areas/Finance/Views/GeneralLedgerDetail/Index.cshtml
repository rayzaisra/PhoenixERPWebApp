    function grid_params(){
        return {
            LegalEntityId: $("#LegalEntityId").val(),
            PeriodeFrom: $("#PeriodeFrom").val(),
            PeriodeTo: $("#PeriodeTo").val(),
            EvdNo: $("#EvdNo").val(),
            BusinessUnitId: $("#BusinessUnitId").val(),
            Level: $("#Level").val(),
            AccountId: $("#AccountId").val()
        }
    }

    $('#btnSearch').click(function () {
        $("#grid thead [data-field='CoaLevel']").html("Level " + $("#Level").val() +" COA");
        var valid = $("#formSearch").validate().form();
        if (valid) {
            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $('#grid').data('kendoGrid').dataSource.read();
