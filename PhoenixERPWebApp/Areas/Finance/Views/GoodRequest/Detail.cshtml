@model PhoenixERPWebApp.Models.Finance.GoodRequest
@{
    ViewData["Title"] = " Inventory Movement";
    if (Model != null && ViewBag.IsApprove == true)
    {
        ViewData["Title"] = "Inventory Movement Form Approval";

    }
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
    var userSession = CodeMarvel.Infrastructure.Sessions.SessionManager.UserSession;
}


<input hidden id="detail-id" value="@ViewBag.RecordID" />
<input hidden id="entity_id" value="@ViewBag.EntityID" />

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator"> Master Good Request</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-suitcase"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="@Url.Content("~/Finance/GoodRequest")" class="m-nav__link">
                        <span class="m-nav__link-text"> Inventory Movement</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Detail</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>

<div class="m-content">
    <div class="row">
        <div class="col-xl-12 col-lg-12">
            <div class="m-portlet">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-wrapper">
                        <div class="m-portlet__head-caption">
                            <div class="m-portlet__head-title">
                                <h3 class="m-portlet__head-text m--font-success">
                                    @if (string.IsNullOrEmpty(Model.Id))
                                    {
                                        <span>@ViewBag.Header  &nbsp;</span>
                                    }
                                    else
                                    {
                                        <span>@ViewBag.Header  &nbsp;</span>
                                    }
                                    @if (Model.Status != null)
                                    {
                                        @if (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Open)
                                        {
                                            <span class="m-badge m-badge--info m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.StatusName(PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Open)</span>
                                        }
                                        else if (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval)
                                        {
                                            <span class="m-badge m-badge--info m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.StatusName(PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval)</span>
                                        }
                                        else if (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Approved)
                                        {
                                            <span class="m-badge m-badge--warning m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.StatusName(PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Approved)</span>
                                        }
                                        else if (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed)
                                        {
                                            <span class="m-badge m-badge--success m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.StatusName(PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed)</span>
                                        }
                                        else
                                        {
                                            <span class="m-badge m-badge--info m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.StatusName(PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Open)</span>
                                        }
                                    }
                                    <span id="status"></span>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_qf2tcah4xx"><i class="la la-expand"></i></a>
                    </div>
                </div>
                <div class="m-portlet__body">

                    <div class="m-form__group">

                        <!--begin::Form-->
                        @*<input hidden name="approval_id" />*@
                        <form id="formGoodRequests" class="m-form m-form--fit m-form--label-align-right m-form--group-seperator-dashed">

                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="InvFaName" />
                            <input type="hidden" asp-for="division_id" />
                            <input type="hidden" asp-for="OwnerId" />
                            <input type="hidden" asp-for="JobId" />
                            <input type="hidden" asp-for="RemarkLog" />

                            <div class="row">
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Type :</label>
                                        @Html.Kendo().TextBoxFor(m => m.Type).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" }).Value("INVENTORY")

                                    </div>
                                </div>

                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Request Status :</label>
                                        @if ((Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) || (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Approved))
                                        {
                                            @(Html.Kendo().DropDownListFor(i => i.inv_status)
                                                                     .DataTextField("Text")
                                                                     .DataValueField("Value")
                                                                     .OptionLabel("Select...")
                                                                     .Filter(FilterType.Contains)
                                                                     .HtmlAttributes(new { style = "width:100%;", required = "required", @readonly = "readonly" })
                                                                     .DataSource(source => source
                                                                             .Custom()
                                                                             .Transport(transport => transport
                                                                             .Read(read =>
                                                                             {
                                                                                 read.Action("InvGetform", "Dropdown", new { area = "Finance" }).Data("filterInvForm");
                                                                             }))
                                                                         .ServerFiltering(false))

                                            )
                                        }
                                        else
                                        {
                                            @(Html.Kendo().DropDownListFor(i => i.inv_status)
                                                                     .DataTextField("Text")
                                                                     .DataValueField("Value")
                                                                     .OptionLabel("Select...")
                                                                     .Filter(FilterType.Contains)
                                                                     .DataSource(source =>
                                                                        {
                                                                            source.Read(read =>
                                                                            {
                                                                                read.Action("InvGetform", "Dropdown", new { area = "Finance" }).Data("filterInvForm");
                                                                            }).ServerFiltering(true);
                                                                        })
                                                                        .CascadeFrom("Type")
                                                                        .AutoBind(false)
                                                                        .HtmlAttributes(new { style = "width:100%;", @class = "form-control form-control-sm", @required = "required" }).Events(e =>
                                                                                   {
                                                                                       e.Change("onSelectRequestStatus");
                                                                                   })

                                            )
                                        }

                                    </div>

                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>ID - Name :</label>
                                        @if ((Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) || (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Approved))
                                        {
                                            

                                            @(Html.Kendo().DropDownListFor(i => i.InvFaId)
                                                                    .DataTextField("Text")
                                                                    .DataValueField("Value")
                                                                    .OptionLabel("Select Inv/Fa...")
                                                                    .Filter(FilterType.Contains)
                                                                    .HtmlAttributes(new { style = "width:100%;", required = "required", @readonly = "@readonly" })
                                                                    .DataSource(source => source
                                                                            .Custom()
                                                                            .Transport(transport => transport
                                                                            .Read(read =>
                                                                            {
                                                                                read.Action("GetInvFa", "GoodRequest", new { area = "Finance" }).Data("filterInvFa");
                                                                            }))
                                                                        .ServerFiltering(false))

                                            )

                                        }
                                        else
                                        {
                                            @(Html.Kendo().DropDownListFor(m => m.InvFaId)
                                                                                   .DataTextField("Text")
                                                                                   .OptionLabel("Select Inv/Fa...")
                                                                                   .DataValueField("Value")
                                                                                   .Filter(FilterType.Contains)
                                                                                   .DataSource(source =>
                                                                                   {
                                                                                       source.Read(read =>
                                                                                       {
                                                                                           read.Action("GetInvFa", "GoodRequest", new { area = "Finance" }).Data("filterInvFa");
                                                                                       }).ServerFiltering(false);
                                                                                   })
                                                                                   .Events(e =>
                                                                                   {
                                                                                       e.Change("onSelecInvFa");
                                                                                   })
                                                                                   .CascadeFrom("Type")

                                                                                   .AutoBind(false)
                                                                                   .HtmlAttributes(new { style = "width:100%;", @class = "form-control form-control-sm", @required = "required" })
                                            )
                                        }

                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Job ID - Name :</label>
                                        @if ((Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) || (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed))
                                        {
                                            @Html.Kendo().TextBoxFor(m => m.JobName).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly", style = "width:100%", @disabled = "disabled" })
                                        }
                                        else
                                        {
                                            @Html.Kendo().TextBoxFor(m => m.JobName).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly", style = "width:100%" })
                                        }


                                    </div>
                                </div>



                            </div>
                            <hr />
                            <div class="row">
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Request Number :</label>
                                        @if ((Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) || (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed))
                                        {
                                            @Html.Kendo().TextBoxFor(m => m.GoodRequestNumber).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly", @disabled = "disabled", style = "width:100%", Placeholder = "Auto Generated by System.." })
                                        }
                                        else
                                        {
                                            @Html.Kendo().TextBoxFor(m => m.GoodRequestNumber).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly", style = "width:100%", Placeholder = "Auto Generated by System.." })
                                        }

                                    </div>
                                </div>

                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Date Request :</label>
                                        @if ((Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) || (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed))
                                        {
                                            @Html.Kendo().DatePickerFor(m => m.GoodRequestDatetime).Format("dd MMM yyyy").HtmlAttributes(new { @class = "form-control form-control-sm", @required = "required", @disabled = "disabled" })
                                        }
                                        else
                                        {
                                            @Html.Kendo().DatePickerFor(m => m.GoodRequestDatetime).Format("dd MMM yyyy").HtmlAttributes(new { @class = "form-control form-control-sm", @required = "required" })
                                        }

                                        <span class="k-invalid-msg" data-for="GoodRequestName"></span>
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Due Date :</label>
                                        @if ((Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) || (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed))
                                        {
                                            @Html.Kendo().DatePickerFor(m => m.DUeDate).Format("dd MMM yyyy").HtmlAttributes(new { @class = "form-control form-control-sm", @disabled = "disabled" })
                                        }
                                        else
                                        {
                                            @Html.Kendo().DatePickerFor(m => m.DUeDate).Format("dd MMM yyyy").HtmlAttributes(new { @class = "form-control form-control-sm" })
                                        }

                                        <span class="k-invalid-msg" data-for="RegistrationDate"></span>
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub" style="display:none" id="form-to-location">
                                    <div class="form-group">
                                        <label>To location :</label>
                                        @(Html.Kendo().DropDownListFor(i => i.Move_Loc)
                                                                       .DataTextField("Text")
                                                                       .DataValueField("Value")
                                                                       .OptionLabel("Select...")
                                                                       .Filter(FilterType.Contains)
                                                                       //.HtmlAttributes(new { style = "width:100%;", required = "required" })
                                                                       .HtmlAttributes(new { style = "width:100%;" })
                                                                       .DataSource(source => source
                                                                           .Custom()
                                                                           .Transport(transport => transport
                                                                           .Read(read =>
                                                                           {
                                                                               //read.Action("LocationWarehouse", "Dropdown", new { area = "Finance" });
                                                                               read.Action("GetMasterLocationProcurement", "Dropdown", new { area = "Finance" });
                                                                           }))
                                                                       .ServerFiltering(false)
                                                                       ))

                                    </div>
                                </div>
                                
                            </div>

                            <div class="row">
                                @*<div class="col-sm-3 m-form__group-sub">
            <div class="form-group">
                <label>Requestor :</label>
                <div class="input-group input-group-sm">
                    @if ((Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) || (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed))
                    {
                        @Html.Kendo().TextBoxFor(m => m.EmployeeName).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly", @disabled = "disabled" })
                    }
                    else
                    {
                        @Html.Kendo().TextBoxFor(m => m.EmployeeName).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                    }

                </div>
            </div>
        </div>*@
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Requestor :</label>
                                        <div class="input-group input-group-sm">
                                            @if ((Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) || (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed))
                                            {
                                                @Html.Kendo().TextBoxFor(m => m.EmployeeName).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly", @disabled = "disabled" })
                                            }
                                            else
                                            {
                                                @Html.Kendo().TextBoxFor(m => m.EmployeeName).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                            }

                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Division :</label>
                                        <div class="input-group input-group-sm">
                                            @if ((Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) || (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed))
                                            {
                                                @Html.Kendo().TextBoxFor(m => m.division_name).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly", @disabled = "disabled" })
                                            }
                                            else
                                            {
                                                @Html.Kendo().TextBoxFor(m => m.division_name).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                            }

                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub" style="display:none;">
                                    <div class="form-group">
                                        <label>Business Unit :</label>
                                        @if ((Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) || (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed))
                                        {
                                            @(Html.Kendo().DropDownListFor(i => i.BusinessUnitId)
                                                                          .DataTextField("Text")
                                                                          .DataValueField("Value")
                                                                          .OptionLabel("All")
                                                                          .Filter(FilterType.Contains)
                                                                          .HtmlAttributes(new { style = "width:100%;", disabled = "disabled" })
                                                                          .DataSource(source => source
                                                                              .Custom()
                                                                              .Transport(transport => transport
                                                                              .Read(read =>
                                                                              {
                                                                                  read.Action("GetDivisionFinance", "Dropdown", new { area = "Finance" });
                                                                              }))
                                                                          .ServerFiltering(false)
                                                                          ))
                                        }
                                        else
                                        {
                                            @(Html.Kendo().DropDownListFor(i => i.BusinessUnitId)
                                                                              .DataTextField("Text")
                                                                              .DataValueField("Value")
                                                                              .OptionLabel("All")
                                                                              .Filter(FilterType.Contains)
                                                                              .HtmlAttributes(new { style = "width:100%;" })
                                                                              .DataSource(source => source
                                                                                  .Custom()
                                                                                  .Transport(transport => transport
                                                                                  .Read(read =>
                                                                                  {
                                                                                      read.Action("GetDivisionFinance", "Dropdown", new { area = "Finance" });
                                                                                  }))
                                                                              .ServerFiltering(false)
                                                                              ))
                                        }

                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub" style="display:none">
                                    <div class="form-group">
                                        <label>Out of Condition :</label>
                                        @(Html.Kendo().DropDownListFor(m => m.Inv_Out_Type)
                                                    .DataTextField("Text")
                                                    .OptionLabel("Select...")
                                                    .DataValueField("Value")
                                                    .Filter(FilterType.Contains)
                                                    .DataSource(source =>
                                                    {
                                                        source.Read(read =>
                                                        {
                                                            //read.Action("GetInvOutType", "GoodRequest", new { area = "Finance" }).Data("filterInvOutType");
                                                             read.Action("GetInvOutType", "GoodRequest", new { area = "Finance" });
                                                        }).ServerFiltering(true);
                                                    })
                                                    .Events(e =>
                                                    {
                                                        e.Change("onSelecInvFa");
                                                    })
                                                    .CascadeFrom("Type")
                                                    .Enable(false)
                                                    .AutoBind(false)
                                                    .HtmlAttributes(new { style = "width:100%;", @class = "form-control form-control-sm" })
                                        )

                                    </div>
                                </div>

                            </div>

                            <div class="row" style="display:none;">
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>On Behalf :</label>
                                        <div class="input-group input-group-sm">
                                            @if ((Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) || (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed))
                                            {
                                                @(Html.Kendo().DropDownListFor(i => i.OnBehalfId)
                                                                                   .DataTextField("Text")
                                                                                   .OptionLabel("Select...")
                                                                                   .DataValueField("Value")
                                                                                   .Filter(FilterType.Contains)
                                                                                   .HtmlAttributes(new { style = "width:100%;", disabled = "disabled" })
                                                                                    .DataSource(source =>
                                                                                   {
                                                                                       source.Read(read =>
                                                                                       {
                                                                                           read.Action("GetEmployee", "Dropdown", new { area = "Finance" });
                                                                                       }).ServerFiltering(true);
                                                                                   })
                                                                                   .Events(e =>
                                                                                   {
                                                                                       e.Change("onSelectBehalf");
                                                                                   }))
                                            }
                                            else
                                            {
                                                @(Html.Kendo().DropDownListFor(i => i.OnBehalfId)
                                                                                   .DataTextField("Text")
                                                                                   .OptionLabel("Select...")
                                                                                   .DataValueField("Value")
                                                                                   .Filter(FilterType.Contains)
                                                                                   .HtmlAttributes(new { style = "width:100%;" })
                                                                                    .DataSource(source =>
                                                                                   {
                                                                                       source.Read(read =>
                                                                                       {
                                                                                           read.Action("GetEmployee", "Dropdown", new { area = "Finance" });
                                                                                       }).ServerFiltering(false);
                                                                                   })
                                                                                   .Events(e =>
                                                                                   {
                                                                                       e.Change("onSelectBehalf");
                                                                                   }))
                                            }

                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Division :</label>
                                        <div class="input-group input-group-sm">
                                            @if ((Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) || (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed))
                                            {
                                                @Html.Kendo().TextBoxFor(m => m.behalf_div).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly", @disabled = "disabled" })
                                            }
                                            else
                                            {
                                                @Html.Kendo().TextBoxFor(m => m.behalf_div).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                            }

                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Job Title :</label>
                                        @if ((Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) || (Model.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed))
                                        {
                                            @Html.Kendo().TextBoxFor(m => m.behalf_jobtitle).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                        }
                                        else
                                        {
                                            @Html.Kendo().TextBoxFor(m => m.behalf_jobtitle).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                        }

