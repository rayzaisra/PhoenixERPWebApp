            //alert("On Progress..")
            var validator = $("#formGoodRequests").kendoValidator().data("kendoValidator");
            console.log("validator", validator);
            if (validator.validate()) {
                var gridDetails = $("#grid-goodrequest").data("kendoGrid");
                gridDetails.saveRow();
                var dataList = {
                    details: gridDetails.dataSource.data()
                };
                $("#InvFaName").val($("#InvFaId").data("kendoDropDownList").text());
