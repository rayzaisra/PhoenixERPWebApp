</style>

<script id="btnAction-template" type="text/x-kendo-template">
    <a href='javascript: void(0);' onclick='Detail(this)' title='Edit' class='edit'><span style='color:green'><i class='fa fa-edit'></i></span></a>
    @*<a href='javascript: void(0);' onclick='deleteGridRow(this)' title='Delete' class='delete'><span style='color:maroon'><i class='fa fa-trash-alt'></i></span></a>*@
</script>

<script id="GoodRequestNumber-template" type="text/x-kendo-template">
    <a href='javascript: void(0);' onclick='Detail(this)' title='Edit' class='edit'><span style='color:blue; text-decoration:underline;'> #=GoodRequestNumber# </span></a>
</script>


<script>
    function GetStatusButton(data) {
        var button = "";
        if (data.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval) {
            button = "<center><a href='javascript: void(0);' onclick='ProcessData(this)' class='m-badge m-badge--info m-badge--wide'>@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.StatusName(@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.WaitingApproval)</a></center>";
        } else if (data.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Approved) {
            button = "<center><a href='javascript: void(0);' onclick='ProcessData(this)' class='m-badge m-badge--warning m-badge--wide'>@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.StatusName(@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Approved)</a></center>";
        } else if (data.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed) {
            button = "<center><a href='javascript: void(0);' onclick='ProcessData(this)' class='m-badge m-badge--success m-badge--wide'>@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.StatusName(@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed)</a></center>";
        } else if (data.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Open) {
            button = "<center><a href='javascript: void(0);' onclick='ProcessData(this)' class='m-badge m-badge--info m-badge--wide'>@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.StatusName(@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Open)</a></center>";
        } else if (data.Status == @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Rejected) {
            button = "<center><a href='javascript: void(0);' onclick='ProcessData(this)' class='m-badge m-badge--danger m-badge--wide'>@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.StatusName(@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Rejected)</a></center>";
        } else {
             button = "<center><a href='javascript: void(0);' onclick='ProcessData(this)' class='m-badge m-badge--info m-badge--wide'>@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.StatusName(@PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Open)</a></center>";
        }
        return button;
    }

    //function Link(data) {
    //    return "<center><a href='javascript: void(0);' onclick='Detail(this)' title='Edit' class='edit' >" + data.GoodRequestNumber + "</a></center>";
    //}

    function Detail(e) {
        var item = dataItem(e);
        window.location.href = '@Url.Action("Detail", "GoodRequest")?Id=' + item.Id + '&isApprove=true';
    }

    function deleteGridRow(e) {
        deleteRow(e, '@Url.Action("Delete", "GoodRequest")');
    }

    function dataBoundEvent(e) {
        var grid = this;
        var currentRecords = grid.dataSource.view();

       var rows = e.sender.tbody.children();
        $(rows).each(function () {
            var rowLabel = $(this).find(".row-number");
            var pageSize = (e.sender.dataSource.pageSize() * (e.sender.dataSource.page() - 1));
            if (isNaN(pageSize)) { pageSize = 0; }
            var index = $(this).index() + 1 + pageSize;
            $(rowLabel).html(index);
        });

        for (var i = 0; i < currentRecords.length; i++) {
            var today = new Date();
            today.getDate();
            if (today > currentRecords[i].DUeDate && currentRecords[i].Status < @PhoenixERPWebApp.Models.Enum.GoodRequestStatus.Completed) {
                grid.tbody.find("tr[data-uid='" + currentRecords[i].uid + "']");
            }
        }
    }
</script>


