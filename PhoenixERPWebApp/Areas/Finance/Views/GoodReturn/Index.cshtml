                           columns.Bound(p => p.GoodsReturnNumber).Title("Goods Return Number").Width(200);
                           columns.Bound(p => p.GoodRequestNumber).Title("Goods Request Number").Width(200);
                           columns.Bound(p => p.ReturnDate).Width(200).Title("Date Return").Format("{0: dd MMM yyyy}");
                           columns.Bound(p => p.InvFaName).Width(200).Title("Name");
                           columns.Bound(p => p.InvFaNumber).Width(200).Title("FA/INVT Detail No");
                           columns.Bound(p => p.RequestedBy).Width(150);
                           columns.Bound(p => p.DivisionId).Width(150).Title("Division");
                           columns.Bound(p => p.Status).Width(150).Title("Status");
                           //columns.Bound(p => p.description).Width(200);
                           //columns.Bound(p => p.BusinessUnitName).Width(200);
                       })
                       .Pageable(pageable => pageable
                           .Refresh(true)
                           .PageSizes(true)
                           .ButtonCount(5))
                       .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                       .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                           .Extra(false)
                           .Operators(operators => operators
                           .ForString(str => str.Clear()
                               .Contains("Contains")
                               .StartsWith("Start sWith")
                               .EndsWith("End sWith")
                           )))
                       .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                       .Resizable(rsz => rsz.Columns(true))
                       .DataSource(dataSource => dataSource
                           .Ajax()
                           .PageSize(10)
                           .Events(events => events.Error("errorHandler"))
                           .Model(model => { model.Id(p => p.Id); })
                           .Read(read => read.Action("Read", "GoodReturn"))
                       )
                       .Events(e => e.DataBound("dataBoundEvent"))
                    )
