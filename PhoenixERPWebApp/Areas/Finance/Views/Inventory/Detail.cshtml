@model PhoenixERPWebApp.Models.Finance.Transaction.Inventory.Inventory
@{
    ViewData["Title"] = "Inventory";
}
@{
    ViewData["Title"] = "Detail";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Inventory</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-suitcase"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance </span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item"><a asp-action="index" asp-controller="Inventory" asp-area="finance" class="m-nav__link"> <span class="m-nav__link-text">Inventory</span></a></li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <span class="m-nav__link-text">Inventory Detail</span>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>

<div class="m-content">
    <div class="row">
        <div class="col-xl-12 col-lg-12">
            <div class="m-portlet">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-wrapper">
                        <div class="m-portlet__head-caption">
                            <div class="m-portlet__head-title">
                                <h3 class="m-portlet__head-text m--font-success">
                                    Inventory &nbsp;
                                    <span id="status"></span>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_qf2tcah4xx"><i class="la la-expand"></i></a>
                    </div>
                </div>
                <div class="m-portlet__body">
                    <div class="m-form__group">
                        <form id="formInventory" class="m-form m-form--fit m-form--label-align-right m-form--group-seperator-dashed" asp-action="submit" asp-controller="Inventory" asp-area="Finance" enctype="multipart/form-data">
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="LegalEntity" />
                            <input type="hidden" asp-for="BusinessUnit" />
                            <input type="hidden" asp-for="InventoryGoodsReceiptId" />
                            <input type="hidden" asp-for="CreatedOn" />
                            <input type="hidden" asp-for="CreatedBy" />
                            <input type="hidden" asp-for="OwnerId" />
                            <input type="hidden" asp-for="FileUpload" />

                            <div class="row">
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Inventory Number :</label>
                                        @Html.Kendo().TextBoxFor(m => m.InventoryInNumber).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly", style = "width:100%", Placeholder = "Auto Generated by System.." })
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Inventory Name :</label>
                                        @Html.Kendo().TextBoxFor(m => m.InventoryName).HtmlAttributes(new { @class = "form-control form-control-sm", @required = "required" })
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Brand :</label>
                                        @Html.Kendo().TextBoxFor(m => m.Brand).HtmlAttributes(new { @class = "form-control form-control-sm" })
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Job Name :</label>
                                        @(Html.Kendo().DropDownListFor(m => m.JobId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .OptionLabel("Non Job")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                        source.Read(read =>
                                        {
                                        read.Action("Job", "DropDown", new { area = "Finance" });
                                        });
                                        })
                                        .HtmlAttributes(new { style = "width:100%;", @class = "form-control form-control-sm" })
                                        )
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 m-form__group-sub">
                                    <div class="form-group">
                                        <div class="form-group">
                                            <label>Unit of Measure :</label>
                                            @(Html.Kendo().DropDownListFor(m => m.UomId)
                                           .DataTextField("Text")
                                           .OptionLabel("Select Location...")
                                           .DataValueField("Value")
                                           .Filter(FilterType.Contains)
                                           .DataSource(source =>
                                           {
                                           source.Read(read =>
                                           {
                                           read.Action("GetDDLUnit", "DropDown", new { area = "Finance" });
                                           });
                                           })
                                           .HtmlAttributes(new { style = "width:100%;", @class = "form-control form-control-sm", required = "required" })
                                        )
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Lead Time :</label>
                                        @(Html.Kendo().TextBoxFor(m => m.LeadTime).HtmlAttributes(new { @class = "form-control form-control-sm", style = "width:100%" , @required = "required" }))
                                        @*@Html.Kendo().NumericTextBoxFor(m => m.LeadTime).Spinners(true).Format("{0:N0}").HtmlAttributes(new { @class = "form-control form-control-sm", @required = "required" })*@
                                    </div>
                                </div>
                                <div class="col-lg-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Model :</label>
                                        @Html.Kendo().TextBoxFor(m => m.Model).HtmlAttributes(new { @class = "form-control form-control-sm" })
                                    </div>
                                </div>
                                <div class="col-lg-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Manufacture :</label>
                                        @Html.Kendo().TextBoxFor(m => m.Manufacture).HtmlAttributes(new { @class = "form-control form-control-sm" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Vendor Name :</label>
                                        @(Html.Kendo().DropDownListFor(m => m.VendorNameId)
                                        .DataTextField("Text")
                                        .OptionLabel("Select Vendor Name")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                        source.Read(read =>
                                        {
                                        read.Action("GetVendorNames", "DropDown", new { area = "Finance" });
                                        });
                                        })
                                        .HtmlAttributes(new { style = "width:100%;", @class = "form-control form-control-sm" })
                                        )
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Legal Entity :</label>
                                        @(Html.Kendo().DropDownListFor(m => m.LegalEntityId)
                                        .DataTextField("Text")
                                        .OptionLabel("Select Legal Entity...")
                                        .DataValueField("Value")
                                        .OptionLabel("--Select--")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                        source.Read(read =>
                                        {
                                        read.Action("GetLegalEntity", "DropDown", new { area = "Finance" });
                                        });
                                        })
                                        .HtmlAttributes(new { style = "width:100%;", @class = "form-control form-control-sm", required = "required" })
                                        )
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Affiliation :</label>
                                        @(Html.Kendo().DropDownListFor(m => m.AffiliationId)
                                        .DataTextField("Text")
                                        .OptionLabel("Select Affiliation...")
                                        .DataValueField("Value")
                                        .OptionLabel("--Select--")
                                        .DataSource(source =>
                                        {
                                        source.Read(read =>
                                        {
                                        read.Action("GetAffiliation", "DropDown", new { area = "Finance" });
                                        });
                                        })
                                        .HtmlAttributes(new { style = "width:100%;", @class = "form-control form-control-sm", required = "required" })
                                        )
                                    </div>
                                </div>

                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Business Unit :</label>
                                        @(Html.Kendo().DropDownListFor(m => m.BusinessUnitId)
                                        .DataTextField("Text")
                                        .OptionLabel("Select Business Unit")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                        source.Read(read =>
                                        {
                                        read.Action("GetDDLBusinessUnitByAffId", "DropDown", new { area = "Finance" }).Data("FilterBusinessUnitById");
                                        }).ServerFiltering(true);
                                        })
                                        .CascadeFrom("AffiliationId")
                                        .Enable(false)
                                        .AutoBind(false)
                                        .HtmlAttributes(new { style = "width:100%;", @class = "form-control form-control-sm" }))
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-3 m-form__group-sub" style="display:none;">
                                    <div class="form-group">
                                        <label>Total Qty :</label>
                                        @Html.Kendo().NumericTextBoxFor(m => m.TotalQty).Spinners(false).HtmlAttributes(new { @class = "form-control form-control-sm", @format = "{0:N0}" })
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Get From :</label>
                                        @(Html.Kendo().DropDownListFor(m => m.GetFrom)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .HtmlAttributes(new { style = "width:100%;", required = "required" })
                                        .OptionLabel($"Choose Get From..")
                                        .DataSource(source =>
                                        source.Read(read =>
                                        {
                                        read.Action("GetFrom", "DropDown", new { area = "Finance" });
                                        })
                                        .ServerFiltering(false)
                                        ))
                                    </div>
                                </div>
                                <div class="col-lg-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label asp-for="FileUpload"></label> <span class="req"></span> :
                                        <div id="divFileUpload"></div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.FileUploadName))
                                {
                                    <div class="col-lg-3 m-form__group-sub">
                                        <div class="form-group">
                                            <div style="width:100%" class="displayimage">
                                                <label>Image :</label>
                                                <a class="thumbnail pull-left" href="#">
                                                    <img class="media-object" id="img-inventory-nava" width="225">
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Remark :</label>
                                        @Html.Kendo().TextBoxFor(m => m.Remark).HtmlAttributes(new { @class = "form-control form-control-sm" })
                                    </div>
                                </div>
                            </div>
                            <hr />
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="m-accordion m-accordion--bordered m-accordion--solid" id="detail" role="tablist">
                                        <!--begin::Item-->
                                        <div class="m-accordion__item">
                                            <div class="m-accordion__item-head" role="tab" id="detail_head" data-toggle="collapse" href="#detail_body" aria-expanded="true">
                                                <span class="m-accordion__item-icon"><i class="fa flaticon-interface-4"></i></span>
                                                <span class="m-accordion__item-title">Inventory Detail</span>
                                                <span class="m-accordion__item-mode"></span>
                                            </div>
                                            <div class="m-accordion__item-body show" id="detail_body" role="tabpanel" aria-labelledby="detail_head" data-parent="#detail" style="">
                                                <div class="m-accordion__item-content">
                                                    <div class="row">
                                                        <div class="form-group">
                                                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Finance.Transaction.Inventory.InventoryDetail>
                                                                ()
                                                                .Name("grid")
                                                                .ToolBar(x =>
                                                                {
                                                                    x.ClientTemplateId("grid-toolbar-template");
                                                                })
                                                                .Columns(columns =>
                                                                {
                                                                    columns.Command(command =>
                                                                    {
                                                                        command.Custom("").TemplateId("btnAction-template");
                                                                    }).Title("Action").HtmlAttributes(new { style = "text-align:center;" });
                                                                    //.HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(90);
                                                                    //columns.Bound("").Title("#").Width(35).Filterable(false).HtmlAttributes(new { style = "text-align:center;", @class = "row-number" }).HeaderHtmlAttributes(new { style = "text-align:center;" });
                                                                    columns.Bound(p => p.Id).ClientTemplate("#= EditDetail(data) #").Width(200);
                                                                    //columns.Bound(p => p.ProductNumber).Width(150);
                                                                    //columns.Bound(p => p.ItemName).Width(200);
                                                                    columns.Bound(p => p.Color).Width(100);
                                                                    //columns.Bound(p => p.Condition).ClientTemplate("#=ConditionName#").Width(200);
                                                                    columns.Bound(p => p.Qty).Width(100);
                                                                    columns.Bound(p => p.Location).ClientTemplate("#=LocationName#").Width(200);
                                                                    columns.Bound(p => p.status_name).Title("Condition").Width(150);
                                                                    //columns.Bound(p => p.Manufacturer).Width(200);
                                                                    //columns.Bound(p => p.Brand).Width(200);
                                                                    //columns.Bound(p => p.Model).Width(100);
                                                                    //columns.Bound(p => p.UnitOfMeasure).Width(200);
                                                                    //columns.Bound(p => p.LeadTime).Width(100);
                                                                })
                                                                //.Events(ev => ev.DataBound("SumQty"))
                                                                .Pageable(pageable => pageable
                                                                .Refresh(true)
                                                                .PageSizes(true)
                                                                .ButtonCount(5))
                                                                .Resizable(rsz => rsz.Columns(true))
                                                                .DataSource(dataSource => dataSource
                                                                .Ajax()
                                                                .PageSize(10)
                                                                .Events(events => events.Error("errorHandler"))
                                                                .Model(model => { model.Id(p => p.Id); })
                                                                .Read(read => read.Action("ReadDetail", "Inventory").Data("InvId"))
                                                                .Update(update => update.Action("Editing_Detail_Update", "Inventory"))
                                                                .Destroy(destroy => destroy.Action("DestroyDetail", "Inventory"))
                                                                )
                                                                .Events(e => e.DataBound("SumQty")
                                                                //.Save("InventoryDetail_SaveEvent").Edit("InventoryDetail_EditEvent")
                                                                )
                                                                .NoRecords()
                                                            )
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr />
                            <div class="row">
                                <div class="col-lg-12">

                                    <div class="pull-right">
                                        <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                                        <a asp-action="index" asp-controller="Inventory" asp-area="finance" class="fakelink btn btn-secondary">Close</a>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <!--end::Form-->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_DetailInv" />

<script id="btnAction-template" type="text/x-kendo-template">
    <a href='javascript: void(0);' onclick='deleteGridRow(this)' title='Delete' class='delete'><span style='color:maroon'><i class='fa fa-trash-alt'></i></span></a>
</script>

<script id="grid-toolbar-template" type="text/x-kendo-template">
    <a class='k-button' href='javascript: void(0);' onclick='AddFormDetailInventory(this)'><span class='k-icon k-i-plus'></span>Add Detail</a>
</script>

<script>

   
    function formatNumber(num) {
        return (
            num
                //.toFixed(2) // always two decimal digits
                .replace(',', '.') // replace decimal point character with ,
                .replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.')
        ) // use . as a separator
    }
    function FilterBusinessUnitById() {
        return {
            affiliationid : $("#AffiliationId").val()
        };
    }

    $(function () {

        $("#btn-save").click(pageFunction.save);
        var FileUploadName = '@Model.FileUploadName';
        console.log("FileUploadName = " + FileUploadName);
             if (FileUploadName == '') {
                 $('.displayimage').hide();
             } else {
                  $('.displayimage').show();
             }

            if (FileUploadName == '') {
                FileUpload();
            } else {
                 FileUpload();
                 getImageInventroy();
            }

        var FileUploadNameDetail = '@Model.InventoryDetail.FileAttachmentName';
        if (FileUploadNameDetail == '') {
            FileAttachmentFunction();
        } else {
            $("#downloadLinkFileAttachment").text(FileUploadNameDetail);
        }

       
        
      });

    function EditDetail(data) {
        return "<center><a href='javascript: void(0);' onclick='FormDetail(this)' title='Edit' class='edit'>" + data.Id + "</a></center>";
    }

    function deleteGridRow(e) {
        var grid = $("#grid").data("kendoGrid");
        grid.removeRow("tr:eq(1)");
        //deleteRow(e, '@Url.Action("DeleteTempDetail", "Inventory")');
    }

    function AddFormDetailInventory(e) {
        var valid = $("#formInventory").validate().form();
        if (valid) {
            ClearFormDetailInventory()
            var id = $("#Id").val();
            $('#InventoryDetail_InventoryId').val(id);
            var qtyNumeric = $("#InventoryDetail_Qty").data("kendoNumericTextBox");
            qtyNumeric.value(1);
            $('#modalDetailInv').modal('show');

        }
    }

    function SumQty(e) {
        var total = 0;
        //var grid = $("[id ^= 'Grid_']").data("kendoGrid");
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();
        for (var i = 0; i < gridData.length; i++) {
            total += gridData[i].Qty;
        }
        $("#TotalQty").data("kendoNumericTextBox").value(total);
    }

    function InvId() {
        return {
            invId: $("#Id").val()
        };
    }


    function RequiredDetailRemove() {

    }

    function saveDetailInv() {
        var valid = $("#formDetailInv").validate().form();
        if (valid) {
            var dataList = {}
            $('#InventoryDetail_ConditionName').val($('#InventoryDetail_Condition').data("kendoDropDownList").text());
            $('#InventoryDetail_LocationName').val($('#InventoryDetail_Location').data("kendoDropDownList").text());
            $('#InventoryDetail_status_name').val($('#InventoryDetail_Status').data("kendoDropDownList").text());
            $('#InventoryDetail_UnitOfMeasure').val($('#InventoryDetail_UomId').data("kendoDropDownList").text());
            callActionFile({ formId: "formDetailInv", title: "save", type: "POST", objects: dataList });
            //callActionFile({ formId: "formDetailInv", title: "save", type: "POST", url: '@Url.Action("SaveDetailPersist", "Inventory")', objects: dataList });
        }
    }

    function FormDetail(e) {
        var item = dataItem(e);
        $('#modalDetailInv').modal('show');
        $('#InventoryDetail_Id').val(item.Id);
        $('#InventoryDetail_InventoryId').val(item.InventoryId);
        $('#InventoryDetail_DateReceipt').val(item.DateReceipt);
        var qtyNumeric = $("#InventoryDetail_Qty").data("kendoNumericTextBox");
        qtyNumeric.value(1);
        $('#InventoryDetail_UnitName').val(item.UnitName);
        $('#InventoryDetail_Manufacturer').val(item.Manufacturer);
        $('#InventoryDetail_Brand').val(item.Brand);
        $('#InventoryDetail_Model').val(item.Model);
        $('#InventoryDetail_ProductNumber').val(item.ProductNumber);
        $('#InventoryDetail_Color').val(item.Color);
        $('#InventoryDetail_Condition').data("kendoDropDownList").value(item.Condition);
        $('#InventoryDetail_Location').data("kendoDropDownList").value(item.Location);
        $('#InventoryDetail_DateReceipt').val(item.DateReceipt);
        $('#InventoryDetail_Remark').val(item.Remark);
        $('#InventoryDetail_ItemName').val(item.ItemName);

        $('#InventoryDetail_Status').data("kendoDropDownList").value(item.Status);
        $('#InventoryDetail_VendorNameId').data("kendoDropDownList").value(item.VendorNameId);
        $('#InventoryDetail_VendorBrandId').data("kendoDropDownList").value(item.VendorBrandId);
        $('#InventoryDetail_UomId').data("kendoDropDownList").value(item.UomId);
        //var numerictextbox = $("#InventoryDetail_LeadTime").data("kendoNumericTextBox");
        //numerictextbox.value(item.LeadTime);

        //$('#InventoryDetail_FileAttachment').val(item.FileAttachment);
        //if (item.FileAttachment != null) {
        //    $("#divFileAttachment").empty();
        //    $('#downloadLinkFileAttachment').text(item.FileAttachmentName);
        //    $('#removeLinkFileAttachment').html("<span style='color:maroon'><i class='fa fa-times'></i></span>");
        //}
    }

    function ClearFormDetailInventory() {
        $("#InventoryDetail_Id").val("");
        //$("#InventoryDetail_InventoryId").val("");
        $('#InventoryDetail_DateReceipt').val("");
        $('#InventoryDetail_Qty').data("kendoNumericTextBox").value(0);
        $('#InventoryDetail_UnitName').val("");
        $('#InventoryDetail_Manufacturer').val("");
        $('#InventoryDetail_Brand').val("");
        $('#InventoryDetail_Model').val("");
        $('#InventoryDetail_ProductNumber').val("");
        $('#InventoryDetail_Color').val("");
        $('#InventoryDetail_Condition').data("kendoDropDownList").value("");
        $('#InventoryDetail_Location').data("kendoDropDownList").value("");
        $('#InventoryDetail_DateReceipt').val("");
        $('#InventoryDetail_Remark').val("");
        $('#InventoryDetail_ItemName').val("");
        $('#InventoryDetail_Status').data("kendoDropDownList").value("");
        $('#InventoryDetail_VendorNameId').data("kendoDropDownList").value("");
        $('#InventoryDetail_VendorBrandId').data("kendoDropDownList").value("");
        $('#InventoryDetail_UomId').data("kendoDropDownList").value("");
        //$("#InventoryDetail_LeadTime").data("kendoNumericTextBox").value(0);
        $('#InventoryDetail_FileAttachment').val("");
    }

    function FileUpload() {
        //$("#linkDownloadFile").empty();
        $("#linkInterviewRemoveFile").empty();
        $("#divFileUpload").empty().append("<input name='file' id='file' type='file'/>");

        $("#file").kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".jpg",".jpeg", ".png", ".gif", ".doc", ".pdf", ".docx"]
            }
        });
    }

    function removeFileUpload() {
        FileUpload();
    }

    function downloadFileUpload() {
        downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download" })', data: { id: $("#FileUpload").val() }});
    }

    //############################################################
    @*var param = (function (param) {
        param.saveUrl = "@Url.Action("Save", "Inventory")";
        return param;
    })(param || {});*@

    var pageFunction = (function (pageFunction) {
        pageFunction.init = function () {
            //initialize
        };
        pageFunction.save = function () {

            var gridDetails = $("#grid").data("kendoGrid");
            gridDetails.saveRow();
            var dataList = {
                details: gridDetails.dataSource.data()
            }
            $("#LegalEntity").val($("#LegalEntityId").data("kendoDropDownList").text());
            $("#BusinessUnit").val($("#BusinessUnitId").data("kendoDropDownList").text());
            callActionFile({ formId: "formInventory", title: "save", type: "POST", objects: dataList });
        };
        return pageFunction;
    })(pageFunction || {});


 let getImageInventroy = function () {

     let urlApi = $.helper.resolveApi("~odrive/GetImageInventory");
     var id = '@Model.FileUploadName';

       mApp.blockPage({
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        }),
        $.ajax({
        type: "GET",
        dataType: 'json',
        url: urlApi,
        data: {id: id},
        success: function (data) {
            console.log("data = " + data.webUrl);
            if (data.webUrl !== null) {
                $("#img-inventory-nava").attr("src",data.webUrl);
            }
        },
        error: function (e, t, s) {
                //swal(
                //    'Information',
                //    'Ooops, something went wrong !',
                //    'info'
                //);
            console.log(e);
            }
        }).then(setTimeout(function () {
            mApp.unblockPage();
        }, 2e3));
    };

    function InventoryDetail_SaveEvent(e) {
        var Manufacturer = $("#Manufacturer").data("kendoTextBox").value();
        var Brand = $("#Brand").data("kendoTextBox").value();
        var Model = $("#Model").data("kendoTextBox").value();
        var ProductNumber = $("#ProductNumber").data("kendoTextBox").value();
        var Color = $("#Color").data("kendoTextBox").text();
        var Condition = $("#Condition").data("kendoDropDownList").text();
        var Qty = $("#Qty").data("kendoNumericTextBox").value();
        var UnitName = $("#UnitName").data("kendoTextBox").text();
        var Location = $("#Location").data("kendoDropDownList").text();
        //var LeadTime = $("#LeadTime").data("kendoNumericTextBox").value();
        e.model.set("Manufacturer", Manufacturer);
        e.model.set("Brand", Brand);
        e.model.set("Model", Model);
        e.model.set("ProductNumber", ProductNumber);
        e.model.set("Color", Color);
        e.model.set("Condition", Condition);
        e.model.set("Qty", Qty);
        e.model.set("UnitName", UnitName);
        e.model.set("Location", Location);
        //e.model.set("LeadTime", LeadTime);
    }

