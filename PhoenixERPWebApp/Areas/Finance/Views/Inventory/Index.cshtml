@{
    ViewData["Title"] = "Inventory";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<link href="~/bundles/css/datatable.min.css?@DateTime.Now" rel="stylesheet" />
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Inventory</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-suitcase"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Inventory</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div class="input-group input-group-sm">
                                <a asp-action="Detail" asp-controller="Inventory" asp-area="Finance" class="m-btn btn btn-primary btn-sm m-btn--sm"><i class="la la-plus"></i></a>
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                @*<form id="form-search-dt_basic">
                                    <div class="input-group">
                                        <div class="input-group-prepend"><span class="input-group-text input-group-sm"><i class="la la-search"></i></span></div>
                                        <input autocomplete="off" type="text" name="q" class="form-control form-control-sm m-input searchbox" placeholder="Search">
                                    </div>
                                </form>*@
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Finance.Transaction.Inventory.Inventory>()
                        .Name("grid")
                        .Columns(columns =>
                        {
                            columns.Command(command =>
                            {
                                command.Custom("").TemplateId("btnAction-template");
                            }).Title("Action").HtmlAttributes(new { style = "text-align:center;" })
                            .HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(90);
                           columns.Bound("").Title("#").Width(35).Filterable(false).HtmlAttributes(new { style = "text-align:center;", @class = "row-number" }).HeaderHtmlAttributes(new { style = "text-align:center;" });

                            //columns.Bound("").Title("#").Width(35).Filterable(false)
                            //.HtmlAttributes(new { style = "text-align:center;", @class = "row-number" })
                            //.HeaderHtmlAttributes(new { style = "text-align:center;" });
                            columns.Bound(p => p.Id).Width(200).Hidden();
                            //columns.Bound(p => p.InventoryInNumber).ClientTemplate("#= Link(data) #").Title("Inventory No").Width(200);
                            columns.Bound(p => p.InventoryInNumber).Title("Inventory No").Width(200);
                            columns.Bound(p => p.InventoryName).Width(200);
                            columns.Bound(p => p.Brand).Title("Brand").Width(200);
                            columns.Bound(p => p.LeadTime).Title("Lead Time").Width(150);
                            columns.Bound(p => p.FileUploadName).ClientTemplateId("download-template").Width(150);
                            columns.Bound(p=>p.TotalQty).Title("Total Qty").Width(100);
                            columns.Bound(p=>p.QtyOnHand).Title("Qty On Hand").Width(100);
                            columns.Bound(p=>p.QtyOutReturn).Title("Qty Out Return").Width(100);
                            columns.Bound(p=>p.QtyBroken).Title("Qty Broken").Width(100);
                            //columns.Bound(p=>p.QtyNoReturn).Title("Qty No Return").Width(100);
                            columns.Bound(p => p.BusinessUnit).Title("Division").Width(200);
                            columns.Bound(p => p.LegalEntity).Title("Legal Entity").Width(200);
                        })
                        .Pageable(pageable => pageable
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
                        .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                        .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                        .Resizable(rsz => rsz.Columns(true))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(10)
                            .Events(events => events.Error("errorHandler"))
                            .Model(model =>
                            {
                                model.Id(p => p.Id);
                            })
                            .Read(read => read.Action("Read", "Inventory"))
                        )
                        .Events(x => x.DataBound("dataBoundEvent"))
                        .NoRecords()
                        .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                            .Extra(false)
                            .Operators(operators => operators
                            .ForString(str => str.Clear()
                                .Contains("Contains")
                                .StartsWith("Start sWith")
                                .EndsWith("End sWith")
                            )))
                    )
                </div>
            </div>
        </div>
    </div>
</div>

<script id="btnAction-template" type="text/x-kendo-template">
    <a href='javascript: void(0);' onclick='editGridRow(this)' title='Edit' class='edit'><span style='color:green'><i class='fa fa-edit'></i></span></a>
    <a href='javascript: void(0);' onclick='deleteGridRow(this)' title='Delete' class='delete'><span style='color:maroon'><i class='fa fa-trash-alt'></i></span></a>
</script>

<script id="download-template" type="text/x-kendo-template">
    <a href='javascript: void(0);' onclick='downloadGidRow(this)' style="text-decoration:underline;color:blue;">#=FileUploadName#</a>
</script>

<script>

    function editGridRow(e) {
        var item = dataItem(e);
        window.location.href = '@Url.Action("Detail", "Inventory")?Id=' + item.Id;
    }

    function deleteGridRow(e) {
        deleteRow(e, '@Url.Action("Delete", "Inventory")');
    }

     function downloadGidRow(e) {
        var item = dataItem(e);
        downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download" })', data: { id: item.FileUpload }});
    }

    function Link(data) {
        return "<center><a href='javascript: void(0);' onclick='Detail(this)' title='Edit' class='edit'>" + data.InventoryInNumber + "</a></center>";
    }

    function Detail(e) {
        var item = dataItem(e);
        window.location.href = '@Url.Action("Detail", "Inventory")?Id=' + item.Id;
    }

</script>

