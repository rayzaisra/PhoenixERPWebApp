                                                                                {
                                                                                    model.Id(p => p.Id);
                                                                                    model.Field(p => p.Id).Editable(false);
                                                                                    //model.Field(p => p.FixedAssetName).Editable(false);
                                                                                    model.Field(p => p.UnitCount).Editable(false);
                                                                                })
                                                                                .Read(read => read.Action("ReadFixedAsset", "InventoryGoodsReceipt").Data("GetInventoryGoodReceiptId"))
                                                                                .Update(update => update.Action("EditingFA_Update", "InventoryGoodsReceipt"))
                                                                            )
                                                                            .Events(x => x.Save("FixedAsset_SaveEvent"))
                                                                            .NoRecords()
                                                                        )
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <br />
                            }
                            <div class="row ">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label asp-for="Remark"></label> :
                                        @Html.TextAreaFor(x => x.Remark, new { style = "height:100px;width:100%" })
                                    </div>
                                </div>
                            </div>

                            <br />
                            <div class="row">
                                <div class="col-lg-12" id="m_blockui_list">
                                    <div class="m-accordion m-accordion--bordered m-accordion--solid" id="grhistory_detail" role="tablist">
                                        <!--begin::Item-->
                                        <div class="m-accordion__item">
                                            <div class="m-accordion__item-head collapsed" role="tab" id="po_detail_head" data-toggle="collapse" href="#grhistory_detail_body" aria-expanded="true">
                                                <span class="m-accordion__item-icon"><i class="fa flaticon-suitcase"></i></span>
                                                <span class="m-accordion__item-title">Goods and Bast Receipt History</span>
                                                <span class="m-accordion__item-mode"></span>
                                            </div>
                                            <div class="m-accordion__item-body collapse" id="grhistory_detail_body" role="tabpanel" aria-labelledby="grhistory_detail_head" data-parent="#grhistory_detail" style="">
                                                <div class="m-accordion__item-content">
                                                    <div class="row">
                                                        <div class="col-sm-12">
                                                            <div class="form-group ">
                                                                @(Html.Kendo().Grid<PhoenixERPWebApp.Models.InventoryGoodsReceiptDetail>()
                                                                    .Name("gridhistory")
                                                                    .Columns(columns =>
                                                                    {
                                                                        columns.Bound(p => p.Id).Width(200).Hidden();
                                                                        columns.Bound(p => p.ModifiedOn).Title("Date Receipt").Width(100).Format("{0:dd MMMM yyyy}");
                                                                        columns.Bound(p => p.InventoryGoodsReceiptId).Width(100).Title("Goods and Bast Receipt Number");
                                                                        columns.Bound(p => p.ItemTypeName).Width(100).Title("Type");
                                                                        columns.Bound(p => p.InventoryId).Title("ID-Name").Width(200).Hidden(true);
                                                                        columns.Bound(p => p.Task).Width(200).Title("Name");
                                                                        columns.Bound(p => p.ReceivedQty).Title("ReceivedQty").Width(100).Format("{0:n0}").HtmlAttributes(new { style = "text-align:right;" }); ;
                                                                    })
                                                                    .Pageable(pageable => pageable
                                                                        .Refresh(true)
                                                                        .PageSizes(true)
                                                                        .ButtonCount(5)
                                                                    )
                                                                    .DataSource(dataSource => dataSource
                                                                        .Ajax()
                                                                        .PageSize(5)
                                                                        .Events(events => events.Error("errorHandler"))
                                                                        .Model(model =>
                                                                        {
                                                                            model.Id(p => p.Id);
                                                                        })
                                                                        .Read(read => read.Action("ReadHistory", "InventoryGoodsReceipt").Data("GetPurchaseOrderId"))
                                                                    )
                                                                    .NoRecords()
                                                                )
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <partial name="_StatusLog" />
                        </div>
                                           
                    </form> 
                    <br><hr>
                    <div style="text-align: right;">
                        @if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Draft)
                        {
                            <button type="button" id="btnSave" class="btn btn-success edit"><span class="fa fa-save"></span> Save</button>
                            <button type="button" id="btnSubmit" class="btn btn-primary edit"><span class="fa fa-paper-plane"></span> Submit</button>
                        } 
                        <a asp-action="Index" asp-controller="InventoryGoodsReceipt" asp-area="Finance" class="fakelink btn btn-secondary"><span class="fa fa-arrow-circle-left"></span> Cancel</a>
                    </div>    
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () { 
        if ('@Model.Status' == '@PhoenixERPWebApp.Models.StatusTransactionName.Close') {
            $("#VendorId").data("kendoDropDownList").readonly();
            $("#PurchaseOrderId").data("kendoDropDownList").readonly();
            $("#LocationId").data("kendoDropDownList").readonly();
            $("#GoodsReceiptDatetime").data("kendoDatePicker").readonly();   
        }     

        $('#inventorygoodreceiptgeneratemode').hide();
        $('#btnSubmit').hide();
        if ('@Model.Id') {
            $('#inventorygoodreceiptgeneratemode').show();
            $('#btnSubmit').show();
        }
    });

    function GoodsReceiptDetail_EditEvent(e) { 
        if (e.model.ItemTypeName != "Inventory") {
            var disableField = e.container.find("input[name=InventoryId]").data("kendoDropDownList");
            disableField.enable(false);
        } 
        //if (e.model.LastRemainingQty == null || e.model.LastRemainingQty == 0) {
        //    $('#ReceivedQty').data('kendoNumericTextBox').options.max = e.model.PurchasedQty;
        //} else {
        //    $('#ReceivedQty').data('kendoNumericTextBox').options.max = e.model.LastRemainingQty;
        //}
    } 

    function GoodsReceiptDetail_SaveEvent(e) { 
        var PurchasedQty = $("#PurchasedQty").data("kendoNumericTextBox").value();
        var ReceivedQty = $("#ReceivedQty").data("kendoNumericTextBox").value(); 
        var RemainingQty = $("#RemainingQty").data("kendoNumericTextBox").value();
        var InventoryId = $("#InventoryId").data("kendoDropDownList").value();
        var InventoryName = $("#InventoryId").data("kendoDropDownList").text(); 

        e.model.set("PurchasedQty", PurchasedQty);
        e.model.set("ReceivedQty", ReceivedQty); 
        e.model.set("RemainingQty", RemainingQty);
        e.model.set("InventoryId", InventoryId);
        e.model.set("InventoryName", InventoryName); 
    }

    function FixedAsset_SaveEvent(e) {
        var UomId = $("#UomId").data("kendoDropDownList").value();
        var UomName = $("#UomId").data("kendoDropDownList").text();
        var ConditionId = $("#Condition").data("kendoDropDownList").value();
        var ConditionName = $("#Condition").data("kendoDropDownList").text();

        e.model.set("UomId", UomId);
        e.model.set("UnitName", UomName);
        e.model.set("Condition", ConditionId);
        e.model.set("ConditionName", ConditionName);
    }

    function InventoryDetail_SaveEvent(e) {
        var UomId = $("#UomId").data("kendoDropDownList").value();
        var UomName = $("#UomId").data("kendoDropDownList").text();
        var ConditionId = $("#Condition").data("kendoDropDownList").value();
        var ConditionName = $("#Condition").data("kendoDropDownList").text();

        e.model.set("Condition", ConditionId);
        e.model.set("ConditionName", ConditionName);
        e.model.set("UomId", UomId);
        e.model.set("UnitName", UomName);
    }

    function calculate_change(e) {
        var PurchasedQty = $('#PurchasedQty').data("kendoNumericTextBox").value();
        var ReceivedQty = $('#ReceivedQty').data("kendoNumericTextBox").value();
        var _lastRemaining = '';

        if ($('#LastRemainingQty').val() == '')
            _lastRemaining = '0';
        else
            _lastRemaining = $('#LastRemainingQty').val();

        var remainingQty = parseInt(_lastRemaining); 
        //var RemainingQty = PurchasedQty - (PurchasedQty - remainingQty) - ReceivedQty;
        //var RemainingQty = PurchasedQty - (remainingQty + ReceivedQty);
        if (remainingQty == '0') { remainingQty = PurchasedQty; }
        var RemainingQty = remainingQty - ReceivedQty + (PurchasedQty - remainingQty);
        if (RemainingQty < 0) {
            swal('Warning', 'Remaining qty must greather than 0 !', 'warning');
            $('#ReceivedQty').data("kendoNumericTextBox").value('0')
            $('#RemainingQty').data("kendoNumericTextBox").value(_lastRemaining);
        }
        else { $('#RemainingQty').data("kendoNumericTextBox").value(RemainingQty); }
    }

    function GetPurchaseOrderId() {
        return {
            poId: $("#PurchaseOrderId").val()
        };
    }

    function GetInventoryGoodReceiptDetail() {
        return {
            poId: $("#PurchaseOrderId").val(),
            grId: $("#Id").val()
        }
    }

    function GetInventoryGoodReceiptId() {
        return {
            grId: $("#Id").val()
        }
    }

    function filterPurchaseOrders() {
        return {
            clientId: $("#VendorId").val(),
            grId: $("#Id").val()
        };
    }

    function po_selectEvent(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            $("#PurchaseOrderId").val(dataItem.Value);
             $("#pod").data("kendoGrid").dataSource.data([]);
            $("#gridpod").data("kendoGrid").dataSource.data([]);
            $("#JobName").val("");
            $("#BusinessUnitName").val("");
            $("#CompanyName").val("");
            $("#BrandName").val("");
            $("#LegalEntityName").val("");
            $("#BusinessUnitId").val("");
            $("#BrandId").val("");
            $("#CompanyId").val("");
            $("#LegalEntityId").val("");
            $("#JobId").val("");
            $("#InvoicingTypeName").val("");
            $("#PurchaseOrderNumber").val("");
            $("#AffiliationId").val("");
            $("#AffiliationName").val("");
            $("#PicName").val("");

            $.ajax({
                type: "POST",
                url: '@Url.Action("GetDataPO", "InventoryGoodsReceipt")',
                data: { poId: dataItem.Value  },
                success: function (data) { 
                    $("#PurchaseOrderNumber").val(data.PurchaseOrderNumber);
                    $("#JobName").val(data.JobName);
                    $("#LegalEntityName").val(data.LegalEntityName);
                    $("#BusinessUnitName").val(data.BusinessUnitName);

                    $("#CompanyName").val(data.CompanyName);
                    $("#BrandName").val(data.BrandName);
                    //ID
                    $("#BusinessUnitId").val(data.BusinessUnitId);
                    $("#BrandId").val(data.BrandId);
                    $("#CompanyId").val(data.CompanyId);
                    $("#LegalEntityId").val(data.LegalEntityId);
                    $("#JobId").val(data.JobId);
                    $("#PicName").val(data.PicName);
                    $("#PicId").val(data.PicId);
                    $("#AffiliationId").val(data.AffiliationId);
                    $("#AffiliationName").val(data.AffiliationName);

                    if (data.IsNonInventory == true) {
                        $("#divInventoryFixedAsset").css("display", "none");
                    } else {
                        $("#divInventoryFixedAsset").css("display", "block");
                    }   
                }
            });
            $("#VendorName").val($("#VendorId").data("kendoDropDownList").text());
            $("#pod").data("kendoGrid").dataSource.read(); 
            $("#gridpod").data("kendoGrid").dataSource.read(); 
            $("#gridhistory").data("kendoGrid").dataSource.read(); 
        } else {
            $("#pod").data("kendoGrid").dataSource.data([]);
            $("#gridpod").data("kendoGrid").dataSource.data([]);
            $("#JobName").val("");
            $("#BusinessUnitName").val("");
            $("#CompanyName").val("");
            $("#BrandName").val("");
            $("#LegalEntityName").val("");
            $("#BusinessUnitId").val("");
            $("#BrandId").val("");
            $("#CompanyId").val("");
            $("#LegalEntityId").val("");
            $("#JobId").val("");
            $("#InvoicingTypeName").val("");
            $("#PurchaseOrderNumber").val("");
            $("#AffiliationId").val("");
            $("#AffiliationName").val("");
            $("#PicName").val("");
        } 
    }; 
           
    $('#btnSave').click(function () {
        if (!isValid()) return; 

        callAction({ formId: "form-goodreceipt", title: "save", type: "POST", url: '@Url.Action("save", "InventoryGoodsReceipt")', objects: result() });
    });

    $('#btnSubmit').click(function () {
        if ($("#IsGenerated").val() === "False") {
            if (!('@Model.Id')) {
                swal('Warning', 'Please click generate button before submitted', 'warning');
                return false;
            }
        }

        if (!isValid()) return; 
        callAction({ formId: "form-goodreceipt", title: "submit", type: "POST", url: '@Url.Action("submit", "InventoryGoodsReceipt")', objects: result() });

    });

    $('#btnGenerate').click(function () {
        if (!isValid()) return;

        callAction({ formId: "form-goodreceipt", title: "generate", type: "POST", url: '@Url.Action("generate", "InventoryGoodsReceipt")', objects: result() });
        $('#btnGenerate').hide();
    });

    function isValid() {
        var valid = $("#form-goodreceipt").validate().form();

        if (valid) {
            var _data = $("#gridpod").data("kendoGrid").dataSource.data(); 
            var _totalQty = 0;
            for (var i = 0; i < _data.length; i++) {
                _totalQty = _totalQty + _data[i].ReceivedQty;
            }
            if (_totalQty == 0) {
                swal('Warning', 'Recive QTY must grater than 0 !', 'warning');
                return false;
            }
            return true;
        } else {
            return false;
        }
    }

    function result() {
        var gridDetails = $("#gridpod").data("kendoGrid");
        gridDetails.saveRow();

        var dataList = {
            InventoryGoodsReceiptDetails: gridDetails.dataSource.data()
        }
        return dataList;
    }

    function AddMasterInventory() {
        var grNumber = $('#GoodsReceiptNumber').val();
        if (grNumber !== "") {
            window.open('@Url.Action("Detail", "Inventory")?remark='+grNumber);
        } else {
            swal('Warning', 'Please save first before add master inventory because Goods and Service Receipt number has been not generated !', 'warning');
        }
         
    }
</script>
