                                                                            .Events(e => e.Save("InventoryDetail_SaveEvent"))
                                                                            .NoRecords()
                                                                        )
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
