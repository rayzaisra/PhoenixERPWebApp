                                                                                    model.Field(p => p.Qty).Editable(false);
                                                                                    model.Field(p => p.InventoryId).Editable(false);
                                                                                    model.Field(p => p.ItemName).Editable(false);
                                                                                })
                                                                                .Read(read => read.Action("ReadInventoryDetail", "InventoryGoodsReceipt").Data("GetInventoryGoodReceiptId"))
