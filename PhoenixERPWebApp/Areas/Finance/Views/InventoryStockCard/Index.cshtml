@model PhoenixERPWebApp.Models.Finance.Transaction.Inventory.Inventory
@{
    ViewData["Title"] = "Inventory Stock Card";
}
@{
    ViewData["Title"] = "Detail";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Inventory</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-suitcase"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance </span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item"><a asp-action="index" asp-controller="Inventory" asp-area="finance" class="m-nav__link"> <span class="m-nav__link-text">Inventory</span></a></li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <span class="m-nav__link-text">Inventory Stock Card</span>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>

<div class="m-content">
    <div class="row">
        <div class="col-xl-12 col-lg-12">
            <div class="m-portlet">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-wrapper">
                        <div class="m-portlet__head-caption">
                            <div class="m-portlet__head-title">
                                <h3 class="m-portlet__head-text m--font-success">
                                    Inventory &nbsp;
                                    <span id="status"></span>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_qf2tcah4xx"><i class="la la-expand"></i></a>
                    </div>
                </div>
                <div class="m-portlet__body">
                    <div class="m-form__group">
                        <form id="formInventory" class="m-form m-form--fit m-form--label-align-right m-form--group-seperator-dashed" asp-action="submit" asp-controller="Inventory" asp-area="Finance" enctype="multipart/form-data">
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="LegalEntity" />
                            <input type="hidden" asp-for="BusinessUnit" />
                            <input type="hidden" asp-for="CreatedOn" />
                            <input type="hidden" asp-for="CreatedBy" />
                            <input type="hidden" asp-for="OwnerId" />
                            <input type="hidden" asp-for="FileUpload" />

                            <div class="row">
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Inventory Number :</label>
                                        @(Html.Kendo().DropDownListFor(i => i.InventoryInNumber)
                                                                   .DataTextField("Value")
                                                                   .DataValueField("Value")
                                                                   .OptionLabel("Select Inventory Number")
                                                                   .Filter(FilterType.Contains)
                                                                   .HtmlAttributes(new { style = "width:100%;", required = "required" })
                                                                   .DataSource(source =>
                                                                    {
                                                                        source.Read(read =>
                                                                        {
                                                                            read.Action("GetInvFa", "GoodRequest", new { area = "Finance" }).Data("filterInvFa");
                                                                        }).ServerFiltering(false); ;
                                                                    }).Events(e => e.Select("invChange"))
                                        )
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Brand :</label>
                                        @Html.Kendo().TextBoxFor(m => m.Brand).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "@readonly" })
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Reorder Level (Unit) :</label>
                                        @Html.Kendo().TextBoxFor(m => m.ReOrderLevel).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "@readonly" })
                                    </div>
                                </div>
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Remark :</label>
                                        @Html.TextAreaFor(m => m.Remark, new { style = "height:100px;width:100%", @readonly = "@readonly" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Inventory Name :</label>
                                        @Html.Kendo().TextBoxFor(m => m.InventoryName).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "@readonly" })
                                    </div>
                                </div>

                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Sub Brand :</label>
                                        @Html.Kendo().TextBoxFor(m => m.SubBrand).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "@readonly" })
                                    </div>
                                </div>
                                <div class="col-lg-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Stock On Hand :</label>
                                        @Html.Kendo().TextBoxFor(m => m.QtyOnHand).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "@readonly" })
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-sm-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Category :</label>
                                        @(Html.Kendo().TextBoxFor(m => m.CategoryName).HtmlAttributes(new { @class = "form-control form-control-sm", style = "width:100%", @readonly = "@readonly" }))
                                    </div>
                                </div>
                                <div class="col-lg-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Lead Time :</label>
                                        @Html.Kendo().TextBoxFor(m => m.LeadTime).HtmlAttributes(new { @class = "form-control form-control-sm", style = "width:100%", @readonly = "@readonly" })
                                    </div>
                                </div>
                                <div class="col-lg-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Status :</label>
                                        @Html.Kendo().TextBoxFor(m => m.StatusName).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "@readonly" })
                                    </div>
                                </div>
                                <div class="col-lg-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Inventory Type :</label>
                                        @Html.Kendo().TextBoxFor(m => m.VendorNameId).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "@readonly" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                @*<div class="col-lg-3 m-form__group-sub">
                                    <div class="form-group">
                                        <label asp-for="FileUpload"></label> <span class="req"></span> :
                                        <div id="divFileUpload"></div>
                                    </div>
                                </div>*@
                                <div class="col-lg-3 m-form__group-sub">
                                    <div class="form-group">
                                        <div style="width:100%" class="displayimage">
                                            <label>Image :</label>
                                            <a class="thumbnail pull-left" href="#">
                                                <img class="media-object" id="img-inventory-nava" width="225">
                                            </a>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <hr />
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="m-accordion m-accordion--bordered m-accordion--solid" id="detail" role="tablist">
                                        <!--begin::Item-->
                                        <div class="m-accordion__item">
                                            <div class="m-accordion__item-head" role="tab" id="detail_head" data-toggle="collapse" href="#detail_body" aria-expanded="true">
                                                <span class="m-accordion__item-icon"><i class="fa flaticon-interface-4"></i></span>
                                                <span class="m-accordion__item-title">Inventory Detail</span>
                                                <span class="m-accordion__item-mode"></span>
                                            </div>
                                            <div class="m-accordion__item-body show" id="detail_body" role="tabpanel" aria-labelledby="detail_head" data-parent="#detail" style="">
                                                <div class="m-accordion__item-content">
                                                    <div class="row">
                                                        <div class="form-group">
                                                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Finance.Transaction.Inventory.InventoryDetail>
                                                                ()
                                                                .Name("gridinventorystockcard")
                                                                .Columns(columns =>
                                                                {
                                                                    columns.Bound(p => p.Id).Width(200).Hidden(true);
                                                                    columns.Bound(p => p.Transaction).Width(100);
                                                                    columns.Bound(p => p.ReferenceNumber).Width(100);
                                                                    columns.Bound(p => p.Location).ClientTemplate("#=LocationName#").Width(200);
                                                                    columns.Bound(p => p.DateReceipt).Format("{0: dd MMM yyyy}").Width(100);
                                                                    columns.Bound(p => p.Qty).Width(100);
                                                                    columns.Bound(p => p.QtyOut).Width(100);
                                                                    columns.Bound(p => p.Difference).Width(100);
                                                                })
                                                                .Pageable(pageable => pageable
                                                                .PageSizes(true))
                                                                .Resizable(rsz => rsz.Columns(true))
                                                                .DataSource(dataSource => dataSource
                                                                .Ajax()
                                                                .PageSize(10)
                                                                .Events(events => events.Error("errorHandler"))
                                                                .Model(model => { model.Id(p => p.Id); })
                                                                .Read(read => read.Action("ReadInventoryStockCardDetail", "InventoryStockCard").Data("InvId"))
                                                                ).NoRecords()
                                                            )
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr />
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="pull-right">
                                        <a asp-action="index" asp-controller="Inventory" asp-area="finance" class="fakelink btn btn-secondary">Close</a>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <!--end::Form-->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

