<script>
    $(function () {
        $("#gridinventorystockcard").hide();
    });

    let getImageInventroy = function (filename) {

     let urlApi = $.helper.resolveApi("~odrive/GetImageInventory");
     var id = filename;

       mApp.blockPage({
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        }),
        $.ajax({
        type: "GET",
        dataType: 'json',
        url: urlApi,
        data: {id: id},
        success: function (data) {
            console.log("data = " + data.webUrl);
            if (data.webUrl !== null) {
                $("#img-inventory-nava").attr("src",data.webUrl);
            }
        },
        error: function (e, t, s) {
                //swal(
                //    'Information',
                //    'Ooops, something went wrong !',
                //    'info'
                //);
            console.log(e);
            }
        }).then(setTimeout(function () {
            mApp.unblockPage();
        }, 2e3));
    };

    function FileUpload() {
        //$("#linkDownloadFile").empty();
        $("#linkInterviewRemoveFile").empty();
        $("#divFileUpload").empty().append("<input name='file' id='file' type='file'/>");

        $("#file").kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".jpg",".jpeg", ".png", ".gif", ".doc", ".pdf", ".docx"]
            }
        });
    }

    function removeFileUpload() {
        FileUpload();
    }

    function downloadFileUpload() {
        downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download" })', data: { id: $("#FileUpload").val() }});
    }

    function filterInvFa() {
        return {
            type: 'INVENTORY'
        };
    }

    function InvId() {
        return {
            invId: $("#InventoryInNumber").val()
        };
    }

    function invChange(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            $.ajax({
                type: "GET",
                url: '@Url.Action("GetDataInventoryStockCard", "InventoryStockCard")',
                data: { id: dataItem.Value },
                success: function (result) {
                    if (result != undefined) {
                        $('#Brand').val(result.Brand);
                        $('#ReOrderLevel').val(result.ReOrderLevel);
                        $('#Remark').val(result.Remark);
                        $('#InventoryName').val(result.InventoryName);
                        $('#SubBrand').val(result.SubBrand);
                        $('#QtyOnHand').val(result.QtyOnHand);
                        $('#CategoryName').val(result.CategoryName);
                        $('#LeadTime').val(result.LeadTime);
                        $('#StatusName').val(result.StatusName);
                        $('#VendorNameId').val(result.VendorNameId);

                        var FileUploadName = result.FileUploadName;
                        console.log("FileUploadName = " + FileUploadName);
                        if (FileUploadName == '') {
                            $('.displayimage').hide();
                        } else {
                            $('.displayimage').show();
                        }

                        if (FileUploadName == '') {
                            FileUpload();
                        } else {
                            FileUpload();
                            getImageInventroy(FileUploadName);
                        }

                        $("#gridinventorystockcard").show();
                        $("#gridinventorystockcard").data("kendoGrid").dataSource.read();
                        $("#gridinventorystockcard").data("kendoGrid").refresh();

                    }
                }
            });
        }

    }

    @*function formatNumber(num) {
        return (
            num
                //.toFixed(2) // always two decimal digits
                .replace(',', '.') // replace decimal point character with ,
                .replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.')
        ) // use . as a separator
    }
    function FilterBusinessUnitById() {
        return {
            affiliationid : $("#AffiliationId").val()
        };
    }



    function EditDetail(data) {
        return "<center><a href='javascript: void(0);' onclick='FormDetail(this)' title='Edit' class='edit'>" + data.Id + "</a></center>";
    }

    function deleteGridRow(e) {
        var grid = $("#grid").data("kendoGrid");
        grid.removeRow("tr:eq(1)");
        //deleteRow(e, '@Url.Action("DeleteTempDetail", "Inventory")');
    }

    function AddFormDetailInventory(e) {
        var valid = $("#formInventory").validate().form();
        if (valid) {
            ClearFormDetailInventory()
            var id = $("#Id").val();
            $('#InventoryDetail_InventoryId').val(id);
            var qtyNumeric = $("#InventoryDetail_Qty").data("kendoNumericTextBox");
            qtyNumeric.value(1);
            $('#modalDetailInv').modal('show');

        }
    }

    function SumQty(e) {
        var total = 0;
        //var grid = $("[id ^= 'Grid_']").data("kendoGrid");
        var grid = $("#grid").data("kendoGrid");
        var gridData = grid.dataSource.view();
        for (var i = 0; i < gridData.length; i++) {
            total += gridData[i].Qty;
        }
        $("#TotalQty").data("kendoNumericTextBox").value(total);
    }




    function RequiredDetailRemove() {

    }

    function saveDetailInv() {
        var valid = $("#formDetailInv").validate().form();
        if (valid) {
            var dataList = {}
            $('#InventoryDetail_ConditionName').val($('#InventoryDetail_Condition').data("kendoDropDownList").text());
            $('#InventoryDetail_LocationName').val($('#InventoryDetail_Location').data("kendoDropDownList").text());
            $('#InventoryDetail_status_name').val($('#InventoryDetail_Status').data("kendoDropDownList").text());
            $('#InventoryDetail_UnitOfMeasure').val($('#InventoryDetail_UomId').data("kendoDropDownList").text());
            callActionFile({ formId: "formDetailInv", title: "save", type: "POST", objects: dataList });
            //callActionFile({ formId: "formDetailInv", title: "save", type: "POST", url: '@Url.Action("SaveDetailPersist", "Inventory")', objects: dataList });
        }
    }

    function FormDetail(e) {
