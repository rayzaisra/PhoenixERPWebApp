    function ClearFormDetailInventory() {
        $("#InventoryDetail_Id").val("");
        //$("#InventoryDetail_InventoryId").val("");
        $('#InventoryDetail_DateReceipt').val("");
        $('#InventoryDetail_Qty').data("kendoNumericTextBox").value(0);
        $('#InventoryDetail_UnitName').val("");
        $('#InventoryDetail_Manufacturer').val("");
        $('#InventoryDetail_Brand').val("");
        $('#InventoryDetail_Model').val("");
        $('#InventoryDetail_ProductNumber').val("");
        $('#InventoryDetail_Color').val("");
        $('#InventoryDetail_Condition').data("kendoDropDownList").value("");
        $('#InventoryDetail_Location').data("kendoDropDownList").value("");
        $('#InventoryDetail_DateReceipt').val("");
        $('#InventoryDetail_Remark').val("");
        $('#InventoryDetail_ItemName').val("");
        $('#InventoryDetail_Status').data("kendoDropDownList").value("");
        $('#InventoryDetail_VendorNameId').data("kendoDropDownList").value("");
        $('#InventoryDetail_VendorBrandId').data("kendoDropDownList").value("");
        $('#InventoryDetail_UomId').data("kendoDropDownList").value("");
        //$("#InventoryDetail_LeadTime").data("kendoNumericTextBox").value(0);
        $('#InventoryDetail_FileAttachment').val("");
    }


    //############################################################


    var pageFunction = (function (pageFunction) {
        pageFunction.init = function () {
            //initialize
        };
        pageFunction.save = function () {

            var gridDetails = $("#grid").data("kendoGrid");
            gridDetails.saveRow();
            var dataList = {
                details: gridDetails.dataSource.data()
            }
            $("#LegalEntity").val($("#LegalEntityId").data("kendoDropDownList").text());
            $("#BusinessUnit").val($("#BusinessUnitId").data("kendoDropDownList").text());
            callActionFile({ formId: "formInventory", title: "save", type: "POST", objects: dataList });
        };
        return pageFunction;
    })(pageFunction || {});




    function InventoryDetail_SaveEvent(e) {
        var Manufacturer = $("#Manufacturer").data("kendoTextBox").value();
        var Brand = $("#Brand").data("kendoTextBox").value();
        var Model = $("#Model").data("kendoTextBox").value();
        var ProductNumber = $("#ProductNumber").data("kendoTextBox").value();
        var Color = $("#Color").data("kendoTextBox").text();
        var Condition = $("#Condition").data("kendoDropDownList").text();
        var Qty = $("#Qty").data("kendoNumericTextBox").value();
        var UnitName = $("#UnitName").data("kendoTextBox").text();
        var Location = $("#Location").data("kendoDropDownList").text();
        //var LeadTime = $("#LeadTime").data("kendoNumericTextBox").value();
        e.model.set("Manufacturer", Manufacturer);
        e.model.set("Brand", Brand);
        e.model.set("Model", Model);
        e.model.set("ProductNumber", ProductNumber);
        e.model.set("Color", Color);
        e.model.set("Condition", Condition);
        e.model.set("Qty", Qty);
        e.model.set("UnitName", UnitName);
        e.model.set("Location", Location);
        //e.model.set("LeadTime", LeadTime);
    }

