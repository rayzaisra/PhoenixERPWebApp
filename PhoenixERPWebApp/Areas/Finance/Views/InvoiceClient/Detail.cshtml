                                                </div>
                                                <div class="row">
                                                    @*<div class="col-lg-6">
                                                        <div class="form-group row">
                                                            <label class="col-lg-3" asp-for="PceOtherFee"></label>
                                                            <div class="col-lg-9">
                                                                @(Html.Kendo().NumericTextBoxFor(m => m.PceOtherFee)
                                                                    .Spinners(false) 
                                                                    .HtmlAttributes(new
                                                                    {
                                                                        style = "width:100%",
                                                                        maxlength = 12,
                                                                        @readonly = "readonly"
                                                                    }
                                                                ))
                                                            </div>
                                                        </div>
                                                    </div>*@
                                                </div>
                                                <div class="row"> 
                                                    <div class="col-lg-6">
                                                        <div class="form-group row">
                                                            <label class="col-lg-3">Job Name</label>
                                                            <div class="col-lg-9">
                                                                @Html.Kendo().TextBoxFor(m => m.JobName).HtmlAttributes(new
                                                                {
                                                                    style = "width:100%",
                                                                    @readonly = "readonly"
                                                                })
                                                            </div>
