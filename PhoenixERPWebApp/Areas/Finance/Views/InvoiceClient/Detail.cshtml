    function isValid() {
        var valid = $("#form").validate().form();
        if (valid) {
            var grid = $("#treelist").data("kendoGrid").dataSource.data();
            if (grid.length == 0) {
                swal('Warning', 'Input detail data first please !', 'warning');
                return false;
            }
            if ($("#SourceOption").val() != "Other") {
                var pceBalance = $('#PceBalance').data("kendoNumericTextBox").value();
                var subtotal = $('#TotalAmount').data("kendoNumericTextBox").value();
                if (subtotal > pceBalance) {
                     swal('Warning', 'the value of the grand total amount cannot be greater than the pce balance', 'warning');
                    return false;
                }
            }
            return true;
        } else {
            return false;
        }
    }

    function result() {
        var gridDetail = $("#treelist").data("kendoGrid");
        gridDetail.saveRow();

        var dataList = {
            items_other: gridDetail.dataSource.data()
        }

        return dataList;
    }
    
