                        <div class="row" id="data_history_invoice_detail">
                            <div class="col-lg-12 m-row--no-padding">
                                <div class="m-accordion m-accordion--bordered m-accordion--solid" id="history_invoice_detail" role="tablist"> 
                                    <div class="m-accordion__item">
                                        <div class="m-accordion__item-head collapsed" role="tab" id="history_invoice_detail_head" data-toggle="collapse" href="#history_invoice_detail_body" aria-expanded="true">
                                            <span class="m-accordion__item-icon"><i class="fa fa-history"></i></span>
                                            <span class="m-accordion__item-title">History Invoice</span>
                                            <span class="m-accordion__item-mode"></span>
                                        </div>
                                        <div class="m-accordion__item-body collapse" id="history_invoice_detail_body" role="tabpanel" aria-labelledby="history_invoice_detail_head" data-parent="#history_invoice_detail" style="">
                                            <div class="m-accordion__item-content">
                                                @(Html.Kendo().Grid<PhoenixERPWebApp.Models.InvoiceClient>()
                                                    .Name("treelisthistory")
                                                    .Columns(columns =>
                                                    {
                                                        columns.Bound(p => p.InvoiceNumber).Width(150);
                                                        columns.Bound(p => p.InvoiceDate).Width(100).ClientFooterTemplate("TOTAL <br/> Pce Balance");
                                                        columns.Bound(p => p.TotalAmount).Title("Sub Total").ClientTemplate("#if(CurrencySymbol!=null && TotalAmount!=null){# #=CurrencySymbol# #}# #if(TotalAmount!=null){# #=kendo.format('{0:n2}', TotalAmount)# #}#").Width(130).ClientFooterTemplate("#=totalHistory(sum)# <br/> #=balance(sum)#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right; vertical-align:top;" });
                                                        //columns.Bound(p => p.Asf).Width(70).Title("ASF %").ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                        //columns.Bound(p => p.AsfAmount).Width(130).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                        //columns.Bound(p => p.totalamtplusasf).Title("Total").Width(130).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                        //columns.Bound(p => p.VAtPercentage).Width(130).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                        //columns.Bound(p => p.Vat).Width(130).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                        //columns.Bound(p => p.GrandTotal).Title("Grand Total").Width(130).ClientFooterTemplate("#=kendo.toString(sum, 'n2')# <br/> #=balance(sum)#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right; vertical-align:top;" });
                                                    })
                                                    .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                                    .DataSource(dataSource => dataSource
                                                        .Ajax()
                                                        .Aggregates(aggregates =>
                                                        {
                                                            aggregates.Add(p => p.TotalAmount).Sum();
                                                            //aggregates.Add(p => p.Asf).Sum();
                                                            //aggregates.Add(p => p.AsfAmount).Sum();
                                                            //aggregates.Add(p => p.totalamtplusasf).Sum();
                                                            //aggregates.Add(p => p.VAtPercentage).Sum();
                                                            //aggregates.Add(p => p.Vat).Sum();
                                                            aggregates.Add(p => p.GrandTotal).Sum();
                                                        })
                                                        .Events(events => events.Error("errorHandler"))
                                                        .Model(model => { model.Id(p => p.Id); })
                                                        .Read(read => read.Action("ReadHistoryInvoice", "InvoiceClient").Data("grid_history_params"))
                                                    ).NoRecords()
                                                )
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
