    function GetPceTask(pceNo) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPCEDetail", "InvoiceClient")',
            data: { pceId: pceNo },
            success: function (data) {
                if (data != null) {
                    var griddtlds = $("#treelist").data('kendoGrid').dataSource;
                    for (var i = 0; i < data.length; i++){
                        var newRow = {
                            Id: data[i].Id,
                            TaskId: data[i].Id, 
                            TaskName: data[i].TaskName,
                            Quantity: data[i].Quantity,
                            UnitPrice: data[i].UnitPrice, 
                            AmountPercentage: 100,
                            Amount: data[i].Total,
                            AmountBilled: data[i].Total - data[i].TotalUsedInvoice,
                            Balance: data[i].TotalBalanceInvoice,
                            IsAsf: data[i].IsAsf,
                            CurrencySymbol: data[i].CurrencySymbol
                        };

                        //griddtlds.add(newRow);
                        griddtlds.pushCreate(newRow);//jika ada fungsi edit inline harus menggunakan pushcreate dikarenakan jika menggunakan add ketika ada edit terus melakuakn cancel makan data yg sudah di add bakal hilang dari list
                    }
                    CallculateAll();
                }
            }
        });
    } 
     
    function SaveSelectedPce() {
