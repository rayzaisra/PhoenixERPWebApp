    function balance(totalHistory) {
        var totalPCE = 0;
        if ($("#TotalPCE").val()!="") totalPCE = parseFloat($("#TotalPCE").val());
        return $("#CurrencySymbol").val() +' '+ kendo.toString(totalPCE - totalHistory, '#,###.##');
    }


    function totalHistory(totalHistory) { 
        return $("#CurrencySymbol").val() + ' ' + kendo.toString(totalHistory, '#,###.##');
    }

    function params_bank() {
        return {
            legalEntityId: $('#LegalId').data("kendoDropDownList").value()
        }
    }

    function AccountIdOnDataBound(){
        if ("@ViewBag.isRequestor" == "False") {    
            $('#AccountId').data("kendoDropDownList").readonly();
        }
    }

    function params_vatNo() {
        return {
            legalEntityId: $("#LegalId").val(),
            invoiceDate: kendo.toString($("#InvoiceDate").data("kendoDatePicker").value(), "yyyy-MM-dd"),
            vatNo: $("#VatNo").val()
        }
    }

    function invoiceDate_change() {
        $("#VatNo").data("kendoDropDownList").dataSource.read();
    }

    function vatexchangerate_change() {
        var vatExchangeRate = $('#VatExchangeRate').data("kendoNumericTextBox").value();
        var exchangeRate = $('#ExchangeRate').data("kendoNumericTextBox").value(); 
        var isReadonly = (vatExchangeRate == exchangeRate);
        $('#Vat').data("kendoNumericTextBox").readonly(isReadonly);
    }

    function vat_change() {
        var total = $("#totalamtplusasf").data("kendoNumericTextBox").value();
        var vat = $('#Vat').data("kendoNumericTextBox").value();
        var grandTotal = (total + vat);

        $('#GrandTotal').data("kendoNumericTextBox").value(grandTotal); 
    }
        
    function currency_select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;            
                 mApp.block("#m_blockui_list", {
                        overlayColor: "#000000",
                        type: "loader",
                        state: "primary",
                        message: "Processing..."
                    });

                $.ajax({
                    type: "GET",
                    dataType: "json",
                    contentType: "application/x-www-form-urlencoded",
                    async: false,
                    data: { id: dataItem.Value },
                    url: "@Url.Action("Get", "Currency",new { area="Finance"})",
                    success: function (result) {
                        if (result != null) {                            
                            $("#CurrencySymbol").val(result.CurrencySymbol);
                            $("#CurrencyIdDefault").val(result.CurrencyIdDefault);
                            $("#CurrencySymbolDefault").val(result.CurrencySymbolDefault);

                            if (dataItem.Value == result.CurrencyIdDefault) {
                                    $("#ExchangeRate").data("kendoNumericTextBox").value("1");
                                    $('#ExchangeRate').data("kendoNumericTextBox").readonly();
                             }
                             else { 
                                    $('#ExchangeRate').data("kendoNumericTextBox").readonly(false);
                            }

                            setCurrencyValue();

                            var dataSource = $("#treelist").data("kendoGrid").dataSource;
                            var view = dataSource.view();
                            for (var i = 0; i < view.length; i++) { 
                                view[i].set("CurrencySymbol", result.CurrencySymbol); 
                            }
                        }
                    },
                    error: function (e, t, s) {
                        console.log(e)
                        mApp.unblock("#m_blockui_list");
                    }
                }).then(setTimeout(function () {
                    mApp.unblock("#m_blockui_list");
                }, 2e3)); 
        }
    }

    function setCurrencyValue() {
        var currencySymbol = $("#CurrencySymbol").val();
        var CurrencySymbolDefault = $("#CurrencySymbolDefault").val();
        var invoiceBilled = $('#InvoiceBilled').data('kendoNumericTextBox');
        var pceBalance = $('#PceBalance').data('kendoNumericTextBox');
        var totalAmount = $('#TotalAmount').data('kendoNumericTextBox');
        var asfAmount = $('#AsfAmount').data('kendoNumericTextBox');
        var totalamtplusasf = $('#totalamtplusasf').data('kendoNumericTextBox');
        var vat = $('#Vat').data('kendoNumericTextBox');
        var grandTotal = $('#GrandTotal').data('kendoNumericTextBox');
        var vatExchangeRate = $('#VatExchangeRate').data('kendoNumericTextBox');
        var exchangeRate = $('#ExchangeRate').data('kendoNumericTextBox'); 

        var invoiceBilledValue = invoiceBilled.value();
        var pceBalanceValue = pceBalance.value();
        var totalAmountValue = totalAmount.value();
        var asfAmountValue = asfAmount.value();
        var totalamtplusasfValue = totalamtplusasf.value();
        var vatValue = vat.value();
        var grandTotalValue = grandTotal.value();
        var vatExchangeRateValue = vatExchangeRate.value();
        var exchangeRateValue = exchangeRate.value();

        invoiceBilled.setOptions({ value: invoiceBilledValue, format: currencySymbol + " #,###.##" });
        pceBalance.setOptions({ value: pceBalanceValue, format: currencySymbol + " #,###.##" });
        totalAmount.setOptions({ value: totalAmountValue, format: currencySymbol + " #,###.##" });
        asfAmount.setOptions({ value: asfAmountValue, format: currencySymbol + " #,###.##" });
        totalamtplusasf.setOptions({ value: totalamtplusasfValue, format: currencySymbol + " #,###.##" });
        vat.setOptions({ value: vatValue, format: currencySymbol + " #,###.##" });
        grandTotal.setOptions({ value: grandTotalValue, format: currencySymbol + " #,###.##" });
        vatExchangeRate.setOptions({ value: vatExchangeRateValue, format: CurrencySymbolDefault + " #,###.##" });
        exchangeRate.setOptions({ value: exchangeRateValue, format: CurrencySymbolDefault + " #,###.##" });
    }

    function sumDebitJournal(sum) { 
        return $("#CurrencySymbolDefault").val() + ' ' + kendo.toString(sum, '#,###.##');
    }

    function sumCreditJournal(sum) {
        return $("#CurrencySymbolDefault").val() + ' ' + kendo.toString(sum, '#,###.##');
    }
</script>