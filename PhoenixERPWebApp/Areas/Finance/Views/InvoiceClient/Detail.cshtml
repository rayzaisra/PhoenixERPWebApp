
@model PhoenixERPWebApp.Models.InvoiceClient
@{
    ViewData["Title"] = "Invoice to client";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
    var show = ""; if (Model.SourceOption == "Other") { show = "show"; }
    var collapsed = ""; if(Model.SourceOption != "Other") { collapsed = "collapsed"; }
}
<style>
    .k-numerictextbox .k-input {
        text-align: right;
        padding-right: 10px;
    }  
</style>
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">Invoice to Client</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-suitcase"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="@Url.Content("~/Finance/InvoiceClient")" class="m-nav__link">
                        <span class="m-nav__link-text">Invoice to Client</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Detail</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="m-content">
    <div class="row">
        <div class="col-xl-12 col-lg-12">
            <div class="m-portlet">
                <div class="m-portlet__head" style="background:#fafafa">
                    <div class="m-portlet__head-wrapper">
                        <div class="m-portlet__head-caption">
                            <div class="m-portlet__head-title">
                                <h3 class="m-portlet__head-text m--font-success">Invoice to Client</h3> &nbsp;  
                                @if (Model.Status == PhoenixERPWebApp.Models.InvoiceClientStatus.Open)
                                {<span class="m-badge m-badge--info m-badge--wide" id="lblstatus">@Model.StatusDesc</span>}
                                @if (Model.Status == PhoenixERPWebApp.Models.InvoiceClientStatus.Rejected)
                                {<span class="m-badge m-badge--danger m-badge--wide" id="lblstatus">@Model.StatusDesc</span> }                                    
                                else if (Model.Status == PhoenixERPWebApp.Models.InvoiceClientStatus.WaitingApproval)
                                { <span class="m-badge m-badge--warning m-badge--wide" id="lblstatus">@Model.StatusDesc</span> }
                                else if (Model.Status == PhoenixERPWebApp.Models.InvoiceClientStatus.Approved)
                                { <span class="m-badge m-badge--success m-badge--wide" id="lblstatus">@Model.StatusDesc</span> } 
                             </div>
                        </div>
                        <div class="m-portlet__head-tools">
                            <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_qf2tcah4xx"><i class="la la-expand"></i></a>
                        </div>
                    </div>
                </div>
                <div class="m-portlet__body">
                    <form id="form" class="m-form m-form--fit m-form--label-align-right m-form--group-seperator-dashed" role="form">
                        <input type="hidden" id="CheckedFlag" />
                        <input type="hidden" asp-for="CreatedBy" />
                        <input type="hidden" asp-for="CreatedOn" />
                        <input type="hidden" asp-for="ModifiedBy" />
                        <input type="hidden" asp-for="ModifiedOn" />
                        <input type="hidden" asp-for="ApprovedBy" />
                        <input type="hidden" asp-for="ApprovedOn" />
                        <input type="hidden" asp-for="IsActive" />
                        <input type="hidden" asp-for="IsLocked" />
                        <input type="hidden" asp-for="IsDefault" />
                        <input type="hidden" asp-for="IsDeleted" />
                        <input type="hidden" asp-for="OwnerId" />
                        <input type="hidden" asp-for="DeletedBy" />
                        <input type="hidden" asp-for="DeletedOn" /> 
                        <input type="hidden" asp-for="Status" /> 
                        <input type="hidden" asp-for="SourceOption"/>
                        <input type="hidden" asp-for="Id" /> 
                        <input type="hidden" asp-for="PceSeq"/>
                        <input type="hidden" asp-for="TotalPCE"/>      
                        <input type="hidden" asp-for="PceTypeCrossBilling" /> 
                        <input type="hidden" asp-for="CurrencySymbol" />  
                        <input type="hidden" asp-for="CurrencyIdDefault" />  
                        <input type="hidden" asp-for="CurrencySymbolDefault" />  
                        
