    function SetVatDocUpload() {
        var required = "";
        //if ($("#SourceOption").val() == "Other") { } else { required = "required" }
        $("#linkVatDocDownloadFile").empty();
        $("#linkVatDocRemoveFile").empty();
        $("#divVatDoc").empty().append("<input name='fileVatDoc' id='fileVatDoc' type='file'" + required +"/>");

        $("#fileVatDoc").kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".jpg", ".png", ".gif", ".doc", ".pdf", ".docx", ".xlsx"]
            }
        });
    }

    function SetPoDocUpload() {
        var required = "";
        if ($("#SourceOption").val() == "Other") { } else { required = "required"}
        $("#linkPoDocDownloadFile").empty();
        $("#linkPoDocRemoveFile").empty();
        $("#divPoDoc").empty().append("<input name='filePoDoc' id='filePoDoc' type='file' " + required +"/>");

        $("#filePoDoc").kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".jpg", ".png", ".gif", ".doc", ".pdf", ".docx", ".xlsx"]
            }
        });
    }
      
