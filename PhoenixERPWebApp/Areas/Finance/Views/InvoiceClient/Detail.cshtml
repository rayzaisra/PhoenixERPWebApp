                                                                    model.Field(p => p.AccountName).Editable(false);
                                                                    model.Field(p => p.JobIdName).Editable(false);
                                                                    model.Field(p => p.DivisiName).Editable(false);
                                                                    model.Field(p => p.LegalEntityName).Editable(false);
                                                                    model.Field(p => p.Debit).Editable(false);
                                                                    model.Field(p => p.Credit).Editable(false);
                                                                })
                                                                .Read(read => read.Action("ReadJournal", "InvoiceClient").Data("grid_params"))
                                                                .Update(update => update.Action("updateJournal", "InvoiceClient"))
                                                            )
                                                        )
                                                    </div>
