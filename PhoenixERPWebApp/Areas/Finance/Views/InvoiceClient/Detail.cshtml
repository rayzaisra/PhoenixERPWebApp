    function other_onchange() {
        var Quantity = $("#Quantity").data("kendoNumericTextBox").value();
        var UnitPrice = $("#UnitPrice").data("kendoNumericTextBox").value();

        var total = Quantity * UnitPrice;
        $("#Amount").data("kendoNumericTextBox").value(total);
        $("#AmountBilled").data("kendoNumericTextBox").value(total);

    } 

    function removeInvDtl_event(e) {
        var models = $("#treelist").data("kendoGrid").dataSource.data().filter((x) => { return x.Id != e.model.Id }); 
        var subTotal = 0;
        var subTotalAsf = 0;

        $.each(models, function (index, data) {
            if (data.AmountBilled != null) {
                subTotal += data.AmountBilled; 

                if (data.IsAsf == true) {
                    subTotalAsf += data.AmountBilled;
                }
            }
        });
         
        ReCallculateAll(subTotal, subTotalAsf); 
    }

    function saveInvDtl_Event(e) {
        if ($("#SourceOption").val() == "Other") {
            var Quantity = $("#Quantity").data("kendoNumericTextBox").value();
            var UnitPrice = $("#UnitPrice").data("kendoNumericTextBox").value();
            var total = Quantity * UnitPrice;
            e.model.set("Amount", total);
            e.model.set("AmountBilled", total);
        } else {
            var AmountBilled = $("#AmountBilled").data("kendoNumericTextBox").value(); 
            if (AmountBilled > e.model.Balance) {
                swal('Warning', 'the value of the billed cannot be greater than the balance', 'warning');
                //grid.cancelChanges();
                e.preventDefault();
                return;
            }
        }
        CallculateAll(); 
    } 
    
    function CallculateAll() {
        var models = $("#treelist").data("kendoGrid").dataSource.data();
        var subTotal = 0;
        var subTotalAsf = 0;

        $.each(models, function (index, data) {
            if (data.AmountBilled != null) {
                subTotal += data.AmountBilled;

                if(data.IsAsf == true){
                    subTotalAsf += data.AmountBilled;
                }
            }
        });

        ReCallculateAll(subTotal, subTotalAsf);
    }

    function ReCallculateAll(subTotal, subTotalAsf) {
        var vatpercent = $('#VAtPercentage').data("kendoNumericTextBox").value();
        var asfpercent = $("#Asf").data("kendoNumericTextBox").value();

        if (vatpercent == null) vatpercent = 0;
        if (asfpercent == null) asfpercent = 0;

        var asfAmount = subTotalAsf * (asfpercent / 100);
        var total = subTotal + asfAmount;
        var vat = (total * (vatpercent / 100));
        var grandTotal = (total + vat);

        $('#TotalAmount').data("kendoNumericTextBox").value(subTotal);
        $("#Asf").data("kendoNumericTextBox").value(asfpercent); 
        $("#AsfAmount").data("kendoNumericTextBox").value(asfAmount); 
        $("#totalamtplusasf").data("kendoNumericTextBox").value(total);
        $('#VAtPercentage').data("kendoNumericTextBox").value(vatpercent);
        $('#Vat').data("kendoNumericTextBox").value(vat);
        $('#GrandTotal').data("kendoNumericTextBox").value(grandTotal); 
    }

