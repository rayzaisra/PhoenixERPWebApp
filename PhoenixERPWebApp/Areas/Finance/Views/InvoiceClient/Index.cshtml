@{
    ViewData["Title"] = "Invoice Client";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}  
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Invoice to  Client</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-suitcase"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Invoice Client</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div> 

<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div> 
                                <a href="#" onclick="OpenPopupMainService()" class="m-btn btn btn-primary btn-sm m-btn--sm"><i class="la la-plus"></i></a>
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item" style="display:none">
                                @(Html.Kendo().DropDownList()
                                    .Name("status")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .Events(e => e.Change("onFilterMode"))
                                    .OptionLabel("All Status")
                                    .DataSource(source => source
                                        .Custom()
                                        .Transport(transport => transport
                                        .Read(read =>
                                        {
                                            read.Action("GetInvoiceClientStatus", "Dropdown", new { area = "Finance" });
                                        }))
                                        .ServerFiltering(false)
                                    ))
                            </li>
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list"> 
                    <div class="row">    
                        <div class="col-lg-6">
                            <div class="form-group">
                                <label>Date</label> :
                                <div class="row" style="padding:0px">
                                    <div class="col-lg-6">
                                        @(Html.Kendo().DropDownList()
                                             .Name("DateType")
                                             .DataTextField("Text")
                                             .DataValueField("Value")
                                             .Events(e => e.Change("type_change"))
                                             .BindTo(new List<SelectListItem>() {
                                                 new SelectListItem() { Text = "Day", Value = "Day"},
                                                 new SelectListItem() { Text = "Month", Value = "Month"},
                                                 new SelectListItem() { Text = "Year", Value = "Year"},
                                                 new SelectListItem() { Text = "Custom Range", Value = "Custom Range"}
                                             })
                                             .HtmlAttributes(new { style = "width: 100%" })
                                        )
                                    </div>
                                    <div class="col-lg-6">
                                        <div id="divDate"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="row" style="padding:0px">
                                    <div class="col-lg-6">
                                        <div id="divDateStart"></div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div id="divDateEnd"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <br />
                                <button type="button" id="btnSearch" class="btn btn-primary" style="padding:7px;"><span class="fa fa-filter"></span> Filter</button>
                            </div>

                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-12">
                            <div class="form-group">
                                <div class="alert m-alert--default" role="alert">
                                    <span style="font-weight:500">List Data</span>
                                </div>
                                @(Html.Kendo().Grid<PhoenixERPWebApp.Models.InvoiceClient>()
                                    .Name("grid")
                                    .Columns(columns =>
                                    {
                                        columns.Bound(p => p.InvoiceDate).Title("Date").Width(110);
                                        columns.Bound(p => p.LegalEntityName).Width(180).Encoded(false);
                                        columns.Bound(p => p.DivisionName).Width(180).Title("Business Unit").Encoded(false);
                                        columns.Bound(p => p.Id).Title("Invoice No").ClientTemplateId("invno-template").Width(130);
                                        //columns.Bound(p => p.PceId).Title("Pce ID").Width(130);
                                        columns.Bound(p => p.MainServiceCategoryName).Width(160).Title("MSC").Encoded(false);
                                        columns.Bound(p => p.ClientName).Width(200);
                                        columns.Bound(p => p.ClientBrandName).Width(200).Title("Client Brand").Encoded(false);
                                        columns.Bound(p => p.JobName).Width(260).Title("Job ID-Name");
                                        columns.Bound(p => p.POClientNo).Width(160).Title("PO Number");
                                        columns.Bound(p => p.ClientTaxNumber).Width(170).Title("Tax Number");
                                        columns.Bound(p => p.GrandTotal).HtmlAttributes(new { style = "text-align:right;" }).ClientTemplate("#if(CurrencySymbol!=null && GrandTotal!=null){# #=CurrencySymbol# #}# #if(GrandTotal!=null){# #=kendo.format('{0:n2}', GrandTotal)# #}#").Title("Amount").Width(180);
                                        //columns.Bound(p => p.TotalAmount).ClientTemplate("#if(CurrencySymbol!=null && TotalAmount!=null){# #=CurrencySymbol# #}# #if(TotalAmount!=null){# #=kendo.format('{0:n2}', TotalAmount)# #}#").Title("Amount").Width(140).HtmlAttributes(new { @style = "text-align:right" });
                                        columns.Bound(p => p.Status).Title("Status").ClientTemplate("#= GetStatusButton(data) #").Width(100); 
                                    })
                                    .Pageable(pageable => pageable
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
                                    .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                    .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                                        .Extra(false)
                                        .Operators(operators => operators
                                        .ForString(str => str.Clear()
                                            .Contains("Contains")
                                            .StartsWith("Start sWith")
                                            .EndsWith("End sWith")
                                        )))
                                    .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                    .Resizable(rsz => rsz.Columns(true))
                                    .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .PageSize(10)
                                        .Events(events => events.Error("errorHandler"))
                                        .Model(model => { model.Id(p => p.Id); })
                                        .Sort(sort=>sort.Add(p => p.InvoiceDate).Descending())
                                        .Read(read => read.Action("ReadIndex", "InvoiceClient").Data("grid_params"))
                                    )
                                )
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalMainServiceOption" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Main Service Option</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnSourceAdd" />
                <div class="form-group">
                    <ul style="margin: 0 0 -1em; padding: 0;">
                        <li style="list-style: none;padding-bottom: 1em;">
                            @(Html.Kendo().RadioButton().Name("option1").Checked(true).Value("0").HtmlAttributes(new { @name = "engine" }).Label("Other"))
                        </li>
                        <li style="list-style: none;padding-bottom: 1em;">
                            @(Html.Kendo().RadioButton().Name("option2").Value("1").HtmlAttributes(new { @name = "engine" }).Label("PCE Source"))
                        </li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" id="btnProcess" onclick="OpenAddPage()" class="btn btn-primary">Process</button>
            </div>
        </div>
    </div>
</div>

<script id="invno-template" type="text/x-kendo-template">
    <a href='javascript: void(0);' onclick='editGridRow(this)' title='Edit' class='edit'><span style='color:blue; text-decoration:underline;'>#=Id#</span></a>
</script> 

<script>    
    $(document).ready(function () {
        type_change();
        //$('#grid').data('kendoGrid').dataSource.read();
    });

    function type_change() {
        var type = $("#DateType").data("kendoDropDownList").value();

        $("#divDate").empty();
        $("#divDateStart").empty();
        $("#divDateEnd").empty();

        if (type == "Month") {
            $("#divDate").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder='Choose a Month' required/>");
            $("#EndingDate").kendoDatePicker({
                format: "MMM yyyy",
                start: "year",
                depth: "year",
            });
        } else if (type == "Year") {
            $("#divDate").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder='Choose a Year' required/>");
            $("#EndingDate").kendoDatePicker({
                format: "yyyy",
                start: "decade",
                depth: "decade",
            });
        } else if (type == "Custom Range") {
            $("#divDateStart").empty().append("<input name='StartingDate' id='StartingDate' type='text' style='width: 100%;' placeholder='Start' required/>");
            $("#divDateEnd").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder='End' required/>");

            $("#StartingDate").kendoDatePicker({
                format: "dd MMM yyyy",
                start: "month",
                depth: "month",
            });

            $("#EndingDate").kendoDatePicker({
                format: "dd MMM yyyy",
                start: "month",
                depth: "month",
            });
        } else {
            $("#divDate").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder='Choose a Day' required/>");
            $("#EndingDate").kendoDatePicker({
                format: "dd MMM yyyy",
                start: "month",
                depth: "month",
            });
        }
    }

    function GetStatusButton(data) {
        var buttonType = "";
        if (data.Status == "@PhoenixERPWebApp.Models.InvoiceClientStatus.Open") buttonType = "m-badge--info"; 
        else if (data.Status == "@PhoenixERPWebApp.Models.InvoiceClientStatus.WaitingApproval") buttonType = " m-badge--warning";
        else if (data.Status == "@PhoenixERPWebApp.Models.InvoiceClientStatus.Rejected") buttonType = " m-badge--danger";
        else if (data.Status == "@PhoenixERPWebApp.Models.InvoiceClientStatus.Approved") buttonType = " m-badge--success"; 
        return "<center><a href='javascript: void(0);' onclick='editGridRow(this)' class='m-badge " + buttonType + " m-badge--wide'>" + data.StatusDesc+"</a></center>";
    }
    
    function OpenPopupMainService() {
        $('#modalMainServiceOption').modal('show');
    }

    function OpenAddPage() {
        $('#modalMainServiceOption').modal('hide');
        var sourceOption = '';
        if ($("#hdnSourceAdd").val() == "0" || $("#hdnSourceAdd").val() == "")
            sourceOption = "Other"
        else
            sourceOption = "Pce"

        window.location.href = '@Url.Action("Detail", "InvoiceClient")?Source=' + sourceOption;
    }

    $(document).on("change", "input[type='radio']", function () {
        $("#hdnSourceAdd").val(this.value);
    });

    function onFilterMode() {
        mApp.block("#m_blockui_list", {
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        });

        var grid = $("#grid").data("kendoGrid");
        grid.dataSource.read();
        grid.refresh();
        mApp.unblock("#m_blockui_list");
    };
     
    function grid_params() {
        return {
            Filter: {
                Status: $("#status").data("kendoDropDownList").value(),
                StartingDate: $("#StartingDate").data("kendoDatePicker") == undefined ? undefined : kendo.format('{0:yyyy/MM/dd}', $("#StartingDate").data("kendoDatePicker").value()),
                EndingDate: $("#EndingDate").data("kendoDatePicker") == undefined ? undefined : kendo.format('{0:yyyy/MM/dd}', $("#EndingDate").data("kendoDatePicker").value()),
                DateType: $("#DateType").data("kendoDropDownList").value()
            }
        }
    }

    function editGridRow(e) {
        var item = dataItem(e);
        window.location.href = '@Url.Action("Detail", "InvoiceClient")?Id=' + item.Id ;
    }

    $('#btnSearch').click(function () {
        mApp.block("#m_blockui_list", {
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();

        mApp.unblock("#m_blockui_list");
    });
</script>
