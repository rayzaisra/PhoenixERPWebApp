<style>
    .modallargewidth {
        width: 90%;
        max-width: 1200px;
    }

    .has-danger label:not([class]) {
        color: #f4516c;
    }
</style>

<div class="modal fade" id="modal-choice-pce" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modallargewidth">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Add Invoice</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBodyPceList">
                <form id="formVendor" class="form-horizontal form-bordered" role="form" enctype="multipart/form-data"> 
                    <div class="m-form__group">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group row">
                                    <div class="col-lg-4">
                                        <label>Client Name</label>
                                    </div>
                                    <div class="col-lg-8">
                                        @(Html.Kendo().DropDownList().Name("_ClientId")
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .OptionLabel($"Choose a Client Name")
                                            .Popup(x => x.AppendTo("#modalBodyPceList"))
                                            .HtmlAttributes(new { style = "width:100%;" })
                                            .Filter(FilterType.Contains)
                                            .DataSource(source => source
                                                .Custom()
                                                .Transport(transport => transport
                                                .Read(read =>
                                                {
                                                    read.Action("GetDDLClient", "Dropdown", new { area = "Finance" });
                                                }))
                                                .ServerFiltering(false)
                                            ))
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group row">
                                    <div class="col-lg-4">
                                        <label>Legal Entity</label>
                                    </div>
                                    <div class="col-lg-8">
                                        @(Html.Kendo().DropDownList().Name("_LegalId")
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .OptionLabel($"Choose a Legal Entity")
                                            .Popup(x => x.AppendTo("#modalBodyPceList"))
                                            .HtmlAttributes(new { style = "width:100%;" })
                                            .Filter(FilterType.Contains)
                                            .DataSource(source => source
                                                .Custom()
                                                .Transport(transport => transport
                                                .Read(read =>
                                                {
                                                    read.Action("GetLegalEntity", "Dropdown", new { area = "Finance" });
                                                }))
                                                .ServerFiltering(false)
                                            ))
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group row">
                                    <div class="col-lg-4">
                                        <label>Business Unit</label>
                                    </div>
                                    <div class="col-lg-8">
                                        @(Html.Kendo().DropDownList().Name("_DivisionId")
                                            .DataTextField("Text")
                                            .DataValueField("Value") 
                                            .OptionLabel($"Choose a Business Unit")
                                            .Popup(x => x.AppendTo("#modalBodyPceList"))
                                            .HtmlAttributes(new { style = "width:100%;" })
                                            .Filter(FilterType.Contains)
                                            .DataSource(source => source
                                                .Custom()
                                                .Transport(transport => transport
                                                .Read(read =>
                                                {
                                                    read.Action("GetDivisionFinance", "Dropdown", new { area = "Finance" });
                                                }))
                                                .ServerFiltering(false)
                                            ))
                                </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group row">
                                    <div class="col-lg-4">
                                        <label>Pce Id</label>
                                    </div>
                                    <div class="col-lg-8">
                                        @(Html.Kendo().TextBox().Name("_pceId").HtmlAttributes(new { style = "width:100%;" }))
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group row">
                                    <div class="col-lg-4">
                                        <label>Currency</label>
                                    </div>
                                    <div class="col-lg-8">
                                        @(Html.Kendo().DropDownList().Name("_CurrencyId")
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .OptionLabel($"Choose a Currency")
                                            .Popup(x => x.AppendTo("#modalBodyPceList"))
                                            .HtmlAttributes(new { style = "width:100%;" })
                                            .Filter(FilterType.Contains)
                                            .DataSource(source => source
                                                .Custom()
                                                .Transport(transport => transport
                                                .Read(read =>
                                                {
                                                    read.Action("GetDDLCurrency", "Dropdown", new { area = "Finance" });
                                                }))
                                                .ServerFiltering(false)
                                            ))
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group row">
                                    <div class="col-lg-4">
                                        <label>Job ID - Name</label>
                                    </div>
                                    <div class="col-lg-8">
                                        @(Html.Kendo().TextBox().Name("_JobIdName").HtmlAttributes(new { style = "width:100%;" }))
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group row">
                                    <div class="col-lg-4">

                                    </div>
                                    <div class="col-lg-8">
                                        <button class="btn btn-primary" type="button" onclick="SearchPceList()">Search</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group m-form__group row m-row--no-padding">
                                    <div class="col-lg-12 m-row--no-padding" id="m_blockui_list">
                                        @(Html.Kendo().Grid<PhoenixERPWebApp.Models.InvoiceClient>()
                                            .Name("grid-choice-pce")
                                            .Columns(columns =>
                                            {
                                                columns.Select().ClientHeaderTemplate(" ").Width(40).HtmlAttributes(new { style = "text-align:center;" });
                                                columns.Bound("").ClientTemplate("#=JobId# - #=JobName#").Width(200).Title("Job ID-Name");
                                                columns.Bound(p => p.PceId).Width(150).Title("Pce Id");
                                                columns.Bound(p => p.CurrencyName).Width(150);
                                                columns.Bound(p => p.TotalAmount).ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(TotalAmount!=null){# #=kendo.format('{0:n2}', TotalAmount)# #}#").Width(150);
                                                columns.Bound(p => p.AsfAmount).ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(AsfAmount!=null){# #=kendo.format('{0:n2}', AsfAmount)# #}#").Width(150);
                                                columns.Bound(p => p.Vat).Title("VAT").ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(Vat!=null){# #=kendo.format('{0:n2}', Vat)# #}#").Width(150);
                                                columns.Bound(p => p.GrandTotal).ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(GrandTotal!=null){# #=kendo.format('{0:n2}', GrandTotal)# #}#").Width(150);
                                                columns.Bound(p => p.PceBalance).ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(PceBalance!=null){# #=kendo.format('{0:n2}', PceBalance)# #}#").Title("Remaining Budget").Width(150);
                                                columns.Bound(p => p.ClientName).Width(150);
                                                columns.Bound(p => p.ClientBrandName).Width(150);
                                                columns.Bound(p => p.DivisionName).Width(150).Title("Business Unit");
                                                columns.Bound(p => p.LegalEntityName).Width(150).Title("Legal Entity");
                                                columns.Bound(p => p.PceTypeCrossBilling).ClientTemplate("#if(PceTypeCrossBilling==true){#Yes#}else{#No#}#").Width(150);
                                            })
                                            .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                            .Scrollable(
                                                scr => scr.Height(250)
                                            )
                                            .Pageable(pageable => pageable
                                        .Refresh(true)
                                        .PageSizes(true)
                                        .ButtonCount(5))
                                            .AutoBind(false)
                                            .DataSource(dataSource => dataSource
                                                .Ajax()
                                                .PageSize(10)
                                                .Events(events => events.Error("errorHandler"))
                                                .Model(model => { model.Id(p => p.Id); })
                                                .Read(read => read.Action("GetPceChoiceList", "InvoiceClient").Data("gridChoicePce_params"))
                                            )
                                            .NoRecords()
                                        )
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btn-save-detail" onclick="SaveSelectedPce()">Save</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div> 