    function isValid() {
        var valid = $("#form").validate().form();
        if (valid) {
            var grid = $("#treelist").data("kendoGrid").dataSource.data();
            if (grid.length < 2) {
                swal('Warning', 'please select at least two pce in the invoice details before doing this process ...', 'warning');
                return false;
            }             
            return true;
        } else {
            return false;
        }
    }

    function result() { 
        var grid = $("#treelist").data("kendoGrid");
        var itemRow = grid.dataSource.data();
        var InvoiceMultipleListOthers = [];
        for (var i = 0; i < itemRow.length; i++) { 
            var gridDetails = $("#grid_" + itemRow[i].PceId).data("kendoGrid");
            var itemRows = gridDetails.dataSource.data();
            for (var x = 0; x < itemRows.length; x++) {
                InvoiceMultipleListOthers.push(itemRows[x]);
            }
        } 
        var result = {
            PceListMultiple: itemRow,
            InvoiceMultipleListOther: InvoiceMultipleListOthers,
            MultipleBrand: $("#gridMultipleBrand").data("kendoGrid").dataSource.data()
        }
        return result;
    }
    
