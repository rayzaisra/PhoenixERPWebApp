    function currency_select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;            
                 mApp.block("#m_blockui_list", {
                        overlayColor: "#000000",
                        type: "loader",
                        state: "primary",
                        message: "Processing..."
                    });

                $.ajax({
                    type: "GET",
                    dataType: "json",
                    contentType: "application/x-www-form-urlencoded",
                    async: false,
                    data: { id: dataItem.Value },
                    url: "@Url.Action("Get", "Currency",new { area="Finance"})",
                    success: function (result) {
                        if (result != null) {                            
                            $("#CurrencySymbol").val(result.CurrencySymbol);
                            $("#CurrencyIdDefault").val(result.CurrencyIdDefault);
                            $("#CurrencySymbolDefault").val(result.CurrencySymbolDefault);

                            if (dataItem.Value == result.CurrencyIdDefault) {
                                    $("#ExchangeRate").data("kendoNumericTextBox").value("1");
                                    $('#ExchangeRate').data("kendoNumericTextBox").readonly();
                             }
                             else { 
                                    $('#ExchangeRate').data("kendoNumericTextBox").readonly(false);
                            }

                            setCurrencyValue();

                            var dataSource = $("#treelist").data("kendoGrid").dataSource;
                            var view = dataSource.view();
                            for (var i = 0; i < view.length; i++) { 
                                view[i].set("CurrencySymbol", result.CurrencySymbol); 
                            }
                        }
                    },
                    error: function (e, t, s) {
                        console.log(e)
                        mApp.unblock("#m_blockui_list");
                    }
                }).then(setTimeout(function () {
                    mApp.unblock("#m_blockui_list");
                }, 2e3)); 
        }
    }
        
    function setCurrencyValue() {
        var currencySymbol = $("#CurrencySymbol").val();
        var CurrencySymbolDefault = $("#CurrencySymbolDefault").val(); 
        var totalAmount = $('#TotalAmount').data('kendoNumericTextBox');        
        var vat = $('#Vat').data('kendoNumericTextBox');
        var grandTotal = $('#GrandTotal').data('kendoNumericTextBox');
        var vatExchangeRate = $('#VatExchangeRate').data('kendoNumericTextBox');
        var exchangeRate = $('#ExchangeRate').data('kendoNumericTextBox');
         
        var totalAmountValue = totalAmount.value();
        var vatValue = vat.value();
        var grandTotalValue = grandTotal.value();
        var vatExchangeRateValue = vatExchangeRate.value();
        var exchangeRateValue = exchangeRate.value();
         
        totalAmount.setOptions({ value: totalAmountValue, format: currencySymbol + " #,###.##" });
        vat.setOptions({ value: vatValue, format: currencySymbol + " #,###.##" });
        grandTotal.setOptions({ value: grandTotalValue, format: currencySymbol + " #,###.##" });
        vatExchangeRate.setOptions({ value: vatExchangeRateValue, format: CurrencySymbolDefault + " #,###.##" });
        exchangeRate.setOptions({ value: exchangeRateValue, format: CurrencySymbolDefault + " #,###.##" }); 
    }

    function sumDebitJournal(sum) {
        return $("#CurrencySymbolDefault").val() + ' ' + kendo.toString(sum, '#,###.##');
    }

    function sumCreditJournal(sum) {
        return $("#CurrencySymbolDefault").val() + ' ' + kendo.toString(sum, '#,###.##');
    }
