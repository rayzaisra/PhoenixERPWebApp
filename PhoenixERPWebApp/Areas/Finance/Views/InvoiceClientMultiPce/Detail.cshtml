    function bindPCEList() {
        mApp.block("#m_blockui_list", {
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        });
        
        var grid = $("#grid-choice-pce").data("kendoGrid"); 
        //grid.dataSource.read(); 
        grid.dataSource.fetch(function () {
            $("#treelist").data("kendoGrid").dataSource.data().forEach(function (item) {
                var item2 = grid.dataSource.get(item.PceId);
                if(item2!=null){
                    grid.dataSource.remove(item2);
                }
            });
        }); 
        mApp.unblock("#m_blockui_list");
    };

    function VatPercent_Change() {
        var gridDetail = $("#grid-choice-pce").data("kendoGrid");
        gridDetail.saveRow();
        CallculateAll();
    }

    function CallculateAll() {
        var models = $("#treelist").data("kendoGrid").dataSource.data();
        var subTotal = 0;

        $.each(models, function (index, data) {
            if (data.GrandTotal != null) {
                subTotal += data.GrandTotal;
            }
        });
        ReCallculateAll(subTotal);
    }
    
    function ReCallculateAll(subTotal) {
        $('#TotalAmount').data("kendoNumericTextBox").value(subTotal);
        var vatpercent = $('#VAtPercentage').data("kendoNumericTextBox").value();
        if (vatpercent == null) vatpercent = 0;

        var vat = (subTotal * (vatpercent / 100));
        var grandTotal = (subTotal + vat);

        $('#Vat').data("kendoNumericTextBox").value(vat);
        $('#GrandTotal').data("kendoNumericTextBox").value(grandTotal);
    }

