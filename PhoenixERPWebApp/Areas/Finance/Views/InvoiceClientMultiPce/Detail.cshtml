<script>     
    $(document).ready(function () {
        vatexchangerate_change();
        setCurrencyValue();
        if ("@ViewBag.isRequestor" == "False") {  
            $("#InvoiceDate").data("kendoDatePicker").readonly();
            $('#AccountId').data("kendoDropDownList").readonly();
            $('#TotalAmount').data("kendoNumericTextBox").readonly();
            $('#GrandTotal').data("kendoNumericTextBox").readonly();
            $('#VAtPercentage').data("kendoNumericTextBox").readonly();
            $('#Vat').data("kendoNumericTextBox").readonly();
            $('#VatExchangeRate').data("kendoNumericTextBox").readonly();
            $('#ClientId').data("kendoDropDownList").readonly();
            $('#LegalId').data("kendoDropDownList").readonly();
            $('#CurrencyId').data("kendoDropDownList").readonly();
            $('#BusinessUnitId').data("kendoDropDownList").readonly();
            $('#AffiliationId').data("kendoDropDownList").readonly(); 

            $("#POClientNo").attr('readonly', 'readonly');
            $("#RefNumber").attr('readonly', 'readonly');
            $("#YourRef").attr('readonly', 'readonly');
            $("#Remarks").attr('readonly', 'readonly');
            $("#PayDescription").attr('readonly', 'readonly');
            
            $('#linkPoDocRemoveFile').css('display', 'none');
            $('#linkVatDocRemoveFile').css('display', 'none'); 
        } else {
            DDLCurrencyChange();
        }
           
        var vatDocName = '@Model.VatDocFileName';
        var poDocName = '@Model.PoDocFileName';

        if (vatDocName == '' && "@ViewBag.isRequestor" == "True") { SetVatDocUpload(); } else { $("#linkVatDocDownloadFile").text(vatDocName); }
        if (poDocName == '' && "@ViewBag.isRequestor" == "True") { SetPoDocUpload(); } else { $("#linkPoDocDownloadFile").text(poDocName); }
    }); 

    function VatNo_bound() {
        if ("@ViewBag.isRequestor" == "False") {
            $('#VatNo').data("kendoDropDownList").readonly(); 
        }
    }

    function DDLBrandBound() {         
        $('#BrandId').data("kendoDropDownList").readonly(); 
    }
          
    function AccountIdOnChange() { 
        $.ajax({
            type: "GET",
            dataType: "json",
            contentType: "application/x-www-form-urlencoded",
            async: false,
            data: { id: $("#AccountId").data("kendoDropDownList").value() },
            url: '@Url.Action("GetInfoBank", "InvoiceClient")',
            success: function (data) {
                if (data != null) {
                    $("#AccountBankNumber").val(data.AccountNumber);
                }
            }
        });
    }

    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row"));//.first()
    }
    
    function removeInvDtl_event(e) {
        var models = $("#treelist").data("kendoGrid").dataSource.data().filter((x) => { return x.PceId != e.model.PceId });
        var subTotal = 0;
        var brandList = [];

        $.each(models, function (index, data) {
            if (data.InvoiceBilled != null) {
                subTotal += data.InvoiceBilled;
            }

            var getBrand = brandList.filter((x) => { return x.BrandId == data.BrandId });
            if (getBrand.length == 0) {
                var brand = { BrandId: data.BrandId, ClientBrandName: data.ClientBrandName, ClientInvAddress: data.ClientInvAddress, ClientPIC: data.ClientPIC, TermOfPayment: data.TermOfPayment };
                brandList.push(brand);
            }
        });

        if (models.length == 0) {
            $('#ClientId').data("kendoDropDownList").value(""); 
            $('#ClientTaxNumber').val("");
        }

        $("#gridMultipleBrand").data("kendoGrid").dataSource.data(brandList);
        //$.each(brandList, function (i, dataItem) {
        //    $("#gridMultipleBrand").data('kendoGrid').dataSource.pushCreate(dataItem);
        //});

        ReCallculateAll(subTotal);
    }

    function grid_multi_pce_params() { 
        return { multipceid: $("#MultiPceId").val() };
    }
     
    function gridChoicePce_params() {  
        return {
            clientid : $("#_ClientId").data("kendoDropDownList").value(),
            legalid: $("#_LegalId").data("kendoDropDownList").value(),
            brandid : $("#_BrandId").data("kendoDropDownList").value(),
            mainservice : $("#_MainServiceCategory").data("kendoDropDownList").value(),
            currencyid : $("#_CurrencyId").data("kendoDropDownList").value(),
            divisionid: $("#_BusinessUnitId").data("kendoDropDownList").value(),
            invoiceId: $("#MultiPceId").val(),
            pceTypeCrossBilling: $("#_PceTypeCrossBilling").data("kendoDropDownList").value()
        }
    }

    function SaveSelectedPce() {
        var rowDataItem = []; 
        var isError = false;

        var grid = $("#grid-choice-pce").data("kendoGrid");
        var allSelected = grid.select(); 
        
        allSelected.each(function (index, row) {
            var dataItem = grid.dataItem(row);  
            dataItem.totalamtplusasf = dataItem.AsfAmount + dataItem.TotalAmount;
            dataItem.InvoiceBilled = dataItem.GrandTotal;
            
            var dataAR = $("#treelist").data('kendoGrid').dataSource.data()[0];
            var rowItem = rowDataItem[0];
            if (dataAR != null || rowItem != null) {
                var ClientId, LegalId, BrandId, MainServiceCategory, CurrencyId, BusinessUnitId, PceTypeCrossBilling; 
                if (dataAR != null) {
                    ClientId = dataAR.ClientId;
                    LegalId = dataAR.LegalId;
                    //BrandId = dataAR.BrandId;
                    MainServiceCategory = dataAR.MainServiceCategory;
                    CurrencyId = dataAR.CurrencyId;
                    BusinessUnitId = dataAR.BusinessUnitId;
                    PceTypeCrossBilling = dataAR.PceTypeCrossBilling;
                } else if (rowItem != null) {
                    ClientId = rowItem.ClientId;
                    LegalId = rowItem.LegalId;
                    //BrandId = rowItem.BrandId;
                    MainServiceCategory = rowItem.MainServiceCategory;
                    CurrencyId = rowItem.CurrencyId;
                    BusinessUnitId = rowItem.BusinessUnitId;
                    PceTypeCrossBilling = rowItem.PceTypeCrossBilling;
                }

                if (dataItem.ClientId == ClientId && dataItem.LegalId == LegalId && //dataItem.BrandId == BrandId &&
                    dataItem.MainServiceCategory == MainServiceCategory && dataItem.CurrencyId == CurrencyId && dataItem.BusinessUnitId == BusinessUnitId && dataItem.PceTypeCrossBilling == PceTypeCrossBilling) {
                    rowDataItem.push(dataItem);
                } else {
                    isError = true;
                    swal('Warning', "please choose the same client name, legal entity, main service category, currency, business unit and pce type cross billing", 'error');
                    //swal('Warning', "please choose the same client name, legal entity, client brand, main service category, currency, business unit and pce type cross billing", 'error');
                    return;
                }
            } else { 
                rowDataItem.push(dataItem); 
            }

            $('#ExchangeRate').data("kendoNumericTextBox").value(dataItem.ExchangeRate);
            $('#VatExchangeRate').data("kendoNumericTextBox").value(dataItem.ExchangeRate); 
            $('#ClientId').data("kendoDropDownList").value(dataItem.ClientId);
            //$('#BrandId').data("kendoDropDownList").value(dataItem.BrandId);
            $('#LegalId').data("kendoDropDownList").value(dataItem.LegalId);
            $('#CurrencyId').data("kendoDropDownList").value(dataItem.CurrencyId);
            $('#BusinessUnitId').data("kendoDropDownList").value(dataItem.BusinessUnitId);
            $('#AffiliationId').data("kendoDropDownList").value(dataItem.AffiliationId);
            $('#MainServiceCategory').data("kendoDropDownList").value(dataItem.MainServiceCategory);
            $("#PceTypeCrossBilling").val(dataItem.PceTypeCrossBilling)
              
            $('#ClientInvAddress').val(dataItem.ClientInvAddress);
            $('#ClientTaxNumber').val(dataItem.ClientTaxNumber);
            $('#ClientPIC').val(dataItem.ClientPIC); 
            $('#POClientNo').val(dataItem.POClientNo);
            $('#TermOfPayment').val(dataItem.TermOfPayment);

            $("#CurrencyIdDefault").val(dataItem.CurrencyIdDefault);
            $("#CurrencySymbolDefault").val(dataItem.CurrencySymbolDefault);
            $("#CurrencySymbol").val(dataItem.CurrencySymbol);
            DDLCurrencyChange();
            setCurrencyValue();
        });

        if (!isError) {
            $.each(rowDataItem, function (i, dataItem) {
                //$("#treelist").data('kendoGrid').dataSource.add(dataItem);
                $("#treelist").data('kendoGrid').dataSource.pushCreate(dataItem);
            });
             
            CallculateAll(); 
            
            var models = $("#treelist").data("kendoGrid").dataSource.data(); 
            var brandList = [];

            $.each(models, function (index, data) { 
                var getBrand = brandList.filter((x) => { return x.BrandId == data.BrandId });
                if (getBrand.length == 0) {
                    var brand = { BrandId: data.BrandId, ClientBrandName: data.ClientBrandName, ClientInvAddress: data.ClientInvAddress, ClientPIC: data.ClientPIC, TermOfPayment: data.TermOfPayment };
                    brandList.push(brand);
                }
            }); 

            $("#gridMultipleBrand").data("kendoGrid").dataSource.data(brandList);
            $('#modal-choice-pce').modal('toggle');
        } 
    }
     
