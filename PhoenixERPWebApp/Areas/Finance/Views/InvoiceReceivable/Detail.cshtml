                                else
                                { <a asp-action="Index" asp-controller="InvoiceReceivable" asp-area="Finance" class="fakelink btn btn-secondary"><span class="fa fa-arrow-circle-left"></span> Cancel</a>}
                            </div>                        
                    </form> 
                </div>
            </div>
        </div>
    </div>
