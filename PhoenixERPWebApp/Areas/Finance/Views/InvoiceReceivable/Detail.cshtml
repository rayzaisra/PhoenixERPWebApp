    function calculate_change() {
        var models = $("#grid-InvoiceReceivableDetailList").data("kendoGrid").dataSource.data();
        var subTotal = 0;

        $.each(models, function (index, data) {
            if (data.InvoiceValue != null) {
                subTotal += data.InvoiceValue;
            }
        });

        //var subTotal = $("#NetAmount").data("kendoNumericTextBox").value();
        var vatpercent = $('#ValueAddedTaxPercent').data("kendoNumericTextBox").value();
        var discountPercent =$('#DiscountPercent').data("kendoNumericTextBox").value();

        if (vatpercent == null) vatpercent = 0;
        if (discountPercent == null) discountPercent = 0;

        var vat = 0;
        if ("@ViewBag.UserAccessFrontDesk"=="True" || "@ViewBag.UserAccessAdminFinance"=="True")
        {
            vat = (subTotal * (vatpercent / 100));
        } else {
            vat = $('#ValueAddedTax').data("kendoNumericTextBox").value();
        }
        var discount = (subTotal * (discountPercent / 100));
        var grandTotal = (subTotal + vat) - discount;

        //tambahan
        var advt = $("#AdvertisingTax").data("kendoNumericTextBox").value();
        grandTotal = grandTotal - advt;

        $("#NetAmount").data("kendoNumericTextBox").value(subTotal)
        $('#ValueAddedTax').data("kendoNumericTextBox").value(vat);
        $('#DiscountAmount').data("kendoNumericTextBox").value(discount);
        $('#TotalCostVendor').data("kendoNumericTextBox").value(grandTotal);
    }


