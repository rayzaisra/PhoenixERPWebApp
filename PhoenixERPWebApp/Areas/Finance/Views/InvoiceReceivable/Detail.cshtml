                                    @(Html.Kendo().DropDownListFor(m => m.PoId)
                                        .DataTextField("Text") 
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .Events(e => { e.Select("po_select").DataBound("po_databound"); })
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetPOClient", "DropDown", new { area = "Finance" }).Data("vendor_params");
                                            }).ServerFiltering(true);
                                        })
