                                                read.Action("GetDDLInventoryGoodsReceipt", "Dropdown", new { area = "Finance" }).Data("goodReceived_params");
                                            })
                                            .ServerFiltering(true);
                                        }).CascadeFrom("PoId")
                                        .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.GoodReceivedId)}")
                                        .HtmlAttributes(new { style = "width:100%;" })
                                    )
                                </div>
                                @*<div class="form-group">
                                    <input type="hidden" asp-for="ServiceReceivedNumber" />
                                    <label asp-for="ServiceReceivedId"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.ServiceReceivedId)
                                        .DataTextField("Text")
