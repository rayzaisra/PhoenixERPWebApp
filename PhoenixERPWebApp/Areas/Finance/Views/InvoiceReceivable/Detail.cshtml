    function OnchangeTaxPayableCoa() {
        var TaxPayableCoaId = $("#TaxPayableCoaId").data("kendoDropDownList").value();
        if (TaxPayableCoaId != "") {
            $("#TaxPayable-error").css("display", "block");
            $("#TaxPayable").attr("required", "required");
        } else {
            $("#TaxPayable-error").css("display", "none");
            $("#TaxPayable").removeAttr("required");
        }
    }

    function sumDebit() {
        var models = $("#gridJournal").data("kendoGrid").dataSource.data();
        var result = 0;

        $.each(models, function (index, data) {
            if (data.Debit != null) {
                result += data.Debit;
            }
        });

        return $("#CurrencySymbolDefault").val() + ' ' + kendo.toString(result, '#,###.##'); 
    }

    function sumCredit() {
        var models = $("#gridJournal").data("kendoGrid").dataSource.data();
        var result = 0;

        $.each(models, function (index, data) {
            if (data.Credit != null) {
                result += data.Credit;
            }
        });

        return $("#CurrencySymbolDefault").val() + ' ' + kendo.toString(result, '#,###.##'); 
    }
</script>