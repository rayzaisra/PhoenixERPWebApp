    function callActionInvFrontDesk(action, title) {
        var valid = $("#formInvoiceReceivable").validate().form();
        if (valid) {
            var maskedtextbox = $("#TaxNumber").data("kendoMaskedTextBox");
            if (maskedtextbox.value() != "") {
                if (maskedtextbox.value().includes(maskedtextbox.options.promptChar)) {
                    swal('Warning', "Tax Number is incomplete", 'warning');
                    return false;
                }
            }

            var paramsUrl = '@Url.Action("Save", "InvoiceReceivable")';
            paramsUrl = paramsUrl.replace("Save", action);
            callActionFile({ formId: "formInvoiceReceivable", title: title, type: "POST", url: paramsUrl });
        }
    }

    function callActionInv(action, title) {
        if (!isValid(false, action)) return;
        var paramsUrl = '@Url.Action("Save", "InvoiceReceivable")';
        paramsUrl = paramsUrl.replace("Save", action);
        callActionFile({ formId: "formInvoiceReceivable", title: title, type: "POST", url: paramsUrl, objects: result() });
    }

     function callActionJournal(action, title) {
        if (!isValid(true)) return;
        var paramsUrl = '@Url.Action("Save", "InvoiceReceivable")';
        paramsUrl = paramsUrl.replace("Save", action);
        callActionFile({ formId: "formInvoiceReceivable", title: title, type: "POST", url: paramsUrl, objects: result() });
    }

    function isValid(isDraft, action) {
        if (action != "RevisedAccountingSupervisor") {
            $("#TransactionDate").attr("required", "required");
        } else {
            $("#TransactionDate").removeAttr("required");
        }

        var valid = $("#formInvoiceReceivable").validate().form();
        if (valid) {
            var grid = $("#grid-InvoiceReceivableDetailList").data("kendoGrid").dataSource.data();
            if (grid.length == 0) {
                swal('Warning', "Please input invoice detail list", 'warning');
                return false;
            }

            if (isDraft == false) {
                if ("@ViewBag.CreateJournal" == "True") {
                    if (action != "RevisedAccountingSupervisor") {
                        var gridJournal = $("#gridJournal").data("kendoGrid").dataSource.data();
                        if (gridJournal.length == 0) {
                            swal('Warning', "Please create a journal first before this process", 'warning');
                            return false;
                        }
                    }
                }
            }

            var maskedtextbox = $("#TaxNumber").data("kendoMaskedTextBox");
            if (maskedtextbox.value() != "") {
                if (maskedtextbox.value().includes(maskedtextbox.options.promptChar)) {
                    swal('Warning', "Tax Number is incomplete", 'warning');
                    return false;
                }
            }


            return true;
        } else {
            return false;
        }
    }

    function result() {
        var grid = $("#grid-InvoiceReceivableDetailList").data("kendoGrid");
        var dataList = { InvoiceReceivableDetails: grid.dataSource.data() }
        return dataList;
