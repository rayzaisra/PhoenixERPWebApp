    function setFile(id, fileName, isReadonly, isRequired) {
        if (fileName != "") {
            $("#link" + id + "DownloadFile").text(fileName);
        } else {
            uploadFile(id, isRequired);
        }
        if (isReadonly) {
            if (fileName != "") {
                $("#link" + id + "RemoveFile").empty();
            } else {
                $("#file" + id).data("kendoUpload").enable(false);
            }
        }
    }

    function uploadFile(id, isRequired) {
        var required = "";
        $("#link" + id + "DownloadFile").empty();
        $("#link" + id + "RemoveFile").empty();
        if (isRequired=="True") required = "required";
        $("#div" + id + "File").empty().append("<input name='file" + id + "' id='file" + id + "' type='file' " + required +"/>");

        $("#file" + id).kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".doc", ".pdf", ".docx"]
            }
        });
    }

    function downloadFile(id) {
        downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download" })', data: { id: $("#" + id).val() } });
    }

