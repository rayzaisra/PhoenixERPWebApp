@model PhoenixERPWebApp.Models.InvoiceReceivable
@{
    if (Model.ListGroup == "inv") { ViewData["Title"] = "Invoice Received"; }
    else if (Model.ListGroup == "tap"){ ViewData["Title"] = "Temporary Account Payable"; }
    else if (Model.ListGroup == "ap"){ ViewData["Title"] = "Account Payable"; }
    else { ViewData["Title"] = "Invoice Received"; }
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
} 
<style>
    .k-numerictextbox .k-input {
        text-align: right;
        padding-right:10px;
    }
</style>
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto"> 
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-suitcase"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (Model.ListGroup == "inv")
                    { <a asp-action="Index" asp-controller="InvoiceReceivable" asp-area="Finance" class="m-nav__link"><span class="m-nav__link-text">Invoice Received</span></a>}
                    else if (Model.ListGroup == "tap")
                    { <a asp-action="Index" asp-controller="TemporaryAccountPayable" asp-area="Finance" class="m-nav__link"><span class="m-nav__link-text">Temporary Account Payable List</span></a>}
                    else if (Model.ListGroup == "ap")
                    { <a asp-action="Index" asp-controller="AccountPayable" asp-area="Finance" class="m-nav__link"><span class="m-nav__link-text">Account Payable List</span></a>}
                    else{<a asp-action="Index" asp-controller="InvoiceReceivable" asp-area="Finance" class="m-nav__link"><span class="m-nav__link-text">Invoice Received</span></a>}
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Detail</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">
                                @if (Model.ListGroup == "inv") { <label>Invoice Received</label> }
                                else if (Model.ListGroup == "tap"){ <label>Temporary Account Payable</label> }
                                else if (Model.ListGroup == "ap"){ <label>Account Payable</label> }
                                else { <label>Invoice Received</label> }</h3> &nbsp; 

                                @if (Model.InvoiceStatusId == @PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.Open) {
                                    <span class="m-badge m-badge--info m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.StatusName(PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.Open)</span>}
                                else if (Model.InvoiceStatusId == @PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.TAP) {
                                    <span class="m-badge m-badge--warning m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.StatusName(PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.TAP)</span>}
                                else if (Model.InvoiceStatusId == @PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.TAXTAP) {
                                    <span class="m-badge m-badge--danger m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.StatusName(PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.TAXTAP)</span>}
                                else if (Model.InvoiceStatusId == @PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.OpenAP) {
                                    <span class="m-badge m-badge--dark m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.StatusName(PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.OpenAP)</span>}
                                else if (Model.InvoiceStatusId == @PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.Posted) {
                                    <span class="m-badge m-badge--success m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.StatusName(PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.Posted)</span>}
                                else if (Model.InvoiceStatusId == @PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.Cancelled) {
                                    <span class="m-badge m-badge--success m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.StatusName(PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.Cancelled)</span>}
                                else {
                                    <span class="m-badge m-badge--info m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.StatusName(PhoenixERPWebApp.Models.Enum.InvoiceReceivedStatus.Open)</span>}
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
