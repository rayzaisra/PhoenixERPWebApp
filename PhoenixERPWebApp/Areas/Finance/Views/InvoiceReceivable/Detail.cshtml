    function currency_select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
                 mApp.block("#m_blockui_list", {
                        overlayColor: "#000000",
                        type: "loader",
                        state: "primary",
                        message: "Processing..."
                    });

                $.ajax({
                    type: "GET",
                    dataType: "json",
                    contentType: "application/x-www-form-urlencoded",
                    async: false,
                    data: { id: dataItem.Value },
                    url: "@Url.Action("Get", "Currency",new { area="Finance"})",
                    success: function (result) {
                        if (result != null) {
                            $("#CurrencySymbol").val(result.CurrencySymbol);
                            $("#CurrencyIdDefault").val(result.CurrencyIdDefault);
                            $("#CurrencySymbolDefault").val(result.CurrencySymbolDefault);

                            if (dataItem.Value == result.CurrencyIdDefault) {
                                    $("#ExchangeRate").data("kendoNumericTextBox").value("1");
                                    $('#ExchangeRate').data("kendoNumericTextBox").readonly();
                             }
                             else {
                                    $('#ExchangeRate').data("kendoNumericTextBox").readonly(false);
                            }

                            setCurrencyValue();

                            var dataSource = $("#grid-InvoiceReceivableDetailList").data("kendoGrid").dataSource;
                            var view = dataSource.view();
                            for (var i = 0; i < view.length; i++) {
                                view[i].set("CurrencySymbol", result.CurrencySymbol);
                            }
                        }
                    },
                    error: function (e, t, s) {
                        console.log(e)
                        mApp.unblock("#m_blockui_list");
                    }
                }).then(setTimeout(function () {
                    mApp.unblock("#m_blockui_list");
                }, 2e3));
        }
    }

    function DDLCurrencyChange() {
        if ($('#CurrencyId').data("kendoDropDownList").value() == $("#CurrencyIdDefault").val() &&
            $('#CurrencyId').data("kendoDropDownList").value() != "") {
            $("#ExchangeRate").data("kendoNumericTextBox").value("1");
            $('#ExchangeRate').data("kendoNumericTextBox").readonly();
        }
        else {
            $('#ExchangeRate').data("kendoNumericTextBox").readonly(false);
        }
    }

    function setCurrencyValue() {
        var currencySymbol = $("#CurrencySymbol").val();
        var CurrencySymbolDefault = $("#CurrencySymbolDefault").val();
        var netAmount = $('#NetAmount').data('kendoNumericTextBox');
        var discountAmount = $('#DiscountAmount').data('kendoNumericTextBox');
        var valueAddedTax = $('#ValueAddedTax').data('kendoNumericTextBox');
        var advertisingTax = $('#AdvertisingTax').data('kendoNumericTextBox');
        var totalCostVendor = $('#TotalCostVendor').data('kendoNumericTextBox');
        var taxPayable = $('#TaxPayable').data('kendoNumericTextBox');
        var exchangeRate = $('#ExchangeRate').data('kendoNumericTextBox');

        var netAmountValue = netAmount.value();
        var discountAmountValue = discountAmount.value();
        var valueAddedTaxValue = valueAddedTax.value();
        var advertisingTaxValue = advertisingTax.value();
        var totalCostVendorValue = totalCostVendor.value();
        var taxPayableValue = taxPayable.value();
        var exchangeRateValue = exchangeRate.value();

        netAmount.setOptions({ value: netAmountValue, format: currencySymbol + " #,###.##" });
        discountAmount.setOptions({ value: discountAmountValue, format: currencySymbol + " #,###.##" });
        valueAddedTax.setOptions({ value: valueAddedTaxValue, format: currencySymbol + " #,###.##" });
        advertisingTax.setOptions({ value: advertisingTaxValue, format: currencySymbol + " #,###.##" });
        totalCostVendor.setOptions({ value: totalCostVendorValue, format: currencySymbol + " #,###.##" });
        taxPayable.setOptions({ value: taxPayableValue, format: currencySymbol + " #,###.##" });
        exchangeRate.setOptions({ value: exchangeRateValue, format: CurrencySymbolDefault + " #,###.##" });
    }

    function sumGridJournal(sum) {
        return $("#CurrencySymbolDefault").val() + ' ' + kendo.toString(sum, '#,###.##');
