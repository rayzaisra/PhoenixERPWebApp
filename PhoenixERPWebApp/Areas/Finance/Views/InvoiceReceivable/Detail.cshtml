                                            //onkeydown = "javascript:return false;",
                                            @placeholder = $"Choose a {Html.DisplayNameFor(m => m.TaxDate)}"
                                        })
                                    )
                                </div>
                                <div class="form-group">
                                    <label asp-for="TaxNumber"></label> :
                                    @(Html.Kendo().MaskedTextBoxFor(m => m.TaxNumber)
                                        .Mask("000.000-00.00000000")
                                        .HtmlAttributes(new {
                                            style = "width:100%;",
                                            data_validmask_msg = $"{Html.DisplayNameFor(m => m.TaxNumber)} is incomplete",
                                            @placeholder = $"Input type a {Html.DisplayNameFor(m => m.TaxNumber)}" }))
                                </div>
                                <div class="form-group">
                                    <input type="hidden" asp-for="GoodReceivedNumber" />
                                    <label asp-for="GoodReceivedId"></label> : &nbsp; <a href="#" onclick="viewGoodReceived()" id="linkGoodReceived" style="text-decoration:underline !important;">View</a>
                                    @(Html.Kendo().DropDownListFor(m => m.GoodReceivedId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .Events(x => x.Select("goodreceived_select").DataBound("goodReceived_databound"))
                                        .DataSource(source =>
