                                                //        .EndsWith("End sWith")
                                                //    )))
                                                .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                                .Resizable(rsz => rsz.Columns(true))
                                                .NoRecords()
                                                .DataSource(dataSource => dataSource
                                                    .Ajax()
                                                    .Events(events => events.Error("errorHandler"))
                                                    .Model(model =>
                                                    {
                                                        model.Id(p => p.Id);
                                                        model.Field(p => p.ReferenceNumber).Editable(false);
                                                        model.Field(p => p.TransactionDate).Editable(false);
                                                        model.Field(p => p.CodeRec).Editable(false);
                                                        model.Field(p => p.AccountName).Editable(false);
                                                        model.Field(p => p.Debit).Editable(false);
                                                        model.Field(p => p.Credit).Editable(false);
                                                    })
                                                    .Aggregates(aggregates =>
                                                    {
                                                        aggregates.Add(p => p.Debit).Sum();
                                                        aggregates.Add(p => p.Credit).Sum();
                                                    })
                                                    .Read(read => read.Action("readjournal", "jobclosing").Data("grid_params"))
                                                    .Update(update => update.Action("updateJournal", "jobclosing"))
                                                )
                                            )
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row ">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label asp-for="RemarksProcess"></label> :
                                            @Html.TextAreaFor(x => x.RemarksProcess, new { style = "height:100px;width:100%" })
                                        </div>
                                    </div>
                                </div>

                                <partial name="_HistoryApproval" />
                                <partial name="_StatusLog" />
                            </div>
                        </div>

                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="pull-right">
                                    @if (ViewBag.isRequestor == true)
                                    {
                                        <button type="button" id="btnSave" class="btn btn-success edit"><span class="fa fa-save"></span> Save</button>
                                        <button type="button" id="btnSubmit" class="btn btn-primary edit"><span class="fa fa-paper-plane"></span> Submit</button>
                                    }
                                    else if (ViewBag.processApprove == true)
                                    {
                                        <button type="button" id="btnReject" class="btn btn-danger"><span class="fa fa-ban"></span> Reject</button>
                                        <button type="button" id="btnApprove" class="btn btn-primary"><span class="fa fa-bookmark"></span> Approve</button>
                                    }
                                    <a asp-action="index" asp-controller="jobclosing" asp-area="finance" class="fakelink btn btn-secondary"><span class="fa fa-arrow-circle-left"></span> Cancel</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var SelectApAr = [];
    $(document).ready(function () {
         @foreach(var item in Model.JobClosingDetails) { <Text>SelectApAr.push({ Id: '@item.JournalId'});</text>}
    });

    function job_params() {
        return {
            JobId:"@Model.JobId"
        }
    }

    function grid_params() {
        return {
            id: $("#Id").val()
        }
    }

    $('#btnApprove').click(function () {
        $("#RemarksProcess").removeAttr("required", "required");
        callAction({ formId: "formjobclosing", title: "approve", type: "PUT", url: '@Url.Action("approve", "jobclosing")'});
    });

    $('#btnReject').click(function () {
        $("#RemarksProcess").attr("required", "required");
        callAction({ formId: "formjobclosing", title: "reject", type: "PUT", url: '@Url.Action("reject", "jobclosing")'});
    });

    $('#btnSave').click(function () {
        if (!isValid(true)) return; 
        callAction({ formId: "formjobclosing", title: "save", type: "POST", url: '@Url.Action("save", "jobclosing")', objects: result()});
    });

    $('#btnSubmit').click(function () {
        if (!isValid(false)) return; 
        callAction({ formId: "formjobclosing", title: "submit", type: "POST", url: '@Url.Action("submit", "jobclosing")', objects: result()});
    });

    $('#btnCretaeJournal').click(function () {
        if (!isValid(true)) return;
        callAction({ formId: "formjobclosing", title: "create journal", type: "POST", url: '@Url.Action("createjournal", "jobclosing")', objects: result()});
    });

    @*$('#btnGenerate').click(function () { 
        if (!isValid()) return; 
        callAction({ formId: "formjobclosing", title: "generate", type: "POST", url: '@Url.Action("generate", "jobclosing")', objects: result()});
    });*@

    function result() {
        //var grid = $("#gridSummary").data("kendoGrid");
        var dataList = {
            JobClosingDetails: Details(),
            JournalEntry: $("#gridJournalEntry").data("kendoGrid").dataSource.data()
        }
        return dataList;
    }

    function isValid(isDraft) {
        var valid = $("#formjobclosing").validate().form();
        if (valid) {
            //var grid = $("#gridSummary").data("kendoGrid").dataSource.data();
            //if (grid.length == 0) {
            //    swal('Warning', "Please generate it before processing", 'warning');
            //    return false;
            //}


            if (Balance() == false) {
                swal('Warning', "Debit value is not the same as credit value, please make sure the debit value must be equal to the credit value.", 'warning');
                return false;
            }

            if (isDraft==false){ 
                var gridJournal = $("#gridJournal").data("kendoGrid").dataSource.data();
                if (gridJournal.length == 0) {
                    swal('Warning', "Please create a journal first before this process", 'warning');
                    return false;
                }
            }

            return true;
        } else {
            return false;
        }
    }
    
    function Details() {
        var JobDetails = [];
        var gridAP = $("#gridAP").data("kendoGrid");
        var rowsAP = gridAP.select();
        rowsAP.each(function (index, row) {
            var selectedItem = gridAP.dataItem(row);
            var data = {JournalId: selectedItem.Id, ReffNumber: selectedItem.ReffNumber, ReffDate: selectedItem.TransactionDate, CoaId: selectedItem.CoaId, CoaName: selectedItem.Name5, Description: selectedItem.Description, Debit: selectedItem.Debit, Credit: selectedItem.Credit };
            JobDetails.push(data);
        });

        var gridAR = $("#gridAR").data("kendoGrid");
        var rowsAR = gridAR.select();
        rowsAR.each(function (index, row) {
            var selectedItem = gridAR.dataItem(row);
            var data = {JournalId: selectedItem.Id, ReffNumber: selectedItem.ReffNumber, ReffDate: selectedItem.TransactionDate, CoaId: selectedItem.CoaId, CoaName: selectedItem.Name5, Description: selectedItem.Description, Debit: selectedItem.Debit, Credit: selectedItem.Credit };
            JobDetails.push(data);
        });
        
        return JobDetails;
    }

    function closing_dataBoundEvent(e) {
        var grid = this;
        var rows = grid.items();
         
        $(rows).each(function () { 
            var row = this;
            @*var dataItem = grid.dataItem(row);

            var select = SelectApAr.filter(function (data) {return data.Id == dataItem.Id; });

            if (select.length > 0) {
                grid.select(row);
            }

            if ("@ViewBag.isRequestor" == "True") {
                $('input:checkbox').removeAttr('disabled');
            } else {
                $('input:checkbox').attr('disabled', 'true');
            }*@


            //Auto Select All
            grid.select(row); 
            $('input:checkbox').attr('disabled', 'true');
        });
    }

    
    function save_event(e) {
        var CoaId = $("#CoaId").data("kendoDropDownList").value();
        var AccountName = $("#CoaId").data("kendoDropDownList").text();
        var CodeRec = $("#CodeRec").val();
        var Condition = $("#Condition").data("kendoDropDownList").value();
        var Debit = $("#Debit").data("kendoNumericTextBox").value();
        var Credit = $("#Credit").data("kendoNumericTextBox").value();

        e.model.set("CoaId", CoaId);
        e.model.set("CodeRec", CodeRec);
        e.model.set("AccountName", AccountName);
        e.model.set("Condition", Condition);
        e.model.set("Debit", Debit);
        e.model.set("Credit", Credit);

        //var TransactionDate = $("#TransactionDate").data("kendoDatePicker").value();
        //e.model.set("TransactionDate", TransactionDate)

        Balance();
    }
         
    function edit_event(e) {
        Condition(e.model.Condition);
    }
    
    function Condition_Select(e) {
        if (e.dataItem) {
            Condition(e.dataItem.Value);
            if (e.dataItem.Value == "Debit") {
                $('#Credit').data("kendoNumericTextBox").value(0);
            } else {
                $('#Debit').data("kendoNumericTextBox").value(0);
            }
        }
    }

    function Condition(value) {
        var isReadOnly = (value == "Debit");
        $("#Debit").data("kendoNumericTextBox").readonly(!isReadOnly);
        $("#Credit").data("kendoNumericTextBox").readonly(isReadOnly);
    }

    function Balance() {
        var models = $("#gridJournalEntry").data("kendoGrid").dataSource.data();
        var totalDebit = 0;
        var totalCredit = 0;

        $.each(models, function (index, data) {
            if (data.Debit != null) {
                totalDebit += data.Debit;
            }
            if (data.Credit != null) {
                totalCredit += data.Credit;
            }
        });
        var balance = (totalCredit == totalDebit);
        if (balance) {
            $("#lblBalance").html("<span style='color:green;'>Balance</span>");
        } else {
            $("#lblBalance").html("<span style='color:red;'>Not Balance</span>");
        }
        return balance;
    }
    
    function sumDebit() {
        var models = $("#gridJournalEntry").data("kendoGrid").dataSource.data();
        var result = 0;

        $.each(models, function (index, data) {
            if (data.Debit != null) {
                result += data.Debit;
            }
        });
        return kendo.toString(result, 'n2');
    }

    function sumCredit() {
        var models = $("#gridJournalEntry").data("kendoGrid").dataSource.data();
        var result = 0;

        $.each(models, function (index, data) {
            if (data.Credit != null) {
                result += data.Credit;
            }
        });
        return kendo.toString(result, 'n2');
    }
</script>