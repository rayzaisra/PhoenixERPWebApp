                                    @*<div class="col-lg-6">
                                        <div class="form-group">
                                            <label asp-for="AffiliationId"></label> :
                                            @(Html.Kendo().DropDownListFor(m => m.AffiliationId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Filter(FilterType.Contains)
                                                .DataSource(source => source
                                                    .Custom()
                                                    .Transport(transport => transport
                                                    .Read(read =>
                                                    {
                                                        read.Action("GetAffiliation", "Dropdown", new { area = "Finance" });
                                                    }))
                                                    .ServerFiltering(false)
                                                )
                                                .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.AffiliationId)}")
                                                .HtmlAttributes(new {
                                                    style = "width:100%;", 
                                                    @readonly = "readonly", 
                                                })
                                            )
                                        </div>
                                    </div>*@
                                </div>

                                @*<div class="row ">                                    
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label asp-for="JvDescription"></label> :
                                            @Html.TextAreaFor(m => m.JvDescription, new {  style = "height:100px; width:100%;", @placeholder = $"Input type a {Html.DisplayNameFor(m => m.JvDescription)}"})
                                        </div>
                                    </div>
                                </div>*@
                                
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.JournalEntryDetail>()
                                                .Name("grid")
                                                .ToolBar(x =>
                                                {
                                                    if ((Model.IsDraft ?? true) == true)
                                                    {
                                                        x.Create();
                                                    }

                                                })
                                                .Columns(columns =>
                                                {
                                                    if ((Model.IsDraft??true) == true)
                                                    {
                                                        columns.Command(command =>
                                                        {
                                                            command.Edit().Text(" ").UpdateText(" ").CancelText(" ");
                                                            command.Destroy().Text(" ");
                                                        }).Title("Action").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(90);
                                                    }

                                                    columns.Bound(p => p.TransactionDate).Title("Date").EditorTemplateName("Date").Width(100);
                                                    //columns.Bound(p => p.CodeRec).EditorTemplateName("StringReadOnly").Width(100);
                                                    columns.Bound(p => p.CoaId).ClientTemplate("#:AccountName == null ? '' : AccountName #").EditorTemplateName("CoaIdDropdown").Width(200);
                                                    columns.Bound(p => p.Description).Width(250).ClientFooterTemplate("TOTAL").FooterHtmlAttributes(new { style = "text-align:right;" });
                                                    columns.Bound(p => p.Condition).EditorTemplateName("Finance/Journal/ConditionDropdown").Width(100);
                                                    columns.Bound(p => p.Debit).Width(150).ClientFooterTemplate("#=kendo.format('{0:n2}', sumDebit())#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                    columns.Bound(p => p.Credit).Width(150).ClientFooterTemplate("#=kendo.format('{0:n2}', sumCredit())#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                    columns.Bound(p => p.JobId).EditorTemplateName("JobIdDropdown").ClientTemplate("#:JobName == null ? '' : JobName #").Width(250);
                                                    columns.Bound(p => p.BusinessUnitId).EditorTemplateName("BusinessUnitIdDropdown").ClientTemplate("#:BusinessUnitName == null ? '' : BusinessUnitName #").Width(250);
                                                    columns.Bound(p => p.PceId).EditorTemplateName("StringReadOnly").Width(180);
                                                    columns.Bound(p => p.PcaId).EditorTemplateName("StringReadOnly").Width(180);
                                                    columns.Bound(p => p.PcaTaskId).EditorTemplateName("PcaTaskIdDropdown").Width(150).ClientTemplate("#:PcaTask == null ? '' : PcaTask #");
                                                })
                                                //.Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                                //.Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                                                //    .Extra(false)
                                                //    .Operators(operators => operators
                                                //    .ForString(str => str.Clear()
                                                //        .Contains("Contains")
                                                //        .StartsWith("Start sWith")
                                                //        .EndsWith("End sWith")
                                                //    )))
                                                .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                                .Resizable(rsz => rsz.Columns(true))
                                                .NoRecords()
                                                .Editable(x => x.Mode(GridEditMode.InLine).DisplayDeleteConfirmation(true))
                                                .DataSource(dataSource => dataSource
                                                    .Ajax()
                                                    .Events(events => events.Error("errorHandler"))
                                                    .Model(model => { model.Id(p => p.Id); })
                                                    .Read(read => read.Action("readdetail", "journalentry").Data("grid_params"))
                                                    .Create(create => create.Action("createdetail", "journalentry"))
                                                    .Update(update => update.Action("updatedetail", "journalentry"))
                                                    .Destroy(destroy => destroy.Action("destroydetail", "journalentry"))
                                                )
                                                .Events(evt=>evt.Save("save_event").Edit("edit_event"))
                                            )
                                        </div>
                                    </div>
                                </div>

                                @if ((Model.IsDraft ?? true) == true)
                                {
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <button type="button" id="btnCretaeJournal" class="btn btn-primary add"><span class="fa fa-plus"></span> Create Journal</button>
                                            <div class="pull-right">
                                                <h3 class="m--font-info"><span id="lblBalance"></span></h3>
                                            </div>
                                        </div>
                                    </div>
                                    <br/>
                                }

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Journal>()
                                                .Name("gridJournal")
                                                .Columns(columns =>
                                                {
                                                    columns.Bound(p => p.CodeRec).Width(100);
                                                    columns.Bound(p => p.AccountName).Title("Account Name (Level 5 COA)").Width(250);
                                                    columns.Bound(p => p.ReferenceNumber).Width(150);
                                                    columns.Bound(p => p.Description).Width(200);
                                                    columns.Bound(p => p.CurrencyName).Width(120).ClientFooterTemplate("TOTAL").FooterHtmlAttributes(new { style = "text-align:right;" });
                                                    columns.Bound(p => p.Debit).Width(150).Format("{0:N2}").ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                    columns.Bound(p => p.Credit).Width(150).Format("{0:N2}").ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                    columns.Bound(p => p.LegalEntityName).Width(200);
                                                    columns.Bound(p => p.DivisiName).Width(200);
                                                    columns.Bound(p => p.AfiliationName).Width(200);
                                                })
                                                //.Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                                //.Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                                                //    .Extra(false)
                                                //    .Operators(operators => operators
                                                //    .ForString(str => str.Clear()
                                                //        .Contains("Contains")
                                                //        .StartsWith("Start sWith")
                                                //        .EndsWith("End sWith")
                                                //    )))
                                                .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                                .Resizable(rsz => rsz.Columns(true))
                                                .NoRecords()
                                                .DataSource(dataSource => dataSource
                                                    .Ajax()
                                                    .Events(events => events.Error("errorHandler"))
                                                    .Model(model => { model.Id(p => p.Id); })
                                                    .Aggregates(aggregates =>
                                                    {
                                                        aggregates.Add(p => p.Debit).Sum();
                                                        aggregates.Add(p => p.Credit).Sum();
                                                    })
                                                    .Read(read => read.Action("readjournal", "journalentry").Data("grid_params"))
                                                )
                                            )
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="pull-right">
                                    @if ((Model.IsDraft ?? true) == true)
                                    {
                                        <button type="button" id="btnSave" class="btn btn-success edit"><span class="fa fa-save"></span> Save</button>
                                        <button type="button" id="btnSubmit" class="btn btn-primary edit"><span class="fa fa-paper-plane"></span> Submit</button>
                                        @if (Model.Id != null)
                                        {
                                            <button type="button" id="btnDelete" class="btn btn-danger delete"><span class="fa fa-trash-alt"></span> Delete</button>
                                        }
                                    }
                                    <a asp-action="index" asp-controller="journalentry" asp-area="finance" class="fakelink btn btn-secondary">Close</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {        
        if ("@(Model.IsDraft?? true)" == "False") {
            $("#ExchangeRate").data("kendoNumericTextBox").readonly(); 
            $("#LegalEntityId").data("kendoDropDownList").readonly();
            $("#JvDate").data("kendoDatePicker").readonly();  
            //$("#BusinessUnitId").data("kendoDropDownList").readonly();            
            //$("#JvReferenceNo").attr('readonly', 'readonly');
            $("#CurrencyId").data("kendoDropDownList").readonly();
            $("#JvDescription").attr('readonly', 'readonly');
        } else {            
            if ("@Model.CurrencyId" == "@PhoenixERPWebApp.Models.CurrencyIDR.CurrencyId") {
                $("#ExchangeRate").data("kendoNumericTextBox").readonly(); 
            } else {
                $("#ExchangeRate").data("kendoNumericTextBox").readonly(false); 
            } 
        }
    });

    function grid_params() {
        return {
            id: $("#Id").val()
        }
    }

    $('#btnSubmit').click(function () {
        if (!isValid()) return;
        callAction({ formId: "formJournalEntry", title: "submit", type: "POST", url: '@Url.Action("submit", "journalentry")', objects: result()});
    });

    $('#btnSave').click(function () {
        if (!isValid()) return;
        callAction({ formId: "formJournalEntry", title: "save", type: "POST", url: '@Url.Action("save", "journalentry")', objects: result()});
    });
    
    $('#btnDelete').click(function () {
        callAction({ formId: "formJournalEntry", title: "delete", type: "DELETE", url: '@Url.Action("delete", "journalentry")'});
    });

    $('#btnCretaeJournal').click(function () {
        if (!isValidBalance()) return;
        callAction({ formId: "formJournalEntry", title: "create journal", type: "POST", url: '@Url.Action("createjournal", "journalentry")', objects: result()});
    });
    
    function isValid() {
        var valid = $("#formJournalEntry").validate().form();
        if (valid) {
            var grid = $("#grid").data("kendoGrid").dataSource.data();
            if (grid.length == 0) {
                swal('Warning', "Please input journal detail list", 'warning');
                return false;
            }
            
            return true;
        } else {
            return false;
        }
    }

    function isValidBalance() {
        var valid = $("#formJournalEntry").validate().form();
        if (valid) {
            var grid = $("#grid").data("kendoGrid").dataSource.data();
            if (grid.length == 0) {
                swal('Warning', "Please input journal detail list", 'warning');
                return false;
            }

            if (Balance() == false) {
                swal('Warning', "Debit value is not the same as credit value, please make sure the debit value must be equal to the credit value.", 'warning');
                return false;
            }

            return true;
        } else {
            return false;
        }
    }

    function result() {
        var grid = $("#grid").data("kendoGrid");
        var dataList = {
            JournalEntryDetails: grid.dataSource.data()
        }

        return dataList;
    }
         
    function CoaId_Select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;

            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });
            
            $.ajax({
                type: "GET",
                url: '@Url.Action("Get", "ChartOfAccount")',
                data: { id: dataItem.Value },
                success: function (result) {
                    if (result != undefined) {
                        $("#CodeRec").val(result.CodeRec);
                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    console.log(e)
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
            }, 2e3));
        }
    }
    
    @*function BusinessUnit_Select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;

            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            if (dataItem.Value == "") {
                $("#AffiliationId").data("kendoDropDownList").value("");
                mApp.unblock("#m_blockui_list");
            } else {
                $.ajax({
                    type: "GET",
                    dataType: "json",
                    contentType: "application/x-www-form-urlencoded",
                    async: false, 
                    url: '@Url.Action("Get", "BusinessUnit", new { area = "HrisNew" })',
                    data: { id: dataItem.Value },
                    success: function (result) {
                        if (result != undefined) {
                            $("#AffiliationId").data("kendoDropDownList").value(result.AffiliationId);
                        }
                        mApp.unblock("#m_blockui_list");
                    },
                    error: function (e, t, s) {
                        console.log(e)
                        mApp.unblock("#m_blockui_list");
                    }
                }).then(setTimeout(function () {
                    mApp.unblock("#m_blockui_list");
                    }, 2e3));
            }
        }
    }*@

    function save_event(e) {
        var CoaId = $("#CoaId").data("kendoDropDownList").value();
        var AccountName = $("#CoaId").data("kendoDropDownList").text();
        var CodeRec = $("#CodeRec").val();
        var Condition = $("#Condition").data("kendoDropDownList").value();
        var Debit = $("#Debit").data("kendoNumericTextBox").value();
        var Credit = $("#Credit").data("kendoNumericTextBox").value();
        
        e.model.set("CoaId", CoaId);
        e.model.set("CodeRec", CodeRec);
        e.model.set("AccountName", AccountName);
        e.model.set("Condition", Condition);
        e.model.set("Debit", Debit);
        e.model.set("Credit", Credit); 
        
        var TransactionDate = $("#TransactionDate").data("kendoDatePicker").value();
        var JobId = $("#JobId").data("kendoDropDownList").value();
        var Jobname = $("#JobId").data("kendoDropDownList").text();
        var BusinessUnitId = $("#BusinessUnitId").data("kendoDropDownList").value();
        var BusinessUnitName = $("#BusinessUnitId").data("kendoDropDownList").text();
        var PcaTaskId = $("#PcaTaskId").data("kendoDropDownList").value();
        var PcaTask = $("#PcaTaskId").data("kendoDropDownList").text();
        var PceId = $("#PceId").val();
        var PcaId = $("#PcaId").val();

        e.model.set("TransactionDate", TransactionDate)
        e.model.set("JobId", JobId);
        e.model.set("BusinessUnitId", BusinessUnitId);
        e.model.set("PcaTaskId", PcaTaskId);
        e.model.set("PceId", PceId);
        e.model.set("PcaId", PcaId);

        if (JobId != "") e.model.set("JobName", Jobname);
        if (BusinessUnitId != "") e.model.set("BusinessUnitName", BusinessUnitName);
        if (PcaTaskId != "") e.model.set("PcaTask", PcaTask);

        Balance();
    }

    var taskId = "";
    function edit_event(e) {
        Condition(e.model.Condition); 
        $("#PcaId").val(e.model.PcaId);
        if ($("#JobId").data("kendoDropDownList").value() == "") {
            $("#BusinessUnitId").data("kendoDropDownList").readonly(false);
            $("#PcaTaskId").removeAttr("required");
        } else {
            $("#PcaTaskId").data("kendoDropDownList").dataSource.read();
            $("#BusinessUnitId").data("kendoDropDownList").readonly();
            $("#PcaTaskId").attr("required", "required");
            taskId = e.model.PcaTaskId;
            //$('#PcaTaskId').data("kendoNumericTextBox").value(e.model.PcaTaskId);
        }
    }

    function currency_select(e) {
        if (e.dataItem) {
            if (e.dataItem.Value == "@PhoenixERPWebApp.Models.CurrencyIDR.CurrencyId") {
                $("#ExchangeRate").data("kendoNumericTextBox").readonly();
                $('#ExchangeRate').data("kendoNumericTextBox").value(1);
            } else {
                $("#ExchangeRate").data("kendoNumericTextBox").readonly(false);
                $('#ExchangeRate').data("kendoNumericTextBox").value(0);
            }
        }
    }

    function Condition_Select(e) {
        if (e.dataItem) {
            Condition(e.dataItem.Value);
            if (e.dataItem.Value == "Debit") {                
                $('#Credit').data("kendoNumericTextBox").value(0);
            } else {
                $('#Debit').data("kendoNumericTextBox").value(0);
            }
        }
    }

    function Condition(value){
        var isReadOnly = (value == "Debit");
        $("#Debit").data("kendoNumericTextBox").readonly(!isReadOnly);
        $("#Credit").data("kendoNumericTextBox").readonly(isReadOnly);
    }

    function Balance() { 
        var models = $("#grid").data("kendoGrid").dataSource.data();
        var totalDebit = 0;
        var totalCredit = 0;

        $.each(models, function (index, data) { 
            if (data.Debit != null) {
                totalDebit += data.Debit;
            }
            if (data.Credit != null) {
                totalCredit += data.Credit;
            } 
        });
        var balance = (totalCredit == totalDebit);
        if (balance) {
            $("#lblBalance").html("<span style='color:green;'>Balance</span>");
        } else {
            $("#lblBalance").html("<span style='color:red;'>Not Balance</span>");
        }
        return balance;
    }
        
    function JobIdOnChange() {
        if($("#JobId").data("kendoDropDownList").value()==""){
            $("#BusinessUnitId").data("kendoDropDownList").readonly(false);
            $("#PcaTaskId").removeAttr("required");
            $("#PceId").val("");
            $("#PcaId").val("");
            $("#BusinessUnitId").data("kendoDropDownList").value("");
            $("#PcaTaskId").data("kendoDropDownList").dataSource.read();
        }else{
            $.ajax({
                type: "GET",
                dataType: "json",
                contentType: "application/x-www-form-urlencoded",
                async: false,
                data: { jobId: $("#JobId").data("kendoDropDownList").value() },
                url: '@Url.Action("GetInfoPceByJobId", "pettycash")',
                success: function (result) {
                    if (result != undefined) {
                        $("#PceId").val(result.JobPeId);
                        $("#PcaId").val(result.JobPaId);
                        $("#BusinessUnitId").data("kendoDropDownList").value(result.BusinessUnitDivisionId); 
                        $("#PcaTaskId").data("kendoDropDownList").dataSource.read();
                        $("#BusinessUnitId").data("kendoDropDownList").readonly();
                        $("#PcaTaskId").attr("required", "required");
                    }
                }
            })
        }
    }
    
    function pca_param() {
        return { pcaId: $("#PcaId").val() };
    } 

    function task_bound(e) {
        this.value(taskId);
    }
    
    function sumDebit() {
        var models = $("#grid").data("kendoGrid").dataSource.data();
        var result = 0;

        $.each(models, function (index, data) {
            if (data.Debit != null) {
                result += data.Debit;
            }
        });
        return result;
    }

    function sumCredit() {
        var models = $("#grid").data("kendoGrid").dataSource.data();
        var result = 0;

        $.each(models, function (index, data) {
            if (data.Credit != null) {
                result += data.Credit;
            }
        });
        return result;
    }
</script>