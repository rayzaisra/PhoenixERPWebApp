@{
    ViewData["Title"] = "Setting Journal Account Salary Payment Request";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto"> 
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                       <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Master Data</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">Setting Journal Account Salary Payment Request</li> 
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">Setting Journal Account Salary Payment Request</h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formMasterAccountSalaryPaymentRequest" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="MasterAccountSalaryPaymentRequest" asp-area="Finance">  
                        <div class="row ">
                            <div class="col-lg-12">
                                @*<div class="alert m-alert--default" role="alert">
                                    <span>Define control petty cash account to be deliver to payment request. </span>
                                </div>*@
                                @(Html.Kendo().Grid<PhoenixERPWebApp.Models.MapCoaTransaksi>()
                                    .Name("grid")
                                    .Columns(columns =>
                                    {
                                        columns.Command(command =>
                                        {
                                            command.Edit().Text(" ").UpdateText(" ").CancelText(" ");
                                        }).Title("Action").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(60);
                                        columns.Bound(p => p.Description).EditorTemplateName("StringReadOnly").Width(150);
                                        columns.Bound(p => p.CoaId).EditorTemplateName("Finance/MasterJournal/CoaIdDropdown").ClientTemplate("#if(CoaId!=null){# #=AccountName# #}#").Width(250);
                                        columns.Bound(p => p.CodeRec).EditorTemplateName("StringReadOnly").Width(100);
                                        columns.Bound(p => p.DK).EditorTemplateName("Finance/MasterJournal/ConditionDropdown").ClientTemplate("#=Condition#").Width(100);
                                        //columns.Bound(p => p.IsAsf).ClientTemplate("#=ASFName#").Width(100).Hidden();
                                    })
                                    .Editable(x => x.Mode(GridEditMode.InLine).DisplayDeleteConfirmation(true))
                                    .DataSource(dataSource => dataSource
                                        .Ajax()
                                        .Events(events => events.Error("errorHandler"))
                                        .Model(model =>
                                        {
                                            model.Id(p => p.Id);
                                        })
                                        .Read(read => read.Action("Read", "MasterAccountSalaryPaymentRequest"))
                                        .Update(update => update.Action("Update", "MasterAccountSalaryPaymentRequest"))
                                    )
                                    .Events(e => e.Save("save_event"))
                                    .NoRecords()
                                )
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="pull-right">
                                    <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                                    <a asp-action="index" asp-controller="MasterAccountSalaryPaymentRequest" asp-area="finance" class="fakelink btn btn-secondary">Close</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>    
    function save_event(e) {
        var CoaId = $("#CoaId").data("kendoDropDownList").value();
        var AccountName = $("#CoaId").data("kendoDropDownList").text();
        var CodeRec = $("#CodeRec").val();
        var Condition = $("#DK").data("kendoDropDownList").value();

        e.model.set("CoaId", CoaId);
        e.model.set("CodeRec", CodeRec);
        e.model.set("AccountName", AccountName);
        e.model.set("DK", Condition);
    }
        
    function CoaId_Select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;

            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });
            
            $.ajax({
                type: "GET",
                url: '@Url.Action("Get", "ChartOfAccount")',
                data: { id: dataItem.Value },
                success: function (result) {
                    if (result != undefined) {
                        $("#CodeRec").val(result.CodeRec);
                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    console.log(e)
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
            }, 2e3));
        }
    }

    $('#btn-save').click(function () {
        $("#grid").data("kendoGrid").saveRow();
        if (!isValid()) return;
        callAction({ formId: "formMasterAccountSalaryPaymentRequest", title: "save", type: "POST", url: '@Url.Action("submit", "MasterAccountSalaryPaymentRequest")', objects: result()});
    });

    function isValid() {
        var valid = $("#formMasterAccountSalaryPaymentRequest").validate().form();
        if (valid) {
            var grid = $("#grid").data("kendoGrid").dataSource.data();
            var isNotCoaId = false;
            $.each(grid, function (index, data) {
                if (data.CoaId == null) {
                    isNotCoaId = true;
                    return false;
                }
            });

            if (isNotCoaId == true) {
                swal('Warning', "Please fill in all the Account Name (Level 5 COA) in the list", 'warning');
                return false;
            }

            return true;
        } else {
            return false;
        }
    }

    function result() { 
        var grid = $("#grid").data("kendoGrid"); 
        var dataList = {
            model: grid.dataSource.data()
        }

        return dataList;
    }
</script>