                                                                        .HtmlAttributes(new {
                                                                            style = "width:100%",
                                                                            maxlength = 50,
                                                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.Instagram)}"
                                                                        }
                                                                     ))
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="pull-right">
                                    <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                                    <a asp-action="index" asp-controller="masterclient" asp-area="finance" class="fakelink btn btn-secondary">Close</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        readonly($('#IsFromOfficeAddress').is(":checked"));

        var ImageTaxScanName = '@Model.ImageTaxScanName';
        if (ImageTaxScanName == '') {
            ImageTaxScan();
        } else {
            $("#linkImageTaxScanDownloadFile").text(ImageTaxScanName);
         }

        var ImageLegalScanName = '@Model.ImageLegalScanName';
        if (ImageLegalScanName == '') {
            ImageLegalScan();
        } else {
            $("#linkImageLegalScanDownloadFile").text(ImageLegalScanName);
        }
    });
    
    function removeImageTaxScan() {
        ImageTaxScan();
    }

    function downloadImageTaxScan() {
        downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download" })', data: { id: $("#ImageTaxScan").val() }});
    }

    function ImageTaxScan() {
        $("#linkImageTaxScanDownloadFile").empty();
        $("#linkImageTaxScanRemoveFile").empty();
        $("#divImageTaxScan").empty().append("<input name='fileImageTaxScan' id='fileImageTaxScan' type='file'/>");

        $("#fileImageTaxScan").kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".jpg", ".png", ".gif", ".doc", ".pdf", ".docx"]
            }
        });
    }
    
    function removeImageLegalScan() {
        ImageLegalScan();
    }

    function downloadImageLegalScan() {
        downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download" })', data: { id: $("#ImageLegalScan").val() }});
    }

    function ImageLegalScan() {
        $("#linkImageLegalScanDownloadFile").empty();
        $("#linkImageLegalScanRemoveFile").empty();
        $("#divImageLegalScan").empty().append("<input name='fileImageLegalScan' id='fileImageLegalScan' type='file'/>");

        $("#fileImageLegalScan").kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".jpg", ".png", ".gif", ".doc", ".pdf", ".docx"]
            }
        });
    }

    function officeProvince_params() {
        return {
            CountryId: $("#OfficeCountryId").val()
        }
    }

    function officeCity_params() {
        return {
            ProvinceId: $("#OfficeProvinceId").val()
        }
    }

    function billingProvince_params() {

        return {
            CountryId: $("#BillingCountryId").val()
        }
    }

    function billingCity_params() {
        return {
            ProvinceId: $("#BillingProvinceId").val()
        }
    }

    $('#btn-save').click(function () {
        callActionFile({ formId:"formmasterclient", title: "save", type:"POST"});
    });
    
    function bank_selectEvent(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;

            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });
            
            $.ajax({
                type: "GET",
                url: '@Url.Action("Get", "Bank")',
                data: { id: dataItem.Value },
                success: function (result) {
                    if (result != undefined) {
                        $("#AccountNumber").val(result.AccountNumber);
                    } else {
                        $("#AccountNumber").val("");
                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    console.log(e)
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
            }, 2e3));
        }
    }

    $('#IsFromOfficeAddress').change(function () {
        var checked = this.checked;
        readonly(checked);

        if (checked) {
            var countryId = $("#OfficeCountryId").data("kendoDropDownList").value();
            var provinceId = $("#OfficeProvinceId").data("kendoDropDownList").value();
            var cityId = $("#OfficeCityId").data("kendoDropDownList").value();
            var address = $("#OfficeAddress").val();
            var zipCode = $("#OfficeZipCode").val();

            $("#BillingCountryId").data("kendoDropDownList").value(countryId);
            $("#BillingProvinceId").data("kendoDropDownList").value(provinceId);
            $("#BillingCityId").data("kendoDropDownList").value(cityId);
            $("#BillingAddress").val(address);
            $("#BillingZipCode").val(zipCode);
        }
    });

    function readonly(checked){
        $("#BillingCountryId").data("kendoDropDownList").readonly(checked);
        $("#BillingProvinceId").data("kendoDropDownList").readonly(checked);
        $("#BillingCityId").data("kendoDropDownList").readonly(checked)

        if (checked) {
            $("#BillingAddress").attr("readonly", "readonly");
            $("#BillingZipCode").attr("readonly", "readonly");
        } else {
            $("#BillingAddress").removeAttr("readonly", "readonly");
            $("#BillingZipCode").removeAttr("readonly", "readonly");
        }
    }

    function BillingProvince_databound(e) {
        $("#BillingProvinceId").data("kendoDropDownList").readonly($('#IsFromOfficeAddress').is(":checked"));
    }

    function BillingCity_databound(e) {
        $("#BillingCityId").data("kendoDropDownList").readonly($('#IsFromOfficeAddress').is(":checked"));
    }
</script>