@model PhoenixERPWebApp.Models.MasterMonthlyBudgetSpread
@{
    ViewData["Title"] = "Master Monthly Budget Spread";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">Master Monthly Budget Spread</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Master Data</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="mastermonthlybudgetspread" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Master Monthly Budget Spread</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="mastermonthlybudgetspread" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="mastermonthlybudgetspread" asp-area="finance" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">@ViewBag.Header Master Monthly Budget Spread</h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formMasterMonthlyBudgetSpread" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="mastermonthlybudgetspread" asp-area="Finance">
                        @*enctype="multipart/form-data"*@
                        <div class="row ">
                            <div class="col-lg-12">
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" asp-for="CreatedBy" />
                                <input type="hidden" asp-for="ModifiedBy" />
                                <input type="hidden" asp-for="ModifiedOn" />
                                <input type="hidden" asp-for="ApprovedBy" />
                                <input type="hidden" asp-for="ApprovedOn" />
                                <input type="hidden" asp-for="DeletedBy" />
                                <input type="hidden" asp-for="DeletedOn" />
                                <input type="hidden" asp-for="IsActive" />
                                <input type="hidden" asp-for="IsLocked" />
                                <input type="hidden" asp-for="IsDefault" />
                                <input type="hidden" asp-for="IsDeleted" />
                                <input type="hidden" asp-for="OwnerId" />

                                <div class="row m-row--col-separator-xl">
                                    <div class="col-lg-4">
                                        <div class="form-group">
                                            <label asp-for="Id"></label> <span class="req">*</span>  :
                                            @(Html.Kendo().TextBoxFor(m => m.Id)
                                            .HtmlAttributes(new
                                            {
                                                style = "width:100%",
                                                maxlength = 50,
                                                @readonly = "readonly",
                                                placeholder = $"Auto generated by system"
                                            }
                                            ))
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="form-group">
                                            <label asp-for="MasterMonthlyBudgetName"></label> <span class="req">*</span>  :
                                            @(Html.Kendo().TextBoxFor(m => m.MasterMonthlyBudgetName)
                                            .HtmlAttributes(new
                                            {
                                                style = "width:100%",
                                                maxlength = 50,
                                                placeholder = $"Input type a {Html.DisplayNameFor(m => m.MasterMonthlyBudgetName)}",
                                                required = "required",
                                                validationmessage = $"{Html.DisplayNameFor(m => m.MasterMonthlyBudgetName)} is required"
                                            }
                                            ))
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="form-group">
                                            <label>Create Date</label>  :
                                            @(Html.Kendo().DatePickerFor(m => m.CreatedOn)
                                            .HtmlAttributes(new
                                            {
                                                style = "width:100%",
                                                @readonly = "readonly",
                                                placeholder = $"Auto generated by system",
                                                onkeydown = "javascript:return false;"
                                            })
                                            .Format("dd MMMM yyyy"))
                                        </div>
                                    </div>
                                </div>
                                <br /> 
                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <td class="text-center"><label>Month</label></td>
                                                <td class="text-center"><label>Percentage</label></td>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>January</td>
                                                <td>
                                                    @Html.Kendo().NumericTextBoxFor(x => x.PercentageMonth1).Format("##.## \\%").Min(0).Max(100).Spinners(false).Events(evt=>evt.Change("calculate_change")).HtmlAttributes(new { style = "width:100%", @required = "required" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>February</td>
                                                <td>
                                                    @Html.Kendo().NumericTextBoxFor(x => x.PercentageMonth2).Format("##.## \\%").Min(0).Max(100).Spinners(false).Events(evt=>evt.Change("calculate_change")).HtmlAttributes(new { style = "width:100%", @required = "required" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>March</td>
                                                <td>
                                                    @Html.Kendo().NumericTextBoxFor(x => x.PercentageMonth3).Format("##.## \\%").Min(0).Max(100).Spinners(false).Events(evt=>evt.Change("calculate_change")).HtmlAttributes(new { style = "width:100%", @required = "required" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>April</td>
                                                <td>
                                                    @Html.Kendo().NumericTextBoxFor(x => x.PercentageMonth4).Format("##.## \\%").Min(0).Max(100).Spinners(false).Events(evt=>evt.Change("calculate_change")).HtmlAttributes(new { style = "width:100%", @required = "required" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>May</td>
                                                <td>
                                                    @Html.Kendo().NumericTextBoxFor(x => x.PercentageMonth5).Format("##.## \\%").Min(0).Max(100).Spinners(false).Events(evt=>evt.Change("calculate_change")).HtmlAttributes(new { style = "width:100%", @required = "required" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>June</td>
                                                <td>
                                                    @Html.Kendo().NumericTextBoxFor(x => x.PercentageMonth6).Format("##.## \\%").Min(0).Max(100).Spinners(false).Events(evt=>evt.Change("calculate_change")).HtmlAttributes(new { style = "width:100%", @required = "required" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>July</td>
                                                <td>
                                                    @Html.Kendo().NumericTextBoxFor(x => x.PercentageMonth7).Format("##.## \\%").Min(0).Max(100).Spinners(false).Events(evt=>evt.Change("calculate_change")).HtmlAttributes(new { style = "width:100%", @required = "required" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>August</td>
                                                <td>
                                                    @Html.Kendo().NumericTextBoxFor(x => x.PercentageMonth8).Format("##.## \\%").Min(0).Max(100).Spinners(false).Events(evt=>evt.Change("calculate_change")).HtmlAttributes(new { style = "width:100%", @required = "required" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>September</td>
                                                <td>
                                                    @Html.Kendo().NumericTextBoxFor(x => x.PercentageMonth9).Format("##.## \\%").Min(0).Max(100).Spinners(false).Events(evt=>evt.Change("calculate_change")).HtmlAttributes(new { style = "width:100%", @required = "required" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>October</td>
                                                <td>
                                                    @Html.Kendo().NumericTextBoxFor(x => x.PercentageMonth10).Format("##.## \\%").Min(0).Max(100).Spinners(false).Events(evt=>evt.Change("calculate_change")).HtmlAttributes(new { style = "width:100%", @required = "required" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>November</td>
                                                <td>
                                                    @Html.Kendo().NumericTextBoxFor(x => x.PercentageMonth11).Format("##.## \\%").Min(0).Max(100).Spinners(false).Events(evt=>evt.Change("calculate_change")).HtmlAttributes(new { style = "width:100%", @required = "required" })
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>December</td>
                                                <td>
                                                    @Html.Kendo().NumericTextBoxFor(x => x.PercentageMonth12).Format("##.## \\%").Min(0).Max(100).Spinners(false).Events(evt=>evt.Change("calculate_change")).HtmlAttributes(new { style = "width:100%", @required = "required" })
                                                </td>
                                            </tr>
                                            <tr style="font-weight:bold;">
                                                <td><label asp-for="TotalBudgetSpread"></label></td>
                                                <td>
                                                    @(Html.Kendo().NumericTextBoxFor(x => x.TotalBudgetSpread)
                                                        .Spinners(false).Events(evt=>evt.Change("calculate_change"))
                                                        .Format("##.## \\%")
                                                        .HtmlAttributes(new
                                                        {
                                                            style = "width:100%",
                                                            @readonly = "readonly"
                                                        }
                                                    ))
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div> 
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="pull-right">
                                    <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                                    <a asp-action="index" asp-controller="mastermonthlybudgetspread" asp-area="finance" class="fakelink btn btn-secondary">Close</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $('#btn-save').click(function () {
        if (!isValid()) return;
        callAction({ formId: "formMasterMonthlyBudgetSpread", title: "save", type: "POST" });
    });

    function isValid() {
        var valid = $("#formMasterMonthlyBudgetSpread").validate().form();
        if (valid) {
            var totalCost = $("#TotalBudgetSpread").data("kendoNumericTextBox").value();
            if (totalCost != 100) {
                swal('Warning', "The total budget spread must be 100%", 'warning');
                return false;
            }

            return true;
        } else {
            return false;
        }
    }

    function calculate_change(e) {
        var percent1 = $("#PercentageMonth1").data("kendoNumericTextBox").value();
        var percent2 = $("#PercentageMonth2").data("kendoNumericTextBox").value();
        var percent3 = $("#PercentageMonth3").data("kendoNumericTextBox").value();
        var percent4 = $("#PercentageMonth4").data("kendoNumericTextBox").value();
        var percent5 = $("#PercentageMonth5").data("kendoNumericTextBox").value();
        var percent6 = $("#PercentageMonth6").data("kendoNumericTextBox").value();
        var percent7 = $("#PercentageMonth7").data("kendoNumericTextBox").value();
        var percent8 = $("#PercentageMonth8").data("kendoNumericTextBox").value();
        var percent9 = $("#PercentageMonth9").data("kendoNumericTextBox").value();
        var percent10 = $("#PercentageMonth10").data("kendoNumericTextBox").value();
        var percent11 = $("#PercentageMonth11").data("kendoNumericTextBox").value();
        var percent12 = $("#PercentageMonth12").data("kendoNumericTextBox").value();
        var total = percent1 + percent2 + percent3 + percent4 + percent5 + percent6 + percent7 + percent8 + percent9 + percent10 + percent11 + percent12;
        $("#TotalBudgetSpread").data("kendoNumericTextBox").value(total);//Math.round(total)
    }
</script>