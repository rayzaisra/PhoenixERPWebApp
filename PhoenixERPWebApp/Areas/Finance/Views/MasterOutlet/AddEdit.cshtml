@model PhoenixERPWebApp.Models.MasterOutlet
@{
    ViewData["Title"] = "Master Outlet";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">Master Outlet</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                       <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Master Data</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="masteroutlet" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Master Outlet</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                     @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="masteroutlet" asp-area="finance"  class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="masteroutlet" asp-area="finance"  asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">@ViewBag.Header Master Outlet</h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formMasterOutlet" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="masteroutlet" asp-area="Finance">
                        @*enctype="multipart/form-data"*@
                        <div class="row ">
                            <div class="col-lg-12">
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" asp-for="CreatedBy" />
                                <input type="hidden" asp-for="CreatedOn" />
                                <input type="hidden" asp-for="ModifiedBy" />
                                <input type="hidden" asp-for="ModifiedOn" />
                                <input type="hidden" asp-for="ApprovedBy" />
                                <input type="hidden" asp-for="ApprovedOn" />
                                <input type="hidden" asp-for="DeletedBy" />
                                <input type="hidden" asp-for="DeletedOn" />
                                <input type="hidden" asp-for="IsActive" />
                                <input type="hidden" asp-for="IsLocked" />
                                <input type="hidden" asp-for="IsDefault" />
                                <input type="hidden" asp-for="IsDeleted" />
                                <input type="hidden" asp-for="OwnerId" />
                                  
                                <div class="row m-row--col-separator-xl">
                                    <div class="col-lg-4">
                                         <div class="form-group">
                                            <label asp-for="ClientId"></label> <span class="req">*</span>  :
                                             @(Html.Kendo().DropDownListFor(x => x.ClientId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.ClientId)}")
                                                .HtmlAttributes(new {
                                                    style = "width:100%;",                                              
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.ClientId)} is required" 
                                                })
                                                .Filter(FilterType.Contains)
                                                .DataSource(source => source
                                                    .Custom()
                                                    .Transport(transport => transport
                                                    .Read(read =>
                                                    {
                                                        read.Action("GetDDLClientList", "Dropdown",new {area="finance"});
                                                     }))
                                                    .ServerFiltering(false)
                                                )
                                            )
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="OutletName"></label> <span class="req">*</span>  :
                                            @(Html.Kendo().TextBoxFor(m => m.OutletName)
                                                .HtmlAttributes(new {
                                                    style = "width:100%",
                                                    maxlength = 50,
                                                    placeholder = $"Input type a {Html.DisplayNameFor(m => m.OutletName)}",
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.OutletName)} is required" 
                                                }
                                             ))
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="TypeOutlet"></label> <span class="req">*</span>  :
                                            @(Html.Kendo().TextBoxFor(m => m.TypeOutlet)
                                                .HtmlAttributes(new {
                                                    style = "width:100%",
                                                    maxlength = 50,
                                                    placeholder = $"Input type a {Html.DisplayNameFor(m => m.TypeOutlet)}",
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.TypeOutlet)} is required" 
                                                }
                                             ))
                                        </div>
                                         <div class="form-group">
                                               <label asp-for="Address"></label> :
                                               @Html.TextAreaFor(m => m.Address, new { style = "height:100px; width:100%;", @placeholder = $"Input type a {Html.DisplayNameFor(m => m.Address)}" })
                                       </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="form-group">
                                            <label asp-for="CountryId"></label> <span class="req">*</span>  :
                                             @(Html.Kendo().DropDownListFor(x => x.CountryId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.CountryId)}")
                                                .HtmlAttributes(new {
                                                    style = "width:100%;",                                              
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.CountryId)} is required" 
                                                                                            })
                                                .Filter(FilterType.Contains)
                                                .DataSource(source => source
                                                    .Custom()
                                                    .Transport(transport => transport
                                                    .Read(read =>
                                                    {
                                                        read.Action("GetDDLCountry", "Dropdown",new {area="finance"});
                                                     }))
                                                    .ServerFiltering(false)
                                                )
                                            )
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="ProvinceId"></label> <span class="req">*</span>  :
                                             @(Html.Kendo().DropDownListFor(x => x.ProvinceId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.ProvinceId)}")
                                                .HtmlAttributes(new {
                                                    style = "width:100%;",                                              
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.ProvinceId)} is required" 
                                                                                            })
                                                .Filter(FilterType.Contains)
                                                .DataSource(source => source
                                                    .Custom()
                                                    .Transport(transport => transport
                                                    .Read(read =>
                                                    {
                                                        read.Action("GetDDLProvince", "Dropdown",new {area="finance"}).Data("Province_params");
                                                     }))
                                                    .ServerFiltering(true)
                                                ).CascadeFrom("CountryId")
                                            )
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="CityId"></label> <span class="req">*</span>  :
                                             @(Html.Kendo().DropDownListFor(x => x.CityId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.CityId)}")
                                                .HtmlAttributes(new {
                                                    style = "width:100%;",                                              
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.CityId)} is required" 
                                                                                            })
                                                .Filter(FilterType.Contains)
                                                .DataSource(source => source
                                                    .Custom()
                                                    .Transport(transport => transport
                                                    .Read(read =>
                                                    {
                                                        read.Action("GetDDLCity", "Dropdown",new {area="finance"}).Data("City_params");
                                                     }))
                                                    .ServerFiltering(true)
                                                ).CascadeFrom("ProvinceId")
                                            )
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="ZipCode"></label> <span class="req">*</span>  :
                                            @(Html.Kendo().TextBoxFor(m => m.ZipCode)
                                                .HtmlAttributes(new
                                                {
                                                    style = "width:100%",
                                                    maxlength = 5,
                                                    placeholder = $"Input type a {Html.DisplayNameFor(m => m.ZipCode)}",
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.ZipCode)} is required"
                                                }
                                                ))
                                        </div>
                                    </div> 
                                    <div class="col-lg-4">
                                        <div class="form-group">
                                            <label asp-for="PicName"></label> <span class="req">*</span>  :
                                            @(Html.Kendo().TextBoxFor(m => m.PicName)
                                                .HtmlAttributes(new {
                                                    style = "width:100%",
                                                    maxlength = 50,
                                                    placeholder = $"Input type a {Html.DisplayNameFor(m => m.PicName)}",
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.PicName)} is required" 
                                                }
                                                ))
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="Phone"></label> <span class="req">*</span>  :
                                            @(Html.Kendo().TextBoxFor(m => m.Phone)
                                            .HtmlAttributes(new {
                                                style = "width:100%",
                                                maxlength = 50,
                                                placeholder = $"Input type a {Html.DisplayNameFor(m => m.Phone)}",
                                                required = "required",
                                                validationmessage = $"{Html.DisplayNameFor(m => m.Phone)} is required" 
                                            }
                                            ))
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="MobilePhone"></label> <span class="req">*</span>  :
                                            @(Html.Kendo().TextBoxFor(m => m.MobilePhone)
                                                .HtmlAttributes(new {
                                                    style = "width:100%",
                                                    maxlength = 50,
                                                    placeholder = $"Input type a {Html.DisplayNameFor(m => m.MobilePhone)}",
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.MobilePhone)} is required" 
                                                }
                                             ))
                                        </div>                                                                  
                                    </div>
                                </div>
                               <br/>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="pull-right">
                                    <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                                    <a asp-action="index" asp-controller="masteroutlet" asp-area="finance" class="fakelink btn btn-secondary">Close</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function Province_params() {
        return {
            CountryId: $("#CountryId").val()
        }
    }

    function City_params() {
        return {
            ProvinceId: $("#ProvinceId").val()
        }
    }
    $('#btn-save').click(function () {
        callAction({ formId:"formMasterOutlet", title: "save", type:"POST"});
    });
</script>