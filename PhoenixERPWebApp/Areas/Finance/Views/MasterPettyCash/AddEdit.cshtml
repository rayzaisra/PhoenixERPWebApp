@model PhoenixERPWebApp.Models.MasterPettyCash
@{
    ViewData["Title"] = "Master Petty Cash";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Master Petty Cash</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Master Data</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="masterpettycash" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Master Petty Cash</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="masterpettycash" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="masterpettycash" asp-area="finance" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div>
                                @ViewBag.Header
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formMasterPettyCash" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="masterpettycash" asp-area="finance">
                        @*enctype="multipart/form-data"*@
                        <div class="row ">
                            <div class="col-lg-12"> 
                                <input type="hidden" asp-for="CreatedBy" />
                                <input type="hidden" asp-for="ModifiedBy" />
                                <input type="hidden" asp-for="ModifiedOn" />
                                <input type="hidden" asp-for="ApprovedBy" />
                                <input type="hidden" asp-for="ApprovedOn" />
                                <input type="hidden" asp-for="DeletedBy" />
                                <input type="hidden" asp-for="DeletedOn" />
                                <input type="hidden" asp-for="IsActive" />
                                <input type="hidden" asp-for="IsLocked" />
                                <input type="hidden" asp-for="IsDefault" />
                                <input type="hidden" asp-for="IsDeleted" />
                                <input type="hidden" asp-for="OwnerId" />  
                                <input type="hidden" asp-for="AmountInsused" /> 
                                <input type="hidden" asp-for="Balance" /> 

                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label asp-for="Id"></label> :
                                            @(Html.Kendo().TextBoxFor(m => m.Id)
                                                .HtmlAttributes(new
                                                {
                                                    style = "width:100%",
                                                    maxlength = 50,
                                                    placeholder = "Auto Generated",
                                                    @readonly = "readonly"
                                                }
                                            ))
                                        </div>
                                        @*<div class="form-group">
                                            <label asp-for="BankId"></label><span class="req">*</span>
                                            @(Html.Kendo().DropDownListFor(i => i.BankId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Filter(FilterType.Contains)
                                                .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.BankId)}")
                                                .HtmlAttributes(new { style = "width:100%;", required = "required" })
                                                .DataSource(source => source
                                                    .Custom()
                                                    .Transport(transport => transport
                                                    .Read(read =>
                                                    {
                                                        read.Action("GetDDLBanksList", "Dropdown", new { area = "Finance" });
                                                    }))
                                                    .ServerFiltering(false)
                                                ))
                                        </div>*@
                                        <div class="form-group">
                                            <label asp-for="BankAccountName"></label> <span class="req">*</span>  :
                                            @(Html.Kendo().TextBoxFor(m => m.BankAccountName)
                                                .HtmlAttributes(new
                                                {
                                                    style = "width:100%",
                                                    maxlength = 50,
                                                    placeholder = $"{Html.DisplayNameFor(m => m.BankAccountName)}",
                                                    required = "required"
                                                }
                                            ))
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="BankAccountNumber"></label> <span class="req">*</span>  :
                                            @(Html.Kendo().TextBoxFor(m => m.BankAccountNumber)
                                                .HtmlAttributes(new
                                                {
                                                    style = "width:100%",
                                                    maxlength = 50,
                                                    placeholder = $"{Html.DisplayNameFor(m => m.BankAccountNumber)}",
                                                    required = "required"
                                                }
                                            ))
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="HolderUserId"></label><span class="req">*</span>
                                            @(Html.Kendo().DropDownListFor(i => i.HolderUserId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Filter(FilterType.Contains)
                                                .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.HolderUserId)}")
                                                .HtmlAttributes(new { style = "width:100%;", required = "required" })
                                                .DataSource(source => source
                                                    .Custom()
                                                    .Transport(transport => transport
                                                    .Read(read =>
                                                    {
                                                        read.Action("GetEmployee", "Dropdown", new { area = "Finance" });
                                                    }))
                                                    .ServerFiltering(false)
                                                ))
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label asp-for="CreatedOn"></label>
                                            @Html.Kendo().DatePickerFor(m => m.CreatedOn).HtmlAttributes(new {
                                                @class = "m-input ", style = "width:100%", @readonly = "readonly"
                                            })
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="LegalEntityId"></label><span class="req">*</span>
                                            @(Html.Kendo().DropDownListFor(i => i.LegalEntityId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Filter(FilterType.Contains)
                                                .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.LegalEntityId)}")
                                                .HtmlAttributes(new { style = "width:100%;", required = "required" })
                                                .DataSource(source => source
                                                    .Custom()
                                                    .Transport(transport => transport
                                                    .Read(read =>
                                                    {
                                                        read.Action("GetLegalEntity", "Dropdown", new { area = "Finance" });
                                                    }))
                                                    .ServerFiltering(false)
                                                ))
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="CurrencyId"></label> <span class="req">*</span>  :
                                            @(Html.Kendo().DropDownListFor(i => i.CurrencyId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Filter(FilterType.Contains)
                                                .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.CurrencyId)}")
                                                .HtmlAttributes(new { style = "width:100%;", required = "required" })
                                                .DataSource(source => source
                                                    .Custom()
                                                    .Transport(transport => transport
                                                    .Read(read =>
                                                    {
                                                        read.Action("GetDDLCurrency", "Dropdown", new { area = "Finance" });
                                                    }))
                                                    .ServerFiltering(false)
                                                ))
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="DelegateUserId"></label><span class="req">*</span>
                                            @(Html.Kendo().DropDownListFor(i => i.DelegateUserId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Filter(FilterType.Contains)
                                                .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.DelegateUserId)}")
                                                .HtmlAttributes(new { style = "width:100%;", required = "required" })
                                                .DataSource(source => source
                                                    .Custom()
                                                    .Transport(transport => transport
                                                    .Read(read =>
                                                    {
                                                        read.Action("GetEmployee", "Dropdown", new { area = "Finance" });
                                                    }))
                                                    .ServerFiltering(false)
                                                ))
                                        </div>
                                    </div>
                                </div>
                                <br />
                                <div class="alert m-alert--default"> Chart Of Account Configuration </div>
                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <td class="text-center"><label>Description</label></td>
                                                <td class="text-center"><label asp-for="ChartAccountName"></label></td>
                                                <td><label asp-for="ChartAccountNumber"></label></td>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Asset Setting</td>
                                                <td>
                                                    @(Html.Kendo().DropDownListFor(x => x.ChartAccountId)
                                                        .DataTextField("Text")
                                                        .DataValueField("Value")
                                                        .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.ChartAccountId)}")
                                                        .HtmlAttributes(new { style = "width:100%;", required = "required" })
                                                        .Height(250)
                                                        .Filter(FilterType.Contains)
                                                        .Events(evt => evt.Select("CoaId_Select"))
                                                        .DataSource(source => source
                                                            .Custom()
                                                            .Transport(transport => transport
                                                            .Read(read =>
                                                            {
                                                                read.Action("GetCOAByNameLv5", "Dropdown", new { area = "Finance" });
                                                            }))
                                                        .ServerFiltering(false))
                                                    )
                                                </td>
                                                <td>
                                                    @(Html.Kendo().TextBoxFor(x => x.ChartAccountNumber)
                                                        .HtmlAttributes(new
                                                        {
                                                            style = "width:100%",
                                                            @readonly = "readonly"
                                                        }
                                                    ))
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="pull-right">
                                    <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                                    <a asp-action="index" asp-controller="masterpettycash" asp-area="finance" class="fakelink btn btn-secondary">Close</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(function () {
        var aidi = '@Model.Id';
        if (aidi != "")
            $("#ChartAccountId").data("kendoDropDownList").readonly(true);
    });

    $('#btn-save').click(function () {
        if (!isValid()) return; 
        callAction({ formId: "formMasterPettyCash", title: "save", type: "POST" });
    });

    function isValid() {
        var valid = $("#formMasterPettyCash").validate().form();
        if (valid) {
            if ($("#HolderUserId").data("kendoDropDownList").value() == $("#DelegateUserId").data("kendoDropDownList").value()) {
                swal('Warning', 'Holder Name 1 and Holder Name 2 cannot be the same', 'warning');
                return false;
            }
            return true;
        } else {
            return false;
        }
    }

    function CoaId_Select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;

            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $.ajax({
                type: "GET",
                url: '@Url.Action("Get", "ChartOfAccount")',
                data: { id: dataItem.Value },
                success: function (result) {
                    if (result != undefined) {
                        $("#ChartAccountNumber").val(result.CodeRec);
                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    //swal('Warning', 'Ooops, something went wrong !', 'warning');
                    console.log(e);
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
            }, 2e3));
        }
    }
</script>