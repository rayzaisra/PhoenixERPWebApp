@model PhoenixERPWebApp.Models.Organization
@{
    ViewData["Title"] = "Master Organization";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Master Organization</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Master Data</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="organization" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Master Organization</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                     @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="organization" asp-area="finance"  class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="organization" asp-area="finance"  asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div>
                                @ViewBag.Header
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formOrganization" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="organization" asp-area="Finance">
                        @*enctype="multipart/form-data"*@
                        <div class="row ">
                            <div class="col-lg-12">
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" asp-for="CreatedBy" />
                                <input type="hidden" asp-for="CreatedOn" />
                                <input type="hidden" asp-for="ModifiedBy" />
                                <input type="hidden" asp-for="ModifiedOn" />
                                <input type="hidden" asp-for="ApprovedBy" />
                                <input type="hidden" asp-for="ApprovedOn" />
                                <input type="hidden" asp-for="DeletedBy" />
                                <input type="hidden" asp-for="DeletedOn" />
                                <input type="hidden" asp-for="IsActive" />
                                <input type="hidden" asp-for="IsLocked" />
                                <input type="hidden" asp-for="IsDefault" />
                                <input type="hidden" asp-for="IsDeleted" />
                                <input type="hidden" asp-for="OwnerId" />
  
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="OrganizationName"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().TextBoxFor(m => m.OrganizationName)
                                        .HtmlAttributes(new {
                                            style = "width:100%",
                                            maxlength = 50,
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.OrganizationName)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.OrganizationName)} is required" 
                                        }
                                     ))
                                </div>
                                @*<div class="form-group m-form__group-sub">
                                    <label asp-for="ParentOrganizationId"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().TextBoxFor(m => m.ParentOrganizationId)
                                        .HtmlAttributes(new {
                                            style = "width:100%",
                                            maxlength = 50,
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.ParentOrganizationId)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.ParentOrganizationId)} is required" 
                                        }
                                     ))
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="SmtpServer"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().TextBoxFor(m => m.SmtpServer)
                                        .HtmlAttributes(new {
                                            style = "width:100%",
                                            maxlength = 450,
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.SmtpServer)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.SmtpServer)} is required" 
                                        }
                                     ))
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="SmtpPort"></label> <span class="req">*</span>  :
  
                                     @(Html.Kendo().NumericTextBoxFor(m => m.SmtpPort)
                                        .Spinners(false)
                                        .Format("0")
                                        .Max(2147483647)
                                        .HtmlAttributes(new {
                                            style = "width:100%",
                                            maxlength = 10,
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.SmtpPort)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.SmtpPort)} is required"
                
                                        }))
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="SmtpUsername"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().TextBoxFor(m => m.SmtpUsername)
                                        .HtmlAttributes(new {
                                            style = "width:100%",
                                            maxlength = 450,
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.SmtpUsername)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.SmtpUsername)} is required" 
                                        }
                                     ))
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="SmtpPassword"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().TextBoxFor(m => m.SmtpPassword)
                                        .HtmlAttributes(new {
                                            style = "width:100%",
                                            maxlength = 450,
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.SmtpPassword)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.SmtpPassword)} is required" 
                                        }
                                     ))
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="SmtpFromAddress"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().TextBoxFor(m => m.SmtpFromAddress)
                                        .HtmlAttributes(new {
                                            style = "width:100%",
                                            maxlength = 450,
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.SmtpFromAddress)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.SmtpFromAddress)} is required" 
                                        }
                                     ))
                                </div>*@
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                                <a asp-action="index" asp-controller="organization" asp-area="finance" class="fakelink btn btn-secondary">Close</a>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $('#btn-save').click(function () {
        callAction({ formId:"formOrganization", title: "save", type:"POST"});
    });
</script>