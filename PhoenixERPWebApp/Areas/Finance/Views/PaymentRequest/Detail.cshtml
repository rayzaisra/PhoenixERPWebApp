@model PhoenixERPWebApp.Models.Finance.Transaction.PaymentRequest.PaymentRequestList
@{
    @if (ViewBag.IsBankPayment == true)
    {
        ViewData["Title"] = "Bank Payment Detail";
    }
    else
    {
        ViewData["Title"] = "Payment Request Detail";
    }
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";

        DateTime? EffectiveDate = DateTime.Now;
        DateTime? EndDate = DateTime.Now;
    } 
<style>
    .k-footer-template {
        text-align: right;
    }

    .k-numerictextbox .k-input {
        text-align: right;
        padding-right:10px;
    }
</style>
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">
                @if (ViewBag.IsBankPayment == true)
                {
                    <label>Bank Payment</label>
                }
                else
                {
                    <label>Payment Request</label>
                }
            </h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-suitcase"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (ViewBag.IsBankPayment == true)
                    {
                        <a asp-action="Index" asp-controller="BankPayment" asp-area="Finance" class="m-nav__link"><span class="m-nav__link-text">Bank Payment</span></a>
                    }
                    else
                    {
                        <a asp-action="Index" asp-controller="PaymentRequest" asp-area="Finance" class="m-nav__link"><span class="m-nav__link-text">Payment Request</span></a>
                    }
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (ViewBag.IsBankPayment == true)
                    {
                        <a asp-action="Detail" asp-controller="PaymentRequest" asp-area="Finance" asp-route-Id="@Model.Id"  asp-route-isBankPayment="true" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="Detail" asp-controller="PaymentRequest" asp-area="Finance" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="Detail" asp-controller="PaymentRequest" asp-area="Finance" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

<div class="m-content">
    <div class="row">
        <div class="col-xl-12 col-lg-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            @if (ViewBag.IsBankPayment == true)
                            {
                                <h3 class="m-portlet__head-text m--font-success">Bank Payment</h3>
                            }
                            else
                            {
                                <h3 class="m-portlet__head-text m--font-success">Payment Request</h3>
                            }
                            &nbsp;
                            @if (!string.IsNullOrEmpty(Model.Status))
                            {
                                @if (Model.Status == @PhoenixERPWebApp.Models.PaymentRequestStatus.Open)
                                {<span class="m-badge m-badge--info m-badge--wide" id="status">@Model.StatusDesc</span> }
                            else if (Model.Status == @PhoenixERPWebApp.Models.PaymentRequestStatus.PayBalance)
                            { <span class="m-badge m-badge--focus m-badge--wide" id="status">@Model.StatusDesc</span> }
                        else if (Model.Status == @PhoenixERPWebApp.Models.PaymentRequestStatus.WaitingApproval)
                        { <span class="m-badge m-badge--warning m-badge--wide" id="status">@Model.StatusDesc</span> }
                    else if (Model.Status == @PhoenixERPWebApp.Models.PaymentRequestStatus.Reject)
                    { <span class="m-badge m-badge--danger m-badge--wide" id="status">@Model.StatusDesc</span> }
                    else if (Model.Status == @PhoenixERPWebApp.Models.PaymentRequestStatus.Complete)
                    { <span class="m-badge m-badge--success m-badge--wide" id="status">@Model.StatusDesc</span> }
                    else if (Model.Status == @PhoenixERPWebApp.Models.PaymentRequestStatus.Reconsiliation)
                    { <span class="m-badge m-badge--dark m-badge--wide" id="status">@Model.StatusDesc</span> }
                    else
                    { <span class="m-badge m-badge--info m-badge--wide" id="status">@Model.StatusDesc</span>}
                            }
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
