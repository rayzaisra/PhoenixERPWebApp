    function grid_params() { return { Id: $("#Id").val() };  } 

    function job_params() {
        return {
            status: "@Model.Status",
            jobId : "@Model.Ca_JobId"
        };
    }
                
    function SaveSelectedAP() { 
        var grid = $("#grid-choice-ap").data("kendoGrid");
        var allSelected = grid.select(); 
        if (allSelected.length < 1) {
            swal('Warning', "At Lease Choose 1 AP Id, Please Choose more.", 'error');
            return;
        }

        var rowDataItem = [];
        var isError = false;
        allSelected.each(function (index, row) {
            var dataItem = grid.dataItem(row); 
            var dataAP = $("#grid-multi-pce").data('kendoGrid').dataSource.data()[0];
            var rowItem = rowDataItem[0];
            if (dataAP != null || rowItem != null) {
                var VendorId, BusinessUnitId, LegalEntityId, MainserviceCategoryId, CurrencyId;
                if (dataAP != null) {
                    VendorId = dataAP.VendorId;
                    BusinessUnitId = dataAP.BusinessUnitId;
                    LegalEntityId = dataAP.LegalEntityId;
                    MainserviceCategoryId = dataAP.MainserviceCategoryId;
                    CurrencyId = dataAP.CurrencyId;
                } else if (rowItem != null) {
                    VendorId = rowItem.VendorId;
                    BusinessUnitId = rowItem.BusinessUnitId;
                    LegalEntityId = rowItem.LegalEntityId;
                    MainserviceCategoryId = rowItem.MainserviceCategoryId;
                    CurrencyId = rowItem.CurrencyId;
                }

                if (dataItem.VendorId == VendorId && dataItem.BusinessUnitId == BusinessUnitId && dataItem.LegalEntityId == LegalEntityId &&
                    dataItem.MainserviceCategoryId == MainserviceCategoryId && dataItem.CurrencyId == CurrencyId) {
                    rowDataItem.push(dataItem); 
                } else {
                    isError = true; 
                    swal('Warning', "please choose the same vendor, currency, legal entity, business unit and main service category", 'error');
                    return;
                } 
            } else { 
                var paytoCoaid = $('#PaytoCoaId').data("kendoDropDownList");
                //var coaidPayFrom = $('#AccountId').data("kendoDropDownList");
                var divIdPayFrom = $('#BusinessUnitId').data("kendoDropDownList");

                var PaytoVedor = $('#PayToVendor').data("kendoDropDownList"); // vendor id
                var currencyIdPayfrom = $('#CurrencyId').data("kendoDropDownList");

                //$("#AmountPay").data("kendoNumericTextBox").readonly();
                $("#divpaytobankname").css("display", "block"); 

                divIdPayFrom.value(dataItem.BusinessUnitId);
                PaytoVedor.value(dataItem.VendorId);
                paytoCoaid.value(dataItem.AccountId); 

                @*if (dataItem.MainserviceCategoryId == "@PhoenixERPWebApp.Models.MainServiceCategoryOther.MainServiceCategoryId") {
                    $('#BusinessUnitId').removeAttr("required");
                    $("#reqBusinessUnitId").css("display", "none");
                } else {                    
                    $("#reqBusinessUnitId").css("display", "inline");
                }*@

                $('#BusinessUnitId').val(dataItem.BusinessUnitId);
                if (dataItem.BusinessUnitId !== "") {
                    var BusinessUnitIdDropDownList = $("#BusinessUnitId").data("kendoDropDownList");
                    BusinessUnitIdDropDownList.readonly();
                }; 

                if (currencyIdPayfrom) {
                    currencyIdPayfrom.value(dataItem.CurrencyId);
                    //currencyIdPayfrom.readonly(); 
                };

                $('#PaytoCoaId').val(dataItem.AccountId);
                $('#PayToAccountNumber').val(dataItem.VendorAccountNumber);
                $("#PaytoBankName").val(dataItem.BankAccountDestination);
                $("#MainServiceCategoryId").val(dataItem.MainserviceCategoryId);
                $("#SwiftCode").val(dataItem.SwiftCode);
                $('#PaytoCoaId').removeAttr("required");

                divIdPayFrom.readonly();
                PaytoVedor.readonly();
                paytoCoaid.readonly();


                $("#CurrencyIdDefault").val(dataItem.CurrencyIdDefault);
                $("#CurrencySymbol").val(dataItem.CurrencySymbolDefault);
                $("#CurrencySymbolDefault").val(dataItem.CurrencySymbolDefault);
                DDLCurrencyChange();
                setCurrencyValue();

                rowDataItem.push(dataItem); 
            }
        });

        if (!isError) {
            $.each(rowDataItem, function (i, dataItem) {
                //$("#grid-multi-pce").data('kendoGrid').dataSource.add(dataItem); 
                $("#grid-multi-pce").data('kendoGrid').dataSource.pushCreate(dataItem);
            });
        } 

        CalculateAmount(); 

        $("#PayToType").data("kendoDropDownList").value("3");
        $("#PayToType").data("kendoDropDownList").readonly(true);
        $("#vendoroption").css("display", "block");
        $("#bankoption").css("display", "none");
        $("#pettycashoption").css("display", "none");

        $("#PayToVendor").attr("required", "required");
        $("#PayToPettyCash").removeAttr("required");
        $("#PaytoBank").removeAttr("required");

        if (isError)
            $('#modal-choice-pce').modal('show');
        else
            $('#modal-choice-pce').modal('toggle');
    }
     
    function AddAP(e) {
