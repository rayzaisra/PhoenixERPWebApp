                                    @if (ViewBag.isRequestor == true)
                                    {
                                        @if (Model.Status == "" || string.IsNullOrEmpty(Model.Status) || Model.Status == PhoenixERPWebApp.Models.PaymentRequestStatus.Open || Model.isAdvancePayment == true)
                                        {
                                            <button type="button" id="btnSave" class="btn btn-success">Save</button>
                                        }
                                        <button type="button" id="btnSubmit" class="btn btn-primary">Process Payment</button>
                                    }
                                    else if (ViewBag.processApprove == true)
                                    {
                                        <button type="button" id="btnReject" class="btn btn-danger"><span class="fa fa-ban"></span> Revise</button>
                                        <button type="button" id="btnApprove" class="btn btn-primary edit"><span class="fa fa-bookmark"></span> Approve</button>
                                        @if (Model.Status == PhoenixERPWebApp.Models.PaymentRequestStatus.Complete)
                                        {
                                            <button type="button" id="btn-reconsiliation" class="btn btn-primary">Reconciliation</button>
                                        }
                                    }

                                    @if (ViewBag.IsBankPayment == true)
                                    {
                                        <a asp-action="Index" asp-controller="BankPayment" asp-area="Finance" class="fakelink btn btn-secondary">Cancel</a>
                                    }
                                    else
                                    {
                                        <a asp-action="Index" asp-controller="PaymentRequest" asp-area="Finance" class="fakelink btn btn-secondary">Cancel</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
