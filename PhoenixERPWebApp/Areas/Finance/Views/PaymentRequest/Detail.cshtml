    function save_event(e) {
        var CoaId = $("#CoaId").data("kendoDropDownList").value();
        var AccountName = $("#CoaId").data("kendoDropDownList").text();
        var CodeRec = $("#CodeRec").val();
        var Condition = $("#Condition").data("kendoDropDownList").value();
        var Debit = $("#Debit").data("kendoNumericTextBox").value();
        var Credit = $("#Credit").data("kendoNumericTextBox").value();

        e.model.set("CoaId", CoaId);
        e.model.set("CodeRec", CodeRec);
        e.model.set("AccountName", AccountName);
        e.model.set("Condition", Condition);
        e.model.set("Debit", Debit);
        e.model.set("Credit", Credit);

        //var TransactionDate = $("#TransactionDate").data("kendoDatePicker").value();
        //e.model.set("TransactionDate", TransactionDate)

        Balance();
    }
         
    function edit_event(e) {
        Condition(e.model.Condition);
    }
    
    function Condition_Select(e) {
        if (e.dataItem) {
            Condition(e.dataItem.Value);
            if (e.dataItem.Value == "Debit") {
                $('#Credit').data("kendoNumericTextBox").value(0);
            } else {
                $('#Debit').data("kendoNumericTextBox").value(0);
            }
        }
    }

    function Condition(value) {
        var isReadOnly = (value == "Debit");
        $("#Debit").data("kendoNumericTextBox").readonly(!isReadOnly);
        $("#Credit").data("kendoNumericTextBox").readonly(isReadOnly);
    }

    function Balance() {
        var models = $("#gridJournalEntry").data("kendoGrid").dataSource.data();
        var totalDebit = 0;
        var totalCredit = 0;

        $.each(models, function (index, data) {
            if (data.Debit != null) {
                totalDebit += data.Debit;
            }
            if (data.Credit != null) {
                totalCredit += data.Credit;
            }
        });
        var balance = (totalCredit == totalDebit);
        if (balance) {
            $("#lblBalance").html("<span style='color:green;'>Balance</span>");
        } else {
            $("#lblBalance").html("<span style='color:red;'>Not Balance</span>");
        }
        return balance;
    }
    
    function JEValue(value) {
        return $("#CurrencySymbol").val() + ' ' + kendo.toString(value, '#,###.##');
    }

    function sumJEDebit() {
        var models = $("#gridJournalEntry").data("kendoGrid").dataSource.data();
        var result = 0;

        $.each(models, function (index, data) {
            if (data.Debit != null) {
                result += data.Debit;
            }
        });
        return $("#CurrencySymbol").val() + ' ' + kendo.toString(result, '#,###.##'); 
    }

    function sumJECredit() {
        var models = $("#gridJournalEntry").data("kendoGrid").dataSource.data();
        var result = 0;

        $.each(models, function (index, data) {
            if (data.Credit != null) {
                result += data.Credit;
            }
        });
        return $("#CurrencySymbol").val() + ' ' + kendo.toString(result, '#,###.##'); 
    }

    function setCurrencyValue() {
        var currencySymbol = $("#CurrencySymbol").val();
        var CurrencySymbolDefault = $("#CurrencySymbolDefault").val();
        var amountPay = $('#AmountPay').data('kendoNumericTextBox');
        var charges = $('#Charges').data('kendoNumericTextBox');
        var totalAmountPay = $('#TotalAmountPay').data('kendoNumericTextBox'); 
        var exchangeRate = $('#ExchangeRate').data('kendoNumericTextBox');

        var amountPayValue = amountPay.value();
        var chargesValue = charges.value();
        var totalAmountPayValue = totalAmountPay.value(); 
        var exchangeRateValue = exchangeRate.value();

        amountPay.setOptions({ value: amountPayValue, format: currencySymbol + " #,###.##" });
        charges.setOptions({ value: chargesValue, format: currencySymbol + " #,###.##" });
        totalAmountPay.setOptions({ value: totalAmountPayValue, format: currencySymbol + " #,###.##" }); 
        exchangeRate.setOptions({ value: exchangeRateValue, format: CurrencySymbolDefault + " #,###.##" });

        if ($("#SourceDoc").val() == "@PhoenixERPWebApp.Models.Enum.SourceDoc.AccountPayable") {
            var amount = $('#Amount').data('kendoNumericTextBox');
            var taxPayable = $('#TaxPayable').data('kendoNumericTextBox');
            var totalAmount = $('#TotalAmount').data('kendoNumericTextBox');
            
            var amountValue = amount.value();
            var taxPayableValue = taxPayable.value();
            var totalAmountValue = totalAmount.value(); 

            amount.setOptions({ value: amountValue, format: currencySymbol + " #,###.##" });
            taxPayable.setOptions({ value: taxPayableValue, format: currencySymbol + " #,###.##" });
            totalAmount.setOptions({ value: totalAmountValue, format: currencySymbol + " #,###.##" }); 
        } 
    }

    function sumJournal(sum) {
        return $("#CurrencySymbolDefault").val() + ' ' + kendo.toString(sum, '#,###.##');
    } 
