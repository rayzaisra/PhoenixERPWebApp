    function DDLCurrencyChange() {  
        if ($('#CurrencyId').data("kendoDropDownList").value() == $("#CurrencyIdDefault").val() &&
            $('#CurrencyId').data("kendoDropDownList").value() != "") {
            $("#ExchangeRate").data("kendoNumericTextBox").value("1");
            $('#ExchangeRate').data("kendoNumericTextBox").readonly();
        }
        else {
            $('#ExchangeRate').data("kendoNumericTextBox").readonly(false);
        } 
    }
        
    function currency_select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;            
                 mApp.block("#m_blockui_list", {
                        overlayColor: "#000000",
                        type: "loader",
                        state: "primary",
                        message: "Processing..."
                    });

                $.ajax({
                    type: "GET",
                    dataType: "json",
                    contentType: "application/x-www-form-urlencoded",
                    async: false,
                    data: { id: dataItem.Value },
                    url: "@Url.Action("Get", "Currency",new { area="Finance"})",
                    success: function (result) {
                        if (result != null) {                            
                            $("#CurrencySymbol").val(result.CurrencySymbol);
                            $("#CurrencyIdDefault").val(result.CurrencyIdDefault);
                            $("#CurrencySymbolDefault").val(result.CurrencySymbolDefault);

                            if (dataItem.Value == result.CurrencyIdDefault) {
                                    $("#ExchangeRate").data("kendoNumericTextBox").value("1");
                                    $('#ExchangeRate').data("kendoNumericTextBox").readonly();
                             }
                             else { 
                                    $('#ExchangeRate').data("kendoNumericTextBox").readonly(false);
                            }

                            setCurrencyValue();

                            //var dataSource = $("#treelist").data("kendoGrid").dataSource;
                            //var view = dataSource.view();
                            //for (var i = 0; i < view.length; i++) { 
                            //    view[i].set("CurrencySymbol", result.CurrencySymbol); 
                            //}
                        }
                    },
                    error: function (e, t, s) {
                        console.log(e)
                        mApp.unblock("#m_blockui_list");
                    }
                }).then(setTimeout(function () {
                    mApp.unblock("#m_blockui_list");
                }, 2e3)); 
        }
    }

    function onChangeDDLPayToType() {
        $("#PayToAccountNumber").val(""); 
        //$("#AmountPay").data("kendoNumericTextBox").readonly(false); 
        $('#PaytoCoaId').data("kendoDropDownList").value("");
        $("#PaytoBankName").val("");
        $('#PaytoBank').data("kendoDropDownList").value("");
        $('#PayToPettyCash').data("kendoDropDownList").value("");

        ActionPayToType();

        if ($("#PayToType").val() == "3") {
            $("#vendoroption").css("display", "none");
            $("#bankoption").css("display", "none");
            $("#pettycashoption").css("display", "none");

            $("#PayToVendor").removeAttr("required");
            $("#PayToPettyCash").removeAttr("required");
            $("#PaytoBank").removeAttr("required");
            $("#divpaytobankname").css("display", "none");
            $("#accountNumberOption").css("display", "none");
            $("#divcoaidpayto").css("display", "none");
            $('.btn').attr('disabled', 'disabled');
        } else {
            $("#accountNumberOption").css("display", "block");
            $("#pettycashoption").css("display", "block");
            $("#bankoption").css("display", "block");
            $("#divpaytobankname").css("display", "block");
            $("#accountNumberOption").css("display", "block");
            $("#divcoaidpayto").css("display", "block");
            $('.btn').attr('disabled', false);
            ActionPayToType();
        }
    }

    function ActionPayToType() {
        if ($("#PayToType").val() == "1") {
            $("#pettycashoption").css("display", "block");
            $("#bankoption").css("display", "none");
            $("#vendoroption").css("display", "none");

            $("#PayToPettyCash").attr("required", "required");
            $("#PaytoBank").removeAttr("required");
            $("#PayToVendor").removeAttr("required");
            $("#divpaytobankname").css("display", "none");
            $("#accountNumberOption").css("display", "block");
        }

        if ($("#PayToType").val() == "2") {
            $("#bankoption").css("display", "block");
            $("#divpaytobankname").css("display", "none");
            $("#pettycashoption").css("display", "none");
            $("#vendoroption").css("display", "none");

            $("#PaytoBank").attr("required", "required");
            $("#PayToPettyCash").removeAttr("required");
            $("#PayToVendor").removeAttr("required");
            $("#accountNumberOption").css("display", "block");
        }

        if ($("#PayToType").val() == "3") {
            $("#vendoroption").css("display", "block");
            $("#bankoption").css("display", "none");
            $("#pettycashoption").css("display", "none");

            $("#PayToVendor").attr("required", "required");
            $("#PayToPettyCash").removeAttr("required");
            $("#PaytoBank").removeAttr("required");
            $("#divpaytobankname").css("display", "block");
            $("#accountNumberOption").css("display", "block");
        }

        if ($("#PayToType").val() == "4") {
            $("#vendoroption").css("display", "none");
            $("#bankoption").css("display", "none");
            $("#pettycashoption").css("display", "none");

            //$("#PayToAccountNumber").removeAttr("required");
            $("#PayToVendor").removeAttr("required");
            $("#PayToPettyCash").removeAttr("required");
            $("#PaytoBank").removeAttr("required");
