    function deleteGridRowPceList(e) {
        swal({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            type: "warning",
            showCancelButton: !0,
            confirmButtonText: "Yes",
            cancelButtonText: "No",
            reverseButtons: !0
        }).then(function (ok) {
            if (ok.value) { 
                var item = dataItem(e);
                $("#grid-multi-pce").data("kendoGrid").dataSource.remove(item);

                var itemRow = $("#grid-multi-pce").data("kendoGrid").dataSource.data();
                if (itemRow.length == 0) { 
                    var paytoCoaid = $('#PaytoCoaId').data("kendoDropDownList");
                    //var coaidPayFrom = $('#AccountId').data("kendoDropDownList");
                    var divIdPayFrom = $('#BusinessUnitId').data("kendoDropDownList");
                    var PaytoVedor = $('#PayToVendor').data("kendoDropDownList"); // vendor id
                    var currencyIdPayfrom = $('#CurrencyId').data("kendoDropDownList");
                    var bankChargesCoaId = $('#BankChargesCoaId').data("kendoDropDownList");

                    //coaidPayFrom.enable(true);
                    divIdPayFrom.enable(true);
                    PaytoVedor.enable(true);
                    //currencyIdPayfrom.readonly(false);

                    bankChargesCoaId.value("");
                    paytoCoaid.value('');
                    //coaidPayFrom.value('');
                    divIdPayFrom.value('');
                    PaytoVedor.value(''); 

                    $('#Amount').data("kendoNumericTextBox").value(0);
                    $('#TaxPayable').data("kendoNumericTextBox").value(0);
                    $('#TotalAmount').data("kendoNumericTextBox").value(0);   
                    $("#AmountPay").data("kendoNumericTextBox").value(0);
                    $("#TotalAmountPay").data("kendoNumericTextBox").value(0);
                    $("#PaytoBankName").val(""); 

                    $("#Charges").data("kendoNumericTextBox").value(0);
                    $("#Charges").data("kendoDropDownList").readonly(); 
                    $("#PayToType").data("kendoDropDownList").value("1");
                    $("#PayToType").data("kendoDropDownList").readonly(false);
                    $("#vendoroption").css("display", "none");
                    $("#bankoption").css("display", "none");
                    $("#pettycashoption").css("display", "block");
                    $('#PayToAccountNumber').val("");
                }

                CalculateAmount();
            }
        }).catch(swal.noop);
    }
     
