    } 
        
    function CalculateAmount() {
        var chargesCoa = $("#Charges").data("kendoNumericTextBox").value();
        var griddtldsData = $("#grid-multi-pce").data('kendoGrid').dataSource.data();

        if (griddtldsData.length > 0){
            var amt = 0, taxPay = 0;
            for (var i = 0; i < griddtldsData.length; i++) {
                amt += griddtldsData[i].Amount;
                taxPay += griddtldsData[i].TaxPayable;             
            }
            var grandTotal = amt - taxPay;

            $('#Amount').data("kendoNumericTextBox").value(amt);
            $('#TaxPayable').data("kendoNumericTextBox").value(taxPay);
            $('#TotalAmount').data("kendoNumericTextBox").value(grandTotal);
            $('#AmountPay').data("kendoNumericTextBox").value(grandTotal);
            $("#TotalAmountPay").data("kendoNumericTextBox").value(grandTotal + chargesCoa);
        } else {            
            var grandTotal = $("#AmountPay").data("kendoNumericTextBox").value();
            $("#TotalAmountPay").data("kendoNumericTextBox").value(grandTotal + chargesCoa);
        }
    }
    
    function Calculate() {
        var chargesCoa = $("#Charges").data("kendoNumericTextBox").value();
        var grandTotal = $("#AmountPay").data("kendoNumericTextBox").value();
        $("#TotalAmountPay").data("kendoNumericTextBox").value(grandTotal + chargesCoa);
    }

