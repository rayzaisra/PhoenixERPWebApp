@inject Phoenix.WebExtension.Attributes.MenuAuthorization menuAuthorization;
@model PhoenixERPWebApp.Models.Pce
@{
    if (ViewBag.processApprove == true)
    {
        ViewData["Title"] = "Production Cost Estimate Approval";
    }
    else
    {
        ViewData["Title"] = "Production Cost Estimate";
    }
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";

    var privilege = await menuAuthorization.GetPrivilege("Finance", "Pce");
    if (!privilege.IsRead && !ViewBag.IsRead) { throw new Exception("You have no authorization to the current access."); }
}

<style>
    .k-numerictextbox .k-input {
        text-align: right;
        padding-right:10px;
    }
</style>

