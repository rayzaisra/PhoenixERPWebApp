    function calculateOtherFee_change() {
        var models = $("#treelist").data("kendoTreeList").dataSource.data();
        var totalCost = 0;
        var subTotal = 0;

        $.each(models, function (index, data) {
            if (data.ParentId == null) {
                if (data.Total != null) {
                    subTotal += data.Total;
                }
                if (data.Cost != null) {
                    totalCost += data.Cost;
                }
            }
        });

        CalculateAll(totalCost, subTotal);        
    }
    
    function CalculateAll(totalCost, subTotal) {
        var otherFeePercentage = $("#OtherFeePercentage").data("kendoNumericTextBox").value();
        var otherFee = Math.round((subTotal * otherFeePercentage) / 100);
        var subtotalFee = subTotal + otherFee;
        var vat = Math.round(0.1 * (subTotal + otherFee));
        var grandTotal = (subTotal + otherFee) + vat;
        var margin = (subTotal + otherFee) - totalCost;
        
        $("#Subtotal").data("kendoNumericTextBox").value(subTotal);
        $("#OtherFee").data("kendoNumericTextBox").value(otherFee);
        $("#subTotalFee").data("kendoNumericTextBox").value(subtotalFee);
        $("#Vat").data("kendoNumericTextBox").value(vat);
        $("#GrandTotal").data("kendoNumericTextBox").value(grandTotal);
        $("#totalAmount").html(kendo.format("{0:N2}", grandTotal));
        $("#PceMargin").val(margin);
    }

    $('#btnPrint').click(function () {
        window.open('@Url.Action("print", "pce")?Id=' + $("#Id").val(), '_blank');
    });

    $('#btnSubmitToClient').click(function () {
        $("#RemarkRejected").removeAttr("required", "required");

        if ('@Model.TypeOfExpenseId' == '@ViewBag.CrossBilling') {
            $("#PceReference").attr("required", "required");
        }

        //$("#PoClient").attr("required", "required");
        //$("#TotalPoClient").attr("required", "required");
        $("#Status").attr("required", "required");
        if (!isValid()) return;
        callAction({ formId: "formpce", title: "submit", type: "PUT", url: '@Url.Action("submitToClient", "pce")', objects: result()});
    });

    $('#btnApprove').click(function () {
        $("#RemarkRejected").removeAttr("required", "required");
        callAction({ formId: "formpce", title: "approve", type: "PUT", url: '@Url.Action("approve", "pce")', objects: result()});
    });

