        $("#RemarkRejected").attr("required", "required");
        if (!isValid()) return;
        callAction({ formId: "formpce", title: "revise", type: "POST", url: '@Url.Action("revise", "pce")', objects: result()});
    });

    $('#btnSubmit').click(function () {
        $("#RemarkRejected").removeAttr("required", "required");
        if (!isValid()) return;
        callAction({ formId: "formpce", title: "submit", type: "POST", url: '@Url.Action("submit", "pce")', objects: result()});
    });

    $('#btnSave').click(function () {
        $("#RemarkRejected").removeAttr("required", "required");
        if (!isValid()) return;
        callAction({ formId: "formpce", title: "save", type: "POST", url: '@Url.Action("save", "pce")', objects: result()});
    });
    
    function isValid() {
        var valid = $("#formpce").validate().form();
        if (valid) {
            var taskList = $("#treelist").data("kendoTreeList").dataSource.data();
            if (taskList.length == 0) {
                swal('Warning', "Please input task list", 'warning');
                return false;
            }

            var models = $("#treelist").data("kendoTreeList").dataSource.data();
            var task = models.filter((x) => { return x.ParentId==null });

            var messageTaskName = "";
            $.each(task, function (index, data) {
                var total = data.Total;
                var subTask = models.filter((x) => { return x.ParentId == data.Id });

                if (subTask.length > 0) {
                    var subTotal = 0;
                    $.each(subTask, function (indexSub, dataSub) {
                        subTotal += dataSub.Total;
                    });

                    if (total != subTotal) {
                        if (messageTaskName != "") messageTaskName += ", ";
                        messageTaskName += data.TaskName;
                    }
                }
            });

            if (messageTaskName != "") {
                swal('Warning', "Total task is not the same as the total sub task.please check again for the following task : " + messageTaskName , 'warning');
                return false;
            }
            
            return true;
        } else {
            return false;
        }
    }

    function result() {
        var treeListPdrDevelopmentPlan = $("#treelist").data("kendoTreeList");
        var dataList = {
            PceTasks: treeListPdrDevelopmentPlan.dataSource.data()
        }

        return dataList;
    }
    function boundTreeList_event(e) {
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);

            row.removeClass("boldColor");
            if (dataItem.ParentId == null) {
                row.addClass("boldColor");
            }
        }
    }
    
    function job_params() {
        return {
            status: "@Model.Status",
            jobId : "@Model.JobId"
        };
    }

    function pcereference_params() {        
        return {
            pceId : "@Model.Id"
        };
    }

    function invoice_params() {
         return {
            pceId : "@Model.Id"
        };
    }

    function MasterOutlet_params() {
        return {
            clientId:$("#CompanyId").val()
        }
    }
</script>