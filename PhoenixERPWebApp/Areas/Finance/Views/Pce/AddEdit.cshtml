<script>    
    $(document).ready(function () {
        if ("@ViewBag.isRequestor" == "False") {
            $("#OtherFeeName").data("kendoDropDownList").readonly();
            $("#OtherFeePercentage").data("kendoNumericTextBox").readonly();
        }

        if ('@Model.Status' != '') {
            if ('@Model.Status' != '@PhoenixERPWebApp.Models.StatusTransactionName.Approved') {
                $("#Status").data("kendoDropDownList").readonly();
            }
        }
                
        if ('@Model.Total' != '' && '@Model.CurrencySymbol' !='') {
            $("#totalAmount").html('@Model.CurrencySymbol' +' '+ kendo.format("{0:N2}", @Model.Total));
        }else  if ('@Model.Total' != '') {
            $("#totalAmount").html(kendo.format("{0:N2}", @Model.Total));
        }

        var subTotal = "@Model.Subtotal";
        var otherFee = "@Model.OtherFee";
        if (subTotal == "") subTotal = "0";
        if (otherFee == "") otherFee = "0";

        var subtotalFee = parseFloat(subTotal) + parseFloat(otherFee);
        $("#subTotalFee").data("kendoNumericTextBox").value(subtotalFee);

        var subTotalOriginal = "@Model.SubtotalOriginal";
        var otherFeeOriginal = "@Model.OtherFeeOriginal";

        if (subTotalOriginal != ""){
            if (subTotalOriginal == "") subTotalOriginal = "0";
            if (otherFeeOriginal == "") otherFeeOriginal = "0";

            var subtotalFeeOriginal = parseFloat(subTotalOriginal) + parseFloat(otherFeeOriginal);
            $("#subTotalFeeOriginal").data("kendoNumericTextBox").value(subtotalFeeOriginal);
        }
    });

    function shareService_params() {
        return {
            MainserviceCategoryId: $("#MainserviceCategoryId").val()
        }
    }

    function treeList_params() {
        return {
            pceId: "@Model.Id"
        };
    }

    function Job_SelectEvent(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;

            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $("#CompanyId").val("");
            $("#CompanyName").val("");
            $("#ClientBrand").val("");

            $.ajax({
                type: "GET",
                dataType: "json",
                contentType: "application/x-www-form-urlencoded",
                async: false,
                data: { jobid: dataItem.Value },
                url: "@Url.Action("getclient", "pca")",
                success: function (result) {
                    if (result != null) {
                        $("#CompanyId").val(result.CompanyId);
                        $("#CompanyName").val(result.CompanyName);
                        $("#ClientBrand").val(result.BrandName);
                        if (result.IsPMTeam == false) {
                            $("#btnSave").css({ "visibility": "hidden", "position": "fixed" });
                            $("#btnSubmit").css({ "visibility": "hidden", "position": "fixed" });
                            $("#btnDelete").css({ "visibility": "hidden", "position": "fixed" });
                        } else {
                            $("#btnSave").css({ "visibility": "visible", "position": "static" });
                            $("#btnSubmit").css({ "visibility": "visible", "position": "static" });
                            $("#btnDelete").css({ "visibility": "visible", "position": "static" });
                        }
                    }
                },
                error: function (e, t, s) {
                    console.log(e)
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
            }, 2e3));
        }
    }

