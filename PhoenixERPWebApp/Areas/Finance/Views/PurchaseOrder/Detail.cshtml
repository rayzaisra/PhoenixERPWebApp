    function calculate_change(e) {
        var Qty = $('#Qty').data("kendoNumericTextBox").value();
        var UnitPrice = $('#UnitPrice').data("kendoNumericTextBox").value();
        var Amount = Qty * UnitPrice;
        $('#Amount').data("kendoNumericTextBox").value(Amount);
        
        var ExchangeRate = $("#ExchangeRate").data("kendoNumericTextBox").value();
        var Operator = $("#Operator").val();
        var totalOri = eval(Amount.toString() + Operator + ExchangeRate.toString());
        $("#TotalExchangeAmount").data("kendoNumericTextBox").value(totalOri);
    }

    
    function exchangeRate_change(e) {
        var dataSource = $("#treelist-RequestforQuotationDetailList").data("kendoTreeList").dataSource;
        var view = dataSource.view();
        for (var i = 0; i < view.length; i++) {
            var ParentTaskId = view[i].get("ParentTaskId");
            if (ParentTaskId == null) {
                var Total = view[i].get("Amount");
                var TotalExchangeRequest = view[i].get("TotalExchangeRequest");
                var Operator = view[i].get("Operator");

                if (Total != null) {
                    var ExchangeRate = $("#ExchangeRate").data("kendoNumericTextBox").value();
                    var TotalExchangeAmount = eval(Total.toString() + Operator + ExchangeRate.toString());
                    view[i].set("TotalExchangeAmount", TotalExchangeAmount);
                }
            }
        } 
    }

