                            <h3 class="m-portlet__head-text m--font-success">
                                    Purchase Order &nbsp;
                                    @if (Model.Status == PhoenixERPWebApp.Models.PurchaseOrderStatus.Draft)
                                    {<span class="m-badge m-badge--info m-badge--wide" id="lblstatus">@Model.StatusDesc</span> }
                                    else if (Model.Status == PhoenixERPWebApp.Models.PurchaseOrderStatus.WaitingApproval)// || 
                                        //Model.Status == PhoenixERPWebApp.Models.PurchaseOrderStatus.CanceledRequest || 
                                        //Model.Status == PhoenixERPWebApp.Models.PurchaseOrderStatus.ClosedRequest)
                                        { <span class="m-badge m-badge--warning m-badge--wide" id="lblstatus">@Model.StatusDesc</span> }
