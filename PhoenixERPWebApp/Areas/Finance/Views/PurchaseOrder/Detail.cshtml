                                    { <span class="m-badge m-badge--danger m-badge--wide" id="lblstatus">@Model.StatusDesc</span> }
                                    else if (Model.Status == PhoenixERPWebApp.Models.PurchaseOrderStatus.Approved ||
                                        Model.Status == PhoenixERPWebApp.Models.PurchaseOrderStatus.Cancelled ||
