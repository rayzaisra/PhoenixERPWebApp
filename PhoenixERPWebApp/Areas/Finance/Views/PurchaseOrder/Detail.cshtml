    function currency_select(e) {
        if (e.dataItem) {
            if (e.dataItem.Value == "@PhoenixERPWebApp.Models.CurrencyIDR.CurrencyId") {
                $("#ExchangeRate").data("kendoNumericTextBox").readonly();
                $('#ExchangeRate').data("kendoNumericTextBox").value(1);
            } else {
                $("#ExchangeRate").data("kendoNumericTextBox").readonly(false);
                $('#ExchangeRate').data("kendoNumericTextBox").value(0);
            }
        }
    }

    function InvoicingType_Select(e) {
        if (e.dataItem) {
            var isReadonly = e.dataItem.Value == "SINGLE";
            $("#PercentPaymentTerm1").data("kendoNumericTextBox").readonly(isReadonly);
            $("#PercentPaymentTerm2").data("kendoNumericTextBox").readonly(isReadonly);
            $("#PercentPaymentTerm3").data("kendoNumericTextBox").readonly(isReadonly);

            if (isReadonly) {
                $('#PercentPaymentTerm1').data("kendoNumericTextBox").value(100);
                $('#PercentPaymentTerm2').data("kendoNumericTextBox").value(0);
                $('#PercentPaymentTerm3').data("kendoNumericTextBox").value(0);
            } else {
                $('#PercentPaymentTerm1').data("kendoNumericTextBox").value(50);
                $('#PercentPaymentTerm2').data("kendoNumericTextBox").value(50);
            }

            CalculatePayment();
        }
    }

