        box-shadow: none !important;
        background: transparent;
        border: none;
        color: green;
        margin: 0px;
        padding: 2px;
    }

    td[role=gridcell] > button.k-button.k-button-icontext.k-grid-delete,
    td[role=gridcell] > button.k-button.k-button-icontext.k-grid-remove,
    td[role=gridcell] > button.k-button.k-button-icontext.k-grid-cancel {
        box-shadow: none !important;
