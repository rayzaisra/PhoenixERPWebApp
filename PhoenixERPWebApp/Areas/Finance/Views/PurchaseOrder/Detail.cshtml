    function saveDetail_event(e) {
        var UomId = $("#UomId").data("kendoDropDownList").value();
        var UomName = $("#UomId").data("kendoDropDownList").text();

        var CurrencyId = "";
        var ExchangeRate = "";
        var CurrencySymbolRequest = "";
        var CurrencySymbol = "";

        var models = $("#treelist-PurchaseOrderDetailList").data("kendoTreeList").dataSource.data().filter((x) => { return x.ParentTaskId == null });
        if (models.length > 0) { 
            CurrencyId = models[0].CurrencyId;
            ExchangeRate = models[0].ExchangeRate;
            CurrencySymbolRequest = models[0].CurrencySymbolRequest;
            CurrencySymbol = models[0].CurrencySymbol;
        }

        if ("@Model.CashAdvanceSettlementId" != "") {
            var ItemTypeId = $("#ItemTypeId").data("kendoDropDownList").value();
            var ItemTypeName = $("#ItemTypeId").data("kendoDropDownList").text();

            e.model.set("ItemTypeId", ItemTypeId);
            e.model.set("ItemTypeName", ItemTypeName);
        }else{ 
            var UnitPrice = $("#UnitPrice").data("kendoNumericTextBox").value();
            var Qty = $("#Qty").data("kendoNumericTextBox").value();
            var Amount = $("#Amount").data("kendoNumericTextBox").value();
            var TotalExchangeAmount = $("#TotalExchangeAmount").data("kendoNumericTextBox").value();
            //var TaskId = $("#TaskId").data("kendoDropDownList").value();
            //var Task = $("#TaskId").data("kendoDropDownList").text();
            //var UomId = $("#UomId").data("kendoDropDownList").value();
            //var UomName = $("#UomId").data("kendoDropDownList").text();


            if (e.model.ParentTaskId == null) {
                if (TotalExchangeAmount > e.model.TotalExchangeRequest) {
                    swal('Warning', "The total cost exchange value should not exceed the value of the total price exchange", 'warning');
                    e.preventDefault();
                    return false;
                }
            }

            //e.model.set("TaskId", TaskId);
            //e.model.set("Task", Task);
            e.model.set("UomId", UomId);
            e.model.set("UomName", UomName);
            e.model.set("UnitPrice", UnitPrice);
            e.model.set("Qty", Qty);
            e.model.set("Amount", Amount);
            e.model.set("TotalExchangeAmount", TotalExchangeAmount);

            e.model.set("Operator", $("#Operator").val());
            e.model.set("CurrencyId", CurrencyId);
            e.model.set("ExchangeRate", ExchangeRate);
            e.model.set("CurrencySymbolRequest", CurrencySymbolRequest);
            e.model.set("CurrencySymbol", CurrencySymbol);
        }

        CallculateAll();
    }

