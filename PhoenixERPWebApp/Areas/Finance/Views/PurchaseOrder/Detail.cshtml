    function isValid() {
        var valid = $("#formPO").validate().form();
        if (valid) {
            var percentTerm1 = $('#PercentPaymentTerm1').data("kendoNumericTextBox").value();
            var percentTerm2 = $('#PercentPaymentTerm2').data("kendoNumericTextBox").value();
            var percentTerm3 = $('#PercentPaymentTerm3').data("kendoNumericTextBox").value();

            var percent = percentTerm1 + percentTerm2 + percentTerm3;
            if (percent != 100) {
                swal('Warning', "The total payment terms for one, two and three must be one hundred percent", 'warning');
                return false;
            }
            
            if (percentTerm2 != 0 && percentTerm1 == 0) {
                swal('Warning', "Term 1 may not be filled in 0 as long as term 2 or 3 has a value", 'warning');
                return false;
            }

            if (percentTerm3 != 0 && (percentTerm1 == 0 || percentTerm2 == 0)) {
                swal('Warning', "Terms 1 and 2 may not be filled in as long as term 3 has a value", 'warning');
                return false;
            }
                        
            var InvoicingType = $('#InvoicingType').data("kendoDropDownList").value();
            var countTerm = 0;
            if (percentTerm1 != 0) countTerm++;
            if (percentTerm2 != 0) countTerm++;
            if (percentTerm3 != 0) countTerm++;

            if (InvoicingType == "MULTIPLE" && countTerm == 1) {
                swal('Warning', "The terms must be filled in more than one", 'warning');
                return false;                
            }
            
            var grid = $("#treelist-PurchaseOrderDetailList").data("kendoTreeList");
            grid.saveRow();

            var data = grid.dataSource.data(); 
            if (data.length == 0) {
                swal('Warning', "Please input purchase order detail list", 'warning');
                return false;
            }

            for (var i = 0; i < data.length; i++) {
                if (data[i].UnitPrice == null) {
                    swal('Warning', "please input unit price value in purchase order detail", 'warning');
                    return false;
                }
                if (data[i].Qty == null) {
                    swal('Warning', "please input qty value in purchase order detail", 'warning');
                    return false;
                }

                if (data[i].ParentTaskId == null) {
                    if (data[i].ItemTypeId == null) {
                        swal('Warning', "please input type value in purchase order detail", 'warning');
                        return false;
                    }
                }
                
                if(data[i].TotalExchangeAmount!=null && data[i].TotalExchangeRequest!=null) {
                    if (data[i].TotalExchangeAmount > data[i].TotalExchangeRequest) {
                        swal('Warning', "The total cost exchange value should not exceed the value of the total price exchange", 'warning'); 
                        return false;
                    }
                }
            } 

            var rfq = $("#RequestForQuotationId").val();
            if (rfq != "") {
                var paymentMethod = $("#PaymentMethodId").data("kendoDropDownList").value();
                var specialRequest = $("#SpecialRequestId").data("kendoDropDownList").value();
                var isPayment = (paymentMethod == "@PhoenixERPWebApp.Models.Enum.PaymentType.CashAdvance");
                var isSpecial = (specialRequest == "@PhoenixERPWebApp.Models.Enum.SpecialRequestType.TypeCashAdvanceId");

                if (isPayment && isSpecial){
                    swal('Warning', "Payment method and Special request may not choose \"cash advance\" if the source of the data is from RFQ.", 'warning');
                    return false;
                } else if (isPayment) {
                    swal('Warning', "Payment method may not choose \"@PhoenixERPWebApp.Models.Enum.PaymentType.CashAdvanceName\" if the source of the data is from RFQ.", 'warning');
                    return false;
                }else if (isSpecial) {
                    swal('Warning', "Special request may not choose \"@PhoenixERPWebApp.Models.Enum.SpecialRequestType.TypeCashAdvanceName\" if the source of the data is from RFQ.", 'warning');
                    return false;
                }
            }

            return true;
        } else {
            return false;
        }
    }

    function result() {
        var grid = $("#treelist-PurchaseOrderDetailList").data("kendoTreeList");
        grid.saveRow();
        CallculateAll();

        var dataList = {
            PurchaseOrderDetail: grid.dataSource.data()
        }

        return dataList;
    }


    function PercentPaymentTerm1_change() {
        var percentTerm1 = $('#PercentPaymentTerm1').data("kendoNumericTextBox").value();
        var grandTotal = $('#GrandTotal').data("kendoNumericTextBox").value();        
        var paymentTerm1 = grandTotal * (percentTerm1 / 100);
        $('#PaymentTerm1').data("kendoNumericTextBox").value(paymentTerm1);
    }

