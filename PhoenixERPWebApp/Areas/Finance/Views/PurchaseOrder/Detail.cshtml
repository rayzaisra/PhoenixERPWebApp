    function CallculateAll() { 
        var models = $("#treelist-PurchaseOrderDetailList").data("kendoTreeList").dataSource.data();
        if (models.length>0){
            //var amount = 0;
            //var CountDiscountPercent = 0;
            //var discountPercent = 0;
            //var discountAmount = 0;
            var subTotal = 0;

            $.each(models, function (index, data) {
                if (data.ParentTaskId == null) {
                    if (data.Amount != null) {
                        subTotal += data.Amount;
                        //    amount += data.Amount;
                        //    discountPercent += data.DiscountPercent;
                        //    discountAmount += data.DiscountAmount;
                        //    subTotal += data.AmountNet;

                        //    if (data.DiscountPercent != null || data.DiscountPercent != 0) CountDiscountPercent++;
                    }
                }
            }); 

            //ReCallculateAll(amount, CountDiscountPercent, discountPercent, discountAmount, subTotal);
            ReCallculateAll(subTotal);
        }
    }
       
    function ReCallculateAll(subTotal) {
        var vatpercent = $('#VatPercent').data("kendoNumericTextBox").value();
        var discountPercent = $('#totalDiscountPercent').data("kendoNumericTextBox").value();

        if (vatpercent == null) vatpercent = 0;
        if (discountPercent == null) discountPercent = 0;

        var vat = (subTotal * (vatpercent / 100));
        var discount = (subTotal * (discountPercent / 100));
        var grandTotal = (subTotal + vat) - discount;

        $('#SubTotal').data("kendoNumericTextBox").value(subTotal);
        $('#Vat').data("kendoNumericTextBox").value(vat);
        $('#totalDiscountAmount').data("kendoNumericTextBox").value(discount);
        $('#GrandTotal').data("kendoNumericTextBox").value(grandTotal);
        CalculatePayment();
    }

    function CalculatePayment() {
        PercentPaymentTerm1_change();
        PercentPaymentTerm2_change();
        PercentPaymentTerm3_change();
