@inject Phoenix.WebExtension.Attributes.MenuAuthorization menuAuthorization;
@model PhoenixERPWebApp.Models.PurchaseRequest
@{
    ViewData["Title"] = "Purchase Request Internal";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";

    var privilege = await menuAuthorization.GetPrivilege("Finance", "PurchaseRequest");
    if (!privilege.IsRead) { throw new Exception("You have no authorization to the current access."); }
}
<style>
    .k-numerictextbox .k-input {
        text-align: right;
        padding-right:10px;
    }
</style>
