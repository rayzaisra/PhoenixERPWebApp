    });

    function isValid() {
        var valid = $("#formpurchaserequest").validate().form();
        if (valid) {
            var grid = $("#grid-PurchaseRequestDetail").data("kendoGrid").dataSource.data();
            if (grid.length == 0) {
                swal('Warning', "Please input purchase request detail", 'warning');
                return false;
            }
            return true;
        } else {
            return false;
        }
    }
    
    function result() {
        var gridDetail = $("#grid-PurchaseRequestDetail").data("kendoGrid");
        gridDetail.saveRow();

        var dataList = {
            PurchaseRequestDetails: gridDetail.dataSource.data()
        }

        return dataList;
    }
        
