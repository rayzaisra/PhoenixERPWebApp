    }

    function remove_event(e) {
        var models = $("#grid-PurchaseRequestDetail").data("kendoGrid").dataSource.data().filter((x) => { return x.Id != e.model.Id }); 
        var subTotal = 0;

        $.each(models, function (index, data) {
            if (data.Amount != null) {
                subTotal += data.Amount; 
            }
        });
         
        ReCallculateAll(subTotal);

        @*if ("@ViewBag.isRequestor" == "True") {
