                        <div class="row m-row--col-separator-xl">
                            <div class="col-lg-4">
                                <div class="form-group">
                                    <label asp-for="RequestNumber"></label> :
                                    @Html.Kendo().TextBoxFor(m => m.RequestNumber).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly", style = "width:100%", Placeholder = "Auto Generated by System.." })
                                </div>
                                <div class="form-group">
                                    <label asp-for="RequestDatetime"></label> <span class="req">*</span> :
                                    @Html.Kendo().DatePickerFor(m => m.RequestDatetime).HtmlAttributes(new { @readonly = "readonly", style = "width:100%" })
                                </div>
                                <div class="form-group">
                                    <label asp-for="DueDate"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().DatePickerFor(m => m.DueDate)
                                        .Format("dd MMMM yyyy")
                                        .HtmlAttributes(new
                                        {
                                            style = "width: 100%",
                                            onkeydown = "javascript:return false;",
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.DueDate)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.DueDate)} is required"

                                        })
                                    )
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="form-group">
                                    <label asp-for="Requestor"></label> :
                                    @Html.Kendo().TextBoxFor(m => m.Requestor).HtmlAttributes(new { @readonly = "readonly", style = "width:100%" })
                                </div>
                                <div class="form-group">
                                    <label asp-for="RequestorDivisionId"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.RequestorDivisionId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetDivisionHris", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.RequestorDivisionId)}")
                                        .HtmlAttributes(new { @readonly = "readonly", style = "width:100%;" })
                                    )
                                </div>
                                <div class="form-group">
                                    <label asp-for="BudgetOwnerId"></label> :
                                    @(Html.Kendo().DropDownListFor(x => x.BudgetOwnerId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .OptionLabel($"Auto Generated by System..")
                                        .HtmlAttributes(new { @readonly = "readonly", style = "width:100%;" })
                                        .Height(400)
                                        .Filter(FilterType.Contains)
                                        .DataSource(source => source
                                            .Custom()
                                            .Transport(transport => transport
                                            .Read(read =>
                                            {
                                                read.Action("GetEmployee", "Dropdown", new { area = "Finance" });
                                            }))
                                            .ServerFiltering(false))
                                        .AutoBind(true)
                                    )
                                </div>
                                <div class="form-group">
                                    <label asp-for="LegalEntityId"></label> <span class="req">*</span> :
                                    @(Html.Kendo().DropDownListFor(m => m.LegalEntityId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetLegalEntity", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.LegalEntityId)}")
                                        .HtmlAttributes(new { style = "width:100%;", required = "required" })
                                    )
                                </div>
                            </div>
                            <div class="col-lg-4">
                                @*<div class="form-group">
                                    <label asp-for="BusinessUnitId"></label>:
                                    @(Html.Kendo().DropDownListFor(m => m.BusinessUnitId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        //.Events(evt => evt.Select("BusinessUnitId_Select"))
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetDivisionFinance", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.BusinessUnitId)}")
                                        .HtmlAttributes(new { style = "width:100%;" })
                                    )
                                </div>*@
                                <div class="form-group">
                                    <label asp-for="CurrencyId"></label> <span class="req">*</span> :
                                    @(Html.Kendo().DropDownListFor(m => m.CurrencyId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .Events(evt => evt.Select("requestcurrency_select"))
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetDDLCurrency", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.CurrencyId)}")
                                        .HtmlAttributes(new { style = "width:100%;", required = "required"})
                                    )
                                </div>
                                <div class="form-group">
                                    <label asp-for="ExchangeRate"></label> : 
                                    @(Html.Kendo().NumericTextBoxFor(m => m.ExchangeRate)
                                            .Spinners(false)
                                            .Events(evt => evt.Change("calculaterequest_change"))
                                            .Format("{0:N2}")
                                            .HtmlAttributes(new
                                            {
                                                style = "width:100%"
                                            }
                                        )) 
                                </div>

                                <div class="form-group">
                                    <label asp-for="Operator"></label> : 
                                    @(Html.Kendo().DropDownListFor(x => x.Operator)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.Operator)}") 
                                        .HtmlAttributes(new {
                                            style = "width:100%;"
                                        })
                                        .Filter(FilterType.Contains)
                                        .Events(evt=>evt.Change("calculaterequest_change"))
                                        .DataSource(source => source
                                            .Custom()
                                            .Transport(transport => transport
                                            .Read(read =>
                                            {
                                                read.Action("GetDDLOperator", "Dropdown", new { area = "Pm" });
                                            }))
                                            .ServerFiltering(false)
                                        ))
                                </div>
                                <div class="form-group" style="text-align:right">
                                    <h6>Total</h6>
                                    <h2 class="m--font-info"><span class="totalAmount" id="div_total_amount">0</span></h2>

                                </div>
                            </div>
                        </div>
                        <br />
                        <br />
                        <!--end::Form-->
                        <div class="row">
                            <div class="col-lg-12" id="m_blockui_list">
                                <div class="form-group">
                                    <div class="alert m-alert--default" role="alert">
                                        Detail List Item
                                    </div>

                                    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.PurchaseRequestDetail>()
                                        .Name("grid-PurchaseRequestDetail")
                                        .ToolBar(x =>
                                        {
                                            if (ViewBag.isRequestor == true)
                                            {
                                                if (privilege.IsAdd)
                                                {
                                                    x.Create();
                                                }
                                            }
                                        })
                                        .Columns(columns =>
                                        {
                                            if (ViewBag.isRequestor == true)
                                            {
                                                if (privilege.IsEdit || privilege.IsDelete)
                                                {
                                                    columns.Command(command =>
                                                    {
                                                        if (privilege.IsEdit)
                                                        {
                                                            command.Edit().Text(" ").UpdateText(" ").CancelText(" ");
                                                        }

                                                        if (privilege.IsDelete)
                                                        {
                                                            command.Destroy().Text(" ");
                                                        }
                                                    }).Title("Action").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(90);
                                                }
                                            }
                                            columns.Bound(p => p.ItemTypeId).ClientTemplate("#=ItemTypeName#").EditorTemplateName("ItemTypeDropdown").Width(150);
                                            columns.Bound(p => p.ItemId).ClientTemplate("#if(ItemCode!=null){# #=ItemCode# - #=ItemName# #}#").EditorTemplateName("ItemIdDropdown").Width(150);
                                            columns.Bound(p => p.Name).Width(200);
                                            columns.Bound(p => p.Qty).EditorTemplateName("Integer").Width(100).Format("{0:N0}").HtmlAttributes(new { style = "text-align:right;" });
                                            columns.Bound(p => p.UomId).ClientTemplate("#=UomName#").EditorTemplateName("UomDropdown").Width(100);
                                            columns.Bound(p => p.UnitPrice).EditorTemplateName("Decimal").ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(UnitPrice!=null){# #=kendo.format('{0:n2}', UnitPrice)# #}#").Width(200).HtmlAttributes(new { style = "text-align:right;" });
                                            columns.Bound(p => p.Amount).EditorTemplateName("DecimalReadOnly").ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(Amount!=null){# #=kendo.format('{0:n2}', Amount)# #}#").Width(200).HtmlAttributes(new { style = "text-align:right;" });
                                            columns.Bound(p => p.AmountExchange).EditorTemplateName("DecimalReadOnly").ClientTemplate("#if(CurrencySymbolExchange!=null){# #=CurrencySymbolExchange# #}# #if(AmountExchange!=null){# #=kendo.format('{0:n2}', AmountExchange)# #}#").Width(200).HtmlAttributes(new { style = "text-align:right;" });
                                            columns.Bound(p => p.TotalBudgetUsed).Hidden().EditorTemplateName("DecimalReadOnly").ClientTemplate("#if(CurrencySymbolExchange!=null){# #=CurrencySymbolExchange# #}# #if(TotalBudgetUsed!=null){# #=kendo.format('{0:n2}', TotalBudgetUsed)# #}#").Width(200).HtmlAttributes(new { style = "text-align:right;" });
                                            columns.Bound(p => p.TotalBudgetBalance).EditorTemplateName("DecimalReadOnly").ClientTemplate("#if(CurrencySymbolExchange!=null){# #=CurrencySymbolExchange# #}# #if(TotalBudgetBalance!=null){# #=kendo.format('{0:n2}', TotalBudgetBalance)# #}#").Width(200).HtmlAttributes(new { style = "text-align:right;" });
                                            columns.Bound(p => p.ItemCode).Hidden();
                                            columns.Bound(p => p.ItemName).Hidden(); 
                                            columns.Bound(p => p.CurrencySymbolExchange).Hidden(); 
                                        })
                                        .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                        .Editable(x => x.Mode(GridEditMode.InLine).DisplayDeleteConfirmation(true))
                                        .DataSource(dataSource => dataSource
                                            .Ajax()
                                            .Events(events => events.Error("errorHandler"))
                                            .Model(model => { model.Id(p => p.Id);})
                                            .Read(read => read.Action("ReadDetail", "PurchaseRequest").Data("detail_params"))
                                            .Create(create => create.Action("CreateDetail", "PurchaseRequest"))
                                            .Update(update => update.Action("UpdateDetail", "PurchaseRequest"))
                                            .Destroy(destroy => destroy.Action("DestroyDetail", "PurchaseRequest"))
                                        )
                                        .Events(e => e.Edit("edit_event").Save("save_event").Remove("remove_event"))
                                        .NoRecords()
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-8"><div class="pull-right"><label asp-for="GrandTotal"></label></div></div>
                            <div class="col-lg-4">
                                <div class="form-group">
                                    @(Html.Kendo().NumericTextBoxFor(x => x.SubTotal)
                                        .Spinners(false)
                                        .HtmlAttributes(new { style = "width:100%", @readonly = "readonly" })
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="row" style="display:none;">
                            <div class="col-lg-8"><div class="pull-right"><label asp-for="VatPercent"></label> <span class="req">*</span></div></div>
                            <div class="col-lg-1">
                                <div class="form-group">
                                    @(Html.Kendo().NumericTextBoxFor(x => x.VatPercent)
                                        .Spinners(false)
                                        .Format("## \\%")
                                        .Max(100)
                                        .Events(x => x.Change("VatPercent_Change"))
                                        .HtmlAttributes(new { style = "width:100%", required = "required" })
                                    )
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group">
                                    @(Html.Kendo().NumericTextBoxFor(x => x.Vat)
                                        .Spinners(false)
                                        .HtmlAttributes(new { style = "width:100%", @readonly = "readonly" })
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="row" style="display:none;">
                            <div class="col-lg-8"><div class="pull-right"><label asp-for="GrandTotal"></label></div></div>
                            <div class="col-lg-4">
                                <div class="form-group">
                                    @Html.Kendo().NumericTextBoxFor(m => m.GrandTotal).Spinners(false).HtmlAttributes(new { style = "width:100%", @readonly = "readonly" })
                                </div>
                            </div>
                        </div>
                        <div class="row ">
                            <div class="col-lg-8"><div class="pull-right"><label asp-for="DocumentSpecificationFile"></label></div></div>
                            <div class="col-lg-4">
                                <div id="divFile"></div>
                                <div id="divDownloadFile" style="width:100%">
                                    <input type="hidden" asp-for="DocumentSpecificationFile" />
                                    <a href='javascript: void(0);' id="linkDownloadFile" onclick='downloadFile()'></a> &nbsp;
                                    <a href='javascript: void(0);' id="linkRemoveFile" onclick='removeFile()' title='Delete'><span style='color:maroon'><i class='fa fa-times'></i></span></a>
                                </div>
                            </div>
                        </div>

                        @if (ViewBag.checkBudget == true)
                        {
                            <div class="row">
                                <div class="col-lg-12">
                                    <button type="button" id="showBudget" class="btn btn-info">Budget Check</button>
                                </div>
                            </div>
                            <br />
                        }

                        <div class="row ">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label asp-for="RemarksProcess"></label> :
                                    @Html.TextAreaFor(x => x.RemarksProcess, new { style = "height:100px;width:100%" })
                                </div>
                            </div>
                        </div>

                        <partial name="_HistoryApproval" />
                        <partial name="_StatusLog" />
                        <br><hr>
                        <div style="text-align: right;">
                            @if (ViewBag.isRequestor == true)
                            {
                                if (privilege.IsAdd || privilege.IsEdit)
                                {
                                    <button type="button" id="btnSave" class="btn btn-success edit"><span class="fa fa-save"></span> Save</button>
                                    <button type="button" id="btnSubmit" class="btn btn-primary edit"><span class="fa fa-paper-plane"></span> Submit</button>
                                }
                            }
                            else if (ViewBag.processApprove == true)
                            {
                                <button type="button" id="btnReject" class="btn btn-danger"><span class="fa fa-ban"></span> Reject</button>
                                <button type="button" id="btnApprove" class="btn btn-primary"><span class="fa fa-bookmark"></span> Approve</button>
                            }
                            <a asp-action="Index" asp-controller="PurchaseRequest" asp-area="Finance" class="fakelink btn btn-secondary"><span class="fa fa-arrow-circle-left"></span> Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="refModal" class="modal fade" role="dialog"></div>
<script>
     $(document).ready(function () {
         if ("@ViewBag.isRequestor" == "False") {
             //$("#BusinessUnitId").data("kendoDropDownList").readonly();
             $("#LegalEntityId").data("kendoDropDownList").readonly();
             $("#CurrencyId").data("kendoDropDownList").readonly();             
             $("#DueDate").data("kendoDatePicker").readonly();
             $('#VatPercent').data("kendoNumericTextBox").readonly();
             $("#linkRemoveFile").empty(); 
         }

        if ('@Model.GrandTotal' != '') {
            $("#div_total_amount").html($("#CurrencySymbol").val()+' '+kendo.format("{0:N0}", @Model.GrandTotal));
         }

         var fileName = '@Model.DocumentSpecificationFileName';
         if (fileName == '') {
            Files();
         } else {
            $("#linkDownloadFile").text(fileName);
         }

         @*if ("@ViewBag.isRequestor" == "True") {
            var grid = $("#grid-PurchaseRequestDetail").data("kendoGrid");
             grid.dataSource.fetch(function () { 
             var count = grid.dataSource.total();
             if (count > 0) {
                $("#BusinessUnitId").data("kendoDropDownList").readonly();
                 }
             })
        }*@
    });

    //params detail pr
    function detail_params() {
        return {
            Id: "@Model.Id"
        };
    }

    //edit mode inline detail pr
    function itemType_params() {
        return {
            itemTypeId: $("#ItemTypeId").data("kendoDropDownList").value(),
            year: $("#BudgetYear").val(),
            hrisDivisionId: $("#RequestorDivisionId").data("kendoDropDownList").value(),
            //businessUnitId: $("#BusinessUnitId").data("kendoDropDownList").value(),
            budgetOwnerId: $("#BudgetOwnerId").data("kendoDropDownList").value()
        }
    }

    //check budget
    function grid_budget_params() {
        return { 
            //Id: $("#filertHrisDivisionId").val()
            Id: "@Model.Id"
        };
    }

    function edit_event(e) {
        if (e.model.isNew() == false) {
            if (e.model.ItemTypeId != "@PhoenixERPWebApp.Models.ItemTypeId.FixedAsset") {
                $("#ItemId").removeAttr("required", "required");
                $("#ItemCode").removeAttr("required", "required");
                $("#ItemName").removeAttr("required", "required");
                $("#CurrencySymbolExchange").removeAttr("required", "required");
            } else {
                $("#ItemId").attr("required", "required");
                $("#ItemCode").attr("required", "required");
                $("#ItemName").attr("required", "required");
                $("#CurrencySymbolExchange").attr("required", "required");
            }
        } else {
            var grid = $("#grid-PurchaseRequestDetail").data("kendoGrid").dataSource.data();
            if (grid.length == 1) {
                $("#BudgetOwnerId").data("kendoDropDownList").value("");
            }
        }
    }

    function save_event(e) {
        var ItemTypeId = $("#ItemTypeId").data("kendoDropDownList").value();
        var ItemTypeName = $("#ItemTypeId").data("kendoDropDownList").text();
        var ItemId = $("#ItemId").data("kendoDropDownList").value(); 
        var Name = $("#Name").val();
        var UnitPrice = $("#UnitPrice").data("kendoNumericTextBox").value();
        var Qty = $("#Qty").data("kendoNumericTextBox").value();
        var Amount = $("#Amount").data("kendoNumericTextBox").value();
        var UomId = $("#UomId").data("kendoDropDownList").value();
        var UomName = $("#UomId").data("kendoDropDownList").text(); 
        var ItemCode = $("#ItemCode").val();
        var ItemName = $("#ItemName").val();
        var TotalBudgetUsed = $("#TotalBudgetUsed").data("kendoNumericTextBox").value();
        var TotalBudgetBalance = $("#TotalBudgetBalance").data("kendoNumericTextBox").value();
        var CurrencySymbolExchange = $("#CurrencySymbolExchange").val();


        //reset item budget
        if (ItemId == "") {
            $("#BudgetOwnerId").data("kendoDropDownList").value("");
            $("#ItemCode").val("");
            $("#ItemName").val("");
            $("#TotalBudgetUsed").data("kendoNumericTextBox").value("");
            $("#TotalBudgetBalance").data("kendoNumericTextBox").value("");
            $("#CurrencySymbolExchange").val("");
        }

