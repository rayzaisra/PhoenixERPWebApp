    function VatPercent_Change() {
        var gridDetail = $("#grid-PurchaseRequestDetail").data("kendoGrid");
        gridDetail.saveRow();
        CallculateAll();
    }
    
    function calculate_change(e) {
        var Qty = $('#Qty').data("kendoNumericTextBox").value();
        var UnitPrice = $('#UnitPrice').data("kendoNumericTextBox").value();
        var Amount = Qty * UnitPrice;
        $('#Amount').data("kendoNumericTextBox").value(Amount);
         
        var ExchangeRate = $("#ExchangeRate").data("kendoNumericTextBox").value();
        var Operator = $("#Operator").data("kendoDropDownList").value();
        
        if(ExchangeRate!=null && Operator!=null){
            var totalOri = eval(Amount.toString() + Operator + ExchangeRate.toString()); 
            $("#AmountExchange").data("kendoNumericTextBox").value(totalOri);
        } else {
            $("#AmountExchange").data("kendoNumericTextBox").value(0);
        }
    }
    
    function CallculateAll() {
        var models = $("#grid-PurchaseRequestDetail").data("kendoGrid").dataSource.data();
        var subTotal = 0;

        $.each(models, function (index, data) {
            if (data.Amount != null) {
                subTotal += data.Amount;
            }
        });

        ReCallculateAll(subTotal);
    }

    function ReCallculateAll(subTotal) {
        var vatpercent = $('#VatPercent').data("kendoNumericTextBox").value(); 

        if (vatpercent == null) vatpercent = 0;

        var vat = (subTotal * (vatpercent / 100));
        var grandTotal = (subTotal + vat);

        $('#SubTotal').data("kendoNumericTextBox").value(subTotal);
        $('#Vat').data("kendoNumericTextBox").value(vat); 
        $('#GrandTotal').data("kendoNumericTextBox").value(grandTotal);
        $('#div_total_amount').html($("#CurrencySymbol").val()+' '+kendo.format("{0:N0}", grandTotal));
    }

    
    $('#btnApprove').click(function () {
        $("#RemarksProcess").removeAttr("required", "required");
        callAction({ formId: "formpurchaserequest", title: "approve", type: "PUT", url: '@Url.Action("approve", "purchaserequest")', objects: result()});
    });

    $('#btnReject').click(function () {
        $("#RemarksProcess").attr("required", "required");
        callAction({ formId: "formpurchaserequest", title: "reject", type: "PUT", url: '@Url.Action("reject", "purchaserequest")', objects: result()});
    });

    $('#btnSave').click(function () {
        if (!isValid()) return; 
        callActionFile({ formId: "formpurchaserequest", title: "save", type: "POST", url: '@Url.Action("save", "purchaserequest")', objects: result()});
    });

    $('#btnSubmit').click(function () {
        if (!isValid()) return; 
