@model PhoenixERPWebApp.Models.Reconcile
<style>
   /* .modallargewidth {
        width: 90%;
        max-width: 1200px;
    }*/

    .has-danger label:not([class]) {
        color: #f4516c;
    }

    .modal .modal-content .modal-header {
        padding: 15px;
    }
</style>
 
<div class="modal-dialog modal-lg">
    <!-- Modal content-->
    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title">
                <label id="lblInfo">Reconcile</label>
            </h4>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body" id="modalBodyReconcile">
            <form id="formReconcile" class="form-horizontal form-bordered" role="form" enctype="multipart/form-data">
                <input type="hidden" asp-for="CreatedBy" />
                <input type="hidden" asp-for="CreatedOn" />
                <input type="hidden" asp-for="ModifiedBy" />
                <input type="hidden" asp-for="ModifiedOn" />
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ReferenceId" />

                <div class="row ">
                    <div class="col-lg-12">
                        <div class="form-group">
                            <label asp-for="Period"></label> :
                            @Html.Kendo().DatePickerFor(m => m.Period).HtmlAttributes(new { style = "width:100%", @required = "required" })
                        </div>
                        <div class="form-group">
                            <label asp-for="Notes"></label> :
                            @Html.TextAreaFor(x => x.Notes, new { style = "height:100px;width:100%", @required = "required" })
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-primary" id="btn-save-detail" onclick="saveReconcile()">Submit</button>
            <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
        </div>
    </div>
</div> 
