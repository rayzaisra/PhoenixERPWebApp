    }

    function GetTask() {
        var RfqDetail = [];
        var gridTask = $("#grid-RequestforQuotationTaskList").data("kendoGrid");
        gridTask.saveRow();

        $.each(gridTask.dataSource.data(), function (index, data) {
            if ($("#MainserviceCategoryId").val() == "@PhoenixERPWebApp.Models.MainServiceCategoryOther.MainServiceCategoryId") {
                var data = { Id: generateUUID(), ParentTaskId: null, TaskId: data.TaskId, Task: data.Task, ItemTypeId: data.ItemTypeId, ItemId: data.ItemId, ItemCode: data.ItemCode, ItemName: data.ItemName, UomId: data.UomId, Qty: data.Quantity, UnitPrice: data.UnitPrice,  UomName: data.UomName, ItemTypeName: data.ItemTypeName, RemainingBudget: data.RemainingBudget, CurrencyId: data.CurrencyId, ExchangeRate: data.ExchangeRate, Operator: data.Operator, TotalRequest: data.TotalRequest, Amount: data.TotalPrice, TotalExchangeRequest: data.TotalExchange, CurrencySymbol: data.CurrencySymbol, CurrencySymbolRequest: data.CurrencySymbolRequest, TotalExchangeAmount: data.TotalExchange };
                RfqDetail.push(data);
            }else{
                var data = { Id: generateUUID(), ParentTaskId: null, TaskId: data.TaskId, Task: data.Task, ItemTypeId: data.ItemTypeId, ItemId: data.ItemId, ItemCode: data.ItemCode, ItemName: data.ItemName, UomId: data.UomId, Qty: data.Quantity, UnitPrice: null,  UomName: data.UomName, ItemTypeName: data.ItemTypeName, RemainingBudget: data.RemainingBudget, CurrencyId: data.CurrencyId, ExchangeRate: data.ExchangeRate, Operator: data.Operator, TotalRequest: data.TotalRequest, Amount: null, TotalExchangeRequest: data.TotalExchange, CurrencySymbol: data.CurrencySymbol, CurrencySymbolRequest: data.CurrencySymbolRequest, TotalExchangeAmount: null };
                RfqDetail.push(data);
            }
        });
        return RfqDetail;
    }

    function generateUUID() { // Public Domain/MIT
        var d = new Date().getTime();//Timestamp
        var d2 = (performance && performance.now && (performance.now() * 1000)) || 0;//Time in microseconds since page-load or 0 if unsupported
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
            var r = Math.random() * 16;//random number between 0 and 16
            if (d > 0) {//Use timestamp until depleted
                r = (d + r) % 16 | 0;
                d = Math.floor(d / 16);
            } else {//Use microseconds since page-load if supported
                r = (d2 + r) % 16 | 0;
                d2 = Math.floor(d2 / 16);
            }
            return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
        });
    }

    function AddVendor(e) {
        $("#lblInfo").html("Add");
        if (!isValidTask()) return;
        var models = $("#grid-RequestforQuotationVendorList").data("kendoGrid").dataSource.data();
        var isPreferedVendor = $("input:radio[name=IsPreferedVendor]:checked").val();
        vendorId = "";

        if ((models.length >= 1 && isPreferedVendor == "true")) {
            swal('Warning', "Can only enter one vendor if the preferred vendor", 'warning');
        } else {
            ClearDataVendor();

            var vatPercent = $("#GetVatPercent").val();
            if(vatPercent != ""){
                $("#VatPercent").data("kendoNumericTextBox").value(vatPercent);
            }
            //$("#VendorId").data("kendoDropDownList").dataSource.read();
            $('#modalVendor').modal('show');
            var task = GetTask();

            var singleTask = task[0];
            if (singleTask != null) {
                var exchangeRate = $('#ExchangeRateRequest').data('kendoNumericTextBox');
                var subtotal = $('#Subtotal').data('kendoNumericTextBox');
                var vat = $('#Vat').data('kendoNumericTextBox');
                var grandTotal = $('#GrandTotal').data('kendoNumericTextBox');

                var exchangeRateValue = exchangeRate.value();
                var subtotalValue = subtotal.value();
                var vatValue = vat.value();
                var grandTotalValue = grandTotal.value();

                exchangeRate.setOptions({ value: exchangeRateValue, format: singleTask.CurrencySymbol + " #,###.##" });
                subtotal.setOptions({ value: subtotalValue, format: singleTask.CurrencySymbolRequest + " #,###.##" });
                vat.setOptions({ value: vatValue, format: singleTask.CurrencySymbolRequest + " #,###.##" });
                grandTotal.setOptions({ value: grandTotalValue, format: singleTask.CurrencySymbolRequest + " #,###.##" });


                $("#CurrencyRequestId").data("kendoDropDownList").value(singleTask.CurrencyId);
                $("#ExchangeRateRequest").data("kendoNumericTextBox").value(singleTask.ExchangeRate);
                $("#OperatorRequest").data("kendoDropDownList").value(singleTask.Operator);
                exchangeRequestDefault(singleTask.CurrencyId);
            }

            //$("#grid-RequestforQuotationDetailList").data('kendoGrid').dataSource.data(task);
            $("#treelist-RequestforQuotationDetailList").data('kendoTreeList').dataSource.pushCreate(task);
            CallculateAll();
        }
    }

