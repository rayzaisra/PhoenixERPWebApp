    function saveDetailVendor() {
        mApp.block("#m_blockui_list", {
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        });

        $("#VatPercent").attr("required", "required");
        $("#VendorId").attr("required", "required");

        var valid = $("#formRFQ").validate().form();
        if (valid) {
            var VendorName = $("#VendorId").data("kendoDropDownList").text();

            //var gridDetail = $("#grid-RequestforQuotationDetailList").data("kendoGrid");
            var gridDetail = $("#treelist-RequestforQuotationDetailList").data('kendoTreeList');
            var gridTask = $("#grid-RequestforQuotationTaskList").data("kendoGrid");

            gridDetail.saveRow();

            if (gridDetail.dataSource.data().length==0) {
                swal('Warning', "please input vendor detail", 'warning');
                return;
            }

            var isNullUnitPrice = false;
            var isNullQty = false;
            $.each(gridDetail.dataSource.data(), function (index, data) {
                if (data.UnitPrice == null) {
                    isNullUnitPrice = true;
                    return false;
                }
                if (data.Qty == null) {
                    isNullQty = true;
                    return false;
                }
            });

            if (isNullUnitPrice == true) {
                swal('Warning', "please input unit price value in vendor detail", 'warning');
                return;
            }

            if (isNullQty == true) {
                swal('Warning', "please input qty value in vendor detail", 'warning');
                return;
            }

            $("#TempVendorName").val(VendorName);

            var dataList = {
                RequestForQuotationDetails: gridDetail.dataSource.data(),
                RequestForQuotationTasks: gridTask.dataSource.data()
            }

            callActionFile({ formId: "formRFQ", title: "save", type: "POST", url: '@Url.Action("SaveVendor", "RequestForQuotation")', objects: dataList });
        }
    }

    function AttachmentFile() {
        $("#linkdetailAttachmentDownloadFile").empty();
