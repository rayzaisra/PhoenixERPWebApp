    function editDetailVendor_event(e) {
        if (!e.model.isNew()) {
            if (e.model.ParentTaskId == null) {
                $("#Task").attr("readonly", "readonly"); 
                $("#UomId").data("kendoDropDownList").enable(false);
            } else {
                $("#Task").removeAttr("readonly");
                $("#UomId").data("kendoDropDownList").enable(true);
            }
        } else {
            $("#Task").removeAttr("readonly");
            $("#UomId").data("kendoDropDownList").enable(true);
        }

        var update = $(e.container).parent().find(".k-grid-update");
        //var cancel = $(e.container).parent().find("[data-command='canceledit']");
        //$(update).html('<button type="button" data-command="update" class="k-button k-button-icontext k-primary k-grid-update" style="display:block"><span class="k-icon k-i-check"></span> </button>');
        //$(cancel).html('<button type="button" data-command="canceledit" class="k-button k-button-icontext k-grid-cancel"><span class="k-icon k-i-cancel"></span> </button>');

        update.css("display","inline");
    }

    function boundDetailVendor_event(e) {
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);

            if (dataItem.ParentTaskId == null) {
                row.find("[data-command='destroy']").hide();
                row.find("[data-command='createchild']").show();
            }
            else {
                row.find("[data-command='destroy']").show();
                row.find("[data-command='createchild']").hide();
            }
        }
    }

    function cancelDetailVendor_event(e) {
        e.sender.cancelChanges();
        e.preventDefault();
    }
</script>