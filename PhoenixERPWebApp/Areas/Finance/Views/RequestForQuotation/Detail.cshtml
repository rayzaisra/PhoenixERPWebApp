@inject Phoenix.WebExtension.Attributes.MenuAuthorization menuAuthorization;
@model PhoenixERPWebApp.Models.RequestForQuotation
@{
    ViewData["Title"] = "Request For Quotation Detail";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";

    var privilege = await menuAuthorization.GetPrivilege("Finance", "RequestForQuotation");
    if (!privilege.IsRead && !ViewBag.IsRead) { throw new Exception("You have no authorization to the current access."); }
}
<style>
    .k-numerictextbox .k-input {
        text-align: right;
        padding-right: 10px;
    }

    td[role=gridcell] > button.k-button.k-button-icontext.k-grid-edit, 
    td[role=gridcell] > button.k-button.k-button-icontext.k-grid-update {
        box-shadow: none !important;
        background: transparent;
        border: none;
        color: green;
        margin: 0px;
