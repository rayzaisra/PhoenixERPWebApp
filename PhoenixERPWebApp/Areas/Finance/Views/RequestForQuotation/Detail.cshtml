    function saveDetailVendor_event(e) {
        //var ItemTypeId = $("#ItemTypeId").data("kendoDropDownList").value();
        //var ItemTypeName = $("#ItemTypeId").data("kendoDropDownList").text();
        //var ItemCode = $("#ItemId").data("kendoDropDownList").text();
        //var ItemId = $("#ItemId").data("kendoDropDownList").value();
        //var ItemName = $("#ItemName").val();
        var UnitPrice = $("#UnitPrice").data("kendoNumericTextBox").value();
        var Qty = $("#Qty").data("kendoNumericTextBox").value();
        //var Amount = $("#Amount").val();
        var UomId = $("#UomId").data("kendoDropDownList").value();
        var UomName = $("#UomId").data("kendoDropDownList").text();

        var Amount = $("#Amount").data("kendoNumericTextBox").value();
        var TotalExchangeAmount = $("#TotalExchangeAmount").data("kendoNumericTextBox").value();
        var ExchangeRateRequest = $("#ExchangeRateRequest").data("kendoNumericTextBox").value();

        if (e.model.ParentTaskId == null) {
            if (TotalExchangeAmount > e.model.TotalExchangeRequest) {
                swal('Warning', "The total price exchange value should not exceed the value of the original budget request", 'warning');
                e.preventDefault();
                return false;
            }
        }

        //e.model.set("ItemTypeId", ItemTypeId);
        //e.model.set("ItemTypeName", ItemTypeName);
        //e.model.set("ItemCode", ItemCode);
        //e.model.set("ItemId", ItemId);
        //e.model.set("ItemName", ItemName);
        e.model.set("UnitPrice", UnitPrice);
        e.model.set("Qty", Qty);
        e.model.set("Amount", Amount);
        e.model.set("TotalExchangeAmount", TotalExchangeAmount);
        e.model.set("ExchangeRate", ExchangeRateRequest);
        e.model.set("UomId", UomId);
        e.model.set("UomName", UomName);
        e.model.set("VendorId", $("#VendorId").data("kendoDropDownList").value());

        CallculateAll(); 
    }
     
    function calculate_change() {
        var Qty = $('#Qty').data("kendoNumericTextBox").value();
        var UnitPrice = $('#UnitPrice').data("kendoNumericTextBox").value();
        var Amount = Qty * UnitPrice;
        $('#Amount').data("kendoNumericTextBox").value(Amount);

        var ExchangeRate = $("#ExchangeRateRequest").data("kendoNumericTextBox").value();
        var Operator = $("#OperatorRequest").data("kendoDropDownList").value();
        var totalOri = eval(Amount.toString() + Operator + ExchangeRate.toString());
        $("#TotalExchangeAmount").data("kendoNumericTextBox").value(totalOri);
    }

    function VatPercent_Change() {
        //var gridDetail = $("#grid-RequestforQuotationDetailList").data("kendoGrid");
        var gridDetail = $("#treelist-RequestforQuotationDetailList").data('kendoTreeList');
        gridDetail.saveRow();
        CallculateAll();
    }

    function CallculateAll() {
        //var models = $("#grid-RequestforQuotationDetailList").data("kendoGrid").dataSource.data();
        var models = $("#treelist-RequestforQuotationDetailList").data("kendoTreeList").dataSource.data();
        var subTotal = 0;

        $.each(models, function (index, data) {
            if (data.ParentTaskId == null) {
                if (data.Amount != null) {
                    subTotal += data.Amount;
                }
            }
        });
        ReCallculateAll(subTotal);
    }


    function ReCallculateAll(subTotal) {
        $('#Subtotal').data("kendoNumericTextBox").value(subTotal);
        var vatpercent = $('#VatPercent').data("kendoNumericTextBox").value();
        if (vatpercent == null) vatpercent = 0;

        var vat = (subTotal * (vatpercent / 100));
        var grandTotal = (subTotal + vat);

        $('#Vat').data("kendoNumericTextBox").value(vat);
        $('#GrandTotal').data("kendoNumericTextBox").value(grandTotal);
    }

    function ItemType_Select(e) {
        if (e.dataItem) {
