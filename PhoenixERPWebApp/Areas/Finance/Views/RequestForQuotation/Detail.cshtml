                                                                            {
                                                                                if (ViewBag.isRequestor == true)
                                                                                {
                                                                                    if (privilege.IsAdd || privilege.IsEdit)
                                                                                    {

                                                                                        columns.Command(command =>
                                                                                        {
                                                                                            command.Edit().Text(" ").UpdateText(" ").CancelText(" ");
                                                                                        }).Title("Action").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(90);
                                                                                    }
                                                                                }
                                                                            }
                                                                            columns.Bound(p => p.ItemTypeId).ClientTemplate("#if(ItemTypeId!=null){# #=ItemTypeName# #}#").EditorTemplateName("ItemTypeDropdown").Width(150);
                                                                            //if (Model.MainserviceCategoryId==PhoenixERPWebApp.Models.MainServiceCategoryOther.MainServiceCategoryId)
                                                                            //{
                                                                            columns.Bound(p => p.ItemId).ClientTemplate("#if(ItemCode!=null){# #=ItemCode# - #=ItemName# #}#").EditorTemplateName("ItemIdDropdown").Width(150);
                                                                            //}
                                                                            columns.Bound(p => p.Task).Width(200);
                                                                            columns.Bound(p => p.Quantity).Width(70).HtmlAttributes(new { style = "text-align:right;" });
                                                                            columns.Bound(p => p.UomName).Width(100);
                                                                            if (Model.MainserviceCategoryId == PhoenixERPWebApp.Models.MainServiceCategoryOther.MainServiceCategoryId)
                                                                            {
                                                                                columns.Bound(p => p.UnitPrice).ClientTemplate("#if(CurrencySymbolRequest!=null){# #=CurrencySymbolRequest# #}# #if(UnitPrice!=null){# #=kendo.format('{0:n2}', UnitPrice)# #}#").Width(140).HtmlAttributes(new { style = "text-align:right;" });
                                                                                columns.Bound(p => p.TotalPrice).ClientTemplate("#if(CurrencySymbolRequest!=null){# #=CurrencySymbolRequest# #}# #if(TotalPrice!=null){# #=kendo.format('{0:n2}', TotalPrice)# #}#").Width(140).HtmlAttributes(new { style = "text-align:right;" });
                                                                            }
                                                                            else
                                                                            {
                                                                                columns.Bound(p => p.UnitPrice).ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(UnitPrice!=null){# #=kendo.format('{0:n2}', UnitPrice)# #}#").Width(140).HtmlAttributes(new { style = "text-align:right;" });
                                                                                columns.Bound(p => p.TotalPrice).ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(TotalPrice!=null){# #=kendo.format('{0:n2}', TotalPrice)# #}#").Width(140).HtmlAttributes(new { style = "text-align:right;" });
                                                                            }
                                                                            columns.Bound(p => p.RemainingBudget).ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(RemainingBudget!=null){# #=kendo.format('{0:n2}', RemainingBudget)# #}#").Width(140).HtmlAttributes(new { style = "text-align:right;" });
                                                                            columns.Bound(p => p.TotalRequest).ClientTemplate("#if(CurrencySymbolRequest!=null){# #=CurrencySymbolRequest# #}# #if(TotalRequest!=null){# #=kendo.format('{0:n2}', TotalRequest)# #}#").Width(140).HtmlAttributes(new { style = "text-align:right;" });
                                                                            columns.Bound(p => p.TotalExchange).ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(TotalExchange!=null){# #=kendo.format('{0:n2}', TotalExchange)# #}#").Width(140).HtmlAttributes(new { style = "text-align:right;" });
                                                                        })
                                                                        .Editable(x => x.Mode(GridEditMode.InLine).DisplayDeleteConfirmation(true))
                                                                        .DataSource(dataSource => dataSource
