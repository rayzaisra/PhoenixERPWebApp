        $('#GrandTotal').data("kendoNumericTextBox").value("");
        AttachmentFile();
        //$("#grid-RequestforQuotationDetailList").data('kendoGrid').dataSource.data([]);
        $("#treelist-RequestforQuotationDetailList").data('kendoTreeList').dataSource.data([]);
    }

    $('#btnApprove').click(function () {
        $("#RemarksProcess").removeAttr("required", "required");

        callAction({ formId: "formRFQ", title: "approve", type: "PUT", url: '@Url.Action("approve", "RequestForQuotation")'});
    });

    $('#btnReject').click(function () {
        $("#RemarksProcess").attr("required", "required");
        callAction({ formId: "formRFQ", title: "reject", type: "PUT", url: '@Url.Action("reject", "RequestForQuotation")'});
    });

    $('#btnSubmit').click(function () {
        if (!isValidTask()) return;
        if (!isValid()) return;
        var entityGrid = $("#grid-RequestforQuotationVendorList").data("kendoGrid");
        var rows = entityGrid.select();
        if (rows.length == 0) {
            swal('Warning', "choose a vendor that wins", 'warning');
            return false;
        }
         callActionFile({ formId:"formRFQ", title: "request approval", type:"POST", url: '@Url.Action("submit", "RequestForQuotation")', objects: resultSelectVendor()});
        //callAction({ formId: "formRFQ", title: "request approval", type: "POST", url: '@Url.Action("submit", "RequestForQuotation")', objects: resultSelectVendor()});
    });

    $('#btnSave').click(function () {
        if (!isValidTask()) return;
        if (!isValid()) return;
        callActionFile({ formId:"formRFQ", title: "on process", type:"POST", url: '@Url.Action("save", "RequestForQuotation")', objects: resultSelectVendor()});
        //callAction({ formId: "formRFQ", title: "on process", type: "POST", url: '@Url.Action("save", "RequestForQuotation")', objects: resultSelectVendor() });
        $("#lblstatus").html("@PhoenixERPWebApp.Models.StatusTransactionName.OnProcess");
    });

    function resultSelectVendor() {
        var entityGrid = $("#grid-RequestforQuotationVendorList").data("kendoGrid");
        var rows = entityGrid.select();
        var vendorSelect = [];
        rows.each(function (index, row) {
            var selectedItem = entityGrid.dataItem(row);
            vendorSelect.push(selectedItem);
        });

        var dataList = {
            RequestForQuotationVendors: vendorSelect
        }
        return dataList;
    }

    function isValidTask() {
        var valid = true;
        var gridTask = $("#grid-RequestforQuotationTaskList").data("kendoGrid").dataSource.data();

        $.each(gridTask, function (index, data) {
            if (data.ItemTypeId == null) {
                valid = false;
                return false;
            }
        });

        if (!valid) {
            swal('Warning', "Please fill in the name 'type' column in the rfq list", 'warning');
        }
        return valid;
    }

    function isValid() {
        $("#VatPercent").removeAttr("required", "required");
        $("#VendorId").removeAttr("required", "required");

        var valid = $("#formRFQ").validate().form();
        if (valid) {
            return true;
        } else {
            return false;
        }
    }

    function vendor_dataBound(e) {
        // iterate the table rows and apply custom row and cell styling
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);

            row.removeClass("currentApprove");
            if (dataItem.IsRequestPurchaseOrder == true) {
                row.addClass("currentApprove");
            }
        }
    }

    function MasterLocationProcurement_SelectEvent(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            $("#DeliveryPlace").val(dataItem.Text);
        }
    }

    function edittask_event(e) {
        if ($("#MainserviceCategoryId").val() != "@PhoenixERPWebApp.Models.MainServiceCategoryOther.MainServiceCategoryId") {
            $("#ItemId").removeAttr("required");
        } else {
            $("#ItemId").attr("required", "required");
        }
    }

    function itemId_bound(e) {
         if ($("#MainserviceCategoryId").val() != "@PhoenixERPWebApp.Models.MainServiceCategoryOther.MainServiceCategoryId") {
            $("#ItemId").data("kendoDropDownList").readonly(true);
        } else {
            $("#ItemId").data("kendoDropDownList").readonly(false);
        }
    }

    function savetask_event(e) {
        var ItemTypeId = $("#ItemTypeId").data("kendoDropDownList").value();
        var ItemTypeName = $("#ItemTypeId").data("kendoDropDownList").text();

        e.model.set("ItemTypeId", ItemTypeId);
        e.model.set("ItemTypeName", ItemTypeName);

         if ($("#MainserviceCategoryId").val() == "@PhoenixERPWebApp.Models.MainServiceCategoryOther.MainServiceCategoryId") {
            var ItemId = $("#ItemId").data("kendoDropDownList").value();
            e.model.set("ItemId", ItemId);
        }
    }

    //new
    function requestcurrency_select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
                 mApp.block("#m_blockui_list", {
                        overlayColor: "#000000",
                        type: "loader",
                        state: "primary",
                        message: "Processing..."
                    });

                    $.ajax({
                        type: "GET",
                        dataType: "json",
                        contentType: "application/x-www-form-urlencoded",
                        async: false,
                        data: { id: dataItem.Value },
                        url: "@Url.Action("Get", "Currency",new { area="Finance"})",
                        success: function (result) {
                            if (result != null) {
                                $("#CurrencySymbolExchange").val(result.CurrencySymbol);
                            }
                        },
                        error: function (e, t, s) {
                            console.log(e)
                            mApp.unblock("#m_blockui_list");
                        }
                    }).then(setTimeout(function () {
                        mApp.unblock("#m_blockui_list");
                    }, 2e3));
            exchangeRequestDefault(dataItem.Value);
        } else {
            exchangeRequestDefault(null);
        }
        calculaterequest_change();
    }

    function exchangeRequestDefault(value) {
        var currencyId = $("#CurrencyId").val();
         if ("@ViewBag.isRequestor" == "False") {
             $('#ExchangeRateRequest').data("kendoNumericTextBox").readonly();
         }else if (value == currencyId) {
            $("#ExchangeRateRequest").data("kendoNumericTextBox").readonly();
            //$("#OperatorRequest").data("kendoDropDownList").readonly();
            //$("#OperatorRequest").data("kendoDropDownList").value("*");
            $("#ExchangeRateRequest").data("kendoNumericTextBox").value("1");
        } else {
            $("#ExchangeRateRequest").data("kendoNumericTextBox").readonly(false);
            //$("#OperatorRequest").data("kendoDropDownList").readonly(false);
        }
    }


    function calculaterequest_change() {
        //var dataSource = $("#grid-RequestforQuotationDetailList").data("kendoGrid").dataSource;
        var dataSource = $("#treelist-RequestforQuotationDetailList").data('kendoTreeList').dataSource;

        var view = dataSource.view();
        for (var i = 0; i < view.length; i++) {
            var Total = view[i].get("TotalRequest");
            var parentId = view[i].get("ParentTaskId");
            if (parentId == null) {
                if (Total != null) {
                    var ExchangeRate = $("#ExchangeRateRequest").data("kendoNumericTextBox").value();
                    var Operator = $("#OperatorRequest").data("kendoDropDownList").value();
                    var totalOri = eval(Total.toString() + Operator + ExchangeRate.toString());

                    view[i].set("TotalExchangeAmount", totalOri);
                    view[i].set("CurrencySymbolExchange", $("#CurrencySymbolExchange").val());
                    view[i].set("ExchangeRate", ExchangeRate);
                }
            }
        }
    }

    function IntegerEditor(container, options) {
        // create input element and add the validation attribute
        var input = $('<input name="' + options.field + '" id="' + options.field + '" required="required" />');
        // set its name to the field to which the column is bound ('lastName' in this case)
        input.attr("name", options.field);
        // append it to the container
        input.appendTo(container);
        // initialize a Kendo UI AutoComplete
        input.kendoNumericTextBox({
            format: "{0:n0}",
            spinners: false,
            change: function () {
                //var value = this.value();
                calculate_change();
            }
        });
    }

