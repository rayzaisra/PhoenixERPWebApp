                                                                            .Events(events => events.Error("errorHandler"))
                                                                            .Sort(sort => sort.Add(x => x.Task).Ascending())
                                                                            .Model(model =>
                                                                            {
                                                                                model.Id(p => p.Id);
                                                                                model.Field(p => p.Task).Editable(false);
                                                                                model.Field(p => p.Quantity).Editable(false);
                                                                                model.Field(p => p.UomName).Editable(false);
                                                                                model.Field(p => p.UnitPrice).Editable(false);
                                                                                model.Field(p => p.TotalPrice).Editable(false);
                                                                                model.Field(p => p.RemainingBudget).Editable(false);
                                                                                model.Field(p => p.TotalRequest).Editable(false);
                                                                                model.Field(p => p.TotalExchange).Editable(false);
                                                                            })
                                                                            .Read(read => read.Action("ReadTask", "RequestForQuotation").Data("grid_params"))
                                                                            .Update(update => update.Action("UpdateTask", "RequestForQuotation"))
                                                                        )
                                                                        .Events(e => e.Save("savetask_event").Edit("edittask_event"))
                                                                        .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                                                    )
                                                                </div>
