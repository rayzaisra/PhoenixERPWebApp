        $("#fileDetail").kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".doc", ".pdf", ".docx", ".xls", ".xlsx", ".jpg", ".png", ".bmp", ".jpeg", ".png"]
            }
        });
    }

