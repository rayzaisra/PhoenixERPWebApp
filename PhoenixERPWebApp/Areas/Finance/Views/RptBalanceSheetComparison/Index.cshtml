@model PhoenixERPWebApp.Models.RptBalanceSheetFilter
@{
    ViewData["Title"] = "Balance Sheet Comparison";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">Balance Sheet Comparison</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Report</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="RptBalanceSheetComparison" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Balance Sheet Comparison</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">
                                Balance Sheet Comparison
                            </h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formSearch">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="LegalEntityId"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.LegalEntityId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .Events(x => x.Select("legalEntity_select"))
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetLegalEntity", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel($" ")
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%;",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.LegalEntityId)} is required"
                                        })
                                    )
                                </div>
                                <div class="form-group">
                                    <label asp-for="BusinessUnitId"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.BusinessUnitId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .Events(x => x.Select("businessUnit_select"))
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetDivisionFinance", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel($" ")
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%;",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.BusinessUnitId)} is required"
                                        })
                                    )
                                </div>
                                <div class="form-group">
                                    <label asp-for="CoaLevel"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.CoaLevel)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetDDLCOALevel", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel($" ")
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%;",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.CoaLevel)} is required"
                                        })
                                    )
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="CurrencyId"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.CurrencyId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetDDLCurrency", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel($" ")
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%;",
                                            required = "required",
                                            @readonly = "readonly",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.CurrencyId)} is required"
                                        })
                                    )
                                </div>
                                <div class="form-group">
                                    <label asp-for="EndingDate"></label> :
                                    @(Html.Kendo().DatePickerFor(m => m.EndingDate)
                                        .Start(CalendarView.Year)
                                        .Depth(CalendarView.Year)
                                        .Format("MMM yyyy")
                                        .HtmlAttributes(new 
                                        { 
                                            placeholder = $" ", 
                                            style = "width:100%",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.EndingDate)} is required"
                                        }
                                    ))
                                    @*<div class="row" style="padding:0px">
                                        <div class="col-lg-6">
                                            @(Html.Kendo().DropDownListFor(m => m.Type)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Events(e => e.Change("type_change"))
                                                .BindTo(new List<SelectListItem>() {
                                                                                new SelectListItem() { Text = "Day", Value = "Day"},
                                                    //new SelectListItem() { Text = "Month", Value = "Month"},
                                                    //new SelectListItem() { Text = "Year", Value = "Year"},
                                                })
                                                .HtmlAttributes(new { style = "width: 100%" })
                                            )
                                        </div>
                                        <div class="col-lg-6">
                                            <div id="divDate"></div>
                                        </div>
                                    </div>*@
                                </div>
                                <div class="form-group">
                                    @(Html.Kendo().CheckBoxFor(x => x.DisplayZeroBalance)
                                             .Label("Display Zero Balance")
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <button type="button" id="btnSearch" class="btn btn-primary" style="padding:7px;"><span class="fa fa-filter"></span> Filter</button>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div class="row">
                        <div class="col-lg-12">
                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.RptBalanceSheetComparison>()
                                .Name("grid")
                                .Columns(columns =>
                                {
                                    columns.Bound(p => p.name1).Width(150).ClientGroupHeaderTemplate("#=value#").Hidden();
                                    columns.Bound(p => p.code_rec).Width(120);
                                    columns.Bound(p => p.name5).Width(250).ClientGroupFooterTemplate("TOTAL :").ClientFooterTemplate("TOTAL ASSET : <br/>TOTAL LIABILITIES AND CAPITAL : <br/>").FooterHtmlAttributes(new { style = "text-align:right;" });
                                    columns.Group(g => g.Title("Balance")
                                     .Columns(location =>
                                     {
                                         location.Bound(p => p.balance_year).Title("-").Width(150).ClientGroupFooterTemplate("#=kendo.format('{0:n2}', sum)#").ClientFooterTemplate("#=window.balance_year()#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                         location.Bound(p => p.balance_month).Title("-").Width(150).ClientGroupFooterTemplate("#=kendo.format('{0:n2}', sum)#").ClientFooterTemplate("#=window.balance_month()#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                     })
                                  );
                                    columns.Bound(p => p.diference).Width(150).ClientGroupFooterTemplate("#=kendo.format('{0:n2}', sum)#").ClientFooterTemplate("#=window.diference()#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                    columns.Group(g => g.Title("Balance")
                                     .Columns(location =>
                                     {
                                         location.Bound(p => p.balance_now).Title("-").Width(150).ClientGroupFooterTemplate("#=kendo.format('{0:n2}', sum)#").ClientFooterTemplate("#=window.balance_now()#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                     })
                                  );
                                })
                                .ToolBar(toolBar =>
                                {
                                    toolBar.Excel();
                                    toolBar.Pdf();
                                })
                                .Excel(excel => excel.AllPages(true)
                                    .FileName("Balance Sheet Comparison.xlsx")
                                    .Filterable(true)
                                )
                                .Pdf(pdf => pdf
                                    .AllPages()
                                    .AvoidLinks()
                                    .PaperSize("A3")
                                    .Margin("5.5cm", "1cm", "1cm", "1cm")
                                    .Landscape()
                                    .RepeatHeaders()
                                    .TemplateId("page-template")
                                    .FileName("Balance Sheet Comparison.pdf")
                                )
                                //.Pageable(pageable => pageable
                                //    .Refresh(true)
                                //    .PageSizes(true)
                                //    .ButtonCount(5))
                                //.Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                //.Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                                //    .Extra(false)
                                //    .Operators(operators => operators
                                //    .ForString(str => str.Clear()
                                //        .Contains("Contains")
                                //        .StartsWith("Start sWith")
                                //        .EndsWith("End sWith")
                                //    )))
                                .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                .Resizable(rsz => rsz.Columns(true))
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    //.PageSize(10)
                                    .Events(events => events.Error("errorHandler"))
                                    .Model(model => { model.Id(p => p.account_id); })
                                    .Aggregates(aggregates =>
                                    {
                                        aggregates.Add(p => p.balance_year).Sum();
                                        aggregates.Add(p => p.balance_month).Sum();
                                        aggregates.Add(p => p.balance_now).Sum();
                                        aggregates.Add(p => p.diference).Sum();
                                    })
                                    .Group(grp => grp.Add(p => p.name1))
                                    .Sort(sort => sort.Add(p => p.code_rec).Ascending())
                                    .Read(read => read.Action("Read", "RptBalanceSheetComparison").Data("gridParams"))
                                )
                            .AutoBind(false)
                            .Events(e => e.ExcelExport("customeExcelExportEvent").DataBound("grid_bound"))
                            )
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .k-grid-footer td {
        vertical-align: top;
    } 
</style>

<script type="x/kendo-template" id="page-template">
    <div class="page-template">
        <div class="header">
            <div class="page">Page #: pageNum # of #: totalPages #</div> 
            @*#if(pageNum==1){#*@
                #=LoadPDF()#            
            @*#}#*@
        </div>
        @*<div class="watermark">KENDO UI</div>
        <div class="footer">
            Page #: pageNum # of #: totalPages #
        </div>*@
    </div>
</script>

<script> 
    $(document).ready(function () {
        //type_change();
        $('#grid').data('kendoGrid').dataSource.read();
    });

    function gridParams() {
        return {
            Filter: {
                LegalEntityId: $("#LegalEntityId").data("kendoDropDownList").value(),
                BusinessUnitId: $("#BusinessUnitId").data("kendoDropDownList").value(),
                //Type: $("#Type").data("kendoDropDownList").value(),
                EndingDate: $("#EndingDate").data("kendoDatePicker").value(),
                CurrencyId: $("#CurrencyId").data("kendoDropDownList").value(),
                DisplayZeroBalance: $("#DisplayZeroBalance").is(':checked'),
                CoaLevel: $("#CoaLevel").data("kendoDropDownList").value()
            }
        }
    }

    $('#btnSearch').click(function () {
        var valid = $("#formSearch").validate().form();
        if (valid) {
            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $('#grid').data('kendoGrid').dataSource.read();
            $('#grid').data('kendoGrid').refresh();

            var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var date = $("#EndingDate").data("kendoDatePicker").value();
            var year = date.getFullYear();
            var month = date.getMonth();

            var oldyear = "Dec " + (year - 1);
            var oldMonth = monthNames[month - 1] + " " + (year);
            var currentMonth = monthNames[month] + " " + (year);

            if (month > 1) {
                oldMonth = "Jan - " + oldMonth;
            }

            $("#grid").data("kendoGrid").columns[3].columns[0].title = oldyear;
            $("#grid").data("kendoGrid").columns[3].columns[1].title = oldMonth;
            $("#grid").data("kendoGrid").columns[5].columns[0].title = currentMonth;
            //$("#grid th[data-field=balance_year]").contents().last().replaceWith("MiddleName");

            $("#grid th[data-field=balance_year]").html(oldyear);
            $("#grid th[data-field=balance_month]").html(oldMonth);
            $("#grid th[data-field=balance_now]").html(currentMonth);

            mApp.unblock("#m_blockui_list");
        }
    });

    function businessUnit_select(e) {
        if (e.dataItem) {
            //$("#LegalEntityId").data("kendoDropDownList").readonly(e.dataItem.Value != "");
            if (e.dataItem.Value != "") {
                $("#LegalEntityId").removeAttr("required");
                $("#LegalEntityId-error").css("display", "none");
                $("#LegalEntityId").data("kendoDropDownList").value("");
            } else {
                $("#LegalEntityId").attr("required", "required");
                $("#LegalEntityId-error").css("display", "block");
            }
        }
    }

    function legalEntity_select(e) {
        if (e.dataItem) {
            //$("#BusinessUnitId").data("kendoDropDownList").readonly(e.dataItem.Value != "");
            if (e.dataItem.Value != "") {
                $("#BusinessUnitId").removeAttr("required");
                $("#BusinessUnitId-error").css("display", "none");
                $("#BusinessUnitId").data("kendoDropDownList").value("");
            } else {
                $("#BusinessUnitId").attr("required", "required");
                $("#BusinessUnitId-error").css("display", "block");
            }
        }
    }

    function balance_year() {
        var models = $("#grid").data("kendoGrid").dataSource.data();
        var asset = 0;
        var liabilities = 0;
        var capital = 0;

        $.each(models, function (index, data) {
            var balance_year = data.aggregates.balance_year.sum;
            if (data.value == "1. ASSETS") {
                asset += balance_year;
            } else if (data.value == "2. LIABILITIES") {
                liabilities += balance_year;
            } else if (data.value == "3. CAPITAL") {
                capital += balance_year;
            }
        });

        var result = kendo.format('{0:n2}', asset) + "<br/>" + kendo.format('{0:n2}', (liabilities + capital)) + "<br/>";
        var balance_year = asset - (liabilities + capital);
        if (balance_year != 0) result += "UNBALANCE";
        else result += "BALANCE";
        return result;
    }

    function balance_month() {
        var models = $("#grid").data("kendoGrid").dataSource.data();
        var asset = 0;
        var liabilities = 0;
        var capital = 0;

        $.each(models, function (index, data) {
            var balance_month = data.aggregates.balance_month.sum;
            if (data.value == "1. ASSETS") {
                asset += balance_month;
            } else if (data.value == "2. LIABILITIES") {
                liabilities += balance_month;
            } else if (data.value == "3. CAPITAL") {
                capital += balance_month;
            }
        });

        var result = kendo.format('{0:n2}', asset) + "<br/>" + kendo.format('{0:n2}', (liabilities + capital)) + "<br/>";
        var balance_month = asset - (liabilities + capital);
        if (balance_month != 0) result += "UNBALANCE";
        else result += "BALANCE";
        return result;
    }

    function diference() {
        var models = $("#grid").data("kendoGrid").dataSource.data();
        var asset = 0;
        var liabilities = 0;
        var capital = 0;

        $.each(models, function (index, data) {
            var diference = data.aggregates.diference.sum;
            if (data.value == "1. ASSETS") {
                asset += diference;
            } else if (data.value == "2. LIABILITIES") {
                liabilities += diference;
            } else if (data.value == "3. CAPITAL") {
                capital += diference;
            }
        });

        var result = kendo.format('{0:n2}', asset) + "<br/>" + kendo.format('{0:n2}', (liabilities + capital)) + "<br/>";
        var diference = asset - (liabilities + capital);
        if (diference != 0) result += "UNBALANCE";
        else result += "BALANCE";
        return result;
    }

    function balance_now() {
        var models = $("#grid").data("kendoGrid").dataSource.data();
        var asset = 0;
        var liabilities = 0;
        var capital = 0;

        $.each(models, function (index, data) {
            var balance_now = data.aggregates.balance_now.sum;
            if (data.value == "1. ASSETS") {
                asset += balance_now;
            } else if (data.value == "2. LIABILITIES") {
                liabilities += balance_now;
            } else if (data.value == "3. CAPITAL") {
                capital += balance_now;
            }
        });

        var result = kendo.format('{0:n2}', asset) + "<br/>" + kendo.format('{0:n2}', (liabilities + capital)) + "<br/>";
        var balance_now = asset - (liabilities + capital);
        if (balance_now != 0) result += "UNBALANCE";
        else result += "BALANCE";
        return result;
    }

    //function type_change() {
    //    var type = $("#Type").data("kendoDropDownList").value();
    //    if (type == "Month") {
    //        $("#divDate").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder=' ' required/>");
    //        $("#EndingDate").kendoDatePicker({
    //            format: "MMM yyyy",
    //            start: "year",
    //            depth: "year"
    //        });
    //    } else if (type == "Year") {
    //        $("#divDate").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder=' ' required/>");
    //        $("#EndingDate").kendoDatePicker({
    //            format: "yyyy",
    //            start: "decade",
    //            depth: "decade"
    //        });
    //    } else {
    //        $("#divDate").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder=' ' required/>");
    //        $("#EndingDate").kendoDatePicker({
    //            format: "dd MMM yyyy",
    //            start: "month",
    //            depth: "month"
    //        });
    //    }
    //}

    function customeExcelExportEvent(e) {
        var sheet = GetBodyExportExcel(e)
        sheet.frozenRows = 7;
        sheet.mergedCells = ["A1:B1", "A2:B2", "A3:B3", "A4:B4", "A5:B5"];
        //sheet.name = "Header";

        var date = $("#EndingDate").val();
        var currency = $("#CurrencyId").data("kendoDropDownList").text();
        var coaLevel = $("#CoaLevel").data("kendoDropDownList").text();
        var bu = $("#BusinessUnitId").data("kendoDropDownList").text();
        var legal = $("#LegalEntityId").data("kendoDropDownList").text();

        sheet.rows.splice(0, 0, { cells: [{ value: "Date", bold: true }, { value: date, bold: true }], type: "header", height: 20 });
        sheet.rows.splice(0, 0, { cells: [{ value: "Currency", bold: true }, { value: currency, bold: true }], type: "header", height: 20 });
        sheet.rows.splice(0, 0, { cells: [{ value: "COA Level", bold: true }, { value: coaLevel, bold: true }], type: "header", height: 20 });
        sheet.rows.splice(0, 0, { cells: [{ value: "Business Unit", bold: true }, { value: bu, bold: true }], type: "header", height: 20 });
        sheet.rows.splice(0, 0, { cells: [{ value: "Legal Entity", bold: true }, { value: legal, bold: true }], type: "header", height: 20 });
    }

    function grid_bound(e) {
        var date = $("#EndingDate").data("kendoDatePicker").value(); 
        var month = date.getMonth(); 
        if (month == 0) {
            this.hideColumn(e.sender.columns[3].columns[1]);
        } else {
            this.showColumn(e.sender.columns[3].columns[1]);
        }
    }

    function LoadPDF() {
        var date = $("#EndingDate").val();
        var currency = $("#CurrencyId").data("kendoDropDownList").text();
        var coaLevel = $("#CoaLevel").data("kendoDropDownList").text();
        var bu = $("#BusinessUnitId").data("kendoDropDownList").text();
        var legal = $("#LegalEntityId").data("kendoDropDownList").text();

        return "<table>"+
                "<tr>"+
                    "<td style='width:200px;'>Legal Entity</td>"+
                    "<td>:</td>"+
                    "<td>"+legal+"</td>"+
                "</tr>"+
                "<tr>"+
                    "<td>Business Unit</td>"+
                    "<td>:</td>"+
                    "<td>"+bu+"</td>"+
                "</tr>"+
                "<tr>"+
                    "<td>COA Level</td>"+
                    "<td>:</td>"+
                    "<td>"+coaLevel+"</td>"+
                "</tr>"+
                "<tr>"+ 
                    "<td>Currency</td>"+
                    "<td>:</td>"+
                    "<td>"+currency+"</td>"+
                "</tr>"+
                "<tr>"+
                    "<td>Date</td>"+
                    "<td>:</td>"+
                    "<td>"+date+"</td>"+
                "</tr>"+ 
            "</table>";
    }
</script>