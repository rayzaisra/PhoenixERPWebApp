@model PhoenixERPWebApp.Models.RptBillingAndRevenueFilter
@{ 
    ViewData["Title"] = "Billing and Revenue Business Unit";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">Billing and Revenue Business Unit</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Report</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="RptBillingAndRevenueBusinessUnit" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Billing and Revenue Business Unit</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">
                                Billing and Revenue Business Unit <span id="lblType"></span>
                            </h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">                    
                    <form id="formSearch" >
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="EndingDate"></label> :
                                    <div class="row" style="padding:0px">
                                        <div class="col-lg-6">
                                            @(Html.Kendo().DropDownListFor(m => m.DateType)
                                                 .DataTextField("Text")
                                                 .DataValueField("Value")
                                                 .Events(e => e.Change("type_change"))
                                                 .BindTo(new List<SelectListItem>() {
                                                     new SelectListItem() { Text = "Day", Value = "Day"},
                                                     new SelectListItem() { Text = "Month", Value = "Month"},
                                                     new SelectListItem() { Text = "Year", Value = "Year"},
                                                    new SelectListItem() { Text = "Custom Range", Value = "Custom Range"}
                                                 })
                                                 .HtmlAttributes(new { style = "width: 100%" })
                                            )
                                        </div>
                                        <div class="col-lg-6">
                                            <div id="divDate"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="row" style="padding:0px">
                                        <div class="col-lg-6">
                                            <div id="divDateStart"></div>
                                        </div>
                                        <div class="col-lg-6">
                                            <div id="divDateEnd"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label asp-for="MainServiceCategoryId"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.MainServiceCategoryId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetDDLMainserviceCategoryNotOthers", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel($" ")
                                        .HtmlAttributes(new
                                                {
                                            style = "width:100%;",
                                            //required = "required",
                                            //validationmessage = $"{Html.DisplayNameFor(m => m.MainServiceCategoryId)} is required",
                                            //@readonly = "readonly"
                                        })
                                    )
                                </div>
                            </div>
                            <div class="col-lg-6">                                
                                <div class="form-group"> 
                                    <label asp-for="CurrencyId"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.CurrencyId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetDDLCurrency", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel($" ")
                                        .HtmlAttributes(new {
                                            style = "width:100%;",
                                            required = "required",
                                            @readonly= "readonly",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.CurrencyId)} is required"
                                        })
                                    )
                                </div>
                                <div class="form-group">
                                    <label asp-for="BusinessUnitId"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.BusinessUnitId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains) 
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetDivisionFinance", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel($" ")
                                        .HtmlAttributes(new {
                                            style = "width:100%;",
                                            //required = "required",
                                            //validationmessage = $"{Html.DisplayNameFor(m => m.BusinessUnitId)} is required"
                                        })
                                    )
                                </div> 
                            </div>       
                        </div>  
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <button type="button" id="btnSearch" class="btn btn-primary" style="padding:7px;"><span class="fa fa-filter"></span> Filter</button>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div class="row">
                        <div class="col-lg-12">
                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.RptBillingAndRevenueBusinessUnit>()
                                .Name("grid")
                                .Columns(columns =>
                                {
                                    //columns.Bound("").Title("#").Width(35).Filterable(false).HtmlAttributes(new { style = "text-align:center;", @class = "row-number" }).HeaderHtmlAttributes(new { style = "text-align:center;" });
                                    columns.Bound(p => p.business_unit_name).Width(250);
                                    columns.Bound(p => p.MSC).Width(130).ClientFooterTemplate("Total").FooterHtmlAttributes(new { style = "text-align:right;" });
                                    columns.Group(group =>
                                        group.Title("Closed Current Year")
                                         .Columns(columnGroup =>
                                         {
                                             columnGroup.Bound(p => p.ccy_revenue).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                             columnGroup.Bound(p => p.ccy_billing).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                             columnGroup.Bound(p => p.ccy_margin).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                         })
                                    );

                                    columns.Group(group =>
                                        group.Title("Closed Carry Over Job")
                                        .Columns(columnGroup =>
                                        {
                                            columnGroup.Bound(p => p.cco_revenue).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                            columnGroup.Bound(p => p.cco_billing).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                            columnGroup.Bound(p => p.cco_margin).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                        })
                                    );

                                    columns.Group(group =>
                                        group.Title("Total Closed")
                                        .Columns(columnGroup =>
                                        {
                                            columnGroup.Bound(p => p.tc_revenue).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                            columnGroup.Bound(p => p.tc_billing).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                            columnGroup.Bound(p => p.tc_margin).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                        })
                                    );

                                    columns.Group(group =>
                                       group.Title("Total Unclosed Current year")
                                       .Columns(columnGroup =>
                                       {
                                           columnGroup.Bound(p => p.tu_billing).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                           columnGroup.Bound(p => p.tu_wip).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                           columnGroup.Bound(p => p.tu_margin).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                       })
                                   );

                                    columns.Group(group =>
                                       group.Title("Total Unclosed Carry Over")
                                       .Columns(columnGroup =>
                                       {
                                           columnGroup.Bound(p => p.cco_tu_billing).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                           columnGroup.Bound(p => p.cco_tu_wip).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                           columnGroup.Bound(p => p.cco_tu_margin).Width(150).ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                       })
                                   );

                                })
                                .ToolBar(toolBar =>
                                {
                                    toolBar.Excel();
                                    toolBar.Pdf();
                                })
                                .Excel(excel => excel.AllPages(true)
                                    .FileName("Billing and Revenue Business Unit.xlsx")
                                    .Filterable(true)
                                ) 
                                .Pdf(pdf => pdf
                                    .AllPages()
                                    .AvoidLinks()
                                    .PaperSize("A0")
                                    .Margin("5cm", "1cm", "1cm", "1cm")
                                    .Landscape()
                                    .RepeatHeaders()
                                    .TemplateId("page-template")
                                    .FileName("Billing and Revenue Business Unit.pdf")
                                )
                                .Pageable(pageable => pageable
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
                                .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                                    .Extra(false)
                                    .Operators(operators => operators
                                    .ForString(str => str.Clear()
                                        .Contains("Contains")
                                        .StartsWith("Start sWith")
                                        .EndsWith("End sWith")
                                    )))
                                .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                .Resizable(rsz => rsz.Columns(true))
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .PageSize(10)
                                    .Events(events => events.Error("errorHandler"))
                                    //.Model(model => { model.Id(p => p.id); }) 
                                    .Aggregates(aggregates =>
                                    {
                                        aggregates.Add(p => p.ccy_revenue).Sum();
                                        aggregates.Add(p => p.ccy_billing).Sum();
                                        aggregates.Add(p => p.ccy_margin).Sum();
                                        aggregates.Add(p => p.cco_revenue).Sum();
                                        aggregates.Add(p => p.cco_billing).Sum();
                                        aggregates.Add(p => p.cco_margin).Sum();
                                        aggregates.Add(p => p.tc_revenue).Sum();
                                        aggregates.Add(p => p.tc_billing).Sum();
                                        aggregates.Add(p => p.tc_margin).Sum();
                                        aggregates.Add(p => p.tu_billing).Sum();
                                        aggregates.Add(p => p.tu_wip).Sum();
                                        aggregates.Add(p => p.tu_margin).Sum();
                                        aggregates.Add(p => p.cco_tu_billing).Sum();
                                        aggregates.Add(p => p.cco_tu_wip).Sum();
                                        aggregates.Add(p => p.cco_tu_margin).Sum();
                                    })
                                    .Read(read => read.Action("Read", "RptBillingAndRevenueBusinessUnit").Data("gridParams"))
                                )
                                .AutoBind(false)
                                .Events(e => e.ExcelExport("customeExcelExportEvent").PdfExport("pdfExportEvent"))
                            )
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 
<script type="x/kendo-template" id="page-template">
    <div class="page-template">
        <div class="header">
            <div class="page">Page #: pageNum # of #: totalPages #</div> 
            @*#if(pageNum==1){#*@
                #=LoadPDF()#            
            @*#}#*@
        </div>
        @*<div class="watermark">KENDO UI</div>
        <div class="footer">
            Page #: pageNum # of #: totalPages #
        </div>*@
    </div>
</script>
<script>    
    $(document).ready(function () {
        type_change();
        $('#grid').data('kendoGrid').dataSource.read();
    });
          
    function gridParams() { 
        return {
            Filter: { 
                BusinessUnitId: $("#BusinessUnitId").data("kendoDropDownList").value(), 
                MainServiceCategoryId: $("#MainServiceCategoryId").data("kendoDropDownList").value(),
                StartingDate:  $("#StartingDate").data("kendoDatePicker") == undefined ? undefined : kendo.format('{0:yyyy/MM/dd}', $("#StartingDate").data("kendoDatePicker").value()),
                EndingDate: $("#EndingDate").data("kendoDatePicker").value(),
                CurrencyId: $("#CurrencyId").data("kendoDropDownList").value(), 
                DateType: $("#DateType").data("kendoDropDownList").value()
            }
        }
    }

    $('#btnSearch').click(function () {
        var valid = $("#formSearch").validate().form();
        if (valid) {
            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $('#grid').data('kendoGrid').dataSource.read();
            $('#grid').data('kendoGrid').refresh();

            mApp.unblock("#m_blockui_list");
        }
    });
     
    function type_change() {
        var type = $("#DateType").data("kendoDropDownList").value();        
        $("#divDate").empty();
        $("#divDateStart").empty();
        $("#divDateEnd").empty();

        if (type == "Month") {
            $("#divDate").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder='Choose a Month' required/>");
            $("#EndingDate").kendoDatePicker({
                format: "MMM yyyy",
                start: "year",
                depth: "year",
                value: new Date(@Model.EndingDate.Value.Year, @Model.EndingDate.Value.Month-1, @Model.EndingDate.Value.Day)
            });
        } else if (type == "Year") {
            $("#divDate").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder='Choose a Year' required/>");
            $("#EndingDate").kendoDatePicker({
                format: "yyyy",
                start: "decade",
                depth: "decade",
                value: new Date(@Model.EndingDate.Value.Year, @Model.EndingDate.Value.Month-1, @Model.EndingDate.Value.Day)
            });
        }else if (type == "Custom Range") {
             $("#divDateStart").empty().append("<input name='StartingDate' id='StartingDate' type='text' style='width: 100%;' placeholder='Start' required/>");
             $("#divDateEnd").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder='End' required/>");

             $("#StartingDate").kendoDatePicker({
                format: "dd MMM yyyy",
                start: "month",
                depth: "month",
                value: new Date(@Model.EndingDate.Value.Year, @Model.EndingDate.Value.Month-1, @Model.EndingDate.Value.Day)
             });

            $("#EndingDate").kendoDatePicker({
                format: "dd MMM yyyy",
                start: "month",
                depth: "month",
                value: new Date(@Model.EndingDate.Value.Year, @Model.EndingDate.Value.Month-1, @Model.EndingDate.Value.Day)
            });
        } else {
            $("#divDate").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder='Choose a Day' required/>");
            $("#EndingDate").kendoDatePicker({
                format: "dd MMM yyyy",
                start: "month",
                depth: "month",
                value: new Date(@Model.EndingDate.Value.Year, @Model.EndingDate.Value.Month-1, @Model.EndingDate.Value.Day)
            });
        }
    }

    function customeExcelExportEvent(e) {
        var sheet = GetBodyExportExcel(e)
        sheet.frozenRows = 6;
        //sheet.mergedCells = ["A1:B1", "A2:B2", "A3:B3", "A4:B4", "A5:B5", "A6:B6", "A7:B7"];
        //sheet.name = "Header";

        var currency = $("#CurrencyId").data("kendoDropDownList").text();
        //var coaLevel = $("#CoaLevel").data("kendoDropDownList").text(); 
        var bu = $("#BusinessUnitId").data("kendoDropDownList").text();
        //var legal = $("#LegalEntityId").data("kendoDropDownList").text();
        //var client = $("#ClientId").data("kendoDropDownList").text();
        var mainServiceCategory = $("#MainServiceCategoryId").data("kendoDropDownList").text();
        var date = $("#EndingDate").val();

        sheet.rows.splice(0, 0, { cells: [{ value: "Currency", bold: true }, { value: currency, bold: true }], type: "header", height: 20 });
        //sheet.rows.splice(0, 0, { cells: [{ value: "COA Level", bold: true }, { value: coaLevel, bold: true }], type: "header", height: 20 }); 
        sheet.rows.splice(0, 0, { cells: [{ value: "Business Unit", bold: true }, { value: bu, bold: true }], type: "header", height: 20 });
        //sheet.rows.splice(0, 0, { cells: [{ value: "Legal Entity", bold: true }, { value: legal, bold: true }], type: "header", height: 20 });
        //sheet.rows.splice(0, 0, { cells: [{ value: "Client Name", bold: true }, { value: client, bold: true }], type: "header", height: 20 });
        sheet.rows.splice(0, 0, { cells: [{ value: "Main Service Category", bold: true }, { value: mainServiceCategory, bold: true }], type: "header", height: 20 });
        sheet.rows.splice(0, 0, { cells: [{ value: "Date", bold: true }, { value: date, bold: true }], type: "header", height: 20 });
    }

    function LoadPDF() {

        var currency = $("#CurrencyId").data("kendoDropDownList").text();
        //var coaLevel = $("#CoaLevel").data("kendoDropDownList").text(); 
        var bu = $("#BusinessUnitId").data("kendoDropDownList").text();
        //var legal = $("#LegalEntityId").data("kendoDropDownList").text();
        //var client = $("#ClientId").data("kendoDropDownList").text();
        var mainServiceCategory = $("#MainServiceCategoryId").data("kendoDropDownList").text();
        var date = $("#EndingDate").val();

        return "<table>"+
                "<tr>"+
                    "<td style='width:200px;'>Date</td>"+
                    "<td>:</td>"+
                    "<td>"+date+"</td>"+
                "</tr>"+
                "<tr>"+
                    "<td>Main Service Category</td>"+
                    "<td>:</td>"+
                    "<td>"+mainServiceCategory+"</td>"+
                "</tr>"+
                "<tr>"+
                    "<td>Business Unit</td>"+
                    "<td>:</td>"+
                    "<td>"+bu+"</td>"+
                "</tr>"+
                "<tr>"+ 
                    "<td>Currency</td>"+
                    "<td>:</td>"+
                    "<td>"+currency+"</td>"+
                "</tr>"+ 
            "</table>";
    }
</script>