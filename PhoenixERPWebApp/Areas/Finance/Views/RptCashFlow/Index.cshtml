@model PhoenixERPWebApp.Models.RptCashFlowFilter
@{ 
    ViewData["Title"] = "CashFlow";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">CashFlow</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Report</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="RptCashFlow" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">CashFlow</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">
                                CashFlow
                            </h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body">             
                    <form id="formSearch" >
                        <div class="row">  
                            <div class="col-lg-6">  
                                <div class="form-group"> 
                                    <label asp-for="CurrencyId"></label> <span class="req">*</span> :
                                    @(Html.Kendo().DropDownListFor(m => m.CurrencyId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetDDLCurrency", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel($" ")
                                        .HtmlAttributes(new {
                                            style = "width:100%;",
                                            required = "required", 
                                            validationmessage = $"{Html.DisplayNameFor(m => m.CurrencyId)} is required"
                                        })
                                    )
                                </div>                                 
                                <div class="form-group">
                                    <label asp-for="BankId"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.BankId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .OptionLabel($" ")
                                        .HtmlAttributes(new { style = "width:100%;" })
                                        .Filter(FilterType.Contains) 
                                        .DataSource(source => source
                                            .Custom()
                                            .Transport(transport => transport
                                            .Read(read =>
                                            {
                                                read.Action("GetDDLBanksList", "Dropdown");
                                            }))//;
                                            .ServerFiltering(false)
                                        ))
                                </div>    
                            </div>
                            <div class="col-lg-6"> 
                                <div class="form-group">
                                    <label>Date</label> <span class="req">*</span> : <br/>
                                    @(Html.Kendo().DatePickerFor(m => m.StartDate) 
                                        .HtmlAttributes(new
                                        {
                                            style = "width:45%",
                                            @placeholder = $" ",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.EndingDate)} is required"
                                        })
                                    )              
                                    @(Html.Kendo().DatePickerFor(m => m.EndingDate) 
                                        .HtmlAttributes(new
                                        {
                                            style = "width:45%",
                                            @placeholder = $" ",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.EndingDate)} is required"
                                        })
                                    )                                 
                                </div>
                            </div>
                        </div>  
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <button type="button" id="btnSearch" class="btn btn-primary" style="padding:7px;"><span class="fa fa-filter"></span> Filter</button>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div class="row">
                        <div class="col-lg-12">
                            <div id="divGrid">No records available.</div> 
                        </div>
                    </div> 
                </div>
            </div>
        </div>
    </div>
</div> 

<script type="x/kendo-template" id="page-template">
    <div class="page-template">
        <div class="header">
            <div class="page">Page #: pageNum # of #: totalPages #</div> 
            @*#if(pageNum==1){#*@
                #=LoadPDF()#            
            @*#}#*@
        </div>
        @*<div class="watermark">KENDO UI</div>
        <div class="footer">
            Page #: pageNum # of #: totalPages #
        </div>*@
    </div>
</script>

<script>      
    $(document).ready(function () {
        LoadData();
    });

    $('#btnSearch').click(function () {
        var valid = $("#formSearch").validate().form();
        if (valid) {
            LoadData();
        }
    });  

    function LoadData() {
         mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            }); 

             $.ajax({
                type: "GET",
                url: '@Url.Action("GetGenerateList", "RptCashFlow")',
                 data: { 
                     StartDate: kendo.format('{0:yyyy/MM/dd}', $("#StartDate").data("kendoDatePicker").value()),
                     EndingDate: kendo.format('{0:yyyy/MM/dd}', $("#EndingDate").data("kendoDatePicker").value()),
                     CurrencyId: $("#CurrencyId").data("kendoDropDownList").value(),
                     BankId: $("#BankId").data("kendoDropDownList").value()
                 },
                dataType: 'json',
                aync: false,
                success: function (result) {
                    if (result.success) {
                        generateGrid(result); 
                    } else {
                        swal('Error', result.message, 'error');
                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    var errorMessage = e.responseJSON.errorMessage;
                    if (errorMessage === "" || errorMessage === undefined) {
                        errorMessage = "Ooops, something went wrong !";
                    }
                    console.log(errorMessage);
                    mApp.unblock("#m_blockui_list");
                }
            });
            //mApp.unblock("#m_blockui_list");
    }

    function generateGrid(result) {
        if (result.Data != null) {
            var amoutColumn = 0;
            for (var property in result.Data[0]) {
                amoutColumn++;
            }

            var paperSize = "A0"; 
            if (amoutColumn < 6)
                paperSize = "A4";
            else if (amoutColumn < 8)
                paperSize = "A3";
            else if (amoutColumn < 9)
                paperSize = "A2";
            else if (amoutColumn < 10)
                paperSize = "A1";

            var model = generateModel(result.Data[0]); 
            $("#divGrid").empty().kendoGrid({
                dataSource: {
                    data: result.Data,
                    model: model,
                    //pageSize: 10,
                    group: {
                        field: "type",
                        aggregates: AggregatesGeneration(result.Data)
                    },
                    aggregate: AggregatesGeneration(result.Data),
                },
                //height: 350,
                //groupable: true,
                //sortable: true,
                //pageable: {
                //    refresh: true,
                //    pageSizes: true,
                //    buttonCount: 5
                //},
                resizable: true,
                columns: ColumnGeneration(result.Data),
                toolbar: ["excel", "pdf"],
                excel: {
                    fileName: "CashFlow.xlsx",
                    filterable: true
                },
                pdf: {
                    allPages: true,
                    avoidLinks: true,
                    paperSize: paperSize,
                    margin: { top: "4cm", left: "1cm", right: "1cm", bottom: "1cm" },
                    landscape: true,
                    repeatHeaders: true,
                    template: $("#page-template").html(),
                    scale: 0.8,
                    fileName: "CashFlow.pdf"
                }, 
                excelExport: function (e) { customeExcelExportEvent(e) },
            }).data('kendoGrid');
        } else {
            $("#divGrid").empty().append("<div>No records available.</div>");
        }
    }

    function generateModel(result) {
        var model = {};
        model.id = "id";
        var fields = {};
        for (var property in result) {
            var propType = typeof result[property];
            if (propType == "number") {
                fields[property] = {
                    type: "number",
                    nullable: true
                    //validation: {
                    //    required: true
                    //}
                };
            } else if (propType == "boolean") {
                fields[property] = {
                    type: "boolean",
                    nullable: true
                    //validation: {
                    //    required: true
                    //}
                };
            } else if (propType == "string") {
                var parsedDate = kendo.parseDate(result[property]);
                if (parsedDate) {
                    fields[property] = {
                        type: "date",
                        nullable: true
                        //validation: {
                        //    required: true
                        //}
                    };
                    //dateFields.push(property);
                } else {
                    fields[property] = {
                        type: "string",
                        nullable: true
                        //validation: {
                        //    required: true
                        //}
                    };
                }
            } else {
                fields[property] = {
                    type: "string",
                    nullable: true
                    //validation: {
                    //    required: true
                    //}
                };
            }

        }
        model.fields = fields;

        return model;
    }

    function ColumnGeneration(result) {
        var GridColumnGeneration = [];
        var resultVal = [];
        $.each(result, function (index, value) {
            $.each(result[index], function (gridTitle, element) {
                var propType = typeof element;
                if (propType == "number") {
                    resultVal.push({ text: gridTitle, value: element, type: value.type })
                }
            });
        });

        $.each(result[0], function (gridTitle, element) {
            if (gridTitle != "id") {
                var propType = typeof element;
                var title = gridTitle.replaceAll("rpt_", "").replaceAll("_", " ");
                var width = 150;
                if (propType == "number") { 
                    GridColumnGeneration.push({
                        title: title,
                        field: gridTitle,
                        width: width,
                        format: "{0:n2}",
                        aggregates: ["sum"],
                        //groupFooterTemplate: "#=kendo.format('{0:n2}',sum)#",
                        footerTemplate: "#=kendo.format('{0:n2}',sum)#", 
                        attributes: { style: "text-align: right;" },
                        footerAttributes: { style: "text-align: right;" }
                    });
                }
                //else if (gridTitle == "rpt_Date") {
                //    GridColumnGeneration.push({
                //        title: title,
                //        field: gridTitle,
                //        width: width,
                //        //format: "{0: yyyy-MM-dd}"
                //        template:'#if(rpt_Date!=null){# #= kendo.format("{0:dd MMM yyyy}", kendo.parseDate(rpt_Date)) # #}#'
                //        //format: "{0:dd MMM yyyy}", kendo. toString(kendo.parseDate(DateOfBirth, 'yyyy-MM-dd'), 'MM/dd/yyyy') #" }
                //    });
                //}
                else if (gridTitle == "rpt_Description") {
                    GridColumnGeneration.push({
                        title: title,
                        field: gridTitle,
                        width: 250, 
                        footerTemplate: "Ending Balance : ", 
                        footerAttributes: { style: "text-align: right;" }
                    });
                }
                else if (gridTitle == "type") {
                    GridColumnGeneration.push({
                        field: gridTitle,
                        width: 250,
                        hidden: true,
                        groupHeaderTemplate: "#=value#"
                    });
                }
                else {
                    GridColumnGeneration.push({
                        title: title,
                        field: gridTitle,
                        width: width
                    });
                }
            }
        });
        return GridColumnGeneration;
    }


    function AggregatesGeneration(result) {
        var generate = [];
        $.each(result[0], function (gridTitle, element) {
            if (gridTitle != "id" && gridTitle != "type") {
                generate.push({ field: gridTitle, aggregate: "sum" });
            }
        });
        return generate;
    }

    function customeExcelExportEvent(e) {
        var sheet = GetBodyExportExcel(e)
        sheet.frozenRows = 4;
        sheet.mergedCells = ["A1:B1", "A2:B2", "A3:B3"];
        //sheet.name = "Header"; 

        var currency = $("#CurrencyId").data("kendoDropDownList").text();
        var bank = $("#BankId").data("kendoDropDownList").text(); 
        var stdate = $("#StartDate").val();
        var eddate = $("#EndingDate").val();
         
        sheet.rows.splice(0, 0, { cells: [{ value: "Bank", bold: true }, { value: currency, bold: true }], type: "header", height: 20 });
        sheet.rows.splice(0, 0, { cells: [{ value: "Currency", bold: true }, { value: currency, bold: true }], type: "header", height: 20 });
        sheet.rows.splice(0, 0, { cells: [{ value: "Date", bold: true }, { value: stdate + ' - ' + eddate, bold: true }], type: "header", height: 20 });
    }

    function LoadPDF() {
        var currency = $("#CurrencyId").data("kendoDropDownList").text();
        var bank = $("#BankId").data("kendoDropDownList").text();
        var stdate = $("#StartDate").val();
        var eddate = $("#EndingDate").val();

        return "<table>" +
            "<tr>" +
            "<td style='width:200px;'>Date</td>" +
            "<td>:</td>" +
            "<td>" + stdate + ' - ' + eddate + "</td>" +
            "</tr>" +
            "<tr>" +
            "<td>Currency</td>" +
            "<td>:</td>" +
            "<td>" + currency + "</td>" +
            "</tr>" +
            "<tr>" +
            "<td>Bank</td>" +
            "<td>:</td>" +
            "<td>" + bank + "</td>" +
            "</tr>" + 
            "</table>";
    }
</script>