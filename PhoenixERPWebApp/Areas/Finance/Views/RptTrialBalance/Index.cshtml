@model PhoenixERPWebApp.Models.RptTrialBalanceFilter
@{
    ViewData["Title"] = "Trial Balance";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">Trial Balance</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Report</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="rpttrialbalance" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Trial Balance</span></a>
                </li>
            </ul>
        </div>
    </div>  
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">
                                Trial Balance
                            </h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    @*<input type="hidden" id="hd_bal_debit" value="0" />
                        <input type="hidden" id="hd_bal_credit" value="0" />
                        <input type="hidden" id="hd_pnl_debit" value="0" />
                        <input type="hidden" id="hd_pnl_credit" value="0" />*@
                    <form id="formSearch">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="LegalEntityId"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.LegalEntityId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Filter(FilterType.Contains)
                                                .Events(x => x.Select("legalEntity_select"))
                                                .DataSource(source =>
                                                {
                                                    source.Read(read =>
                                                    {
                                                        read.Action("GetLegalEntity", "Dropdown", new { area = "Finance" });
                                                    });
                                                })
                                                .OptionLabel(" ")
                                                .HtmlAttributes(new
                                                {
                                                    style = "width:100%;",
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.LegalEntityId)} is required"
                                                })
                                    )
                                </div>
                                <div class="form-group">
                                    <label asp-for="BusinessUnitId"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.BusinessUnitId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Filter(FilterType.Contains)
                                                .Events(x => x.Select("businessUnit_select"))
                                                .DataSource(source =>
                                                {
                                                    source.Read(read =>
                                                    {
                                                        read.Action("GetDivisionFinance", "Dropdown", new { area = "Finance" });
                                                    });
                                                })
                                                .OptionLabel(" ")
                                                .HtmlAttributes(new
                                                {
                                                    style = "width:100%;",
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.BusinessUnitId)} is required"
                                                })
                                    )
                                </div>
                                <div class="form-group">
                                    <label asp-for="CoaLevel"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.CoaLevel)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Filter(FilterType.Contains)
                                                .DataSource(source =>
                                                {
                                                    source.Read(read =>
                                                    {
                                                        read.Action("GetDDLCOALevel", "Dropdown", new { area = "Finance" });
                                                    });
                                                })
                                                .OptionLabel(" ")
                                                .HtmlAttributes(new
                                                {
                                                    style = "width:100%;",
                                                    required = "required",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.CoaLevel)} is required"
                                                })
                                    )
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label asp-for="CurrencyId"></label> :
                                    @(Html.Kendo().DropDownListFor(m => m.CurrencyId)
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Filter(FilterType.Contains)
                                                .DataSource(source =>
                                                {
                                                    source.Read(read =>
                                                    {
                                                        read.Action("GetDDLCurrency", "Dropdown", new { area = "Finance" });
                                                    });
                                                })
                                                .OptionLabel(" ")
                                                .HtmlAttributes(new
                                                {
                                                    style = "width:100%;",
                                                    required = "required",
                                                    @readonly = "readonly",
                                                    validationmessage = $"{Html.DisplayNameFor(m => m.CurrencyId)} is required"
                                                })
                                    )
                                </div>
                                <div class="form-group">
                                    <label asp-for="EndingDate"></label> :
                                    <div class="row" style="padding:0px">
                                        <div class="col-lg-6">
                                            @(Html.Kendo().DropDownListFor(m => m.Type)
                                                         .DataTextField("Text")
                                                         .DataValueField("Value")
                                                         .Events(e => e.Change("type_change"))
                                                         .BindTo(new List<SelectListItem>() {
                                                                                          new SelectListItem() { Text = "Day", Value = "Day"},
                                                                                          new SelectListItem() { Text = "Month", Value = "Month"},
                                                                                          new SelectListItem() { Text = "Year", Value = "Year"},
                                                         })
                                                         .HtmlAttributes(new { style = "width: 100%" })
                                            )
                                        </div>
                                        <div class="col-lg-6">
                                            @*@(Html.Kendo().DatePickerFor(m => m.EndingDate)
                                                    .Format("dd MMM yyyy")
                                                    //.Start(CalendarView.Decade)
                                                    //.Depth(CalendarView.Decade)
                                                    .HtmlAttributes(new
                                                    {
                                                        style = "width:100%",
                                                        @placeholder = $"Choose a {Html.DisplayNameFor(m => m.EndingDate)}",
                                                        required = "required",
                                                        validationmessage = $"{Html.DisplayNameFor(m => m.EndingDate)} is required"
                                                    })
                                                )*@
                                            <div id="divDate"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    @(Html.Kendo().CheckBoxFor(x => x.DisplayZeroBalance)
                                             .Label("Display Zero Balance")
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <button type="button" id="btnSearch" class="btn btn-primary" style="padding:7px;"><span class="fa fa-filter"></span> Filter</button>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div class="row">
                        <div class="col-lg-12">
                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.RptTrialBalance>()
                                        .Name("grid")
                                        .Columns(columns =>
                                        {
                                            columns.Bound(p => p.code_rec).Width(150);//.Locked(true);
                                            columns.Bound(p => p.name5).Width(250).ClientFooterTemplate("TOTAL<br/>Total Balance Sheet<br/>Total Profit and Loss");//.Locked(true);
                                            columns.Group(g => g.Title("Opening Balance")
                                                .Columns(location =>
                                                {
                                                    location.Bound(p => p.ob_debit).Width(150).ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#<br/><br/>").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right; vertical-align:top;" });
                                                    location.Bound(p => p.ob_credit).Width(150).ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#<br/><br/>").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right; vertical-align:top;" });
                                                })
                                            );
                                            columns.Group(g => g.Title("Mutation")
                                               .Columns(location =>
                                               {
                                                   location.Bound(p => p.mut_debit).Width(150).ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#<br/><br/>").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right; vertical-align:top;" });
                                                   location.Bound(p => p.mut_credit).Width(150).ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#<br/><br/>").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right; vertical-align:top;" });
                                               })
                                            );
                                            columns.Bound(p => p.net_mutation).Width(150).ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#<br/><br/>").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right; vertical-align:top;" });
                                            columns.Group(g => g.Title("Ending Balance")
                                                 .Columns(location =>
                                                 {
                                                     location.Bound(p => p.eb_debit).Width(150).ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#<br/><br/>").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right; vertical-align:top;" });
                                                     location.Bound(p => p.eb_credit).Width(150).ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#<br/><br/>").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right; vertical-align:top;" });
                                                 })
                                            );
                                            columns.Group(g => g.Title("Balance Sheet")
                                                 .Columns(location =>
                                                 {
                                                     location.Bound(p => p.bal_debit).Width(150).ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#<br/>#=window.bal_debit()#<br/>").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right; vertical-align:top;" });
                                                     location.Bound(p => p.bal_credit).Width(150).ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#<br/>#=window.bal_credit()#<br/>").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right; vertical-align:top;" });
                                                 })
                                            );
                                            columns.Group(g => g.Title("Profit and Loss")
                                                 .Columns(location =>
                                                 {
                                                     location.Bound(p => p.pnl_debit).Width(150).ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#<br/> <br/>#=window.pnl_debit()#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right; vertical-align:top;" });
                                                     location.Bound(p => p.pnl_credit).Width(150).ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#<br/> <br/>#=window.pnl_credit()#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right; vertical-align:top;" });
                                                 })
                                            );
                                        })
                                        .ToolBar(toolBar =>
                                        {
                                            toolBar.Excel();
                                            toolBar.Pdf();
                                        })
                                        .Excel(excel => excel.AllPages(true)
                                            .FileName("Trial Balance.xlsx")
                                            .Filterable(true)
                                        )
                                        .Pdf(pdf => pdf
                                            .AllPages()
                                            .AvoidLinks()
                                            .PaperSize("A0")
                                            .Margin("5.5cm", "1cm", "1cm", "1cm")
                                            .Landscape()
                                            .RepeatHeaders()
                                            .TemplateId("page-template")
                                            .FileName("Trial Balance.pdf")
                                        )
                                        //.Pageable(pageable => pageable
                                        //    .Refresh(true)
                                        //    .PageSizes(true)
                                        //    .ButtonCount(5))
                                        //.Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                        //.Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                                        //    .Extra(false)
                                        //    .Operators(operators => operators
                                        //    .ForString(str => str.Clear()
                                        //        .Contains("Contains")
                                        //        .StartsWith("Start sWith")
                                        //        .EndsWith("End sWith")
                                        //    )))
                                        .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                        .Resizable(rsz => rsz.Columns(true))
                                        .DataSource(dataSource => dataSource
                                            .Ajax()
                                            //.PageSize(20)
                                            .Events(events => events.Error("errorHandler"))
                                            .Model(model => { model.Id(p => p.account_id); })
                                            .Aggregates(aggregates =>
                                            {
                                                aggregates.Add(p => p.ob_debit).Sum();
                                                aggregates.Add(p => p.ob_credit).Sum();
                                                aggregates.Add(p => p.mut_debit).Sum();
                                                aggregates.Add(p => p.mut_credit).Sum();
                                                aggregates.Add(p => p.net_mutation).Sum();
                                                aggregates.Add(p => p.eb_debit).Sum();
                                                aggregates.Add(p => p.eb_credit).Sum();
                                                aggregates.Add(p => p.bal_debit).Sum();
                                                aggregates.Add(p => p.bal_credit).Sum();
                                                aggregates.Add(p => p.pnl_debit).Sum();
                                                aggregates.Add(p => p.pnl_credit).Sum();
                                            })
                                            .Read(read => read.Action("Read", "RptTrialBalance").Data("gridParams"))
                                        )
                                    .AutoBind(false)
                                    .Events(e => e.ExcelExport("customeExcelExportEvent"))
                            )
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="x/kendo-template" id="page-template">
    <div class="page-template">
        <div class="header">
            <div class="page">Page #: pageNum # of #: totalPages #</div> 
            @*#if(pageNum==1){#*@
                #=LoadPDF()#            
            @*#}#*@
        </div>
        @*<div class="watermark">KENDO UI</div>
        <div class="footer">
            Page #: pageNum # of #: totalPages #
        </div>*@
    </div>
</script>
<script>

    $(document).ready(function () {
        type_change();
        $('#grid').data('kendoGrid').dataSource.read();
    });

    function gridParams() {
        return {
            Filter: filter()
        }
    }

    function filter(){
        return {
            LegalEntityId: $("#LegalEntityId").data("kendoDropDownList").value(),
            BusinessUnitId: $("#BusinessUnitId").data("kendoDropDownList").value(),
            Type: $("#Type").data("kendoDropDownList").value(),
            EndingDate: $("#EndingDate").data("kendoDatePicker").value().toDateString(),
            CurrencyId: $("#CurrencyId").data("kendoDropDownList").value(),
            DisplayZeroBalance: $("#DisplayZeroBalance").is(':checked'),
            CoaLevel: $("#CoaLevel").data("kendoDropDownList").value()
        };
    }
    $('#btnSearch').click(function () {
        var valid = $("#formSearch").validate().form();
        if (valid) {
            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            @*$.ajax({
                url: "@Url.Action("GetTotal", "RptTrialBalance", new { area = "Finance" })",
                data: filter(),
                success: function (data) {
                    if (data != null) {
                        $("#hd_bal_debit").val(data.bal_debit);
                        $("#hd_bal_credit").val(data.bal_credit);
                        $("#hd_pnl_debit").val(data.pnl_debit);
                        $("#hd_pnl_credit").val(data.pnl_credit);
                    }

                    $('#grid').data('kendoGrid').dataSource.read();
                    $('#grid').data('kendoGrid').refresh();
                }
            });*@

            $('#grid').data('kendoGrid').dataSource.read();
            $('#grid').data('kendoGrid').refresh();
            mApp.unblock("#m_blockui_list");
        }
    });

    function businessUnit_select(e) {
        if (e.dataItem) {
            //$("#LegalEntityId").data("kendoDropDownList").readonly(e.dataItem.Value != "");
            if (e.dataItem.Value != "") {
                $("#LegalEntityId").removeAttr("required");
                $("#LegalEntityId-error").css("display", "none");
                $("#LegalEntityId").data("kendoDropDownList").value("");
            } else {
                $("#LegalEntityId").attr("required", "required");
                $("#LegalEntityId-error").css("display", "block");
            }
        }
    }

    function legalEntity_select(e) {
        if (e.dataItem) {
            //$("#BusinessUnitId").data("kendoDropDownList").readonly(e.dataItem.Value != "");
            if (e.dataItem.Value != "") {
                $("#BusinessUnitId").removeAttr("required");
                $("#BusinessUnitId-error").css("display", "none");
                $("#BusinessUnitId").data("kendoDropDownList").value("");
            } else {
                $("#BusinessUnitId").attr("required", "required");
                $("#BusinessUnitId-error").css("display", "block");
            }
        }
    }

    function type_change() {
        var type = $("#Type").data("kendoDropDownList").value();
        if (type == "Month") {
            $("#divDate").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder=' ' required/>");
            $("#EndingDate").kendoDatePicker({
                format: "MMM yyyy",
                start: "year",
                depth: "year",
                value: new Date(@Model.EndingDate.Value.Year, @Model.EndingDate.Value.Month-1, @Model.EndingDate.Value.Day)
            });
        } else if (type == "Year") {
            $("#divDate").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder=' ' required/>");
            $("#EndingDate").kendoDatePicker({
                format: "yyyy",
                start: "decade",
                depth: "decade",
                value: new Date(@Model.EndingDate.Value.Year, @Model.EndingDate.Value.Month-1, @Model.EndingDate.Value.Day)
            });
        } else {
            $("#divDate").empty().append("<input name='EndingDate' id='EndingDate' type='text' style='width: 100%;' placeholder=' ' required/>");
            $("#EndingDate").kendoDatePicker({
                format: "dd MMM yyyy",
                start: "month",
                depth: "month",
                value: new Date(@Model.EndingDate.Value.Year, @Model.EndingDate.Value.Month-1, @Model.EndingDate.Value.Day)
            });
        }
    }

    function customeExcelExportEvent(e) {
        var sheet = GetBodyExportExcel(e)
        sheet.frozenRows = 7;
        //sheet.mergedCells = ["B1:E1"];
        //sheet.name = "Header";

        var date = $("#EndingDate").val();
        var currency = $("#CurrencyId").data("kendoDropDownList").text();
        var coaLevel = $("#CoaLevel").data("kendoDropDownList").text();
        var bu = $("#BusinessUnitId").data("kendoDropDownList").text();
        var legal = $("#LegalEntityId").data("kendoDropDownList").text();

        sheet.rows.splice(0, 0, { cells: [{ value: "Date", bold: true }, { value: date, bold: true  }], type: "header", height: 20 });
        sheet.rows.splice(0, 0, { cells: [{ value: "Currency", bold: true }, { value: currency, bold: true  }], type: "header", height: 20 });
        sheet.rows.splice(0, 0, { cells: [{ value: "COA Level", bold: true }, { value: coaLevel, bold: true  }], type: "header", height: 20 });
        sheet.rows.splice(0, 0, { cells: [{ value: "Business Unit", bold: true }, { value: bu, bold: true  }], type: "header", height: 20 });
        sheet.rows.splice(0, 0, { cells: [{ value: "Legal Entity", bold: true }, { value: legal, bold: true  }], type: "header", height: 20 });
    }
    
    function LoadPDF() {
        var date = $("#EndingDate").val();
        var currency = $("#CurrencyId").data("kendoDropDownList").text();
        var coaLevel = $("#CoaLevel").data("kendoDropDownList").text();
        var bu = $("#BusinessUnitId").data("kendoDropDownList").text();
        var legal = $("#LegalEntityId").data("kendoDropDownList").text();

        return "<table>"+
                "<tr>"+
                    "<td style='width:200px;'>Legal Entity</td>"+
                    "<td>:</td>"+
                    "<td>"+legal+"</td>"+
                "</tr>"+
                "<tr>"+
                    "<td>Business Unit</td>"+
                    "<td>:</td>"+
                    "<td>"+bu+"</td>"+
                "</tr>"+
                "<tr>"+
                    "<td>COA Level</td>"+
                    "<td>:</td>"+
                    "<td>"+coaLevel+"</td>"+
                "</tr>"+
                "<tr>"+ 
                    "<td>Currency</td>"+
                    "<td>:</td>"+
                    "<td>"+currency+"</td>"+
                "</tr>"+
                "<tr>"+
                    "<td>Date</td>"+
                    "<td>:</td>"+
                    "<td>"+date+"</td>"+
                "</tr>"+ 
            "</table>";
    }

    function bal_debit() { 
        var ds = $("#grid").data("kendoGrid").dataSource;
        var result = ds.aggregates().bal_debit.sum; 
        if (balancePNL() > 0) result += Math.abs(balancePNL());
        return kendo.format('{0:n2}', result);
        //return kendo.format('{0:n2}', parseFloat($("#hd_bal_debit").val()));
    }

    function bal_credit() { 
        var ds = $("#grid").data("kendoGrid").dataSource; 
        var result = ds.aggregates().bal_credit.sum;
        if (balancePNL() < 0) result += Math.abs(balancePNL());
        return kendo.format('{0:n2}', result);
        //return kendo.format('{0:n2}', parseFloat($("#hd_bal_credit").val()));
    }

    function pnl_debit() {
        var result = 0;
        if (balancePNL() > 0) result = balancePNL();
        return kendo.format('{0:n2}', result);
        //return kendo.format('{0:n2}', parseFloat($("#hd_pnl_debit").val()));
    }

    function pnl_credit() {
        var result = 0;
        if (balancePNL() < 0) result = balancePNL();
        return kendo.format('{0:n2}', Math.abs(result));
        //return kendo.format('{0:n2}', parseFloat($("#hd_pnl_credit").val()));
    }

    function balancePNL() {
        var ds = $("#grid").data("kendoGrid").dataSource;
        var debit = ds.aggregates().pnl_debit.sum;
        var credit = ds.aggregates().pnl_credit.sum;
        var result = debit - credit;
        return result;
    }

    //function balanceBAL() {
    //    var ds = $("#grid").data("kendoGrid").dataSource;
    //    var debit = ds.aggregates().bal_debit.sum;
    //    var credit = ds.aggregates().bal_credit.sum;
    //    var result = debit - credit;
    //    return result;
    //}
</script>