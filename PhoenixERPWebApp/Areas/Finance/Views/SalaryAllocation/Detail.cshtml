                                                            <div class="col-lg-12">
                                                                <div class="form-group">
                                                                    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.SalaryAllocationDetail>()
                                                                        .Name("grid")
                                                                        .ToolBar(x =>
                                                                        {
                                                                            if (ViewBag.isRequestor == true)
                                                                            {
                                                                                x.Create();
                                                                            }

                                                                        })
                                                                        .Columns(columns =>
                                                                        {
                                                                            if (ViewBag.isRequestor == true)
                                                                            {
                                                                                columns.Command(command =>
                                                                                {
                                                                                    command.Edit().Text(" ").UpdateText(" ").CancelText(" ");
                                                                                    command.Destroy().Text(" ");
                                                                                }).Title("Action").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(90);
                                                                            }
                                                                            columns.Bound(p => p.CodeRec).EditorTemplateName("StringReadOnly").Width(100);
                                                                            columns.Bound(p => p.CoaId).EditorTemplateName("Finance/Journal/CoaIdDropdown").ClientTemplate("#=AccountName#").Width(200);
                                                                            columns.Bound(p => p.Condition).EditorTemplateName("Finance/Journal/ConditionDropdown").Width(150);
                                                                            columns.Bound(p => p.Debit).Width(150).HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" }).ClientFooterTemplate("#=kendo.format('{0:n2}', sumDebit())#");
                                                                            columns.Bound(p => p.Credit).Width(150).HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" }).ClientFooterTemplate("#=kendo.format('{0:n2}', sumCredit())#");
                                                                        })
                                                                        .Resizable(rsz => rsz.Columns(true))
                                                                        .NoRecords()
                                                                        .Editable(x => x.Mode(GridEditMode.InLine).DisplayDeleteConfirmation(true))
                                                                        .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                                                        .DataSource(dataSource => dataSource
                                                                            .Ajax()
                                                                            .Events(events => events.Error("errorHandler"))
                                                                            .Model(model => { model.Id(p => p.Id); })
                                                                            .Read(read => read.Action("readdetail", "SalaryAllocation").Data("grid_params"))
                                                                            .Create(create => create.Action("createdetail", "SalaryAllocation"))
                                                                            .Update(update => update.Action("updatedetail", "SalaryAllocation"))
                                                                            .Destroy(destroy => destroy.Action("destroydetail", "SalaryAllocation"))
                                                                        ).AutoBind(false)
                                                                        .Events(evt => evt.Save("save_event").Edit("edit_event"))
                                                                    )
                                                                </div>
                                                            </div>
                                                        </div>

                                                        @if (ViewBag.isRequestor == true)
                                                        {
                                                            <div class="row">
                                                                <div class="col-lg-12">
                                                                    <button type="button" id="btnCretaeJournal" class="btn btn-primary add"><span class="fa fa-plus"></span> Create Journal</button>
                                                                    <div class="pull-right">
                                                                        <h3 class="m--font-info"><span id="lblBalance"></span></h3>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <br />
                                                        }

                                                        <div class="row">
                                                            <div class="col-lg-12">
                                                                <div class="form-group">
                                                                    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Journal>()
                                                                        .Name("gridJournal")
                                                                        .Columns(columns =>
                                                                        {
                                                                            columns.Bound(p => p.CodeRec).Width(100);
                                                                            columns.Bound(p => p.AccountName).Title("Account Name (Level 5 COA)").Width(250);
                                                                            //columns.Bound(p => p.ReferenceNumber).Width(150);
                                                                            columns.Bound(p => p.Description).Width(200);
                                                                            columns.Bound(p => p.CurrencyName).Width(120).ClientFooterTemplate("TOTAL").FooterHtmlAttributes(new { style = "text-align:right;" });
                                                                            columns.Bound(p => p.Debit).Width(150).Format("{0:N2}").ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                                            columns.Bound(p => p.Credit).Width(150).Format("{0:N2}").ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                                                            //columns.Bound(p => p.LegalEntityName).Width(200);
                                                                            //columns.Bound(p => p.DivisiName).Width(200);
                                                                            //columns.Bound(p => p.AfiliationName).Width(200);
                                                                            //columns.Bound(p => p.JobId).Width(160);
                                                                            //columns.Bound(p => p.PceId).Width(150);
                                                                            //columns.Bound(p => p.PcaId).Width(150);
                                                                        })
                                                                        .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                                                        .Resizable(rsz => rsz.Columns(true))
                                                                        .NoRecords()
                                                                        .DataSource(dataSource => dataSource
                                                                            .Ajax()
                                                                            .Events(events => events.Error("errorHandler"))
                                                                            .Model(model => { model.Id(p => p.Id); })
                                                                            .Aggregates(aggregates =>
                                                                            {
                                                                                aggregates.Add(p => p.Debit).Sum();
                                                                                aggregates.Add(p => p.Credit).Sum();
                                                                            })
                                                                            .Read(read => read.Action("readjournal", "SalaryAllocation").Data("grid_params"))
                                                                        ).AutoBind(false)
                                                                    )
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div> 
                        <br/>
                        <div class="row ">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label asp-for="RemarksProcess"></label> :
                                    @Html.TextAreaFor(x => x.RemarksProcess, new { style = "height:100px;width:100%" })
                                </div>
                            </div>
                        </div>

                        <partial name="_HistoryApproval" />
                        <partial name="_StatusLog" />
                        <br><hr>
                        <div style="text-align: right;">
                            @if (ViewBag.isRequestor == true)
                            {
                                <button type="button" id="btnSave" class="btn btn-success edit"><span class="fa fa-save"></span> Save</button>
                                <button type="button" id="btnSubmit" class="btn btn-primary edit"><span class="fa fa-paper-plane"></span> Submit</button>
                            }
                            else if (ViewBag.processApprove == true)
                            {
                                <button type="button" id="btnReject" class="btn btn-danger"><span class="fa fa-ban"></span> Reject</button>
                                <button type="button" id="btnApprove" class="btn btn-primary"><span class="fa fa-bookmark"></span> Approve</button>
                            }
                            <a asp-action="Index" asp-controller="SalaryAllocation" asp-area="Finance" class="fakelink btn btn-secondary"><span class="fa fa-arrow-circle-left"></span> Cancel</a>
                        </div> 
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script> 
    var Type, FiscalYear, StartPeriod, EndPeriod;
    $(document).ready(function () {
        if ("@Model.Id"!="") {
            $("#gridJournalHistory").data("kendoGrid").dataSource.read();
            $("#grid").data("kendoGrid").dataSource.read();
            $("#gridJournal").data("kendoGrid").dataSource.read();
            //$("#FinancialYearId").data("kendoDropDownList").dataSource.read();
        } else {
            Type = $("#TypeSearch").data("kendoDropDownList").filterInput.val();
            FiscalYear = $("#FiscalYearSearch").data("kendoDropDownList").filterInput.val();
            StartPeriod = $("#StartPeriodSearch").data("kendoDatePicker").value();
            EndPeriod = $("#EndPeriodSearch").data("kendoDatePicker").value();
        }

        if ("@ViewBag.isRequestor" == "False") {
            $("#ExchangeRate").data("kendoNumericTextBox").readonly();
            $("#CurrencyId").data("kendoDropDownList").readonly();
            //$("#FinancialYearId").data("kendoDropDownList").readonly();
            //$("#FinancePeriodId").data("kendoDropDownList").readonly();                
            $("#TransactionDate").data("kendoDatePicker").readonly();   
            $("#Description").attr('readonly', 'readonly'); 
        }else {            
            if ("@Model.CurrencyId" == "@PhoenixERPWebApp.Models.CurrencyIDR.CurrencyId") {
                $("#ExchangeRate").data("kendoNumericTextBox").readonly(); 
            } else {
                $("#ExchangeRate").data("kendoNumericTextBox").readonly(false); 
            } 
        }   
    });

    function grid_params() {
        return {
            id: $("#Id").val()
        }
    }

    function year_params(){
        return {
            legalId: $("#LegalEntityId").val()
        }
    }

    //function period_params(){
    //    return {
    //        Id: $("#FinancialYearId").val()
    //    }
    //}

    function journalhisroty_params(){
        return {
            referenceId: $("#ReferenceId").val()
        }
    }

    function number_params(){
        return {
            Type: Type,
            FiscalYear: FiscalYear,
            StartPeriod: StartPeriod,
            EndPeriod: EndPeriod
        }
    }
    
    $('#btnSearch').click(function () { 
        var valid = $("#formSalaryAllocationSearch").validate().form();
        if (valid) {
            var data = $("#formSalaryAllocationSearch").serialize();
            $.ajax({
                type: "GET",
                url: '@Url.Action("search", "SalaryAllocation")',
                data: { type: $("#TypeSearch").data("kendoDropDownList").value(), number: $("#NumberSearch").data("kendoDropDownList").value()},
                dataType: 'json',
                success: function (result) {
                    if (result != null) {
                        $("#ReferenceId").val(result.ReferenceId);
                        $("#ReferenceNumber").val(result.ReferenceNumber);
                        $("#viewType").val(result.Type);
                        $("#viewBusinessUnitName").val(result.BusinessUnitName);
                        $("#viewLegalEntityName").val(result.LegalEntityName);
                        $("#viewAffiliationName").val(result.AffiliationName);
                        $("#viewClientName").val(result.ClientName);
                        $("#viewJobId").val(result.JobId);
                        $("#viewPcaId").val(result.PcaId);
                        $("#viewPceId").val(result.PceId);
                        $("#viewMainServiceCategoryName").val(result.MainServiceCategoryName);
                        $("#ViewFiscalYear").val(result.ViewFiscalYear);
                        $("#ViewPeriod").val(result.ViewPeriod);
                        $("#ViewDateTransaction").data("kendoDatePicker").value(result.ViewDateTransaction);

                        $("#Type").val(result.Type);
                        $("#BusinessUnitId").val(result.BusinessUnitId);
                        $("#BusinessUnitName").val(result.BusinessUnitName);
                        $("#LegalEntityId").val(result.LegalEntityId);
                        $("#LegalEntityName").val(result.LegalEntityName);
                        $("#AffiliationId").val(result.AffiliationId);
                        $("#AffiliationName").val(result.AffiliationName);
                        $("#ClientId").val(result.ClientId);
                        $("#ClientName").val(result.ClientName);
                        $("#JobId").val(result.JobId);
                        $("#PcaId").val(result.PcaId);
                        $("#PceId").val(result.PceId);
                        $("#MainServiceCategoryId").val(result.MainServiceCategoryId);
                        $("#MainServiceCategoryName").val(result.MainServiceCategoryName);

                        $("#CurrencyId").data("kendoDropDownList").value(result.CurrencyId);
                        $('#ExchangeRate').data("kendoNumericTextBox").value(result.ExchangeRate);

                        if (result.ExchangeRate==null){
                            if (result.CurrencyId == "@PhoenixERPWebApp.Models.CurrencyIDR.CurrencyId") { 
                                $('#ExchangeRate').data("kendoNumericTextBox").value(1);
                            } else { 
                                $('#ExchangeRate').data("kendoNumericTextBox").value(0);
                            }
                        }

                        //$("#FinancialYearId").data("kendoDropDownList").dataSource.read();
                        $("#gridJournalHistory").data("kendoGrid").dataSource.read();
                    }
                }
            })
        } 
    });

    $('#btnApprove').click(function () {
        $("#RemarksProcess").removeAttr("required", "required");
        callAction({ formId: "formSalaryAllocation", title: "approve", type: "PUT", url: '@Url.Action("approve", "SalaryAllocation")'});
    });

    $('#btnReject').click(function () {
        $("#RemarksProcess").attr("required", "required");
        callAction({ formId: "formSalaryAllocation", title: "reject", type: "PUT", url: '@Url.Action("reject", "SalaryAllocation")'});
    });

    $('#btnSubmit').click(function () {
        if (!isValid()) return;
        callAction({ formId: "formSalaryAllocation", title: "submit", type: "POST", url: '@Url.Action("submit", "SalaryAllocation")', objects: result()});
    });

    $('#btnSave').click(function () {
        if (!isValid()) return;
        callAction({ formId: "formSalaryAllocation", title: "save", type: "POST", url: '@Url.Action("save", "SalaryAllocation")', objects: result()});
    });

    $('#btnDelete').click(function () {
        callAction({ formId: "formSalaryAllocation", title: "delete", type: "DELETE", url: '@Url.Action("delete", "SalaryAllocation")'});
    });

    $('#btnCretaeJournal').click(function () {
        if (!isValidBalance()) return;
        callAction({ formId: "formSalaryAllocation", title: "create journal", type: "POST", url: '@Url.Action("createjournal", "SalaryAllocation")', objects: result()});
    });

    function isValid() {
        var valid = $("#formSalaryAllocation").validate().form();
        if (valid) {
            var grid = $("#grid").data("kendoGrid").dataSource.data();
            if (grid.length == 0) {
                swal('Warning', "Please input journal detail list", 'warning');
                return false;
            }

            return true;
        } else {
            return false;
        }
    }

    function isValidBalance() {
        var valid = $("#formSalaryAllocation").validate().form();
        if (valid) {
            var grid = $("#grid").data("kendoGrid").dataSource.data();
            if (grid.length == 0) {
                swal('Warning', "Please input journal detail list", 'warning');
                return false;
            }

            if (Balance() == false) {
                swal('Warning', "Debit value is not the same as credit value, please make sure the debit value must be equal to the credit value.", 'warning');
                return false;
            }

            return true;
        } else {
            return false;
        }
    }

    function result() {
        var grid = $("#grid").data("kendoGrid");
        var dataList = {
            SalaryAllocationDetails: grid.dataSource.data()
        }

        return dataList;
    }

    function CoaId_Select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;

            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $.ajax({
                type: "GET",
                url: '@Url.Action("Get", "ChartOfAccount")',
                data: { id: dataItem.Value },
                success: function (result) {
                    if (result != undefined) { 
                        $("#CodeRec").val(result.CodeRec);
                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    console.log(e)
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
            }, 2e3));
        }
    }

    function save_event(e) {
        var CoaId = $("#CoaId").data("kendoDropDownList").value();
        var AccountName = $("#CoaId").data("kendoDropDownList").text();
        var CodeRec = $("#CodeRec").val();
        var Condition = $("#Condition").data("kendoDropDownList").value();
        var Debit = $("#Debit").data("kendoNumericTextBox").value();
        var Credit = $("#Credit").data("kendoNumericTextBox").value();

        e.model.set("CoaId", CoaId);
        e.model.set("CodeRec", CodeRec);
        e.model.set("AccountName", AccountName);
        e.model.set("Condition", Condition);
        e.model.set("Debit", Debit);
        e.model.set("Credit", Credit);
        Balance();
    }

    function edit_event(e) {
        Condition(e.model.Condition);
    }

    function Balance() {
        var models = $("#grid").data("kendoGrid").dataSource.data();
        var totalDebit = 0;
        var totalCredit = 0;

        $.each(models, function (index, data) {
            if (data.Debit != null) {
                totalDebit += data.Debit;
            }
            if (data.Credit != null) {
                totalCredit += data.Credit;
            }
        });
        var balance = (totalCredit == totalDebit);
        if (balance) {
            $("#lblBalance").html("<span style='color:green;'>Balance</span>");
        } else {
            $("#lblBalance").html("<span style='color:red;'>Not Balance</span>");
        }
        return balance;
    }
    
    function Condition_Select(e) {
        if (e.dataItem) {
            Condition(e.dataItem.Value);
            if (e.dataItem.Value == "Debit") {
                $('#Credit').data("kendoNumericTextBox").value(0);
            } else {
                $('#Debit').data("kendoNumericTextBox").value(0);
            }
        }
    }

    function Condition(value) {
        var isReadOnly = (value == "Debit");
        $("#Debit").data("kendoNumericTextBox").readonly(!isReadOnly);
        $("#Credit").data("kendoNumericTextBox").readonly(isReadOnly);
    }

    function currency_select(e) {
        if (e.dataItem) {
            if (e.dataItem.Value == "@PhoenixERPWebApp.Models.CurrencyIDR.CurrencyId") {
                $("#ExchangeRate").data("kendoNumericTextBox").readonly();
                $('#ExchangeRate').data("kendoNumericTextBox").value(1);
            } else {
                $("#ExchangeRate").data("kendoNumericTextBox").readonly(false);
                $('#ExchangeRate').data("kendoNumericTextBox").value(0);
            }
        }
    }

    function year_select(e) { 
        if (e.dataItem) {
            FiscalYear = e.dataItem.Value;
            $("#NumberSearch").data("kendoDropDownList").dataSource.read();
        }
    }

    function type_select(e) {
        if (e.dataItem) {
            Type = e.dataItem.Value;
            $("#NumberSearch").data("kendoDropDownList").dataSource.read();
        }
    }

    function startperiod_change(e) {
        StartPeriod = this.value().toISOString().slice(0, 16);;
        $("#NumberSearch").data("kendoDropDownList").dataSource.read();
    }

    function endperiod_change(e) {
        EndPeriod = this.value().toISOString().slice(0, 16);;
        $("#NumberSearch").data("kendoDropDownList").dataSource.read();
    }  

    function sumDebit() {
        var models = $("#grid").data("kendoGrid").dataSource.data();
        var result = 0;

        $.each(models, function (index, data) {
            if (data.Debit != null) {
                result += data.Debit;
            }
        });
        return result;
    }

    function sumCredit() {
        var models = $("#grid").data("kendoGrid").dataSource.data();
        var result = 0;

        $.each(models, function (index, data) {
            if (data.Credit != null) {
                result += data.Credit;
            }
        });
        return result;
    }
</script>