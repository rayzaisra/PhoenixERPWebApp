@model PhoenixERPWebApp.Models.SalaryAllocation
@{
    ViewData["Title"] = "Salary Allocation Detail";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<style>
    .k-numerictextbox .k-input {
        text-align: right;
        padding-right:10px;
    }
</style>
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="SalaryAllocation" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Salary Allocation Detail</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (string.IsNullOrEmpty(Model.Id))
                    {
                    <a asp-action="Detail" asp-controller="SalaryAllocation" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                    <a asp-action="Detail" asp-controller="SalaryAllocation" asp-area="finance" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">Salary Allocation Detail </h3> 
                            @if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Draft)
                            {<span class="m-badge m-badge--info m-badge--wide" id="lblstatus">@Model.Status</span> }
                        else if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.WaitingApproval)
                        { <span class="m-badge m-badge--warning m-badge--wide" id="lblstatus">@Model.Status</span> }
                    else if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Rejected)
                    { <span class="m-badge m-badge--danger m-badge--wide" id="lblstatus">@Model.Status</span> }
                    else if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Approved)
                    { <span class="m-badge m-badge--success m-badge--wide" id="lblstatus">@Model.Status</span>}
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">

                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    @if (Model.Id == null) { 
                        <form id="formSalaryAllocationSearch" >
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label>Fiscal Year</label> :
                                        @(Html.Kendo().DropDownList()
                                            .Name("FiscalYearSearch")
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .Filter(FilterType.Contains)
                                            .Events(x=>x.Select("year_select"))
                                            .DataSource(source =>
                                            {
                                                source.Read(read =>
                                                {
                                                    read.Action("GetYearList", "Dropdown", new { area = "Finance" });
                                                });
                                            })
                                            .OptionLabel($"Choose a Fiscal Year")
                                            .HtmlAttributes(new
                                            {
                                                style = "width:100%;"
                                            })
                                        )
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label>Select Type</label> <span class="req">*</span> :
                                        @(Html.Kendo().DropDownList()
                                            .Name("TypeSearch")
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .Filter(FilterType.Contains)
                                            .Events(x=>x.Select("type_select"))
                                            .DataSource(source =>
                                            {
                                                source.Read(read =>
                                                {
                                                    read.Action("GetSalaryAllocationType", "Dropdown", new { area = "Finance" });
                                                });
                                            })
                                            .OptionLabel($"Choose a Type")
                                            .HtmlAttributes(new
                                            {
                                                style = "width:100%;",
                                                required = "required",
                                                validationmessage = $"Type is required"
                                            })
                                        )
                                    </div>
                                </div>                            
                            </div>
                            <div class="row">
                                <div class="col-lg-3">
                                    <div class="form-group">
                                         <label>Start Period</label> :
                                        @(Html.Kendo().DatePicker()
                                            .Name("StartPeriodSearch")
                                            .Format("dd MMMM yyyy")
                                            .Events(x=>x.Change("startperiod_change"))
                                            .HtmlAttributes(new
                                            {
                                                style = "width: 100%",
                                                //onkeydown = "javascript:return false;",
                                                placeholder = $"Input type a Start Period"

                                            })
                                        )
                                    </div>
                                </div>
                                 <div class="col-lg-3">
                                    <div class="form-group">
                                         <label>End Period</label> :
                                        @(Html.Kendo().DatePicker()
                                            .Name("EndPeriodSearch")
                                            .Format("dd MMMM yyyy")
                                            .Events(x => x.Change("endperiod_change"))
                                            .HtmlAttributes(new
                                            {
                                                style = "width: 100%",
                                                //onkeydown = "javascript:return false;",
                                                placeholder = $"Input type a End Period"

                                            })
                                        )
                                    </div>
                                </div>                            
                                <div class="col-lg-6">
                                    <div class="form-group">
                                        <label>Search Number</label> <span class="req">*</span> :
                                        @(Html.Kendo().DropDownList()
                                            .Name("NumberSearch")
                                            .DataTextField("Text")
                                            .DataValueField("Value")
                                            .Filter(FilterType.Contains)
                                            .DataSource(source =>
                                            {
                                                source.Read(read =>
                                                {
                                                    read.Action("GetSalaryAllocationNumber", "Dropdown", new { area = "Finance" }).Data("number_params");
                                                });
                                            })
                                            .OptionLabel($"Choose a Number")
                                            .HtmlAttributes(new
                                            {
                                                style = "width:100%;",
                                                required = "required",
                                                validationmessage = $"Number is required"
                                            })  
                                        )
                                    </div>
                                </div>
                            </div> 
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="pull-left">
                                        <button type="button" id="btnSearch" class="btn btn-primary">@*<span class="fa fa-save"></span>*@ Search</button>
                                    </div>
                                </div>
                            </div>
                            <br/>
                        </form>
                    }
