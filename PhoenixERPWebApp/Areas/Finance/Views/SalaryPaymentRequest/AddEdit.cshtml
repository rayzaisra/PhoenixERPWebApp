@model PhoenixERPWebApp.Models.SalaryPaymentRequest
@{
    ViewData["Title"] = "Salary Payment Request";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">Salary Payment Request</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                       <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="salarypaymentrequest" asp-area="finance" class="m-nav__link"><span class="m-nav__link-text">Salary Payment Request</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                     @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="salarypaymentrequest" asp-area="finance"  class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="salarypaymentrequest" asp-area="finance"  asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption"> 
                         <div class="m-portlet__head-title">
                             <h3 class="m-portlet__head-text m--font-success">
                                 Salary Payment Request
                             </h3>&nbsp;
                            @if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Draft)
                            {<span class="m-badge m-badge--info m-badge--wide" id="lblstatus">@Model.Status</span> }
                            else if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.WaitingApproval)
                            { <span class="m-badge m-badge--warning m-badge--wide" id="lblstatus">@Model.Status</span> }
                            else if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Rejected)
                            { <span class="m-badge m-badge--danger m-badge--wide" id="lblstatus">@Model.Status</span> }
                            else if (Model.Status == PhoenixERPWebApp.Models.StatusTransactionName.Approved)
                            { <span class="m-badge m-badge--success m-badge--wide" id="lblstatus">@Model.Status</span>} 
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formSalaryPaymentRequest" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="salarypaymentrequest" asp-area="Finance">
                        @*enctype="multipart/form-data"*@
                        <div class="row "> 
                            @*<input type="hidden" asp-for="Id" />*@
                            <input type="hidden" asp-for="CreatedBy" />
                            <input type="hidden" asp-for="CreatedOn" />
                            <input type="hidden" asp-for="ModifiedBy" />
                            <input type="hidden" asp-for="ModifiedOn" />
                            <input type="hidden" asp-for="ApprovedBy" />
                            <input type="hidden" asp-for="ApprovedOn" />
                            <input type="hidden" asp-for="DeletedBy" />
                            <input type="hidden" asp-for="DeletedOn" />
                            <input type="hidden" asp-for="IsActive" />
                            <input type="hidden" asp-for="IsLocked" />
                            <input type="hidden" asp-for="IsDefault" />
                            <input type="hidden" asp-for="IsDeleted" />
                            <input type="hidden" asp-for="OwnerId" />
                            <input type="hidden" asp-for="TotalAmount" />
                            <input type="hidden" asp-for="Status" />

                            <div class="col-lg-6">
                                <div class="form-group m-form__group-sub">
                                    <label  asp-for="RequestDate"></label> :
                                    @Html.Kendo().TextBoxFor(m => m.RequestDate).HtmlAttributes(new { @readonly = "readonly", style = "width:100%", Placeholder = "Auto Generated by System.." })
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="LegalEntityId"></label> <span class="req">*</span> :
                                    @(Html.Kendo().DropDownListFor(m => m.LegalEntityId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .Events(evt=>evt.Change("LegalEntityId_Change"))
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetLegalEntity", "Dropdown", new { area = "Finance" });
                                            });
                                        })
                                        .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.LegalEntityId)}")
                                        .HtmlAttributes(new { style = "width:100%;", required = "required" })
                                    )
                                </div>
                                    <div class="form-group m-form__group-sub">
                                    <label asp-for="PayrollId"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().TextBoxFor(m => m.PayrollId)
                                        .HtmlAttributes(new {
                                            style = "width:100%",
                                            maxlength = 50,
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.PayrollId)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.PayrollId)} is required",
                                            @readonly = "readonly"
                                        }
                                        ))
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="Description"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().TextBoxFor(m => m.Description)
                                        .HtmlAttributes(new {
                                            style = "width:100%",
                                            maxlength = 255,
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.Description)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.Description)} is required" 
                                        }
                                        ))
                                </div> 
                                    <div class="form-group">
                                    <label asp-for="Id"></label> :
                                    @Html.Kendo().TextBoxFor(m => m.Id).HtmlAttributes(new {@readonly = "readonly", style = "width:100%", Placeholder = "Auto Generated by System.." })
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="RequestBy"></label> :
                                    @Html.Kendo().TextBoxFor(m => m.RequestBy).HtmlAttributes(new { @readonly = "readonly", style = "width:100%", Placeholder = "Auto Generated by System.." })
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="SalaryPaymentDate"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().DatePickerFor(m=>m.SalaryPaymentDate)
                                            .Format("MMM yyyy")
                                            .Start(CalendarView.Year)
                                            .Depth(CalendarView.Year)
                                            .Events(evt=>evt.Change("SalaryPaymentDate_Change"))
                                            .HtmlAttributes(new {
                                                style = "width: 100%",
                                                onkeydown = "javascript:return false;",
                                                placeholder = $"Input type a {Html.DisplayNameFor(m => m.SalaryPaymentDate)}",
                                                required = "required",
                                                validationmessage = $"{Html.DisplayNameFor(m => m.SalaryPaymentDate)} is required"
  
                                            })
                                    )
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="CurrencyId"></label> <span class="req">*</span> : 
                                    @(Html.Kendo().DropDownListFor(m => m.CurrencyId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .Events(evt => evt.Select("currency_select"))
                                        .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.CurrencyId)}")
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetDDLCurrency", "DropDown", new { area = "Finance" });
                                            });
                                        })
                                        .HtmlAttributes(new {
                                            style = "width:100%;",
                                            @required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.CurrencyId)} is required"
                                        })
                                    ) 
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="ExchangeRate"></label> <span class="req">*</span> : &nbsp; <a href="javascript:void(0);" onclick="window.open('@Url.RouteUrl(new { action = "Index", controller = "Currency", area="Finance" })?isView=true', '_blank','toolbar=yes,scrollbars=yes,resizable=yes,top=150,left=280,width=800,height=400');" id="linkCurrency" style="text-decoration:underline !important;">View</a>
                                    @(Html.Kendo().NumericTextBoxFor(m => m.ExchangeRate).Spinners(false)
                                        .HtmlAttributes(new
                                                {
                                            @placeholder = $"Input type a {Html.DisplayNameFor(m => m.ExchangeRate)}",
                                            @required = "required",
                                            @style = "width:100%",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.ExchangeRate)} is required"
                                        }))
                                </div>
                            </div> 
                        </div>
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.SalaryPaymentRequestDetail>()
                                        .Name("gridDetail")
                                        .Columns(columns =>
                                        {
                                            columns.Bound(p => p.DivisionName).Width(250).ClientFooterTemplate("TOTAL").FooterHtmlAttributes(new { style = "text-align:right;" });
                                            columns.Bound(p => p.Amount).Width(120).Format("{0:N2}").ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                        })
                                        //.Pageable(pageable => pageable
                                        //    .Refresh(true)
                                        //    .PageSizes(true)
                                        //    .ButtonCount(5))
                                        //.Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                        //.Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                                        //    .Extra(false)
                                        //    .Operators(operators => operators
                                        //    .ForString(str => str.Clear()
                                        //        .Contains("Contains")
                                        //        .StartsWith("Start sWith")
                                        //        .EndsWith("End sWith")
                                        //    )))
                                        .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                        .Resizable(rsz => rsz.Columns(true))
                                        .NoRecords()
                                        .DataSource(dataSource => dataSource
                                            .Ajax()
                                            .PageSize(10)
                                            .Events(events => events.Error("errorHandler"))
                                            .Model(model => { model.Id(p => p.Id); })
                                            .Read(read => read.Action("ReadDetail", "SalaryPaymentRequest").Data("gridDetails_params"))
                                            .Aggregates(aggregates =>
                                            {
                                                aggregates.Add(p => p.Amount).Sum();
                                            })
                                        )
                                    )
                                </div>
                            </div>
                        </div>
                                                
                        <div class="row" style="padding-bottom:10px;">
                            <div class="col-lg-4"> 
                                @(Html.Kendo().DatePickerFor(m => m.TransactionDate)
                                    .Format("dd MMM yyyy") 
                                    .HtmlAttributes(new
                                    {
                                        style = "width: 100%",
                                        onkeydown = "javascript:return false;",
                                        placeholder = $"Input type a {Html.DisplayNameFor(m => m.TransactionDate)}",
                                        required = "required",
                                        validationmessage = $"{Html.DisplayNameFor(m => m.TransactionDate)} is required"

                                    })
                                ) 
                            </div>

                            @if (ViewBag.isRequestor == true)
                            {
                                <div class="col-lg-4"> 
                                    <button type="button" id="btnCretaeJournal" class="btn btn-primary add"><span class="fa fa-plus"></span> Create Journal</button> 
                                </div>
                            }
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Journal>()
                                        .Name("gridjournal")
                                        .Columns(columns =>
                                        {
                                            columns.Bound(p => p.TransactionDate).Title("Date Transaction").Width(130);
                                            columns.Bound(p => p.AccountName).Title("Account ID-Name").Width(280);
                                            columns.Bound(p => p.Description).Width(200);
                                            columns.Bound(p => p.LegalEntityName).Width(200);
                                            columns.Bound(p => p.CurrencyName).Width(120).ClientFooterTemplate("TOTAL").FooterHtmlAttributes(new { style = "text-align:right;" });
                                            columns.Bound(p => p.Debit).Width(150).Format("{0:N2}").ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" });
                                            columns.Bound(p => p.Credit).Width(150).Format("{0:N2}").ClientFooterTemplate("#=kendo.toString(sum, 'n2')#").HtmlAttributes(new { style = "text-align:right;" }).FooterHtmlAttributes(new { style = "text-align:right;" }); 
                                        })
                                        .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                        .Resizable(rsz => rsz.Columns(true))
                                        .NoRecords()
                                        .DataSource(dataSource => dataSource
                                            .Ajax()
                                            .Events(events => events.Error("errorHandler"))
                                            .Model(model => { model.Id(p => p.Id); })
                                            .Aggregates(aggregates =>
                                            {
                                                aggregates.Add(p => p.Debit).Sum();
                                                aggregates.Add(p => p.Credit).Sum();
                                            })
                                            .Read(read => read.Action("ReadJournal", "SalaryPaymentRequest").Data("grid_params"))
                                        )
                                    )
                                </div>
                            </div>
                        </div>
                        
                        <div class="row ">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label asp-for="LogDescription"></label> :
                                    @Html.TextAreaFor(x => x.LogDescription, new { style = "height:100px;width:100%" })
                                </div>
                            </div>
                        </div>

                        <partial name="_HistoryApproval" />
                        <partial name="_StatusLog" />
                        <br><hr>                          
                        <div style="text-align: right;">
                            @if (ViewBag.isRequestor == true)
                            { 
                                <button type="button" id="btnSave" class="btn btn-success edit"><span class="fa fa-save"></span> Save</button>
                                <button type="button" id="btnSubmit" class="btn btn-primary edit"><span class="fa fa-paper-plane"></span> Submit</button> 
                            }
                            else if (ViewBag.processApprove == true)
                            {
                                <button type="button" id="btnReject" class="btn btn-danger"><span class="fa fa-ban"></span> Reject</button>
                                <button type="button" id="btnApprove" class="btn btn-primary"><span class="fa fa-bookmark"></span> Approve</button>
                            }
                            <a asp-action="Index" asp-controller="salarypaymentrequest" asp-area="Finance" class="fakelink btn btn-secondary"><span class="fa fa-arrow-circle-left"></span> Cancel</a>
                        </div> 
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script> 
    $(document).ready(function () { 
         if ("@ViewBag.isRequestor" == "False") {
             $("#LegalEntityId").data("kendoDropDownList").readonly();
             $("#CurrencyId").data("kendoDropDownList").readonly();
             $("#SalaryPaymentDate").data("kendoDatePicker").readonly();
             $("#TransactionDate").data("kendoDatePicker").readonly();
             $("#ExchangeRate").data("kendoNumericTextBox").readonly();
             $("#PayrollId").attr("readonly", "readonly");    
             $("#Description").attr("readonly", "readonly");    
         } else {       
             exchangeRate("@Model.CurrencyId"); 
         }        
    });

    function gridDetails_params(){
        return {
            id: $("#Id").val(),
            legalEntityId: $("#LegalEntityId").data("kendoDropDownList").value(),
            salaryPaymentDate: $("#SalaryPaymentDate").data("kendoDatePicker").value()
        }
    }

    function grid_params() {
        return {
            id: $("#Id").val()
        }
    }

    function LegalEntityId_Change() {
        GetPayroll();
    }

    function SalaryPaymentDate_Change() {
        GetPayroll();
    }

    function GetPayroll() { 
        if ($("#LegalEntityId").data("kendoDropDownList").value() != "" && $("#SalaryPaymentDate").data("kendoDatePicker").value() != null) { 
            $.ajax({
                type: "GET",
                dataType: "json",
                contentType: "application/x-www-form-urlencoded",
                async: false,
                data: { legalEntityId: $("#LegalEntityId").data("kendoDropDownList").value(), salaryPaymentDate: $("#SalaryPaymentDate").data("kendoDatePicker").value().toISOString() },
                url: "@Url.Action("GetPayrollId", "salarypaymentrequest")",
                success: function (result) {
                    if (result != "") { 
                        $("#PayrollId").val(result);
                        $("#gridDetail").data("kendoGrid").dataSource.read();
                    }
                }
            });
        }
    }

    $('#btnApprove').click(function () {
        $("#LogDescription").removeAttr("required", "required");
        callAction({ formId: "formSalaryPaymentRequest", title: "approve", type: "PUT", url: '@Url.Action("approve", "salarypaymentrequest")'});
    });

    $('#btnReject').click(function () {
        $("#LogDescription").attr("required", "required");
        callAction({ formId: "formSalaryPaymentRequest", title: "reject", type: "PUT", url: '@Url.Action("reject", "salarypaymentrequest")'});
    });

    $('#btnSave').click(function () {
        if (!isValid()) return;   
        callAction({ formId: "formSalaryPaymentRequest", title: "save", type: "POST", url: '@Url.Action("save", "salarypaymentrequest")', objects: result()});
    });

    $('#btnSubmit').click(function () {
        if (!isValid()) return;
        var gridJournal = $("#gridjournal").data("kendoGrid").dataSource.data();
        if (gridJournal.length == 0) {
            swal('Warning', 'Create journal first please !', 'warning');
            return false;
        }

        callAction({ formId: "formSalaryPaymentRequest", title: "submit", type: "POST", url: '@Url.Action("submit", "salarypaymentrequest")', objects: result()});
    });

    $('#btnCretaeJournal').click(function () {
        if (!isValid()) return;   
        callActionFile({ formId: "formSalaryPaymentRequest", title: "jurnal", type: "POST", url: '@Url.Action("CreateJournal", "salarypaymentrequest")', objects: result() }); 
    });


    function isValid() {
        var valid = $("#formSalaryPaymentRequest").validate().form();
        if (valid) {
            var grid = $("#gridDetail").data("kendoGrid").dataSource.data();
            if (grid.length == 0) {
                swal('Warning', 'Input detail data first please !', 'warning');
                return false;
            }
            return true;
        } else {
            return false;
        }
    }

    function result() {
        var gridDetail = $("#gridDetail").data("kendoGrid");
        var dataList = {
            Details: gridDetail.dataSource.data()
        }

        return dataList;
    }

    function currency_select(e) {
        if (e.dataItem) {
            exchangeRate(e.dataItem.Value);
        }
    }

    function exchangeRate(currencyId) {
        if (currencyId == "@PhoenixERPWebApp.Models.CurrencyIDR.CurrencyId") {
            $("#ExchangeRate").data("kendoNumericTextBox").readonly();
            $('#ExchangeRate').data("kendoNumericTextBox").value(1);
        } else {
            $("#ExchangeRate").data("kendoNumericTextBox").readonly(false);
            $('#ExchangeRate').data("kendoNumericTextBox").value(0);
        }
    }
</script>