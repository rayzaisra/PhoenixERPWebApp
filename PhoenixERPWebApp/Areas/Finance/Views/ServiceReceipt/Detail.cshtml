                <div class="m-portlet__head">
                    <div class="m-portlet__head-wrapper">
                        <div class="m-portlet__head-caption">
                            <div class="m-portlet__head-title">
                                <h3 class="m-portlet__head-text m--font-success">
                                    Service Receipt &nbsp;
                                    <span id="status"></span>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_qf2tcah4xx"><i class="la la-expand"></i></a>
                    </div>
                </div>
                <div class="m-portlet__body">
                    <div class="m-form__group">
                        <!--begin::Form-->
                        @*<input hidden name="approval_id" />*@
                        <form id="form-Servicereceipt" class="m-form m-form--fit m-form--label-align-right m-form--group-seperator-dashed">
                            <input type="hidden" asp-for="Id" />
                            @*<input hidden name="id" value="@ViewBag.RecordID" />*@
                            <input type="hidden" asp-for="CompanyId" />
                            <input type="hidden" asp-for="BrandId" />
                            <input type="hidden" asp-for="LegalEntityId" />
                            <input type="hidden" asp-for="BusinessUnitId" />
                            <input type="hidden" asp-for="JobId" />
                            <input type="hidden" asp-for="InvoicingTypeName" />
                            <input type="hidden" asp-for="PurchaseOrderNumber" />
                            <input type="hidden" asp-for="VendorName" />

                            <div class="row">
                                <div class="col-lg-6 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Service Receipt Number :</label>
                                        @Html.Kendo().TextBoxFor(m => m.ServiceReceiptNumber).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly", style = "width:100%", Placeholder = "Auto Generated by System.." })
                                        @*<input class="form-control form-control-sm" name="gr_number" id="gr_number" disabled />*@
                                    </div>
                                </div>
                                <div class="col-lg-6 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Reference Number :</label>
                                        @Html.Kendo().TextBoxFor(m => m.ReferenceNumber).HtmlAttributes(new { @class = "form-control form-control-sm" })
                                        @*<input id="reference_number" name="reference_number" class="form-control form-control-sm m-input m-input--square" type="text" />*@
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-6 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Vendor :</label>
                                        @(Html.Kendo().DropDownListFor(m => m.VendorId)
                                                                                            .DataTextField("Text")
                                                                                            .OptionLabel("Select Vendor...")
                                                                                            .DataValueField("Value")
                                                                                            .Filter(FilterType.Contains)
                                                                                            .DataSource(source =>
                                                                                            {
                                                                                                source.Read(read =>
                                                                                                {
                                                                                                    read.Action("GetDDLVendorInv", "DropDown", new { area = "Finance" });
                                                                                                });
                                                                                            })
                                                                                            //.Events(e =>
                                                                                            //{
                                                                                            //    e.Change("onSelectVendor");
                                                                                            //})
                                                                                            .HtmlAttributes(new { style = "width:100%;", @class = "form-control form-control-sm" })
                                        )
                                    </div>
                                </div>
                                <div class="col-lg-6 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Date :</label>
                                        @Html.Kendo().DatePickerFor(m => m.ServiceReceiptDatetime).HtmlAttributes(new { style = "width:100%" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-6 m-form__group-sub">
                                    <div class="form-group">
                                        <label>PO Number :</label>
                                        @(Html.Kendo().DropDownListFor(m => m.PurchaseOrderId)
                                                                                                    .DataTextField("Text")
                                                                                                    .OptionLabel("Select PO...")
                                                                                                    .DataValueField("Value")
                                                                                                    .Filter(FilterType.Contains)
                                                                                                    .DataSource(source =>
                                                                                                    {
                                                                                                        source.Read(read =>
                                                                                                        {
                                                                                                            read.Action("GetPOClient", "DropDown", new { area = "Finance" }).Data("filterPurchaseOrders");
                                                                                                        }).ServerFiltering(true); ;
                                                                                                    })
                                                                                                    .Events(e =>
                                                                                                    {
                                                                                                        e.Change("onSelectPO");
                                                                                                    })
                                                                                                    .CascadeFrom("VendorId")
                                                                                                    .Enable(false)
                                                                                                    .AutoBind(false)
                                                                                                    .HtmlAttributes(new { style = "width:100%;", @class = "form-control form-control-sm" })
                                        )
                                    </div>
                                </div>
                                <div class="col-lg-6 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Receipt By :</label>
                                        @Html.Kendo().TextBoxFor(m => m.ReceivedBy).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Invoicing Type :</label>
                                        @(Html.Kendo().DropDownListFor(m => m.InvoicingTypeId)
                                                                                                .DataTextField("Text")
                                                                                                .DataValueField("Value")
                                                                                                .BindTo(new List<SelectListItem>() {
                                                                                                                                                    new SelectListItem() {
                                                                                                                                                        Text = "SINGLE",
                                                                                                                                                        Value = "SINGLE"
                                                                                                                                                    },
                                                                                                                                                    new SelectListItem() {
                                                                                                                                                        Text = "MULTIPLE",
                                                                                                                                                        Value = "MULTIPLE"
                                                                                                                                                    }
                                                                                                })
                                                                                                .HtmlAttributes(new { style = "width: 100%" })
                                        )
                                    </div>
                                </div>
                                <div class="col-lg-6 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Term :</label>
                                        @Html.Kendo().TextBoxFor(m => m.Term).HtmlAttributes(new { @class = "form-control form-control-sm" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-6 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Job Id-name :</label>
                                        @Html.Kendo().TextBoxFor(m => m.JobName).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                    </div>
                                </div>
                                <div class="col-lg-6 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Division :</label>
                                        @Html.Kendo().TextBoxFor(m => m.BusinessUnitName).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Client :</label>
                                        @Html.Kendo().TextBoxFor(m => m.CompanyName).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                    </div>
                                </div>
                                <div class="col-lg-6 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Legal Entity :</label>
                                        @Html.Kendo().TextBoxFor(m => m.LegalEntityName).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 m-form__group-sub">
                                    <div class="form-group">
                                        <label>Brand Client :</label>
                                        @Html.Kendo().TextBoxFor(m => m.BrandName).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                        </form>
                        <!--end::Form-->
                    </div>
