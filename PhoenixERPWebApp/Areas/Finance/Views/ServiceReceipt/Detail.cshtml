                                                                                    //.NoRecords

                                                        )
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                                </div>
                                            </div>
                                        </div>
                        </div>
                    </div>
                </div>
                <div class="m-portlet__foot">
                    <div class="row">
                        <div class="col-lg-12">
                            <center>                                
                                <a href="@Url.Content("~/Finance/ServiceReceipt")" class="go-back btn btn-sm m-btn--sm btn-secondary m-btn m-btn--icon m-btn--wide m--margin-right-10">
                                    <span>
