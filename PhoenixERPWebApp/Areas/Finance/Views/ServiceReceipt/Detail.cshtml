<script>

    function GetPurchaseOrderId() {
        return {
            Id: $("#PurchaseOrderId").val()
        };
    }
    
    function filterPurchaseOrders() {
        return {
            clientId: $("#VendorId").val()
        };
    }

    function onSelectPO() {
        console.log("onSelectPo");
        console.log($("#VendorId").data("kendoDropDownList").text());
        if ($("#Id").val() != null && $("#Id").val() != "") {
            console.log("GetDataDetail");
            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });
            var srId = $("#detail-id").val();
            console.log("GetDataDetail");
            console.log(srId);
            var dataSource = new kendo.data.DataSource({
                transport: {
                    read: {
                        type: "json",
                        url: '@Url.Action("ReadDetail", "ServiceReceipt")',
                        data: {
                            Id: srId
                        }
                    }
                }, schema: {
                    data: (response) => {
                        //console.log(response)
                        // Augment returned data with a slice() method used internally by Kendo DataSource
                        // in the absence of "schema.model" to obtain a pristine copy of the object.
                        response.slice = () => JSON.parse(JSON.stringify(response.Data));
                        return response.Data;
                    },
                    total: (response) => {
                        return response.Total;
                    }
                },
                pageSize: 10
            });
        
            var gridv = $('#gridpod').data('kendoGrid');
            gridv.setDataSource(dataSource);
        
            mApp.unblock("#m_blockui_list");
           
        } else {
             if ($("#PurchaseOrderId").val() != "") {
                //GetDataInvoiceVendor();
                GetDataPODetail();
                //$('#PoNumberSpan').html($("#PoId").data("kendoDropDownList").text());
                //console.log("Before Reload Grid");
                //$("#gridpod").data("kendoGrid").dataSource.read();
                //$("#gridpod").data("kendoGrid").refresh();
                //console.log("After Reload Grid");
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetDataPO", "ServiceReceipt")',
                    data: { poId: $("#PurchaseOrderId").val() },
                    success: function (data) {
                        console.log(data)
                        $("#JobName").val(data.JobName);
                        $("#InvoicingTypeId").data("kendoDropDownList").value(data.InvoicingTypeId);
                        $("#LegalEntityName").val(data.LegalEntityName);
                        $("#BusinessUnitName").val(data.BusinessUnitName);
                        $("#Term").val(data.Term);
                        $("#CompanyName").val(data.CompanyName);
                        $("#BrandName").val(data.BrandName);                        
                        //ID
                        $("#BusinessUnitId").val(data.BusinessUnitId);
                        $("#BrandId").val(data.BrandId);
                        $("#CompanyId").val(data.CompanyId);
                        $("#LegalEntityId").val(data.LegalEntityId);
                        $("#JobId").val(data.JobId);
                        $("#InvoicingTypeName").val(data.InvoicingTypeName);
                        $("#PurchaseOrderNumber").val(data.PurchaseOrderNumber);
                    }
                });
            } else {
                $("#gridpod").data("kendoGrid").dataSource.data([]);
                $("#JobName").val("");
                $("#Term").val("");
                $("#BusinessUnitName").val("");
                $("#CompanyName").val("");
                $("#BrandName").val("");
                $("#LegalEntityName").val("");
                $("#InvoicingTypeId").data("kendoDropDownList").value("");
                //ID
                $("#BusinessUnitId").val("");
                $("#BrandId").val("");
                $("#CompanyId").val("");
                $("#LegalEntityId").val("");
                $("#JobId").val("");
                $("#InvoicingTypeName").val("");
                $("#PurchaseOrderNumber").val("");
            }
        }
    };

    function GetDataPODetail() {
        console.log("GetDataPODetail");
        mApp.block("#m_blockui_list", {
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        });
        var poId = $("#PurchaseOrderId").val();
        console.log("GetDataPODetail");
        console.log(poId);
        var dataSource = new kendo.data.DataSource({
            transport: {
                read: {
                    type: "json",
                    url: '@Url.Action("GetDataPODetail", "ServiceReceipt")',
                    data: {
                        poId: poId
                    }
                }
            }, schema: {
                data: (response) => {
                    //console.log(response)
                    // Augment returned data with a slice() method used internally by Kendo DataSource
                    // in the absence of "schema.model" to obtain a pristine copy of the object.
                    response.slice = () => JSON.parse(JSON.stringify(response.Data));
                    return response.Data;
                },
                total: (response) => {
                    return response.Total;
                }
            },
            pageSize: 10
        });
        
        var gridv = $('#gridpod').data('kendoGrid');
        gridv.setDataSource(dataSource);
        
        mApp.unblock("#m_blockui_list");
    };

    var param = (function (param) {
        param.saveUrl = "@Url.Action("Save", "ServiceReceipt")";
         @*param.submitUrl = "@Url.Action("Submit", "PurchaseRequest")";
         param.indexRefUrl = '@Url.Action("IndexRef", "RequestForQuotation")';
         param.saveDetails = "@Url.Action("SaveDetailWithAttachment", "RequestForQuotation")";*@
        return param;
    })(param || {});

    (function ($) {
        var pageFunction = (function (pageFunction) {
            pageFunction.init = function () {
                //initialize
            };
            pageFunction.save = function () {
                var gridDetails = $("#gridpod").data("kendoGrid");
                gridDetails.saveRow();
                var dataList = {
                    details: gridDetails.dataSource.data()
                }
                //callAction({ formId: "form", title: "save", type: "POST", url: param.saveUrl, objects: dataList });
                $("#VendorName").val($("#VendorId").data("kendoDropDownList").text());
                callAction({ formId: "form-Servicereceipt", title: "save", type: "POST", url: param.saveUrl, objects: dataList });
            };
            //pageFunction.submit = function () {
            //    var gridDetails = $("#grid-RequestforQuotationDetailList").data("kendoGrid");
            //    gridDetails.saveRow();
            //    var dataList = {
            //        details: gridDetails.dataSource.data()
            //    }
            //    callAction({ formId: "form", title: "submit", type: "POST", url: param.saveUrl, objects: dataList });
            //    //callAction({ formId: "form", title: "submit", type: "POST", url: param.submitUrl });
            //};
            //pageFunction.popUpRef = function (e) {
            //    e.preventDefault();
            //    var aptype = 1;
            //    $.ajax({
            //        type: 'GET',
            //        url: param.indexRefUrl,
            //        data: {
            //            aptype: aptype,
            //            VendorId: $('#VendorId').val()
            //        },
            //        success: function (result) {
            //            $('#refModal').html(result);

            //            $('#refModal').modal('show');
            //            mApp.unblock("#m_blockui_list");
            //        },
            //        error: function (e, t, s) {
            //            console.log(e)
            //            mApp.unblock("#m_blockui_list");
            //        }
            //    }).then(setTimeout(function () {
            //        mApp.unblock("#m_blockui_list");
            //    }, 2e3));
            //};

            return pageFunction;
        })(pageFunction || {});


        $(document).ready(function () {
            console.log("Init...");
            console.log($("#Id").val());
            if ($('#Id').val() != null && $('#Id').val() != "") {
                onSelectPO();
            };
            $("#ReceivedBy").val("@userSession.FullName").change();
            $('#btn-save').click(pageFunction.save);
        });
       
    }(jQuery));

</script>