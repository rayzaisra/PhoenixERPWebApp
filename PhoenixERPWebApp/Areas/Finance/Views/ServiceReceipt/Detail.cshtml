                                        <span>Close</span>
                                    </span>
                                </a>
                                <button type="button" id="btn-save" class="btn btn-sm m-btn--sm btn-brand m-btn m-btn--icon m-btn--wide m--margin-right-10">
                                    <span>
                                        <i class="la la-save"></i>
                                        <span>Save</span>
                                    </span>
                                </button>
                                <button style="display:none" type="button" id="btn-submit" class="btn btn-sm m-btn--sm btn-primary m-btn m-btn--icon m-btn--wide m--margin-right-10">
