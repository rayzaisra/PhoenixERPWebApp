@model PhoenixERPWebApp.Models.Finance.Transaction.StatementOfAccountPayable.StatementOfAccountPayableIndex
@{
    ViewData["Title"] = "Statement Of Account Payable";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">@ViewData["Title"]</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Finance</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="Index" asp-controller="StatementOfAccountPayable" asp-area="Finance" class="m-nav__link"><span class="m-nav__link-text">@ViewData["Title"]</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div>
                                @*<a asp-action="Detail" asp-controller="AccountPayableAging" asp-area="Finance" class="m-btn btn btn-primary btn-sm m-btn--sm" title="Add New Record"><i class="la la-plus"></i></a>*@
                                @*<button id="btn-delete" type="button" class="m-btn btn btn-danger btn-sm m-btn--sm" title="Delete Selection"><i class="la la-trash"></i></button>*@
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <div class="m-form__group">
                        <div class="row">
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label>Chart Of Account :</label>
                                    @Html.Kendo().DropDownListFor(m => m.ChartOfAccount).HtmlAttributes(new { @class = "form-control form-control-sm" })
                                </div>
                            </div>
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label>Vendor :</label>
                                    @Html.Kendo().DropDownListFor(m => m.Vendor).HtmlAttributes(new { @class = "form-control form-control-sm" })
                                </div>
                            </div>
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label>Legal :</label>
                                    @Html.Kendo().DropDownListFor(m => m.Legal).HtmlAttributes(new { @class = "form-control form-control-sm" })
                                </div>
                            </div>
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label>Begining Date :</label>
                                    @Html.Kendo().DatePickerFor(m => m.BeginDate).HtmlAttributes(new { @class = "m-input marvel-datepicker", style = "width:100%" })
                                </div>
                            </div>
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label>Ending Date :</label>
                                    @Html.Kendo().DatePickerFor(m => m.EndDate).HtmlAttributes(new { @class = "m-input marvel-datepicker", style = "width:100%" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12">
                                @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Finance.Transaction.StatementOfAccountPayable.StatementOfAccountPayableList>()
                                                                                    .Name("grid")
                                                                                    .Columns(columns =>
                                                                                    {
                                                                                        columns.Bound("").ClientTemplate("#= renderNumber(data) #").Title("#").Width(50);
                                                                                        columns.Bound(p => p.Vendor).Width(200);
                                                                                        columns.Bound(p => p.Brand).Width(200);
                                                                                        columns.Bound(p => p.EvidenNo).Width(200);
                                                                                        columns.Bound(p => p.Date).Width(200).Format("{0:dd/MMM/yyyy}");
                                                                                        columns.Bound(p => p.JobId).Width(200);
                                                                                        columns.Bound(p => p.Division).Width(200);
                                                                                        columns.Bound(p => p.Support).Width(200);
                                                                                        columns.Bound(p => p.Description).Width(200);
                                                                                        columns.Bound(p => p.Debet).Width(200);
                                                                                        columns.Bound(p => p.Credit).Width(200);
                                                                                        columns.Bound(p => p.Balance).Width(200);
                                                                                        columns.Command(command =>
                                                                                        {
                                                                                            command.Custom("").TemplateId("btnAction-template");
                                                                                        }).Title("Action").HtmlAttributes(new { style = "text-align:center;" })
                                                                                        .HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(90);
                                                                                    })
                                                                                    .Pageable(pageable => pageable
                                                                                        .Refresh(true)
                                                                                        .PageSizes(true)
                                                                                        .ButtonCount(5))
                                                                                    .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                                                                    .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                                                                                        .Extra(false)
                                                                                        .Operators(operators => operators
                                                                                        .ForString(str => str.Clear()
                                                                                            .Contains("Contains")
                                                                                            .StartsWith("Start sWith")
                                                                                            .EndsWith("End sWith")
                                                                                        )))
                                                                                    .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                                                                    .Resizable(rsz => rsz.Columns(true))
                                                                                    .DataSource(dataSource => dataSource
                                                                                        .Ajax()
                                                                                        .PageSize(10)
                                                                                        .Events(events => events.Error("errorHandler"))
                                                                                        .Model(model => { model.Id(p => p.Id); })
                                                                                        .Read(read => read.Action("Read", "StatementOfAccountPayable"))
                                                                                    )
                                )
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<script id="btnAction-template" type="text/x-kendo-template">
    <a href='javascript: void(0);' onclick='editGridRow(this)' title='Edit' class='edit'><span style='color:green'><i class='fa fa-edit'></i></span></a>
    <a href='javascript: void(0);' onclick='deleteGridRow(this)' title='Delete' class='delete'><span style='color:maroon'><i class='fa fa-trash-alt'></i></span></a>
</script>
<script>
    var counter = 1;

    function onDataBound(e) {
        counter = 1;
    }

    function renderNumber(data) {
        return counter++;
    }
    var param = (function (param) {
        param.editUrl = '@Url.Action("Detail", "StatementOfAccountPayable")?Id=';
        param.deleteUrl = '@Url.Action("Delete", "StatementOfAccountPayable")';
        return param;
    })(param || {});
</script>
<script src="~/Areas/Finance/Scripts/StatementOfAccountPayable/StatementOfAccountPayable.Index.js" asp-append-version="true"></script>