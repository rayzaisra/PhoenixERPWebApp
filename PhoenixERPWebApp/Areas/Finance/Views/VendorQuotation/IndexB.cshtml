@{
    ViewData["Title"] = "Vendor Quotation";
}

<link href="~/bundles/css/datatable.min.css" rel="stylesheet" />


<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Vendor Quotation</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Procurement & Expenses</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="@Url.Content("~/Finance/VendorQuotation")" class="m-nav__link">
                        <span class="m-nav__link-text">Vendor Quotation</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--mobile m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head m-portlet--head-sm">
                    <div class="m-portlet__head-caption ">
                        <div class="m-portlet__head-title">
                            <span class="m-portlet__head-icon">
                                <i class="fa fa-table m--font-brand"></i>
                            </span>
                            Choose vendor type &nbsp;
                            <h3 class="m-portlet__head-text">
                                <select class="form-control form-control-sm m-bootstrap-select m_selectpicker" data-width="200px" title="" id="rfqType">
                                    <option value="internal" selected='selected'>Internal</option>
                                    <option value="project">Project</option>
                                </select>
                            </h3>
                            <h3 class="m-portlet__head-text m--font-brand">
                                    <select class="form-control form-control-sm m-bootstrap-select m_selectpicker" data-width="200px" id="vendor_type">
                                        <option value="true" selected='selected'>Prefered vendor</option>
                                        <option value="false">Multiple vendor</option>
                                    </select>
                                </h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <div class="btn-group mr-2" role="group" aria-label="First group">
                                    @*<a href="@Url.Content("~/Finance/VendorQuotation/Detail/")" class="m-btn btn btn-secondary btn-sm m-btn--sm"><i class="la la-plus"></i></a>*@
                                    <button id="btn-delete" type="button" class="m-btn btn btn-secondary btn-sm m-btn--sm"><i class="la la-trash"></i></button>
                                </div>
                            </li>
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon"><i class="la la-expand"></i></a>
                            </li>
                        </ul>
                    </div>

                </div>
                <div class="m-portlet__body m-portlet__body--no-padding" id="m_blockui_list">
                    <div id="grid"></div>
                    <div id="dialog_grid"></div>
                    <script type="text/x-kendo-template" id="detail_template">
                        <div class="tabstrip">
                            <ul>
                                <li class="k-state-active">
                                    Details
                                </li>
                                <li>
                                    Status
                                </li>
                            </ul>
                            <div>
                                <div class="ca_detail"></div>
                            </div>
                            <div>
                                <div class='status-approval'></div>
                            </div>
                        </div>
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/demo/demo_12/custom/crud/forms/widgets/bootstrap-select.js" type="text/javascript"></script>
    <script src="~/Areas/Finance/Scripts/VendorQuotation.Index.js?_@DateTime.Now" asp-append-version="true"></script>
}