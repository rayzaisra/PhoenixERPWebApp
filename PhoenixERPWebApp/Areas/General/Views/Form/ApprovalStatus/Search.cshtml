@{
    ViewBag.ModalTitle = "ApprovalStatus";
    ViewBag.ModalId = "ApprovalStatusModalSearch";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}
<form id="ApprovalStatusFormSearch" method="post">
 
    <div class="row">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="approval_group_id">approval_group_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_approval_group_id" id="search_approval_group_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="approval_status">approval_status</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_approval_status" id="search_approval_status"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="status_level">status_level</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_status_level" id="search_status_level"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="status_name">status_name</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_status_name" id="search_status_name"  maxlength="400" type="text">
            </div>
                    
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="button" onclick="fnApprovalStatus.initsearch()" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> <span class="translate" data-args="app-search">search</span></button>
            <button type="button" onclick="fnApprovalStatus.initsearch('reset')" class="btn btn-success btn-sm"><i class="fa fa-backspace"></i> <span class="translate" data-args="app-reset">reset</span></button>
            <button type="button" data-dismiss="modal" class="btn btn-warning btn-sm"><i class="fa fa-times-circle"></i>  Close</button>
        </div>

    </div>
</form>