@{
    ViewBag.ModalTitle = "City";
    ViewBag.ModalId = "CityModalSearch";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}
<form id="CityFormSearch" method="post">
 
    <div class="row">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="city_code">city_code</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_city_code" id="search_city_code"  maxlength="5" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="city_name">city_name</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_city_name" id="search_city_name"  maxlength="400" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="country_id">country_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_country_id" id="search_country_id"  maxlength="50" type="text">
            </div>
                    
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="button" onclick="fnCity.initsearch()" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> <span class="translate" data-args="app-search">search</span></button>
            <button type="button" onclick="fnCity.initsearch('reset')" class="btn btn-success btn-sm"><i class="fa fa-backspace"></i> <span class="translate" data-args="app-reset">reset</span></button>
            <button type="button" data-dismiss="modal" class="btn btn-warning btn-sm"><i class="fa fa-times-circle"></i>  Close</button>
        </div>

    </div>
</form>