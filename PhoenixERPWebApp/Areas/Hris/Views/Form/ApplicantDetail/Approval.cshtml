@{
    ViewData["Title"] = "Applicant Detail Info Approval";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
    @*<a href="@Url.Content("~/Hris/Activity/create")" class="fakelink m-btn btn btn-primary btn-sm m-btn--sm"><i class="la la-plus"></i></a>*@
}

@section Paneltools{
    @*<a  data-target="#ActivityModalSearch" data-toggle="modal" class="btn btn-circle btn-outline btn-sm"><i class="la la-search"></i> <span class="translate" data-args="app-search">Search</span></a>*@
}
@section Panelbody{
    <style>
        .m-margin__top-20 {
            margin-top: 20px !important;
        }

        .redtext {
            color: red !important;
        }

        .bluetext {
            color: blue !important;
        }

        .greentext {
            color: greenyellow !important;
        }
    </style>
    <script>
        $('#xbreadcrumb').hide();
    </script>

    <input value="@ViewBag.RecordID" type="hidden" name="id" id="id" />
    <input value="@ViewBag.RecordIDSec" type="hidden" name="job_vacancy_id" id="job_vacancy_id" />
    <div class="row">
        <div class="col-lg-9">
            <legend>Applicant Detail Info Approval Page</legend>
            <div class="form-group">&nbsp;</div>
        </div>
        <div class="col-lg-2">
            <div class="form-group">
                <a href="@Url.Content("~/Hris/Applicant/TrackingNewApplicant/")@ViewBag.RecordIDSec" class="btn btn-primary">< Back to Job Tracking</a>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-3">
            <div class="form-group">
                &nbsp;
            </div>
        </div>
        <div class="col-lg-3">
            <div class="form-group">
                &nbsp;
            </div>
        </div>
        <div class="col-lg-9">
            <div class="form-group">
                <a href="@Url.Content("~/Hris/ApplicantDetail/Interview/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" class="btn btn-secondary">Interview</a>
                <a href="@Url.Content("~/Hris/ApplicantDetail/Comment/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" class="btn btn-secondary">Comment</a>
                <a href="@Url.Content("~/Hris/ApplicantDetail/Approval/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" class="btn btn-primary">Approved</a>
                <a href="@Url.Content("~/Hris/ApplicantDetail/ApplicantReject/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" class="btn btn-secondary">Reject</a>
                <a href="@Url.Content("~/Hris/ApplicantDetail/Training/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" class="btn btn-secondary">Screening Test</a>
                <a href="@Url.Content("~/Hris/ApplicantDetail/ApplicantMoveStage/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" class="btn btn-secondary">Move Stage</a>
            </div>
        </div>
    </div>
    <br />
    <br />
    <div class="row">
        <div class="col-lg-3">
            <div class="form-group">
                <label><span class="translate" data-args="Applicant ID">Applicant ID</span> :</label>
                <input type="text" class="form-control form-control-sm m-input m-input--square" name="applicant_code" id="applicant_code" readonly/>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="form-group">
                <label><span class="translate" data-args="Posting Code">Posting Code</span> :</label>
                <input type="text" class="form-control form-control-sm m-input m-input--square" name="posting_code" id="posting_code" readonly />
            </div>
        </div>
        <div class="col-lg-3">
            <div class="form-group">
                <label><span class="translate" data-args="Status">Status</span> :</label>
                <input type="text" class="form-control form-control-sm m-input m-input--square" name="posting_status" id="posting_status" readonly />
            </div>
        </div>
        <div class="col-lg-3">
            <div class="form-group">
                <label><span class="translate" data-args="Recruitment Status">Recruitment Status</span> :</label>
                <input type="text" class="form-control form-control-sm m-input m-input--square" name="recruitment_status" id="recruitment_status" readonly/>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-3">
            <div class="form-group">
                <label><span class="translate" data-args="Vacancy">Vacancy</span> :</label>
                <input type="text" class="form-control form-control-sm m-input m-input--square" name="vacancy_name" id="vacancy_name" readonly/>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="form-group">&nbsp;</div>
        </div>
        <div class="col-lg-3">
            <div class="form-group">&nbsp;</div>
        </div>
        <div class="col-lg-3">
            <div class="form-group">&nbsp;</div>
        </div>
    </div>
    <hr />
    <legend>Approval Applicant</legend>
    <form id="ApplicantApprovalForm" name="ApplicantApprovalForm" method="post">
        <input value="@ViewBag.RecordID" type="hidden" name="id" id="id" />
        <input value="@ViewBag.RecordIDSec" type="hidden" name="job_vacancy_id" id="job_vacancy_id" />
        <input type="hidden" name="applicant_progress_id" id="applicant_progress_id" />
        <input type="hidden" name="candidate_recruitment_id" id="candidate_recruitment_id" />
        <div class="row">
            <div class="col-lg-12 m-form__group-sub">
                <div class="form-group">

                    <div class="m-section__content">

                        <table class="table table-striped table-bordered table-hover table-checkable" id="JobVacancyAprovalApproverList">
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Title</th>
                                    <th>Approver Name</th>
                                    <th><center>Approval Status</center></th>
                                    <th><center>Approved Date</center></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr id="no_data">
                                    <td colspan="5">No Data</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                @*<center>
            <a href="#" class="fakelink btn btn-success" onclick="ApprovedData()">Approved</a>
            <a href="#" class="fakelink btn btn-danger">Reject</a>
            <a href="@Url.Content("~/Hris/ApplicantDetail/PersonalInfo/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" class="fakelink btn btn-secondary">Close</a>
        </center>*@
                <div class="col-lg-12" id="with_approval" style="display:none">
                    <center>

                        <a href="#" class="fakelink btn btn-success" onclick="ApprovedData()">Approved</a>
                        <a data-target="#MppApprovedStatusModalSearch" data-toggle="modal" id="btn-submit" name="btn-submit" class="btn btn-danger"><span class="translate" data-args="reject">Reject</span></a>
                        <a href="@Url.Content("~/Hris/ApplicantDetail/PersonalInfo/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" class="fakelink btn btn-secondary">Close</a>
                    </center>
                </div>
                <div class="col-lg-12" id="no_approval">
                    <center>
                        <a href="@Url.Content("~/Hris/ApplicantDetail/PersonalInfo/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" class="fakelink btn btn-secondary">Close</a>
                    </center>
                </div>
            </div>

        </div>
    </form>

}
@section Panelscript{
    <script src="~/approval/gmApproval.js"></script>
    <script src="~/assets/js/Areas/Hris/Form/ApplicantDetail.applicantapproval.js"></script>
}
