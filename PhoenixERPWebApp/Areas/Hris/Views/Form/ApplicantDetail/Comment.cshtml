@{
    ViewData["Title"] = "Applicant Detail Info";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
    @*<a href="@Url.Content("~/Hris/Activity/create")" class="fakelink m-btn btn btn-primary btn-sm m-btn--sm"><i class="la la-plus"></i></a>*@
}

@section Paneltools{
    @*<a  data-target="#ActivityModalSearch" data-toggle="modal" class="btn btn-circle btn-outline btn-sm"><i class="la la-search"></i> <span class="translate" data-args="app-search">Search</span></a>*@
}
@section Panelbody{
    <script>
        $('#xbreadcrumb').hide();
    </script>
    <form id="AplicantTrackingFormNewApplicant" name="AplicantTrackingFormNewApplicant" method="post">
        <input value="@ViewBag.RecordID" type="hidden" name="id" id="id" />
        <input value="@ViewBag.RecordIDSec" type="hidden" name="job_vacancy_id" id="job_vacancy_id" />
        <div class="row">
            <div class="col-lg-9">
                <legend>Applicant Detail Info</legend>
                <div class="form-group">&nbsp;</div>
            </div>
            <div class="col-lg-2">
                <div class="form-group">
                    <a href="@Url.Content("~/Hris/Applicant/TrackingNewApplicant/")@ViewBag.RecordIDSec" class="btn btn-primary">< Back to Job Tracking</a>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-3">
                <div class="form-group">
                    &nbsp;
                </div>
            </div>
            <div class="col-lg-3">
                <div class="form-group">
                    &nbsp;
                </div>
            </div>
            <div class="col-lg-9">
                <div class="form-group">
                    <a href="@Url.Content("~/Hris/ApplicantDetail/Interview/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" class="btn btn-secondary">Interview</a>
                    <a href="@Url.Content("~/Hris/ApplicantDetail/Comment/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" class="btn btn-primary">Comment</a>
                    <a href="#" class="btn btn-secondary" onclick="ApprovedData()">Approval Status</a>
                    <a href="@Url.Content("~/Hris/ApplicantDetail/ApplicantReject/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" class="btn btn-secondary">Reject</a>
                    <a href="@Url.Content("~/Hris/ApplicantDetail/Training/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" class="btn btn-secondary">Screening Test</a>
                    <a href="@Url.Content("~/Hris/ApplicantDetail/ApplicantMoveStage/"+@ViewBag.RecordID+"/"+@ViewBag.RecordIDSec)" style="border-style: solid; border-color: blue;"  class="btn btn-secondary">Move Stage</a>
                </div>
            </div>
        </div>
        <br />
        <br />
        <div class="row">
            <div class="col-lg-3">
                <div class="form-group">
                    <label><span class="translate" data-args="Applicant ID">Applicant ID</span> :</label>
                    <input type="text" class="form-control form-control-sm m-input m-input--square" name="applicant_code" id="applicant_code" readonly/>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="form-group">
                    <label><span class="translate" data-args="Posting Code">Posting Code</span> :</label>
                    <input type="text" class="form-control form-control-sm m-input m-input--square" name="posting_code" id="posting_code" readonly />
                </div>
            </div>
            <div class="col-lg-3">
                <div class="form-group">
                    <label><span class="translate" data-args="Status">Status</span> :</label>
                    <input type="text" class="form-control form-control-sm m-input m-input--square" name="posting_status" id="posting_status" readonly />
                </div>
            </div>
            <div class="col-lg-3">
                <div class="form-group">
                    <label><span class="translate" data-args="Recruitment Status">Recruitment Status</span> :</label>
                    <input type="text" class="form-control form-control-sm m-input m-input--square" name="recruitment_status" id="recruitment_status" readonly/>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-3">
                <div class="form-group">
                    <label><span class="translate" data-args="Vacancy">Vacancy</span> :</label>
                    <input type="text" class="form-control form-control-sm m-input m-input--square" name="vacancy_name" id="vacancy_name" readonly/>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="form-group">&nbsp;</div>
            </div>
            <div class="col-lg-3">
                <div class="form-group">&nbsp;</div>
            </div>
            <div class="col-lg-3">
                <div class="form-group">&nbsp;</div>
            </div>
        </div>
        <hr />
        <div id="content_comment">
            <div class="row">
                <div class="col-lg-6">
                    <div class="form-group">
                        <label><b><span class="translate" data-args="No Comments Yet">No Comments Yet</span>  </b></label>
                    </div>
                    <div class="form-group">
                        <label>Be the first to share what you think</label>
                    </div>
                    <hr />
                </div>
            </div>
        </div>
       
        <br />
        <br />
        <div class="row">
            <div class="col-lg-12">
                <div class="form-group">
                    <label><span class="translate" data-args="Add Comment">Add Comment</span> </label>
                </div>
                <div class="form-group">
                    <textarea id="comment_message" name="comment_message" class="form-control form-control-sm" rows="10"></textarea>
                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-lg-12">
                <button type="button" class="btn btn-primary" onclick="SaveComment()"><span class="translate" data-args="Save">Save Comment</span></button>
            </div>

        </div>
    </form>

}
@section Panelscript{
    <script src="~/assets/js/Areas/Hris/Form/ApplicantDetail.comment.js"></script>
}
