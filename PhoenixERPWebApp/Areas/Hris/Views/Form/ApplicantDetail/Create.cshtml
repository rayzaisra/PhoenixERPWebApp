@{
    ViewData["Title"] = "Activity";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
<span class="translate" data-args="create">Create</span>
}

@section Paneltools{

}
@section Panelbody{
    <script>
        $('#xbreadcrumb').hide();
    </script>
<form id="ActivityFormCreate" method="post">
    <div class="row ">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="code">code</span> <span class="req">*</span>:</label>
                <input class="form-control form-control-sm m-input m-input--square" name="code" id="code" required maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="description">description</span> <span class="req">*</span>:</label>
                <input class="form-control form-control-sm m-input m-input--square" name="description" id="description" required maxlength="2147483647" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="type">type</span> <span class="req">*</span>:</label>
                <input class="form-control form-control-sm m-input m-input--square" name="type" id="type" required maxlength="50" type="text">
            </div>
            
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="submit" id="btn-save" class="btn btn-primary">Save</button>
            <a href="~/Hris/Activity" class="fakelink btn btn-secondary">Close</a>
        </div>

    </div>
</form>
}
@section Panelscript{
    <script src="~/assets/js/Areas/Hris/Form/Activity.create.js"></script>
}
