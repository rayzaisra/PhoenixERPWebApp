@{
    ViewData["Title"] = "BscCategory";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
<span class="translate" data-args="create">Create</span>
}

@section Paneltools{

}
@section Panelbody{
<form id="BscCategoryFormCreate" method="post">
    <div class="row ">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="bsc_category">bsc_category</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="bsc_category" id="bsc_category"  maxlength="255" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="bsc_description">bsc_description</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="bsc_description" id="bsc_description"  maxlength="255" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="status_id">status_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="status_id" id="status_id"   type="number">
            </div>
            
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="submit" id="btn-save" class="btn btn-primary">Save</button>
            <a href="~/Hris/BscCategory" class="fakelink btn btn-secondary">Close</a>
        </div>

    </div>
</form>
}
@section Panelscript{
    <script src="~/assets/js/Areas/Hris/Form/BscCategory.create.js"></script>
}
