@{
    ViewBag.ModalTitle = "CompanyAccount";
    ViewBag.ModalId = "CompanyAccountModalSearch";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}
<form id="CompanyAccountFormSearch" method="post">
 
    <div class="row">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="bankbranch_id">bankbranch_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_bankbranch_id" id="search_bankbranch_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="bank_account_id">bank_account_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_bank_account_id" id="search_bank_account_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="bank_id">bank_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_bank_id" id="search_bank_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="branchcomapany_id">branchcomapany_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_branchcomapany_id" id="search_branchcomapany_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="branch_name">branch_name</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_branch_name" id="search_branch_name"  maxlength="2147483647" type="text">
            </div>
                    
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="button" onclick="fnCompanyAccount.initsearch()" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> <span class="translate" data-args="app-search">search</span></button>
            <button type="button" onclick="fnCompanyAccount.initsearch('reset')" class="btn btn-success btn-sm"><i class="fa fa-backspace"></i> <span class="translate" data-args="app-reset">reset</span></button>
            <button type="button" data-dismiss="modal" class="btn btn-warning btn-sm"><i class="fa fa-times-circle"></i>  Close</button>
        </div>

    </div>
</form>