@{
    ViewData["Title"] = "CompetenceLevel";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
<span class="translate" data-args="update">Update</span>
}

@section Paneltools{

}
@section Panelbody{
<form id="CompetenceLevelFormUpdate" method="post">
    <div class="row ">
        <div class="col-lg-12"><input value="@ViewBag.RecordID" type="hidden" name="id" />

            <div class="form-group">
                <label><span class="translate" data-args="competence_id">competence_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="competence_id" id="competence_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="level_position_id">level_position_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="level_position_id" id="level_position_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="level_req">level_req</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="level_req" id="level_req"   type="number">
            </div>
            
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="submit" id="btn-save" class="btn btn-primary">Save</button>
            <a href="~/Hris/CompetenceLevel" class="fakelink btn btn-secondary">Close</a>
        </div>

    </div>
</form>
}
@section Panelscript{
    <script src="~/assets/js/Areas/Hris/Form/CompetenceLevel.update.js"></script>
}
