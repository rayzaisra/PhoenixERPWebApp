@{
    ViewBag.ModalTitle = "Education";
    ViewBag.ModalId = "EducationModalSearch";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}
<form id="EducationFormSearch" method="post">
 
    <div class="row">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="address">address</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_address" id="search_address"  maxlength="100" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="education_level_id">education_level_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_education_level_id" id="search_education_level_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="employee_basic_info_id">employee_basic_info_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_employee_basic_info_id" id="search_employee_basic_info_id"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="end_education">end_education</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_end_education" id="search_end_education"  maxlength="100" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="institution_id">institution_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_institution_id" id="search_institution_id"  maxlength="60" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="majors">majors</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_majors" id="search_majors"  maxlength="100" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="start_education">start_education</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_start_education" id="search_start_education"  maxlength="100" type="text">
            </div>
                    
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="button" onclick="fnEducation.initsearch()" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> <span class="translate" data-args="app-search">search</span></button>
            <button type="button" onclick="fnEducation.initsearch('reset')" class="btn btn-success btn-sm"><i class="fa fa-backspace"></i> <span class="translate" data-args="app-reset">reset</span></button>
            <button type="button" data-dismiss="modal" class="btn btn-warning btn-sm"><i class="fa fa-times-circle"></i>  Close</button>
        </div>

    </div>
</form>