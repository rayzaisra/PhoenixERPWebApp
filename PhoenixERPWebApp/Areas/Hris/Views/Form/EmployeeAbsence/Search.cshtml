@{
    ViewBag.ModalTitle = "EmployeeAbsence";
    ViewBag.ModalId = "EmployeeAbsenceModalSearch";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}
<form id="EmployeeAbsenceFormSearch" method="post">
 
    <div class="row">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="date_absence">date_absence</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_date_absence" id="search_date_absence"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="employee_basic_info_id">employee_basic_info_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_employee_basic_info_id" id="search_employee_basic_info_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="note">note</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_note" id="search_note"  maxlength="100" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="time_back">time_back</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_time_back" id="search_time_back"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="time_come">time_come</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_time_come" id="search_time_come"   type="number">
            </div>
                    
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="button" onclick="fnEmployeeAbsence.initsearch()" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> <span class="translate" data-args="app-search">search</span></button>
            <button type="button" onclick="fnEmployeeAbsence.initsearch('reset')" class="btn btn-success btn-sm"><i class="fa fa-backspace"></i> <span class="translate" data-args="app-reset">reset</span></button>
            <button type="button" data-dismiss="modal" class="btn btn-warning btn-sm"><i class="fa fa-times-circle"></i>  Close</button>
        </div>

    </div>
</form>