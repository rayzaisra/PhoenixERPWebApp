@{
    ViewBag.ModalTitle = "EmployeeBank";
    ViewBag.ModalId = "EmployeeBankModalSearch";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}
<form id="EmployeeBankFormSearch" method="post">
 
    <div class="row">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="account_name">account_name</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_account_name" id="search_account_name"  maxlength="100" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="account_no">account_no</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_account_no" id="search_account_no"  maxlength="60" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="bank_address">bank_address</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_bank_address" id="search_bank_address"  maxlength="10" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="bank_city">bank_city</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_bank_city" id="search_bank_city"  maxlength="10" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="bank_id">bank_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_bank_id" id="search_bank_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="branch">branch</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_branch" id="search_branch"  maxlength="10" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="currency_id">currency_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_currency_id" id="search_currency_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="employee_basic_info_id">employee_basic_info_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_employee_basic_info_id" id="search_employee_basic_info_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="end_date">end_date</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_end_date" id="search_end_date"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="start_date">start_date</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_start_date" id="search_start_date"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="sub_bank_id">sub_bank_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_sub_bank_id" id="search_sub_bank_id"  maxlength="50" type="text">
            </div>
                    
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="button" onclick="fnEmployeeBank.initsearch()" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> <span class="translate" data-args="app-search">search</span></button>
            <button type="button" onclick="fnEmployeeBank.initsearch('reset')" class="btn btn-success btn-sm"><i class="fa fa-backspace"></i> <span class="translate" data-args="app-reset">reset</span></button>
            <button type="button" data-dismiss="modal" class="btn btn-warning btn-sm"><i class="fa fa-times-circle"></i>  Close</button>
        </div>

    </div>
</form>