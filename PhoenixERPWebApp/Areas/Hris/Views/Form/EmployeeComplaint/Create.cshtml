@{
    ViewData["Title"] = "EmployeeComplaint";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
<span class="translate" data-args="create">Create</span>
}

@section Paneltools{

}
@section Panelbody{
<form id="EmployeeComplaintFormCreate" method="post">
    <div class="row ">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="complaint_date">complaint_date</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="complaint_date" id="complaint_date"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="complaint_description">complaint_description</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="complaint_description" id="complaint_description"  maxlength="2147483647" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="complaint_title">complaint_title</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="complaint_title" id="complaint_title"  maxlength="150" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="employee_basic_info_id">employee_basic_info_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="employee_basic_info_id" id="employee_basic_info_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="notes">notes</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="notes" id="notes"  maxlength="2147483647" type="text">
            </div>
            
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="submit" id="btn-save" class="btn btn-primary">Save</button>
            <a href="~/Hris/EmployeeComplaint" class="fakelink btn btn-secondary">Close</a>
        </div>

    </div>
</form>
}
@section Panelscript{
    <script src="~/assets/js/Areas/Hris/Form/EmployeeComplaint.create.js"></script>
}
