@{
    ViewData["Title"] = "Group Create";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
    var userSession = CodeMarvel.Infrastructure.Sessions.SessionManager.UserSession;
}
@section Panelhead{
    <span class="translate" data-args="create">Create</span>
}

@section Paneltools{

}
@section Panelbody{
    <form id="GroupFormCreate" method="post">
        <input type="hidden" name="business_unit_type_id" id="business_unit_type_id" value="0C153DE5-383F-40D5-9BEE-D390E2A0344E" />
        <input type="hidden" name="parent_unit" id="parent_unit" />
        <input type="hidden" name="affiliation_id" id="affiliation_id" value="27f5efff-e898-473b-b5d6-890429706b1c" />
        <input type="hidden" name="organization_id" id="organization_id" />
        <div class="row ">
            <div class="col-lg-12">
                <div class="form-group">
                    <label><span class="translate" data-args="group_code">Group Code</span> :</label>
                    <input class="form-control form-control-sm m-input m-input--square" name="unit_code" id="unit_code" maxlength="50" type="text" required>
                </div>
                <div class="form-group">
                    <label><span class="translate" data-args="group_name">Group Name</span> :</label>
                    <input class="form-control form-control-sm m-input m-input--square" name="unit_name" id="unit_name" maxlength="100" type="text" required>
                </div>
                <div class="form-group">
                    <label><span class="translate" data-args="description">Description</span> :</label>
                    <input class="form-control form-control-sm m-input m-input--square" name="unit_description" id="unit_description" maxlength="100" type="text">
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-lg-12">
                <button type="submit" id="btn-save" class="btn btn-primary">Save</button>
                <a href="~/Hris/Group" class="fakelink btn btn-secondary">Close</a>
            </div>
        </div>
    </form>
}
@section Panelscript{
    <script>
        var OrganizationID = "@userSession.OrganizationID";
        $('#organization_id').val(OrganizationID);
    </script>
    <script src="~/assets/js/Areas/Hris/Form/Group.create.js"></script>
}
