@{
    ViewData["Title"] = "HiringRequest";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
    <span class="translate" data-args="Approval Hiring Request">Approval Hiring Request</span>
}

@section Paneltools{

}
@section Panelbody{
    <style>
        .m-margin__top-20 {
            margin-top: 20px !important;
        }

        .redtext {
            color: red !important;
        }

        .bluetext {
            color: blue !important;
        }

        .greentext {
            color: greenyellow !important;
        }
    </style>
    <form id="HiringRequestApprovalFormCreate" method="post">
        <input value="@ViewBag.RecordID" type="hidden" name="id" id="id" />
        <fieldset>
            <div class="row">
                <div class="col-sm-3">
                    <div class="form-group">
                        <label for="first_name">Request Code *</label>
                        <input type="text" class="form-control" id="code" name="code" readonly />
                    </div>
                </div>
                <div class="col-sm-3">
                    &nbsp;
                </div>
                <div class="col-sm-3">
                    &nbsp;
                </div>
                <div class="col-sm-3">
                    &nbsp;
                </div>
            </div>
            <div class="row">
                <div class="col-sm-3">
                    <div class="form-group">
                        <label for="first_name">Requester Name*</label>
                        <input type="hidden" class="form-control" id="requester_employee_basic_info_id" name="requester_employee_basic_info_id" />
                        <input type="text" class="form-control" id="requester_name" name="requester_name" readonly />
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label for="first_name">Title *</label>
                        <input type="text" class="form-control" id="job_title_requester" name="job_title_requester" readonly />
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label for="first_name">Division *</label>
                        <input type="hidden" class="form-control" id="division_id" name="division_id" />
                        <input type="text" class="form-control" id="division_name" name="division_name" readonly />
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label for="first_name">Departement *</label>
                        <input type="hidden" class="form-control" id="business_unit_id" name="business_unit_id" />
                        <input type="text" class="form-control" id="business_unit_name" name="business_unit_name" readonly />
                    </div>
                </div>
            </div>
        </fieldset>
        <hr />
        <div class="row">

            <!-- Begin: Select Job Title -->
            <div class="col-lg-3 m-form__group-sub">
                <div class="form-group">
                    <label>Select Job Title :</label>
                    <input type="hidden" class="form-control" id="job_title_id" name="job_title_id" />
                    <input type="text" class="form-control" id="job_title_name" name="job_title_name" readonly />
                </div>
            </div>
            <div class="col-lg-9 m-form__group-sub m-margin__top-30" id="label_budgeted" style="display:block">
                <div class="m-section__content">
                    <div class="m-demo" data-code-preview="true" data-code-html="true" data-code-js="false">
                        <div class="m-demo__preview">
                            <center><h3>Category <B><span id="inner_label_budgeted">Budgeted</span></B></h3></center>
                        </div>
                    </div>

                </div>
            </div>
            <!-- end:: Button Proccess -->

        </div>
        <hr />

        <div class="row" id="budgeted_div" style="display:block">
            <div class="col-lg-12 m-form__group-sub">
                <div class="form-group">
                    <label>
                        <h5>Request Man Power</h5>
                    </label>
                    <div class="m-section__content">
                        <div class="m-demo" data-code-preview="true" data-code-html="true"
                             data-code-js="false">
                            <div class="m-demo__preview" id="employee_hiring">

                                <br />
                                <div class="row">
                                    <div class="col-sm-12">
                                        <!-- begin: Datatable -->
                                        <table class="table table-striped- table-bordered table-hover table-checkable"
                                               id="dt_basic">
                                            <thead>
                                                <tr>

                                                    <th>Job Title</th>
                                                    <th>Grade</th>
                                                    <th id="tff_head">TTF</th>
                                                    <th id="employeestatus_head">Employment Status</th>
                                                    <th>Budget Source</th>
                                                    <th id="mppbudget_head">MPP Budget</th>
                                                    <th><center>Date of Joining</center></th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                        <!-- end:: Datatable -->
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <br />
        <br />
        <div class="row">
            <div class="col-lg-12 m-form__group-sub">
                <div class="form-group">
                    <label>
                        <h5>Approval</h5>
                    </label>
                    <div class="m-section__content">
                        @*<div class="m-demo" data-code-preview="true" data-code-html="true"
                                 data-code-js="false">
                                <div class="m-demo__preview" id="Approval">
                                    <h4>
                                        Associate HD Director
                                    </h4>
                                    <hr>
                                    <h6 style="font-style: italic">Waiting Approval</h6>
                                </div>
                            </div>*@
                        <table class="table table-striped table-bordered table-hover table-checkable" id="HiringRequestAprovalApproverList">
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Title</th>
                                    <th>Approver Name</th>
                                    <th><center>Approval Status</center></th>
                                    <th><center>Approved Date</center></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr id="no_data">
                                    <td colspan="5">No Data</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-lg-12" id="with_approval" style="display:none">
                <center>
                    <a href="#" class="fakelink btn btn-success" onclick="ApprovedData()">Approved</a>
                    <a href="#" class="fakelink btn btn-danger">Reject</a>
                    <a href="~/Hris/HiringRequest" class="fakelink btn btn-secondary">Close</a>
                </center>
            </div>
            <div class="col-lg-12" id="no_approval">
                <center>
                    <a href="~/Hris/HiringRequest" class="fakelink btn btn-secondary">Close</a>
                </center>
            </div>

        </div>
    </form>

}
@section Panelscript{
    <script src="~/approval/gmApproval.js"></script>
    <script src="~/assets/js/Areas/Hris/Form/HiringRequest.approval.js"></script>
}
