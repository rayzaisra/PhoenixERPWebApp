@{
    ViewBag.ModalTitle = "Hiring Request Budgeted";
    ViewBag.ModalId = "HiringRequestModalDetail";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}
<form id="HiringRequestFormDetail" method="post">
    <input type="hidden" name="Id" id="Id">
    <input type="hidden" name="indexBudget" id="indexBudget" />
    <div class="row m-row--col-separator-xl">
        <div class="col-lg-4">
            <div class="form-group">
                <label><span class="translate" data-args="Time to Fullfill">Time to Fullfill</span> :</label>
                <input type="text" name="time_to_fullfill" id="time_to_fullfill" class="md-input form-control form-control-sm m-input m-input--square" readonly>
                <span class="md-input-bar "></span>
            </div>
            <div class="form-group">
                <label><span class="translate" data-args="Status"> Status</span> :</label>
                <input type="text" name="employment_status" id="employment_status" class="md-input form-control form-control-sm m-input m-input--square" readonly>

            </div>
        </div>
        <div class="col-lg-4">
            <div class="form-group">
                <label><span class="translate" data-args="Job Title">Job Title</span> :</label>
                <input type="hidden" name="job_title_id" id="job_title_id">
                <input type="hidden" name="porject_name" id="porject_name">
                <input type="text" name="job_title_nm" id="job_title_nm" class="md-input form-control form-control-sm m-input m-input--square" readonly>
            </div>
            <div class="form-group">
                <label><span class="translate" data-args="Budget Source">Budget Source</span> :</label>
                <input type="text" name="budget_source" id="budget_source" class="md-input form-control form-control-sm m-input m-input--square" readonly>

            </div>

        </div>
        <div class="col-lg-4">
            <div class="form-group">
                <label><span class="translate" data-args="Grade">Grade</span> :</label>
                <input type="hidden" name="job_grade_idu" id="job_grade_idu">
                <input type="text" name="Job_Grade" id="Job_Grade" class="md-input form-control form-control-sm m-input m-input--square" readonly>
            </div>
            <div class="form-group">
                <label><span class="translate" data-args="Mpp Budget">Mpp Budget</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="mppBudget" id="mppBudget" type="number" readonly>
            </div>

        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-6">
            <div class="form-group">
                <label><span class="translate" data-args="Date Fullfillment">Date Fullfillment</span> :</label>
                <div class="input-group date" data-provide="datepicker" data-date-format="yyyy-mm-dd">
                    <input type="text" class="form-control" id="dff" name="dff">
                    <span class="input-group-btn">
                        <button class="btn default" type="button">
                            <i class="fa fa-calendar"></i>
                        </button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <div class="form-group">
                <label><span class="translate" data-args="Detail Spesification">Detail Spesification</span> :</label>
                <textarea class="form-control form-control-sm m-input m-input--square" name="detail_spesification" id="detail_spesification"></textarea>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="form-group">
                <label><span class="translate" data-args="Detail Requirement">Detail Requirement</span> :</label>
                <textarea class="form-control form-control-sm m-input m-input--square" name="detail_requirement" id="detail_requirement"></textarea>
            </div>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="button" id="btn-save" class="btn btn-primary" onclick="SaveDetilBudget()">Save</button>
            <button type="button" id="btn-remove" class="btn btn-danger" onclick="RemoveDetilBudget()">Remove</button>
            <button type="button" data-dismiss="modal" class="btn btn-secondary">Close</button>
        </div>

    </div>
</form>