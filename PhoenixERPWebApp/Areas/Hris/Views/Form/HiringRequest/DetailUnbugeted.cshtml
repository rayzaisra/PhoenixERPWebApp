@{
    ViewBag.ModalTitle = "Hiring Request Unbudgeted";
    ViewBag.ModalId = "HiringRequestModalDetailUnbugeted";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}
<form id="HiringRequestFormDetailUnbugeted" method="post">
    <div class="row m-row--col-separator-xl">
        <div class="col-lg-4">
            <div class="form-group">
                <label><span class="translate" data-args="Job Title">Job Title</span> :</label>
                <input type="hidden" name="job_title_id" id="job_title_id_ub">
                <input type="hidden" name="job_grade_id" id="job_grade_id_ub">
                <input type="text" name="job_title_name" id="job_title_name_ub" class="md-input form-control form-control-sm m-input m-input--square" readonly>
            </div>
            <div class="form-group">
                <label><span class="required translate" data-args="Salary">Salary</span> :</label>
                <input type="number" name="mppBudget_ub" id="mppBudget_ub" class="md-input form-control form-control-sm m-input m-input--square" required>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="form-group">
                <label><span class="translate" data-args="grade">Grade</span> :</label>
                <input type="text" name="Job_Grade" id="Job_Grade_ub" class="md-input form-control form-control-sm m-input m-input--square" readonly>
            </div>
            <div class="form-group">
                <label><span class="translate" data-args="Budget Source">Budget Source</span> :</label>
                <select id="budget_source_ub" name="budget_souce" class="md-input form-control form-control-sm m-input m-input--square" required>
                    <option value="CORPORATE">CORPORATE</option>
                    <option value="PROJECT">PROJECT</option>
                    <option value="IRIS">IRIS</option>
                    <option value="SCORE">SCORE</option>
                    <option value="OPTIMA">OPTIMA</option>
                    <option value="INTERFACE">INTERFACE</option>
                    <option value="PATHFINDERS">PATHFINDERS</option>
                </select>
            </div>

        </div>
        <div class="col-lg-4">
            <div class="form-group">
                <label><span class="translate" data-args="Time to Fullfill">Time to Fullfill</span> :</label>
                <select id="time_to_fullfill_ub" name="time_to_fullfill" class="md-input form-control form-control-sm m-input m-input--square" required>
                    <option value="Q1">Q1 (January,February, Maret)</option>
                    <option value="Q2">Q2 (April, Mei, June)</option>
                    <option value="Q3">Q3 (July,Agt, Sep)</option>
                    <option value="Q4">Q4 (Oct,Nov, Dec)</option>
                </select>
            </div>
            <div class="form-group">
                <label><span class="translate" data-args="Project Name">Project Name</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="project_name" id="project_name_ub" maxlength="255" type="text">
            </div>

        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="form-group">
                @*<label><span class="translate" data-args="Project Name">Employment Status</span> :</label>*@
                <label><span class="translate"></span> Status Agreement</label>
                <select class="form-control form-control-sm m-input m-input--square" name="employment_status" id="employment_status_ub" required>
                    <option value="PERMANENT">PERMANENT</option>
                    <option value="CONTRACT">CONTRACT</option>

                </select>
            </div>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-6">
            <div class="form-group">
                <label><span class="translate" data-args="Date Fullfillment">Date Fullfillment</span> :</label>
                <div class="input-group date" data-provide="datepicker" data-date-format="yyyy-mm-dd">
                    <input type="text" class="form-control" id="dff_ub" name="dff" required>
                    <span class="input-group-btn">
                        <button class="btn default" type="button">
                            <i class="fa fa-calendar"></i>
                        </button>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <div class="form-group">
                <label><span class="translate" data-args="Detail Spesification">Detail Spesification</span> :</label>
                <textarea class="form-control form-control-sm m-input m-input--square" name="detail_spesification" id="detail_spesification_ub" required></textarea>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="form-group">
                <label><span class="translate" data-args="Detail Requirement">Detail Requirement</span> :</label>
                <textarea class="form-control form-control-sm m-input m-input--square" name="detail_requirement" id="detail_requirement_ub" required></textarea>
            </div>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="button" id="btn-save" class="btn btn-primary" onclick="SaveDetilUnBudget()">Save</button>
            <button type="button" data-dismiss="modal" class="btn btn-secondary">Close</button>
        </div>

    </div>
</form>
<style>
    .required:after {
        content: " *";
        color: red;
    }
</style>