@{
    ViewBag.ModalTitle = "InstitutionCompetence";
    ViewBag.ModalId = "InstitutionCompetenceModalSearch";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}
<form id="InstitutionCompetenceFormSearch" method="post">
 
    <div class="row">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="competence_id">competence_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_competence_id" id="search_competence_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="institution_id">institution_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_institution_id" id="search_institution_id"  maxlength="50" type="text">
            </div>
                    
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="button" onclick="fnInstitutionCompetence.initsearch()" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> <span class="translate" data-args="app-search">search</span></button>
            <button type="button" onclick="fnInstitutionCompetence.initsearch('reset')" class="btn btn-success btn-sm"><i class="fa fa-backspace"></i> <span class="translate" data-args="app-reset">reset</span></button>
            <button type="button" data-dismiss="modal" class="btn btn-warning btn-sm"><i class="fa fa-times-circle"></i>  Close</button>
        </div>

    </div>
</form>