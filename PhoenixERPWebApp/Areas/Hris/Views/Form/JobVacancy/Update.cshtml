@{
    ViewData["Title"] = "JobVacancy Update";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
    <span class="translate" data-args="update">Update</span>
}

@section Paneltools{

}
@section Panelbody{
    <form id="JobVacancyFormUpdate" method="post">
        <input value="@ViewBag.RecordID" type="hidden" name="id" id="id" />
        <fieldset>
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="first_name">Posting Code <span style="color:red">*</span></label>
                        <input type="text" class="form-control" id="code" name="code" readonly />
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <label for="first_name">Req Code <span style="color:red">*</span></label>
                        <input type="hidden" class="form-control" id="hiring_request_id" name="hiring_request_id" />
                        <input type="text" class="form-control" id="hiring_request_code" name="hiring_request_code" readonly />
                    </div>
                </div>
                <div class="col-sm-4">
                    &nbsp;
                </div>
            </div>
            <div class="row">
                <div class="col-sm-3">
                    <div class="form-group">
                        <label for="first_name">Vacancy Name <span style="color:red">*</span></label>
                        <input type="text" class="form-control" id="vacancy_name" name="vacancy_name" readonly />
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label for="first_name">Location <span style="color:red">*</span></label>
                        <select id="master_location_id" name="master_location_id" class="form-control form-control-sm m-input m-input--square" required></select>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label for="first_name">Posting Status <span style="color:red">*</span></label>
                        <input type="text" class="form-control" id="posting_status" name="posting_status" readonly />
                        @*<select type="text" class="form-control" id="posting_status" name="posting_status" required>
            <option value="0">DRAFT</option>
            <option value="3">Post/Unpublished</option>
            <option value="4">Post/Published</option>
            <option value="5">Closed</option>
        </select>*@

                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <label for="first_name">Closing Date <span style="color:red">*</span></label>
                        <div class="input-group date" data-provide="datepicker" data-date-format="yyyy-mm-dd">
                            <input type="text" class="form-control" id="closing_date" name="closing_date" required>
                            <span class="input-group-btn">
                                <button class="btn default" type="button">
                                    <i class="fa fa-calendar"></i>
                                </button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <hr />

        <div class="row" id="budgeted_div" style="display:block">
            <div class="col-lg-12 m-form__group-sub">
                <div class="form-group">
                    <label>
                        <h5>Man Power Request</h5>
                    </label>
                    <div class="m-section__content">
                        <div class="m-demo" data-code-preview="true" data-code-html="true"
                             data-code-js="false">
                            <div class="m-demo__preview" id="employee_hiring">
                                <div class="row">
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="first_name">Requestor <span style="color:red">*</span></label>
                                            <input type="hidden" class="form-control" id="requester_id" name="requester_id" />
                                            <input type="text" class="form-control" id="requester_name" name="requester_name" required />
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="first_name">Title <span style="color:red">*</span></label>
                                            <input type="hidden" class="form-control" id="job_title_id" name="job_title_id" />
                                            <input type="text" class="form-control" id="job_title_name" name="job_title_name" required/>
                                        </div>
                                    </div>
                                    <div class="col-sm-3">
                                        <div class="form-group">
                                            <label for="first_name">Division <span style="color:red">*</span></label>
                                            <input type="hidden" class="form-control" id="business_unit_id" name="business_unit_id" />
                                            <input type="text" class="form-control" id="business_unit_name" name="business_unit_name" required/>
                                        </div>
                                    </div>
                                    <div class="col-sm-3" style="display:none;">
                                        <div class="form-group">
                                            <label for="first_name">Departement <span style="color:red">*</span></label>
                                            <input type="text" class="form-control" id="departement" name="departement" />
                                        </div>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-sm-12">
                                        <!-- begin: Datatable -->
                                        <table class="table table-striped- table-bordered table-hover table-checkable"
                                               id="dt_basic">
                                            <thead>
                                                <tr>

                                                    <th>Job Title</th>
                                                    <th>Grade</th>
                                                    <th>TTF</th>
                                                    <th>Employment Status</th>
                                                    <th>Budget Source</th>
                                                    <th>MPP Budget</th>
                                                    <th>Date Joining</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                        <!-- end:: Datatable -->
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <br />
        <br />
        <hr />
        <div class="row">
            <input type="hidden" id="template_approval_id" name="template_approval_id">
            <div class="col-lg-12 m-form__group-sub">
                <div class="form-group">
                    <label>
                        <h5>Approval</h5>
                    </label>
                    <div class="m-section__content">
                        <table class="table table-striped table-bordered table-hover table-checkable" id="VacancyApprover">
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Title</th>
                                    <th>Approver Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr id="no_data">
                                    <td colspan="3">No Data</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <hr />
        <div class="row">
            <div class="col-lg-12">
                <center>
                    <button type="button" id="btn-save" class="btn btn-primary" onclick="UpdateData()">Save</button>
                    <a href="~/Hris/JobVacancy" class="fakelink btn btn-secondary">Close</a>
                </center>
            </div>

        </div>
    </form>
}
@section Panelscript{
    <script src="~/approval/gmApproval.js"></script>
    <script src="~/assets/js/Areas/Hris/Form/JobVacancy.update.js"></script>
}
