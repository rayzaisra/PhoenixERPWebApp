@{
    ViewData["Title"] = "MppApprovedStatus";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
<span class="translate" data-args="create">Create</span>
}

@section Paneltools{

}
@section Panelbody{
<form id="MppApprovedStatusFormCreate" method="post">
    <div class="row ">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="created_date">created_date</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="created_date" id="created_date"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="id_mpp">id_mpp</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="id_mpp" id="id_mpp"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="reason">reason</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="reason" id="reason"  maxlength="2147483647" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="updated_date">updated_date</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="updated_date" id="updated_date"   type="number">
            </div>
            
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="submit" id="btn-save" class="btn btn-primary">Save</button>
            <a href="~/Hris/MppApprovedStatus" class="fakelink btn btn-secondary">Close</a>
        </div>

    </div>
</form>
}
@section Panelscript{
    <script src="~/assets/js/Areas/Hris/Form/MppApprovedStatus.create.js"></script>
}
