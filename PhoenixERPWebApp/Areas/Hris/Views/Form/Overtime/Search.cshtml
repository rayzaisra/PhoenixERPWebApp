@{
    ViewBag.ModalTitle = "Overtime";
    ViewBag.ModalId = "OvertimeModalSearch";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}
<form id="OvertimeFormSearch" method="post">
 
    <div class="row">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="amount">amount</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_amount" id="search_amount"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="approval">approval</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_approval" id="search_approval"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="approval_by">approval_by</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_approval_by" id="search_approval_by"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="approval_date">approval_date</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_approval_date" id="search_approval_date"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="employee_basic_info_id">employee_basic_info_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_employee_basic_info_id" id="search_employee_basic_info_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="hour_overtime">hour_overtime</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_hour_overtime" id="search_hour_overtime"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="last_update">last_update</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_last_update" id="search_last_update"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="overtime_date">overtime_date</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_overtime_date" id="search_overtime_date"   type="number">
            </div>
                    
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="button" onclick="fnOvertime.initsearch()" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> <span class="translate" data-args="app-search">search</span></button>
            <button type="button" onclick="fnOvertime.initsearch('reset')" class="btn btn-success btn-sm"><i class="fa fa-backspace"></i> <span class="translate" data-args="app-reset">reset</span></button>
            <button type="button" data-dismiss="modal" class="btn btn-warning btn-sm"><i class="fa fa-times-circle"></i>  Close</button>
        </div>

    </div>
</form>