@{
    ViewBag.ModalTitle = "SalaryProcessComponent";
    ViewBag.ModalId = "SalaryProcessComponentModalSearch";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}
<form id="SalaryProcessComponentFormSearch" method="post">
 
    <div class="row">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="component_name">component_name</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_component_name" id="search_component_name"  maxlength="100" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="employee_basic_info_id">employee_basic_info_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_employee_basic_info_id" id="search_employee_basic_info_id"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="month">month</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_month" id="search_month"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="tax_id">tax_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_tax_id" id="search_tax_id"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="type">type</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_type" id="search_type"  maxlength="100" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="value">value</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_value" id="search_value"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="value_year">value_year</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_value_year" id="search_value_year"   type="number">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="year">year</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_year" id="search_year"   type="number">
            </div>
                    
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="button" onclick="fnSalaryProcessComponent.initsearch()" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> <span class="translate" data-args="app-search">search</span></button>
            <button type="button" onclick="fnSalaryProcessComponent.initsearch('reset')" class="btn btn-success btn-sm"><i class="fa fa-backspace"></i> <span class="translate" data-args="app-reset">reset</span></button>
            <button type="button" data-dismiss="modal" class="btn btn-warning btn-sm"><i class="fa fa-times-circle"></i>  Close</button>
        </div>

    </div>
</form>