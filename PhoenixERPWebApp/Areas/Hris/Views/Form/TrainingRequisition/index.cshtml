@{
    ViewData["Title"] = "TrainingRequisition";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
    <a href="@Url.Content("~/Hris/TrainingRequisition/create")" class="fakelink m-btn btn btn-primary btn-sm m-btn--sm"><i class="la la-plus"></i></a>
}

@section Paneltools{
    <a data-target="#TrainingRequisitionModalSearch" data-toggle="modal" class="btn btn-circle btn-outline btn-sm"><i class="la la-search"></i> <span class="translate" data-args="app-search">Search</span></a>
}
@section Panelbody{
    <style>
        .m-margin__top-20 {
            margin-top: 20px !important;
        }

        .redtext {
            color: red !important;
        }

        .bluetext {
            color: blue !important;
        }

        .greentext {
            color: greenyellow !important;
        }
    </style>
    <table class="table table-striped table-bordered table-hover table-checkable" id="TrainingRequisitionList"></table>
    @Html.Partial("TrainingRequisition/Search")
}
@section Panelscript{
    <script src="~/assets/js/Areas/Hris/Form/TrainingRequisition.js"></script>
}
