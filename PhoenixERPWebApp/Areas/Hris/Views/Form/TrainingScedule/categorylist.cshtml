@{
    ViewBag.ModalTitle = "LIST";
    ViewBag.ModalId = "categorylist";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}


<div>
    <form action="#"  method="post" id="TimesheetTaskCreate">
        <div class="form-group">
            <label><span class="translate" data-args="Job"></span> :</label>
            <select id="job_number" name="job_number" class="form-control">
                <option></option>
            </select>
        </div>

        <div class="form-group">
            <label>Task</label>
            <select id="taskList" name="task_id" class="form-control">
                <option></option>
            </select>
        </div>

        <div class="form-group">
            <label>Task NonJob</label>
            <input type="text" name="non_job" class="form-control" />
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea class="form-control form-control-sm m-input m-input--square" required name="description" id="description"></textarea>
        </div>
    </form>
</div>

<div id="tmpl_acc_item" class="xtemplate">
</div>

