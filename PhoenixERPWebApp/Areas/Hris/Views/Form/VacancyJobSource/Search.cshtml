@{
    ViewBag.ModalTitle = "VacancyJobSource";
    ViewBag.ModalId = "VacancyJobSourceModalSearch";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}
<form id="VacancyJobSourceFormSearch" method="post">
 
    <div class="row">
        <div class="col-lg-12">

            <div class="form-group">
                <label><span class="translate" data-args="file_id">file_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_file_id" id="search_file_id"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="links">links</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_links" id="search_links"  maxlength="255" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="source_vacancy">source_vacancy</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="search_source_vacancy" id="search_source_vacancy"  maxlength="255" type="text">
            </div>
                    
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="button" onclick="fnVacancyJobSource.initsearch()" class="btn btn-primary btn-sm"><i class="fa fa-search"></i> <span class="translate" data-args="app-search">search</span></button>
            <button type="button" onclick="fnVacancyJobSource.initsearch('reset')" class="btn btn-success btn-sm"><i class="fa fa-backspace"></i> <span class="translate" data-args="app-reset">reset</span></button>
            <button type="button" data-dismiss="modal" class="btn btn-warning btn-sm"><i class="fa fa-times-circle"></i>  Close</button>
        </div>

    </div>
</form>