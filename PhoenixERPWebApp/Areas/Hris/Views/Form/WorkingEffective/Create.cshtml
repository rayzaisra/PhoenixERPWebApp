@{
    ViewData["Title"] = "WorkingEffective";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
<span class="translate" data-args="create">Create</span>
}

@section Paneltools{

}
@section Panelbody{
<form id="WorkingEffectiveFormCreate" method="post">
    <div class="row ">
        <div class="col-lg-12">

            
            <div class="form-group">
                <label><span class="translate" data-args="Working Start Time">Working Start Time</span> <span class="req">*</span>:</label>
                <input class="form-control form-control-sm m-input m-input--square" name="from_time" id="from_time" required maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="Working End Time">Working End Time</span> <span class="req">*</span>:</label>
                <input class="form-control form-control-sm m-input m-input--square" name="to_time" id="to_time" required maxlength="50" type="text">
            </div>
            
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="submit" id="btn-save" class="btn btn-primary">Save</button>
            <a href="~/Hris/WorkingEffective" class="fakelink btn btn-secondary">Close</a>
        </div>

    </div>
</form>
}
@section Panelscript{
    <script src="~/assets/js/Areas/Hris/Form/WorkingEffective.create.js"></script>
}
