                                                <button type="button" id="btn-checkout" class="btn btn-danger m-btn m-btn--icon" style="width:100px;height:50px" disabled><i class="fa fa-bell"></i> Clock Out</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <p id="demo" style="display:none"></p>
</div>
