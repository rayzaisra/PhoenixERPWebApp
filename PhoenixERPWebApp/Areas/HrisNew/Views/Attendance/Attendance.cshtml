@model PhoenixERPWebApp.Models.Attendance
@{
	ViewData["Title"] = "Attendance";
	Layout = "~/Views/Shared/_LayoutKendo.cshtml";
	var clockIn = Model.TimeAttendance==null? "-" : ((TimeSpan)Model.TimeAttendance).ToString(@"hh\:mm\:ss");
	var clockOut = Model.TimeAttendanceOut==null? "-" : ((TimeSpan)Model.TimeAttendanceOut).ToString(@"hh\:mm\:ss");
	var attDate = Model.DateAttendance == null ? "" : Model.DateAttendance.Value.ToString("dd MMM yyyy");
	var attDateOut = Model.DateAttendanceOut == null ? "" : Model.DateAttendanceOut.Value.ToString("dd MMM yyyy");
}
<style>
    #mapid {
        height: 450px;
        width: 100%;
        z-index: 2;
    }

    .time-frame {
        background-color: transparent;
        color: black;
        font-family: Arial, Helvetica, sans-serif;
        font-weight: bold;
    }

    #date-part {
        font-size: 1.2em;
    }

    #time-part {
        font-size: 2em;
    }
</style>
<link rel="stylesheet" href="~/assets/plugins/leaflet/leaflet.css">
<link rel="stylesheet" href="~/assets/plugins/leaflet/MarkerCluster.Default.css">
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">HRIS</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="attendance" asp-controller="attendance" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Attendance</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
