                                            <div id='date-part'></div>
                                            <div id='time-part'></div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div align="center">
                                            <label style="font-size:1em">Clock Out</label>
                                            <h5 class="m--font-info">@attDateOut</h5>
                                            <h3 class="m--font-info">@clockOut</h3>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12 m-form__group-sub">
                                        <div class="form-group">
                                            <div id="mapid"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        @Html.TextAreaFor(x => x.LocationName, new { @style = "height:120px;width:100%;", @readonly = "readonly" })
                                    </div>

                                </div>
                                <div class="row">
                                    <div class="col-lg-12 m-form__group-sub">
                                        <div class="form-group">
                                            @if (@ViewBag.IsChecIn == false)
                                            {
                                                <button type="button" id="btn-checkin" class="btn btn-success m-btn m-btn--icon" style="width:100px;height:50px"><i class="fa fa-clock"></i> Clock In</button>
                                            }
