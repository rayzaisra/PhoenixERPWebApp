                                            {
                                                <button type="button" id="btn-checkin" class="btn btn-success m-btn m-btn--icon" style="width:100px;height:50px" disabled><i class="fa fa-clock"></i> Clock In</button>
                                            }
                                            @if (@ViewBag.IsChecOut == false)
                                            {
                                                <button type="button" id="btn-checkout" class="btn btn-danger m-btn m-btn--icon" style="width:100px;height:50px"><i class="fa fa-bell"></i> Clock Out</button>
                                            }
