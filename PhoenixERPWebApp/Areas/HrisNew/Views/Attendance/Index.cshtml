<script>
	function grid_params() {
		var dtStart = $("#FilterMonth").data("kendoDatePicker").value();
		var dtEnd = $("#FilterYear").data("kendoDatePicker").value();
		var isNotClockOut = $("#isNotClockOut").is(":checked");
		var valClockOutFlag = (isNotClockOut == true) ? 1 : 0;
        return {
        	dtStart: kendo.toString(dtStart, "yyyyMMdd"),
        	dtEnd: kendo.toString(dtEnd, "yyyyMMdd"),
        	isNotClockOut: valClockOutFlag
        };
	}

	$('#btnSearch').click(function () {
		mApp.block("#m_blockui_list", {
			overlayColor: "#000000",
			type: "loader",
			state: "primary",
			message: "Processing..."
		});

		$('#grid').data('kendoGrid').dataSource.read();

		mApp.unblock("#m_blockui_list");
	});
</script>