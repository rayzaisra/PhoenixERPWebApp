@{
    ViewData["Title"] = "Attendance Report";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">HRIS</span>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Report</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="report" asp-controller="attendance" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Attendance Report</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div>
                                <h3 class="m-portlet__head-text m--font-success">Attendance Report</h3>
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <b><label>Month</label> </b>:
                                @(Html.Kendo().DatePicker().Name("FilterMonth").Start(CalendarView.Year).Depth(CalendarView.Year).Format("MMM").Value(DateTime.Today)
									.HtmlAttributes(new
									{
										style = "width:100%",
										@class = "form-control form-control-sm m-input",
									}))
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <b><label>Year</label> </b>:
                                @(Html.Kendo().DatePicker().Name("FilterYear").Start(CalendarView.Decade).Depth(CalendarView.Decade).Format("yyyy").Value(DateTime.Today)
									.HtmlAttributes(new
									{
										style = "width:100%",
										@class = "form-control form-control-sm m-input",
									}))
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <b><label>Legal Entity</label> </b>:
                                @(Html.Kendo().DropDownList().Name("legalEntityId")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .Filter(FilterType.Contains)
                                    .DataSource(source =>
                                    {
                                        source.Read(read =>
                                        {
                                            read.Action("GetLegalEntity", "Dropdown", new { area = "Finance" });
                                        });
                                    })
                                    .OptionLabel($"Choose a Legal Entity")
                                    .HtmlAttributes(new { style = "width:100%;" })
                                )
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <button type="button" id="btnSearch" class="btn btn-sm btn-success" style="width:80px">Filter</button>
                            </div>
                        </div>
                    </div>
                    <div class="row" id="divGrid" style="display:none">
                        <div class="col-md-12">
                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Attendance>()
                                .Name("grid")
                                .AutoBind(false)
                                .Columns(columns =>
                                 {
                                     columns.Bound("").Title("#").Width(50).Filterable(false).HtmlAttributes(new { style = "text-align:center;", @class = "row-number" }).HeaderHtmlAttributes(new { style = "text-align:center;" });
                                     columns.Bound(p => p.requestEmployee.EmployeeId).ClientTemplateId("btnAction-template").Width(200);
                                     columns.Bound(p => p.requestEmployee.EmployeeName).Width(200);
                                     columns.Bound(p => p.requestEmployee.LegalEntityName).Width(200);
                                     columns.Bound(p => p.MonthName).Width(150);
                                     columns.Bound(p => p.Year).HtmlAttributes(new { style = "text-align:right;"}).Width(100);
                                     columns.Bound(p => p.requestEmployee.JobTitle).Width(200);
                                     columns.Bound(p => p.requestEmployee.Grade).Width(200);
                                     columns.Bound(p => p.TotalRecord).Title("Total Data").HtmlAttributes(new { style = "text-align:right;" }).Width(200);
                                     columns.Bound(p => p.TotalHour).Title("Total Hour").HtmlAttributes(new { style = "text-align:right;" }).Width(200);
                                 })
                                .NoRecords()
                                .Pageable(pageable => pageable
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
                                .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                                    .Extra(false)
                                    .Operators(operators => operators
                                    .ForString(str => str.Clear()
                                        .Contains("Contains")
                                        .StartsWith("Start sWith")
                                        .EndsWith("End sWith")
                                    )))
                                .Scrollable(s => s.Enabled(true).Height("auto"))
                                .ToolBar(tools => tools.Excel())
                         .Excel(excel => excel
                                    .FileName("Attendance Report.xlsx")
                                    .Filterable(true)
                                    .AllPages(true)
                                    .ProxyURL(Url.Action("Excel_Export_Save", "Attendance"))
                                )
                                .Resizable(rsz => rsz.Columns(true))
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .PageSize(10)
                                    .Events(events => events.Error("errorHandler"))
                                    .Model(model => { model.Id(p => p.Id); })
                                    .Read(read => read.Action("ReadReport", "Attendance").Data("grid_params"))
                                )
                                .Events(e => e.DataBound("dataBoundEvent"))
							)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script id="btnAction-template" type="text/x-kendo-template">
    <a href='javascript: void(0);' onclick='viewGridRow(this)' title='Edit' class='read'><span style='color:blue; text-decoration:underline;'>#=requestEmployee.EmployeeId#</span></a>
</script>

<script>
    function viewGridRow(e) {
        var item = dataItem(e);
        window.location.href = '@Url.Action("View", "Attendance")?employeeId=' + item.requestEmployee.EmployeeId + '&month=' + item.Month + '&year=' + item.Year;
    }

	function grid_params() {
		var flMonth = $("#FilterMonth").data("kendoDatePicker").value();
        var flYear = $("#FilterYear").data("kendoDatePicker").value();
        var legalEntityId = $('#legalEntityId').data("kendoDropDownList").value();
		return {
			month: kendo.toString(flMonth, "yyyyMMdd"),
            year: kendo.toString(flYear, "yyyyMMdd"),
            legalEntityId: legalEntityId
		};
	}

	$('#btnSearch').click(function () {
		mApp.block("#m_blockui_list", {
			overlayColor: "#000000",
			type: "loader",
			state: "primary",
			message: "Processing..."
		});
        $('#divGrid').show();
		$('#grid').data('kendoGrid').dataSource.read();

		mApp.unblock("#m_blockui_list");
	});
</script>