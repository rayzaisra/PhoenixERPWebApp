<style>
    .k-grid-footer tr.k-footer-template td {
        border-style: solid;
        border-width: 1px 0 0 0;
        text-align: right;
    }
</style>
<script>

    var param = (function (param) {
        param.saveUrl = "@Url.Action("Save", "DeclarationPayroll")";
        param.approveUrl = "@Url.Action("Approve", "DeclarationPayroll")";
        param.completeUrl = "@Url.Action("Complete", "DeclarationPayroll")";
        param.rejectUrl = "@Url.Action("Reject", "DeclarationPayroll")";
        param.submitUrl = "@Url.Action("Submit", "DeclarationPayroll")";
        return param;
    })(param || {});

    var pageFunction = (function (pageFunction) {
        pageFunction.init = function () {
            //initialize
        };
        pageFunction.save = function () {
            //alert("On Progress..")
            var validator = $("#formDeclarationPayroll").kendoValidator().data("kendoValidator");

            if (validator.validate()) {
                var gridDetails = $("#grid-DeclarationPayrollDetail").data("kendoGrid");
                gridDetails.saveRow();
                var dataList = {
                    details: gridDetails.dataSource.data()
                };
                callAction({ formId: "formDeclarationPayroll", title: "save", type: "POST", url: param.saveUrl, objects: dataList });
            } else {
                swal('Information', 'Please complete your form !', 'info');
            }
            //callAction({ formId: "formGoodRequests", title: "Save", type: "POST", url: param.saveUrl });
        };
    });

    $(document).ready(function () {
        if ('@ViewBag.isReadonly' === 'True') {
            $('#btn-load').hide();
            $('#DivListEmployee').show();
        } else {
            $('#btn-load').show();
            $('#DivListEmployee').hide();
        }
        $("#btn-save").click(function () {
            var validator = $("#formDeclarationPayroll").kendoValidator().data("kendoValidator");

            if (validator.validate()) {
                var gridDetails = $("#grid-DeclarationPayrollDetail").data("kendoGrid");
                gridDetails.saveRow();
                var dataList = {
                    Details: gridDetails.dataSource.data()
                };
                callAction({ formId: "formDeclarationPayroll", title: "save", type: "POST", url: param.saveUrl, objects: dataList });
            } else {
                swal('Information', 'Please complete your form !', 'info');
            }
        });
        //$('#btn-save').click(pageFunction.save);

        if ('@Model.Id' !== "") {
            $('#DivListEmployee').show();
        } else {
            $('#DivListEmployee').hide();
        }
    });

    $('#btn-load').click(function () {
        var componentId = $("#SubComponentId").data("kendoDropDownList").value();
        if (componentId !== "") {
            $('#DivListEmployee').show();
            ProcessData();
        } else {
            return swal(
                'Information',
                'There is no selected component. Please select the component name first',
                'info'
            );
        }

    })

    function FilterDeclarationType() {
        return {
            DeclarationTypeId: $("#DeclarationType").val()
        };
    }

    function grid_params() {
        var month = $("#Month").data("kendoDropDownList").value();
        var year = $("#Year").data("kendoDropDownList").value();
        var component = $("#SubComponentId").data("kendoDropDownList").value();
        return {
            month: month,
            year: year,
            componentId:component
        }
    }

    function ProcessData() {
        var grid = $("#grid-DeclarationPayrollDetail").data("kendoGrid");
        grid.dataSource.read();
        grid.refresh();
    }

    function saveDeclarationDetail(e) {
        var amount = $("#Amount").data("kendoNumericTextBox").value();
        var EmployeeName = $("#EmployeeBasicInfoId").data("kendoDropDownList").text();
        var LegalEntity = $("#LegalEntityName").val();
        e.model.set("Amount", amount);
        e.model.set("EmployeeName", EmployeeName);
        e.model.set("LegalEntityName", LegalEntity);
    }

    function calculateAmount() {
        var data = $("#grid-DeclarationPayrollDetail").data("kendoGrid").dataSource.data();
        var total = 0;
        for (var i = 0; i < data.length; i++) {
            total += parseFloat(data[i].Amount);
        }
        return total;
    }

    function onEdit(e) {

        e.container.find("input[name='LegalEntityName']").each(function () {
            $(this).attr("disabled", "disabled")
            $(this).removeAttr("required")
        });

    }
    function Emp_Select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            $.ajax({
                type: "GET",
                url: '@Url.Action("GetInfoEmployee", "DeclarationPayroll")',
                data: { Id: dataItem.Value },
                success: function (result) {

                    if (result != undefined) {
                        $("#LegalEntityName").val(result.LegalEntityName);
                        //$("#Id").val(result.Id);
                        //$("#Id").prop("readonly", "readonly");
                    }
                }
            });
        }
    }
</script>