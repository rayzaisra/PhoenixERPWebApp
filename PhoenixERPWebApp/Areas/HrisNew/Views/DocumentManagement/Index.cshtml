@{
    ViewData["Title"] = "Document Management";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<style>
    .div-doc {
        background-color: #EEEEEE;
        padding: 10px;
        height: 100px;
        margin: 1%;
        cursor: pointer;
        border: 1px solid #B7B7B7;
    }

        .div-doc:hover {
            background-color: #D4E0D8;
        }

        .div-doc:active {
            background-color: #A0C3AB;
        }
</style>

