<script>
    $(document).ready(function () {
        if ('@Model.IsReadOnly' === "1") {
            $('form :input').prop('disabled', true);
            var dropDownDOMelements = $(".k-dropdown");
            var dropDowns = [];

            dropDownDOMelements.each(function (ddl) {
                var currentAriaOwnsAttribute = $(this)[0].attributes[7].nodeValue;
                var currentDropDownListName = currentAriaOwnsAttribute.substring(0, currentAriaOwnsAttribute.length - 8);

                var currentDropDownList = $('#' + currentDropDownListName).data("kendoDropDownList").enable(false);

            })
            $('.fakelink').hide();
            $('#btn-save').hide();
            $('.k-button').hide();
        }
       

		var photoFileName = '@Model.PhotoFileName';
        if (photoFileName == '') {
            SetPhotoUpload();
		} else {
            getImageEmployeeProfile();
            $("#linkPhotoDownloadFile").text(photoFileName);
        }

		if ( $('#BusinessUnitJobLevelId').data("kendoDropDownList").value() !== "") {
            $('#BusinessUnitJobLevelId').data("kendoDropDownList").trigger("change");
        }

	});

    var loadFile = function (event) {
        var output = document.getElementById('img-employee-nava');
        output.src = URL.createObjectURL(event.target.files[0]);
        output.onload = function () {
            URL.revokeObjectURL(output.src) // free memory
        }
    };



	 let getImageEmployeeProfile = function () {

        let urlApi = $.helper.resolveApi("~odrive/GetImageEmployeeProfile");
        var id = '@Model.PhotoFileName';

       mApp.blockPage({
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        }),
        $.ajax({
        type: "GET",
        dataType: 'json',
        url: urlApi,
        data: {id: id},
        success: function (data) {
            console.log(data);
            if (data.webUrl !== null) {
                $("#img-employee-nava").attr("src",data.webUrl);
            }
        },
        error: function (e, t, s) {
                //swal(
                //    'Information',
                //    'Ooops, something went wrong !',
                //    'info'
                //);
            console.log(e);
            }
        }).then(setTimeout(function () {
            mApp.unblockPage();
        }, 2e3));
    };

	function grid_params() {
		var empid = $("#Id").val();
		return {
			employeeId: empid
		}
	}
    function filterDivision() {
