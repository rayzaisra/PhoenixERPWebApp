	}

    function employeeChecklistSaveEvent(e) {
        var checklistName = "";
        var categValue = $("#EchkEmployeeChecklistCategoryArrayId").data("kendoMultiSelect").value();
        console.log(categValue);
        $("#EchkEmployeeChecklistCategoryArrayId option:selected").each(function () {
            var $this = $(this);
            if ($this.length) {
                var selText = $this.text();
                checklistName += selText + ";";
            }
        });
        console.log(checklistName);
        //var EchkEmployeeChecklistCategory = checklistName
        e.model.set("EchkEmployeeChecklistCategoryId", categValue);
        e.model.set("EchkEmployeeChecklistCategory", checklistName);
		e.model.set("EchkBusinessUnitPicId", "");
	}

	function getGrid() {
		return {
			Families: $("#gridFamily").data("kendoGrid").dataSource.data(),
			EmployeeEmergencyContacts: $("#gridEmergencyContact").data("kendoGrid").dataSource.data(),
			Educations: $("#gridEducation").data("kendoGrid").dataSource.data(),
			EmployeeExperiences: $("#gridEmployeeExperience").data("kendoGrid").dataSource.data(),
