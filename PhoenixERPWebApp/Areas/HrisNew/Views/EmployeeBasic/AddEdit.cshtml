    	//get detail from bussiness uni job level
    	var bujoblvlid = e.sender.value();
    	mApp.block("#m_blockui_list", {
    		overlayColor: "#000000",
    		type: "loader",
    		state: "primary",
    		message: "Processing..."
    	});
     
    	$.ajax({
    		type: "GET",
    		url: '@Url.Action("GetJobLevelJobTitleDetail", "employeebasic")',
    		data: { id : bujoblvlid },
    		success: function (result) {
                if (result != undefined) {
                    console.log(result);
    				$("#JobTitleId").val(result.JobTitleId);
    				$("#BusinessUnitSubgroupId").val(result.BusinessUnitSubgroupId);
    				$("#ReportsTo").data("kendoDropDownList").value(result.ParentId);
                    $("#JobGradeId").data("kendoDropDownList").value(result.JobGradeId);

                    $("#BusinessUnitDepartementId").data("kendoDropDownList").value(result.BusinessUnitDepartementId);

    				$("#BusinessUnitId").data("kendoDropDownList").dataSource.read();
                    $("#BusinessUnitId").data("kendoDropDownList").value(result.BusinessUnitDivisionId);

    				//$("#BusinessUnitDepartementId").data("kendoDropDownList").dataSource.read();
    				//$("#BusinessUnitDepartementId").data("kendoDropDownList").value(result.BusinessUnitDepartementId);
    				//$("#InterestMonth").data("kendoNumericTextBox").value(result.InterestMonth);

    			}
    			mApp.unblock("#m_blockui_list");
    		},
    		error: function (e, t, s) {
    			console.log(e)
    			mApp.unblock("#m_blockui_list");
    		}
    	}).then(setTimeout(function () {
    		mApp.unblock("#m_blockui_list");
    	}, 2e3));
    }

	function saveFamilyEvent(e) {
		var fFamilyStatus = $("#FamilyStatusId").data("kendoDropDownList").text();
		var fReligionId = $("#fReligion").data("kendoDropDownList").value();
        var fReligion = $("#fReligion").data("kendoDropDownList").value();
		//$('#InventoryDetail_Status').data("kendoDropDownList").value(item.Status);

		e.model.set("fFamilyStatus", fFamilyStatus);
		e.model.set("fReligionId", fReligionId);
        e.model.set("fReligion", fReligion);

	}

