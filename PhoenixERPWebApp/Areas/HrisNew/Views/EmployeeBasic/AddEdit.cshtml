            EmployeeChecklists: $("#gridEmployeeChecklist").data("kendoGrid").dataSource.data()
            //EmployeeHistorys: $("#gridEmployeeHistory").data("kendoGrid").dataSource.data()
		}
	}

	function removePhoto() {
		SetPhotoUpload();
	}

	function downloadPhoto() {
		downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download" })', data: { id: $("#Photo").val() } });
	}

    function downloadFile(e) {
        var item = dataItem(e);
        downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download" })', data: { id: item.FileId }});
    }

	function SetPhotoUpload() {
		$("#linkPhotoDownloadFile").empty();
		$("#linkPhotoRemoveFile").empty();
        $("#divPhoto").empty().append("<input name='filePhoto' id='filePhoto' type='file' onchange='loadFile(event)' />");

		$("#filePhoto").kendoUpload({
			multiple: false,
			validation: {
				maxFileSize: 5000000,
				allowedExtensions: [".jpg", ".png", ".gif", ".doc", ".pdf", ".docx", ".xlsx"]
            },
            remove: onRemove
		});
    }

    function onRemove(e) {
        $('#img-employee-nava').attr('src', '');
        // An array with information about the removed files
        var files = e.files;
    }

	$('#btn-save').click(function () {
		var isvalid = $("#formEmployeeBasic").validate().form();
		if (!isvalid) {
			$("#valmsg").css("visibility", "visible");
		} else {
			$("#valmsg").css("visibility", "hidden");
			callActionFile(
			{
				formId: "formEmployeeBasic",
				title: "save", type: "POST",
				url: '@Url.Action("Save", "employeebasic")',
				objects: getGrid()
			});
		}


	});


	function EmployementStatusOnChange(e) {
		var empSts = e.sender.text();
		var empStatusval = e.sender.value();
		var datepicker = $("#EmployementStatusEndDate").data("kendoDatePicker");

		if (empSts.toLowerCase().includes("contract") || empSts.toLowerCase().includes("kontrak") || empSts.toLowerCase().includes("probation")) {
			$("#spanEmpSstEndDate").text("*");
			datepicker.readonly(false);
			//$("#EmployementStatusId)").data("kendoDropDownList").val();
		} else {
			$("#spanEmpSstEndDate").text("");
			datepicker.readonly(true);
		}
    }

    function Detail(e) {
        var item = dataItem(e);
        if (item.Category === "Promotion") {
            window.open('/hrisnew/Promotion/AddEdit?Id='+item.Id, '_blank');
        } else if (item.Category === "Demotion") {
            window.open('/hrisnew/demotion/AddEdit?Id=' + item.Id, '_blank');
        } else if (item.Category === "Sanction") {
            window.open('/hrisnew/sanction/AddEdit?Id=' + item.Id, '_blank');
        } else if (item.Category === "Retired") {
            window.open('/hrisnew/Retired/AddEdit?Id=' + item.Id, '_blank');
        } else if (item.Category === "PDR") {
            window.open('/hrisnew/pdrperformance/AddEdit?Id=' + item.Id, '_blank');
        } else if (item.Category === "KPI") {
            window.open('/hrisnew/PDRApprailsal/AddEdit?Id=' + item.Id, '_blank');
        }
       
    }

    function Link(data) {
        return "<center><a href='javascript: void(0);' onclick='Detail(this)' title='Detail' class='edit' target='_blank'>" + data.Id + "</a></center>";

    }

