                                <div role="tabpanel" class="tab-pane fade" id="FamilyInfo">
                                    <div class="row">
                                        <div class="col-md-12">
                                            @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Family>()
                                                    .Name("gridFamily")
                                                    .ToolBar(toolbar => toolbar.Create())
                                                    .Columns(columns =>
                                                    {
                                                        columns.Command(command =>
                                                        {
                                                            command.Edit().Text(" ").UpdateText("Save");
                                                            command.Destroy().Text(" ");
                                                        }).Title("Action").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(90);
                                                        columns.Bound(p => p.fName).Width(200);
                                                        columns.Bound(p => p.fPhoneNo).Width(150);
                                                        columns.Bound(p => p.fFamilyStatus).Width(150);
                                                        columns.Bound(p => p.fGender).Width(100);
                                                        columns.Bound(p => p.fAddress).Width(300);
                                                        columns.Bound(p => p.fReligionId).Hidden();
                                                        columns.Bound(p => p.fReligion).Hidden();

                                                    })
                                                    .NoRecords()
                                                    .Editable(editable => editable.Mode(GridEditMode.PopUp).Window(wd => wd.Title("Family")).DisplayDeleteConfirmation(false))
                                                    .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                                    .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                                                        .Extra(false)
                                                        .Operators(operators => operators
                                                        .ForString(str => str.Clear()
                                                            .Contains("Contains")
                                                            .StartsWith("Start sWith")
                                                            .EndsWith("End sWith")
                                                        )))
                                                    .Scrollable(s => s.Enabled(true).Height("auto"))
                                                    .Resizable(rsz => rsz.Columns(true))
                                                    .DataSource(dataSource => dataSource
                                                        .Ajax()
                                                        .PageSize(10)
                                                        .Events(events => events.Error("errorHandler"))
                                                        .Model(model =>
                                                        {
                                                            model.Id(p => p.Id);
                                                        })
                                                        .Read(read => read.Action("ReadFamily", "employeebasic").Data("grid_params"))
                                                        .Create(create => create.Action("CreateFamily", "employeebasic"))
                                                        .Update(update => update.Action("UpdateFamily", "employeebasic"))
                                                        .Destroy(destroy => destroy.Action("DestroyFamily", "employeebasic"))
                                                    )
                                                    //.AutoBind(false)
                                                    //.Messages(msg => msg.Commands(c => { c.Create("Add Item"); c.Update(" "); c.Cancel(" "); c.Canceledit(" "); }))
                                                    .Events(e => e.Save("saveFamilyEvent"))//e.DataBound("dataBoundEvent"))
											)
