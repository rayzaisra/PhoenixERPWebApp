    	//return {
    	//	divisionId: divisi
    	//};
        var id = '';
        //var id = $("#BusinessUnitDepartementId").data("kendoDropDownList").value();

    	if (id == "")
    		id = "noselected";
    	return {
    		id: id
    	};
    }

