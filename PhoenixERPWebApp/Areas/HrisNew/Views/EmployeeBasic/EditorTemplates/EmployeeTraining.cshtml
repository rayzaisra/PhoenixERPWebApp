@model PhoenixERPWebApp.Models.EmployeeTraining
<!-- BEGIN: Subheader -->
<!-- MODAL REMOTE -->
<style>
	.k-animation-container, .k-widget, .k-widget *, .k-animation-container *, .k-widget *:before, .k-animation-container *:after {
		box-sizing: border-box !important;
	}

	/*k-popup-edit-form k-window-content k-content*/
	.k-window-titlebar k-header, div.k-edit-form-container{
		width: 820px;
		/*padding:0px !important;*/
	}

	table {
		border: none;
		padding: 5px 20px;
		width: 100%;
		position:center;
	}

		table tr > td {
			width: 50%;
			padding: 0px 10px;
		}
</style>
<div class="k-content">
	<div class="row">
		<div class="col-sm-12">
			<table>
				<tr>
					<td>
						<div class="form-group">
							<label asp-for="NameTraining"></label> <span class="req">*</span> :
							@(Html.Kendo().TextBoxFor(x => x.NameTraining).HtmlAttributes(new { style = "width:100%", required = "required", @maxlength = 150 }))
						</div>
					</td>
					<td>
						<div class="form-group">
							<label asp-for="EmployeeTrainingInstitutionId"></label>:
							@(Html.Kendo().DropDownListFor(m => m.EmployeeTrainingInstitutionId)
								.DataTextField("Text")
								.DataValueField("Value")
								.OptionLabel($"choose a {Html.DisplayNameFor(m => m.EmployeeTrainingInstitutionId)}")
								.HtmlAttributes(new
								{
									style = "width:100%;",
									required = "required",
									validationmessage = $"{Html.DisplayNameFor(m => m.EmployeeTrainingInstitutionId)} is required"
								})
								.Height(400)
								.Filter(FilterType.Contains)
								.DataSource(source => source
									.Custom()
									.Transport(transport => transport
										.Read(read =>
										{
											read.Action("GetDDLInstitution", "Dropdown", new { area = "hrisnew" });
										}))
								.ServerFiltering(false))
							)
						</div>				
					</td>
				</tr>
				<tr>
					<td>
						<div class="form-group">
							@*<label asp-for="EmployeeTrainingAddress"></label> :
							@(Html.Kendo().TextBoxFor(x => x.EmployeeTrainingAddress).HtmlAttributes(new { style = "width:100%", @maxlength = 100 }))*@
							<label asp-for="EmployeeTrainingAddress"></label><span class="req">*</span> :
							@Html.TextAreaFor(x => x.EmployeeTrainingAddress, new { @class = "k-textbox", @maxlength = 2000, style = "width: 100%;padding:0.5em" })
						</div>					
					</td>
					<td>
						<label>Year</label><span class="req">*</span> :<br />
						<div style="display:inline-block">
							@(Html.Kendo().DatePickerFor(m => m.StartTraining).Start(CalendarView.Decade).Depth(CalendarView.Decade)
								.Format("yyyy")
								.HtmlAttributes(new
								{
									style = "width:100%;margin-right:10px",
									required = "required",
									@class = "form-control form-control-sm m-input",
								}))
						</div>
						<div style="display:inline-block">
							@(Html.Kendo().DatePickerFor(m => m.EndTraining).Start(CalendarView.Decade).Depth(CalendarView.Decade)
							.Format("yyyy")
							.HtmlAttributes(new
							{
								style = "width:100%",
								required = "required",
								@class = "form-control form-control-sm m-input",
							}))
						</div>
					</td>
				</tr>
				<tr>
					<td>
						<div class="form-group">
							<label asp-for="NoCertification"></label> :
							@(Html.Kendo().TextBoxFor(x => x.NoCertification).HtmlAttributes(new { style = "width:100%", required = "required", @maxlength = 50 }))
						</div>						
					</td>
					<td rowspan="2">
						<div class="form-group">
							<div class="form-group">
								<label asp-for="EmployeeTrainingDescription"></label> <span class="req">*</span> :
								@Html.TextAreaFor(x => x.EmployeeTrainingDescription, new { @class = "k-textbox", required = "required", @maxlength = 2000, style = "width: 100%;padding:0.5em" })
							</div>
						</div>
					</td>
				</tr>
				<tr>
					<td>
						<div class="form-group">
							<label asp-for="ExpiredCertificate"></label> :
							@(Html.Kendo().DatePickerFor(m => m.ExpiredCertificate)
								.Format("dd MMM yyyy")
								.HtmlAttributes(new
								{
									style = "width:50%",
									@class = "form-control form-control-sm m-input",
								}))
						</div>
					</td>
					<td>
						<div class="form-group"></div>
					</td>
				</tr>
				<tr>
					<td>
						<div class="form-group">
							@*<label asp-for="FilemasterId"></label> :
							@(Html.Kendo().TextBoxFor(x => x.FilemasterId).HtmlAttributes(new { style = "width:100%", required = "required", @maxlength = 100 }))*@
						</div>
					</td>
					<td></td>
				</tr>				
			</table>
		</div>
	</div>
</div>