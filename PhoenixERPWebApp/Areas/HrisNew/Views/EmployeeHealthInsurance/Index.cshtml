</div>
<script>
    var employeeId = 0;

    $('#btnSubmit').click(function () {
        var gridFamily = $("#gridFamily").data("kendoGrid");
        var dataList = {
            EmployeeHealthInsuranceFamilys: gridFamily.dataSource.data(),
        }
        var valid = $("#formEmployeeHealthInsurance").validate().form();
        if (valid) {
            @*if (gridFamily.dataSource.data().length == 0) {
                swal('Warning', "Family cannot be empty.", 'warning');
            } else {
                gridFamily.saveRow();
                callAction({ formId: "formEmployeeHealthInsurance", title: "save", type: "POST", url: '@Url.Action("submit", "employeehealthinsurance")', objects: dataList });
            }*@
             callAction({ formId: "formEmployeeHealthInsurance", title: "save", type: "POST", url: '@Url.Action("submit", "employeehealthinsurance")', objects: dataList });
        }
    });

     function params_autocomplete() {
         return {
            name: $("#SearchEmployee").val()
        };
    }

    function family_params() {
        return {
            employeeId: employeeId
        };
    }

    function grid_params() {
        return {
            employeeId :$("#EmployeeBasicInfoId").val()
        }
    }

    function saveFamilyEvent(e) {
        e.model.set("FamilyStatus", $("#FamilyStatus").val());
        e.model.set("Gender", $("#Gender").val());
        e.model.set("DateBirth", $("#DateBirth").data("kendoDatePicker").value());
        e.model.set("FamilyId", $("#FamilyId").data("kendoDropDownList").value());
        e.model.set("FamilyName", $("#FamilyId").data("kendoDropDownList").text());
    }

    function family_select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;

            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $.ajax({
                type: "GET",
                url: '@Url.Action("GetFamily", "employeehealthinsurance")',
                data: { familyId: dataItem.Value },
                success: function (result) {
                    if (result != undefined) {
                        $("#FamilyStatus").val(result.FamilyStatus);
                        $("#Gender").val(result.Gender);
                        $("#DateBirth").data("kendoDatePicker").value(result.DateBirth);
                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    console.log(e)
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
                }, 2e3));
        }
    }

    function inpatient_select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            if (dataItem.Value == "No") {
                $("#InpatientPremi").data("kendoNumericTextBox").value(0);
                $("#InpatientPremi").data("kendoNumericTextBox").readonly();
            } else {
                $("#InpatientPremi").data("kendoNumericTextBox").readonly(false);
            }

            premi_change();
        }
    }

    function outpatient_select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            if (dataItem.Value == "No") {
                $("#OutpatientPremi").data("kendoNumericTextBox").value(0);
                $("#OutpatientPremi").data("kendoNumericTextBox").readonly();
            } else {
                $("#OutpatientPremi").data("kendoNumericTextBox").readonly(false);
            }
            premi_change();
        }
    }

    function dental_select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            if (dataItem.Value == "No") {
                $("#DentalPremi").data("kendoNumericTextBox").value(0);
                $("#DentalPremi").data("kendoNumericTextBox").readonly();
            } else {
                $("#DentalPremi").data("kendoNumericTextBox").readonly(false);
            }
            premi_change();
        }
    }

    function maternity_select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            if (dataItem.Value == "No") {
                $("#MaternityPremi").data("kendoNumericTextBox").value(0);
                $("#MaternityPremi").data("kendoNumericTextBox").readonly();
            } else {
                $("#MaternityPremi").data("kendoNumericTextBox").readonly(false);
            }
            premi_change();
        }
    }

    function optical_select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            if (dataItem.Value == "No") {
                $("#OpticalPremi").data("kendoNumericTextBox").value(0);
                $("#OpticalPremi").data("kendoNumericTextBox").readonly();
            } else {
                $("#OpticalPremi").data("kendoNumericTextBox").readonly(false);
            }
            premi_change();
        }
    }

    function premi_change() {
        var InpatientPremi = $("#InpatientPremi").data("kendoNumericTextBox").value();
        var OutpatientPremi= $("#OutpatientPremi").data("kendoNumericTextBox").value();
        var DentalPremi= $("#DentalPremi").data("kendoNumericTextBox").value();
        var MaternityPremi= $("#MaternityPremi").data("kendoNumericTextBox").value();
        var OpticalPremi = $("#OpticalPremi").data("kendoNumericTextBox").value();

        if (InpatientPremi == undefined) InpatientPremi = 0;
        if (OutpatientPremi == undefined) OutpatientPremi = 0;
        if (DentalPremi == undefined) DentalPremi = 0;
        if (MaternityPremi == undefined) MaternityPremi = 0;
        if (OpticalPremi == undefined) OpticalPremi = 0;

        var total = InpatientPremi + OutpatientPremi + DentalPremi + MaternityPremi + OpticalPremi;

        $("#TotalPremi").data("kendoNumericTextBox").value(total);
    }


    function employeeInfoSelectEvent(e) {
        var dataItem = this.dataItem(e.item.index());
        if (dataItem === undefined) {
            this.value("");
            ClearAsignEmployee();
            $("#btnSubmit").css("display", "none");
        } else {
            $("#btnSubmit").css("display", "block");
            employeeId = dataItem.Value;
            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $.ajax({
                type: "GET",
                url: '@Url.Action("AddEdit", "employeehealthinsurance")',
                data: { employeeId: dataItem.Value },
                success: function (result) {
                    if (result != undefined) {
                        $("#EmployeeBasicInfoId").val(result.infoEmployee.EmployeeId);
                        $("#Endorsement").val(result.Endorsement);
                        $("#EffectiveDate").data("kendoDatePicker").value(result.EffectiveDate);
                        $("#PlanNumber").val(result.PlanNumber);
                        $("#InsuranceCompanyId").data("kendoDropDownList").value(result.InsuranceCompanyId);
                        $("#Remarks").val(result.Remarks);
                        $("#Inpatient").data("kendoDropDownList").value(result.Inpatient);
                        $("#Outpatient").data("kendoDropDownList").value(result.Outpatient);
                        $("#Dental").data("kendoDropDownList").value(result.Dental);
                        $("#Maternity").data("kendoDropDownList").value(result.Maternity);
                        $("#Optical").data("kendoDropDownList").value(result.Optical);

                        $("#InpatientPremi").data("kendoNumericTextBox").value(result.InpatientPremi);
                        $("#OutpatientPremi").data("kendoNumericTextBox").value(result.OutpatientPremi);
                        $("#DentalPremi").data("kendoNumericTextBox").value(result.DentalPremi);
                        $("#MaternityPremi").data("kendoNumericTextBox").value(result.MaternityPremi);
                        $("#OpticalPremi").data("kendoNumericTextBox").value(result.OpticalPremi);

                        var total = result.InpatientPremi + result.OutpatientPremi + result.DentalPremi + result.MaternityPremi + result.OpticalPremi;
                        if (total == undefined) total = 0;
                        $("#TotalPremi").data("kendoNumericTextBox").value(total);

                        $("#TotalMutation").data("kendoNumericTextBox").value(result.TotalMutation);
                        $("#MutationDate").data("kendoDatePicker").value(result.MutationDate);

                        $("#CreatedBy").val(result.CreatedBy);
                        $("#CreatedOn").val(result.CreatedOn);
                        $("#ModifiedBy").val(result.ModifiedBy);
                        $("#ModifiedOn").val(result.ModifiedOn);
                        $("#ApprovedBy").val(result.ApprovedBy);
                        $("#ApprovedOn").val(result.ApprovedOn);
                        $("#IsActive").val(result.IsActive);
                        $("#IsLocked").val(result.IsLocked);
                        $("#IsDefault").val(result.IsDefault);
                        $("#IsDeleted").val(result.IsDeleted);
                        $("#OwnerId").val(result.OwnerId);
                        $("#DeletedBy").val(result.DeletedBy);
                        $("#DeletedOn").val(result.DeletedOn);
                        $("#BusinessUnitDivisionId").val(result.BusinessUnitDivisionId);
                        $("#BusinessUnitDepartementId").val(result.BusinessUnitDepartementId);

                        $("#infoEmployee_EmployeeName").val(result.infoEmployee.EmployeeName);
                        $("#infoEmployee_JobTitle").val(result.infoEmployee.JobTitle);
                        $("#infoEmployee_Grade").val(result.infoEmployee.Grade);
                        $("#infoEmployee_EmployementStatus").val(result.infoEmployee.EmployementStatus);
                        $("#infoEmployee_Phone").val(result.infoEmployee.Phone);
                        $("#infoEmployee_DateBirth").data("kendoDatePicker").value(result.infoEmployee.DateBirth);
                        $("#infoEmployee_Age").data("kendoNumericTextBox").value(result.infoEmployee.Age);
                        $("#infoEmployee_Email").val(result.infoEmployee.Email);
                        $("#infoEmployee_DateEmployed").data("kendoDatePicker").value(result.infoEmployee.DateEmployed);
                        $("#infoEmployee_EmployeeContractDocument").val(result.infoEmployee.EmployeeContractDocument);
                        $("#infoEmployee_MarriedStatusName").val(result.infoEmployee.MarriedStatusName);
                        $("#gridFamily").data("kendoGrid").dataSource.read();
                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    console.log(e)
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
                }, 2e3));
        }
    }

    function ClearAsignEmployee() {
        $("#EmployeeBasicInfoId").val("");
        $("#infoEmployee_EmployeeName").val("");
        $("#infoEmployee_JobTitle").val("");
        $("#infoEmployee_Grade").val("");
        $("#infoEmployee_EmployementStatus").val("");
        $("#infoEmployee_Phone").val("");
        $("#infoEmployee_DateBirth").data("kendoDatePicker").value("");
        $("#infoEmployee_Age").data("kendoNumericTextBox").value("");
        $("#infoEmployee_Email").val("");
        $("#infoEmployee_DateEmployed").data("kendoDatePicker").value("");
        $("#infoEmployee_MarriedStatusName").val("");
    }
</script>