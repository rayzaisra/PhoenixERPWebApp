<script>
    $(document).ready(function () {
        if ('@Model.Id' != '') {
            $("#PayrollDeduction").data("kendoNumericTextBox").readonly();
           
            $("#DateLoan").data("kendoDatePicker").readonly();
            //$("#Value").data("kendoNumericTextBox").readonly();
            $("#RepaymentStartDate").data("kendoDatePicker").readonly();
            //$("#ValueInterestAmount").data("kendoNumericTextBox").readonly();
            //$("#ValueInstallmentAmount").data("kendoNumericTextBox").readonly();
            //$("#ValueTotalInstallment").data("kendoNumericTextBox").readonly();
            $("#search").remove();
            $('#Value').css('text-align', 'right');
            $('#ValueInterestAmount').css('text-align', 'right');
            $('#ValueInstallmentAmount').css('text-align', 'right');
            $('#ValueTotalInstallment').css('text-align', 'right');
            $('#Remaining').css('text-align', 'right');

            $('#Value').val(formatDecimal($('#Value').val().replace(',','.')));
            

            if ( $('#ValueInstallmentAmount').val() !== "") {
                $('#ValueInstallmentAmount').val(formatDecimal($('#ValueInstallmentAmount').val().replace(',','.')));
            } else {
                $('#ValueInstallmentAmount').val('0.00');
            }

            if ($('#ValueInterestAmount').val() !== "") {
                $('#ValueInterestAmount').val(formatDecimal($('#ValueInterestAmount').val().replace(',', '.')));
            } else {
                $('#ValueInterestAmount').val('0.00');
            }

            if ($('#ValueTotalInstallment').val() !== "") {
                $('#ValueTotalInstallment').val(formatDecimal($('#ValueTotalInstallment').val().replace(',', '.')));
            } else {
                $('#ValueTotalInstallment').val('0.00');
            }
            
            $('#Remaining').val(formatDecimal($('#Remaining').val().replace(',','.')));
           
            $('#btn-save').prop('disabled', false);
            $('#btn-submit').prop('disabled', false);

            if ('@ViewBag.processApprove' == 'True' && '@Model.Status' == 2) {
                $('#LogDescription').val('');
            }
        } else {
            $('#Remaining').data("kendoNumericTextBox").value(0);
            $("#Value").data("kendoNumericTextBox").readonly();
            $('#Remaining').css('text-align', 'right');
            $("#PayrollDeduction").data("kendoNumericTextBox").readonly();
            $('#btn-save').prop('disabled', true);
            $('#btn-submit').prop('disabled', true);
        }

        $('#Value').blur(function () {
            CalculateTotalInstallment();
        });

        $('#btn-save').click(function () {
            var LoanValue = '';
            if ('@Model.Id' != '') {
                var vala = $('#ValueInterestAmount').val().replace('.', ',');
                var valb = $('#ValueInstallmentAmount').val().replace('.', ',');
                var valc = $('#ValueTotalInstallment').val().replace('.', ',');
                LoanValue = $('#Value').val();
                $('#ValueInterestAmount').val(vala);
                $('#ValueInstallmentAmount').val(valb);
                $('#ValueTotalInstallment').val(valc);
            } else {
                LoanValue = $('#Value').data('kendoNumericTextBox').value();
            }

            if (LoanValue === 0) {
                swal('Information', 'Ooops, You have not entered the loan value data!', 'info');
                return false;
            }
           
            callAction({ formId: "formEmployeeLoan", title: "save", type: "POST", url: '@Url.Action("Save", "EmployeeLoanCoop")' });
        });

        $('#btn-submit').click(function () {
            var LoanValue = '';
            if ('@Model.Id' != '') {
                $('#Value').val('@Model.Value');
                $('#ValueInterestAmount').val('@Model.ValueInterestAmount');
                $('#ValueInstallmentAmount').val('@Model.ValueInstallmentAmount');
                $('#ValueTotalInstallment').val('@Model.ValueTotalInstallment');
                $('#Remaining').val('@Model.Remaining');
                LoanValue = $('#Value').val();
            } else {
                LoanValue = $('#Value').data('kendoNumericTextBox').value();
            }

            if (LoanValue === 0) {
                swal('Information', 'Ooops, You have not entered the loan value data!', 'info');
                return false;
            }
            
            callAction({ formId: "formEmployeeLoan", title: "submit", type: "POST", url: '@Url.Action("Submit", "EmployeeLoanCoop")' });
        });

        $('#btnApprove').click(function () {
            $('#Value').val('@Model.Value');
            $('#ValueInterestAmount').val('@Model.ValueInterestAmount');
            $('#ValueInstallmentAmount').val('@Model.ValueInstallmentAmount');
            $('#ValueTotalInstallment').val('@Model.ValueTotalInstallment');
            $('#Remaining').val('@Model.Remaining');
            callAction({ formId: "formEmployeeLoan", title: "approve", type: "PUT", url: '@Url.Action("Approve", "EmployeeLoanCoop")' });
        });

        $('#btnReject').click(function () {
            $('#Value').val('@Model.Value');
            $('#ValueInterestAmount').val('@Model.ValueInterestAmount');
            $('#ValueInstallmentAmount').val('@Model.ValueInstallmentAmount');
            $('#ValueTotalInstallment').val('@Model.ValueTotalInstallment');
            $('#Remaining').val('@Model.Remaining');
            callAction({ formId: "formEmployeeLoan", title: "reject", type: "PUT", url: '@Url.Action("Reject", "EmployeeLoanCoop")' });
        });
    });



    function params_autocomplete() {
        return {
            name: $("#SearchEmployee").val()
        };
    }

    function CalculateTotalInstallment() {
        var value = $('#Value').data("kendoNumericTextBox").value();
        //var tenor = $("#Tenor").data("kendoDropDownList").value();
        var payrollDeduction = $("#PayrollDeduction").data("kendoNumericTextBox").value();
        var interest = $('#InterestMonth').val();
       
        var installmentAmount = (value / payrollDeduction) + ((parseFloat(interest) * value) / 100);
        var interestAmount = ((parseFloat(interest) * value * payrollDeduction) / 100);
        var TotalInstallment = value + ((parseFloat(interest) * value * payrollDeduction) / 100);
        //if (remainingBalance === 0) {
        //    var remaining = remainingBalance - TotalInstallment;
        //     $('#Remaining').data("kendoNumericTextBox").value(remaining); 
        //}

        $('#ValueTotalInstallment').data("kendoNumericTextBox").value(TotalInstallment);
        $('#ValueInterestAmount').data("kendoNumericTextBox").value(interestAmount);
        $('#ValueInstallmentAmount').data("kendoNumericTextBox").value(installmentAmount);
        $('#Value').css('text-align', 'right');
        $('#ValueInterestAmount').css('text-align', 'right');
        $('#ValueInstallmentAmount').css('text-align', 'right');
        $('#ValueTotalInstallment').css('text-align', 'right');

        if ($("#EmployeeBasicInfoId").val() === "") {
            $('#btn-save').prop('disabled', true);
            $('#btn-submit').prop('disabled', true);
        } else {
            $('#btn-save').prop('disabled', false);
            $('#btn-submit').prop('disabled', false);
        }
       
    }

    function formatNum(value) {
        value = parseFloat(value);
        var output = '' + addCommas(value.toFixed(2));
        return value < 0 ? '(' + output.replace('-', '') + ')' : output;
    }

    function formatDecimal(total) {
        var neg = false;
        if (total < 0) {
            neg = true;
            total = Math.abs(total);
        }
        return (neg ? "-" : ' ') + parseFloat(total, 10).toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g, "$1,").toString();
    }

    function addCommas(nStr) {
        nStr += '';
        x = nStr.split('.');
        x1 = x[0];
        x2 = x.length > 1 ? '.' + x[1] : '';
        var rgx = /(\d+)(\d{3})/;
        while (rgx.test(x1)) {
            x1 = x1.replace(rgx, '$1,$2');
        }
        return x1 + x2;
    }

    function calculateInterestValue() {
        var value = $("#Value").data("kendoNumericTextBox").value();
        var payrollDeduction = $("#PayrollDeduction").data("kendoNumericTextBox").value();
        var interestperMonth = $("#InterestMonth").val();
        var persentasePerTotalMonth = (payrollDeduction * interestperMonth);
        var interest = (value * persentasePerTotalMonth)/100;
        var total = value + interest;
        //$("#InterestValue").data("kendoNumericTextBox").value(total);
    }

    function employeeInfoSelectEvent(e) {
        var dataItem = this.dataItem(e.item.index());
        if (dataItem === undefined) {
            this.value("");
            $("#EmployeeBasicInfoId").val("");
            $("#infoEmployee_EmployeeName").val("");
            $("#infoEmployee_JobTitle").val("");
            $("#infoEmployee_Grade").val("");
        } else {
            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $.ajax({
                type: "GET",
                url: '@Url.Action("GetEmployeeInfoById", "employeeinfo")',
                data: { employeeId: dataItem.Value },
                success: function (result) {
                    if (result != undefined) {
                        $("#EmployeeBasicInfoId").val(result.EmployeeId);
                        $("#infoEmployee_EmployeeName").val(result.EmployeeName);
                        $("#infoEmployee_JobTitle").val(result.JobTitle);
                        $("#infoEmployee_Grade").val(result.Grade);
                        
                        $("#DateLoan").data("kendoDatePicker").readonly(false);
                        $("#Value").data("kendoNumericTextBox").readonly(false);
                        $("#PayrollDeduction").data("kendoNumericTextBox").readonly(false);
                        $("#RepaymentStartDate").data("kendoDatePicker").readonly(false);
                        $('#btn-save').prop('disabled', false);
                        $('#btn-submit').prop('disabled', false);
                        $.ajax({
                            type: "GET",
                            url: '@Url.Action("GetEmployeeLoanInfoById", "employeeinfo")',
                            data: { employeeId: dataItem.Value, isCorporateloan:'0' },
                            success: function (result2) {
                                if (result2 != undefined) {
                                    if (result2.LoanBalance > 0)
                                    {
                                        swal('Information', 'Ooops, this employee still has a loan coop!', 'info');
                                        $("#EmployeeBasicInfoId").val("");
                                        $("#infoEmployee_EmployeeName").val("");
                                        $("#infoEmployee_JobTitle").val("");
                                        $("#infoEmployee_Grade").val("");
                                       
                                        $("#DateLoan").data("kendoDatePicker").readonly();
                                        $("#Value").data("kendoNumericTextBox").readonly();
                                        $("#PayrollDeduction").data("kendoNumericTextBox").readonly();
                                        $("#RepaymentStartDate").data("kendoDatePicker").readonly();
                                        $("#ValueInterestAmount").data("kendoNumericTextBox").readonly();
                                        $("#ValueInstallmentAmount").data("kendoNumericTextBox").readonly();
                                        $("#ValueTotalInstallment").data("kendoNumericTextBox").readonly();
                                        $('#btn-save').prop('disabled', true);
                                        $('#btn-submit').prop('disabled', true);
                                    }

                                }
                            }
                        }); 
                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    console.log(e)
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
                }, 2e3));
        }
    }
</script>