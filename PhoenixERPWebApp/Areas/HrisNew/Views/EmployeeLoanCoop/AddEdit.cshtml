@model PhoenixERPWebApp.Models.EmployeeLoan
@{
    ViewData["Title"] = "Employee Loan Coop";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";

    DateTime? DateLoan = DateTime.Now;
    DateTime? RepaymentStartDate = DateTime.Now;
    if (!string.IsNullOrEmpty(Model.Id))
    {
        if (DateLoan >= Model.DateLoan)
        {
            DateLoan = Model.DateLoan;
        }

        if (RepaymentStartDate >= Model.RepaymentStartDate)
        {
            RepaymentStartDate = Model.RepaymentStartDate;
        }
    }
}
