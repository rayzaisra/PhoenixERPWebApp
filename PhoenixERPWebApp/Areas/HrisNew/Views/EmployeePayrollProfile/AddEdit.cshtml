                                        <button type="button" id="btn-save" class="btn btn-primary"><span class="fa fa-save"></span> Save</button>
                                    }
                                    <a asp-action="index" asp-controller="employeepayrollprofile" asp-area="hrisnew" class="fakelink btn btn-secondary"><span class="fa fa-arrow-circle-left"></span> Cancel</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_PayrollHistory" />
<style>
    .k-grid-footer tr.k-footer-template td {
        border-style: solid;
        border-width: 1px 0 0 0;
        text-align: right;
    }
</style>
<script>
    var AddAmount = 0;
    var DedAmount = 0;
  


    $('#btn-historyPayroll').click(function () {
        $('#modalPayrollHistory').modal('show');
    });

    function EncryptAmount() {
        return '**********';
    }


    $('#btn-save').click(function () {
        ////var grid = $('#gridSalary').data('kendoGrid');
        ////var tr = $(e.target).closest('tr');
        ////var validated = $(tr).kendoValidator().data('kendoValidator').validate();
        //var validated = $("#gridSalary").data("kendoGrid").saveRow();
        //if (validated) {
        //    alert("errr");
        //}

        var gridAdditional = $("#gridAdditional").data("kendoGrid");
        var gridDeducation = $("#gridDeducation").data("kendoGrid");

        gridAdditional.saveRow();
        gridDeducation.saveRow();

        var dataList = {
            EmployeeSubcomponentAdditionals: gridAdditional.dataSource.data(),
            EmployeeSubcomponentDeductions: gridDeducation.dataSource.data()
         }
        callAction({ formId: "formemployeepayrollprofile", title: "save", type: "POST", url: '@Url.Action("save", "employeepayrollprofile")', objects: dataList });
    });

    $("#btn-load").click(function () {
        $('#gridAdditional').data('kendoGrid').dataSource.read();
        $('#gridDeducation').data('kendoGrid').dataSource.read();
    });

    function saveAdditionalEvent(e) {
        var percent = $("#AdditionalPercent").data("kendoNumericTextBox").value();
        var amount = $("#AdditionalAmount").data("kendoNumericTextBox").value();
        var salaryComponentValue = $("#AdditionalSalaryComponent").data("kendoDropDownList").value();
        var salaryComponentName = $("#AdditionalSalaryComponent").data("kendoDropDownList").text();
        var ComponentTypeValue = $("#AdditionalComponentId").data("kendoDropDownList").value();
        var ComponentTypeName = $("#AdditionalComponentId").data("kendoDropDownList").text();

        e.model.set("AdditionalPercent", percent);
        e.model.set("AdditionalAmount", amount);
        e.model.set("AdditionalSalaryComponent", salaryComponentValue);
        e.model.set("AdditionalSalaryComponentName", salaryComponentName);
        e.model.set("AdditionalComponentId", ComponentTypeValue);
        e.model.set("AdditionalComponentTypeName", ComponentTypeName);

        var data = $("#gridDeducation").data("kendoGrid").dataSource.data();
        for (var i = 0; i < data.length; i++) {
            if (data[i].SalaryComponent == "@PhoenixERPWebApp.Models.SalaryComponentTypeDeduction.BPJS") {
                var newAmount = calculateBasicSalary() * (data[i].Percent / 100);
                data[i].set("Amount", newAmount);
            }
        }

        var dataAdd = $("#gridAdditional").data("kendoGrid").dataSource.data();
        for (var i = 0; i < dataAdd.length; i++) {
            if (dataAdd[i].AdditionalSalaryComponent == "@PhoenixERPWebApp.Models.SalaryComponentTypeAdditional.BPJS") {
                var newAmount = calculateBasicSalary() * (dataAdd[i].AdditionalPercent / 100);
                dataAdd[i].set("AdditionalAmount", newAmount);
            }
        }
    }

    function saveDeducationEvent(e) {
        var percent = $("#Percent").data("kendoNumericTextBox").value();
        var amount = $("#Amount").data("kendoNumericTextBox").value();
        var salaryComponentValue = $("#SalaryComponent").data("kendoDropDownList").value();
        var salaryComponentName = $("#SalaryComponent").data("kendoDropDownList").text();
        var ComponentTypeValue = $("#ComponentId").data("kendoDropDownList").value();
        var ComponentTypeName = $("#ComponentId").data("kendoDropDownList").text();

        e.model.set("Percent", percent);
        e.model.set("Amount", amount);
        e.model.set("SalaryComponent", salaryComponentValue);
        e.model.set("SalaryComponentName", salaryComponentName);
        e.model.set("ComponentId", ComponentTypeValue);
        e.model.set("ComponentTypeName", ComponentTypeName);
    }

    function editDeductionEvent(e) {
        var isReadonly = e.model.SalaryComponent == "@PhoenixERPWebApp.Models.SalaryComponentTypeDeduction.BPJS";
        $("#Amount").data("kendoNumericTextBox").readonly(isReadonly);
    }

    function PTKP_Select(e) {
        if (e.dataItem) {
            var value = e.dataItem.Value;
            var employeeId = '@Model.EmployeeId';
             $.ajax({
                    type: "GET",
                    url: '@Url.Action("getPph21", "employeepayrollprofile")',
                    data: { id: value, employeeId: employeeId},
                 success: function (result) {
                        if (result != undefined) {
                            $('#Pph21').data("kendoNumericTextBox").value(result.result);
                        }
                        mApp.unblock("#m_blockui_list");
                    },
                    error: function (e, t, s) {
                        console.log(e)
                        mApp.unblock("#m_blockui_list");
                    }
                }).then(setTimeout(function () {
                    mApp.unblock("#m_blockui_list");
                }, 2e3));
        }

    }

    function ComponentTypeAdditional_Select(e) {
        if (e.dataItem) {
            console.log(e.dataItem);
            var dataItem = e.dataItem;
            var salaryComponent = $("#AdditionalSalaryComponent").val();

            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $("#AdditionalPercent").data("kendoNumericTextBox").value(0);
            $("#AdditionalAmount").data("kendoNumericTextBox").value(0);

            if (salaryComponent == "@PhoenixERPWebApp.Models.SalaryComponentTypeAdditional.Allowance") {

                $.ajax({
                    type: "GET",
                    url: '@Url.Action("getallowancecomponent", "employeepayrollprofile")',
                    data: { id: dataItem.Value, employeeId: '@Model.EmployeeId'},
                    success: function (result) {
                        console.log('in ajax');
                        if (result != undefined) {
                            $("#AdditionalAmount").data("kendoNumericTextBox").value(result.Value);
                            $("#AdditionalPercent").data("kendoNumericTextBox").value(result.Percent);
                        }
                        mApp.unblock("#m_blockui_list");
                    },
                    error: function (e, t, s) {
                        console.log(e)
                        mApp.unblock("#m_blockui_list");
                    }
                }).then(setTimeout(function () {
                    mApp.unblock("#m_blockui_list");
                }, 2e3));
            }
            else if (salaryComponent == "@PhoenixERPWebApp.Models.SalaryComponentTypeAdditional.BPJS") {
                $.ajax({
                    type: "GET",
                    url: '@Url.Action("getbpjscomponent", "employeepayrollprofile")',
                    data: { id: dataItem.Value },
                    success: function (result) {
                        if (result != undefined) {
                            $("#AdditionalPercent").data("kendoNumericTextBox").value(result.Value);
                            //$("#AdditionalAmount").data("kendoNumericTextBox").value(result.MaxLimit);
                            var AdditionalAmount = calculateAdditionalAmount() * (result.Value / 100);
                            $("#AdditionalAmount").data("kendoNumericTextBox").value(AdditionalAmount);
                        }
                        mApp.unblock("#m_blockui_list");
                    },
                    error: function (e, t, s) {
                        console.log(e)
                        mApp.unblock("#m_blockui_list");
                    }
                }).then(setTimeout(function () {
                    mApp.unblock("#m_blockui_list");
                }, 2e3));
            }
            else {
                mApp.unblock("#m_blockui_list");
            }
        }
    }

    function ComponentTypeDeduction_Select(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            var salaryComponent = $("#SalaryComponent").val();

            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $("#Percent").data("kendoNumericTextBox").value(0);
            $("#Amount").data("kendoNumericTextBox").value(0);

             if (salaryComponent == "@PhoenixERPWebApp.Models.SalaryComponentTypeDeduction.BPJS") {
                $.ajax({
                    type: "GET",
                    url: '@Url.Action("getbpjscomponent", "employeepayrollprofile")',
                    data: { id: dataItem.Value },
                    success: function (result) {
                        if (result != undefined) {
                            $("#Percent").data("kendoNumericTextBox").value(result.Value);
                            //$("#Amount").data("kendoNumericTextBox").value(result.MaxLimit);
                            var AdditionalAmount = calculateBasicSalary() * (result.Value / 100);

                            $("#Amount").data("kendoNumericTextBox").value(AdditionalAmount);
                        }
                        mApp.unblock("#m_blockui_list");
                    },
                    error: function (e, t, s) {
                        console.log(e)
                        mApp.unblock("#m_blockui_list");
                    }
                }).then(setTimeout(function () {
                    mApp.unblock("#m_blockui_list");
                }, 2e3));
            } else {
                mApp.unblock("#m_blockui_list");
            }
        }
    }

    function deductionSalaryComponent_selectEvent(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            var isReadonly = dataItem.Value == "@PhoenixERPWebApp.Models.SalaryComponentTypeDeduction.BPJS";
            $("#Amount").data("kendoNumericTextBox").readonly(isReadonly);
        }
    }

    function grid_params() {
        return {
            employeeId: "@Model.EmployeeId",
            employeePayrollGroupId: $("#LoadGroup").val()
        }
    }

    function ComponentTypeAdditional_params() {
        return {
            salaryComponentId: $("#AdditionalSalaryComponent").val(),
            gradeId: $("#GradeId").val()
        }
    }

    function ComponentTypeDeduction_params() {
        return {
            salaryComponentId: $("#SalaryComponent").val()
        }
    }

    function calculateAdditionalAmount() {
        var data = $("#gridAdditional").data("kendoGrid").dataSource.data();
        var total = 0;
        for (var i = 0; i < data.length; i++) {
            total += parseFloat(data[i].AdditionalAmount);
        }
        AddAmount = total;
        var net = AddAmount - DedAmount;
        $('#NetSalary').data('kendoNumericTextBox').value(net);
        return total;
    }

    function calculateAmount() {
        var data = $("#gridDeducation").data("kendoGrid").dataSource.data();
        var total = 0;
        for (var i = 0; i < data.length; i++) {
            total += parseFloat(data[i].Amount);
        }
        DedAmount = total;
        var net = AddAmount - DedAmount;
        $('#NetSalary').data('kendoNumericTextBox').value(net);
        return total;
    }

    function calculateBasicSalary() {
        var data = $("#gridAdditional").data("kendoGrid").dataSource.data();
        var total = 0;
        for (var i = 0; i < data.length; i++) {

            //basic salary id
            if (data[i].AdditionalComponentId === "ab4cf509-88ee-4c35-8083-67e305a22719") {
                total += parseFloat(data[i].AdditionalAmount);
            }

            //timesleep allowance id
            if (data[i].AdditionalComponentId === "563e6fb7-dae5-4d9c-be68-1b28f26bb1b7") {
                total += parseFloat(data[i].AdditionalAmount);
            }

        }
        if (total > 8754600) {
            total = 8754600;
        }

        return total;
    }

    function deductionPercent_changeEvent(e) {
        var salaryComponent = $("#SalaryComponent").data("kendoDropDownList").value();
        if (salaryComponent == "@PhoenixERPWebApp.Models.SalaryComponentTypeDeduction.BPJS") {
            var gridAdditional = $("#gridAdditional").data("kendoGrid");
            gridAdditional.saveRow();
            //var AdditionalAmount = calculateAdditionalAmount() * (this.value() / 100);
            var AdditionalAmount = calculateBasicSalary() * (this.value() / 100);

            $("#Amount").data("kendoNumericTextBox").value(AdditionalAmount);
        }
    }

    function additionalPercent_changeEvent(e) {
        var salaryComponent = $("#AdditionalSalaryComponent").data("kendoDropDownList").value();
        if (salaryComponent == "@PhoenixERPWebApp.Models.SalaryComponentTypeAdditional.BPJS") {
            //var gridAdditional = $("#gridAdditional").data("kendoGrid");
            //gridAdditional.saveRow();
            //var AdditionalAmount = calculateAdditionalAmount() * (this.value() / 100);
            var AdditionalAmount = calculateBasicSalary() * (this.value() / 100);

            $("#AdditionalAmount").data("kendoNumericTextBox").value(AdditionalAmount);
        }

    }

    $("#pph21").on("click", function () {
        window.location.href = '@Url.Action("addedit", "employeebasic")?Id=' + '@Model.EmployeeId' +'&paramcol=&paramval=';
    });
</script>
