@{
    ViewData["Title"] = "Employee Payroll Profile";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">HRIS</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="employeepayrollprofile" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Employee Payroll Profile</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div>
                                <h3 class="m-portlet__head-text m--font-success">Employee Payroll Profile</h3>
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
				<div class="m-portlet__body" id="m_blockui_list">
					<div class="row">
						<div class="col-md-12">
							<div class="row">
								<div class="col-lg-6">
									<div class="form-group row">
										<label class="col-lg-4 form-label">Employee Name</label>
										<div class="col-lg-8">
											@(Html.Kendo().TextBox().Name("srcName")
												.HtmlAttributes(new
												{
													style = "width:100%",
													@class = "form-control form-control-sm m-input",
													placeholder = $"Employee Name"
												}))
										</div>
									</div>
								</div>
								<div class="col-lg-6">
									<div class="form-group row">
										<label class="col-lg-4 form-label"></label>
										<div class="col-lg-8">
											
										</div>
									</div>
								</div>
							</div>
							<hr />
							<div class="col-lg-12">
								<div class="form-group">
									<button type="button" id="btnSearch" class="btn btn-sm btn-success" style="width:80px">Filter</button>
								</div>
							</div>
						</div>
					</div>
					<br />
					@(Html.Kendo().Grid<PhoenixERPWebApp.Models.InfoEmployee>()
                                .Name("grid")
                                .Columns(columns =>
                                {
                                    columns.Bound("").Title("#").Width(50).Filterable(false).HtmlAttributes(new { style = "text-align:center;", @class = "row-number" }).HeaderHtmlAttributes(new { style = "text-align:center;" });
                                    columns.Bound(p => p.EmployeeId).ClientTemplateId("btnAction-template").Width(200).Title("Employee ID");
                                    columns.Bound(p => p.EmployeeName).Width(200).Filterable(false);
                                    columns.Bound(p => p.LegalEntityName).Width(200);
                                    columns.Bound(p => p.Division).Width(200);
                                    columns.Bound(p => p.PtkpSettingName).Width(200);
                                    columns.Bound(p => p.JobTitle).Width(200);
                                    columns.Bound(p => p.Grade).Width(200);
                                    columns.Bound(p => p.EmployementStatus).Width(200);
                                    columns.Bound(p => p.DateEmployed).Title("Join Date").Width(200);
                                })
                                .NoRecords()
                                .Pageable(pageable => pageable
                                    .Refresh(true)
                                    .PageSizes(true)
                                    .ButtonCount(5))
                                .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                                .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                                    .Extra(false)
                                    .Operators(operators => operators
                                    .ForString(str => str.Clear()
                                        .Contains("Contains")
                                        .StartsWith("Start sWith")
                                        .EndsWith("End sWith")
                                    )))
                                .Scrollable(s => s.Enabled(true).Height("auto"))
                                .Resizable(rsz => rsz.Columns(true))
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .PageSize(10)
                                    .Events(events => events.Error("errorHandler"))
                                    .Model(model => { model.Id(p => p.EmployeeId); })
                                    .Read(read => read.Action("Read", "employeepayrollprofile").Data("grid_params"))
                                )
                                .Events(e => e.DataBound("dataBoundEvent"))
					)
				</div>
            </div>
        </div>
    </div>
</div>
<script id="btnAction-template" type="text/x-kendo-template">
    <a href='javascript: void(0);' onclick='viewGridRow(this)' title='View' class='edit'><label style="text-decoration:underline;color:blue;cursor:pointer">#=EmployeeId#</label></a>
</script>
<script>
    function viewGridRow(e) {
        var item = dataItem(e);
        window.location.href = '@Url.Action("AddEdit", "employeepayrollprofile")?employeeId=' + item.EmployeeId;
    }

	function grid_params() {
		return {
			empName: $("#srcName").val()
		};
	}

	$('#btnSearch').click(function () {
		mApp.block("#m_blockui_list", {
			overlayColor: "#000000",
			type: "loader",
			state: "primary",
			message: "Processing..."
		});

		$('#grid').data('kendoGrid').dataSource.read();

		mApp.unblock("#m_blockui_list");
	});
</script>