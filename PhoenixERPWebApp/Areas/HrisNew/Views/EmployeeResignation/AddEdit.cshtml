<script>

    $(document).ready(function () {
        var fileName = '@Model.ResignLetterName';
        if (fileName == '') {
            ResignLetter();
        } else {
            $("#linkDownloadFile").text(fileName);
        }



        if ('@Model.Status' != '') {
            $('#SearchEmployee').val('@Model.SearchEmployee');

            if ('@Model.IsApprove' == "True" || !('@Model.Status' == '@PhoenixERPWebApp.Models.StatusTransaction.Draft')) {
                $('.k-editor-toolbar').hide();
                $($("#Reason").data().kendoEditor.body).attr("contentEditable", false);
                $($("#Reason").data().kendoEditor.body).css("background-color", "#F8F9FA");

                $("#LastDayDate").data("kendoDatePicker").readonly();
                $("#EffectiveResignDate").data("kendoDatePicker").readonly();
                $("#linkRemoveFile").remove();

                    if ("@Model.requestEmployee.EmployementStatusId" != "@PhoenixERPWebApp.Models.EmployeeStatus.Tetap") {
                        if ('@Model.IsApprove' == "False") {
                            $("#EndOfContract").data("kendoDatePicker").readonly();
                        }
                    }


            }
        }
    });

    function params_autocomplete() {
        return {
            name: $("#SearchEmployee").val()
        };
    }

    function ClearAsignEmployee() {
        $("#SearchEmployeeId").val("");
    }

    function employeeInfoSelectEvent(e) {
        var dataItem = this.dataItem(e.item.index());
        if (dataItem === undefined) {
            this.value("");
            ClearAsignEmployee();
        } else {
            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $.ajax({
                type: "GET",
                url: '@Url.Action("GetEmployeeInfoById", "employeeinfo")',
                data: { employeeId: dataItem.Value },
                success: function (result) {
                    if (result != undefined) {
                        $("#SearchEmployeeId").val(result.EmployeeId);

                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    console.log(e)
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
            }, 2e3));

            $.ajax({
                type: "GET",
                url: '@Url.Action("GetDataResignationByEmployeeId", "employeeResignation")',
                data: { id: dataItem.Value },
                success: function (result) {
                    if (result != undefined) {
                        $("#Penalty").val(result.Penalty);
                        $("#TrainingBonding").val(result.TrainingBonding);
                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    console.log(e)
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
            }, 2e3));


        }

    }

    function removeFile() {
        ResignLetter();
    }

    function downloadFile() {
        downloadAction({url: '@Url.RouteUrl(new { action = "download", controller = "Download" })',data: { id: '@Model.ResignLetter' }});
    }

    function ResignLetter() {
        $("#divDownloadFile").remove();
        $("#divFile").empty().append("<input name='file' id='file' type='file' required/>");

        $("#file").kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".doc", ".pdf", ".docx", ".png", ".jpg", ".jpeg", ".gif"]
            }
        });
    }


    $('#btnShow').click(function () {
        $("#RemarkRejected").attr("required", "required");
        $('#modalRemark').modal('show');
    });

    $('#btnApprove').click(function () {
        $("#RemarkRejected").removeAttr("required", "required");
        callActionFile({ formId: "formTermination", title: "approval request", type:"POST", url: '@Url.Action("approve", "employeeresignation")'});
    });

    $('#btnReject').click(function () {
        callActionFile({ formId: "formTermination", title: "cancel request", type:"POST", url: '@Url.Action("reject", "employeeresignation")'});
    });

    $('#btnSubmit').click(function () {
        callActionFile({ formId: "formTermination", title: "submit", type:"POST", url: '@Url.Action("submit", "employeeresignation")'});
    });

    $('#btnSave').click(function () {
        callActionFile({ formId: "formTermination", title: "save", type:"POST", url: '@Url.Action("save", "employeeresignation")'});
    });
</script>