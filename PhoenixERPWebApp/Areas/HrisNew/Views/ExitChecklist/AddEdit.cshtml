<script>
    function grid_params() {
        return {
            terminationId :'@Model.Id',
            employeeBasicInfoId :'@Model.EmployeeBasicInfoId'
        }
    }

     $('#btnSubmit').click(function () {
         var gridJobHandover = $("#gridJobHandover").data("kendoGrid").dataSource.data();
         var gridOfficeManagement = $("#gridOfficeManagement").data("kendoGrid").dataSource.data();
         var gridInformationTechnology = $("#gridInformationTechnology").data("kendoGrid").dataSource.data();
         var gridFinance = $("#gridFinance").data("kendoGrid").dataSource.data();
         var gridHumanResource = $("#gridHumanResource").data("kendoGrid").dataSource.data();
         var gridOther = $("#gridOther").data("kendoGrid").dataSource.data();
         var gridFinalHandover = $("#gridFinalHandover").data("kendoGrid").dataSource.data();

         var data = {
             JobHandover: gridJobHandover,
             OfficeManagement: gridOfficeManagement,
             InformationTechnology: gridInformationTechnology,
             Finance: gridFinance,
             HumanResource: gridHumanResource,
             Other: gridOther,
             FinalHandover: gridFinalHandover
         }
         callAction({ formId: "formExitChecklist", title: "Submit", type: "POST", url: '@Url.Action("submit", "exitchecklist")', objects: data });
     });

    $('#btnSave').click(function () {
         var gridJobHandover = $("#gridJobHandover").data("kendoGrid").dataSource.data();
         var gridOfficeManagement = $("#gridOfficeManagement").data("kendoGrid").dataSource.data();
         var gridInformationTechnology = $("#gridInformationTechnology").data("kendoGrid").dataSource.data();
         var gridFinance = $("#gridFinance").data("kendoGrid").dataSource.data();
         var gridHumanResource = $("#gridHumanResource").data("kendoGrid").dataSource.data();
         var gridOther = $("#gridOther").data("kendoGrid").dataSource.data();
         var gridFinalHandover = $("#gridFinalHandover").data("kendoGrid").dataSource.data();

         var data = {
             JobHandover: gridJobHandover,
             OfficeManagement: gridOfficeManagement,
             InformationTechnology: gridInformationTechnology,
             Finance: gridFinance,
             HumanResource: gridHumanResource,
             Other: gridOther,
             FinalHandover: gridFinalHandover
         }
         callAction({ formId: "formExitChecklist", title: "Save", type: "POST", url: '@Url.Action("save", "exitchecklist")', objects: data });
     });

</script>