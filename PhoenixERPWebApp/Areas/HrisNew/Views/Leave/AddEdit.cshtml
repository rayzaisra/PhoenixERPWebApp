<script>
    var dateholidays = [];
    var processError = "";
    $(document).ready(function () {

        var FileUploadName = '@Model.FileUploadName';

        if (FileUploadName == '') {
            FileUpload();
        } else {
            $("#linkDownloadFileLeave").text(FileUploadName);
        }

        Other($("#LeaveRequestTypeId").data("kendoDropDownList").text());

        if ('@Model.Status' != '') {
            if ('@Model.IsApprove' == "True" || !('@Model.Status' == '@PhoenixERPWebApp.Models.StatusTransaction.Draft')) {// || '@Model.Status' == '@PhoenixERPWebApp.Models.StatusTransaction.Rejected')) {
                $('.k-editor-toolbar').hide();
                $($("#Reason").data().kendoEditor.body).attr("contentEditable", false);
                $($("#Reason").data().kendoEditor.body).css("background-color", "#F8F9FA");
                $("#LeaveRequestTypeId").data("kendoDropDownList").readonly();
                $("#StartDate").data("kendoDatePicker").readonly();
                $("#EndDate").data("kendoDatePicker").readonly();
                $("#search").remove();
                $("#Reached").attr("readonly", "readonly");
            }
        }


        if ('@Model.Id' !== '') {
            $('#ListTableLeaveBalance').show();
            $('#divcurrentuser').show();
            $('#gridLeaveBalance').data('kendoGrid').dataSource.read();
        } else {
            $('#ListTableLeaveBalance').hide();
            $('#divcurrentuser').hide();
        }
        //$('#gridLeaveBalance').data('kendoGrid').dataSource.read();
        //$('#gridLeaveBalance').data('kendoGrid').refresh()

        $.ajax({
            type: "GET",
            url: '@Url.Action("GetHolidays", "leave")',
            success: function (result) {

                $.each(result, function (x, r) {
                    dateholidays.push(new Date(r.Date));
                })

                mApp.unblock("#m_blockui_list");
            },
            error: function (e, t, s) {
                console.log(e)
                mApp.unblock("#m_blockui_list");
            }
        }).then(setTimeout(function () {
            mApp.unblock("#m_blockui_list");
        }, 2e3));
    });

    function removeFileUpload() {
        FileUpload();
    }

    function downloadFileUpload() {
        downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download" })', data: { id: $("#FileUpload").val() }});
    }

    function FileUpload() {
        $("#linkDownloadFileLeave").empty();
        $("#linkRemoveFileLeave").empty();
        $("#divFileUpload").empty().append("<input name='file' id='file' type='file'/>");

        $("#file").kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".jpg", ".jpeg", ".png", ".gif", ".doc", ".pdf", ".docx", ".xlx", ".xlsx"]
            }
        });
    }

    $('#btnShow').click(function () {
        $("#RemarkRejected").attr("required", "required");
        $('#modalRemark').modal('show');
    });


    $('#btnApprove').click(function () {
        $("#RemarkRejected").removeAttr("required", "required");
        if (!isValid()) return;
        $('#UseCurrentYear').val($('#chk_currentYear').is(':checked'));
        $('#UseCarryOver').val($('#chk_carryOver').is(':checked'));
        callAction({ formId:"formLeave", title: "approve", type:"POST", url: '@Url.Action("approve", "leave")'});
    });

    $('#btnReject').click(function () {
        $('#UseCurrentYear').val($('#chk_currentYear').is(':checked'));
        $('#UseCarryOver').val($('#chk_carryOver').is(':checked'));
        callAction({ formId:"formLeave", title: "reject", type:"POST", url: '@Url.Action("reject", "leave")'});
    });

    $('#btnSubmit').click(function () {
        if (!isValid()) return;
        $('#UseCurrentYear').val($('#chk_currentYear').is(':checked'));
        $('#UseCarryOver').val($('#chk_carryOver').is(':checked'));
        callActionFile({ formId: "formLeave", title: "submit", type: "POST", url: '@Url.Action("submit", "leave")' });
    });

    $('#btnSave').click(function () {
        if (!isValid()) return;
        $('#UseCurrentYear').val($('#chk_currentYear').is(':checked'));
        $('#UseCarryOver').val($('#chk_carryOver').is(':checked'));

        callActionFile({ formId: "formLeave", title: "save", type: "POST", url: '@Url.Action("save", "leave")' });
    });

    function startDateChange() {
        var LeaveRequestTypeId = $('#LeaveRequestTypeId').data("kendoDropDownList").value();
        var startDate = $("#StartDate").data("kendoDatePicker").value();
