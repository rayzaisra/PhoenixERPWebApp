                        $('#label-max-days').text('');
                        $('#btnSubmit').prop('disabled', true);
                        $('#btnSave').prop('disabled', true);
                        if (dataItem.Text.toLowerCase().indexOf('annual leave') < 0) {

                            var MinimumDurationLeave = result.MinimumDurationLeave;
                            if (MinimumDurationLeave === 0) {
                                MinimumDurationLeave = 1;
                            }

                            $("#TotalDays").data("kendoNumericTextBox").value(MinimumDurationLeave);
                            var startDate = $("#StartDate").data("kendoDatePicker").value();
                            var totalDays = $("#TotalDays").data("kendoNumericTextBox").value();

                            var isOpenDate = false;
                            if (result.MinimumDurationLeave !== result.MaximumDurationLeave) {
                                $("#EndDate").data("kendoDatePicker").enable(true);
                                isOpenDate = true;
                                //$('#label-max-days').text('* Maximum duration leave ' + result.MaximumDurationLeave);
                            } else if (result.MinimumDurationLeave === 0 && result.MaximumDurationLeave === 0) {
                                $("#EndDate").data("kendoDatePicker").enable(true);
                                isOpenDate = true;
                                //$('#label-max-days').text('* Maximum duration leave ' + result.MaximumDurationLeave);
