            $.ajax({
                type: "GET",
                url: '@Url.Action("GetLeaveRequestType", "leave")',
                data: { Id: dataItem.Value },
                success: function (result) {
                    if (result != undefined) {
                        $('#ListTableLeaveBalance').show();
