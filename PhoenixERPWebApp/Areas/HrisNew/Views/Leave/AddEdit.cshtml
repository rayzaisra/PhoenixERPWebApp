    function Other(text) {
        $(".leaveOther").css("display", "none");
        if (text.toLowerCase() == 'other') {
            $(".leaveOther").css("display", "block");
            $("#OtherLeave").attr("required", "required")
        } else {
            $("#OtherLeave").removeAttr("required");
            $("#OtherLeave").val("");
