                            } else {
                                $("#EndDate").data("kendoDatePicker").enable(false);
                                $('#label-max-days').text('');
                            }
                            if (isOpenDate) {
                                $("#EndDate").data("kendoDatePicker").value('');
                            } else {
                                if (totalDays === 1) {
                                    $("#EndDate").data("kendoDatePicker").value(new Date(startDate));
                                } else {

                                    var endDate = "", noOfDaysToAdd = (totalDays - 1), count = 0;
                                    var sd = new Date(startDate);
                                    while (count < noOfDaysToAdd) {
                                        endDate = new Date(sd.setDate(sd.getDate() + 1));
                                        if (dataItem.Value === '3da149c1-7cb0-4e39-82b3-8a0aaacfc101') {
