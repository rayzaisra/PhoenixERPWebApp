    .ten-day-before-expired {
        background-color: yellow !important;
    }
    .expired {
        background-color: red !important;
        color: white !important;
    }
</style>*@
<script id="download-template" type="text/x-kendo-template">
    <a href='javascript: void(0);' onclick='downloadGidRow(this)' style="text-decoration:underline;color:blue;">#=FileUploadName#</a>
</script>
<script>
    function dashboard_DataBoundEvent(e) {
        var rows = e.sender.tbody.children();
        for (var j = 0; j < rows.length; j++) {
            var row = $(rows[j]);
            var dataItem = e.sender.dataItem(row);
            var expiredDate = dataItem.ExpiredDate;
            var now = new Date();
            var beforeExpired = new Date();

            now.setHours(0, 0, 0, 0);
            beforeExpired.setDate(beforeExpired.getDate() + 10);
            beforeExpired.setHours(0, 0, 0, 0);
            
            //Cell
            if (expiredDate >= now && expiredDate <= beforeExpired) {
                $(row.find("td[role=gridcell]")[4]).css("background", "yellow");
            } else if (expiredDate < now) {
                $(row.find("td[role=gridcell]")[4]).css("background", "red");
                $(row.find("td[role=gridcell]")[4]).css("color", "white");
            }

            //row.addClass("expired");
            //row.addClass("ten-day-before-expired");
        }
        
        var rowLabel = $(this).find(".row-number");
        if (rowLabel !== undefined) {
            $(rows).each(function () {
                var index = $(this).index() + 1 + (e.sender.dataSource.pageSize() * (e.sender.dataSource.page() - 1));
                var rowLabel = $(this).find(".row-number");
                $(rowLabel).html(index);
            });
        }
    }

    function grid_params() {
        return {
            Category: $("input[name='Category']:checked").val(),
            CounterpartId: $("#CounterpartId").data("kendoDropDownList").value(),
            LegalCategoryId: $("#LegalCategoryId").data("kendoDropDownList").value(),
            LocationId: $("#LocationId").data("kendoDropDownList").value(),
            DivisionId: $("#DivisionId").data("kendoDropDownList").value(),
            ExpiredDate: $("#ExpiredDate").data("kendoDatePicker").value()
        }
    };

    function employee_params() {
        return {
            category: $("input[name='Category']:checked").val(),
            legalCategoryId: $("#LegalCategoryId").val()
        };
    }

    $(document).on("change", "input[type='radio']", function () {
        var category = $(this).val();
        var grid = $("#grid").data("kendoGrid");
        if (category != '@PhoenixERPWebApp.Models.CategoryLegalDoc.Employee') {
            grid.hideColumn("LocationName");
            $("#divLocation").css("display", "none");
            $("#divDivision").css("display", "none");
            $("#LocationId").data("kendoDropDownList").value("-1");
            $("#DivisionId").data("kendoDropDownList").value("-1");
        } else {
            grid.showColumn("LocationName");
            $("#divLocation").css("display", "block");
            $("#divDivision").css("display", "block");            
        }
        $("#CounterpartId").data("kendoDropDownList").dataSource.read();
    });

    $('#btnRetrieve').click(function () {
        $("#grid").data('kendoGrid').dataSource.read();
    });
    
    function downloadGidRow(e) {
        var item = dataItem(e);
        downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download" })', data: { id: item.FileUpload }});
    }

    $("#btnReset").click(function () {
        $('input[name=Category][value=Employee]').prop('checked', 'checked');
        $("#CounterpartId").data("kendoDropDownList").dataSource.read();
        $("#LegalCategoryId").data("kendoDropDownList").dataSource.read();
        $("#grid").data('kendoGrid').dataSource.read();
    });
</script>