                url: '@Url.Action("GetDDLEmployeeBasicInfoMasterCounterPart", "Dropdown",new { area = "hrisnew" })',
                data: { id: $("#LegalCategoryId").val() },
                success: function (result) {
                    var result = parseJson(result);

                    if (result.length !== 0) {
                        if (employeeSelect) {
                            employeeSelect.value(result[0].Value);
                            employeeSelect.text(result[0].Text);
                            employeeSelect.enable(false);
                        };
                    } else {
                         if (employeeSelect) {
                            employeeSelect.value("");
                            employeeSelect.text("Choose a Legal Category First");
                            employeeSelect.enable(false);
                        };
                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    console.log(e)
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
            }, 2e3));
