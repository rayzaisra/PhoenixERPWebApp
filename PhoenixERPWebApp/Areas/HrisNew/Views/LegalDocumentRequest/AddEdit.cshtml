@model PhoenixERPWebApp.Models.LegalDocumentRequest
@{
    ViewData["Title"] = "Document Legal Request";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">HRIS</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="legaldocumentrequest" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Document Legal Request</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="legaldocumentrequest" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="legaldocumentrequest" asp-area="hrisnew" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div>
                                <h3 class="m-portlet__head-text m--font-success">Document Legal Request</h3>
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formLegalDocumentRequest" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="legaldocumentrequest" asp-area="HrisNew">
                        <div class="row ">
                            <div class="col-lg-12">
                                @*<input type="hidden" asp-for="Id" />*@
                                <input type="hidden" asp-for="CreatedBy" />
                                <input type="hidden" asp-for="CreatedOn" />
                                <input type="hidden" asp-for="ModifiedBy" />
                                <input type="hidden" asp-for="ModifiedOn" />
                                <input type="hidden" asp-for="ApprovedBy" />
                                <input type="hidden" asp-for="ApprovedOn" />
                                <input type="hidden" asp-for="IsActive" />
                                <input type="hidden" asp-for="IsLocked" />
                                <input type="hidden" asp-for="IsDefault" />
                                <input type="hidden" asp-for="IsDeleted" />
                                <input type="hidden" asp-for="OwnerId" />
                                <input type="hidden" asp-for="DeletedBy" />
                                <input type="hidden" asp-for="DeletedOn" />
                                <input type="hidden" asp-for="BusinessUnitDivisionId" />
                                <input type="hidden" asp-for="BusinessUnitDepartementId" />
                                <input type="hidden" asp-for="SubmitUser" />

                                <div class="form-group m-form__group-sub">
                                    <label asp-for="Id"></label> <span class="req">*</span>  :
                                    @Html.Kendo().TextBoxFor(m => m.Id).HtmlAttributes(new
                                    {
                                        style = "width:100%",
                                        @readonly = "readonly",
                                        placeholder = "Auto Generated",
                                    })
                                </div>

                                <div class="form-group m-form__group-sub">
                                    <label asp-for="LegalCategoryId"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().DropDownListFor(x => x.LegalCategoryId)
                                       .DataTextField("Text")
                                       .DataValueField("Value")
                                       .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.LegalCategoryId)}")
                                       .HtmlAttributes(new
                                               {
                                           style = "width:100%;",
                                           required = "required",
                                           validationmessage = $"{Html.DisplayNameFor(m => m.LegalCategoryId)} is required"
                                       })
                                       .Events(ev => ev.Select("employeeInfoSelectEvent"))
                                       .Filter(FilterType.Contains)
                                       .DataSource(source => source
                                           .Read(read =>
                                           {
                                               read.Action("GetDDLLegalCategory", "Dropdown", new { area = "hrisnew" });
                                            }))

                                    )
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="EmployeeBasicInfoId"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().DropDownListFor(m => m.EmployeeBasicInfoId)
                                           .DataTextField("Text")
                                           .DataValueField("Value")
                                           .HtmlAttributes(new
                                                   {
                                               style = "width:100%;",
                                               required = "required",
                                               validationmessage = $"{Html.DisplayNameFor(m => m.EmployeeBasicInfoId)} is required"
                                           })
                                           .Filter(FilterType.Contains))

                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="DueDate"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().DatePickerFor(m => m.DueDate)
                                          .Format("dd MMMM yyyy")
                                          .HtmlAttributes(new
                                                  {
                                              style = "width: 100%",
                                              onkeydown = "javascript:return false;",
                                              placeholder = $"Input type a {Html.DisplayNameFor(m => m.DueDate)}",
                                              required = "required",
                                              validationmessage = $"{Html.DisplayNameFor(m => m.DueDate)} is required"

                                          })
                                    )
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="Remarks"></label> <span class="req">*</span>  :
                                    @(Html.TextAreaFor(m => m.Remarks, new
                                        {
                                            style = "width:100%; height:100px;",
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.Remarks)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.Remarks)} is required"
                                        }
                                     ))
                                </div>

                                @if (Model.Status == PhoenixERPWebApp.Models.StatusTransaction.Approved)
                                {
                                    <div class="form-group m-form__group-sub">
                                        <label asp-for="LegalDocFile"></label> <span class="req">*</span> :
                                        <div id="divLegalFile"></div>
                                        <div style="width:100%">
                                            <input type="hidden" asp-for="LegalDocFile" />
                                            <a href='javascript: void(0);' id="linkLegalDownloadFile" onclick='downloadLegalFile()'></a> &nbsp;
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="pull-right">
                                    @if (Model.SubmitUser != true)
                                    {
                                        <button type="button" id="btnSave" class="btn btn-success edit"><span class="fa fa-save"></span> Save</button>
                                        <button type="button" id="btnSubmit" class="btn btn-primary edit"><span class="fa fa-paper-plane"></span> Submit</button>
                                    }
                                    <a asp-action="index" asp-controller="legaldocumentrequest" asp-area="hrisnew" class="fakelink btn btn-secondary"><span class="fa fa-arrow-circle-left"></span> Cancel</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
      $(document).ready(function () {
          if ('@Model.SubmitUser' == "True") {
             $("#LegalCategoryId").data("kendoDropDownList").readonly();
             $("#EmployeeBasicInfoId").data("kendoDropDownList").readonly();
             $("#DueDate").data("kendoDatePicker").readonly();
             $("#Remarks").attr("readonly", "readonly");
          }

          if ("@Model.Status" == "@PhoenixERPWebApp.Models.StatusTransaction.Approved") {
              var LegalDocFileName = '@Model.LegalDocFileName';
              if (LegalDocFileName == '') {
                  LegalFile();
              } else {
                  $("#linkLegalDownloadFile").text(LegalDocFileName);
              }
          }


          if ("@Model.LegalCategoryId" !== "") {
               var employeeSelect = $('#EmployeeBasicInfoId').data("kendoDropDownList");
              $.ajax({
                type: "GET",
                dataType: "json",
                contentType: "application/x-www-form-urlencoded",
                async: false, 
                url: '@Url.Action("GetDDLEmployeeBasicInfoMasterCounterPart", "Dropdown",new { area = "hrisnew" })',
                data: { id: "@Model.LegalCategoryId" },
                success: function (result) {
                    var result = parseJson(result);
                    
                    if (result.length !== 0) {
                        if (employeeSelect) {
                            var jsonArray = [{ Value: result[0].Value, Text: result[0].Text }];
                            employeeSelect.setDataSource(jsonArray);
                            employeeSelect.select(0);                       
                            employeeSelect.readonly();
                        };
                    } else {
                        if (employeeSelect) {
                            var jsonArray = [{ Value: "", Text: "Choose a Legal Category First" }];
                            employeeSelect.setDataSource(jsonArray);
                            employeeSelect.select(0);
                            employeeSelect.readonly();
                        };
                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    console.log(e)
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
            }, 2e3));
          }
    });

    $('#btnSubmit').click(function () {
        var employeeSelect = $('#EmployeeBasicInfoId').data("kendoDropDownList");
        if (employeeSelect.value() === '') {
            swal('Warning', "Please fill the Counterpart data first ", 'warning');
            return false;
        }
        callAction({ formId: "formLegalDocumentRequest", title: "submit", type: "POST", url: '@Url.Action("submit", "legaldocumentrequest")' });
    });

    $('#btnSave').click(function () {
        var employeeSelect = $('#EmployeeBasicInfoId').data("kendoDropDownList");
        if (employeeSelect.value() === '') {
            swal('Warning', "Please fill the Counterpart data first ", 'warning');
            return false;
        }
        
        callAction({ formId: "formLegalDocumentRequest", title: "save", type: "POST", url: '@Url.Action("save", "legaldocumentrequest")' });
    });

    function downloadLegalFile() {
        downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download" })', data: { id: $("#LegalDocFile").val() }});
    }

    function params_autocomplete() {
        return {
            id: $("#EmployeeBasicInfoId").val()
        };
    }

