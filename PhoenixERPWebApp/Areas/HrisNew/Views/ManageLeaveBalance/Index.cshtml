<div class="modal fade" id="modalLeaveBalance" role="dialog" aria-labelledby="ModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modallargewidth">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">
                    Form Manage Leave Balance
                </h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="formManageLeaveBalance" class="form-horizontal form-bordered" role="form"  enctype="multipart/form-data">
                    <div class="m-form__group">
                        <div class="row">
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label>Employee Name :</label>
                                    @(Html.Kendo().DropDownListFor(m => m.EmployeeId)
                                        .DataTextField("Text")
                                        .OptionLabel("Select Employee")
                                        .DataValueField("Value")
                                        .Filter(FilterType.Contains)
                                        .Events(evt => evt.Select("Leave_Select"))
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetDDLEmployeeData", "dropdown", new { area = "hrisnew" });
                                            });
                                        })
                                        .HtmlAttributes(new { style = "width:100%;", @class = "form-control form-control-sm" })
                                        )
                                </div>
                            </div>
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label>Leave Request Type : </label>
                                    @(Html.Kendo().DropDownList()
                                        .Name("LeaveRequestTypeIdPopUp")
                                        .Enable(false)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .HtmlAttributes(new { style = "width:100%;", required = "required" })
                                          .Events(evt => evt.Select("LeaveEmployee_Select"))
                                        .Height(400)
                                        .DataSource(source => source
                                            .Custom()
                                            .Transport(transport => transport
                                            .Read(read =>
                                            {
                                                read.Action("GetDDLLeaveRequestTypeByEmployeeId", "Dropdown", new { area = "HrisNew" }).Data("paramsLeaveByEmployeeRequest");
                                            }))
                                            .ServerFiltering(false))
                                    )
                                </div>

                            </div>
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label>Annual Leave :</label>
                                    @Html.Kendo().NumericTextBoxFor(m => m.AnnualLeave).Spinners(false).HtmlAttributes(new { @class = "form-control form-control-sm", @required = "required" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btn-save-detail" onclick="saveLeave()">Submit</button>
                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

