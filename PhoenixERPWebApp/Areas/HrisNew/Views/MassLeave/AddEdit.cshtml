<script>

    var dateholidays = [];
    $(document).ready(function () {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetHolidays", "leave")',
            success: function (result) {

                $.each(result, function (x, r) {
                    dateholidays.push(new Date(r.Date));
                })

                mApp.unblock("#m_blockui_list");
            },
            error: function (e, t, s) {
                console.log(e)
                mApp.unblock("#m_blockui_list");
            }
        }).then(setTimeout(function () {
            mApp.unblock("#m_blockui_list");
        }, 2e3));

        if ('@Model.Status' != '') {
            if ('@Model.IsApprove' == "True" || !('@Model.Status' == '@PhoenixERPWebApp.Models.StatusTransaction.Draft')) {// || '@Model.Status' == '@PhoenixERPWebApp.Models.StatusTransaction.Rejected')) {
                console.log('@Model.Status')
                $('.k-editor-toolbar').hide();
                $($("#Reason").data().kendoEditor.body).attr("contentEditable", false);
                $($("#Reason").data().kendoEditor.body).css("background-color", "#F8F9FA");

             
                $("#divsearch").hide();
                $("#btnSelectAll").prop('disabled', true);
                $("#LeaveTo").data("kendoDatePicker").enable(false);
                $("#LeaveFrom").data("kendoDatePicker").enable(false);
                var grid = $("#grid").data("kendoGrid");
                grid.hideColumn(0);
            }
        }
    });


    function disableDates(date) {


        //var dates = [
        //    new Date("1/1/2019"),
        //    new Date("1/21/2019"),
        //    new Date("2/18/2019"),
        //    new Date("5/27/2019"),
        //    new Date("7/4/2019"),
        //    new Date("9/2/2019"),
        //    new Date("10/14/2019"),
        //    new Date("11/11/2019"),
        //    new Date("11/28/2019"),
        //    new Date("6/24/2021")
        //];
        var dates = dateholidays;

        if (date) {
            var day = date.getDay();
            var isWeekend = (day === 6) || (day === 0);

            if (isWeekend || compareDates(date, dates)) {
                return true;
            } else {
                return false;
            }
        }
    }

    function compareDates(date, dates) {
        for (var i = 0; i < dates.length; i++) {
            if (dates[i].getDate() == date.getDate() &&
                dates[i].getMonth() == date.getMonth() &&
                dates[i].getYear() == date.getYear()) {
                return true
            }
        }
    }

    $('#btnShow').click(function () {
        $("#RemarkRejected").attr("required", "required");
        $('#modalRemark').modal('show');
    });

    $('#btnApprove').click(function () {
        $("#RemarkRejected").removeAttr("required", "required");
        callAction({ formId: "formLeave", title: "approve", type: "POST", url: '@Url.Action("approve", "massleave")', objects: data() });
    });

    $('#btnReject').click(function () {
        callAction({ formId: "formLeave", title: "reject", type: "POST", url: '@Url.Action("reject", "massleave")', objects: data() });
    });

    $('#btnSubmit').click(function () {
        //if (!isValid()) return;
        callAction({ formId: "formLeave", title: "submit", type: "POST", url: '@Url.Action("submit", "massleave")', objects: data() });
    });

    $('#btnSave').click(function () {
        //if (!isValid()) return;
    	callAction({ formId: "formLeave", title: "save", type: "POST", url: '@Url.Action("save", "massleave")', objects: data() });
    });


    function isValid() {
        var valid = $("#formLeave").validate().form();
        if (valid) {

            var taskList = $("#grid").data("kendoGrid").dataSource.data();
            if (taskList.length == 0) {
                swal('Warning', "Please input excepted employee", 'warning');
                return false;
            }

            return true;
        } else {
            return false;
        }
    }

    function data() {
    	var gridDtl = $("#grid").data("kendoGrid");
    	var jmlData = gridDtl.dataSource.total();
    	if (jmlData > 0)
    		return { MassLeaveDetails: $("#grid").data("kendoGrid").dataSource.data() }
    	else
    		return undefined;
    }

    function startDateChange() {
        TotalDays();
    }

    function endDateChange() {
        TotalDays();
    }



    function TotalDays() {
        var startDate = $("#LeaveFrom").data("kendoDatePicker").value();
        var endDate = $("#LeaveTo").data("kendoDatePicker").value();

        if (startDate !== null && endDate !== null) {
            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $.ajax({
            type: "GET",
            url: '@Url.Action("CalculateWorkingDays", "leave")',
            data: { startDate: startDate.toISOString(), endDate: endDate.toISOString()},
            success: function (result) {
                if (result != undefined) {
                    $("#TotalDays").data("kendoNumericTextBox").value(result);
                }
                mApp.unblock("#m_blockui_list");
            },
            error: function (e, t, s) {
                console.log(e)
                mApp.unblock("#m_blockui_list");
            }
        }).then(setTimeout(function () {
            mApp.unblock("#m_blockui_list");
            }, 2e3));
        }

    }
</script>