@model PhoenixERPWebApp.Models.MassLeave
@{
    if (Model.IsApprove == true)
    {
        ViewData["Title"] = "Mass Leave Request Form Approval";
    }
    else
    {
        ViewData["Title"] = "Mass Leave Request Form";
    }
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";

    DateTime? LeaveFrom = DateTime.Now;
    DateTime? LeaveTo = DateTime.Now;
    if (!string.IsNullOrEmpty(Model.Id))
    {
        if (LeaveFrom >= Model.LeaveFrom)
        {
            LeaveFrom = Model.LeaveFrom;
        }

        if (LeaveTo >= Model.LeaveTo)
        {
            LeaveTo = Model.LeaveTo;
        }
    }
}
<style>
    .k-calendar .k-weekend {
        color: red;
    }

    .k-calendar .k-state-disabled {
        color: red;
    }
</style>
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">HRIS</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (Model.IsApprove == true)
                    {
                        <a asp-action="indexapproval" asp-controller="massleave" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Mass Leave Request Form Approval</span></a>
                    }
                    else
                    {
                        <a asp-action="index" asp-controller="massleave" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Mass Leave Request Form</span></a>
                    }
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (Model.IsApprove == true)
                    {
                        <a asp-action="addedit" asp-controller="massleave" asp-area="hrisnew" asp-route-Id="@Model.Id" asp-route-isApprove="true" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="massleave" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="massleave" asp-area="hrisnew" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
