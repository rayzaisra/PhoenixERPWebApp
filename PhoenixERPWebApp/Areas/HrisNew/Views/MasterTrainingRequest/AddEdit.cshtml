@model PhoenixERPWebApp.Models.MasterTrainingRequest
@{
	ViewData["Title"] = "Master Training Request";
	Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
	<div class="d-flex align-items-center">
		<div class="mr-auto">
			<h3 class="m-subheader__title m-subheader__title--separator">Master Training Request</h3>
			<ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
				<li class="m-nav__item m-nav__item--home">
					<a href="javascript:return;" class="m-nav__link m-nav__link--icon">
						<i class="m-nav__link-icon fa fa-cog fa-fw"></i>
					</a>
				</li>
				<li class="m-nav__item">
					<a href="javascript:return;" class="m-nav__link">
						<span class="m-nav__link-text">Master Data</span>
					</a>
				</li>
				<li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
				<li class="m-nav__item">
					<a asp-action="index" asp-controller="mastertrainingrequest" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Master Training Request</span></a>
				</li>
				<li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
				<li class="m-nav__item">
					@if (string.IsNullOrEmpty(Model.Id))
					{
						<a asp-action="addedit" asp-controller="mastertrainingrequest" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
					}
					else
					{
						<a asp-action="addedit" asp-controller="mastertrainingrequest" asp-area="hrisnew" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
					}
				</li>
			</ul>
		</div>
	</div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
	<div class="row">
		<div class="col-md-12">
			<div class="m-portlet m-portlet--head-sm" m-portlet="true">
				<div class="m-portlet__head">
					<div class="m-portlet__head-caption">
						<div class="m-portlet__head-title">
							<div>
								@ViewBag.Header
							</div>
						</div>
					</div>
					<div class="m-portlet__head-tools">
						<div class="btn-group" role="group">
							<div class="col-lg-12">
								<form id="form-search-dt_basic_eui">
									<div class="input-group input-group-sm">

									</div>
								</form>
							</div>
						</div>
						<ul class="m-portlet__nav">
							<li class="m-portlet__nav-item">
								<a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
								<div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
							</li>
						</ul>
					</div>
				</div>
				<div class="m-portlet__body" id="m_blockui_list">
					<form id="formMasterTrainingRequest" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="mastertrainingrequest" asp-area="HrisNew">
						@*enctype="multipart/form-data"*@
						<div class="row ">
							<div class="col-lg-12">
								<input type="hidden" asp-for="Id" />

								<div class="form-group m-form__group-sub">
									<label asp-for="RequestName"></label> <span class="req">*</span>  :
									@(Html.Kendo().TextBoxFor(m => m.RequestName)
										.HtmlAttributes(new
										{
											style = "width:100%",
											maxlength = 200,
											placeholder = $"Input type a {Html.DisplayNameFor(m => m.RequestName)}",
											required = "required",
											validationmessage = $"{Html.DisplayNameFor(m => m.RequestName)} is required"
										}
									))
								</div>
								<div class="form-group m-form__group-sub">
									<label asp-for="Responsibility"></label> <span class="req">*</span>  :
									@(Html.Kendo().DropDownListFor(m => m.Responsibility)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        //.Events(e => e.Change("change"))
                                        .BindTo(new List<SelectListItem>() {
                                          new SelectListItem() {
                                              Text = "Training",
                                              Value = "Training"
                                          },
                                          new SelectListItem() {
                                              Text = "Procurement",
                                              Value = "Procurement"
                                          },
                                          new SelectListItem() {
                                              Text = "Ga",
                                              Value = "Ga"
                                          }
                                        })
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%",
                                            maxlength = 15,
                                            placeholder = $"Input type a {Html.DisplayNameFor(m => m.Responsibility)}",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.Responsibility)} is required"
                                        })
									)									
								</div>
								<div class="form-group m-form__group-sub">
									<label asp-for="IsDate"></label>:
									<ul class="fieldlist">
										<li>
											@(Html.Kendo().RadioButton().Name("rbYes").Checked(true).HtmlAttributes(new { @name = "IsDate" }).Label("Yes").Value("True"))
										</li>
										<li>
											@(Html.Kendo().RadioButton().Name("rbNo").HtmlAttributes(new { @name = "IsDate" }).Label("No").Value("False"))
										</li>
									</ul>
								</div>
							</div>
						</div>
						<hr />
						<div class="row">
							<div class="col-lg-12">
								<button type="button" id="btn-save" class="btn btn-primary">Save</button>
								<a asp-action="index" asp-controller="mastertrainingrequest" asp-area="hrisnew" class="fakelink btn btn-secondary">Close</a>
							</div>

						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
<script>
    $('#btn-save').click(function () {
        callAction({ formId:"formMasterTrainingRequest", title: "save", type:"POST"});
    });
</script>
<style>
	.fieldlist {
		margin: 0 0 -1em;
		padding: 0;
	}

		.fieldlist li {
			list-style: none;
			padding-bottom: 1em;
		}
</style>