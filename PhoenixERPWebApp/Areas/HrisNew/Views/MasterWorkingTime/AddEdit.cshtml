@model PhoenixERPWebApp.Models.MasterWorkingTime
@{
    ViewData["Title"] = "Master Working Time";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<style>
	.fieldlist {
		margin: 0 0 -1em;
		padding: 0;
	}

		.fieldlist li {
			list-style: none;
			padding-bottom: 1em;
		}
</style>
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Master Working Time</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Master Data</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="masterworkingtime" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Master Working Time</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                     @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="masterworkingtime" asp-area="hrisnew"  class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="masterworkingtime" asp-area="hrisnew"  asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div>
                                @ViewBag.Header
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formMasterWorkingTime" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="masterworkingtime" asp-area="HrisNew">
                        @*enctype="multipart/form-data"*@
                        <div class="row ">
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" asp-for="CreatedBy" />
                                <input type="hidden" asp-for="CreatedOn" />
                                <input type="hidden" asp-for="ModifiedBy" />
                                <input type="hidden" asp-for="ModifiedOn" />
                                <input type="hidden" asp-for="ApprovedBy" />
                                <input type="hidden" asp-for="ApprovedOn" />
                                <input type="hidden" asp-for="IsActive" />
                                <input type="hidden" asp-for="IsLocked" />
                                <input type="hidden" asp-for="IsDefault" />
                                <input type="hidden" asp-for="IsDeleted" />
                                <input type="hidden" asp-for="OwnerId" />
                                <input type="hidden" asp-for="DeletedBy" />
                                <input type="hidden" asp-for="DeletedOn" />
                                <input type="hidden" asp-for="BusinessUnitDivisionId" />
                                <input type="hidden" asp-for="BusinessUnitDepartementId" />
   
								<div class="col-md-6">
									<div class="form-group">
										<label asp-for="Name"></label> <span class="req">*</span>  :
										@(Html.Kendo().TextBoxFor(m => m.Name)
											.HtmlAttributes(new{
												style = "width:100%",
												maxlength = 50,
												placeholder = $"Input type a {Html.DisplayNameFor(m => m.Name)}",
												required = "required",
												validationmessage = $"{Html.DisplayNameFor(m => m.Name)} is required"}
											))
									</div>
									<div class="form-group">
										<label asp-for="TimeIn"></label> <span class="req">*</span>  :
										@(Html.Kendo().TimePickerFor(m => m.TimeIn)
											.Format("{0:HH:mm}")
											.HtmlAttributes(new
											{
												style = "width:100%",
												placeholder = $"Input type a {Html.DisplayNameFor(m => m.TimeIn)}",
												required = "required",
												validationmessage = $"{Html.DisplayNameFor(m => m.TimeIn)} is required",
												onkeydown = "javascript:return false;"
											}
											))
									</div>
								</div>
								<div class="col-md-6">
									<div class="form-group ">
										<label asp-for="IsDefault"></label> <span class="req">*</span>  :<br />
										@(Html.Kendo().RadioButtonFor(x => x.IsDefault).Value(true).Label("Yes"))<label>&nbsp;&nbsp;</label>
										@(Html.Kendo().RadioButtonFor(x => x.IsDefault).Value(false).Label("No"))
									</div>
									<div class="form-group">
										<label asp-for="TimeOut"></label> <span class="req">*</span>  :
										@(Html.Kendo().TimePickerFor(m => m.TimeOut)
											.Format("{0:HH:mm}")
											.HtmlAttributes(new
											{
												style = "width:100%",
												placeholder = $"Input type a {Html.DisplayNameFor(m => m.TimeOut)}",
												required = "required",
												validationmessage = $"{Html.DisplayNameFor(m => m.TimeOut)} is required",
												onkeydown = "javascript:return false;"
											}
											))
									</div>
								</div>
                            
							<div class="col-md-12">
								<span>Working Day :</span><hr />
									<ul class="fieldlist">									
										<li>
											@(Html.Kendo().CheckBoxFor(x => x.IsMonday).Label("Monday"))
										</li>
										<li>
											@(Html.Kendo().CheckBoxFor(x => x.IsTuesday).Label("Tuesday"))
										</li>
										<li>
											@(Html.Kendo().CheckBoxFor(x => x.IsWednesday).Label("Wednesday"))
										</li>
										<li>
											@(Html.Kendo().CheckBoxFor(x => x.IsThursday).Label("Thursday"))
										</li>
										<li>
											@(Html.Kendo().CheckBoxFor(x => x.IsFriday).Label("Friday"))
										</li>
										<li>
											@(Html.Kendo().CheckBoxFor(x => x.IsSaturday).Label("Saturday"))
										</li>
										<li>
											@(Html.Kendo().CheckBoxFor(x => x.IsSunday).Label("Sunday"))
										</li>
									</ul>
							</div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                                <a asp-action="index" asp-controller="masterworkingtime" asp-area="hrisnew" class="fakelink btn btn-secondary">Close</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
	$(document).ready(function () {
		$("#formMasterWorkingTime :checkbox").click(function () {
			if ($(this).is(':checked')) {
				var namaCtrl = $(this).attr("name");
				$('input[name="' + namaCtrl + '"]').val('true');
			}
			//alert($(this).is(':checked'));
		});
	});
    $('#btn-save').click(function () {
        callAction({ formId:"formMasterWorkingTime", title: "save", type:"POST"});
    });
</script>