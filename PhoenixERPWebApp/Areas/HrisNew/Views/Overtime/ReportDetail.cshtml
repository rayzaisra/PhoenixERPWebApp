@model PhoenixERPWebApp.Models.OvertimeReportDetail
@{
    ViewData["Title"] = "Overtime Report Detail";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">HRIS</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="report" asp-controller="overtime" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Overtime Report</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="ReportDetail" asp-controller="overtime" asp-area="hrisnew" asp-route-Id="@Model.Header.Id" class="m-nav__link"><span class="m-nav__link-text"> Detail</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">Overtime Report Detail</h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formOvertimeReport" class="form-horizontal form-bordered" role="form">

                        <br />
                        <div class="row">
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label asp-for="Header.EmployeeBasicInfoId"></label> :
                                    @(Html.Kendo().TextBoxFor(m => m.Header.EmployeeBasicInfoId)
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%",
                                            @readonly = "readonly",
                                            @class = "form-control form-control-sm m-input",
                                        }))
                                </div>
                            </div>

                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label asp-for="Header.LegalEntityName"></label> :
                                    @(Html.Kendo().TextBoxFor(m => m.Header.LegalEntityName)
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%",
                                            @readonly = "readonly",
                                            @class = "form-control form-control-sm m-input",
                                        }))
                                </div>
                            </div>

                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label asp-for="Header.JobGradeName"></label> :
                                    @(Html.Kendo().TextBoxFor(m => m.Header.JobGradeName)
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%",
                                            @readonly = "readonly",
                                            @class = "form-control form-control-sm m-input",
                                        }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label asp-for="Header.EmployeeName"></label> :
                                    @(Html.Kendo().TextBoxFor(m => m.Header.EmployeeName)
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%",
                                            @readonly = "readonly",
                                            @class = "form-control form-control-sm m-input",
                                        }))
                                </div>
                            </div>

                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label asp-for="Header.JobTitleName"></label> :
                                    @(Html.Kendo().TextBoxFor(m => m.Header.JobTitleName)
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%",
                                            @readonly = "readonly",
                                            @class = "form-control form-control-sm m-input",
                                        }))
                                </div>
                            </div>

                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label asp-for="Header.TotalOvertime"></label> :
                                    @(Html.Kendo().TextBoxFor(m => m.Header.TotalOvertime)
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%",
                                            @readonly = "readonly",
                                            @class = "form-control form-control-sm m-input",
                                        }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label asp-for="Header.CDO"></label> :
                                    @(Html.Kendo().TextBoxFor(m => m.Header.CDO)
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%;text-align:right",
                                            @readonly = "readonly",
                                            @class = "form-control form-control-sm m-input",
                                        }))
                                </div>
                            </div>

                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label asp-for="Header.BalanceCDO"></label> :
                                    @(Html.Kendo().TextBoxFor(m => m.Header.BalanceCDO)
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%;text-align:right",
                                            @readonly = "readonly",
                                            @class = "form-control form-control-sm m-input",
                                        }))
                                </div>
                            </div>

                            <div class="col-lg-3 m-form__group-sub">
                                <div class="form-group">
                                    <label asp-for="Header.Year"></label> :
                                    @(Html.Kendo().TextBoxFor(m => m.Header.Year)
                                        .HtmlAttributes(new
                                        {
                                            style = "width:100%;text-align:right",
                                            @readonly = "readonly",
                                            @class = "form-control form-control-sm m-input",
                                        }))
                                </div>
                            </div>
                        </div>
                        <br />
                        <div id="divReportDetail">
                            @(Html.Kendo().Grid(Model.Detail)
                        .Name("grid")
                        .Columns(columns =>
                        {

                            columns.Bound(p => p.OvertimeId).Width(200);
                            columns.Bound(p => p.OvertimeDate).Width(200);
                            columns.Bound(p => p.HoursDurationString).Width(200);
                            columns.Bound(p => p.UserApprovalName).Width(200);
                            columns.Bound(p => p.ApprovedDate).Width(200);
                        })
                        .NoRecords()
                        .Pageable(pageable => pageable
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
                        .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                             .ToolBar(tools => tools.Excel())
                         .Excel(excel => excel
                                    .FileName("Overtime Report.xlsx")
                                    .Filterable(true)
                                    .AllPages(true)
                                    .ProxyURL(Url.Action("Excel_Export_Save", "Attendance"))
                                )
                        .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                            .Extra(false)
                            .Operators(operators => operators
                            .ForString(str => str.Clear()
                                .Contains("Contains")
                                .StartsWith("Start sWith")
                                .EndsWith("End sWith")
                            )))
                        .Scrollable(s => s.Enabled(true).Height("auto"))
                        .Resizable(rsz => rsz.Columns(true))
                        .DataSource(dataSource => dataSource
                           .Ajax()
                           .PageSize(20)
                           .ServerOperation(false)
                        )
                        .Events(e => e.DataBound("dataBoundEvent"))
                        )
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
