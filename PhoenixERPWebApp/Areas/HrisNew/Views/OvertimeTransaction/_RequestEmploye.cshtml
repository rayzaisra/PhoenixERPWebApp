                    @class = "form-control form-control-sm m-input",
                }))
        </div>
    </div>
    <div class="col-lg-4 m-form__group-sub">
        <div class="form-group">
            <label asp-for="requestEmployee.Grade"></label> :
            @(Html.Kendo().TextBoxFor(m => m.requestEmployee.Grade)
                .HtmlAttributes(new
                {
                    style = "width:100%",
                    @readonly = "readonly",
                    @class = "form-control form-control-sm m-input",
                }))
        </div>
    </div>
    <div class="col-lg-4 m-form__group-sub">
        <div class="form-group">
            <label asp-for="StatusDesc"></label> :
            @(Html.Kendo().TextBoxFor(m => m.StatusDesc)
