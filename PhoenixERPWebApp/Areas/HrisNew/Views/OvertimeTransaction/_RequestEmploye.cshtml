@model PhoenixERPWebApp.Models.Overtime

<div class="row">
    <div class="col-lg-4 m-form__group-sub">
        <div class="form-group">
            <label asp-for="RequestCode"></label> :
            @(Html.Kendo().TextBoxFor(m => m.RequestCode)
                .HtmlAttributes(new
                {
                    style = "width:100%",
                    @readonly = "readonly",
                    @class = "form-control form-control-sm m-input",
                    placeholder = $"Auto generated by system"
                }))
        </div>
    </div>
    <div class="col-lg-4 m-form__group-sub">
        <div class="form-group">
            <label asp-for="RequestDate"></label> :
            @(Html.Kendo().DatePickerFor(m => m.RequestDate)
                .Format("dd MMM yyyy")
                .HtmlAttributes(new
                {
                    style = "width:100%",
                    @readonly = "readonly",
                    @class = "form-control form-control-sm m-input",
                })
            )
        </div>
    </div>
    
    <div class="col-lg-4 m-form__group-sub">
        <div class="form-group">
            <label>Requestor</label> :
            @(Html.Kendo().TextBoxFor(m => m.requestEmployee.EmployeeName)
                .HtmlAttributes(new
                {
                    style = "width:100%",
                    @readonly = "readonly",
                    @class = "form-control form-control-sm m-input",
                }))
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-4 m-form__group-sub">
        <div class="form-group">
            <label>Legal Entity</label> :
