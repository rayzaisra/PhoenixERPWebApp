<script> 
    function grid_params() {
        return {
            PdrObjectiveTargetId: '@Model.Id'
        };
    }
    
    $('#btnSave').click(function () {
        if (!isValid()) return;
        callAction({ formId: "formPdrObjectiveTarget", title: "save", type: "POST", url: '@Url.Action("save", "PdrObjectiveTarget")', objects: result()  });
    });
    
    function isValid() {
        var valid = $("#formPdrObjectiveTarget").validate().form();
        if (valid) { 
            var PdrObjectiveTargetDetail = $("#gridPdrObjectiveTargetDetail").data("kendoGrid").dataSource.data();
            if (PdrObjectiveTargetDetail.length == 0) {
                swal('Warning', "Please input objectives list", 'warning');
                return false;
            }            
            return true;
        } else {
            return false;
        }
    }
    
    function result() { 
        var gridPdrObjectiveTargetDetail = $("#gridPdrObjectiveTargetDetail").data("kendoGrid");         
        gridPdrObjectiveTargetDetail.saveRow(); 

        var dataList = { 
            PdrObjectiveTargetDetails: gridPdrObjectiveTargetDetail.dataSource.data()
        }

        return dataList;
    } 
    
    function savePdrObjectiveTargetDetailEvent(e) { 
        var PdrObjectiveSetting = $("#PdrObjectiveSettingId").data("kendoDropDownList").value();
        var PdrObjectiveSettingItem = $("#PdrObjectiveSettingId").data("kendoDropDownList").text();          
        e.model.set("PdrObjectiveSettingId", PdrObjectiveSetting);
        e.model.set("PdrObjectiveSettingItem", PdrObjectiveSettingItem); 
    }
</script>