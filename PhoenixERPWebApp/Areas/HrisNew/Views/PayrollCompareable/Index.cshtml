@{
    ViewData["Title"] = "Payroll Compareable";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Payroll Compareable</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">HRIS</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="leavebalance" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Payroll Compareable</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                               
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list"> 
                    <div class="row">
                        <div class="col-lg-5">
                            <div class="form-group">
                                <label style="width:15%">Month :</label>
                                @(Html.Kendo().DropDownList()
                                .Name("month")
                                .DataTextField("Text")
                                .DataValueField("Value") 
                                .HtmlAttributes(new { style = "width:80%;" })
                                .Height(400)
                                .Value(DateTime.Now.Month.ToString())
                                .DataSource(source => source
                                    .Custom()
                                    .Transport(transport => transport
                                    .Read(read =>
                                    {
                                        read.Action("GetDDLMonth", "Dropdown", new { area = "HrisNew" });
                                    }))
                                    .ServerFiltering(false))
                                )
                            </div>
                        </div>
                        <div class="col-lg-5">
                                <div class="form-group">
                                    <label style="width:15%">Year :</label>
                                    @(Html.Kendo().DropDownList()
                                    .Name("year")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .HtmlAttributes(new { style = "width:80%;" })
                                    .Height(400)
                                    .Value(DateTime.Now.Year.ToString())
                                    .DataSource(source => source
                                        .Custom()
                                        .Transport(transport => transport
                                        .Read(read =>
                                        {
                                            read.Action("GetDDLYear", "Dropdown", new { area = "HrisNew" });
                                        }))
                                        .ServerFiltering(false))
                                    )
                                </div>
                        </div>
                            <div class="col-lg-2">
                                <div class="form-group">
                                    <button type="button" id="btnSearch" class="btn btn-success edit" style="padding:7px;"><span class="fa fa-filter"></span> Filter</button>
                                </div>
                        </div>
                    </div> 

                    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.PayrollCompareable>()
                        .Name("grid")
                        .Columns(column =>
                        {
                        column.Bound("").Title("#").Width(50).Filterable(false).HtmlAttributes(new { style = "text-align:center;", @class = "row-number" }).HeaderHtmlAttributes(new { style = "text-align:center;" });
                        column.Bound(p => p.NameEmployee).Width(250);
                        column.Group(group => group.Title("Basic Salary")
                            .Columns(location => {
                                location.Bound(p => p.StringCurrentBasicSalary).Width(150).HtmlAttributes(new { style = "text-align:right;" });
                                location.Bound(p => p.StringOneMonthBeforeBasicSalary).Width(150).HtmlAttributes(new { style = "text-align:right;" });
                                location.Bound(p => p.StringTwoMonthBeforeBasicSalary).Width(150).HtmlAttributes(new { style = "text-align:right;" });
                            }));
                        column.Group(group => group.Title("Take Home Pay")
                           .Columns(location =>
                           {
                               location.Bound(p => p.StringCurrentThp).Width(150).HtmlAttributes(new { style = "text-align:right;" });
                               location.Bound(p => p.StringOneMonthBeforeThp).Width(150).HtmlAttributes(new { style = "text-align:right;" });
                               location.Bound(p => p.StringTwoMonthBeforeThp).Width(150).HtmlAttributes(new { style = "text-align:right;" });
                           }));
                        })
                        .NoRecords()
                        .Pageable(pageable => pageable
                            .Refresh(true)
                            .PageSizes(true)
                            .ButtonCount(5))
                        .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                        .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                            .Extra(false)
                            .Operators(operators => operators
                            .ForString(str => str.Clear()
                                .Contains("Contains")
                                .StartsWith("Start sWith")
                                .EndsWith("End sWith")
                            )))
                        .Scrollable(s => s.Enabled(true).Height("auto"))
                        .Resizable(rsz => rsz.Columns(true))
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .PageSize(10)
                            .Events(events => events.Error("errorHandler"))
                            .Model(model => { model.Id(p => p.EmployeeBasicInfoId); })
                            .Read(read => read.Action("Read", "PayrollCompareable").Data("grid_params"))
                        )
                        .Events(e => e.DataBound("dataBoundGridEvent"))
                        .AutoBind(false)
                    )
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        refresh();
    });

    function grid_params(){
        return {
            month: $("#month").val(),
            year: $("#year").val()
        }
    }

    $('#btnSearch').click(function () {
        refresh();
    });

    function refresh() {
        mApp.block("#m_blockui_list", {
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        });

        $('#grid').data('kendoGrid').dataSource.read();
        $('#grid').data('kendoGrid').refresh();

        mApp.unblock("#m_blockui_list");
    }

    var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    function dataBoundGridEvent(e) {
        var month = $("#month").data("kendoDropDownList").value();
        var year = $("#year").data("kendoDropDownList").value();
        
        var current = months[month - 1] + " " + year.toString(); 
        var one = (month == 1 ? months[12 - 1] : months[month - 2]) + " " + (month == 1 ? year - 1 : year).toString();
        var two = (month == 1 ? months[11 - 1] : month == 2 ? months[12 - 1] : months[month - 3]) + " " + ((month == 1 || month == 2 ) ? year - 1 : year).toString();

        $("#grid th[data-field=StringCurrentBasicSalary]").contents().last().replaceWith(current);
        $("#grid th[data-field=StringOneMonthBeforeBasicSalary]").contents().last().replaceWith(one);
        $("#grid th[data-field=StringTwoMonthBeforeBasicSalary]").contents().last().replaceWith(two);

        $("#grid th[data-field=StringCurrentThp]").contents().last().replaceWith(current);
        $("#grid th[data-field=StringOneMonthBeforeThp]").contents().last().replaceWith(one);
        $("#grid th[data-field=StringTwoMonthBeforeThp]").contents().last().replaceWith(two);
        dataBoundEvent(e);
    }
</script>