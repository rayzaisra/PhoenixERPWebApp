@model PhoenixERPWebApp.Models.PdrApprailsalM1Header
@{
    ViewData["Title"] = "M1 Final Score";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<style>
    .middleCenter {
        text-align: center;
        vertical-align: middle;
    }

    .middle {
        vertical-align: middle;
    }

    .top {
        vertical-align: top;
    }

    .td-width {
        width: 150px;
    }

    table {
        margin-bottom: 40px;
        width: 100%;
    }

    td {
        border: 1px solid darkgray;
        padding: 5px;
    }

    .grade {
        border: none;
        width: 20%;
        text-align: center;
        vertical-align: middle;
    }

    .header {
        font-weight: bold;
        color: white;
        text-align: center;
        vertical-align: middle;
    }

    .centerBold {
        font-weight: bold;
        text-align: center;
        vertical-align: middle;
    }
</style>
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">M1 Final Score</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">HRIS</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="PdrM1FinalScoreController" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">M1 Final Score</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">M1 Final Score</h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formPDRApprailsal" class="form-horizontal form-bordered" role="form">
                        <div class="row ">
                            <div class="col-lg-12">

                                <partial name="_AssignEmploye" />
                                <br />

                                <div class="row" id="data_detail">
                                    <div class="col-lg-12 m-row--no-padding">
                                        <div class="m-accordion m-accordion--bordered m-accordion--solid" id="Detail" role="tablist">
                                            <!--begin::Item-->
                                            <div class="m-accordion__item">
                                                <div class="m-accordion__item-head show" role="tab" id="Detail_head" data-toggle="collapse" href="#Detail_body" aria-expanded="true">
                                                    <span class="m-accordion__item-icon"><i class="fa flaticon-interface-4"></i></span>
                                                    <span class="m-accordion__item-title"></span>
                                                    <span class="m-accordion__item-mode"></span>
                                                </div>
                                                <div class="m-accordion__item-body show" id="Detail_body" role="tabpanel" aria-labelledby="Detail_head" data-parent="#Detail">
                                                    <div class="m-accordion__item-content">
                                                        <div class="row" id="divAppraisalM1">
                                                            <div class="col-lg-12 m-form__group-sub">
                                                                <h5 style="margin-bottom:10px">KPI</h5>
                                                            </div>
                                                            <div class="col-lg-12 m-form__group-sub">
                                                                <div class="form-group">
                                                                    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.PdrApprailsalM1>()
                                                                        .Name("gridPdrApprailsalM1")
                                                                        .Columns(columns =>
                                                                        {
                                                                            if (ViewBag.isRequestor == true)
                                                                            {
                                                                                columns.Command(
                                                                                    command =>
                                                                                    {
                                                                                        command.Edit().Text(" ").UpdateText(" ").CancelText(" ");
                                                                                        //command.Destroy().Text(" ");
                                                                                    }).Title("Action").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(90);
                                                                            }
                                                                            columns.Bound(p => p.PdrObjectiveSettingItem).Width(150);
                                                                            columns.Bound(p => p.Target).Width(150);
                                                                            columns.Bound(p => p.Achievement).Width(150);
                                                                            columns.Bound(p => p.Weight).Width(150).EditorTemplateName("HrisNew/PDRApprailsal/Weight").Width(150).ClientFooterTemplate("#=kendo.format('{0:N2}', calculateWeight())#");
                                                                            columns.Bound(p => p.RatingScore).Width(150).EditorTemplateName("HrisNew/PDRApprailsal/Rating").Width(150).ClientFooterTemplate("Total Performance Score");
                                                                            columns.Bound(p => p.WeightedScore).EditorTemplateName("DecimalReadOnly").Width(150).ClientFooterTemplate("#=kendo.format('{0:N2}', calculateWeightedScore())#");
                                                                        })
                                                                        .NoRecords()
                                                                        .Editable(editable => editable.Mode(GridEditMode.InLine).DisplayDeleteConfirmation(false))
                                                                        .Scrollable(s => s.Enabled(true).Height("auto"))
                                                                        .Resizable(rsz => rsz.Columns(true))
                                                                        .DataSource(dataSource => dataSource
                                                                            .Ajax()
                                                                            .PageSize(20)
                                                                            .Events(events => events.Error("errorHandler"))
                                                                            .Model(model =>
                                                                            {
                                                                                model.Id(p => p.Id);
                                                                                model.Field(p => p.PdrObjectiveSettingItem).Editable(false);
                                                                                model.Field(p => p.Target).Editable(false);
                                                                            })
                                                                            .Read(read => read.Action("ReadPdrApprailsalM1", "PdrM1FinalScore").Data("grid_params"))
                                                                        )
                                                                    )
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="row" style="margin-top:20px;">
                                                            <div class="col-lg-12 m-form__group-sub">
                                                                <h5 style="margin-bottom:10px">PDR</h5>
                                                            </div>
                                                            <div class="col-lg-12 m-form__group-sub">
                                                                <div class="form-group">
                                                                    <table id="grid_pdr_performance">
                                                                        <tr style="background-color:#00B0F0;" class="header">
                                                                            <td>SECTION</td>
                                                                            <td>AVERAGE SCORE</td>
                                                                            <td>PERCENTAGE (%)</td>
                                                                            <td>TOTAL SCORE</td>
                                                                        </tr>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-lg-12 m-form__group-sub">
                                                                <h5 style="margin-bottom:10px">Final Score</h5>
                                                            </div>
                                                            <div class="col-lg-6 m-form__group-sub">
                                                                <div class="form-group">
                                                                    <table id="grid_kpi_pdr_final_score">
                                                                        <tr style="background-color:#00B0F0;" class="header">
                                                                            <td width="30px;">No</td>
                                                                            <td width="100px;">Keterangan</td>
                                                                            <td width="100px;">Weight (%)</td>
                                                                            <td>Score</td>
                                                                            <td>Total Score</td>
                                                                        </tr>
                                                                        <tbody>
                                                                            <tr>
                                                                                <td>1</td>
                                                                                <td>KPI</td>
                                                                                <td><label><span id="lbl_weight_kpi_percentage">60</span></label></td>
                                                                                <td><label><span id="lbl_kpi_score"></span></label></td>
                                                                                <td><label><span id="lbl_kpi_total_score"></span></label></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td>2</td>
                                                                                <td>PDR</td>
                                                                                <td><label><span id="lbl_weight_pdr_percentage">40</span></label></td>
                                                                                <td><label><span id="lbl_pdr_score">0</span></label></td>
                                                                                <td><label><span id="lbl_pdr_total_score">0</span></label></td>
                                                                            </tr>
                                                                            <tr>
                                                                                <td colspan="4" align="right">
                                                                                    <label>Overall Score</label> 
                                                                                </td>
                                                                                <td>
                                                                                    <label><span id="lbl_m1_final_score">0</span></label>
                                                                                </td>
                                                                            </tr>
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <hr />

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

     function grid_params() {
        return {
            @*PdrApprailsalM1HeaderId: '@Model.Id',*@
            employeeId: $("#EmployeeId").val(),
            startReview: $("#ReviewStart").val(),
        };
    }


    function weight_change(e) {
        var weight = parseFloat(this.value());
        var rating = $("#RatingScore").data("kendoDropDownList").value();
        if (rating == "") rating = "0";
        var weightScore = (parseFloat(rating) * (weight / 100));
        $("#WeightedScore").data("kendoNumericTextBox").value(weightScore);
    }

    function rating_change(e) {
        var rating = parseFloat(this.value());
        var weight = $("#Weight").data("kendoDropDownList").value(); //$("#Weight").data("kendoNumericTextBox").value();
        if (weight == "") weight = "0";
        var weightScore = (rating * (parseFloat(weight) / 100));
        $("#WeightedScore").data("kendoNumericTextBox").value(weightScore);
    }

    function calculateWeight() {
        var data = $("#gridPdrApprailsalM1").data("kendoGrid").dataSource.data();
        var total = 0;
        for (var i = 0; i < data.length; i++) {
            total += data[i].Weight;
        }
        return total;
    }

    
    function calculateWeightedScore() {
        var data = $("#gridPdrApprailsalM1").data("kendoGrid").dataSource.data();
        var total = 0;
        for (var i = 0; i < data.length; i++) {
            total += data[i].WeightedScore;
        }

        var totalScoreKPI = (total * 60) / 100;

        $('#lbl_kpi_score').text(total);
        $('#lbl_kpi_total_score').text(totalScoreKPI);

       
        $('#lbl_m1_final_score').text(totalScorePDR + totalScoreKPI);


        return total;
    }

   
</script>