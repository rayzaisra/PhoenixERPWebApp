@model PhoenixERPWebApp.Models.PdrEmployee
@{
    if (Model.IsApprove == true)
    {
        ViewData["Title"] = "PDR Apprisal Form Approval";
    }
    else
    {
        ViewData["Title"] = "PDR Apprisal Form";
    }
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";


    DateTime? EffectivePermanent = DateTime.Now;
    if (!string.IsNullOrEmpty(Model.Id))
    {
        EffectivePermanent = Model.PdrRecomendation.EffectivePermanent;
    }

    int pdrParameter = 0;
    decimal? finalScore = 0;
    decimal? CountParameter = 0;
    decimal? finalScoreIn5 = 0;
}
<style>
    .middleCenter {
        text-align: center;
        vertical-align: middle;
    }

    .middle {
        vertical-align: middle;
    }

    .top {
        vertical-align: top;
    }

    .td-width {
        width: 150px;
    }

    table {
        margin-bottom: 40px;
        width: 100%;
    }

    td {
        border: 1px solid darkgray;
        padding: 5px;
    }

    .grade {
        border: none;
        width: 20%;
        text-align: center;
        vertical-align: middle;
    }

    .header {
        font-weight: bold;
        color: white;
        text-align: center;
        vertical-align: middle;
    }

    .centerBold {
        font-weight: bold;
        text-align: center;
        vertical-align: middle;
    }
</style>
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">HRIS</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (Model.IsApprove == true)
                    {
                        <a asp-action="indexapproval" asp-controller="pdrperformance" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">PDR Apprisal Approval</span></a>
                    }
                    else
                    {
                        <a asp-action="index" asp-controller="pdrperformance" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">PDR Apprisal Appraisal</span></a>
                    }
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (Model.IsApprove == true)
                    {
                        <a asp-action="addedit" asp-controller="pdrperformance" asp-area="hrisnew" asp-route-Id="@Model.Id" asp-route-isApprove="true" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="pdrperformance" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="pdrperformance" asp-area="hrisnew" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">PDR Apprisal Form</h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formpdrperformance" class="form-horizontal form-bordered" role="form">
                        <div class="row ">
                            <div class="col-lg-12">
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" asp-for="CreatedBy" />
                                <input type="hidden" asp-for="CreatedOn" />
                                <input type="hidden" asp-for="ModifiedBy" />
                                <input type="hidden" asp-for="ModifiedOn" />
                                <input type="hidden" asp-for="ApprovedBy" />
                                <input type="hidden" asp-for="ApprovedOn" />
                                <input type="hidden" asp-for="IsActive" />
                                <input type="hidden" asp-for="IsLocked" />
                                <input type="hidden" asp-for="IsDefault" />
                                <input type="hidden" asp-for="IsDeleted" />
                                <input type="hidden" asp-for="OwnerId" />
                                <input type="hidden" asp-for="DeletedBy" />
                                <input type="hidden" asp-for="DeletedOn" />
                                <input type="hidden" asp-for="BusinessUnitDivisionId" />
                                <input type="hidden" asp-for="BusinessUnitDepartementId" />
                                <input type="hidden" asp-for="FinalScore" />
                                <input type="hidden" asp-for="Grade" />
                                <input type="hidden" asp-for="JobGradeId" />
                                <input type="hidden" asp-for="PdrRecomendation.Type" />
                                <input type="hidden" asp-for="PdrRecomendation.Id" />
                                <input type="hidden" asp-for="DateSubmit" />
                                <input type="hidden" asp-for="DateAppraisal" />
                                <input type="hidden" asp-for="Year" />
                                <input type="hidden" asp-for="FileResult" />
                                <input type="hidden" asp-for="SalaryIncrease" /> 

                                <partial name="_AssignEmploye" />
                                <br/>
                                
                                <div class="row" id="data_detail">
                                    <div class="col-lg-12 m-row--no-padding">
                                        <div class="m-accordion m-accordion--bordered m-accordion--solid" id="Detail" role="tablist">
                                            <!--begin::Item-->
                                            <div class="m-accordion__item">
                                                <div class="m-accordion__item-head show" role="tab" id="Detail_head" data-toggle="collapse" href="#Detail_body" aria-expanded="true">
                                                    <span class="m-accordion__item-icon"><i class="fa flaticon-interface-4"></i></span>
                                                    <span class="m-accordion__item-title">Request Detail</span>
                                                    <span class="m-accordion__item-mode"></span>
                                                </div>
                                                <div class="m-accordion__item-body show" id="Detail_body" role="tabpanel" aria-labelledby="Detail_head" data-parent="#Detail">
                                                    <div class="m-accordion__item-content">
                            
                                                        <div class="row">
                                                            <div class="col-lg-3 m-form__group-sub">
                                                                <div class="form-group">
                                                                    <label asp-for="ReviewStart"></label> <span class="req">*</span>  :
                                                                    @(Html.Kendo().DatePickerFor(m => m.ReviewStart)
                                                                        .Format("dd MMMM yyyy")
                                                                        .HtmlAttributes(new
                                                                        {
                                                                            style = "width: 100%",
                                                                            onkeydown = "javascript:return false;",
                                                                            //placeholder = $"Input type a {Html.DisplayNameFor(m => m.ReviewStart)}",
                                                                            required = "required",
                                                                            validationmessage = $"{Html.DisplayNameFor(m => m.ReviewStart)} is required"
                                                                        })
                                                                    )
                                                                </div>
                                                            </div>
                                                            <div class="col-lg-3 m-form__group-sub">
                                                                <div class="form-group">
                                                                    <label asp-for="ReviewEnd"></label> <span class="req">*</span>  :
                                                                    @(Html.Kendo().DatePickerFor(m => m.ReviewEnd)
                                                                        .Format("dd MMMM yyyy")
                                                                        .HtmlAttributes(new
                                                                        {
                                                                            style = "width: 100%",
                                                                            onkeydown = "javascript:return false;",
                                                                            //placeholder = $"Input type a {Html.DisplayNameFor(m => m.ReviewEnd)}",
                                                                            required = "required",
                                                                            validationmessage = $"{Html.DisplayNameFor(m => m.ReviewEnd)} is required"
                                                                        })
                                                                    )
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row" style="margin-top:20px;">
                                                            <div class="col-lg-12 m-form__group-sub">
                                                                <div class="form-group">
                                                                    @foreach (var item in Model.PdrCategorys.OrderBy(x => x.No))
                                                                    {
                                                                        var result = item.Id+";"+item.PdrParameters.Count();
                                                                        <input type="hidden" id="hdResultPdrParameters_@item.Id" value="@result"/>

                                                                        <h5>@(item.No + ". " + item.Name)</h5>
                                                                        <label style="font-style:normal">@item.Description</label>

                                                                        <div style="margin-left:30px;">
                                                                            @if (item.No == 4)
                                                                            {
                                                                                @Html.TextAreaFor(x => x.Notes, new { style = "width: 100%; height:100px;", placeholder = "input notes here" })
                                                                            }
                                                                            else if (item.No == 5)
                                                                            {
         
                                                                                <div class="row">
                                                                                    <div class="col-lg-6 m-form__group-sub">
                                                                                        <div class="form-group">
                                                                                            <label asp-for="PdrRecomendation.ContractExtended"></label> <span class="req" id="span-extended">*</span> :
                                                                                            @(Html.Kendo().NumericTextBoxFor(m => m.PdrRecomendation.ContractExtended)
                                                                                                .Spinners(false)
                                                                                                .Round(true)
                                                                                                .Format("0 Months")
                                                                                                .Events(evt => evt.Change("contractExtended_change"))
                                                                                                .HtmlAttributes(new
                                                                                                {
                                                                                                    style = "width:100%",
                                                                                                    @class = "form-control form-control-sm m-input",
                                                                                                    required = "required"
                                                                                                }))
                                                                                        </div>
                                                                                    </div>
                                                                                    <div class="col-lg-6 m-form__group-sub">
                                                                                        <div class="form-group">
                                                                                            <label asp-for="PdrRecomendation.Terminated"></label> <span class="req" id="span-terminated">*</span> :
                                                                                            @(Html.Kendo().RadioButtonFor(m => m.PdrRecomendation.Terminated).Label("Yes").Value(true).HtmlAttributes(new { required = "required" }))
                                                                                            @(Html.Kendo().RadioButtonFor(m => m.PdrRecomendation.Terminated).Label("No").Value(false).HtmlAttributes(new { required = "required" }))
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="row">
                                                                                    <div class="col-lg-6 m-form__group-sub">
                                                                                        <div class="form-group">
                                                                                            <label asp-for="PdrRecomendation.EffectivePermanent"></label> <span class="req" id="span-efecctive">*</span> :
                                                                                            @(Html.Kendo().DatePickerFor(m => m.PdrRecomendation.EffectivePermanent)
                                                                                                .Format("dd MMM yyyy")
                                                                                                .Min($"{EffectivePermanent}")
                                                                                                .Events(evt => evt.Change("effectivePermanent_change"))
                                                                                                .HtmlAttributes(new
                                                                                                {
                                                                                                    style = "width:100%",
                                                                                                    @class = "form-control form-control-sm m-input",
                                                                                                    required = "required",
                                                                                                    //placeholder = $"Choose a {Html.DisplayNameFor(m => m.PdrRecomendation.EffectivePermanent)}",
                                                                                                    //onkeydown = "javascript:return false;"
                                                                                                })
                                                                                            )
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            }
                                                                            else if (item.No == 6)
                                                                            {
                                                                                @(Html.Kendo().Grid<PhoenixERPWebApp.Models.PdrDevelopmentPlan>()
                                                                                    .Name("gridPdrDevelopmentPlan")
                                                                                    .ToolBar(toolbar => {
                                                                                        if (ViewBag.isRequestor == true)
                                                                                        {
                                                                                            toolbar.Create();
                                                                                        }
                                                                                    })
                                                                                    .Columns(columns =>
                                                                                    {
                                                                                        if (ViewBag.isRequestor == true)
                                                                                        {
                                                                                            columns.Command(
                                                                                                command =>
                                                                                                {
                                                                                                    command.Edit().Text(" ").UpdateText(" ").CancelText(" ");
                                                                                                    command.Destroy().Text(" ");
                                                                                                }).Title("Action").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(50);
                                                                                        }
                                                                                        columns.Bound(p => p.Activities).Width(150);
                                                                                        columns.Bound(p => p.Quarter).EditorTemplateName("HrisNew/PDRPerformance/Quarter").Width(150);
                                                                                    })
                                                                                    .NoRecords()
                                                                                    .Editable(editable => editable.Mode(GridEditMode.InLine).DisplayDeleteConfirmation(false))
                                                                                    //.Scrollable(s => s.Enabled(true).Height("auto"))
                                                                                    .Resizable(rsz => rsz.Columns(true))
                                                                                    .DataSource(dataSource => dataSource
                                                                                        .Ajax()
                                                                                        .PageSize(20)
                                                                                        .ServerOperation(false)
                                                                                        .Events(events => events.Error("errorHandler"))
                                                                                        .Model(model =>
                                                                                        {
                                                                                            model.Id(p => p.Id);
                                                                                        })
                                                                                        .Read(read => read.Action("ReadPdrDevelopmentPlan", "PdrPerformance").Data("grid_params"))
                                                                                        .Create(create => create.Action("CreatePdrDevelopmentPlan", "PdrPerformance"))
                                                                                        .Update(update => update.Action("UpdatePdrDevelopmentPlan", "PdrPerformance"))
                                                                                        .Destroy(destroy => destroy.Action("DestroyPdrDevelopmentPlan", "PdrPerformance"))
                                                                                    )
                                                                                //.Events(e => e.Save("saveDevelopmentPlanEvent"))
                                                                                )
                                                                            }
                                                                            else if (item.No == 3)
                                                                            {
                                                                                <table>
                                                                                    <tr style="background-color:#00B0F0;" class="header">
                                                                                        <td>SECTION</td>
                                                                                        <td>AVERAGE SCORE</td>
                                                                                        <td>PERCENTAGE (%)</td>
                                                                                        <td>TOTAL SCORE</td>
                                                                                    </tr>
                                                                                    @{ var modelPDRCategory = Model.PdrCategorys.Where(x => x.PdrParameters.Count > 0).OrderBy(x => x.No).ToList();
                                                                                        var poor = Model.PdrGrades.Where(x => x.Id == PhoenixERPWebApp.Models.Grades.Poor).FirstOrDefault();
                                                                                        var fair = Model.PdrGrades.Where(x => x.Id == PhoenixERPWebApp.Models.Grades.Fair).FirstOrDefault();
                                                                                        var good = Model.PdrGrades.Where(x => x.Id == PhoenixERPWebApp.Models.Grades.Good).FirstOrDefault();
                                                                                        var veryGood = Model.PdrGrades.Where(x => x.Id == PhoenixERPWebApp.Models.Grades.VeryGood).FirstOrDefault();
                                                                                        var excellent = Model.PdrGrades.Where(x => x.Id == PhoenixERPWebApp.Models.Grades.Excellent).FirstOrDefault();
                                                                                       
                                                                                    }
                                                                                    @for (int i = 0; i < modelPDRCategory.Count(); i++)
                                                                                    {
                                                                                        var SectionNo = i + 1;

                                                                                        decimal? averageScore = 0;
                                                                                        decimal? percentage = 0;
                                                                                        decimal? total = 0;
                                                                                        if (Model.PdrOverallScores != null)
                                                                                        {
                                                                                            var overallScore = Model.PdrOverallScores.Where(x => x.PdrCategoryId == modelPDRCategory[i].Id).FirstOrDefault();
                                                                                            if (overallScore != null)
                                                                                            {
                                                                                                averageScore = overallScore.AverageScore;
                                                                                                percentage = overallScore.Percentage;
                                                                                                total = overallScore.Total;
                                                                                                finalScore = Model.FinalScore;
                                                                                                CountParameter = Model.PdrDetailM2belows.Where(x => x.PdrEmployeeId == Model.Id).Count();
                                                                                                finalScoreIn5 = (finalScore / CountParameter);
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                percentage = modelPDRCategory[i].Percentage;
                                                                                            }
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            percentage = modelPDRCategory[i].Percentage;
                                                                                        }

                                                                                        if (percentage == null)
                                                                                        {
                                                                                            percentage = ((averageScore / 5) * 100);
                                                                                        }

                                                                                        if ( total == null)
                                                                                        {
                                                                                            total = Model.PdrDetailM2belows.Where(x => x.PdrCategoryId == modelPDRCategory[i].Id).Sum(x=>x.Score);
                                                                                        }


                                                                                        <tr>
                                                                                            <td>Section @SectionNo<br />(@modelPDRCategory[i].Name)</td>
                                                                                            <td style="text-align:center;"><label id="lblAverage_@modelPDRCategory[i].Id">@String.Format("{0:N2}", averageScore)</label></td>
                                                                                            <td style="text-align:center;"><label id="lblPercentage_@modelPDRCategory[i].Id" text="">@String.Format("{0:N2}", percentage)</label></td>
                                                                                            <td class="centerBold"><label id="lblTotal_@modelPDRCategory[i].Id">@String.Format("{0:N2}", total)</label></td>
                                                                                        </tr>
                                                                                    }
                                                                                    @{ 
                                                                                                        if (finalScore == null)
                                                                                                        {
                                                                                                            finalScore = Model.PdrDetailM2belows.Where(x => x.PdrEmployeeId == Model.Id).Sum(x=>x.Score);
                                                                                                            CountParameter = Model.PdrDetailM2belows.Where(x => x.PdrEmployeeId == Model.Id).Count();
                                                                                                            finalScoreIn5 = (finalScore / CountParameter);
                                                                                                        }

                                                                                                    }
                                                                                    <tr>
                                                                                        <td class="centerBold" colspan="3">FINAL SCORE</td>
                                                                                        <td class="centerBold" style="background-color:#EEEEEE;"><label id="lblFinal">@String.Format("{0:N2}", finalScore)</label></td>
                                                                                    </tr>
                                                                                    <tr>
                                                                                        <td class="centerBold" colspan="4">GRADE</td>
                                                                                    </tr>
                                                                                    <tr>
                                                                                        <td colspan="4">
                                                                                            <table style="margin:0;">
                                                                                                <tr style="font-size:20px;">
                                                                                                    <td class="grade"><i class="fa fa-square fa-lg" aria-hidden="true" style="color:#CF2A28"></i> POOR</td>
                                                                                                    <td class="grade"><i class="fa fa-square fa-lg" aria-hidden="true" style="color:#FFE599"></i> FAIR</td>
                                                                                                    <td class="grade"><i class="fa fa-square fa-lg" aria-hidden="true" style="color:#2A78E4"></i> GOOD</td>
                                                                                                    <td class="grade"><i class="fa fa-square fa-lg" aria-hidden="true" style="color:#009E11"></i> VERY GOOD</td>
                                                                                                    <td class="grade"><i class="fa fa-star fa-lg" aria-hidden="true" style="color:#FF9900"></i> EXCELLENT</td>
                                                                                                </tr>
                                                                                                <tr>
                                                                                                    <td class="grade"><small>&lt;=<label id="lblPoor">@String.Format("{0:N2}", poor.EndRange)</label><br />(@poor.Result)</small></td>
                                                                                                    <td class="grade"><small><label id="lblFairStart">@String.Format("{0:N2}", fair.StartRange)</label> - <label id="lblFairEnd">@String.Format("{0:N2}", fair.EndRange)</label><br />(@fair.Result)</small></td>
                                                                                                    <td class="grade"><small><label id="lblGoodStart">@String.Format("{0:N2}", good.StartRange)</label> - <label id="lblGoodEnd">@String.Format("{0:N2}", good.EndRange)</label><br />(@good.Result)</small></td>
                                                                                                    <td class="grade"><small><label id="lblVeryGoodStart">@String.Format("{0:N2}", veryGood.StartRange)</label> - <label id="lblVeryGoodEnd">@String.Format("{0:N2}", veryGood.EndRange)</label><br />(@veryGood.Result)</small></td>
                                                                                                    <td class="grade"><small><label id="lblExcellentStart">@String.Format("{0:N2}", excellent.StartRange)</label> - <label id="lblExcellentEnd">@String.Format("{0:N2}", excellent.EndRange)</label><br />(@excellent.Result)</small></td>
                                                                                                </tr>
                                                                                                <tr>
                                                                                                    @{
                                                                                                        bool isChekedPoor = finalScoreIn5 <= poor.EndRange;
                                                                                                bool isChekedFair = finalScoreIn5 >= fair.StartRange && finalScoreIn5 <= fair.EndRange;
                                                                                                bool isChekedGood = finalScoreIn5 >= good.StartRange && finalScoreIn5 <= good.EndRange;
                                                                                                bool isChekedVeryGood = finalScoreIn5 >= veryGood.StartRange && finalScoreIn5 <= veryGood.EndRange;
                                                                                                bool isChekedExcellent = finalScoreIn5 >= excellent.StartRange && finalScoreIn5 <= excellent.EndRange;

                                                                                            }
                                                                                                    <td class="grade">@(Html.Kendo().CheckBox().Name("chkPoor").Label("").Enable(false).Checked(isChekedPoor)) <input type="hidden" id="hdPoor" value="@poor.Id" /></td>
                                                                                                    <td class="grade">@(Html.Kendo().CheckBox().Name("chkFair").Label("").Enable(false).Checked(isChekedFair)) <input type="hidden" id="hdFair" value="@fair.Id" /></td>
                                                                                                    <td class="grade">@(Html.Kendo().CheckBox().Name("chkGood").Label("").Enable(false).Checked(isChekedGood)) <input type="hidden" id="hdGood" value="@good.Id" /></td>
                                                                                                    <td class="grade">@(Html.Kendo().CheckBox().Name("chkVeryGood").Label("").Enable(false).Checked(isChekedVeryGood)) <input type="hidden" id="hdVeryGood" value="@veryGood.Id" /></td>
                                                                                                    <td class="grade">@(Html.Kendo().CheckBox().Name("chkExcellent").Label("").Enable(false).Checked(isChekedExcellent)) <input type="hidden" id="hdExcellent" value="@excellent" /></td>
                                                                                                </tr>
                                                                                            </table>
                                                                                        </td>
                                                                                    </tr>
                                                                                </table>
                                                                            }
                                                                            else
                                                                            {
                                                                                pdrParameter = pdrParameter + item.PdrParameters.Count();
                                                                                foreach (var item2 in item.PdrParameters.OrderBy(x => x.Alphabet))
                                                                                {
                                                                                    decimal score = 0;
                                                                                        string notes = "";

                                                                                    if(Model.PdrDetailM2belows!=null){
                                                                                        var m2Belows = Model.PdrDetailM2belows.Where(x => x.PdrCategoryId == item.Id && x.PdrParameterId == item2.Id).FirstOrDefault();
                                                                                        if (m2Belows != null)
                                                                                        {
                                                                                            score = m2Belows.Score ?? 0;
                                                                                            notes = m2Belows.Notes;
                                                                                        }
                                                                                    }
                                                                                    <h5>@(item2.Alphabet + ". " + item2.Subject)</h5>
                                                                                    <label style="font-style:normal">@item2.Description</label><br /><br />
                                                                                    <table>
                                                                                        @if (item.No == 1)
                                                                                        {
                                                                                            <tr style="background-color:#00B0F0;" class="header">
                                                                                                <td class="top" style="width:100px;">Parameter</td>
                                                                                                <td class="td-width">1</td>
                                                                                                <td class="td-width">2</td>
                                                                                                <td class="td-width">3</td>
                                                                                                <td class="td-width">4</td>
                                                                                                <td class="td-width">5</td>
                                                                                                <td rowspan="2" style="width:100px;">TOTAL SCORE</td>
                                                                                            </tr>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <tr style="background-color:#008000;" class="header">
