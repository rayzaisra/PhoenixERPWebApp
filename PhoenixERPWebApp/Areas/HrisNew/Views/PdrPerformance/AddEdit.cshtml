    function Score_Change(e, pdrCategoryId, pdrParameterId) {
        var value = parseFloat(e.value);
        var percentage = parseFloat($("#lblPercentage_" + pdrCategoryId).text());

        var setParameter = pdr_detail_m2below.filter((x) => { return x.PdrCategoryId == pdrCategoryId && x.PdrParameterId == pdrParameterId; });
        if (setParameter.length == 1) {
            setParameter[0].Score = value;
        } else {
            pdr_detail_m2below.push({ PdrCategoryId: pdrCategoryId, PdrParameterId: pdrParameterId, Score: value, Percentage: percentage, Notes: $("#txtNotes_" + pdrCategoryId + pdrParameterId).val() });
        }

        var hdResultPdrParameters = $("#hdResultPdrParameters_" + pdrCategoryId).val().split(";");
        var countPdrParameters = 0;
        if (hdResultPdrParameters[0] == pdrCategoryId) {
            countPdrParameters = hdResultPdrParameters[1];
        }

        var scores = pdr_detail_m2below.filter((x) => { return x.PdrCategoryId == pdrCategoryId; }).map(item => item.Score);

        var sum = scores.reduce((prev, next) => prev + next);
        var average = sum / countPdrParameters;//values.length;
        var total = (average * (percentage / 100));
        var percentage2 = (average / 5) * 100;

        var setCategory = pdr_overall_score.filter((x) => { return x.PdrCategoryId == pdrCategoryId; });
        if (setCategory.length == 1) {
            //setCategory[0].Total = total;
            setCategory[0].Total = sum;
            setCategory[0].AverageScore = average;
        } else {
            //pdr_overall_score.push({ PdrCategoryId: pdrCategoryId, AverageScore: average, Percentage: percentage, Total:total });
            pdr_overall_score.push({ PdrCategoryId: pdrCategoryId, AverageScore: average, Percentage: percentage2, Total:sum });
        }

        var grandTotal = pdr_overall_score.map(item => item.Total).reduce((prev, next) => prev + next).toFixed(2);
        
        $("#lblValue_" + pdrCategoryId + pdrParameterId).html(value.toFixed(2));
        $("#lblAverage_" + pdrCategoryId).html(average.toFixed(2));
        //$("#lblTotal_" + pdrCategoryId).html(total.toFixed(2));
         $("#lblTotal_" + pdrCategoryId).html(sum.toFixed(2));
        $("#lblPercentage_" + pdrCategoryId).html(percentage2.toFixed(2));
        $("#lblFinal").html(grandTotal);
        $("#FinalScore").val(grandTotal);

        var lblPoor = parseFloat($("#lblPoor").text());
        var lblFairStart = parseFloat($("#lblFairStart").text());
        var lblFairEnd = parseFloat($("#lblFairEnd").text());
        var lblGoodStart = parseFloat($("#lblGoodStart").text());
        var lblGoodEnd = parseFloat($("#lblGoodEnd").text());
        var lblVeryGoodStart = parseFloat($("#lblVeryGoodStart").text());
        var lblVeryGoodEnd = parseFloat($("#lblVeryGoodEnd").text());
        var lblExcellentStart = parseFloat($("#lblExcellentStart").text());
        var lblExcellentEnd = parseFloat($("#lblExcellentEnd").text());


        var finalGrandTotal = (grandTotal / countParameter);
      
        var isPoor = finalGrandTotal <= lblPoor;
        var isFair = finalGrandTotal >= lblFairStart && finalGrandTotal <= lblFairEnd;
        var isGood = finalGrandTotal >= lblGoodStart && finalGrandTotal <= lblGoodEnd;
        var isVeryGood = finalGrandTotal >= lblVeryGoodStart && finalGrandTotal <= lblVeryGoodEnd;
        var isExcellent = finalGrandTotal >= lblExcellentStart && finalGrandTotal <= lblExcellentEnd;
      

        if (isPoor) {
            $("#Grade").val("POOR");
            $("#JobGradeId").val($("#hdPoor").val());
        }
        else if (isFair) {
            $("#Grade").val("FAIR");
            $("#JobGradeId").val($("#hdFair").val());
        }
        else if (isGood) {
            $("#Grade").val("GOOD");
            $("#JobGradeId").val($("#hdGood").val());
        }
        else if (isVeryGood) {
            $("#Grade").val("VERY GOOD");
            $("#JobGradeId").val($("#hdVeryGood").val());
        }
        else if (isExcellent) {
            $("#Grade").val("EXCELLENT");
            $("#JobGradeId").val($("#hdExcellent").val());
        }

        $("#chkPoor").prop('checked', isPoor);
        $("#chkFair").prop('checked', isFair);
        $("#chkGood").prop('checked', isGood);
        $("#chkVeryGood").prop('checked', isVeryGood);
        $("#chkExcellent").prop('checked', isExcellent);
    }

