        var dataList = {
            PdrDetailM2belows: pdr_detail_m2below,
            PdrOverallScores: pdr_overall_score,
            PdrDevelopmentPlans: gridPdrDevelopmentPlan.dataSource.data()
        }

        return dataList;
    }

