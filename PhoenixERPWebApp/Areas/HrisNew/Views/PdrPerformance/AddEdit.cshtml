    function contractExtended_change(e) {
        var effectivePermanent = $("#PdrRecomendation_EffectivePermanent").data("kendoDatePicker");
        var isReadonly = (this.value() != null);
        disableContractExtended(isReadonly);
    }

    function effectivePermanent_change(e) {
        var contractExtended = $("#PdrRecomendation_ContractExtended").data("kendoNumericTextBox");
        var isReadonly = (this.value() != null);
        disableEffectivePermanent(isReadonly);
    }

    $("input[name='PdrRecomendation.Terminated']").click(function () {
        var isReadonly = $("input:radio[name='PdrRecomendation.Terminated']:checked").val() == "True";
        var contractExtended = $("#PdrRecomendation_ContractExtended").data("kendoNumericTextBox");
        var effectivePermanent = $("#PdrRecomendation_EffectivePermanent").data("kendoDatePicker");
        disableTerminated(isReadonly);
    });

    function disableContractExtended(isReadonly) {
        var effectivePermanent = $("#PdrRecomendation_EffectivePermanent").data("kendoDatePicker");
        effectivePermanent.readonly(isReadonly);
        if (!isReadonly) {
            $("#PdrRecomendation_Type").val("");
            $("input[name='PdrRecomendation.Terminated']").removeAttr("disabled")
            $("#PdrRecomendation_EffectivePermanent").attr("required", "required");
            $('#span-extended').text('*');
            $('#span-terminated').text('*');
            $('#span-efecctive').text('*');

        } else {
            effectivePermanent.value("");
            $("#PdrRecomendation_Terminated_False").prop('checked', true);
            $("#PdrRecomendation_Type").val("Contract extender");
            $("input[name='PdrRecomendation.Terminated']").attr("disabled", true);
            $("#PdrRecomendation_EffectivePermanent").removeAttr("required");
            $('#span-extended').text('*');
            $('#span-terminated').text('*');
            $('#span-efecctive').text('');
        }
    }

    function disableEffectivePermanent(isReadonly) {
        var contractExtended = $("#PdrRecomendation_ContractExtended").data("kendoNumericTextBox");
        contractExtended.readonly(isReadonly);
        if (!isReadonly) {
            $("#PdrRecomendation_Type").val("");
            $("input[name='PdrRecomendation.Terminated']").removeAttr("disabled");
            $("#PdrRecomendation_ContractExtended").attr("required", "required");
            $('#span-extended').text('*');
            $('#span-terminated').text('*');
            $('#span-efecctive').text('*');
        } else {
            contractExtended.value("");
            $("#PdrRecomendation_Terminated_False").prop('checked', true);
            $("#PdrRecomendation_Type").val("Promotion to be permanent");
            $("input[name='PdrRecomendation.Terminated']").attr("disabled", true);
            $("#PdrRecomendation_ContractExtended").removeAttr("required");
            $('#span-extended').text('');
            $('#span-terminated').text('*');
            $('#span-efecctive').text('*');
        }
    }

    function disableTerminated(isReadonly) {
        var contractExtended = $("#PdrRecomendation_ContractExtended").data("kendoNumericTextBox");
        var effectivePermanent = $("#PdrRecomendation_EffectivePermanent").data("kendoDatePicker");
        contractExtended.readonly(isReadonly);
        effectivePermanent.readonly(isReadonly);
        if (!isReadonly) {
            $("#PdrRecomendation_Type").val("");
            $("#PdrRecomendation_ContractExtended").attr("required", "required");
            $("#PdrRecomendation_EffectivePermanent").attr("required", "required");
            $('#span-extended').text('*');
            $('#span-terminated').text('*');
            $('#span-efecctive').text('*');
        } else {
            contractExtended.value("");
            effectivePermanent.value("");
            $("#PdrRecomendation_Type").val("Contract terminated");
            $("#PdrRecomendation_ContractExtended").removeAttr("required");
            $("#PdrRecomendation_EffectivePermanent").removeAttr("required");
            $('#span-extended').text('');
            $('#span-terminated').text('');
            $('#span-efecctive').text('');
        }
    }
</script>