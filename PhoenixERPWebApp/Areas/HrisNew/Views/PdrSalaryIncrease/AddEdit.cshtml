@model PhoenixERPWebApp.Models.PdrSalaryIncrease
@{
    ViewData["Title"] = "PDR Salary Increase";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">PDR Salary Increase</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Master Data</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="pdrsalaryincrease" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">PDR Salary Increase</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="pdrsalaryincrease" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="pdrsalaryincrease" asp-area="hrisnew" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div>
                                @ViewBag.Header
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formPdrSalaryIncrease" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="pdrsalaryincrease" asp-area="HrisNew">
                        @*enctype="multipart/form-data"*@
                        <div class="row ">
                            <div class="col-lg-12">
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" asp-for="CreatedBy" />
                                <input type="hidden" asp-for="CreatedOn" />
                                <input type="hidden" asp-for="ModifiedBy" />
                                <input type="hidden" asp-for="ModifiedOn" />
                                <input type="hidden" asp-for="ApprovedBy" />
                                <input type="hidden" asp-for="ApprovedOn" />
                                <input type="hidden" asp-for="IsActive" />
                                <input type="hidden" asp-for="IsLocked" />
                                <input type="hidden" asp-for="IsDefault" />
                                <input type="hidden" asp-for="IsDeleted" />
                                <input type="hidden" asp-for="OwnerId" />
                                <input type="hidden" asp-for="DeletedBy" />
                                <input type="hidden" asp-for="DeletedOn" />
                                <input type="hidden" asp-for="BusinessUnitDivisionId" />
                                <input type="hidden" asp-for="BusinessUnitDepartementId" />
                                <input type="hidden" asp-for="SalaryIncreaseString" />

                                <div class="form-group m-form__group-sub">
                                    <label asp-for="PdrSalaryGrade"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().MultiSelectFor(x => x.PdrSalaryGrade)
                                          .DataTextField("Text")
                                          .DataValueField("Value")
                                          .Placeholder($"Choose or type a {Html.DisplayNameFor(m => m.PdrSalaryGrade)}")
                                          .Value(Model.PdrSalaryGrade.Select(x => new { Value = x }).ToArray())
                                          .DataSource(source =>
                                          {
                                              source.Read(read =>
                                              {
                                                  read.Action("GetDDLJobGrades", "Dropdown", new { area = "hrisnew" });
                                              })
                                              .ServerFiltering(false);
                                          })
                                    )
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="PdrGradeId"></label> <span class="req">*</span>  :
                                    @(Html.Kendo().DropDownListFor(m => m.PdrGradeId)
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.PdrGradeId)}")
                                        .HtmlAttributes(new
                                                {
                                            style = "width:100%;",
                                            required = "required",
                                            validationmessage = $"{Html.DisplayNameFor(m => m.PdrGradeId)} is required"
                                        })
                                        .Height(400)
                                        .Filter(FilterType.Contains)
                                        .DataSource(source => source
                                            .Custom()
                                            .Transport(transport => transport
                                            .Read(read =>
                                            {
                                                read.Action("GetDDLPdrGrade", "Dropdown", new { area = "hrisnew" });
                                            }))
                                            .ServerFiltering(false))
                                    )
                                </div>
                                <div class="form-group m-form__group-sub">
                                    <label asp-for="SalaryIncrease"></label> <span class="req">*</span>  :
                                    @if (Model.Id != null)
                                    {
                                        @(Html.Kendo().TextBoxFor(m => m.SalaryIncrease).HtmlAttributes(new
                                                   {
                                                       style = "width:100%",
                                                       required = "required",
                                                       validationmessage = $"{Html.DisplayNameFor(m => m.SalaryIncrease)} is required",
                                                       placeholder = $"Input type a {Html.DisplayNameFor(m => m.SalaryIncrease)}",
                                                       @class = "allownumericwithdecimal"
                                                   }))
                                    }
                                    else
                                    {

                                        @(Html.Kendo().NumericTextBoxFor(m => m.SalaryIncrease)
                                          .Spinners(false)
                                          .Format("N2")
                                          .HtmlAttributes(new
                                                  {
                                              style = "width:100%",
                                              maxlength = 10,
                                              placeholder = $"Input type a {Html.DisplayNameFor(m => m.SalaryIncrease)}",
                                              required = "required",
                                              validationmessage = $"{Html.DisplayNameFor(m => m.SalaryIncrease)} is required"

                                          }))
                                    }

                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                                <a asp-action="index" asp-controller="pdrsalaryincrease" asp-area="hrisnew" class="fakelink btn btn-secondary">Close</a>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(function () {
        if ('@Model.Id' != '') {
            $('#SalaryIncrease').val(formatDecimal($('#SalaryIncrease').val().replace(',', '.')));
        }
       

    })
    $('#btn-save').click(function () {
        var data = { PdrSalaryGrade: $("#PdrSalaryGrade").data("kendoMultiSelect").value() }
         if ('@Model.Id' != '') {
                var vala = $('#SalaryIncrease').val().replace('.', ',');
                $('#SalaryIncrease').val(vala);
            } else {
                var vala = $('#SalaryIncrease').data("kendoNumericTextBox").value();
                var stringVala = vala.toString().replace('.', ',');
                $('#SalaryIncrease').val(stringVala);
            }
        callAction({ formId: "formPdrSalaryIncrease", title: "save", type: "POST", objects: data });
    });

    $(".allownumericwithdecimal").keypress(function (e) {
        if (e.which == 46) {
            if ($(this).val().indexOf('.') != -1) {
                return false;
            }
        }

        if (e.which != 8 && e.which != 0 && e.which != 46 && (e.which < 48 || e.which > 57)) {
            return false;
        }
      
    });

    function formatDecimal(total) {
        var neg = false;
        if (total < 0) {
            neg = true;
            total = Math.abs(total);
        }
        return (neg ? "-" : ' ') + parseFloat(total, 10).toFixed(2).replace(/(\d)(?=(\d{3})+\.)/g, "$1,").toString();
    };


    function validateRange(ele) {
        var val = ele.val();
        if (!$.isNumeric(val) || parseInt(val, 10) < 0 || parseInt(val, 10) > 100) {
            return false;
        } else {
            return true;
        }
    }


</script>