@model PhoenixERPWebApp.Models.Promotion
@{
    if (Model.IsApprove == true)
    {
        ViewData["Title"] = "Employee Promotion Recommendation Form Approval";
    }
    else
    {
        ViewData["Title"] = "Employee Promotion Recommendation Form";
    }
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";

    DateTime? EffectiveDate = DateTime.Now;
    if (!string.IsNullOrEmpty(Model.Id))
    {
        if (EffectiveDate >= Model.EffectiveDate)
        {
            EffectiveDate = Model.EffectiveDate;
        }
    }
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">HRIS</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (Model.IsApprove == true)
                    {
                        <a asp-action="indexapproval" asp-controller="promotion" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Employee Promotion Request Approval</span></a>
                    }
                    else
                    {
                        <a asp-action="index" asp-controller="promotion" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Employee Promotion Request</span></a>
                    }
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (Model.IsApprove == true)
                    {
                        <a asp-action="addedit" asp-controller="promotion" asp-area="hrisnew" asp-route-Id="@Model.Id" asp-route-isApprove="true" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="promotion" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="promotion" asp-area="hrisnew" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
