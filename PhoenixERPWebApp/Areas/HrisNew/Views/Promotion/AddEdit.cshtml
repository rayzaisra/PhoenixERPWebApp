                                    <div class="modal-body">
                                        <div class="form-group">
                                            @Html.TextAreaFor(x => x.RemarkRejected, new { style = "height:150px;width:100%" })
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                        <button type="button" id="btnReject" class="btn btn-primary">Submit</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var additional_salary_current = [];
    var additional_salary_new = [];
    var deduction_salary_current = [];
    var deduction_salary_new = [];

     $(document).ready(function () {
        if ('@Model.Status' != '') {
            if ('@Model.IsApprove' == "True" || !('@Model.Status' == '@PhoenixERPWebApp.Models.StatusTransaction.Draft') ||
                ('@ViewBag.isHcAdmin' == "False" && '@Model.SubmitUser' == "True")) {
                // || '@Model.Status' == '@PhoenixERPWebApp.Models.StatusTransaction.Rejected')) {
                 $('.k-editor-toolbar').hide();
                 $($("#Skills").data().kendoEditor.body).attr("contentEditable", false);
                 $($("#Skills").data().kendoEditor.body).css("background-color", "#F8F9FA");

                 $($("#Attitude").data().kendoEditor.body).attr("contentEditable", false);
                 $($("#Attitude").data().kendoEditor.body).css("background-color", "#F8F9FA");

                 $($("#Performence").data().kendoEditor.body).attr("contentEditable", false);
                 $($("#Performence").data().kendoEditor.body).css("background-color", "#F8F9FA");

                 $("#EffectiveDate").data("kendoDatePicker").readonly();
                 $("#JobTitleId").data("kendoDropDownList").readonly();
                 $("#JobGradeId").data("kendoDropDownList").readonly();
                 $("#JobLevelId").data("kendoDropDownList").readonly();

                if ('@ViewBag.isHcAdmin' == 'True' || '@Model.IsApprove' == "True") {
                    $("#NextSalaryZone").data("kendoDropDownList").readonly();
                    $("#NextSalary").data("kendoNumericTextBox").readonly();
                    $("#IncrementPercentage").data("kendoNumericTextBox").readonly();
                    $($("#Notes").data().kendoEditor.body).attr("contentEditable", false);
                    $($("#Notes").data().kendoEditor.body).css("background-color", "#F8F9FA");
                }
                $("#search").remove();
            }
        }

         if ('@ViewBag.isHcAdmin' == "True" && '@Model.SubmitUser' == "True") {
            $("#search").remove();
         }

        SalaryDetail("@Model.EmployeeBasicInfoId","@Model.Id");
    });

    $('#btnShow').click(function () {
        $("#RemarkRejected").attr("required", "required");
        $('#modalRemark').modal('show');
    });

    $('#btnApprove').click(function () {
        $("#RemarkRejected").removeAttr("required", "required");
        callAction({ formId:"formPromotion", title: "approve", type:"POST", url: '@Url.Action("approve", "promotion")'});
    });

    $('#btnReject').click(function () {
        callAction({ formId:"formPromotion", title: "reject", type:"POST", url: '@Url.Action("reject", "promotion")'});
    });

    $('#btnSubmit').click(function () {
        callAction({ formId: "formPromotion", title: "submit", type: "POST", url: '@Url.Action("submit", "promotion")', objects: result() });
    });

    $("#btnSubmitToHC").click(function () {
        callAction({ formId: "formPromotion", title: "submit to hc", type: "POST", url: '@Url.Action("submithc", "promotion")' });
    });

    $('#btnSave').click(function () {
        callAction({ formId: "formPromotion", title: "save", type: "POST", url: '@Url.Action("save", "promotion")', objects: result() });
    });

    function result() {
        var ComponentAdditional = [];
        var ComponentDeduction = [];

        $.each(additional_salary_current, function (index, data) {
             ComponentAdditional.push({
                Id: data.Id,
                AdditionalEmployeeBasicInfoId: data.AdditionalEmployeeBasicInfoId,
                AdditionalSalaryComponent:data.AdditionalSalaryComponent,
                AdditionalComponentId: data.AdditionalComponentId,
                AdditionalPercent: data.AdditionalPercent,
                AdditionalAmount: $("#current_" + data.Id).data("kendoNumericTextBox").value(),
                AdditionalRotationId: data.AdditionalRotationId,
                Type: data.Type,
                AdditionalComponentTypeName: data.AdditionalComponentTypeName,
                IsBasicSalary: data.IsBasicSalary
            });
         });

         $.each(additional_salary_new, function (index, data) {
             ComponentAdditional.push({
                 Id: data.Id,
                 AdditionalEmployeeBasicInfoId: data.AdditionalEmployeeBasicInfoId,
                 AdditionalSalaryComponent: data.AdditionalSalaryComponent,
                 AdditionalComponentId: data.AdditionalComponentId,
                 AdditionalPercent: data.AdditionalPercent,
                 AdditionalAmount: $("#new_" + data.Id).data("kendoNumericTextBox").value(),
                 AdditionalRotationId: data.AdditionalRotationId,
                 Type: data.Type,
                 AdditionalComponentTypeName: data.AdditionalComponentTypeName,
                 IsBasicSalary: data.IsBasicSalary
             });
         });

         $.each(deduction_salary_current, function (index, data) {
              ComponentDeduction.push({
                    Id: data.Id,
                    EmployeeBasicInfoId: data.EmployeeBasicInfoId,
                    SalaryComponent: data.SalaryComponent,
                    ComponentId: data.ComponentId,
                    DeductionPercent: data.DeductionPercent,
                    DeductionAmount: $("#current_" + data.Id).data("kendoNumericTextBox").value(),
                    RotationId: data.RotationId,
                    Type: data.Type,
                    ComponentTypeName: data.ComponentTypeName,
                    IsBasicSalary: data.IsBasicSalary
                });
         });

         $.each(deduction_salary_new, function (index, data) {
             ComponentDeduction.push({
                 Id: data.Id,
                 EmployeeBasicInfoId: data.EmployeeBasicInfoId,
                 SalaryComponent: data.SalaryComponent,
                 ComponentId: data.ComponentId,
                 DeductionPercent: data.DeductionPercent,
                 DeductionAmount: $("#new_" + data.Id).data("kendoNumericTextBox").value(),
                 RotationId: data.RotationId,
                 Type: data.Type,
                 ComponentTypeName: data.ComponentTypeName,
                 IsBasicSalary: data.IsBasicSalary
             });
         });

        var dataList = {
            ComponentAdditionalList: ComponentAdditional,
            ComponentDeductionList: ComponentDeduction
        }
        return dataList;
    }

    function IncrementPercentage_Change() {
        var result = 0;
        var percentage = this.value();
        $.each(additional_salary_current, function (index, data) {
            if (data.IsBasicSalary == true) {
                result += data.AdditionalAmount + (data.AdditionalAmount * (percentage / 100));
            }
        });

        $.each(additional_salary_new, function (index, data) {
            if (data.IsBasicSalary == true) {
                $("#new_" + data.Id).data("kendoNumericTextBox").value(result);
            }
        });
        calculateAll();
    }

    function salary_additional_change(e) { 
        var newValue = this.value();          
        $.each(additional_salary_current, function (index, data) {
            if (data.IsBasicSalary == true) {
                var currentBasicSalary = data.AdditionalAmount;
                var percentage = ((newValue - currentBasicSalary) / currentBasicSalary) * 100;
                $("#IncrementPercentage").data("kendoNumericTextBox").value(percentage);
            }
        });  
        calculateAll();
    }

    function salary_deduction_change(e) {
        calculateAll();
    }

    function calculateAll() {
        var totalAdditional = 0;
        $.each(additional_salary_new, function (index, data) {
            totalAdditional += $("#new_" + data.Id).data("kendoNumericTextBox").value();
        });

        var totalDeduction = 0;
        $.each(deduction_salary_new, function (index, data) {
            if (data.SalaryComponent == "@PhoenixERPWebApp.Models.SalaryComponentTypeDeduction.BPJS") {                
                $("#new_" + data.Id).data("kendoNumericTextBox").value(totalAdditional * (data.DeductionPercent/100));
            }

            totalDeduction += $("#new_" + data.Id).data("kendoNumericTextBox").value();
        });

        $("#new_total_additional").data("kendoNumericTextBox").value(totalAdditional);
        $("#new_total_deduction").data("kendoNumericTextBox").value(totalDeduction);
        $("#lblThp").html(kendo.format("{0:N0}", totalAdditional - totalDeduction));
        $("#NextSalary").data("kendoNumericTextBox").value(totalAdditional + totalDeduction);
    }

    function SalaryDetail(employeeId, promotionId) {
        var currentSalary = 0;
        var nextSalary = 0;
        var totalCurrentAdditional = 0;
        var totalNewAdditional = 0;
        var totalCurrentDeduction = 0;
        var totalNewDeduction = 0;

        $.ajax({
            type: "GET",
            async: false,
            url: '@Url.Action("GetAdditionalList", "Promotion")',
            data: { employeeId: employeeId, promotionId: promotionId },
            success: function (result) {
                $("#divAdditional").empty();
                $("#divAdditionalNew").empty();
                if (result != undefined) {
                    $.each(result, function (index, data) {
                        if (data.AdditionalAmount != null) {
                            if (data.Type == "@PhoenixERPWebApp.Models.Payroll.Type.CurrentSallary") {
                                currentSalary += data.AdditionalAmount;
                            } else if (data.Type == "@PhoenixERPWebApp.Models.Payroll.Type.NewSallary") {
                                nextSalary += data.AdditionalAmount;
                            }
                        }
                            
                        if (data.Type == "@PhoenixERPWebApp.Models.Payroll.Type.CurrentSallary" || promotionId == "") {
                            var current_additional = '<div class="row">' +
                                '<div class="col-lg-7"><label>' + data.AdditionalComponentTypeName + '</label></div>' +
                                '<div class="col-lg-5">' +
                                '<div class="form-group">' +
                                '<input type="text" name="current_' + data.Id + '" id="current_' + data.Id + '" value="' + data.AdditionalAmount + '" readonly>' +
                                '</div>' +
                                '</div>' +
                                '</div>';

                            $("#divAdditional").append(current_additional);
                            $("#current_" + data.Id).kendoNumericTextBox({ format: "n2", spinners: false });
                            totalCurrentAdditional += data.AdditionalAmount;

                            additional_salary_current.push({
                                Id: data.Id,
                                AdditionalEmployeeBasicInfoId: data.AdditionalEmployeeBasicInfoId,
                                AdditionalSalaryComponent: data.AdditionalSalaryComponent,
                                AdditionalComponentId: data.AdditionalComponentId,
                                AdditionalPercent: data.AdditionalPercent,
                                AdditionalAmount: data.AdditionalAmount,
                                AdditionalPromotionId: data.AdditionalPromotionId,
                                Type: "@PhoenixERPWebApp.Models.Payroll.Type.CurrentSallary",
                                AdditionalComponentTypeName: data.AdditionalComponentTypeName,
                                IsBasicSalary: data.IsBasicSalary
                            });
                        }

                        if (data.Type == "@PhoenixERPWebApp.Models.Payroll.Type.NewSallary" || promotionId == "") {
                            var new_additional = '<div class="row">' +
                                '<div class="col-lg-7"><label>' + data.AdditionalComponentTypeName + '</label></div>' +
                                '<div class="col-lg-5">' +
                                '<div class="form-group">' + 
                                '<input type="hidden" id="hdIsBasicSalary_' + data.Id + '" value="' + data.IsBasicSalary + '" />';

                            if ('@Model.IsApprove' == "True" || !('@(Model.Status?? PhoenixERPWebApp.Models.StatusTransaction.Draft)' == '@PhoenixERPWebApp.Models.StatusTransaction.Draft') ||
                                ('@ViewBag.isHcAdmin' == "False" && '@Model.SubmitUser' == "True")) {
                                new_additional += '<input type="text" name="new_' + data.Id + '" id="new_' + data.Id + '" value="' + data.AdditionalAmount + '" readonly>';
                            } else {
                                new_additional += '<input type="text" name="new_' + data.Id + '" id="new_' + data.Id + '" value="' + data.AdditionalAmount + '">';
                            }

                            new_additional += '</div>' +
                                '</div>' +
                                '</div>';

                            $("#divAdditionalNew").append(new_additional);
                            $("#new_" + data.Id).kendoNumericTextBox({ format: "n2", spinners: false, change: salary_additional_change });
                            totalNewAdditional += data.AdditionalAmount;
                                
                            additional_salary_new.push({
                                Id: data.Id,
                                AdditionalEmployeeBasicInfoId: data.AdditionalEmployeeBasicInfoId,
                                AdditionalSalaryComponent: data.AdditionalSalaryComponent,
                                AdditionalComponentId: data.AdditionalComponentId,
                                AdditionalPercent: data.AdditionalPercent,
                                AdditionalAmount: data.AdditionalAmount,
                                AdditionalPromotionId: data.AdditionalPromotionId,
                                Type: "@PhoenixERPWebApp.Models.Payroll.Type.NewSallary",
                                AdditionalComponentTypeName: data.AdditionalComponentTypeName,
                                IsBasicSalary: data.IsBasicSalary
                            });
                        }
                    });

                    
                }
				
            	$("#divAdditional").append('<hr style="margin-top:0px;" /><div class="row" style="font-weight:bold;"><div class="col-lg-7">' +
                        '<label>Total</label></div><div class="col-lg-5"><label><input type="text" name="current_total_additional" id="current_total_additional" value="' + totalCurrentAdditional + '" readonly></label></div></div><br/>');
            	$("#divAdditionalNew").append('<hr style="margin-top:0px;" /><div class="row" style="font-weight:bold;"><div class="col-lg-7">' +
					'<label>Total</label></div><div class="col-lg-5"><label><input type="text" name="new_total_additional" id="new_total_additional" value="' + totalNewAdditional + '" readonly></label></div></div><br/>');

            	$("#current_total_additional").kendoNumericTextBox({ format: "n2", spinners: false });
            	$("#new_total_additional").kendoNumericTextBox({ format: "n2", spinners: false });
                mApp.unblock("#m_blockui_list");
            },
            error: function (e, t, s) {
                console.log(e)
                mApp.unblock("#m_blockui_list");
            }
        });

        $.ajax({
            type: "GET",
            async: false,
            url: '@Url.Action("GetDeductionList", "Promotion")',
            data: { employeeId: employeeId, promotionId: promotionId },
            success: function (result) {
                $("#divDeduction").empty();
                $("#divDeductionNew").empty();
                if (result != undefined) {
                    $.each(result, function (index, data) {
                        if (data.DeductionAmount != null) {
                            if (data.Type == "@PhoenixERPWebApp.Models.Payroll.Type.CurrentSallary") {
                                currentSalary += data.DeductionAmount;
                            } else if (data.Type == "@PhoenixERPWebApp.Models.Payroll.Type.NewSallary") {
                                nextSalary += data.DeductionAmount;
                            }
                        }
                            
                        if (data.Type == "@PhoenixERPWebApp.Models.Payroll.Type.CurrentSallary" || promotionId == "") {
                            var current_deduction = '<div class="row">' +
                                '<div class="col-lg-7"><label>' + data.ComponentTypeName + '</label></div>' +
                                '<div class="col-lg-5">' +
                                '<div class="form-group">' +
                                '<input type="text" name="current_' + data.Id + '" id="current_' + data.Id + '" value="' + data.DeductionAmount + '" readonly>' +
                                '</div>' +
                                '</div>' +
                                '</div>';

                            $("#divDeduction").append(current_deduction);
                            $("#current_" + data.Id).kendoNumericTextBox({ format: "n2", spinners: false });
                            totalCurrentDeduction += data.DeductionAmount;

                            deduction_salary_current.push({
                                Id: data.Id,
                                EmployeeBasicInfoId: data.EmployeeBasicInfoId,
                                SalaryComponent: data.SalaryComponent,
                                ComponentId: data.ComponentId,
                                DeductionPercent: data.DeductionPercent,
                                DeductionAmount: data.DeductionAmount,
                                PromotionId: data.PromotionId,
                                Type: "@PhoenixERPWebApp.Models.Payroll.Type.CurrentSallary",
                                ComponentTypeName: data.ComponentTypeName,
                                IsBasicSalary: data.IsBasicSalary
                            });
                        }

                        if (data.Type == "@PhoenixERPWebApp.Models.Payroll.Type.NewSallary" || promotionId == "") {
                            var new_deduction = '<div class="row">' +
                                '<div class="col-lg-7"><label>' + data.ComponentTypeName + '</label></div>' +
                                '<div class="col-lg-5">' +
                                '<div class="form-group">' + 
                                '<input type="hidden" id="hdIsBasicSalary_' + data.Id + '" value="' + data.IsBasicSalary + '" />';

                            if ('@Model.IsApprove' == "True" || !(@(Model.Status?? PhoenixERPWebApp.Models.StatusTransaction.Draft) == '@PhoenixERPWebApp.Models.StatusTransaction.Draft') ||
                            ('@ViewBag.isHcAdmin' == "False" && '@Model.SubmitUser' == "True") || data.SalaryComponent=="@PhoenixERPWebApp.Models.SalaryComponentTypeDeduction.BPJS") {
                                new_deduction += '<input type="text" name="new_' + data.Id + '" id="new_' + data.Id + '" value="' + data.DeductionAmount + '" readonly>';
                            } else {
                                new_deduction += '<input type="text" name="new_' + data.Id + '" id="new_' + data.Id + '" value="' + data.DeductionAmount + '">';
                            }

                            new_deduction += '</div>' +
                                '</div>' +
                                '</div>';

                            $("#divDeductionNew").append(new_deduction);
                            $("#new_" + data.Id).kendoNumericTextBox({ format: "n2", spinners: false, change: salary_deduction_change });
                            totalNewDeduction += data.DeductionAmount;

                            deduction_salary_new.push({
                                Id: data.Id,
                                EmployeeBasicInfoId: data.EmployeeBasicInfoId,
                                SalaryComponent: data.SalaryComponent,
                                ComponentId: data.ComponentId,
                                DeductionPercent: data.DeductionPercent,
                                DeductionAmount: data.DeductionAmount,
                                PromotionId: data.PromotionId,
                                Type: "@PhoenixERPWebApp.Models.Payroll.Type.NewSallary",
                                ComponentTypeName: data.ComponentTypeName,
                                IsBasicSalary: data.IsBasicSalary
                            });
                        }
                    });   
                }
            	$("#divDeduction").append('<hr style="margin-top:0px;" /><div class="row" style="font-weight:bold;"><div class="col-lg-7">' +
										'<label>Total</label></div><div class="col-lg-5"><label><input type="text" name="current_total_deduction" id="current_total_deduction" value="' + totalCurrentDeduction + '" readonly></label></div></div><br/>');
            	$("#divDeductionNew").append('<hr style="margin-top:0px;" /><div class="row" style="font-weight:bold;"><div class="col-lg-7">' +
					'<label>Total</label></div><div class="col-lg-5"><label><input type="text" name="new_total_deduction" id="new_total_deduction" value="' + totalNewDeduction + '" readonly></label></div></div><br/>');

            	$("#current_total_deduction").kendoNumericTextBox({ format: "n2", spinners: false });
            	$("#new_total_deduction").kendoNumericTextBox({ format: "n2", spinners: false });
                mApp.unblock("#m_blockui_list");
            },
            error: function (e, t, s) {
                console.log(e)
                mApp.unblock("#m_blockui_list");
            }
        });

        if ($("#CurrentSalary").data("kendoNumericTextBox") != null) {
            $("#CurrentSalary").data("kendoNumericTextBox").value(currentSalary);
            if (nextSalary == 0) {
                $("#NextSalary").data("kendoNumericTextBox").value(currentSalary);
            } else {
                $("#NextSalary").data("kendoNumericTextBox").value(nextSalary);
            }
        }

        $("#lblThp").html(kendo.format("{0:N0}", totalNewAdditional - totalNewDeduction));
    }
</script>