@model PhoenixERPWebApp.Models.Rotation
@{
    if (Model.IsApprove == true)
    {
        ViewData["Title"] = "Employee Rotation Request Form Approval";
    }
    else
    {
        ViewData["Title"] = "Employee Rotation Request Form";
    }
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";

    DateTime? EffectiveDate = DateTime.Now;
    DateTime? EndDate = DateTime.Now;
    if (!string.IsNullOrEmpty(Model.Id))
    {
        if (EffectiveDate >= Model.EffectiveDate)
        {
            EffectiveDate = Model.EffectiveDate;
        }
        if (EndDate >= Model.EndDate)
        {
            EndDate = Model.EndDate;
        }
    }
}
