    function IncrementPercentage_Change() {
        var result = 0;
        var percentage = this.value();
        $.each(additional_salary_current, function (index, data) {
            if (data.IsBasicSalary == true) {
                result += data.AdditionalAmount + (data.AdditionalAmount * (percentage / 100));
            }
        });

        $.each(additional_salary_new, function (index, data) {
            if (data.IsBasicSalary == true) {
                $("#hdNew_" + data.Id).val(result);
                $("#new_" + data.Id).data("kendoNumericTextBox").value(result);
            }
        });

        $.each(additional_salary_new, function (index, data) {
            if (data.IsBasicSalary != true) {
                result += $("#new_" + data.Id).data("kendoNumericTextBox").value();
            }
        });

        $.each(deduction_salary_new, function (index, data) {
            if (data.IsBasicSalary != true) {
                result += $("#new_" + data.Id).data("kendoNumericTextBox").value();
            }
        });

        $("#NextSalary").data("kendoNumericTextBox").value(result);
    }

    function salary_change(e) {
        var id = this.element.prop("id").replace("new_", "");
        var isBasicSalary = $("#hdIsBasicSalary_" + id).val();
        var oldValue = $("#hdNew_"+id).val();
        var newValue = this.value();
        var newSalary = $("#NextSalary").data("kendoNumericTextBox").value();

        if (newSalary != null) {
            if (oldValue > newValue) {
                newSalary = newSalary - (oldValue - newValue);
            } else {
                newSalary = newSalary + (newValue - oldValue);
            }

            $("#NextSalary").data("kendoNumericTextBox").value(newSalary);
            $("#hdNew_" + id).val(newValue);
        } else {
            $("#NextSalary").data("kendoNumericTextBox").value(0);
        }

        if (isBasicSalary == "true") {
            $.each(additional_salary_current, function (index, data) {
                if (data.IsBasicSalary == true) {
                    var currentBasicSalary = data.AdditionalAmount;
                    var percentage = ((newValue - currentBasicSalary) / currentBasicSalary) * 100;
                    $("#IncrementPercentage").data("kendoNumericTextBox").value(percentage);
                }
            });
        }
    }

    function SalaryDetail(employeeId, rotationId) {
        var currentSalary = 0;
        var nextSalary = 0;
