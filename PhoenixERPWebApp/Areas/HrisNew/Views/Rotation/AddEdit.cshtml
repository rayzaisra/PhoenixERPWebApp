                                AdditionalPercent: data.AdditionalPercent,
                                AdditionalAmount: data.AdditionalAmount,
                                AdditionalRotationId: data.AdditionalRotationId,
                                Type: "@PhoenixERPWebApp.Models.Payroll.Type.CurrentSallary",
                                AdditionalComponentTypeName: data.AdditionalComponentTypeName,
                                IsBasicSalary: data.IsBasicSalary
                            });
                        }

                        if (data.Type == "@PhoenixERPWebApp.Models.Payroll.Type.NewSallary" || rotationId == "") {
                            var new_additional = '<div class="row">' +
                                '<div class="col-lg-7"><label>' + data.AdditionalComponentTypeName + '</label></div>' +
                                '<div class="col-lg-5">' +
                                '<div class="form-group">' +
                                '<input type="hidden" id="hdNew_' + data.Id + '" value="' + data.AdditionalAmount + '" />' +
