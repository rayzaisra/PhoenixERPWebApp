@{
    ViewData["Title"] = "Subgroup";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
<span class="translate" data-args="update">Update</span>
}

@section Paneltools{

}
@section Panelbody{
<form id="SubgroupFormUpdate" method="post">
    <div class="row ">
        <div class="col-lg-12"><input value="@ViewBag.RecordID" type="hidden" name="id" />

            <div class="form-group">
                <label><span class="translate" data-args="group_id">group_id</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="group_id" id="group_id"  maxlength="100" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="subgroup_code">subgroup_code</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="subgroup_code" id="subgroup_code"  maxlength="50" type="text">
            </div>
            
            <div class="form-group">
                <label><span class="translate" data-args="subgroup_name">subgroup_name</span> :</label>
                <input class="form-control form-control-sm m-input m-input--square" name="subgroup_name" id="subgroup_name"  maxlength="100" type="text">
            </div>
            
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-lg-12">
            <button type="submit" id="btn-save" class="btn btn-primary">Save</button>
            <a href="~/Hris/Subgroup" class="fakelink btn btn-secondary">Close</a>
        </div>

    </div>
</form>
}
@section Panelscript{
    <script src="~/assets/js/Areas/Hris/Form/Subgroup.update.js"></script>
}
