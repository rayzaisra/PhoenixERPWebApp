    function ColumnGeneration(result) {
        var GridColumnGeneration = [];
        $.each(result[0], function (gridTitle, element) {
            if (gridTitle != "employee_basic_info_id") {
                if (gridTitle !== "rpt_Employee_Name" && gridTitle !== "rpt_Legal_Entity_Name" && gridTitle !== "rpt_Division" && gridTitle !== "rpt_Join_Date" && gridTitle !== "rpt_Status_Pph21") {
                    element = parseFloat(element);
                }

                var propType = typeof element;
                var title = gridTitle.replaceAll("rpt_", "").replaceAll("_", " ");
                title = title.toLowerCase().replace(/\b[a-z]/g, function (letter) {
                    return letter.toUpperCase();
                });
                var width = 190;
                if (gridTitle == "rpt_Employee_Name") width = 250;
                if (gridTitle == "rpt_Legal_Entity_Name") width = 250;
                if (gridTitle == "rpt_Division") width = 250;
                if (gridTitle == "rpt_Join_Date") width = 250;
                if (gridTitle == "rpt_Status_Pph21") width = 250;

                if (propType == "number") {
                    GridColumnGeneration.push({ title: title, field: gridTitle, width: width, format: "{0:n2}", attributes: { style: "text-align:right" }, aggregates: ["sum"], footerTemplate: "#=kendo.format('{0:n2}',sum)#" });
                } else if (propType == "object") {

                    GridColumnGeneration.push({ title: title, field: gridTitle, width: width, format: "{0:n2}", attributes: { style: "text-align:right" }, aggregates: ["sum"], footerTemplate: "#=kendo.format('{0:n2}',sum)#" });
                } else if (title == "Employee Name" || title == "Legal Entity Name" || title == "Join Date" || title == "Division" || title == "Status Pph21") {

                    GridColumnGeneration.push({ title: title, field: gridTitle, width: width });
                }
                else {
                    GridColumnGeneration.push({ title: title, field: gridTitle, width: width, format: "{0:n2}", attributes: { style: "text-align:right" }, aggregates: ["sum"], footerTemplate: "#=kendo.format('{0:n2}',sum)#" });
                }
            }
        });

        return GridColumnGeneration;
    }

