    function generateModel(result) {
        var model = {};
        model.id = "employee_basic_info_id";
        var fields = {};
        for (var property in result) {
            var propType = typeof result[property];

            if (property == "employee_basic_info_id" || property == "rpt_Employee_Name" || property == "rpt_Legal_Entity_Name" || property == "rpt_Division" || property == "rpt_Join_Date" || property == "rpt_Status_Pph21" || property == "rpt_Account_No" || property == "rpt_bank_id" || property == "rpt_employee_code") {
                fields[property] = {
                    type: "string",
                    nullable: true
                    //validation: {
                    //    required: true
                    //}
                };
            } else {
                fields[property] = {
                    type: "number",
                    nullable: true
                    //validation: {
                    //    required: true
                    //}
                };
            }
            //else if (propType == "number") {
            //    fields[property] = {
