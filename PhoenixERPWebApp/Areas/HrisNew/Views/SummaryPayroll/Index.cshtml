            //        //validation: {
            //        //    required: true
            //        //}
            //    };
            //} else if (propType == "boolean") {
            //    fields[property] = {
            //        type: "boolean",
            //        nullable: true
            //        //validation: {
            //        //    required: true
            //        //}
            //    };
            //} else if (propType == "string") {
            //    var parsedDate = kendo.parseDate(result[property]);
            //    if (parsedDate) {
            //        fields[property] = {
            //            type: "date",
            //            nullable: true
            //            //validation: {
            //            //    required: true
            //            //}
            //        };
            //        dateFields.push(property);
            //    } else {
            //        fields[property] = {
            //            type: "string",
            //            nullable: true
            //            //validation: {
            //            //    required: true
            //            //}
            //        };
            //    }
            //} else {
