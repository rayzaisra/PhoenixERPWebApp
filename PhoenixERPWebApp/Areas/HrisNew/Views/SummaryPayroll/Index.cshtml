<script>
    $('#btnGenerate').click(function () {
        var valid = $("#formPayroll").validate().form();
        if (valid) {
            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            var month = $("#Month").data("kendoDropDownList").value();
            var year = $("#Year").data("kendoDropDownList").value();
            var legalEntityId = $("#LegalEntityId").data("kendoDropDownList").value();
            var divisionId = $('#DivisionId').data("kendoDropDownList").value();
            $.ajax({
                type: "GET",
                url: '@Url.Action("GetGenerateList", "SummaryPayroll")',
                data: { month: month, year: year, legalEntityId: legalEntityId, divisionId: divisionId},
                dataType: 'json',
                aync: false,
                success: function (result) {
                    if (result.success) {
                        generateGrid(result);
                        //generateGrid2(result);
                    } else {
                        swal('Error', result.message, 'error');
                    }
                    mApp.unblock("#m_blockui_list");
                },
                error: function (e, t, s) {
                    var errorMessage = e.responseJSON.errorMessage;
                    if (errorMessage === "" || errorMessage === undefined) {
                        errorMessage = "Ooops, something went wrong !";
                    }
                    //console.log(errorMessage);
                    console.log(errorMessage);
                    mApp.unblock("#m_blockui_list");
                }
            });
        }
    });

