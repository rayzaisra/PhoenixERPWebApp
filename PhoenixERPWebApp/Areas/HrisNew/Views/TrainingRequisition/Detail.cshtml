												<span class="m-badge m-badge--danger m-badge--wide" id="lblstatus">@TrainingStatus.GetStatus(PhoenixERPWebApp.Models.Enum.TrainingStatus.Reject)</span>
											}
											else if (Model.Status == PhoenixERPWebApp.Models.Enum.TrainingStatus.Training)
											{
												<span class="m-badge m-badge--dark m-badge--wide" id="lblstatus">@TrainingStatus.GetStatus(PhoenixERPWebApp.Models.Enum.TrainingStatus.Training)</span>
											}
											else if (Model.Status == PhoenixERPWebApp.Models.Enum.TrainingStatus.SharingSeassion)
											{
												<span class="m-badge m-badge--info m-badge--wide" id="lblstatus">@TrainingStatus.GetStatus(PhoenixERPWebApp.Models.Enum.TrainingStatus.SharingSeassion)</span>
											}
											else
											{
												<span class="m-badge m-badge--danger m-badge--wide" id="lblstatus">@TrainingStatus.GetStatus(PhoenixERPWebApp.Models.Enum.TrainingStatus.Open)</span>
											}
										}
