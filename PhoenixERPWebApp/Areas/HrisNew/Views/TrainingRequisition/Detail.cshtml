<script id="btnAction-template" type="text/x-kendo-template">
	<a href='javascript: void(0);' onclick='deleteGridRowEmployeeList(this)' title='Delete' class='delete'><span style='color:maroon'><i class='fa fa-trash-alt'></i></span></a>
</script>
<script id="grid-toolbar-template" type="text/x-kendo-template">
	<a class='k-button' href='javascript: void(0);' onclick='AddEmployee(this)'><span class='k-icon k-i-plus'></span>Add Participant</a>
</script>

<script>
    //Untuk Mengatasi problem auto close dropdown modal bootstrap popup
    (function ($, kendo) {
        var _init = kendo.ui.Popup.fn.init;
        var Popup = kendo.ui.Popup.extend({
            init: function (element, options) {
                // Only set appendTo if nothing was manually set in the options.
                if (options.appendTo === undefined) {
                    // Find the nearest parent bootstrap modal, if any.
                    var parentModal = $(options.anchor).closest('.modal');

                    // Found one!
                    if (parentModal.length > 0) {
                        options.appendTo = parentModal[0];
                    }
                }
                // Call the base constructor.
                _init.call(this, element, options);
            }
        });
        kendo.ui.plugin(Popup);
    }(window.kendo.jQuery, window.kendo));

	$(function () {
		
        if ( $('#TrainingId').data("kendoDropDownList").value() !== "") {
            $('#TrainingId').data("kendoDropDownList").trigger("change");
		}

        if ('@ViewBag.isReadOnly' === 'True') {
			$('#Venue').prop('disabled', true);
			$('#Notes').prop('disabled', true);
            $('#PurposeEndDate').data("kendoDatePicker").readonly();
            $('#PurposeStartDate').data("kendoDatePicker").readonly();
            var dropdownlist = $("#TrainingId").data("kendoDropDownList");
            dropdownlist.enable(false);
        }


    })

    function AddEmployee() {
       ClearDataFilter();
        $('#modal-choice-employee').modal('show');
    }

    function ClearDataFilter() {
    	$("#GroupId").data("kendoDropDownList").select(-1);
    	$("#SubgroupId").data("kendoDropDownList").select(-1);
    	$("#DivisionId").data("kendoDropDownList").select(-1);
    	$("#DepartementId").data("kendoDropDownList").select(-1);
    }
    function deleteGridRowEmployeeList(e) {
        swal({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            type: "warning",
            showCancelButton: !0,
            confirmButtonText: "Yes",
            cancelButtonText: "No",
            reverseButtons: !0
        }).then(function (ok) {
            if (ok.value) {
                mApp.block("#m_blockui_list", {
                    overlayColor: "#000000",
                    type: "loader",
                    state: "primary",
                    message: "Processing..."
                });

                var item = dataItem(e);
                $("#grid").data("kendoGrid").dataSource.remove(item);
            }
        }).catch(swal.noop);
    }

    function TrainingOnChange() {
        mApp.block("#m_blockui_list", {
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        });
        var tid = $("#TrainingId").data("kendoDropDownList").value();
        $.ajax({
        	type: "GET",
        	url: '@Url.Action("GetTrainingSettingDetail", "TrainingRequisition")',
        	data: { id: tid },
			success: function (result) {
		
        		if (result != undefined) {
        			$("#TrainingName").val(result.Name);
        			$("#TrainingCost").data("kendoNumericTextBox").value(result.TrainingCost);
        			$("#TrainingType").val(result.TrainingType);
        			if (result.BondingDetail != null) {
        				//$("#IsTrainingBonding").data("kendoRadioButton").checked(true);
        				$('input[name="IsTrainingBonding"][value="True"]').prop("checked", true);
        			} else {
        				$('input[name="IsTrainingBonding"][value="False"]').prop("checked", true);
        			}
        		}
        		mApp.unblock("#m_blockui_list");
        	},
        	error: function (e, t, s) {
        		//console.log(e)
                console.log(e);
        		mApp.unblock("#m_blockui_list");
        	}
        }).then(setTimeout(function () {
        	mApp.unblock("#m_blockui_list");
        }, 2e3));
    };

    $('#btn-save').click(function () {
        if ($("#RequesterEmployeeBasicInfoId").val() == null || $("#BusinessUnitId").val() == null) {
            swal('Warning', "Please Check Your Session", 'error');
            setTimeout(
                function () {
                    //do something special
                    window.location.href = '@Url.Action("Index", "TrainingRequisition")';
                }, 2000);
        }
        var dataList = {
            Details: $("#grid").data("kendoGrid").dataSource.data()
        };
        callAction({ formId: "form", title: "Save", type: "POST" , url: '@Url.Action("Save", "TrainingRequisition")', objects: dataList });
    });

	$('#btn-submit').click(function () {
        if ($("#RequesterEmployeeBasicInfoId").val() == null || $("#BusinessUnitId").val() == null) {
            swal('Warning', "Please Check Your Session", 'error');
            setTimeout(
                function () {
                    //do something special
                    window.location.href = '@Url.Action("Index", "TrainingRequisition")';
                }, 2000);
        }
        var dataList = {
            Details: $("#grid").data("kendoGrid").dataSource.data()
        };
        callAction({ formId: "form", title: "Submit", type: "POST" , url: '@Url.Action("Submit", "TrainingRequisition")', objects: dataList });
    });

    $('#btnApprove').click(function () {
        callAction({ formId: "form", title: "Approve", type: "POST", url: '@Url.Action("Approve", "TrainingRequisition")' });
    });

    $('#btnShow').click(function () {
        $("#RemarkRejected").attr("required", "required");
        $('#modalRemark').modal('show');
    });

    $('#btnReject').click(function () {
        callAction({ formId: "form", title: "Reject", type: "POST", url: '@Url.Action("Reject", "TrainingRequisition")' });
    });

    function ShowBonding() {
        var rev = $('#TrainingCost').data("kendoNumericTextBox").value();
        if (parseInt(rev) >= parseInt(15000000)) {
            $("#bonding_detail_div").css({ display: "block" });
        }
    }

    function GetTrainingRequisitionId() {
        return {
            Id: $("#Id").val()
        };
    }

    function OnChangeFilter_EmployeeList() {
    	$("#grid-choice-employee").data("kendoGrid").dataSource.read();
    }

    function filterSubGroup_EmployeeList() {
    	return { GroupId : $("#GroupId").data("kendoDropDownList").value() }
    }

    function filterDivision_EmployeeList() {
    	console.log("filter division by subgroup change");
    	console.log($("#SubgroupId").data("kendoDropDownList").value());
    	return { subGroupId: $("#SubgroupId").data("kendoDropDownList").value() }
    }

    function filteDept_EmployeeList() {
    	return { divisionId: $("#DivisionId").data("kendoDropDownList").value() }
    }

    function gridChoiceEmployee_params() {
    	var grpid = $("#GroupId").data("kendoDropDownList").value();
    	var subgrpid = $("#SubgroupId").data("kendoDropDownList").value();
    	var divid = $("#DivisionId").data("kendoDropDownList").value();
    	var depid = $("#DepartementId").data("kendoDropDownList").value();
    	return { FilterGroupId: grpid, FilterSubgroupId: subgrpid, FilterDivisionId: divid, FilterDepartementId: depid };
    }

    function SaveSelectedEmployee() {
        $("#grid").data('kendoGrid').dataSource.data([]);
        var allSelected = $("#grid-choice-employee tr.k-state-selected");
        var griddtlds = $("#grid").data('kendoGrid').dataSource;

        if (allSelected.length < 1) {
            swal('Warning', "At Lease Choose 1 employee, Please Choose more.", 'error');
            return;
        }
        $.each(allSelected, function (e) {
            var row = $(this);
            var grid = row.closest(".k-grid").data("kendoGrid");
            var dataItem = grid.dataItem(row);
            griddtlds.add(dataItem)
        });

        $('#modal-choice-employee').modal('toggle');
    }
</script>