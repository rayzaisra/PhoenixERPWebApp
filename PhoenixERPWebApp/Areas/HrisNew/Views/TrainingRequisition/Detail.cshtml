											}
											else if (Model.Status == PhoenixERPWebApp.Models.Enum.TrainingStatus.Approved)
											{
												<span class="m-badge m-badge--success m-badge--wide" id="lblstatus">@TrainingStatus.GetStatus(PhoenixERPWebApp.Models.Enum.TrainingStatus.Approved)</span>
											}
