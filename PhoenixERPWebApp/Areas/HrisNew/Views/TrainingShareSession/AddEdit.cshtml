@model PhoenixERPWebApp.Models.TrainingShareSession
@{
    ViewData["Title"] = "Training Share Session";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Training Share Session</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Training</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="TrainingCategory" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text">Training Share Session</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="addedit" asp-controller="TrainingCategory" asp-area="hrisnew" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div>
                                @ViewBag.Header
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="form" class="form-horizontal form-bordered" role="form" asp-action="submit" asp-controller="TrainingShareSession" asp-area="HrisNew">
                        @*enctype="multipart/form-data"*@
                        <div class="row ">
                            <div class="col-lg-12">
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" asp-for="CreatedBy" />
                                <input type="hidden" asp-for="CreatedOn" />
                                <input type="hidden" asp-for="ModifiedBy" />
                                <input type="hidden" asp-for="ModifiedOn" />
                                <input type="hidden" asp-for="ApprovedBy" />
                                <input type="hidden" asp-for="ApprovedOn" />
                                <input type="hidden" asp-for="IsActive" />
                                <input type="hidden" asp-for="IsLocked" />
                                <input type="hidden" asp-for="IsDefault" />
                                <input type="hidden" asp-for="IsDeleted" />
                                <input type="hidden" asp-for="OwnerId" />
                                <input type="hidden" asp-for="DeletedBy" />
                                <input type="hidden" asp-for="DeletedOn" />
                                <input type="hidden" asp-for="TrainerEmployeeBasicInfoId" />

                                

                                <div class="row">
                                    <div class="col-sm-3 m-form__group-sub">
                                        <div class="form-group">
                                            <label>Training Name </label><span class="req">*</span>
                                            @if (string.IsNullOrEmpty(Model.Id))
                                            {
                                                @(Html.Kendo().DropDownListFor(m => m.TrainingRequisitionId)
                                                .DataTextField("Text")
                                                .OptionLabel("Select Training Name")
                                                .DataValueField("Value")
                                                .OptionLabel("--Select--")
                                                .Filter(FilterType.Contains)
                                                .Events(evt => evt.Select("Training_SelectEvent"))
                                                .DataSource(source =>
                                                {
                                                    source.Read(read =>
                                                    {
                                                        read.Action("GetTrainingCompleted", "DropDown", new { area = "HrisNew" });
                                                    });
                                                })
                                                .HtmlAttributes(new
                                                {
                                                    style = "width:100%;",
                                                    @class = "form-control form-control-sm",
                                                    required = "required"
                                                }
                                                )
                                                )
                                            }
                                            else
                                            {
                                                @(Html.Kendo().DropDownListFor(m => m.TrainingRequisitionId)
                                                        .DataTextField("Text")
                                                        .OptionLabel("Select Training Name")
                                                        .DataValueField("Value")
                                                        .OptionLabel("--Select--")
                                                        .Filter(FilterType.Contains)
                                                        .Events(evt => evt.Select("Training_SelectEvent"))
                                                        .DataSource(source =>
                                                        {
                                                            source.Read(read =>
                                                            {
                                                                read.Action("GetTrainingCompleted", "DropDown", new { area = "HrisNew" });
                                                            });
                                                        })
                                                        .HtmlAttributes(new
                                                        {
                                                            style = "width:100%;",
                                                            @class = "form-control form-control-sm",
                                                            required = "required",
                                                        }
                                                        )
                                                        )
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="m-accordion m-accordion--bordered m-accordion--solid" id="detail" role="tablist">
                                            <!--begin::Item-->
                                            <div class="m-accordion__item">
                                                <div class="m-accordion__item-head" role="tab" id="detail_head" data-toggle="collapse" href="#detail_body" aria-expanded="true">
                                                    <span class="m-accordion__item-icon"><i class="fa flaticon-interface-4"></i></span>
                                                    <span class="m-accordion__item-title">Detail Training</span>
                                                    <span class="m-accordion__item-mode"></span>
                                                </div>
                                                <div class="m-accordion__item-body show" id="detail_body" role="tabpanel" aria-labelledby="detail_head" data-parent="#detail" style="">
                                                    <div class="m-accordion__item-content">
                                                        <div class="row">
                                                            <table id="grid_detail_training" class="table table-bordered">
                                                                <tr>
                                                                    <th>Training Name</th>
                                                                    <th>Start Date</th>
                                                                    <th>End Date</th>
                                                                </tr>
                                                                <tbody>
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="m-accordion m-accordion--bordered m-accordion--solid" id="detail" role="tablist">
                                            <!--begin::Item-->
                                            <div class="m-accordion__item">
                                                <div class="m-accordion__item-head" role="tab" id="detail_head" data-toggle="collapse" href="#detail_body" aria-expanded="true">
                                                    <span class="m-accordion__item-icon"><i class="fa flaticon-interface-4"></i></span>
                                                    <span class="m-accordion__item-title"> Training Share Session Implementation Plan</span>
                                                    <span class="m-accordion__item-mode"></span>
                                                </div>
                                                <div class="m-accordion__item-body show" id="detail_body" role="tabpanel" aria-labelledby="detail_head" data-parent="#detail" style="">
                                                    <div class="m-accordion__item-content">
                                                        <div class="row">
                                                            <div class="col-lg-4">
                                                                <label>Start Date</label> <span class="req">*</span>
                                                                @(Html.Kendo().DatePickerFor(m => m.StartDate)
                                                                    .Format("dd MMM yyyy")
                                                                    .HtmlAttributes(new
                                                                    {
                                                                        style = "height: 40px;",
                                                                        @class = "form-control",
                                                                        required = "required",
                                                                    })
                                                                )
                                                            </div>
                                                            <div class="col-lg-4">
                                                                <label>End Date</label> <span class="req">*</span>
                                                                @(Html.Kendo().DatePickerFor(m => m.EndDate)
                                                                    .Format("dd MMM yyyy")
                                                                    .HtmlAttributes(new
                                                                    {
                                                                        style = "height: 40px;",
                                                                        @class = "form-control",
                                                                        required = "required",
                                                                    })
                                                                )
                                                            </div>
                                                            <div class="col-lg-4">
                                                                <label>Note</label>
                                                                @Html.Kendo().TextBoxFor(m => m.Note).HtmlAttributes(new { @class = "form-control" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">

                                </div>

                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                                <a asp-action="index" asp-controller="TrainingShareSession" asp-area="hrisnew" class="fakelink btn btn-secondary">Close</a>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>

    $(document).ready(function () {

        var id = '@Model.Id';

        if (id != '') {
            var TrainingRequisitionId = $('#TrainingRequisitionId').val();
            $.ajax({
                type: "GET",
                dataType: "json",
                contentType: "application/x-www-form-urlencoded",
                async: false,
                data: { id: TrainingRequisitionId },
                url: "@Url.Action("GetTrainingCompletedById", "TrainingShareSession")",
                success: function (result) {
                   

                    if (result != null) {
                        $('#grid_detail_training').empty('');
                        $('#grid_detail_training').append('<thead><tr><th>Training Name</th><th> Start Date</th><th>End Date</th></tr></thead>');
                        $('#TrainingRequisitionId').val(result.TrainingRequisitionId);
                        $('#TrainerEmployeeBasicInfoId').val(result.TrainerEmployeeBasicInfoId);
                        
                        var trHTML = '';
                        trHTML += '<tr><td>' + result.TrainingName + '</td><td>' + formatDate(result.PurposeStartDate) + '</td><td>' + formatDate(result.PurposeEndDate) + '</td>';
                        $('#grid_detail_training').append(trHTML);

                    } else {
                        $('#grid_detail_training').empty('');
                        alert('Data Not Found!')
                    }
                }
            });
        }


    });


    function Training_SelectEvent(e) {

        if (e.dataItem) {
            var dataItem = e.dataItem;
            $.ajax({
                type: "GET",
                dataType: "json",
                contentType: "application/x-www-form-urlencoded",
                async: false,
                data: { id: dataItem.Value },
                url: "@Url.Action("GetTrainingCompletedById", "TrainingShareSession")",
                success: function (result) {
                    console.log(result.TrainingRequisitionId);
                    console.log(result.TrainerEmployeeBasicInfoId);
                    if (result != null) {
                        $('#grid_detail_training').empty('');
                        $('#grid_detail_training').append('<thead><tr><th>Training Name</th><th> Start Date</th><th>End Date</th></tr></thead>');
                        $('#TrainingRequisitionId').val(result.TrainingRequisitionId);
                        $('#TrainerEmployeeBasicInfoId').val(result.TrainerEmployeeBasicInfoId);
                        var trHTML = '';
                        trHTML += '<tr><td>' + result.TrainingName + '</td><td>' + formatDate(result.PurposeStartDate) + '</td><td>' + formatDate(result.PurposeEndDate) + '</td>';
                        $('#grid_detail_training').append(trHTML);

                    } else {
                        $('#grid_detail_training').empty('');
                        alert('Data Not Found!')
                    }
                }
            });
        }
    }


    function formatDate(date) {
        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        let dateObj = new Date(date);
        let month = monthNames[dateObj.getMonth()];
        let day = String(dateObj.getDate()).padStart(2, '0');
        let year = dateObj.getFullYear();
        let output = day + '-' + month + '-' + year;
        return output;
    }


    $('#btn-save').click(function () {
        callAction({ formId: "form", title: "save", type: "POST" });
    });
</script>