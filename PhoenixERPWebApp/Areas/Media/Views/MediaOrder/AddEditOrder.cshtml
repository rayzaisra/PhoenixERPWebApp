                                                            </div>

                                                        </div>

                                                        <div class="col-lg-6 col-sm-6 col-xs-12 m-form__group-sub">
                                                            @*ITEM*@
                                                            <div class="form-group row">
                                                                <label class="col-form-label col-sm-3">MO Date</label>
                                                                <div class="input-group input-group-sm col-sm-6">
                                                                    @(Html.Kendo().DatePickerFor(m => m.DateOrder).Format("dd-MMM-yyyy").HtmlAttributes(new { required = "required" }))
                                                                </div>
                                                            </div>

