<script>
    (function ($, kendo) {
        var _init = kendo.ui.Popup.fn.init;
        var Popup = kendo.ui.Popup.extend({
            init: function (element, options) {
                // Only set appendTo if nothing was manually set in the options.
                if (options.appendTo === undefined) {
                    // Find the nearest parent bootstrap modal, if any.
                    var parentModal = $(options.anchor).closest('.modal');

                    // Found one!
                    if (parentModal.length > 0) {
                        options.appendTo = parentModal[0];
                    }
                }
                // Call the base constructor.
                _init.call(this, element, options);
            }
        });
        kendo.ui.plugin(Popup);

    }(window.kendo.jQuery, window.kendo));

    function gridHistory_params() {
        return {
            id: '@Model.Id'
        };
    }

    function getUpload() {
        return $("#filesorder").data("kendoUpload");
    }

    $(document).ready(function () {

        if ($('#statusIDHeader').val() != 0) {
            $("[data-role]").each(function (index, el) {
                var widget = kendo.widgetInstance($(el));
                if (widget.enable) {
                    widget.enable(false);
                }
            });
            getUpload().disable();
            $('#Description').attr('readonly', 'readonly');
            $('.k-button').css('pointer-events', 'none');
        }

        var detailMPDetailGrid = $("#grid-order-detail").data("kendoGrid");

        $('#btn-save').click(function () {
            detailMPDetailGrid.saveRow();

            var dataList = {
                MediaOrderDetails: detailMPDetailGrid.dataSource.data()
            }
            callAction({ formId: "form-order-detail", title: "submit", type: "POST", url: '@Url.Action("Save", "mediaorder")', objects: dataList });
        });

        $('#btn-submit').click(function () {
            if ($('#CheckedFlag').val() != '') {
                detailMPDetailGrid.saveRow();
                var dataList = {
                    MediaOrderDetails: detailMPDetailGrid.dataSource.data()
                }
                
                for (var i = 0; i < dataList.MediaOrderDetails.length; i++) {
                    if (dataList.MediaOrderDetails[i].uid == $('#CheckedFlag').val())
                        dataList.MediaOrderDetails[i].IsChecked = true
                    
                }
                
                callAction({ formId: "form-order-detail", title: "submit", type: "POST", url: '@Url.Action("Submit", "mediaorder")', objects: dataList });
            } else {
                swal('warning', 'Please Tick Media Plan Detail', 'warning');
            }
            
        });


        $('#btn-approve').click(function () {
            callActionFile({ formId: "form-order-detail", title: "Approve", type: "POST", url: '@Url.Action("Approve", "mediaorder")' });
        });

        $('#btn-finish').click(function () {
            callActionFile({ formId: "form-order-detail", title: "Finish", type: "POST", url: '@Url.Action("Finish", "mediaorder")' });
        });

        @*$('#btn-revise').click(function () {
            callActionFile({ formId: "form-order-detail", title: "Reject", type: "POST", url: '@Url.Action("Reject", "mediaorder")' });
        });*@

        $('#btn-revise').click(function () {

            $("#RemarkRejected").attr("required", "required");
            $('#modalRemark').modal('show');

