                                                                                                                                                     //.ToolBar(x =>
                                                                                                                                                     //{
                                                                                                                                                     //    x.ClientTemplateId("grid-toolbar-template");
                                                                                                                                                     //})
                                                                                                                                                     .Columns(columns =>
                                                                                                                                                     {
                                                                                                                                                                                                     //columns.Select().ClientHeaderTemplate(" ").Width(100);
                                                                                                                                                                                                     columns.Bound(p => p.Id).Title("Task ID").Width(200).Hidden();
                                                                                                                                                         columns.Bound("").ClientTemplate("#= LinkToViewDetailPlan(data) #").Title("Task ID").Width(150);
                                                                                                                                                         columns.Bound(p => p.Revision).Title("Revision").Width(90);
                                                                                                                                                         columns.Bound("").ClientTemplate("#= LinktoDownload(data) #").Title("File Upload").Width(200);
                                                                                                                                                         columns.Bound(p => p.FileName).Title("File Upload").Width(140).Hidden();
                                                                                                                                                         columns.Bound(p => p.GrossAmount).Title("Sub Total Gross").Format("{0:N}").Width(140);
                                                                                                                                                         columns.Bound(p => p.NettPaid).Title("Net Paid").Format("{0:N}").Width(140);
                                                                                                                                                         columns.Bound(p => p.ASFValue).Title("ASF").Format("{0:N}").Width(130);
                                                                                                                                                         columns.Bound(p => p.NettAmount).Title("Total").Format("{0:N}").Width(150);
                                                                                                                                                         columns.Bound(p => p.VatValue).Title("VAT").Format("{0:N}").Width(150);
                                                                                                                                                         columns.Bound(p => p.TotalNettAmount).Title("Grand Total").Format("{0:N}").Width(150);
                                                                                                                                                         columns.Bound(p => p.StartPeriode).Title("Start Date").Format("{0:MM dd, yyyy}").Width(150);
                                                                                                                                                         columns.Bound(p => p.EndPeriode).Title("End Date").Format("{0:MM dd, yyyy}").Width(150);
                                                                                                                                                         columns.Bound(p => p.ASFPercent).Title("").Hidden();
                                                                                                                                                         columns.Bound(p => p.FileMasterId).Title("file id").Hidden();

                                                                                                                                                     })
                                                                                                                                                    .Scrollable(s => s.Enabled(true).Height("auto"))
                                                                                                                                                    .DataSource(dataSource => dataSource
