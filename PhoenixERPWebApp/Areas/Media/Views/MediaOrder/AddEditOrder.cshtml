
@model PhoenixERPWebApp.Models.Media.MediaOrder.MediaOrderHeader
@{
    ViewData["Title"] = "Media Order";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Media Order</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Media</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="mediaorder" asp-area="media" class="m-nav__link"><span class="m-nav__link-text">Media Order</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="addedit" asp-controller="mediaorder" asp-area="media" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> Media Order Detail</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

<div class="m-content">
    <div class="row">
        <!--NEW -->
        <div class="col-xl-12 col-lg-12">
            <!--begin::Portlet-->
            <div class="m-portlet m-portlet--last m-portlet--head-sm m-portlet--responsive-mobile" id="main_portlet">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-wrapper">
                        <div class="m-portlet__head-caption">
                            <div class="m-portlet__head-title">
                                <h3 class="m-portlet__head-text m--font-success">
                                    @if (string.IsNullOrEmpty(Model.Id))
                                    {
                                        <span>Edit Media Order Detail  &nbsp;</span>
                                    }
                                    else
                                    {
                                        <span>Edit Media Order Detail  &nbsp;</span>
                                    }

                                    @*========================= SET WORKFLOW STATUS ========================*@
                                    @if (!string.IsNullOrEmpty(Model.StatusID))
                                    {
                                        @if (Model.StatusID == @PhoenixERPWebApp.Models.Enum.MediaOrderStatus.Draft)
                                        {
                                            <span class="m-badge m-badge--info m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.MediaOrderStatus.StatusDescMedia(PhoenixERPWebApp.Models.Enum.MediaOrderStatus.Draft)</span>
                                        }
                                        else if (Model.StatusID == @PhoenixERPWebApp.Models.Enum.MediaOrderStatus.WaitingApproval)
                                        {
                                            <span class="m-badge m-badge--warning m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.MediaOrderStatus.StatusDescMedia(PhoenixERPWebApp.Models.Enum.MediaOrderStatus.WaitingApproval)</span>
                                        }
                                        else if (Model.StatusID == @PhoenixERPWebApp.Models.Enum.MediaOrderStatus.Reject)
                                        {
                                            <span class="m-badge m-badge--danger m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.MediaOrderStatus.StatusDescMedia(PhoenixERPWebApp.Models.Enum.MediaOrderStatus.Reject)</span>
                                        }
                                        else if (Model.StatusID == @PhoenixERPWebApp.Models.Enum.MediaOrderStatus.Approved)
                                        {
                                            <span class="m-badge m-badge--success m-badge--wide" id="status">Approved &nbsp;&nbsp;&nbsp;</span>
                                        }
                                        else if (Model.StatusID == @PhoenixERPWebApp.Models.Enum.MediaOrderStatus.Finish)
                                        {
                                            <span class="m-badge m-badge--success m-badge--wide" id="status">Published &nbsp;&nbsp;&nbsp;</span>
                                            @if (string.IsNullOrEmpty(Model.Remark))
                                            {
                                                <span class="m-badge m-badge--focus m-badge--wide" style="margin-left:15px; cursor:pointer" id="status" onclick="ReadyToIncoice()">Ready To Invoice</span>
                                            }
                                        }
                                        else if (Model.StatusID == @PhoenixERPWebApp.Models.Enum.MediaOrderStatus.Published)
                                        {
                                            <span class="m-badge m-badge--focus m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.MediaOrderStatus.StatusDescMedia(PhoenixERPWebApp.Models.Enum.MediaOrderStatus.Published) &nbsp; &nbsp;</span>



                                        }
                                        else
                                        {
                                            <span class="m-badge m-badge--info m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.MediaOrderStatus.StatusDescMedia(PhoenixERPWebApp.Models.Enum.MediaOrderStatus.Draft)</span>
                                        }
                                    }
                                    <span id="status"></span>
                                </h3>
                            </div>
                        </div>
                        <div class="m-portlet__head-tools">
                            <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_qf2tcah4xx"><i class="la la-expand"></i></a>
                        </div>
                    </div>
                </div>

                <input hidden name="approval_id" />

                <div class="m-portlet__body">
                    <div class="m-portlet__body" id="m_blockui_list">
                        <!--begin::Form-->
