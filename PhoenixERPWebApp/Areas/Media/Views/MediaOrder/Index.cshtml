@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Media Order</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Media</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a href="@Url.Content("~/Media/MediaOrder")" class="m-nav__link">
                        <span class="m-nav__link-text">Media Order</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item" style="width:200px">
                                @(Html.Kendo().DropDownList()
                                                       .Name("FilterStatus")
                                                       .DataTextField("Text")
                                                       .DataValueField("Value")
                                                       .Events(e => e.Change("OnChangeFilter"))
                                                       .BindTo(new List<SelectListItem>() {
                                                                         new SelectListItem() {
                                                                         Text = "All Status",
                                                                         Value = ""
                                                                         },
                                                                         new SelectListItem() {
                                                                         Text = PhoenixERPWebApp.Models.MediaPlanStatus.StatusDescMedia(PhoenixERPWebApp.Models.MediaPlanStatus.Open),
                                                                         Value = PhoenixERPWebApp.Models.MediaPlanStatus.Open.ToString()
                                                                         },new SelectListItem() {
                                                                         Text = PhoenixERPWebApp.Models.MediaPlanStatus.StatusDescMedia(PhoenixERPWebApp.Models.MediaPlanStatus.WaitingApproval),
                                                                         Value = PhoenixERPWebApp.Models.MediaPlanStatus.WaitingApproval.ToString()
                                                                         },
                                                                         new SelectListItem() {
                                                                          Text = PhoenixERPWebApp.Models.MediaPlanStatus.StatusDescMedia(PhoenixERPWebApp.Models.MediaPlanStatus.Approved),
                                                                         Value = PhoenixERPWebApp.Models.MediaPlanStatus.Approved.ToString()
                                                                         },
                                                                         new SelectListItem() {
                                                                          Text = PhoenixERPWebApp.Models.MediaPlanStatus.StatusDescMedia(PhoenixERPWebApp.Models.MediaPlanStatus.Rejected),
                                                                         Value = PhoenixERPWebApp.Models.MediaPlanStatus.Rejected.ToString()
                                                                         }

                                                       })
                                                       .HtmlAttributes(new { style = "width: 100%", @Id = "FilterStatus" })
                                )


                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">
                                    <div class="tooltip-arrow arrow" style="left: 48px;"></div>
                                    <div class="tooltip-inner">Fullscreen</div>
                                </div>

                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Media.MediaOrder.MediaOrderHeader>()
                               .Name("grid")
                               .Columns(columns =>
                               {
                                  columns.Bound("").Title("#").Width(35).Filterable(false)
                                       .HtmlAttributes(new { style = "text-align:center;", @class = "row-number" })
                                       .HeaderHtmlAttributes(new { style = "text-align:center;" });
                                   columns.Bound(p => p.Id).Hidden();
                                   columns.Bound("").ClientTemplate("#= LinktoAddEdit(data) #").Title("MO Number").Width(150);
                                   columns.Bound(p => p.MediaOrderNumber).Hidden();
                                   columns.Bound(p => p.JobIDName).Width(250);
                                   columns.Bound(p => p.TypeName).Width(200);
                                   //columns.Bound(p => p.Campaign).ClientTemplate("#= (Campaign == true)? 'Yes' : 'No' #").Width(120);
                                   columns.Bound(p => p.VendorName).Width(200);
                                   columns.Bound(p => p.SubTotal).Width(100).Title("NETT").Format("{0:N}");
                                   columns.Bound(p => p.VATValue).Width(100).Title("VAT").Format("{0:N}");
                                   columns.Bound(p => p.GrandTotal).Width(100).Title("TOTAL").Format("{0:N}");
                                   columns.Bound(p => p.StatusDesc).Width(150);
                                   columns.Bound(p => p.StatusID).Width(200).Hidden();
                                   //columns.Bound("").ClientTemplate("#= GetStatusButton(data) #").Title("Status").Width(150);
                               })
                               .Pageable(pageable => pageable
                                   .Refresh(true)
                                   .PageSizes(true)
                                   .ButtonCount(5))
                               .Sortable(srt => srt.SortMode(GridSortMode.MultipleColumn))
                               .Filterable(ftb => ftb.Mode(GridFilterMode.Menu)
                                   .Extra(false)
                                   .Operators(operators => operators
                                   .ForString(str => str.Clear()
                                       .Contains("Contains")
                                       .StartsWith("Start sWith")
                                       .EndsWith("End sWith")
                                   )))
                               .Scrollable(s => s.Enabled(true).Height("auto"))
                               .Resizable(rsz => rsz.Columns(true))
                               .DataSource(dataSource => dataSource
                                   .Ajax()
                                   .PageSize(10)
                                   .Events(events => events.Error("errorHandler"))
                                   .Model(model =>
                                   {
                                       model.Id(p => p.Id);
                                   })
                                   .Read(read => read.Action("Read", "mediaorder").Data("grid_params"))
                               )
                               //.Events(x => x.DataBound("dataBoundEvent"))
                    )
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function LinktoAddEdit(data) {
        return "<center><a href='javascript: void(0);' onclick='OpenAddEdit(this)' title='Edit' class='edit'>" + data.MediaOrderNumber + "</a></center>";
    }

    function GetStatusButton(data) {
        return "<center><a href='javascript: void(0);' onclick='OpenAddEdit(this)' title='Edit' class='edit'>" + data.StatusDesc + "</a></center>";
    }

    function grid_params() {
        return {
            status: $("#FilterStatus").data("kendoDropDownList").value()
        };
    }

    function OnChangeFilter() {
        mApp.block("#m_blockui_list", {
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        });

        var grid = $("#grid").data("kendoGrid");
        grid.dataSource.read();
        grid.refresh();
        mApp.unblock("#m_blockui_list");
    }

    function OpenAddEdit(e) {
        var item = dataItem(e);
        if (item.StatusID != "0") {
            if (item.StatusID =='1' )
               window.location.href = '@Url.Action("AddEditOrder", "mediaorder")/?planno=' + item.MediaPlanNo;
            else
                window.location.href = '@Url.Action("AddEditOrder", "mediaorder")/?planno=' + item.MediaPlanNo + '&isApprove=true';
        } else {
            window.location.href = '@Url.Action("AddEditOrder", "mediaorder")/?planno=' + item.MediaPlanNo;
        }
        
    }

</script>
