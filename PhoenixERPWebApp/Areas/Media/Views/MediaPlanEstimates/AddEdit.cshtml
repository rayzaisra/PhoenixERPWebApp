        downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download",  area="hrisnew" })', data: { id: dataItem(e).FileMasterId }});
    }

    function refreshPopup() {
        $("#revision_add_dtl").data("kendoNumericTextBox").value("0");
        $("#StartDate").data("kendoDatePicker").value("");
        $("#EndDate").data("kendoDatePicker").value("");
        $("#subgross_add_dtl").data("kendoNumericTextBox").value("");
        $("#asfamount_add_dtl").data("kendoNumericTextBox").value("");
        $("#nettpaid_add_dtl").data("kendoNumericTextBox").value("");
        $("#totalamount_add_dtl").data("kendoNumericTextBox").value("");
        $("#vatamount_add_dtl").data("kendoNumericTextBox").value("");
        $("#grandtotal_add_dtl").data("kendoNumericTextBox").value("");
    }

    function OpenPopupEditDetail(e) {
        $('.requiredvalue').css('display', 'none');
        if (parseInt($('#statusIDHeader').val()) > 1)
            $("#linkInterviewRemoveFile").empty();

        refreshPopup();
        $(".k-upload-files > li").remove();
        $('#modal-media-plan-detail').modal('show');
        $('#title-mediaplandetail-popup').val("Edit Media Plan Detail");
        var grid = $("#grid-media-plan-detail").data("kendoGrid");
        var data = grid.dataSource.get(dataItem(e).Id);

        var taskid = $("#taskid_add_detail").data("kendoTextBox");
        var revision = $("#revision_add_dtl").data("kendoNumericTextBox");
        var startDate = $("#StartDate").data("kendoDatePicker");
        var endDate = $("#EndDate").data("kendoDatePicker");
        var subGross = $("#subgross_add_dtl").data("kendoNumericTextBox");
        var tbxamountasf = $("#asfamount_add_dtl").data("kendoNumericTextBox");
        var netPaid = $("#nettpaid_add_dtl").data("kendoNumericTextBox");
        var asfPercent = $("#asf_add_dtl").data("kendoNumericTextBox");
        var tbxamounttotal = $("#totalamount_add_dtl").data("kendoNumericTextBox");
        var tbxamountvat = $("#vatamount_add_dtl").data("kendoNumericTextBox");
        var tbxamountgrandtotal = $("#grandtotal_add_dtl").data("kendoNumericTextBox");

        $("#taskid_add_detail").val(data.Id);
        revision.value(data.Revision);
        startDate.value(data.StartPeriode);
        endDate.value(data.EndPeriode);
        subGross.value(data.GrossAmount);
        tbxamountasf.value(data.ASFValue);
        netPaid.value(data.NettPaid);
        tbxamounttotal.value(data.NettAmount);
        tbxamountvat.value(data.VatValue);
        tbxamountgrandtotal.value(data.TotalNettAmount);
        asfPercent.value(data.ASFPercent);

        $("#linkInterviewDownloadFile").text(data.FileName);
        $('#fileMasterIDUpload').val(data.FileMasterId);

        var upload = $("#files").data("kendoUpload");
        var filenames = upload.wrapper.find(".k-file-name");

        for (var i = 0; i < filenames.length; i++) {
            $(filenames[i]).html("<a class='toClick'>" + data.FileName + "</a>");
        }

