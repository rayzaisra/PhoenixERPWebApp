            $("#LegalEntityID").data("kendoDropDownList").enable(false);
            $("#AffiliationID").data("kendoDropDownList").enable(false);
            $("#ClientID").data("kendoDropDownList").enable(false);
            $("#BrandID").data("kendoDropDownList").enable(false);
        }
    }

