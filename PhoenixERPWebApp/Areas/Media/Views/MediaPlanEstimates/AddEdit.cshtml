    function removeFileUpload() {
        $("#linkInterviewDownloadFile").empty();
        $("#linkInterviewRemoveFile").empty();
    }

    function downloadFileUpload() {
        downloadAction({ url: '@Url.RouteUrl(new { action = "download", controller = "Download", area = "hrisnew" })', data: { id: $('#fileMasterIDUpload').val() }});
    }

    function onComplete() {
        if ($('#fileMasterIDUpload').val() != "") {
            var valueRev = $("#revision_add_dtl").val();
            var tbxRev = $("#revision_add_dtl").data("kendoNumericTextBox");
            tbxRev.value(parseInt(valueRev) + 1);
        }

        callActionFileLocal({ formId: "formdetailplan", title: "process", type: "POST", url: "@Url.Action("UploadFile", "mediaplanestimates")" });
        $("#button").click();

    }


    function onSelect(e) {
        $(".k-upload-files > li").remove();
        $('#fileNameInfo').val(getFileInfo(e));
        removeFileUpload();
    }

    function getFileInfo(e) {
        return $.map(e.files, function (file) {
            var info = file.name;

            // File size is not available in all browsers
            if (file.size > 0) {
                info += " (" + Math.ceil(file.size / 1024) + " KB)";
            }
            return info;
        }).join(", ");
    }

