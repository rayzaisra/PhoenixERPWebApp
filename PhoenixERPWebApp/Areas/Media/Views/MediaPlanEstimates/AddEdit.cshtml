    //})


    $(document).ready(function () {
        
        if ($('#statusIDHeader').val() != "") {
            if ($('#statusIDHeader').val() != "0") {
                if ($('#statusIDHeader').val() != "1") {
                    $("[data-role]").each(function (index, el) {
                        var widget = kendo.widgetInstance($(el));
                        if (widget.enable) {
                            widget.enable(false);
                        }
                    });
                    getUpload().disable();
                    $('.k-button').css('pointer-events', 'none');
                    $("#ClientID").data("kendoDropDownList").readonly();
                    $('#btn-save-detail').css('display', 'none');
                    //var dropdownlist = $("#ClientID").data("kendoDropDownList");
                    //$(".chkbx").attr("disabled", false);
                    $('.k-radio').attr('disabled', 'disabled')
                    //dropdownlist.enable(false);
                    $(".chkbx").prop("disabled", true);
                    $(".chkbx").attr("disabled", 'disabled');
                }
            }
        } else {
            
        }

        var detailMPDetailGrid = $("#grid-media-plan-detail").data("kendoGrid");
        detailMPDetailGrid.dataSource.read();

        $('#btn-submit').click(function () {
            if ($('#CheckedFlag').val() != '') {
                detailMPDetailGrid.saveRow();
                var dataList = {
                    MediaPlanDetails: detailMPDetailGrid.dataSource.data()
                }
                callAction({ formId: "form-header-media-plan", title: "submit", type: "POST", url: '@Url.Action("Submit", "MediaPlanEstimates")', objects: dataList });
            } else {
                swal('warning', 'Please Tick Media Order Detail', 'warning');
            }
        });

        $('#btn-save').click(function () {
            
            var detailMPDetailGrid = $("#grid-media-plan-detail").data("kendoGrid");
            detailMPDetailGrid.saveRow();

            var dataList = {
                MediaPlanDetails: detailMPDetailGrid.dataSource.data()
            }
            callAction({ formId: "form-header-media-plan", title: "submit", type: "POST", url: '@Url.Action("Save", "MediaPlanEstimates")', objects: dataList });
        });

        $('#btn-approve').click(function () {
            detailMPDetailGrid.saveRow();

            var dataList = {
                MediaPlanDetails: detailMPDetailGrid.dataSource.data()
            }
            callActionFile({ formId: "form-header-media-plan", title: "Approve", type: "POST", url: '@Url.Action("Approve", "MediaPlanEstimates")', objects: dataList  });
        });

        $('#btn-revise').click(function () {

            $("#RemarkRejected").attr("required", "required");
            $('#modalRemark').modal('show');
            
        });

        $('#btnReject').click(function () {
            callActionFile({ formId: "form-header-media-plan", title: "Reject", type: "POST", url: '@Url.Action("Reject", "MediaPlanEstimates")' });
        });



        $('#btn-finish').click(function () {
            callActionFile({ formId: "form-header-media-plan", title: "Finish", type: "POST", url: '@Url.Action("Finish", "MediaPlanEstimates")' });
        });




        $("#button").kendoButton({
            click: function (e) {
                var upload = $("#files").data("kendoUpload");
                var filenames = upload.wrapper.find(".k-file-name");

                for (var i = 0; i < filenames.length; i++) {
                    $(filenames[i]).html("<a class='toClick'>" + $('#fileNameInfo').val() + "</a>");
                }
            }
        });

        var upload = $("#files").data("kendoUpload");
        var filenames = upload.wrapper.find(".k-file-name");

        upload.wrapper.on("click", ".toClick", function (e) {
            downloadFileUpload();
        });


        var reportfilename = '@Model.ReportFileName';
        if (reportfilename == '') {
            SetReportDocUpload();
        } else {
            $("#linkreportDocDownloadFile").text(reportfilename);
        }


    });


    function onChangeCurrency() {
        if ($('#CurrencyID').val() != '46e4d57e-5ce2-4c31-82be-f81382dc243a') {
            $('#Exchange').attr('readonly', false);
        } else {
            $('#Exchange').attr('readonly', 'readonly');
        }
