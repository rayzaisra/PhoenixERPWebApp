@model PhoenixERPWebApp.Models.Media.MediaPlanEstimates.MediaPlanHeader
@{
    ViewData["Title"] = "Media Plan Estimates";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Media Plan Estimates</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon fa fa-cog fa-fw"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Media</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="mediaplanestimates" asp-area="media" class="m-nav__link"><span class="m-nav__link-text">Media Plan Estimates</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="addedit" asp-controller="mediaplanestimates" asp-area="media" class="m-nav__link"><span class="m-nav__link-text"> Add New Media Plan Estimates</span></a>

                    }
                    else
                    {
                        <a asp-action="addedit" asp-controller="mediaplanestimates" asp-area="media" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>

                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<div class="modal-container"></div>
<!-- MODAL REMOTE -->
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div>
                                @ViewBag.Header
                                @if (Model.StatusID == "0" && Model.Id != "")
                                {
                                    @*<div id="status-view-mediaplan" class="btn btn-focus m-btn m-btn--air" style="background: green;font-weight: bold;font-size: 15px; margin-left:15px;">Open</div>*@
                                    <span class="m-badge m-badge--info m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.MediaOrderStatus.StatusDescMedia(PhoenixERPWebApp.Models.Enum.MediaOrderStatus.Draft)</span>
                                }

                                @if (Model.StatusID == "2")
                                {
                                    <span class="m-badge m-badge--warning m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.MediaOrderStatus.StatusDescMedia(PhoenixERPWebApp.Models.Enum.MediaOrderStatus.WaitingApproval)</span>
                                    @*<div id="status-view-mediaplan" class="btn btn-focus m-btn  m-btn--air" style="background: yellow;font-weight: bold;font-size: 15px; margin-left:15px;">Waiting Approval</div>*@
                                }

                                @if (Model.StatusID == "3")
                                {
                                    <span class="m-badge m-badge--success m-badge--wide" id="status">@PhoenixERPWebApp.Models.Enum.MediaOrderStatus.StatusDescMedia(PhoenixERPWebApp.Models.Enum.MediaOrderStatus.Approved) &nbsp;&nbsp;&nbsp;</span>
                                    @*<div id="status-view-mediaplan" class="btn btn-focus m-btn  m-btn--air" style="background: green;font-weight: bold;font-size: 15px; margin-left:15px;">Approved</div>*@
                                }
                            </div>
                        </div>
                    </div>
