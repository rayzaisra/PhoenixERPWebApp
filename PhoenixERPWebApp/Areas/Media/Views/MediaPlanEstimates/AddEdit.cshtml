                            //    ASFValue: $('#asfamount_add_dtl').val(),
                            //    NettAmount: $('#totalamount_add_dtl').val(),
                            //    VatValue: $('#vatamount_add_dtl').val(),
                            //    TotalNettAmount: $('#grandtotal_add_dtl').val(),
                            //    StartPeriode: $('#StartDate').val(),
                            //    EndPeriode: $('#EndDate').val(),
                            //};

                            //var grid = $("#grid-media-plan-detail").data("kendoGrid");
                            //var data = grid.dataSource.get($('#taskid_add_detail').val());
                            //if (data != undefined) {
                            //    var dataRow = $('#grid-media-plan-detail').data("kendoGrid").dataSource.getByUid(data.uid);
                            //    $('#grid-media-plan-detail').data("kendoGrid").dataSource.remove(dataRow);
                            //}
                            //grid.dataSource.add(newRow);

                            //$('#modal-media-plan-detail').modal('toggle');
                        //} else {
                        //    swal('Warning', result.message, 'warning');
                        //}
                        mApp.unblock("#m_blockui_list");
                    },
                    error: function (e, t, s) {
                        var errorMessage = e.responseJSON.errorMessage;
                        if (errorMessage === "" || errorMessage === undefined) {
                            errorMessage = "Ooops, something went wrong !";
                        }
                        //console.log(errorMessage);
                        console.log(errorMessage);
                        mApp.unblock("#m_blockui_list");
                    }
                }).then(setTimeout(function () {
                    mApp.unblock("#m_blockui_list");
                }, 2e3));
            }
        }
    }

    function SaveSelectedMediaDetail() {

        //$("#taskid_add_detail").val(data.PlanNo);
        var isSuccess = true;
        if ($('#StartDate').val() == '' || $('#EndDate').val() == '' || $('#subgross_add_dtl').val() == '' || $('#totalamount_add_dtl').val() == '' || $('#fileNameInfo').val() == '')
            isSuccess = false;

        if (isSuccess) {

            var newRow = {
                Id: $('#taskid_add_detail').val(),
                Revision: $('#revision_add_dtl').val(),
                FileName: $('#fileNameInfo').val(),
                FileMasterId: $('#fileMasterIDUpload').val(),
                GrossAmount: $('#subgross_add_dtl').val(),
                NettPaid: $('#nettpaid_add_dtl').val(),
                ASFValue: $('#asfamount_add_dtl').val(),
                NettAmount: $('#totalamount_add_dtl').val(),
                VatValue: $('#vatamount_add_dtl').val(),
                TotalNettAmount: $('#grandtotal_add_dtl').val(),
                StartPeriode: $('#StartDate').val(),
                EndPeriode: $('#EndDate').val(),
                IsChecked : ''
            };

            var grid = $("#grid-media-plan-detail").data("kendoGrid");
            var data = grid.dataSource.get($('#taskid_add_detail').val());
            if (data != undefined) {
                var dataRow = $('#grid-media-plan-detail').data("kendoGrid").dataSource.getByUid(data.uid);
                $('#grid-media-plan-detail').data("kendoGrid").dataSource.remove(dataRow);
            }
            grid.dataSource.add(newRow);

            $('#modal-media-plan-detail').modal('toggle');
            $(".chkbx").attr("disabled", true);
        } else {
            $('.requiredvalue').css('display', 'block');
        }
    }

    // Calculate asf and total
    function CalculateASFAndTotalAmount() {
        var grossValue = $('#subgross_add_dtl').val();
        var asfValue = $('#asf_add_dtl').val();
        if (asfValue == '')
            asfValue = 0;
        var asfAmount = (asfValue / 100) * grossValue;
        var totalAmount = parseFloat(asfAmount) + parseFloat(grossValue);
        var vatamount = (10 / 100) * parseFloat(totalAmount);

        var tbxamountasf = $("#asfamount_add_dtl").data("kendoNumericTextBox");
        var tbxamounttotal = $("#totalamount_add_dtl").data("kendoNumericTextBox");
        var tbxamountvat = $("#vatamount_add_dtl").data("kendoNumericTextBox");
        var tbxamountgrandtotal = $("#grandtotal_add_dtl").data("kendoNumericTextBox");
        tbxamountasf.value(asfAmount);
        tbxamounttotal.value(totalAmount);
        tbxamountvat.value(vatamount);
        tbxamountgrandtotal.value(parseFloat(totalAmount) + parseFloat(vatamount));
    }

