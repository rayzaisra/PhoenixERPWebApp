
<style>
    .modallargewidth {
        width: 90%;
        max-width: 1200px;
    }

    .has-danger label:not([class]) {
        color: #f4516c;
    }
</style>

<div class="modal fade" id="modal-media-plan-detail" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modallargewidth">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="title-mediaplandetail-popup"></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="formdetailplan" class="form-horizontal form-bordered" method="post" role="form" enctype="multipart/form-data">
                    <input type="hidden" id="fileNameInfo" />
                    <input type="hidden" id="fileMasterIDUpload" />
                    <div class="row ">
                        <div class="col-lg-6">

                            <div class="form-group row">
                                <label class="col-form-label col-sm-3">Task ID</label>
                                <div class="input-group input-group-sm col-sm-6">
                                    @Html.Kendo().TextBox().Name("taskid_add_detail").HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })

                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-form-label col-sm-3">Media Plan Number</label>
                                <div class="col-lg-6">
                                    @*@Html.Kendo().Upload().Name("file").Multiple(false).Events(events => events.Complete("onCompleteUpload"))*@
                                    @(Html.Kendo().Upload()
                                                                                                                    .Name("files")
                                                                                                                    .Async(a => a
                                                                                                                    .Save("SaveFileAsync", "mediaplanestimates")
                                                                                                                    .Remove("Events_Remove", "Upload")
                                                                                                                    .AutoUpload(true)
                                                                                                                    )
                                                                                                                    .Events(events => events
                                                                                                                    .Complete("onComplete").Select("onSelect")

                                                                                                                    )
                                    )
                                    <div style="width:100%">
                                        <a href='javascript: void(0);' id="linkInterviewDownloadFile" onclick='downloadFileUpload()'></a> &nbsp;
                                        <a href='javascript: void(0);' id="linkInterviewRemoveFile" onclick='removeFileUpload()' title='Delete'><span style='color:maroon'><i class='fa fa-times'></i></span></a>
                                    </div>
                                    <span id="span_netpaid" class="requiredvalue" style="color:red; display:none">File upload is required !</span>
                                    <button id="button" type="button" style="display:none">Edit</button>
                                </div>

                            </div>

                        </div>
                        <div class="col-lg-6">

                            <div class="form-group row">
                                <label class="col-form-label col-sm-3">Revision</label>
                                <div class="input-group input-group-sm col-sm-6">
                                    @Html.Kendo().IntegerTextBox().Name("revision_add_dtl").Value(0).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-form-label col-sm-3">Start Periode</label>
                                <div class="input-group input-group-sm col-sm-3">
                                    @(Html.Kendo().DatePicker().Name("StartDate")
                                                                                                                                                                                .Value(DateTime.Now)
                                                                                                                                                                                .HtmlAttributes(new { style = "width: 100%", title = "datepicker" })
                                    )
                                    <span id="span_startDateReq" class="requiredvalue" style="color:red; display:none">Start date is required !</span>
                                </div>
                                <label class="col-form-label col-sm-1">End</label>
                                <div class="input-group input-group-sm col-sm-3">
                                    @(Html.Kendo().DatePicker().Name("EndDate")
                                                                                                                                                                                                .Value(DateTime.Now)
                                                                                                                                                                                                .HtmlAttributes(new { style = "width: 100%", title = "datepicker" })
                                    )
                                    <span id="span_endDateReq" class="requiredvalue" style="color:red; display:none">End date is required !</span>
                                </div>
                            </div>



                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-6"></div>
                        <div class="col-lg-6">
                            <div class="form-group row">
                                <label class="col-form-label col-sm-3">Sub Gross Value</label>
                                <div class="input-group input-group-sm col-sm-6">
                                    @Html.Kendo().NumericTextBox().Name("subgross_add_dtl").Events(e => e
          .Change("CalculateASFAndTotalAmount")
     ).HtmlAttributes(new { @class = "form-control form-control-sm" })
                                </div>
                                <div class="col-sm-9" style="text-align:end"><span id="span_subgrossreq" class="requiredvalue" style="color:red; display:none">Sub Gross Value is required !</span></div>

                            </div>

                            <div class="form-group row">
                                <label class="col-form-label col-sm-3">ASF</label>
                                <div class="input-group input-group-sm col-sm-3">
                                    @Html.Kendo().NumericTextBox().Name("asf_add_dtl").Events(e => e.Change("CalculateASFAndTotalAmount")).HtmlAttributes(new { @class = "form-control form-control-sm"})
                                </div>
                                <div class="input-group input-group-sm col-sm-3">
                                    @Html.Kendo().NumericTextBox().Name("asfamount_add_dtl").HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-form-label col-sm-3">Net Paid</label>
                                <div class="input-group input-group-sm col-sm-6">
                                    @Html.Kendo().NumericTextBox().Name("nettpaid_add_dtl").HtmlAttributes(new { @class = "form-control form-control-sm" });
                                </div>
                                <div class="col-sm-9" style="text-align:end">
                                    <span id="span_netpaid" class="requiredvalue" style="color:red; display:none">Sub Gross Value is required !</span>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-form-label col-sm-3">Total</label>
                                <div class="input-group input-group-sm col-sm-6">
                                    @Html.Kendo().NumericTextBox().Name("totalamount_add_dtl").HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-form-label col-sm-3">VAT</label>
                                <div class="input-group input-group-sm col-sm-3">
                                    @Html.Kendo().NumericTextBox().Name("Vat").Format("p0").Value(0.10).HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                </div>
                                <div class="input-group input-group-sm col-sm-3">
                                    @Html.Kendo().NumericTextBox().Name("vatamount_add_dtl").HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                </div>
                            </div>


                            <div class="form-group row">
                                <label class="col-form-label col-sm-3">Grand Total</label>
                                <div class="input-group input-group-sm col-sm-6">
                                    @Html.Kendo().NumericTextBox().Name("grandtotal_add_dtl").HtmlAttributes(new { @class = "form-control form-control-sm", @readonly = "readonly" })
                                </div>
                            </div>

                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                @*<div class="k-edit-buttons k-state-default">
                        <a role="button" class="k-button k-button-icontext k-primary k-grid-update" href="#"><span class="k-icon k-i-check"></span>Update</a>
                        <a role="button" class="k-button k-button-icontext k-grid-cancel" href="#"><span class="k-icon k-i-cancel"></span>Cancel</a>
                    </div>*@
                <button type="button" class="btn btn-primary" id="btn-save-detail" onclick="SaveSelectedMediaDetail()">Save</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>