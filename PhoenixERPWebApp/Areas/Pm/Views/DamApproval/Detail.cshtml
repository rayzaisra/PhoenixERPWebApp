@model PhoenixERPWebApp.Models.Pm.ViewModel.DamFileShared
@{
    ViewData["Title"] = "Digital Asset Management File Share Approval Detail";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            @*<h3 class="m-subheader__title m-subheader__title--separator">Master Outlet</h3>*@
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-cart"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Digital Asset Management File Share Approval</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="DamApproval" asp-area="pm" class="m-nav__link"><span class="m-nav__link-text">Digital Asset Management File Share Approval</span></a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    @if (string.IsNullOrEmpty(Model.Id))
                    {
                        <a asp-action="detail" asp-controller="DamApproval" asp-area="pm" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                    else
                    {
                        <a asp-action="detail" asp-controller="DamApproval" asp-area="pm" asp-route-Id="@Model.Id" class="m-nav__link"><span class="m-nav__link-text"> @ViewBag.Header</span></a>
                    }
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <h3 class="m-portlet__head-text m--font-success">@ViewBag.Header Digital Asset Management File Share Approval</h3>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <form id="form-search-dt_basic_eui">
                                    <div class="input-group input-group-sm">

                                    </div>
                                </form>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <form id="formDamApproval" class="form-horizontal form-bordered" role="form" asp-action="Submit" asp-controller="DamApproval" asp-area="pm">
                        @*enctype="multipart/form-data"*@
                        <div class="row ">
                            <div class="col-lg-12">
                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" asp-for="CreatedBy" />
                                <input type="hidden" asp-for="CreatedOn" />
                                <input type="hidden" asp-for="ModifiedBy" />
                                <input type="hidden" asp-for="ModifiedOn" />
                                <input type="hidden" asp-for="ApprovedBy" />
                                <input type="hidden" asp-for="ApprovedOn" />
                                <input type="hidden" asp-for="DeletedBy" />
                                <input type="hidden" asp-for="DeletedOn" />
                                <input type="hidden" asp-for="IsActive" />
                                <input type="hidden" asp-for="IsDeleted" />
                                <input type="hidden" asp-for="IsDefault" />
                                <input type="hidden" asp-for="IsLocked" />
                                <input type="hidden" asp-for="OwnerId" />
                                <input type="hidden" asp-for="statusApproval" />
                                <div class="row m-row--col-separator-xl">
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label asp-for="file_name"></label>  :
                                            @(Html.Kendo().TextBoxFor(m => m.file_name)
                                                .HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" }))
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="job_id"></label>  :
                                            @(Html.Kendo().TextBoxFor(m => m.job_id)
                                                .HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" }))
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="share_to_name"></label>  :
                                            @(Html.Kendo().TextBoxFor(m => m.share_to_name)
                                                .HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" }))
                                        </div>

                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label asp-for="file_path"></label>  : <a id="damlink" href="" target="_blank" style="width: 100%;">View Digital Asset Management</a>
                                            @Html.TextAreaFor(x => x.file_path, new { @class = "k-textbox", style = "width: 100%;", @readonly = "readonly" })
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="requester_name"></label>  :
                                            @(Html.Kendo().TextBoxFor(m => m.requester_name)
                                                .HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" }))
                                        </div>
                                        <div class="form-group">
                                            <label asp-for="requester_on"></label>  :
                                            @(Html.Kendo().TextBoxFor(m => m.requester_on)
                                                .HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" }))
                                        </div>
                                    </div> 
                                </div>
                                <br />
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-lg-12">
                                <br />
                                <partial name="_StatusLog" />
                                <br />
                                <br />
                                <partial name="_HistoryApproval" />
                                <br />
                                <div class="pull-right">
                                    @if (Model.status == "Waiting Approval")
                                    {
                                        <button type="button" id="btn-approve" class="btn btn-primary">Approve</button>
                                        <button type="button" id="btn-reject" class="btn btn-danger">Reject</button>
                                    }
                                    <a asp-action="index" asp-controller="DamApproval" asp-area="pm" class="fakelink btn btn-secondary">Close</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(function () {
        $('#btn-reject').click(function () {
            $('#statusApproval').val('Rejected');
            callAction({ formId: "formDamApproval", title: "reject", type: "POST" });
        });

    $('#btn-approve').click(function () {
        $('#statusApproval').val('Approved');
        callAction({ formId: "formDamApproval", title: "approve", type: "POST" });
    });

    $("#damlink").attr("href", "/ProjectManagement/DigitalAssetManagement/Detail/" + $('#job_id').val());

    });
   
</script>