@model IEnumerable<PhoenixERPWebApp.Models.Pm.MyDam.MyDam>
@{
    ViewData["Title"] = "My DAM";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
    var mUserLogin = ViewBag.UserLogin as string;
}

<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">My DAM List</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-suitcase"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Project Management</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="mydam" asp-area="pm" class="m-nav__link"><span class="m-nav__link-text">My DAM List</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->
<!-- MODAL REMOTE -->
<div class="modal-container"></div>
<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            @if (ViewBag.IsAdministrator)
                            {
                                <div class="input-group input-group-sm" style="margin-left:10px">
                                    <button class="btn btn-sm btn-primary btn-form-upload"><i class="fa fa-upload"></i> Upload</button>
                                </div>
                                <div class="input-group input-group-sm" style="margin-left:10px">
                                    <button class="btn btn-sm btn-success btn-listApproval"><i class="fa fa-clipboard"></i> List Approval</button>
                                </div>
                                <div class="input-group input-group-sm" style="margin-left:10px">
                                    <button class="btn btn-sm btn-danger btn-delete"><i class="fa fa-trash"></i> Delete File</button>
                                </div>
                                <div class="input-group input-group-sm" style="margin-left:10px">
                                    <button class="btn btn-sm btn-focus btn-form-folder"><i class="fa fa-folder"></i> Create Folder</button>
                                </div>
                                <div class="input-group input-group-sm" style="margin-left:10px">
                                    <button class="btn btn-sm btn-brand btn-move"><i class="fa fa-share"></i> Move</button>
                                </div>

                            }
                            <div class="input-group input-group-sm" style="margin-left:10px">
                                <button class="btn btn-sm btn-info btn-request"><i class="fas fa-user-plus"></i> Request</button>
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="col-lg-12">
                            <div class="input-group input-group-sm">
                                @*<input type="text" id="search_val" class="form-control" placeholder="Search for...">&nbsp;*@
                                <div class="input-group-append">
                                    <button type="button" id="btn-search-val">
                                        Filter
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="m-portlet__body">
                    <div id="listView"></div>
                    <div id="pager" class="k-pager-wrap"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modalUpload" class="modal" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title title-modal-tempApp">UPLOAD TO ONE DRIVE</h4>
            </div>
            <div class="modal-body">
                <div class="m-portlet m-portlet--full-height ">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="label-block">TITLE</label>
                            <input type="text" class="form-control tb-title-name k-textbox" required/>
                        </div>
                        <div class="form-group">
                            <label>JOB NAME</label> <span class="req"></span>  :
                            @(Html.Kendo().DropDownList()
                                .Name("jobid")
                                .DataTextField("Text")
                                .DataValueField("Value")
                                .OptionLabel($"Choose Job number")
                                .HtmlAttributes(new
                                        {
                                    style = "width:100%;"
                                })
                                .Height(400)
                                .Filter(FilterType.Contains)
                                .DataSource(source => source
                                    .Custom()
                                    .Transport(transport => transport
                                    .Read(read =>
                                    {
                                        read.Action("GetDDLJobList", "Dropdown", new { area = "pm" });
                                    }))
                                    .ServerFiltering(false))
                            )
                        </div>
                        <div class="form-group">
                            <label class="label-block">Current Folder</label>
                            <input type="text" class="form-control tb-label-folder k-textbox" disabled />

                        </div>
                        <div class="form-group">
                            <div class="k-widget k-upload k-header k-upload-sync k-upload-empty">
                                <label class="label-block">SELECT FILE</label>
                                <input type="file" id="fu" placeholder="select file for upload to drive" style="width:100%" />
                                <label class="label-block label-info-fu" style="font-weight:bold"></label>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-sm btn-success btnsave-uploadTodrive"><span class="fa fa-upload"></span> Upload</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalRemark" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered " role="document" style="max-width:90%">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group detail-image">

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Close</button>
                <button type="button" id="btnDownloadFile" class="btn btn-sm btn-success"><span class="fa fa-download"></span> Download</button>
            </div>
        </div>
    </div>
</div>

<div id="modalCreateFolder" class="modal" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-sm" style="max-width:40%">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-body">
                <div class="col-md-12">
                    <h4 class="modal-title title-modal-tempApp">CREATE FOLDER</h4>
                    <div class="form-group">
                        <label class="label-block">Current Folder :</label>
                        <input type="text" class="form-control tb-label-folder" disabled />
                    </div>
                    <div class="form-group">
                        <label class="label-block">New Folder :</label>
                        <input type="text" class="form-control tb-folder-name" />
                    </div>

                    <div class="clearfix"></div>
                    
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-sm btn-success btncreate-folder"><span class="fa fa-save"></span> Save</button>
            </div>
        </div>

    </div>
</div>

<div id="modalMoveFolder" class="modal" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-sm" style="max-width:40%">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-body">
                <div class="col-md-12">
                    <h4 class="modal-title title-modal-tempApp">MOVE FOLDER</h4>
                    <div class="form-group">
                        <label class="label-block">Move To Folder :</label>
                        @(Html.Kendo().DropDownList()
                                .Name("FolderName")
                                .DataTextField("Text")
                                .DataValueField("Value")
                                .OptionLabel($"Choose Folder")
                                .HtmlAttributes(new
                                        {
                                    style = "width:100%;"
                                })
                                .Height(400)
                                .Filter(FilterType.Contains)
                                .DataSource(source => source
                                    .Custom()
                                    .Transport(transport => transport
                                    .Read(read =>
                                    {
                                        read.Action("GetDDLFolderNameMyDam", "Dropdown", new { area = "pm" });
                                    }))
                                    .ServerFiltering(false))
                        )
                    </div>


                    <div class="clearfix"></div>
                   
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-sm btn-success btnmove-folder"><span class="fa fa-share"></span> Move</button>
            </div>
        </div>

    </div>
</div>

<div id="modalFilter" class="modal" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-sm" style="max-width:40%">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-body">
                <div class="col-md-12">
                    <h4 class="modal-title title-modal-tempApp">FILTER</h4>
                    <div class="form-group">
                        <label class="label-block">Search File Name :</label>
                        <input type="text" class="form-control tb-title-name k-textbox" id="search_val" />
                    </div>
                    <div class="form-group">
                        <label class="label-block">Search Job Name :</label>
                        @(Html.Kendo().DropDownList()
                               .Name("search_job_name_mydam")
                               .DataTextField("Text")
                               .DataValueField("Value")
                               .OptionLabel($"Choose Job Name")
                               .HtmlAttributes(new
                                       {
                                   style = "width:100%;"
                               })
                               .Height(400)
                               .Filter(FilterType.Contains)
                               .DataSource(source => source
                                   .Custom()
                                   .Transport(transport => transport
                                   .Read(read =>
                                   {
                                       read.Action("GetDDLJobNameMyDam", "Dropdown", new { area = "pm" });
                                   }))
                                   .ServerFiltering(false))
                        )
                    </div>
                    <div class="form-group">
                        <label class="label-block">Search Client Name :</label>
                        @(Html.Kendo().DropDownList()
                               .Name("search_client_name_mydam")
                               .DataTextField("Text")
                               .DataValueField("Value")
                               .OptionLabel($"Choose Client Name")
                               .HtmlAttributes(new
                                       {
                                   style = "width:100%;"
                               })
                               .Height(400)
                               .Filter(FilterType.Contains)
                               .DataSource(source => source
                                   .Custom()
                                   .Transport(transport => transport
                                   .Read(read =>
                                   {
                                       read.Action("GetDDLClientNameMyDam", "Dropdown", new { area = "pm" });
                                   }))
                                   .ServerFiltering(false))
                        )
                    </div>
                    <div class="form-group">
                        <label class="label-block">Search Campaign Name :</label>
                        @(Html.Kendo().DropDownList()
                               .Name("search_campaign_name_mydam")
                               .DataTextField("Text")
                               .DataValueField("Value")
                               .OptionLabel($"Choose Campaign Name")
                               .HtmlAttributes(new
                                       {
                                   style = "width:100%;"
                               })
                               .Height(400)
                               .Filter(FilterType.Contains)
                               .DataSource(source => source
                                   .Custom()
                                   .Transport(transport => transport
                                   .Read(read =>
                                   {
                                       read.Action("GetDDLCampaignNameMyDam", "Dropdown", new { area = "pm" });
                                   }))
                                   .ServerFiltering(false))
                        )
                    </div>
                    <div class="form-group">
                        <label class="label-block">Search Job Created :</label>
                        <div class="col-md-12">
                            <label class="label-block">Start Date :</label>
                            <input type="date" class="form-control tb-title-name k-textbox" id="search_job_created_val" style="display:inline-block" />
                            <label class="label-block">End Date :</label>
                            <input type="date" class="form-control tb-title-name k-textbox" id="search_job_created_val_end" style="display:inline-block" />
                        </div>
                        


                    </div>


                    <div class="clearfix"></div>
                    
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-sm btn-success btn-search-go"><span class="fa fa-search"></span> Search</button>
            </div>
        </div>

    </div>
</div>




