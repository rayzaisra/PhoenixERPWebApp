<script>
    var selectedFiles;
    var userLogin;
    var listFolder = [];
    var labelFolder = "ROOT";
    var CurrentFolderName ="";
    $(document).ready(function () {
        userLogin = '@mUserLogin';
        CurrentFolderName = labelFolder;
        listFolder.push({ id: 0, name: 'PROJECTMANAGEMENT/DAM', link: '' });
        sessionStorage.setItem('breadcrumpod', JSON.stringify(listFolder));
        //$('body').append('<div style="" id="loadingDiv"><div class="loader">Loading...</div></div>');
        //$(window).on('load', function () {
        //    setTimeout(function () {
        //        removeLoader();
        //        GenerateThumbnail();
        //        GenerateAndWriteThumbnail();
        //    }, 2000);
        //});
        //removeLoader();
        GenerateAndWriteThumbnail();
        GenerateThumbnail();
        
        $('.tb-label-folder').val(labelFolder);
        //loadData('');
    });

    $('.btn-move').on("click", function (e) {
        $('#modalMoveFolder').modal('show');
    });

    $('.btnmove-folder').on("click", function (e) {
        e.preventDefault();
        if (selectedFiles == undefined) {
            return swal(
                'Information',
                'There is no selected files',
                'info'
            );
        }

        if ($('#FolderName').data("kendoDropDownList").value() === "") {
             return swal(
                'Information',
                'There is no selected folder',
                'info'
            );
        }

        mApp.blockPage({
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        });
        startprocess();
        $.ajax({
            type: "POST",
            url: "@Url.Action("Move", "MyDam")",
            data: { SelectedId: selectedFiles, FolderId: ($('#FolderName').data("kendoDropDownList").value()) },
            async: false,
            success: function (responseData) {
                $('#modalMoveFolder').modal('hide');
                endprocess();
                if (responseData.success) {
                    swal('Information', "Move File Success", 'success');
                    window.location.href = '@Url.Action("Index", "MyDam")';
                } else {
                    swal('Information', "Move File failed", 'error');
                    window.location.href = '@Url.Action("Index", "MyDam")';
                }

            },
            error: function (e, t, s) {
                //swal(
                //    'Information',
                //    'Ooops, something went wrong !',
                //    'info'
                //);
                endprocess();
            }
        }).then(setTimeout(function () {
            mApp.unblockPage();
        }, 2e3));
    });

    $('.btn-form-folder').on("click", function (e) {
        e.preventDefault();
        $('.tb-folder-name').val('');
        $('#modalCreateFolder').modal('show');
    });

    $('.btncreate-folder').on('click', function () {
        createFolder();
    });

    $('.btn-delete').on("click", function (e) {
        e.preventDefault();

        if (selectedFiles == undefined) {
            return swal(
                'Information',
                'There is no selected files',
                'info'
            );
        }
        swal({
            title: "Confirmation",
            text: "Do you want to delete these files?",
            type: "success",
            showCancelButton: !0,
            confirmButtonText: "Yes",
            cancelButtonText: "No",
            reverseButtons: !0,
            closeOnConfirm: false,
            closeOnCancel: false
        }).then(function (e) {
            if (e.value) {
                mApp.blockPage({
                    overlayColor: "#000000",
                    type: "loader",
                    state: "primary",
                    message: "Processing..."
                });
                startprocess();
                $.ajax({
                    type: "DELETE",
                    url: "@Url.Action("Delete", "MyDam")",
                    data: { SelectedId: selectedFiles },
                    async: false,
                    success: function (responseData) {
                        endprocess();
                        swal('Information', "Delete file", 'success');
                        window.location.href = '@Url.Action("Index", "MyDam")';
                    },
                    error: function (e, t, s) {
                        //swal(
                        //    'Information',
                        //    'Ooops, something went wrong !',
                        //    'info'
                        //);
                        endprocess();
                    }
                }).then(setTimeout(function () {
                    mApp.unblockPage();
                }, 2e3));

            } else {

            }
        });
    });

    $('.btn-request').on("click", function (e) {
        e.preventDefault();
        if (selectedFiles == undefined) {
            return swal(
                'Information',
                'There is no selected files',
                'info'
            );
        }
        swal({
            title: "Confirmation",
            text: "Do you want to request these files?",
            type: "success",
            showCancelButton: !0,
            confirmButtonText: "Yes",
            cancelButtonText: "No",
            reverseButtons: !0,
            closeOnConfirm: false,
            closeOnCancel: false
        }).then(function (e) {
            if (e.value) {
                mApp.blockPage({
                    overlayColor: "#000000",
                    type: "loader",
                    state: "primary",
                    message: "Processing..."
                });
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("Submit", "MyDam")",
                    data: { SelectedId: selectedFiles },
                    async: false,
                    success: function (responseData) {
                        swal('Information', "Send request", 'success');
                    },
                    error: function (e, t, s) {
                        //swal(
                        //    'Information',
                        //    'Ooops, something went wrong !',
                        //    'info'
                        //);
                    }
                }).then(setTimeout(function () {
                    mApp.unblockPage();
                }, 2e3));
            } else {
            }
        });
    });

    $('.btn-listApproval').on("click", function (e) {
       window.location.href = '@Url.Action("IndexApproval", "MyDam")';
    });

    $('#btn-search-val').on("click", function (e) {
        e.preventDefault();
        var searchFileName = $('#search_val').val('');
        var searchJobName = $('#search_job_name_mydam').data("kendoDropDownList").value('');
        var searchClientName = $('#search_client_name_mydam').data("kendoDropDownList").value('');
        var searchCampaignName = $('#search_campaign_name_mydam').data("kendoDropDownList").value('');
        var searchJobCreated = $('#search_job_created_val').val('');
        var searchJobCreatedEnd = $('#search_job_created_val_end').val('');
        $('#modalFilter').modal('show');
    });

    $('.btn-search-go').on("click", function (e) {
        e.preventDefault();
        var searchFileName = $('#search_val').val();
        var searchJobName = $('#search_job_name_mydam').data("kendoDropDownList").value();
        var searchClientName = $('#search_client_name_mydam').data("kendoDropDownList").value();
        var searchCampaignName = $('#search_campaign_name_mydam').data("kendoDropDownList").value();
        var searchJobCreated = $('#search_job_created_val').val();
        var searchJobCreatedend = $('#search_job_created_val_end').val();
        var searchParam = searchFileName + "::" + searchJobName + "::" + searchClientName + "::" + searchCampaignName + "::" + searchJobCreated + "::" + searchJobCreatedend + "::";
        if (searchParam !== "") {
            GenerateThumbnail(searchParam);
        } else {
            GenerateThumbnail();
        }
        $('#modalFilter').modal('hide');
    });

    function createFolder() {
        var folderName = $('.tb-folder-name').val();
        if (folderName.length === 0 || folderName === '') {
             swal(
                            'Information',
                            'Ooops, Folder Name cannot empty.',
                            'info'
                        );
            return false;
        }

        var ds = sessionStorage.getItem('breadcrumpod');
        ds = JSON.parse(ds);
        var path = "PROJECTMANAGEMENT/DAM";
        var linked = '';
        var currentFolder = CurrentFolderName;


        if (CurrentFolderName === "ROOT" || CurrentFolderName === "") {
            path = path;
        }
        else {
            path = path + "/" + CurrentFolderName;
        }

        var model = { Path: path, FolderName: folderName, Id:"mydam" };
        console.log(model);
         $('#modalCreateFolder').modal('hide');
        mApp.block("#m_blockui_list", {
            overlayColor: "#000000",
            type: "loader",
            state: "primary",
            message: "Processing..."
        });
        //$('body').append('<div style="" id="loadingDiv"><div class="loader">Loading...</div></div>');
        $.ajax({
            type: "POST",
            dataType: 'json',
            contentType: 'application/json',
            url: $.helper.resolveApi("~odrive/createfolder"),
            data: JSON.stringify(model),
            success: function (r) {
                mApp.unblock("#m_blockui_list");
                $('#modalCreateFolder').modal('hide');
                //window.location.href = '@Url.Action("Index", "MyDam")';
                //$('#modalUpload').modal('hide');
                setTimeout(function () {
                    removeLoader();
                    $.ajax({
                        type: "GET",
                        url: "@Url.Action("GetMyDAM", "MyDam")",
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        async: false,
                        success: function (responseData) {
                            $.each(responseData, function (k, v) {
                                GetImageDAM(v.FilePath);
                            });
                        }
                    });
                    GenerateThumbnail();
                    reloadPage();
                }, 3000);
                GenerateThumbnail();
                removeLoader();
            },
