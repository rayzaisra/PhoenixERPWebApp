@inject Phoenix.WebExtension.Attributes.MenuAuthorization menuAuthorization;
@model PhoenixERPWebApp.Models.Pca
@{
    if (ViewBag.processApprove == true)
    {
        ViewData["Title"] = "Production Cost Analysis Approval";
    }
    else
    {
        ViewData["Title"] = "Production Cost Analysis";
    }
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";

    var privilege = await menuAuthorization.GetPrivilege("Pm", "Pca");
    if (!privilege.IsRead && !ViewBag.IsRead) { throw new Exception("You have no authorization to the current access."); }
}

<style>
    .k-numerictextbox .k-input {
        text-align: right;
        padding-right:10px;
    }
</style>

