    function exchangeRequestDefault(value) {
        var currencyId = $("#CurrencyId").data("kendoDropDownList").value();
        if (value == currencyId) {
            $("#ExchangeRateRequest").data("kendoNumericTextBox").readonly();
            $("#OperatorRequest").data("kendoDropDownList").readonly();
            $("#OperatorRequest").data("kendoDropDownList").value("*");
            $("#ExchangeRateRequest").data("kendoNumericTextBox").value("1");
        } else {
            $("#ExchangeRateRequest").data("kendoNumericTextBox").readonly(false);
            $("#OperatorRequest").data("kendoDropDownList").readonly(false);
        }
    }

    function savetaskrequest_event(e) {
        //var TotalRequest = $("#TotalRequest").data("kendoNumericTextBox").value(); 
        //var ExchangeRate = $("#ExchangeRateRequest").data("kendoNumericTextBox").value();
        //var Operator = $("#OperatorRequest").data("kendoDropDownList").value();
        var totalOri = $("#TotalExchangeRequest").data("kendoNumericTextBox").value();//eval(TotalRequest.toString() + Operator + ExchangeRate.toString()); 

        if (totalOri > e.model.RemainingBudget) {
            swal('Warning', "the total exchange requests must be less than or equal to the remaining budget", 'warning');
            e.preventDefault();
        }
        e.model.set("TotalExchangeRequest", totalOri);
        e.model.set("CurrencySymbolExchange", $("#CurrencySymbolExchange").val())
    }

    function totalbudget_change() {
        var TotalRequest = $("#TotalRequest").data("kendoNumericTextBox").value();
        var ExchangeRate = $("#ExchangeRateRequest").data("kendoNumericTextBox").value();
        var Operator = $("#OperatorRequest").data("kendoDropDownList").value();

        if(ExchangeRate!=null && Operator!=null){
             var totalOri = eval(TotalRequest.toString() + Operator + ExchangeRate.toString()); 
             $("#TotalExchangeRequest").data("kendoNumericTextBox").value(totalOri);
        } else {
             $("#TotalExchangeRequest").data("kendoNumericTextBox").value(0);
        }
    }

    function calculaterequest_change() {
        var dataSource = $("#grid_taskRFQ").data("kendoGrid").dataSource;
        var view = dataSource.view();
        for (var i = 0; i < view.length; i++) {
            var Total = view[i].get("TotalRequest");

            if (Total!=null){
                var ExchangeRate = $("#ExchangeRateRequest").data("kendoNumericTextBox").value();
                var Operator = $("#OperatorRequest").data("kendoDropDownList").value();
                
                if(ExchangeRate!=null && Operator!=null){
                    var totalOri = eval(Total.toString() + Operator + ExchangeRate.toString());             
                    view[i].set("TotalExchangeRequest", totalOri);
                } else {     
                    view[i].set("TotalExchangeRequest", 0);
                }

                view[i].set("CurrencySymbolExchange", $("#CurrencySymbolExchange").val());
            }
        }
    }

