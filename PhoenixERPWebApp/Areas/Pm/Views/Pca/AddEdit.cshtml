                                                        <a href='javascript: void(0);' id="linkRemoveFile" onclick='removeFile()' title='Delete'><span style='color:maroon'><i class='fa fa-times'></i></span></a>
                                                    </div>
                                                </div>
                                            </div>
                                             <div class="col-lg-6">
                                                <label asp-for="OperatorRequest"></label> :
                                                <div class="form-group">
                                                  @(Html.Kendo().DropDownListFor(x => x.OperatorRequest)
                                                    .DataTextField("Text")
                                                    .DataValueField("Value")
                                                    .OptionLabel($"Choose a {Html.DisplayNameFor(m => m.OperatorRequest)}")
                                                    .Popup(x => x.AppendTo("#modalBodyRFQ"))
                                                    .HtmlAttributes(new {
                                                        style = "width:100%;"
                                                    })
                                                    .Filter(FilterType.Contains)
                                                    .Events(evt=>evt.Change("calculaterequest_change"))
                                                    .DataSource(source => source
                                                        .Custom()
                                                        .Transport(transport => transport
                                                        .Read(read =>
                                                        {
                                                            read.Action("GetDDLOperator", "Dropdown", new { area = "Pm" });
                                                        }))
                                                        .ServerFiltering(false)
                                                    ))
                                                </div>
                                            </div>
                                        </div>   
                                        
                                        <div class="row">
                                            <div class="col-lg-12 m-row--no-padding">
                                                <div class="form-group">
                                                    <label>List RFQ :</label>
                                                    @(Html.Kendo().Grid<PhoenixERPWebApp.Models.PcaTaskRequest>()
                                                        .Name("grid_taskRFQ")
                                                        .Columns(columns =>
                                                        {
                                                            columns.Command(command =>{
                                                                command.Edit().Text(" ").UpdateText(" ").CancelText(" ");
                                                            }).Title("Action").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width(90);
                                                            //columns.Bound(p => p.ItemTypeId).ClientTemplate("#if(ItemTypeId!=null){# #=ItemTypeName# #}#").EditorTemplateName("ItemTypeDropdown").Width(150);
                                                            //columns.Bound(p => p.ItemId).ClientTemplate("#if(ItemCode!=null){# #=ItemCode# - #=ItemName# #}#").EditorTemplateName("ItemIdDropdown").Width(150);
                                                            columns.Bound(p => p.Task).Width(200);
                                                            columns.Bound(p => p.Quantity).Width(100).HtmlAttributes(new { style = "text-align:right;" });
                                                            columns.Bound(p => p.UomName).Width(100);
                                                            columns.Bound(p => p.UnitPrice).ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(UnitPrice!=null){# #=kendo.format('{0:n2}', UnitPrice)# #}#").Width(150).HtmlAttributes(new { style = "text-align:right;" });
                                                            columns.Bound(p => p.TotalPrice).ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(TotalPrice!=null){# #=kendo.format('{0:n2}', TotalPrice)# #}#").Width(160).HtmlAttributes(new { style = "text-align:right;" });
                                                            columns.Bound(p => p.RemainingBudget).ClientTemplate("#if(CurrencySymbol!=null){# #=CurrencySymbol# #}# #if(RemainingBudget!=null){# #=kendo.format('{0:n2}', RemainingBudget)# #}#").Width(160).HtmlAttributes(new { style = "text-align:right;" });
                                                            columns.Bound(p => p.TotalRequest).ClientTemplate("#if(CurrencySymbolExchange!=null && TotalRequest!=null){# #=CurrencySymbolExchange# #}# #if(TotalRequest!=null){# #=kendo.format('{0:n2}', TotalRequest)# #}#").EditorTemplateName("pm/pca/TotalBudget").Width(160).HtmlAttributes(new { style = "text-align:right;" });
                                                            columns.Bound(p => p.TotalExchangeRequest).ClientTemplate("#if(CurrencySymbol!=null && TotalExchangeRequest!=null){# #=CurrencySymbol# #}# #if(TotalExchangeRequest!=null){# #=kendo.format('{0:n2}', TotalExchangeRequest)# #}#").EditorTemplateName("DecimalReadOnly").Width(160).HtmlAttributes(new { style = "text-align:right;" });
                                                        })
                                                        .Editable(x => x.Mode(GridEditMode.InLine).DisplayDeleteConfirmation(true))
                                                        .Scrollable(s => s.Enabled(true).Height("auto")).NoRecords()
                                                        .DataSource(dataSource => dataSource
                                                            .Ajax()
