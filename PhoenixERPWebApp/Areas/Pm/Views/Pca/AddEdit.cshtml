    function exchangeDefault(value) {
        if (!(value == "" || value==null)) {
            $("#ExchangeRate").data("kendoNumericTextBox").readonly(false);
            $("#Operator").data("kendoDropDownList").readonly(false);

            $("#ExchangeRate").attr('required', 'required');
            $("#Operator").attr('required', 'required');
        } else {
            $("#ExchangeRate").data("kendoNumericTextBox").readonly();
            $("#Operator").data("kendoDropDownList").readonly();

            $("#ExchangeRate").removeAttr('required');
            $("#Operator").removeAttr('required');

            $("#ExchangeRate_validationMessage").css("display", "none");
            $("#Operator_validationMessage").css("display", "none");
        }
    }

