    function visiblePopUp(isNotRateCard, isSubTask) {
        var rateCardId = $("#RateCardId").data("kendoDropDownList").value();
        if (isNotRateCard || rateCardId == '' || rateCardId == undefined) {
            $("#TaskRateCard").data("kendoDropDownList").value("");
            $("#SubTaskRateCard").data("kendoDropDownList").value("");
            $("#divTask").css({ "visibility": "visible", "position": "static" });
            $("#divSubTaskRateCard").css({ "visibility": "hidden", "position": "fixed" });
            $("#divTaskRateCard").css({ "visibility": "hidden", "position": "fixed" });

            if (isSubTask) {
                $("#divLabelTaskRateCard").css({ "visibility": "hidden", "position": "fixed" });
                $("#divLabelSubTaskRateCard").css({ "visibility": "visible", "position": "static" });
            } else {
                $("#divLabelTaskRateCard").css({ "visibility": "visible", "position": "static" });
                $("#divLabelSubTaskRateCard").css({ "visibility": "hidden", "position": "fixed" });
            }

            $("#TaskName").attr("required", true);
            $("#SubTaskRateCard").removeAttr("required");
            $("#TaskRateCard").removeAttr("required");
        } else if (isSubTask) {
            $("#TaskName").val("");
            $("#divSubTaskRateCard").css({ "visibility": "visible", "position": "static" });
            $("#divTaskRateCard").css({ "visibility": "hidden", "position": "fixed" });
            $("#divTask").css({ "visibility": "hidden", "position": "fixed" });

            $("#divLabelTaskRateCard").css({ "visibility": "hidden", "position": "fixed" });
            $("#divLabelSubTaskRateCard").css({ "visibility": "visible", "position": "static" });

            $("#SubTaskRateCard").attr("required", true);
            $("#TaskRateCard").removeAttr("required");
            $("#TaskName").removeAttr("required");
        } else {
            $("#TaskName").val("");
            $("#divTaskRateCard").css({ "visibility": "visible", "position": "static" });
            $("#divSubTaskRateCard").css({ "visibility": "hidden", "position": "fixed" });
            $("#divTask").css({ "visibility": "hidden", "position": "fixed" });

            $("#divLabelTaskRateCard").css({ "visibility": "visible", "position": "static" });
            $("#divLabelSubTaskRateCard").css({ "visibility": "hidden", "position": "fixed" });

            $("#TaskRateCard").attr("required", true);
            $("#SubTaskRateCard").removeAttr("required");
            $("#TaskName").removeAttr("required");
        }
    }
    
