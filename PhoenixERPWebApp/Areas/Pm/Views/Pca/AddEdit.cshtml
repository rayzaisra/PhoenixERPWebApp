                                            <div class="form-group">
                                                @(Html.Kendo().NumericTextBoxFor(m => m.Subtotal)
                                                    .Spinners(false)
                                                    .Format("{0:N2}")
                                                    .HtmlAttributes(new
                                                    {
                                                        style = "width:100%",
