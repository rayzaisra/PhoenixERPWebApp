        {
            <a href="javascript: void(0);" onclick="addTreeListRow(this)" title="Add Child" class="add"><span style="color:green"><i class="fa fa-plus"></i></span></a>
        }
    #}#

    @if (privilege.IsEdit)
    {
        <a href="javascript: void(0);" onclick="editTreeListRow(this)" title="Edit" class="edit"><span style="color:green"><i class="fa fa-edit"></i></span></a>
