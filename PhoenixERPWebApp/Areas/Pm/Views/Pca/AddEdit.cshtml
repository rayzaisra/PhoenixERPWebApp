    function isValid() {
        var valid = $("#formPca").validate().form();
        if (valid) {
            var costAnalysis = parseFloat($("#CostAnalysis").val());//total cost
            var totalMotherPCA = parseFloat($("#TotalMotherPCA").val());

            if (costAnalysis > totalMotherPCA) {
                swal('Warning', "The total cost cannot be greater than the total mother PCA", 'warning');
                return false;
            }

            var taskList = $("#treelist").data("kendoTreeList").dataSource.data();
            if (taskList.length == 0) {
                swal('Warning', "Please input task list", 'warning');
                return false;
            }

            var models = $("#treelist").data("kendoTreeList").dataSource.data();
            var task = models.filter((x) => { return x.ParentId==null });

            var messageTaskName = "";
            $.each(task, function (index, data) {
                var total = data.Cost;
                var subTask = models.filter((x) => { return x.ParentId == data.Id });

                if (subTask.length > 0) {
                    var subTotal = 0;
                    $.each(subTask, function (indexSub, dataSub) {
                        subTotal += dataSub.Cost;
                    });

                    if (total != subTotal) {
                        if (messageTaskName != "") messageTaskName += ", ";
                        messageTaskName += data.TaskName;
                    }
                }
            });

            if (messageTaskName != "") {
                swal('Warning', "Total cost task is not the same as the total cost sub task.please check again for the following task : " + messageTaskName , 'warning');
                return false;
            }
            
            var taskCurrency = models.filter((x) => { return x.CurrencyId != null && x.TotalOriginal == null });
            if (taskCurrency.length > 0){
                if (models.length != taskCurrency.length) {
                    swal('Warning', "PCA task for exchange currency cannot be empty. Double check all PCA tasks for which the exchange currency is empty", 'warning');
                    return false;
                }
            }
            
            return true;
        } else {
            return false;
        }
    }

