    function calculateMargin_change() {
        var Quantity = $("#Quantity").data("kendoNumericTextBox").value();
        var Price = $("#Price").data("kendoNumericTextBox").value();
        var Ppn = $("#Ppn").data("kendoNumericTextBox").value();
        var Asf = $("#Asf").data("kendoNumericTextBox").value();
        var Pph = $("#Pph").data("kendoNumericTextBox").value();
        var Percentage = $("#Percentage").data("kendoNumericTextBox").value();
        var Margin = $("#Margin").data("kendoNumericTextBox").value();

        var Cost = Quantity * (Price + Ppn + Asf + Pph);
        //var Margin = (Cost * Percentage) / 100; //Math.round((Cost * Percentage)/100);
        var UnitPrice = Price + Ppn + Asf + Pph + (Margin / Quantity);
        var Total = Quantity * UnitPrice;
        var percent = Margin * 100 / Cost;
        $("#Cost").data("kendoNumericTextBox").value(Cost);
        $("#Percentage").data("kendoNumericTextBox").value(percent);
        $("#UnitPrice").data("kendoNumericTextBox").value(UnitPrice);
        $("#Total").data("kendoNumericTextBox").value(Total);


        //new request
        var ExchangeRate = $("#ExchangeRate").data("kendoNumericTextBox").value();
        var Operator = $("#Operator").data("kendoDropDownList").value();

        if (Operator != "" && Total != null && ExchangeRate != null) {
            var totalOri = eval(Total.toString() + Operator + ExchangeRate.toString());
            $("#TotalOriginal").data("kendoNumericTextBox").value(totalOri);
        }
    }

    function calculate_change() {
        var Quantity = $("#Quantity").data("kendoNumericTextBox").value();
        var Price = $("#Price").data("kendoNumericTextBox").value();
        var Ppn = $("#Ppn").data("kendoNumericTextBox").value();
        var Asf = $("#Asf").data("kendoNumericTextBox").value();
        var Pph = $("#Pph").data("kendoNumericTextBox").value();
        var Percentage = $("#Percentage").data("kendoNumericTextBox").value();
         
        var Cost = Quantity * (Price + Ppn + Asf + Pph);
        var Margin = (Cost * Percentage) / 100; //Math.round((Cost * Percentage)/100);
        var UnitPrice = Price + Ppn + Asf + Pph + (Margin / Quantity);
        var Total = Quantity * UnitPrice; 

        $("#Cost").data("kendoNumericTextBox").value(Cost);
        $("#Margin").data("kendoNumericTextBox").value(Margin);
        $("#UnitPrice").data("kendoNumericTextBox").value(UnitPrice); 
        $("#Total").data("kendoNumericTextBox").value(Total);


        //new request
        var ExchangeRate = $("#ExchangeRate").data("kendoNumericTextBox").value();
        var Operator = $("#Operator").data("kendoDropDownList").value();

        if (Operator != "" && Total != null && ExchangeRate!=null) {
            var totalOri = eval(Total.toString() + Operator + ExchangeRate.toString());
            $("#TotalOriginal").data("kendoNumericTextBox").value(totalOri);            
        }
    }

    function calculateOtherFee_change() {
        var models = $("#treelist").data("kendoTreeList").dataSource.data();
        var totalCost = 0;
        var subTotal = 0;
        var totalPrice = 0;
        var subTotalForAsf = 0;

        $.each(models, function (index, data) {
            if (data.ParentId == null) {
                if (data.Total == null) data.Total = 0;
                if (data.Cost == null) data.Cost = 0;
                if (data.TotalPrice == null) data.TotalPrice = 0;

                if (data.IsAsf == true) {
                    subTotalForAsf += data.Total;
                }

                subTotal += data.Total;
                totalCost += data.Cost;
                totalPrice += data.TotalPrice; 
            }
        });

        CalculateAll(totalCost, subTotal, subTotalForAsf, totalPrice);        
    }
    
    function CalculateAll(totalCost, subTotal, subTotalForAsf, totalPrice) {
        var otherFeePercentage = $("#OtherFeePercentage").data("kendoNumericTextBox").value();
        var otherFee = (subTotalForAsf * otherFeePercentage) / 100; //Math.round((subTotalForAsf * otherFeePercentage) / 100);
        var vat = 0.1 * (subTotal + otherFee); //Math.round(0.1 * (subTotal + otherFee));
        var grandTotal = (subTotal + otherFee) + vat;
        var margin = (subTotal + otherFee) - totalCost;

        $("#Subtotal").data("kendoNumericTextBox").value(subTotal);
        $("#OtherFee").data("kendoNumericTextBox").value(otherFee);
        $("#Vat").data("kendoNumericTextBox").value(vat);
        $("#GrandTotal").data("kendoNumericTextBox").value(grandTotal);
        $("#lblCostEstimation").html(kendo.format("{0:N2}", totalCost));
        $("#hdPCAMargin").val(margin);
        $("#CostAnalysis").val(totalCost);
        $("#TotalTaskPrice").val(totalPrice);
        $("#TotalTaskPriceUsed").val(0);
        $("#TotalTaskPriceBalance").val(totalPrice);
    }
        
