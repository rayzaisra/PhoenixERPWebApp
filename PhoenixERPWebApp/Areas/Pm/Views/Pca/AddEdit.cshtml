<style>
    .modallargewidth {
        width: 90%;
        max-width: 1200px;
    } 
</style>
<script>    
    $(document).ready(function () {
        if ("@ViewBag.isRequestor" == "False") {
            $("#JobId").data("kendoDropDownList").readonly();
            $("#MotherPcaId").data("kendoDropDownList").readonly();
            $("#RateCardId").data("kendoDropDownList").readonly();
            $("#CurrencyId").data("kendoDropDownList").readonly();
            $("#TypeOfExpenseId").data("kendoDropDownList").readonly();
            $("#MainserviceCategoryId").data("kendoDropDownList").readonly();
            $("#ShareservicesId").data("kendoDropDownList").readonly();
            $("#OtherFeeName").data("kendoDropDownList").readonly(); 

            $("#Termofpayment1").attr('readonly', 'readonly');
            $("#Termofpayment2").attr('readonly', 'readonly');
            $("#Termofpayment3").attr('readonly', 'readonly');
            $("#OtherFeePercentage").data("kendoNumericTextBox").readonly();

            $("#MasterOutletId").data("kendoDropDownList").readonly(); 
        } else {
            var models = $("#treelist").data("kendoTreeList").dataSource.data();
            $("#RateCardId").data("kendoDropDownList").readonly((models.length > 0));
        }

        if ('@Model.CurrencySymbol' !='') {
            $("#lblCurrencySymbol").html('@Model.CurrencySymbol');
        }

        if ('@Model.CostAnalysis' != '') {
            $("#lblCostEstimation").html(kendo.format("{0:N2}", @Model.CostAnalysis));
        }
               
        Outlet("@Model.TypeOfExpenseId");

        var fileName = '@Model.DetailSpecFile';
         if (fileName == '') {
            Files();
         } else {
            $("#linkDownloadFile").text(fileName);
         }

         if ("@ViewBag.IsApprove" == "False") {
             $("#linkRemoveFile").empty();
         }
    });

    function shareservices_databound() {
        if ("@ViewBag.isRequestor" == "False") {
            $("#ShareservicesId").data("kendoDropDownList").readonly();
        }
    }

    function Files() {
        $("#divDownloadFile").remove();
        $("#divFile").empty().append("<input name='file' id='file' type='file' />");

        $("#file").kendoUpload({
            multiple: false,
            validation: {
                maxFileSize: 5000000,
                allowedExtensions: [".doc", ".pdf", ".docx",".png",".jpg",".jpeg"]
            }
        });
    }

    
    function removeFile() {
        Files();
    }

    function downloadFile() {
        downloadAction({url: '@Url.RouteUrl(new { action = "download", controller = "Download" })',data: { id: '@Model.DetailSpecFile' }});
    }

    function shareService_params() {
        return {
            MainserviceCategoryId: $("#MainserviceCategoryId").val()
        }
    }

    function treeList_params() {
        return {
            pceId: "@Model.Id"
        };
    }
        
    function currencyHeader_params() {
        return {
            headerCurrencyId: $("#CurrencyId").data("kendoDropDownList").value()
        };
    }

    function Job_SelectEvent(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            
            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $("#CompanyId").val("");
            $("#CompanyName").val("");
            $("#ClientBrand").val("");

            $.ajax({
                type: "GET",
                dataType: "json",
                contentType: "application/x-www-form-urlencoded",
                async: false,
                data: { jobId: dataItem.Value },
                url: "@Url.Action("getclient", "pca")",
                success: function (result) {
                    if (result != null) {
                        $("#CompanyId").val(result.CompanyId);
                        $("#CompanyName").val(result.CompanyName);
                        $("#ClientBrand").val(result.BrandName);
                        $("#MainserviceCategoryId").data("kendoDropDownList").value(result.MainServiceCategory);
                        if (result.IsPMTeam == false) {
                            $("#btnSave").css({ "visibility": "hidden", "position": "fixed" });
                            $("#btnSubmit").css({ "visibility": "hidden", "position": "fixed" });
                            $("#btnDelete").css({ "visibility": "hidden", "position": "fixed" });
                        } else {
                            $("#btnSave").css({ "visibility": "visible", "position": "static" });
                            $("#btnSubmit").css({ "visibility": "visible", "position": "static" });
                            $("#btnDelete").css({ "visibility": "visible", "position": "static" });
                        }

                        if ($("#TypeOfExpenseId").data("kendoDropDownList").value() == "@PhoenixERPWebApp.Models.TypeOfExpenseOutlet.TypeOfExpenseId") { 
                            $("#MasterOutletId").data("kendoDropDownList").dataSource.read(); 
                        } 
                    }
                },
                error: function (e, t, s) {
                    //console.log(e)
                    console.log(e);
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
            }, 2e3));
        }
    }

    function motherPCA_SelectEvent(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;

            mApp.block("#m_blockui_list", {
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            });

            $.ajax({
                type: "GET",
                dataType: "json",
                contentType: "application/x-www-form-urlencoded",
                async: false,
                data: {motherPcaId: dataItem.Value },
                url: "@Url.Action("getmotherpca", "pca")",
                success: function (result) {
                    if (result != null) {
                        $("#TotalMotherPCA").val(result.Total);
                    }
                },
                error: function (e, t, s) {
                    //console.log(e)
                    console.log(e);
                    mApp.unblock("#m_blockui_list");
                }
            }).then(setTimeout(function () {
                mApp.unblock("#m_blockui_list");
            }, 2e3));
        }
    }

    function typeOfExpense_SelectEvent(e) {
        if (e.dataItem) {
            var dataItem = e.dataItem;
            $("#MasterOutletId").data("kendoDropDownList").value("");
            $("#MasterOutletLocation").val("");
            Outlet(dataItem.Value);            
        }
    }

    function Outlet(TypeOfExpenseId) {
        if (TypeOfExpenseId == "@PhoenixERPWebApp.Models.TypeOfExpenseOutlet.TypeOfExpenseId") {
            $(".outlet").css("display", "block");
            $("#MasterOutletId").data("kendoDropDownList").dataSource.read();
            //$("#MasterOutletId").attr("required", "required");
        } else {
            $(".outlet").css("display", "none");
            //$("#MasterOutletId").removeAttr("required", "required");
        }
    }

    function saveTreeList_Event(e) {
        var Quantity = $("#Quantity").data("kendoNumericTextBox").value();
        var Price = $("#Price").data("kendoNumericTextBox").value();
        var Ppn = $("#Ppn").data("kendoNumericTextBox").value();
        var Asf = $("#Asf").data("kendoNumericTextBox").value();
        var Pph = $("#Pph").data("kendoNumericTextBox").value();
        var Percentage = $("#Percentage").data("kendoNumericTextBox").value();
        var totalPrice = Price * Quantity;
        var totalPriceUsed = 0;
        if (e.model.TotalPriceUsed != null) totalPriceUsed = e.model.TotalPriceUsed;
        var totalPriceBalance = totalPrice - totalPriceUsed;

        if (Ppn == null) Ppn = 0;
        if (Asf == null) Asf = 0;
        if (Pph == null) Pph = 0;

        e.model.set("Quantity", Quantity);
        e.model.set("Price", Price);
        e.model.set("TotalPrice", totalPrice);
        e.model.set("TotalPriceUsed", totalPriceUsed);
        e.model.set("TotalPriceBalance", totalPriceBalance);
        e.model.set("Ppn", Ppn);
        e.model.set("Asf", Asf);
        e.model.set("Pph", Pph);
        e.model.set("Percentage", Percentage);
               
