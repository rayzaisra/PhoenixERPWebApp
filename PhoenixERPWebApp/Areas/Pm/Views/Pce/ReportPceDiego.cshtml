@{
    ViewData["Title"] = "Report Pce Diego";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}



    <div class="m-content">
        <div class="row">
            <div class="col-md-12">
                <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                    <div class="m-portlet__head">
                        <div class="m-portlet__head-caption">
                            <div class="m-portlet__head-title">

                            </div>
                        </div>
                        <div class="m-portlet__head-tools">
                            <div class="btn-group" role="group">
                                <div class="col-lg-12">
                                    <form id="form-search-dt_basic_eui">
                                        <div class="input-group input-group-sm">

                                        </div>
                                    </form>
                                </div>
                            </div>
                            <ul class="m-portlet__nav">
                                <li class="m-portlet__nav-item">
                                    <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                    <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="m-portlet__body" id="m_blockui_list">
                         

                        @(Html.Kendo().Grid<PhoenixERPWebApp.Models.Pm.Report.ReportPCEDiego>()
                                      .Name("grid")

                                      .Columns(column =>
                                      {
                                          column.Bound("").Title("No").Width(30).ClientTemplate("#= renderNumber(data) #");
                                          column.Bound(p => p.Month).Width(150).Format("{0:dd-MM-yyyy}");
                                          column.Bound(p => p.Nature).Width(150);
                                          column.Bound(p => p.PeNumber).Width(150).Title("Pe Number");
                                          column.Bound(p => p.Status).Width(150);
                                          column.Bound(p => p.Brand).Width(150);
                                          column.Bound(p => p.PIC).Width(150);
                                          column.Bound(p => p.BudgetOwner).Width(150).Title("Budged Owner");
                                          column.Bound(p => p.CoreActivityDescription).Width(150).Title("Core Activity Description");
                                          column.Bound(p => p.Description).Width(150);
                                          column.Bound(p => p.Total).Width(150).Format("{0:n2}");
                                          column.Bound(p => p.Asf).Width(150).Format("{0:n2}");
                                          column.Bound(p => p.Vat).Width(150).Format("{0:n2}");
                                          column.Bound(p => p.GrandTotalIdr).Width(150).Format("{0:n2}").Title("Grand Total Idr");
                                          column.Bound(p => p.GrandTOtalUsd).Width(150).Format("{0:n2}").Title("Grand TOtal Usd");
                                      })
                                      .ToolBar(tools => tools.Excel())
                                     .Excel(excel => excel
                                        .FileName("ReportPceDiego.xlsx")
                                        .Filterable(true)
                                        .AllPages(true)
                                        .ProxyURL(Url.Action("Excel_Export_Save", "TimeSheetGridReport"))
                                    )
                                    .NoRecords()
                                    .Scrollable(s => s.Enabled(true).Height("auto"))
                                    .Resizable(rsz => rsz.Columns(true))
                                              .Events(a => a.DataBound("gridDatabound"))
                                              .DataSource(dataSource => dataSource
                                              .Ajax()
                                              //.PageSize(10)
                                              .Read(read => read.Action("GetReportPceDiego", "pce").Data("grid_report_params"))
                                       )
                        )
                    </div>
                </div>
            </div>
        </div>
    </div>


<script type="text/javascript">


    var rowNumber = 0;
     function gridDatabound() {
        rowNumber = 0;
    }
    function renderNumber(data) {
        return ++rowNumber;
    }

    function grid_report_params() {
        //var legal = $("#LegalEntity").data("kendoDropDownList").value();
        //var div = $("#BusinessUnitId").data("kendoDropDownList").value();
        //var year = $("#FiscalYearsId").data("kendoDropDownList").value();

        return {

            //LegalEntityId: legal,
            //BusinessUnitId: div,
            //FiscalYearsId: year,
            ClientId: $("#ClientId").val()


        }


    }

</script>