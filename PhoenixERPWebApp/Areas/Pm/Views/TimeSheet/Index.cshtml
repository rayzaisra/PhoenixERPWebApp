                        @*<div class="col-lg-4">
                                                <label>Choose Date</label>:
                                                @(Html.Kendo().DatePicker()
                                                     .Name("timesheetdate")
                                                     .Value(DateTime.Now)
                                                     .HtmlAttributes(new { style = "width: 50%", title = "datepicker" })
                                                     .Min(DateTime.Now.AddDays(-7))
