                                {
                                    @Html.Kendo().TextBox().Name("timesheetdate").Value(ViewBag.CreatedOn).HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" })
                                }
                                else
                                {
                                    @(Html.Kendo().DatePicker()
                                                                    .Name("timesheetdate")
