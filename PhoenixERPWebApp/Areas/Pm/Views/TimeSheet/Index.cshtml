                                    )
                                }*@
                            @(Html.Kendo().DatePicker()
                                                                .Name("timesheetdate")
                                                                .Value(DateTime.Today)
                                                                .HtmlAttributes(new { style = "width: 50%", title = "datepicker" })
                                                                .Min(DateTime.Now.AddDays(-30))
                                                                .Max(DateTime.Now.AddDays(+14))
                                                                .Events(e =>
