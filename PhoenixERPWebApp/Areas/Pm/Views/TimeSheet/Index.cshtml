                        <input type="hidden" id="TimesheetId" value="@Model.id" />
                        <input type="hidden" id="ApprovalId" value="@Model.ApprovalId" />
                        <input type="hidden" id="NameDivision" value="@ViewBag.Division" />
                        <input type="hidden" id="IdDivision" value="@ViewBag.DivisionId" />
                        <input type="hidden" id="DateToday" value="@ViewBag.DateToday" />
                        <div class="col-lg-4">
                            <label>Name</label>:
                            @Html.Kendo().TextBox().Name("EmployeeName").Value(ViewBag.Name).HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" })
                        </div>

                        <div class="col-lg-4" style="display:none">
                            <label>Department</label>:
                            @(Html.Kendo().DropDownList()
                                .Name("BusinessUnit")
                                .DataTextField("Text")
                                .DataValueField("Value")
                                .Filter(FilterType.Contains)
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetDDLDepartment", "Dropdown", new { area = "Pm" });
                                    });
                                })

                                .HtmlAttributes(new { style = "width:100%;", required = "required" })
                            )
                        </div>
                        <div class="col-lg-4">
                            <label>Division</label>:
                            @if (Model.ApprovalId != "" || Model.Status == "2")
                            {
                                @Html.Kendo().TextBox().Name("Division").Value(ViewBag.Division).HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" })
                            }
                            else
                            {
                                @(Html.Kendo().DropDownList()
                             .Name("Division")
                             .DataTextField("Text")
                             .DataValueField("Value")
                             .BindTo(new List<SelectListItem>() {
                                 new SelectListItem() {
                                     Text = ViewBag.Division, Value = ViewBag.DivisionId
                                 }
                             })
                             .HtmlAttributes(new { style = "width:100%;", required = "required", @readonly = "readonly" })
                                )
                            }

                        </div>
