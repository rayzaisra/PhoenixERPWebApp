    function totalAllHours() {
        var data1 = totalSunday();
        var data2 = totalMonday();
        var data3 = totalTuesday();
        var data4 = totalWednesday();
        var data5 = totalThursday();
        var data6 = totalFriday();
        var data7 = totalSaturday();
        var summary = minTommss(data1 + data2 + data3 + data4 + data5 + data6 + data7)
        return summary;
    }
    function minTommss(minutes) {
        var sign = minutes < 0 ? "-" : "";
        var min = Math.floor(Math.abs(minutes))
        var sec = Math.floor((Math.abs(minutes) * 60) % 60);
        return sign + (min < 10 ? "0" : "") + min + ":" + (sec < 10 ? "0" : "") + sec;
    }

