    function getDate(startDate, endDate) {
        var dates = [],
            currentDate = startDate,
            addDays = function (days) {
                var date = new Date(this.valueOf());
                date.setDate(date.getDate() + days);
                return date;
            };
        while (new Date(currentDate) <= new Date(endDate)) {
            dates.push(currentDate);
            currentDate = addDays.call(currentDate, 1);
        }
        return dates;
    };

    function onDataBinding() {

        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
        ];
        var grid = $("#TimeSheet").data("kendoGrid");
        //console.log(grid.dataSource.data()[0]);
        //console.log('start datenya ' + grid.dataSource.data()[0]['start_date']);
        //console.log('end datenya ' + grid.dataSource.data()[0]['end_date']);
        //console.log('idnya ' + grid.dataSource.data()[0]['id']);
        try {
            var date = getDate(new Date(grid.dataSource.data()[0]['start_date']), new Date(grid.dataSource.data()[0]['end_date']))
            if (date.length != 0) {
                if (date.length == 1) {
                    var sunday = getSunday(date[0]);

                    if (sunday.getDate() == date[0].getDate()) {
                        $("#TimeSheet thead [data-field=Sunday] .k-link").html(date[0].getDate() + '-' + monthNames[date[0].getMonth()]);
                    } else {
                        $("#TimeSheet thead [data-field=Sunday] .k-link").html(sunday.getDate() + '-' + monthNames[sunday.getMonth()]);
