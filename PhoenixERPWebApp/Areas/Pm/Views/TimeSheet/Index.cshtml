@*@model System.Data.DataTable*@
@model PhoenixERPWebApp.Models.ProjectManagement.Timesheet
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
    DateTime dt = DateTime.Parse(ViewBag.DateToday);

    var culture = System.Threading.Thread.CurrentThread.CurrentCulture;
    var diff = dt.DayOfWeek - culture.DateTimeFormat.FirstDayOfWeek;
    if (diff < 0)
    {
        diff += 7;
    }

    var startFirstDayofWeek = dt.AddDays(-diff).Date;
    string sstartFirstDayofWeek = startFirstDayofWeek.ToString("yyyy-MM-dd");

}
<!-- BEGIN: Subheader -->
