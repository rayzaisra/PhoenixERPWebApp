                                  //columns.Bound(b => b.Status).Hidden(true);
                                  //columns.Bound(b => b.job_id).Hidden(true);
                                  columns.Bound(b => b.company_id).Title("Client").EditorTemplateName("Pm/Timesheet/CompanyDropdown").ClientTemplate("#=company_name#").Width("250px").Filterable(false);
                                  columns.Bound(b => b.job_name).Width("250px");
                                  columns.Bound(b => b.job_id).Title("Job Number").Width("250px");
                                  //columns.Bound(b => b.non_job_name).Width("125px");
                                  columns.Bound(b => b.NonJobId).EditorTemplateName("Pm/Timesheet/NonJobDropDown").ClientTemplate("#=non_job_name#").Width("250px").Filterable(false);
                                  columns.Bound(b => b.start_date).Hidden(true);
                                  columns.Bound(b => b.end_date).Hidden(true);
                                  columns.Bound(b => b.Sunday).ClientFooterTemplate("#=minTommss(totalSunday())#").Width("100px").Filterable(false);
                                  columns.Bound(b => b.Monday).ClientFooterTemplate("#=minTommss(totalMonday())#").Width("100px").Filterable(false);
                                  columns.Bound(b => b.Tuesday).ClientFooterTemplate("#=minTommss(totalTuesday())#").Width("100px").Filterable(false);
                                  columns.Bound(b => b.Wednesday).ClientFooterTemplate("#=minTommss(totalWednesday())#").Width("100px").Filterable(false);
                                  columns.Bound(b => b.Thursday).ClientFooterTemplate("#=minTommss(totalThursday())#").Width("100px").Filterable(false);
                                  columns.Bound(b => b.Friday).ClientFooterTemplate("#=minTommss(totalFriday())#").Width("100px").Filterable(false);
                                  columns.Bound(b => b.Saturday).ClientFooterTemplate("#=minTommss(totalSaturday())#").Width("100px").Filterable(false);
                                  columns.Command(cmd =>
                                  {
                                      cmd.Edit();
                                  }).Title("Action").ClientFooterTemplate("Total: #=totalAllHours()#").Width("100px");
                                  columns.Bound(p => p.id).ClientTemplateId("btnAction-template").Title("Delete Non Job").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width("100px");

                              })
                              .ToolBar(t =>
                              {
                                  t.Create().Text("Add Non Job");

                              })
                              .Pageable()
                              .Resizable(rsz => rsz.Columns(true))
                              .Sortable()
                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                              .Filterable(filter =>
{
    filter.Extra(false);
    filter.Operators(op =>
    {
        op.ForString(str =>
        {
            str.Clear().Contains("Contains");
        });
    });
})
                              .Groupable()
                              .Scrollable()
                              .Events(e => e.DataBinding("onDataBinding").Edit("onEdit"))
                              .DataSource(dataSource => dataSource
                                  .Ajax().Events(e => e.Sync("endRequest"))
                                  .Model(model =>
                                  {
                                      model.Id(p => p.id);
                                      model.Field(p => p.id);
                                      model.Field(m => m.start_date).DefaultValue(DateTime.Parse(sstartFirstDayofWeek));
                                      model.Field(m => m.end_date).DefaultValue(DateTime.Parse(sstartFirstDayofWeek).AddDays(6));
                                      model.Field(m => m.job_id);
                                      model.Field(m => m.company_name);
                                      model.Field(m => m.job_name);
                                      model.Field(m => m.non_job_name);
                                      model.Field(m => m.NonJobId);
                                      model.Field(m => m.Sunday).DefaultValue(DateTime.Parse(sstartFirstDayofWeek));
                                      model.Field(m => m.Monday).DefaultValue(DateTime.Parse(sstartFirstDayofWeek).AddDays(1));
                                      model.Field(m => m.Tuesday).DefaultValue(DateTime.Parse(sstartFirstDayofWeek).AddDays(2));
                                      model.Field(m => m.Wednesday).DefaultValue(DateTime.Parse(sstartFirstDayofWeek).AddDays(3));
                                      model.Field(m => m.Thursday).DefaultValue(DateTime.Parse(sstartFirstDayofWeek).AddDays(4));
                                      model.Field(m => m.Friday).DefaultValue(DateTime.Parse(sstartFirstDayofWeek).AddDays(5));
                                      model.Field(m => m.Saturday).DefaultValue(DateTime.Parse(sstartFirstDayofWeek).AddDays(6));
                                  })
                                  .Aggregates(aggregates =>
                                  {
                                      aggregates.Add(p => p.Sunday.TimeOfDay.TotalHours).Sum();
                                      aggregates.Add(p => p.Monday.TimeOfDay.TotalHours).Sum();
                                      aggregates.Add(p => p.Tuesday.TimeOfDay.TotalHours).Sum();
                                      aggregates.Add(p => p.Wednesday.TimeOfDay.TotalHours).Sum();
                                      aggregates.Add(p => p.Thursday.TimeOfDay.TotalHours).Sum();
                                      aggregates.Add(p => p.Friday.TimeOfDay.TotalHours).Sum();
                                      aggregates.Add(p => p.Saturday.TimeOfDay.TotalHours).Sum();
                                  })
                                  .Read(read =>
                                  {
                                      read.Action("Read", "timesheet", new { area = "Pm" }).Data("grid_params");
                                  })
                              .Update(update => update.Action("update", "timesheet", new { area = "Pm" }))

                              )
                                )
                            }

                        </div>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_status_log">
                    <div class="row">
                        <div class="col-lg-12">
                            <br />
                            <partial name="_StatusLog" />
                            <br />
                            <br />
                            <partial name="_HistoryApproval" />
                            <br />

                            <div id="button-place">
                                @if (Model.Status != "")
                                {
                                    <div class="row">
                                        <div class="col-lg-2">
                                            &nbsp;
                                        </div>
                                        <div class="col-lg-8">
                                            <center>
                                                @if (Model.Status == "2" && ViewBag.IsUserLoginApprovalStatus == "true")
                                                {
                                                    <button type="button" id="btn-approve" class="btn btn-primary btn-submit" value="3">Approve</button>
                                                    <button type="button" id="btn-reject" class="btn btn-danger btn-submit" value="4">Reject</button>
                                                }
                                                else if (Model.Status == "4" || Model.Status == "0" || Model.Status == "1")
                                                {
                                                    @if (ViewBag.IsUserLoginApprovalStatus == "false" && ViewBag.IsCreatorTimesheet == "true")
                                                    {
                                                        <button type="button" id="btn-save" class="btn btn-success">Save</button>
                                                        <button type="button" id="btn-submit" class="btn btn-primary" value="2">Submit</button>
                                                    }
                                                }
                                                <a asp-action="Index" asp-controller="TimeSheet" asp-area="pm" class="fakelink btn btn-secondary"> Close</a>
                                            </center>
                                        </div>
                                        <div class="col-lg-2">
                                            &nbsp;
                                        </div>
                                    </div>

                                }
                                else
                                {
                                    <div class="row">
                                        <div class="col-lg-2">
                                            &nbsp;
                                        </div>
                                        <div class="col-lg-8">
                                            <center>
                                                <button type="button" id="btn-save" class="btn btn-success">Save</button>
                                                <button type="button" id="btn-submit" class="btn btn-primary" value="2">Submit</button>
                                                <a asp-action="Index" asp-controller="TimeSheet" asp-area="pm" class="fakelink btn btn-secondary">Close</a>
                                            </center>
                                        </div>
                                        <div class="col-lg-2">
                                            &nbsp;
                                        </div>
                                    </div>
                                }
                            </div>

                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>




</div>
