    function getDate(startDate, endDate) {
        var dates = [],
            currentDate = startDate,
            addDays = function (days) {
                var date = new Date(this.valueOf());
                date.setDate(date.getDate() + days);
                return date;
            };
        while (currentDate <= endDate) {
            dates.push(currentDate);
            currentDate = addDays.call(currentDate, 1);
        }
        return dates;
    };

    function onDataBinding() {

        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
        ];
        var grid = $("#TimeSheet").data("kendoGrid");

        var date = getDate(new Date(grid.dataSource.data()[0]['start_date']), new Date(grid.dataSource.data()[0]['end_date']))
        if (date.length != 0) {
            if (date.length == 1) {
                var sunday = getSunday(date[0]);
                if (sunday.getDate() == date[0].getDate()) {
                    $("#TimeSheet thead [data-field=Sunday] .k-link").html(date[0].getDate() + '-' + monthNames[date[0].getMonth()]);
                } else {
                    $("#TimeSheet thead [data-field=Sunday] .k-link").html(sunday.getDate() + '-' + monthNames[sunday.getMonth()]);
                }
            }


            if (date.length > 1) {
                $("#TimeSheet thead [data-field=Sunday] .k-link").html(date[0].getDate() + '-' + monthNames[date[0].getMonth()]);
                $("#TimeSheet thead [data-field=Monday] .k-link").html(date[1].getDate() + '-' + monthNames[date[1].getMonth()])
                $("#TimeSheet thead [data-field=Tuesday] .k-link").html(date[2].getDate() + '-' + monthNames[date[2].getMonth()])
                $("#TimeSheet thead [data-field=Wednesday] .k-link").html(date[3].getDate() + '-' + monthNames[date[3].getMonth()])
                $("#TimeSheet thead [data-field=Thursday] .k-link").html(date[4].getDate() + '-' + monthNames[date[4].getMonth()])
                $("#TimeSheet thead [data-field=Friday] .k-link").html(date[5].getDate() + '-' + monthNames[date[5].getMonth()])
                $("#TimeSheet thead [data-field=Saturday] .k-link").html(date[6].getDate() + '-' + monthNames[date[6].getMonth()])
            }
        }

    }

    function totalSunday() {
        var hours = $("#TimeSheet").data("kendoGrid").dataSource._aggregateResult['Sunday.TimeOfDay.TotalHours'].sum;
        return hours;
    }
    function totalMonday() {
        var hours = $("#TimeSheet").data("kendoGrid").dataSource._aggregateResult['Monday.TimeOfDay.TotalHours'].sum;
        return hours;
    }
    function totalTuesday() {
        var hours = $("#TimeSheet").data("kendoGrid").dataSource._aggregateResult['Tuesday.TimeOfDay.TotalHours'].sum;
        return hours;
    }
    function totalWednesday() {
        var hours = $("#TimeSheet").data("kendoGrid").dataSource._aggregateResult['Wednesday.TimeOfDay.TotalHours'].sum;
        return hours;
    }
    function totalThursday() {
        var hours = $("#TimeSheet").data("kendoGrid").dataSource._aggregateResult['Thursday.TimeOfDay.TotalHours'].sum;
        return hours;
    }
    function totalFriday() {
        var hours = $("#TimeSheet").data("kendoGrid").dataSource._aggregateResult['Friday.TimeOfDay.TotalHours'].sum;
        return hours;
    }
    function totalSaturday() {
        var hours = $("#TimeSheet").data("kendoGrid").dataSource._aggregateResult['Saturday.TimeOfDay.TotalHours'].sum;
        return hours;
    }
    function totalAllHours() {
        var data1 = totalSunday();
        var data2 = totalMonday();
        var data3 = totalTuesday();
        var data4 = totalWednesday();
        var data5 = totalThursday();
        var data6 = totalFriday();
        var data7 = totalSaturday();
        var summary = minTommss(data1 + data2 + data3 + data4 + data5 + data6 + data7)
        return summary;
    }
    function minTommss(minutes) {
        var sign = minutes < 0 ? "-" : "";
        var min = Math.floor(Math.abs(minutes))
        var sec = Math.floor((Math.abs(minutes) * 60) % 60);
        return sign + (min < 10 ? "0" : "") + min + ":" + (sec < 10 ? "0" : "") + sec;
    }

