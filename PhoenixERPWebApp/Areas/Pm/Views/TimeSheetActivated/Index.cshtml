@*@model System.Data.DataTable*@
@model PhoenixERPWebApp.Models.ProjectManagement.Timesheet
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutKendo.cshtml";
}
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Time Sheet</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="javascript:return;" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon flaticon-suitcase"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Project Management</span>
                    </a>
                </li>
                <li class="m-nav__separator"><i class="fa fa-angle-double-right"></i></li>
                <li class="m-nav__item">
                    <a asp-action="index" asp-controller="TimeSheetActivated" asp-area="pm" class="m-nav__link"><span class="m-nav__link-text">User Time Sheet</span></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__body" id="m_blockui_list">
                    <b>Employee Info</b><hr /><br />
                    <div class="row">
                        <input type="hidden" id="TimesheetId" value="@Model.id" />
                        <input type="hidden" id="ApprovalId" value="@Model.ApprovalId" />
                        <input type="hidden" id="ApprovalId1" value="@ViewBag.Division" />
                        <input type="hidden" id="ApprovalId2" value="@ViewBag.DivisionId" />
                        <input type="hidden" id="DateToday" value="@ViewBag.DateToday" />
                        <div class="col-lg-4">
                            <label>Name</label>:
                            @Html.Kendo().TextBox().Name("EmployeeName").Value(ViewBag.Name).HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" })
                        </div>

                        <div class="col-lg-4" style="display:none">
                            <label>Department</label>:
                            @(Html.Kendo().DropDownList()
                                .Name("BusinessUnit")
                                .DataTextField("Text")
                                .DataValueField("Value")
                                .Filter(FilterType.Contains)
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetDDLDepartment", "Dropdown", new { area = "Pm" });
                                    });
                                })

                                .HtmlAttributes(new { style = "width:100%;", required = "required" })
                            )
                        </div>
                        <div class="col-lg-4">
                            <label>Division</label>:
                            @(Html.Kendo().DropDownList()
                             .Name("Division")
                             .DataTextField("Text")
                             .DataValueField("Value")
                             .BindTo(new List<SelectListItem>() {
                                 new SelectListItem() {
                                     Text = ViewBag.Division, Value = ViewBag.DivisionId
                                 }
                             })
                             .HtmlAttributes(new { style = "width:100%;", required = "required", @readonly = "readonly" })
                            )

                        </div>
                        <div class="col-lg-4">
                            <label>Choose Date</label>:
                            @(Html.Kendo().DatePicker()
                                                                 .Name("timesheetdate")
                                                                 .Value(DateTime.Now)
                                                                 .HtmlAttributes(new { style = "width: 50%", title = "datepicker" })
                                                                 .Min(DateTime.Now.AddDays(-7))
                                                                 .Max(DateTime.Now.AddDays(+7))
                                                                 .Events(e =>
                                                                 {
                                            e.Change("dateChange");
                                        })
                                                                 .HtmlAttributes(new { style = "width:100%;", required = "required" })
                            )
                        </div>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <div class="row">
                        <div class="col-lg-12">
                            @if (Model.ApprovalId != "" || Model.Status == "2")
                            {
                                @(Html.Kendo().Grid<PhoenixERPWebApp.Models.ProjectManagement.Timesheet>()
                               .Name("TimeSheet")
                               .Columns(columns =>
                               {
                                   columns.Bound(b => b.id).Hidden(true);
                                   //columns.Bound(b => b.Status).Hidden(true);
                                   columns.Bound(b => b.job_id).Hidden(true);
                                   columns.Bound(b => b.company_id).Title("Client").EditorTemplateName("Pm/Timesheet/CompanyDropdown").ClientTemplate("#=company_name#").Width("250px");
                                   columns.Bound(b => b.job_name).Width("250px");
                                   //columns.Bound(b => b.non_job_name).Width("125px");
                                   columns.Bound(b => b.NonJobId).EditorTemplateName("Pm/Timesheet/NonJobDropDown").ClientTemplate("#=non_job_name#").Width("250px");
                                   columns.Bound(b => b.start_date).Hidden(true);
                                   columns.Bound(b => b.end_date).Hidden(true);
                                   columns.Bound(b => b.Sunday).ClientFooterTemplate("#=minTommss(totalSunday())#").Width("100px");
                                   columns.Bound(b => b.Monday).ClientFooterTemplate("#=minTommss(totalMonday())#").Width("100px");
                                   columns.Bound(b => b.Tuesday).ClientFooterTemplate("#=minTommss(totalTuesday())#").Width("100px");
                                   columns.Bound(b => b.Wednesday).ClientFooterTemplate("#=minTommss(totalWednesday())#").Width("100px");
                                   columns.Bound(b => b.Thursday).ClientFooterTemplate("#=minTommss(totalThursday())#").Width("100px");
                                   columns.Bound(b => b.Friday).ClientFooterTemplate("#=minTommss(totalFriday())#").Width("100px");
                                   columns.Bound(b => b.Saturday).ClientFooterTemplate("#=minTommss(totalSaturday())#").Width("100px");
                                   columns.Command(cmd => cmd.Edit()).Title("Action").ClientFooterTemplate("Total: #=totalAllHours()#").HtmlAttributes(new { @class = "k-state-disabled" }).Width("100px");
                               })
                               .Pageable()
                               .Resizable(rsz => rsz.Columns(true))
                               .Sortable()
                               //.Filterable(x=>x.Mode(GridFilterMode.Menu))
                               .Groupable()
                               .Scrollable()
                               .DataSource(dataSource => dataSource
                                   .Ajax().Events(e => e.Sync("endRequest"))
                                   .Model(model =>
                                   {
                                       model.Id(p => p.id);
                                       model.Field(p => p.id);
                                       model.Field(m => m.start_date);
                                       model.Field(m => m.end_date);
                                       model.Field(m => m.job_id);
                                       model.Field(m => m.company_name);
                                       model.Field(m => m.job_name);
                                       model.Field(m => m.non_job_name);
                                       model.Field(m => m.NonJobId);
                                       model.Field(m => m.Sunday).DefaultValue(new DateTime());
                                       model.Field(m => m.Monday).DefaultValue(new DateTime());
                                       model.Field(m => m.Tuesday).DefaultValue(new DateTime());
                                       model.Field(m => m.Wednesday).DefaultValue(new DateTime());
                                       model.Field(m => m.Thursday).DefaultValue(new DateTime());
                                       model.Field(m => m.Friday).DefaultValue(new DateTime());
                                       model.Field(m => m.Saturday).DefaultValue(new DateTime());
                                   })
                                   .Aggregates(aggregates =>
                                   {
                                       aggregates.Add(p => p.Sunday.TimeOfDay.TotalHours).Sum();
                                       aggregates.Add(p => p.Monday.TimeOfDay.TotalHours).Sum();
                                       aggregates.Add(p => p.Tuesday.TimeOfDay.TotalHours).Sum();
                                       aggregates.Add(p => p.Wednesday.TimeOfDay.TotalHours).Sum();
                                       aggregates.Add(p => p.Thursday.TimeOfDay.TotalHours).Sum();
                                       aggregates.Add(p => p.Friday.TimeOfDay.TotalHours).Sum();
                                       aggregates.Add(p => p.Saturday.TimeOfDay.TotalHours).Sum();
                                   })
                                   .Read(read =>
                                   {
                                       read.Action("ReadById", "TimeSheetActivated", new { area = "Pm" }).Data("grid_params_byID");
                                   })
                               )
                                )
                            }
                            else
                            {
                                @(Html.Kendo().Grid<PhoenixERPWebApp.Models.ProjectManagement.Timesheet>()
                              .Name("TimeSheet")
                              .Columns(columns =>
                              {
                                  columns.Bound(b => b.id).Hidden(true);
                                  //columns.Bound(b => b.Status).Hidden(true);
                                  columns.Bound(b => b.job_id).Hidden(true);
                                  columns.Bound(b => b.company_id).Title("Client").EditorTemplateName("Pm/Timesheet/CompanyDropdown").ClientTemplate("#=company_name#").Width("250px");
                                  columns.Bound(b => b.job_name).Width("250px");
                                  //columns.Bound(b => b.non_job_name).Width("125px");
                                  columns.Bound(b => b.NonJobId).EditorTemplateName("Pm/Timesheet/NonJobDropDown").ClientTemplate("#=non_job_name#").Width("250px");
                                  columns.Bound(b => b.start_date).Hidden(true);
                                  columns.Bound(b => b.end_date).Hidden(true);
                                  columns.Bound(b => b.Sunday).ClientFooterTemplate("#=minTommss(totalSunday())#").Width("100px");
                                  columns.Bound(b => b.Monday).ClientFooterTemplate("#=minTommss(totalMonday())#").Width("100px");
                                  columns.Bound(b => b.Tuesday).ClientFooterTemplate("#=minTommss(totalTuesday())#").Width("100px");
                                  columns.Bound(b => b.Wednesday).ClientFooterTemplate("#=minTommss(totalWednesday())#").Width("100px");
                                  columns.Bound(b => b.Thursday).ClientFooterTemplate("#=minTommss(totalThursday())#").Width("100px");
                                  columns.Bound(b => b.Friday).ClientFooterTemplate("#=minTommss(totalFriday())#").Width("100px");
                                  columns.Bound(b => b.Saturday).ClientFooterTemplate("#=minTommss(totalSaturday())#").Width("100px");
                                  columns.Command(cmd =>
                                  {
                                      cmd.Edit();
                                  }).Title("Action").ClientFooterTemplate("Total: #=totalAllHours()#").Width("100px");
                                  columns.Bound(p => p.id).ClientTemplateId("btnAction-template").Title("Delete").HtmlAttributes(new { style = "text-align:center;" }).HeaderHtmlAttributes(new { style = "text-align:center;" }).Width("100px");

                              })
                              .ToolBar(t =>
                              {
                                  t.Create().Text("Add Non Job");

                              })
                              .Pageable()
                              .Resizable(rsz => rsz.Columns(true))
                              .Sortable()
                              .Editable(editable => editable.Mode(GridEditMode.InLine))
                              //.Filterable(x=>x.Mode(GridFilterMode.Menu))
                              .Groupable()
                              .Scrollable()
                              .Events(e => e.DataBinding("onDataBinding").Edit("onEdit"))
                              .DataSource(dataSource => dataSource
                                  .Ajax().Events(e => e.Sync("endRequest"))
                                  .Model(model =>
                                  {
                                      model.Id(p => p.id);
                                      model.Field(p => p.id);
                                      model.Field(m => m.start_date);
                                      model.Field(m => m.end_date);
                                      model.Field(m => m.job_id);
                                      model.Field(m => m.company_name);
                                      model.Field(m => m.job_name);
                                      model.Field(m => m.non_job_name);
                                      model.Field(m => m.NonJobId);
                                      model.Field(m => m.Sunday).DefaultValue(new DateTime());
                                      model.Field(m => m.Monday).DefaultValue(new DateTime());
                                      model.Field(m => m.Tuesday).DefaultValue(new DateTime());
                                      model.Field(m => m.Wednesday).DefaultValue(new DateTime());
                                      model.Field(m => m.Thursday).DefaultValue(new DateTime());
                                      model.Field(m => m.Friday).DefaultValue(new DateTime());
                                      model.Field(m => m.Saturday).DefaultValue(new DateTime());
                                  })
                                  .Aggregates(aggregates =>
                                  {
                                      aggregates.Add(p => p.Sunday.TimeOfDay.TotalHours).Sum();
                                      aggregates.Add(p => p.Monday.TimeOfDay.TotalHours).Sum();
                                      aggregates.Add(p => p.Tuesday.TimeOfDay.TotalHours).Sum();
                                      aggregates.Add(p => p.Wednesday.TimeOfDay.TotalHours).Sum();
                                      aggregates.Add(p => p.Thursday.TimeOfDay.TotalHours).Sum();
                                      aggregates.Add(p => p.Friday.TimeOfDay.TotalHours).Sum();
                                      aggregates.Add(p => p.Saturday.TimeOfDay.TotalHours).Sum();
                                  })
                                  .Read(read =>
                                  {
                                      read.Action("Read", "TimeSheetActivated", new { area = "Pm" }).Data("grid_params");
                                  })
                              .Update(update => update.Action("update", "TimeSheetActivated", new { area = "Pm" }))

                              )
                                )
                            }

                        </div>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_status_log">
                    <div class="row">
                        <div class="col-lg-12">
                            <div id="button-place">
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <center>
                                                @if (ViewBag.IsLocked == "true")
                                                {
                                                    <button type="button" id="btn-activated" class="btn btn-success ">Activated</button>
                                                }
                                                <a href="@Url.Content("/Core/Authentication/Logout")" class="fakelink btn btn-secondary">Logout</a>
                                            </center>
                                        </div>
                                    </div>
                                
                            </div>

                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>




</div>
<div id='popupEditor'></div>
<script id="btnAction-template" type="text/x-kendo-template">
    #if(NonJobId != ""){#
    <a href='javascript: void(0);' onclick='deleteGridRow(this)' title='Delete' class='delete'><span style='color:maroon'><i class='fa fa-trash-alt'></i></span></a>
    #}#

</script>

<script>
    function deleteGridRow(e) {
        var item = dataItem(e);
        swal({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            type: "warning",
            showCancelButton: !0,
            confirmButtonText: "Yes",
            cancelButtonText: "No",
            reverseButtons: !0
        }).then(function (ok) {
            if (ok.value) {
                mApp.block("#m_blockui_list", {
                    overlayColor: "#000000",
                    type: "loader",
                    state: "primary",
                    message: "Processing..."
                });
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DeleteNonJob", "TimeSheetActivated", new { area = "Pm" })',
                    data: JSON.parse(JSON.stringify(item)),
                    success: function (result) {
                        endRequest();
                        mApp.unblock("#m_blockui_list");
                    },
                    error: function (e, t, s) {
                        var errorMessage = e.responseJSON.errorMessage;
                        if (errorMessage === "" || errorMessage === undefined) {
                            errorMessage = "Ooops, something went wrong !";
                        }
                        //console.log(errorMessage);
                        console.log(errorMessage);
                        mApp.unblock("#m_blockui_list");
                    }
                });
            }
        }).catch(swal.noop);



        //deleteRow(e, '@Url.Action("DeleteNonJob", "TimeSheetActivated", new { area = "Pm" })');
    }
    // on click save button on grid #Timesheet
    //$("#TimeSheet").on("click", "#customCommandSave", function () {
    $("#btn-activated").on("click", function () {
        var oChoosenDate = formatDate($("#timesheetdate").data("kendoDatePicker").value());
        var oDepartmentId = $("#BusinessUnit").data("kendoDropDownList").value();
        var model = {
            ChoosenDate: oChoosenDate,
            BusinessUnitId: oDepartmentId
        };
        swal({
            title: "Confirmation",
            text: "Are you sure to want save this data?",
            type: "success",
            showCancelButton: !0,
            confirmButtonText: "Yes",
            cancelButtonText: "No",
            reverseButtons: !0
        }).then(function (e) {
            if (e.value) {
                mApp.block("#m_blockui_list", {
                    overlayColor: "#000000",
                    type: "loader",
                    state: "primary",
                    message: "Processing..."
                });
                ajaxPostJquery('@Url.Action("activated","TimeSheetActivated")', model, function (resp) {
                    var JsonParseData = parseJson(resp);
                    if (JsonParseData.success) {
                        swal('Information', JsonParseData.message, 'success');
                        $('#TimesheetId').val(resp.data);
                        mApp.unblock("#m_blockui_list");
                    } else {
                        swal('Warning', JsonParseData.message, 'warning');
                       mApp.unblock("#m_blockui_list");
                    }
                });
            }
        });

    });

   

    function setCompanyName(e) {
        console.log(e);
        return 'xsxsx'
    }

    function timesheet_param() {
        var id = $("#Division").val();
        return { id: id };
    }

    function endRequest() {
        var grid = $("#TimeSheet").data("kendoGrid");
        grid.dataSource.read();
    }

    function NumberDateDiff(startDate, endDate) {
        var start = startDate;
        var end = endDate;

        var startDay = new Date(start);
        var endDay = new Date(end);
        var millisecondsPerDay = 1000 * 60 * 60 * 24;

        var millisBetween = endDay.getTime() - startDay.getTime();
        var days = millisBetween / millisecondsPerDay;

        // Round down.
        return Math.floor(days);

    }

   function EnableDisableDateOnGrid(e) {
        var weekday = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
        var monthNumber = ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"];
        var curr = new Date($("#timesheetdate").data("kendoDatePicker").value()); // get current date

        var d = new Date();
        var first = curr.getDate() - curr.getDay(); // First day is the day of the month - the day of the week
        var last = first + 6; // last day is the first day + 6

        var currentDate = new Date(curr.setDate(first));
        var dd = currentDate.getDate();
        var mm = currentDate.getMonth() + 1;
        var y = currentDate.getFullYear();

        var startDate = mm + '/' + dd + '/' + y;
        var startDateMoment = moment(y + '-' + monthNumber[mm - 1] + '-' + dd); 

        var currentDateLast = new Date(curr.setDate(last));
        var dd = currentDateLast.getDate();
        var mm = currentDateLast.getMonth() + 1;
        var y = currentDateLast.getFullYear();
        //var endDate = mm + '/' + dd + '/' + y;
        
        var endDate = startDateMoment.add(6, 'days'); 

        var date = getDate(new Date(startDate), new Date(endDate));
        var datenumber = "";
        var datenumber1 = "";
        var datenumber2 = "";
        var datenumber3 = "";
        var datenumber4 = "";
        var datenumber5 = "";
        var datenumber6 = "";
        var CheckHMinusDay = -1;
        var CheckHMinusDay1 = -1;
        var CheckHMinusDay2 = -1;
        var CheckHMinusDay3 = -1;
        var CheckHMinusDay4 = -1;
        var CheckHMinusDay5 = -1;
        var CheckHMinusDay6 = -1;

        if (date.length > 0) {
            if (date[0].getDate() < 10) {
                datenumber = "0" + date[0].getDate();
            } else {
                datenumber = date[0].getDate();
            }
            CheckHMinusDay = NumberDateDiff(date[0].getFullYear() + '-' + monthNumber[date[0].getMonth()] + '-' + datenumber, d);
        }

        if (date.length > 1) {
            if (date[1].getDate() < 10) {
                datenumber1 = "0" + date[1].getDate();
            }
            else {
                datenumber1 = date[1].getDate();
            }
            CheckHMinusDay1 = NumberDateDiff(date[1].getFullYear() + '-' + monthNumber[date[1].getMonth()] + '-' + datenumber1, d);
        }
        
        if (date.length > 2) {
            if (date[2].getDate() < 10) {
                datenumber2 = "0" + date[2].getDate();
            }
            else {
                datenumber2 = date[2].getDate();
            }
            CheckHMinusDay2 = NumberDateDiff(date[2].getFullYear() + '-' + monthNumber[date[2].getMonth()] + '-' + datenumber2, d);
        }

        if (date.length > 3) {
            if (date[3].getDate() < 10) {
                datenumber3 = "0" + date[3].getDate();
            }
            else {
                datenumber3 = date[3].getDate();
            }
            CheckHMinusDay3 = NumberDateDiff(date[3].getFullYear() + '-' + monthNumber[date[3].getMonth()] + '-' + datenumber3, d);
        }

        if (date.length > 4) {
            if (date[4].getDate() < 10) {
                datenumber4 = "0" + date[4].getDate();
            }
            else {
                datenumber4 = date[4].getDate();
            }
            CheckHMinusDay4 = NumberDateDiff(date[4].getFullYear() + '-' + monthNumber[date[4].getMonth()] + '-' + datenumber4, d);
        }

        if (date.length > 5) {
            if (date[5].getDate() < 10) {
                datenumber5 = "0" + date[5].getDate();
            }
            else {
                datenumber5 = date[5].getDate();
            }
            CheckHMinusDay5 = NumberDateDiff(date[5].getFullYear() + '-' + monthNumber[date[5].getMonth()] + '-' + datenumber5, d);
        }

        if (date.length > 6) {
            if (date[6].getDate() < 10) {
                datenumber6 = "0" + date[6].getDate();
            }
            else {
                datenumber6 = date[6].getDate();
            }
            CheckHMinusDay6 = NumberDateDiff(date[6].getFullYear() + '-' + monthNumber[date[6].getMonth()] + '-' + datenumber6, d);
        }

        if (CheckHMinusDay > 7 || CheckHMinusDay < 0 ) {
             e.container.find("input[name='" + weekday[date[0].getDay()] + "']").each(function () {
                    $(this).attr("disabled", "disabled");
                    $(this).addClass("readonly"); // add custom css class to make it looks 'disabled'
                    $(this).next('span.k-select').unbind("click"); // avoid clicking on Kendo spans
                });
        }

        if (CheckHMinusDay1 > 7 || CheckHMinusDay1 < 0) {
             e.container.find("input[name='" + weekday[date[1].getDay()] + "']").each(function () {
                    $(this).attr("disabled", "disabled");
                    $(this).addClass("readonly"); // add custom css class to make it looks 'disabled'
                    $(this).next('span.k-select').unbind("click"); // avoid clicking on Kendo spans
                });
        }

        if (CheckHMinusDay2 > 7 || CheckHMinusDay2 < 0) {
             e.container.find("input[name='" + weekday[date[2].getDay()] + "']").each(function () {
                    $(this).attr("disabled", "disabled");
                    $(this).addClass("readonly"); // add custom css class to make it looks 'disabled'
                    $(this).next('span.k-select').unbind("click"); // avoid clicking on Kendo spans
                });
        }

        if (CheckHMinusDay3 > 7 || CheckHMinusDay3 < 0) {
             e.container.find("input[name='" + weekday[date[3].getDay()] + "']").each(function () {
                    $(this).attr("disabled", "disabled");
                    $(this).addClass("readonly"); // add custom css class to make it looks 'disabled'
                    $(this).next('span.k-select').unbind("click"); // avoid clicking on Kendo spans
                });
        }

        if (CheckHMinusDay4 > 7 || CheckHMinusDay4 < 0) {
             e.container.find("input[name='" + weekday[date[4].getDay()] + "']").each(function () {
                    $(this).attr("disabled", "disabled");
                    $(this).addClass("readonly"); // add custom css class to make it looks 'disabled'
                    $(this).next('span.k-select').unbind("click"); // avoid clicking on Kendo spans
                });
        }

        if (CheckHMinusDay5 > 7 || CheckHMinusDay5 < 0) {
             e.container.find("input[name='" + weekday[date[5].getDay()] + "']").each(function () {
                    $(this).attr("disabled", "disabled");
                    $(this).addClass("readonly"); // add custom css class to make it looks 'disabled'
                    $(this).next('span.k-select').unbind("click"); // avoid clicking on Kendo spans
                });
        }

        if (CheckHMinusDay6 > 7 || CheckHMinusDay6 < 0) {
             e.container.find("input[name='" + weekday[date[6].getDay()] + "']").each(function () {
                    $(this).attr("disabled", "disabled");
                    $(this).addClass("readonly"); // add custom css class to make it looks 'disabled'
                    $(this).next('span.k-select').unbind("click"); // avoid clicking on Kendo spans
                });
        }

    }

    function onEdit(e) {
        var approvalId = $('#ApprovalId').val();
        if (approvalId === '') {
             EnableDisableDateOnGrid(e);
        if (!e.model.isNew()) {
            e.container.find("input[name='company_id']").data("kendoDropDownList").enable(false);
            e.container.find("input[name='NonJobId']").data("kendoDropDownList").enable(false);
            e.container.find("input[name='id']").each(function () {
                $(this).hide()
            });
            //e.container.find("input[name='company_name']").each(function () {
            //    $(this).attr("disabled", "disabled")
            //});

            e.container.find("input[name='job_name']").each(function () {
                $(this).attr("disabled", "disabled")
            });

