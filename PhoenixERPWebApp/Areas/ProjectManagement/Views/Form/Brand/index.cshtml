@{
    ViewData["Title"] = "Client Brand";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
    <a href="@Url.Content("~/Projectmanagement/Brand/create")" class="fakelink m-btn btn btn-primary btn-sm m-btn--sm"><i class="la la-plus"></i></a>
}

@section Paneltools{
    <a  data-target="#BrandModalSearch" data-toggle="modal" class="btn btn-circle btn-outline btn-sm"><i class="la la-search"></i> <span class="translate" data-args="app-search">Search</span></a>
}
@section Panelbody{

    <table class="table table-striped table-bordered table-hover table-checkable" id="CompanyBrandList"></table>
    @Html.Partial("Brand/Search")
}
@section Panelscript{
    <script src="~/assets/js/Areas/ProjectManagement/Form/Brand/index.js"></script>
}
