@{
    ViewData["Title"] = "Client Brief";
    Layout = "~/Views/Shared/metronic/_formpanelloader.cshtml";
}

@section Panelhead{
    <h3>Client Brief</h3>
}

@section Paneltools{

}
@section Panelbody{
    <script>
        var RecordId = "@ViewBag.RecordID";

    </script>
    <style>
        .option .description,
        .option .title {
            display: block;
            white-space: nowrap;
            width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .btn-sx {
            font-size: 0.45rem !important;
        }

        .contenttitle {
            font-weight: bold;
            font-size: 16px;
            border: none !important;
        }

        .option .title {
            font-weight: bold;
            font-size: 12px;
        }

        .option .description {
            color: #808080;
            font-size: 10px;
        }
    </style>
    <form action="#" method="post" id="ClientBriefFormList">
        <input value="@ViewBag.RecordID" type="hidden" name="id" />
        <div class="row m-row--col-separator-xl">
            <div class="col-lg-3">

                <h3 id="company_name" class="frmtext"></h3>
                <span id="brand_name" class="frmtext"></span>

            </div>
            <div class="col-lg-3">
                <h5>Campaign Name</h5>
                <h6 id="campaign_name" class="frmtext">-</h6>
                <hr />
                <h5>Business Type</h5>
                <h6 id="bussiness_type_name" class="frmtext">-</h6>
                <hr />
                <h5>Campaign Type</h5>
                <h6 id="campaign_type_name" class="frmtext">-</h6>
                <hr />
            </div>
            <div class="col-lg-3">
                <h5>Business Unit</h5>
                <h6 id="business_unit_name" class="frmtext">-</h6>
                <hr />
                <h5>Account Manager</h5>
                <div id="accountmanagerlist" style="margin-left:10px">-</div>
            </div>
            <div class="col-lg-3">

                <h5>Start</h5>
                <h6 id="start_campaign" class="frmtext xdatetime">-</h6>
                <hr />
                <h5>Deadline</h5>
                <h6 id="deadline" class="frmtext xdatetime">-</h6>
                <hr />
                <h5>Final Delivery</h5>
                <h6 id="final_delivery" class="frmtext xdatetime">-</h6>
                <hr />
            </div>
        </div>
        <hr />
        <button type="button" onclick="fnclientbriefjob.add()"  class="btn btn-circle btn-outline btn-sm"><i class="fa fa-plus"></i> <span class="translate" data-args="app-add">Add</span></button>
        <table class="table table-striped table-bordered table-hover table-checkable" id="JobList">
            <thead>
                <tr>
                    <th>No</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Deadline</th>
                    <th>Final Delivery</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <hr />
        <div class="row">
            <div class="col-lg-12">
                <a href="~/ProjectManagement/clientbrief" class="fakelink btn btn-secondary">Close</a>
            </div>
        </div>
    </form>
    @Html.Partial("ClientBrief/jobcreate")
    @Html.Partial("ClientBrief/jobupdate")
}

@section Panelscript{
    <script src="~/assets/js/Areas/ProjectManagement/Form/ClientBrief.job.js"></script>
}