@{
    ViewData["Title"] = "Client Brief";
    Layout = "~/Views/Shared/metronic/_formpanelloader.cshtml";
}

@section Panelhead{
    <a href="@Url.Content("~/ProjectManagement/clientbrief/create")" class="fakelink  m-btn btn btn-primary btn-sm m-btn--sm" id="btn_create_clientbrief"><i class="la la-plus"></i>Create Client Brief</a>
}

@section Paneltools{

}
@section Panelbody{

    <div class="row">

        <div class="col-lg-6">
            <div class="input-group">
                <div class="input-group-prepend">
                    <select class="form-control" id="search_id" onchange="funcCondition(this)">
                        <option value="Search_campaign_name">Campaign Name</option>
                        <option value="Search_is_deleted">Is Active</option>
                    </select>
                </div>
                <input type="text" id="search_val" class="form-control" placeholder="Search for...">
                <select class="form-control" id="ddl_isdeleted">
                    <option value="false">Active</option>
                    <option value="true">Inactive</option>
                </select>
                <div class="input-group-append">
                    <button class="btn btn-secondary" type="button" onclick="fnClientBrief.initsearch()">
                        Go!
                    </button>
                </div>
            </div>
        </div>
    </div>
    @Html.Partial("ClientBrief/jobcreate")




    <table class="table table-striped table-bordered table-hover table-checkable" id="ClientBriefList"></table>
}
@section Panelscript{
    <script src="~/assets/js/Areas/ProjectManagement/Form/ClientBrief/index.js?v=@DateTime.Now.ToString("yyyyMMddhmmsstt")"></script>
}

