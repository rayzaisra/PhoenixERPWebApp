<div id="modalUpload" class="modal" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" style="max-width:95%">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title title-modal-tempApp">UPLOAD TO ONE DRIVE</h4>
            </div>
            <div class="modal-body">
                <div class="m-portlet m-portlet--full-height ">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="label-block">TITLE :</label>*
                            <input type="text" required id="title_file_name" name="title_file_name" class="form-control form-control-sm m-input m-input--square" >
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="label-block">UPLOAD TO DRIVE PATH :</label>
                            <label class="label-block label-info-root" style="font-weight:bold"></label>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="label-block">SELECT FILE</label>
                            <input type="file" class="form-control" id="fu" placeholder="select file for upload to drive" />
                            <label class="label-block label-info-fu" style="font-weight:bold"></label>
                        </div>
                    </div>
                </div>
                    <div class="clearfix"></div>
                </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-sm btn-primary btnsave-uploadTodrive" style="display:block">Save</button>
            </div>
        </div>

    </div>
</div>
