                    <label for="">
                        Set To:
                    </label>
                    <div class="m-radio-list" id="jobstatusdiv">

                    </div>
                    <button type="submit" class="btn btn-circle btn-outline btn-sm"> <span class="translate" data-args="submit">submit</span></button>
                </div>
            </div>
            <div class="col-lg-7">
                <h4>Client Name</h4>
                <h5 id="company_name">-</h5>
                <hr />
                <h4>Campaign Name</h4>
                <h5 id="campaign_name">-</h5>
                <hr />
                <h4>Job Number</h4>
                <h5 id="job_number">-</h5>
                <hr />
