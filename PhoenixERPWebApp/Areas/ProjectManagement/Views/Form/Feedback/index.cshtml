                <h5 id="job_name">-</h5>
                <hr />
                <div id="damfilediv">

                </div>
            </div>

        </div><hr />




    </form>


}
@section Panelscript{
    <script>
        var RecordID = "@ViewBag.RecordID";
    </script>
    <script type="text/javascript" src="~/vendors/custom/jeasyui/jquery.easyui.min.js"></script>
    <script src="~/assets/js/Areas/ProjectManagement/Form/Feedback.js"></script>
}

