
@{
    ViewData["Title"] = "Assign member";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}




@section Panelhead{

}

@section Paneltools{

}
@section Panelbody{

    <div id="JobAssignpmcontent" >
        <form action="#" method="post" id="JobAssignpmForm">
            <input value="@ViewBag.RecordID" type="hidden" name="id" />
            <div class="row m-row--col-separator-xl">
                <div class="col-lg-4">
                    <h5>Job Name</h5>
                    <h6 id="job_name">-</h6>
                    <hr />
                    <h5>Job Number</h5>
                    <h6 id="job_number">-</h6>
                    <hr />
                </div>
                <div class="col-lg-4">
                    <h5>Campaign Name</h5>
                    <h6 id="campaign_name">-</h6>
                    <hr />

                </div>
                <div class="col-lg-4">

                    <h5>Deadline</h5>
                    <h6 id="deadline" class="xdatetime">-</h6>
                    <hr />
                    <h5>Final Delivery</h5>
                    <h6 id="final_delivery" class="xdatetime">-</h6>
                    <hr />
                </div>
            </div>
            <a href="javascript:void(0)" onclick="fnTeamusers.adduser()" class="m-btn btn btn-primary btn-sm m-btn--sm"><i class=" fa fa-user-plus"></i></a>
            <table class="table table-striped table-bordered table-hover table-checkable" id="TeamusersList">
                <thead><tr><th>#</th><th>User Name</th><th>Email</th><th>As</th></tr></thead>
                <tbody></tbody>
            </table>
            <hr />
            <div class="row">
                <div class="col-lg-12">
                    <button type="button" onclick="fnTeamusers.savedata()" id="btn-save" class="btn btn-primary">Save</button>
                    <a href="~/projectmanagement/job/detail/@ViewBag.RecordID" class="fakelink btn btn-secondary">back</a>
                </div>

            </div>
        </form>

    </div>

    @Html.Partial("Team/UserList")
}

@section Panelscript{
    <script src="~/assets/js/Areas/ProjectManagement/Form/Job/assignmember.js" asp-append-version="true"></script>
}
