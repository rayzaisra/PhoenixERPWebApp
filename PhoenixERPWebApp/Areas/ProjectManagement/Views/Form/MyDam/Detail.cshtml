        </div>
        <div style="clear:both"></div>
        <div class="m-form__group-sub m--margin-bottom-20" style="float:left">
            <h6 id="job_number_label">Job Number</h6>
            <h3 class="m--font-info"><a id="job_number" href="" class="fakelink"></a></h3>
        </div>
        <div class="m-form__group-sub m--margin-bottom-20" style="text-align:right">
