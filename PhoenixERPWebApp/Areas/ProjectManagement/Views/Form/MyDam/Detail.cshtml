@{
    ViewData["Title"] = "MY Digital Asset Management";
    Layout = "~/Views/Shared/metronic/_formpanelloader.cshtml";
}

<link href="~/bundles/css/datatable.min.css" rel="stylesheet" />
<link href="//netdna.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
<title>Untitled</title>

@section Panelhead{
    <h3>Digital Asset Management</h3>
}
@section Panelbody{
    <div class="m-content">
        <input type="hidden" name="id" id="jobnumberid" value="@ViewBag.RecordID" />
