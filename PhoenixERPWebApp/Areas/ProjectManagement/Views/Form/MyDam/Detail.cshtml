                            </ul>
                        </div>
                    </div>
                    @*<div class="m-portlet__body" id="m_blockui_list" style="max-height:400px;overflow-x:auto">
                            <table class="table table-striped- table-bordered table-hover table-checkable" id="dt_basic">
                                <thead>
                                    <tr>
                                        <th><b>#Nama</b></th>
                                        <th><b>#Type</b></th>
