@{
    ViewData["Title"] = "MY Digital Asset Management";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}

@section Panelhead{

}

@section Paneltools{

}
@section Panelbody{

    <div class="row">

        <div class="col-lg-6">
            <div class="input-group">
                <div class="input-group-prepend">
                    <select class="form-control" id="search_id_mydam">
                        <option value="Search_client_brief_id_mydam">Campaign Name</option>
                        <option value="Search_job_name_mydam">Job Name</option>
                        <option value="Search_job_number_mydam">Job Number</option>
                        <option value="Search_brand_name_mydam">Brand</option>

                    </select>
                </div>
                <input type="text" id="search_val_mydam" class="form-control" placeholder="Search for...">
                <div class="input-group-append">
                    <button class="btn btn-secondary" type="button" onclick="fnJob.initsearch()">
                        Go!
                    </button>
                </div>
            </div>
        </div>
    </div>



    <table class="table table-striped table-bordered table-hover table-checkable" id="JobList_mydam"></table>
}
@section Panelscript{
    <script src="~/assets/js/Areas/ProjectManagement/Form/MyDam/Index.js"></script>
}

