@{
    ViewData["Title"] = "PCA";
    Layout = "~/Views/Shared/metronic/_formpanelloader.cshtml";
}

@section Panelhead{

}

@section Paneltools{

}
@section Panelbody{
    <link href="~/assets/plugins/treegrid/jquery.treegrid.css" rel="stylesheet" />
    <style>
        #tablePca .xcount{
            font-size:11px;
        }
        .m-dropdown__wrapper{
            z-index:1000 !important;
        }
        .xcount {
            text-align: right;
            direction: rtl;
            width: 100%;
        }
        .padd5{
            padding:7px 5px 5px 7px !important;
        }
        .xcounttask {
            text-align: right;
            direction: rtl;
            width: 100%;
        }
        .xrght {
            width: 20px;
            margin-top: 6px !important;
        }

            .xrght i {
                padding-top: 10px !important;
            }

        .xtext {
            width: 100%;
        }

        .tblnopadding tbody tr td {
            padding: 0px !important;
        }

        .tblnopadding tfoot tr td {
            padding: 0px !important;
        }

        .tblnopadding .xcategory {
            width: 160px;
        }

        .tblnopadding .select2-results__options li.select2-results__option {
            font-size: 10px !important;
        }

        .bigselect {
            width: 400px !important;
            font-size: 10px !important;
        }

        .tblnopadding .select2-results__options {
            font-size: 10px !important;
        }

        .tblnopadding .select2-selection__rendered {
            font-size: 10px !important;
            min-height: 28px;
            padding-top: 5px;
            padding-bottom: 5px;
        }

        .tblnopadding .select2-selection__clear {
            z-index: 1000;
        }
    </style>
    <form action="#" method="post" id="PcaFormCreate">

        <div class="row m-row--col-separator-xl">

            <div class="col-lg-4">
                <div class="form-group">
                    <label><span class="translate" data-args="Job"></span> :</label>
                    <select id="job_id" name="job_id" style="width:100%"></select>
                </div>
                <div class="form-group">
                    <label><span class="translate" data-args="Mother PCA"></span> :</label>
                    <select id="mother_pca_id" name="mother_pca_id" style="width:100%"></select>
                </div>
                <div class="form-group">
                    <label><span class="translate" data-args="Rate Card"></span> :</label>
                    <select id="rate_card_id" name="rate_card_id" style="width:100%"></select>
                </div>

            </div>

            <div class="col-lg-4">

                <div class="form-group">
                    <label><span class="translate" data-args="Currency"></span> :</label>
                    <select id="currency" name="currency" style="width:100%"></select>
                </div>
                @*<div class="form-group">
                    <label><span class="translate" data-args="description"></span> :</label>
                    <textarea class="form-control form-control-sm m-input m-input--square" required name="description" id="description"></textarea>
                </div>*@
            </div>
            <div class="col-lg-4">
                <div class="form-group">
                    <label><span class="translate" data-args="Code"></span> :</label>
                    <input readonly class="form-control form-control-sm m-input m-input--square" required name="code" id="code" value="-" maxlength="50" type="text">
                </div>
                <div class="form-group">
                    <label><span class="translate" data-args="rev"></span> :</label>
                    <input readonly class="form-control form-control-sm m-input m-input--square" required name="revision" id="revision" value="0" maxlength="50" type="text">
                </div>
                <div class="m-form__group-sub m--margin-bottom-20" style="text-align:right">
                    <h6 id="company_name">Total Amount</h6>
                    <h3 class="m--font-info"><span id="totalAmount">0</span></h3>
                </div>
            </div>
        </div><hr />
              <div style=""> 
                  <table id="tablePca" class="tblnopadding table table-bordered" >
                      <thead>
                          <tr>

                              <th style="width:100px">Departement</th>

                              <th>
                                  task

                                  <div id="dropdowntask" class="pull-right m-dropdown m-dropdown--inline m-dropdown--arrow m-dropdown--align-left m-dropdown--align-push m-dropdown--mobile-full-width" m-dropdown-toggle="click" m-dropdown-persistent="1" aria-expanded="true">

                                      <a href="#" class=" m-dropdown__toggle">
                                          <i class="fa fa-plus-circle fa-sm"></i>
                                      </a>
                                      <div class="m-dropdown__wrapper">
                                          <span class="m-dropdown__arrow m-dropdown__arrow--right m-dropdown__arrow--adjust"></span>
                                          <div class="m-dropdown__inner">
                                              <div class="m-dropdown__body">
                                                  <div class="m-dropdown__content">

                                                      <div id="jobtasklist"></div>

                                                      <div id="ratecardtasklist"></div>
                                                      <hr />
                                                      New Task :
                                                      <div>
                                                          <input class="form-control form-control-sm m-input m-input--square" name="task_name" id="task_name" maxlength="200" type="text">
                                                      </div>
                                                      <div>
                                                          <button type="button" onclick="fnPca.addnewtask()" class="btn btn-primary">Add</button>
                                                      </div>
                                                  </div>
                                              </div>
                                          </div>
                                      </div>
                                  </div>
                              </th>
                              <th style="width:20px">Qty </th>
                              <th style="width:20px">Unit </th>
                              <th style="width:80px">Price </th>
                              <th style="width:80px">PPN </th>
                              <th style="width:80px">ASF </th>
                              <th style="width:80px">PPH </th>

                              <th style="width:80px">Cost </th>
                              <th style="width:30px">% </th>
                              <th style="width:80px">Margin</th>
                              <th style="width:100px">Total</th>
                          </tr>
                      </thead>
                      <tbody></tbody>
                      <tfoot>
                          <tr><td colspan="11" align="right">Sub Total</td><td><input id="subtotal" class="xcount form-control-sm m-input m-input--square " required type="text"></td></tr>
                          <tr>
                              <td colspan="7"></td>
                              <td colspan="4" align="right">
                                  
                                      <select id="other_fee_name" name="other_fee_name">
                                          <option value="Retainer Fee">Retainer Fee</option>
                                          <option value="Agency Service Fee">Agency Service Fee</option>
                                      </select>
                                       
                                          <input id="other_fee_percentage"  style="width:40px" class="xcount  form-control-sm m-input m-input--square">
                                           
                                  
                              </td>
                              <td><input id="other_fee" class="xcount form-control form-control-sm m-input m-input--square"></td>

                          </tr>
                          <tr><td colspan="11" align="right">VAT (10% x Sub Total)</td><td><input id="vat" class="xcount form-control form-control-sm m-input m-input--square"></td></tr>
                          <tr><td colspan="11" align="right">Grand Total</td><td><input id="total" class="xcount form-control-sm m-input m-input--square " required type="text"></td></tr>
                           
                      </tfoot>
                  </table>
              </div>
        <hr />
        <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save </button>
        <a href="~/ProjectManagement/Pca" class="fakelink btn btn-secondary">Close</a>



    </form>
    @Html.Partial("Pca/_task")
    @Html.Partial("Pca/_ratecard")
}
@section Panelscript{
   
    <script src="~/assets/plugins/jquery.mask/jquery.mask.js"></script>
    <script src="~/assets/js/Areas/ProjectManagement/Form/Pca/create.js"></script>
}

