
@{
	ViewBag.ModalTitle = "Task List";
	ViewBag.ModalId = "ratecardbox";
	Layout = "~/Views/Shared/metronic/_ModalLarge.cshtml";
}
<form id="RatecardForm" method="post">
	<div class="form-group">
		<label><span class="translate" data-args="Type"></span> :</label>
		<div class="form-check-inline ml-md-1">
			<label class="form-check-label">
				<input type="radio" class="form-check-input" name="is_prefered_vendor" value="true">preferred
			</label>
		</div>
		<div class="form-check-inline">
			<label class="form-check-label">
				<input type="radio" class="form-check-input" name="is_prefered_vendor" value="false">selection
			</label>
		</div>
		<input type="hidden" value="@ViewBag.RecordID" name="pca_id" id="pca_id" />

	</div>
	<table id="RatecardTable" class="table tree">
		<thead>
			<tr>
				<th>Task</th>
				<th>Category</th>
				<th>Remarks</th>
				<th>Brand</th>
				<th>Sub brand</th>
				<th>Quantity</th>
				<th>Price</th>
				<th>Total</th>
			</tr>
		</thead>
		<tbody></tbody>
	</table>

	<hr />
	<div class="row">
		<div class="col-lg-6 showrfqn">
			<button type="submit" id="btn-save" class="btn btn-primary">Save</button>
			<button type="button" id="taskclose" class="btn btn-secondary" data-dismiss="modal">Close</button>
		</div>
		<div class="col-lg-6 showrfq" style="display:none">
			<button type="button" onclick="saverequest('rfq')" class="btn btn-success"><i class="fa fa-file-contract"></i> RFQ </button>
			<button type="button" onclick="onSubmitCA(event)" class="btn btn-primary"><i class="fa fa-dollar-sign"></i> Cash Advance </button>
		</div>
	</div>
</form>

<script>
	function onSubmitCA(event) {

	
		if (typeof saverequest === 'function') {
			saverequest('ca', {
				url: '@Url.Action("Detail", "CashAdvance", new { area = "Finance" })',
				location: event.target.ownerDocument.location
			})
		}
	}
</script>


