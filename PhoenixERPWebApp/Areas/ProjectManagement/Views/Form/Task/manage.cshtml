<style>
    .subtaskclass .m-portlet__head .m-portlet__head-caption {
        max-height: 20px !important;
    }
    .m-portlet__head-label--accent{
        cursor:pointer;
    }
</style>
<div id="taskboardcontent" style="display:none;padding:0px;margin:0px">
    
    <form id="TaskForm" method="post">
 
                <div class="row  ">
                    <div class="col-lg-12 nopadding">
                        <input value="@ViewBag.RecordID" type="hidden" name="id" />
                        <input value="" type="hidden" name="central_resources_id" />
                        <div class="form-group taskfield">
                            <label><span class="translate" data-args="task_name">task_name</span> <span class="req">*</span>:</label>
                            <input class="form-control form-control-sm m-input m-input--square" name="task_name" id="task_name" required maxlength="50" type="text">
                            <input name="job_number" id="job_number" required type="hidden">
                        </div>

                        <div class="form-group taskfield">

                            <div class="m-radio-inline">
                                <label>
                                    Priority :

                                </label>
                                <label class="m-radio">
                                    <input type="radio" id="taskhigh" name="task_priority_id" value="high"> High
                                    <span></span>
                                </label>
                                <label class="m-radio">
                                    <input type="radio" id="taskmedium" name="task_priority_id" value="medium"> Medium
                                    <span></span>
                                </label>
                                <label class="m-radio">
                                    <input type="radio" checked id="tasklow" name="task_priority_id" value="low"> Low
                                    <span></span>
                                </label>
                            </div>
                        </div>




                    </div>
                </div>
                <div class="row  ">
                    <div class="col-lg-6  taskfieldnp">

                        <div class="form-group ">
                            <label><span class="translate" data-args="description">description</span> <span class="req">*</span>:</label>
                            <textarea class="form-control form-control-sm m-input m-input--square" name="description" rows="4" id="description"></textarea>
                        </div>
                    </div>
                    <div class="col-lg-6  taskfieldnp">
                        <div class="form-group ">
                            <label><span class="translate" data-args="start_date">start_date</span> <span class="req">*</span>:</label>

                            <div class="input-group ">
                                <input type="text" class="dtpicker form-control form-control-sm m-input m-input--square" placeholder="Select date & time" id="start_task" name="start_task" />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="fa fa-calendar-alt"></i></span>
                                </div>
                            </div>

                        </div>
                        <div class="form-group ">
                            <label><span class="translate" data-args="start_date">deadline_date</span> <span class="req">*</span>:</label>
                            <div class="input-group ">
                                <input type="text" class="dtpicker form-control form-control-sm m-input m-input--square" placeholder="Select date & time" id="deadline_task" name="deadline_task" />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="fa fa-calendar-alt"></i></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
  

        
        <div id="contentsubtask"></div>
        <br />

        <div class="m-divider">
            <span></span>
            <span>
                <a class="btn btn-brand m-btn m-btn--icon btn-sm m-btn--pill" href="#" onclick="addsubtask()">
                    <i class="fa fa-plus"></i> sub task
                </a>
            </span>
            <span></span>
        </div>

        <hr />
        <div class="row">
            <div class="col-lg-12">
                <button type="submit" id="btn-save" class="btn btn-primary">Save</button>
                <button type="button" id="taskclose" class="btn btn-secondary" data-dismiss="modal">Close</a>
            </div>
        </div>
    </form>
    <div id="taskboardinit" class="row" style="display:block;">
        <div class="col-lg-12">
            <div class="m-loader m-loader--lg" style="width:100%; display: inline-block;"></div>
        </div>
    </div>
