@{
    ViewData["Title"] = "Team User";
    Layout = "~/Views/Shared/metronic/_formpanel.cshtml";
}
@section Panelhead{
    <span class="translate" data-args="Team">Team</span>
}

@section Paneltools{

}
@section Panelbody{
    <style>
        .checktd {
            width: 50px;
        }

        .acttd {
            width: 100px;
        }
    </style>
    <form id="TeamusersFormTeam" method="post">
        <div class="row ">
            <div class="col-lg-12">
                <input value="@ViewBag.RecordID" type="hidden" name="id" />
                <input value="" type="hidden" id="sub_brand" name="sub_brand" />
                <div class="form-group">
                    <label><span class="translate" data-args="Team">Team</span> <span class="req">*</span>:</label>
                    <input readonly style="width:100%" class="form-control form-control-sm m-input m-input--square" id="team_name" type="text">
                </div>

                <hr />
                <a href="javascript:void(0)" onclick="fnTeamusers.adduser()" class="m-btn btn btn-primary btn-sm m-btn--sm"><i class=" fa fa-user-plus"></i></a>
                <table class="table table-striped table-bordered table-hover table-checkable" id="TeamusersList">
                    <thead><tr><th>#</th><th>User Name</th><th>Email</th><th>As</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-lg-12">
                <button type="button" onclick="fnTeamusers.savedata()" id="btn-save" class="btn btn-primary">Save</button>
                <a href="~/ProjectManagement/Team" class="fakelink btn btn-secondary">Close</a>
            </div>

        </div>
    </form>
    @Html.Partial("Team/UserList")
}
@section Panelscript{

    <script src="~/assets/js/Areas/ProjectManagement/Form/Team/users.js"></script>
}
