@{
    ViewBag.ModalTitle = "LIST";
    ViewBag.ModalId = "categorylist";
    Layout = "~/Views/Shared/metronic/_ModalNormal.cshtml";
}


<div>
    <form action="#" method="post" id="TimesheetTaskCreate">
        <div class="form-group">
            <label class="m-checkbox m-checkbox--single m-checkbox--solid m-checkbox--brand" style="width:100px">
                Use Non Job
                <input type="checkbox" class="m-group-checkable" id="usenonjob">
                <span></span>
            </label>
        </div>
        <div id="optitem" class="form-group">
            <div id="jobselect">
                <label><span class="translate" data-args="Job"></span></label>
                <select id="job_number" name="task_id"></select>
            </div>

        </div>
        @*<div class="form-group" id="jobselect">
