<div class="row">

    <div class="col-lg-4 col-xs-4" style="padding-bottom:15px">
        <div class="card" style="background:#fff !important">
            <div class="card-header '+ranBg+' text-white">
                <b style="color:#000">Approval Summary</b>
            </div>
            <div class="card-body">
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Total Approved <label class="lblpmApproved pull-right float-right uk-text-bold" style="color:blue;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Total Rejected <label class="lblpmRejected pull-right float-right" style="color:forestgreen;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Waiting Approval <label class="lblpmWaiting pull-right float-right" style="color:lightseagreen;font-size:16px"></label></b>
                </div>

            </div>

        </div>

    </div>
    <div class="col-lg-4 col-xs-4" style="padding-bottom:15px">
        <div class="card" style="background:#fff !important">
            <div class="card-header '+ranBg+' text-white">
                <b style="color:#000">Job Status Summary</b>
            </div>
            <div class="card-body">
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Job Open <label class="lblJobOpen pull-right float-right uk-text-bold" style="color:blue;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Job in Progress <label class="lblJobInProgress pull-right float-right" style="color:forestgreen;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Job Delivered <label class="lblJobDelivered pull-right float-right" style="color:lightseagreen;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Job Closed <label class="lblJobClosed pull-right float-right" style="color:deeppink;font-size:16px"></label></b>
                </div>

            </div>

        </div>

    </div>
    <div class="col-lg-4 col-xs-4" style="padding-bottom:15px">
        <div class="card" style="background:#fff !important">
            <div class="card-header '+ranBg+' text-white">
                <b style="color:#000">My Task</b>
            </div>
            <div class="card-body">
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Total Task <label class="lblpmtask pull-right float-right uk-text-bold" style="color:blue;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>Overdue <label class="lblpmoverdue pull-right float-right" style="color:forestgreen;font-size:16px"></label></b>
                </div>
                <div class="col-md-12" style="padding-bottom:10px;padding-top:10px; border-bottom:1px solid #ddd">
                    <b>In Progress <label class="lblpminprogress pull-right float-right" style="color:lightseagreen;font-size:16px"></label></b>
                </div>

            </div>

        </div>

    </div>

</div>
