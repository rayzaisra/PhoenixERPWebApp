    <script>
        $(function () {
            getSectionSummary();
        })


        let getSectionSummary = function () {
            let urlApi = $.helper.resolveApi("~notifycenter/GetDsNewPm");
            $.ajax({
                type: "GET",
                dataType: 'json',
                url: urlApi,
                success: function (res) {

                    var datachart = [];
                    var dataTypeProjectName = [];
                    var dataTypeProjectCount = [];
                    var dataRevenueName = [];
                    var dataRevenueSum = [];
                    var dataJobThisWeekName = [];
                    var dataJobThisWeekCount = [];
                    var dataDivisionThisWeekName = [];
                    var dataDivisionThisWeekCount = [];
                    var dataJobGrade = [];

                    $('#my-hours-this-week').text(res.data.my_hours_this_week + ' h');
                    $('#my-hours-this-month').text(res.data.my_hours_this_month + ' h');
                    $('#my-billable-hours').text(res.data.my_billable_hours + ' h');
                    $('#my-non-billable-hours').text(res.data.my_non_billable_hours + ' h');
                    $('#team-billable-hours').text(res.data.team_billable_hours + ' h');
                    $('#team-non-billable-hours').text(res.data.team_non_billable_hours + ' h');
                    datachart.push(res.data.my_hours_this_week_percent);
                    datachart.push(res.data.my_hours_this_month_percent);
                    datachart.push(res.data.my_billable_hours_percent);
                    datachart.push(res.data.my_non_billable_hours_percent);
                    datachart.push(res.data.team_billable_hours_percent);
                    datachart.push(res.data.team_non_billable_hours_percent);
                    datachart.push(res.data.mine_job);
                    datachart.push(res.data.mine_job_percent);
                    datachart.push(res.data.div_job);
                    datachart.push(res.data.div_job_percent);


                    var htmlTBody = "";
                    $.each(res.dataMostUpdateJob, function (x, r) {

                        var tBody = '<tr>' +
                            '<td>' + (x + 1) + '</td>' +
                            '<td><a href="/projectmanagement/job/detail/' + r.job_number + '" > ' + r.projectName + '</a></td>' +
                            '<td>' + r.deadline + '</td>' +
                            '<td>' + r.status + '</td>' +
                            '</tr>';
                        htmlTBody += tBody;

                    });

                    $.each(res.dataProjectType, function (x, r) {
                        dataTypeProjectName.push(r.job_type_name);
                        dataTypeProjectCount.push(parseFloat(r.job_type_count));
                    });

                    $.each(res.dataRevenue, function (x, r) {
                        dataRevenueName.push(r.division_name);
                        dataRevenueSum.push(parseFloat(r.total_division_pce));
                    });

                    $.each(res.dataJobThisWeek, function (x, r) {
                        dataJobThisWeekName.push(r.my_job_task_this_week);
                        dataJobThisWeekCount.push(parseFloat(r.my_job_task_count_this_week));
                    });

                    $.each(res.dataDivisionThisWeek, function (x, r) {
                        dataDivisionThisWeekName.push(r.section_division_job);
                        dataDivisionThisWeekCount.push(parseFloat(r.section_division_job_count_this_week));
                    });

                    $.each(res.dataJobGrade, function (x, r) {
                        //dataJobGrade.push(r.is_job_grade_id_e1);
                        //dataJobGrade.push(parseFloat(r.is_show_revenue));

                        if (r.is_job_grade_id_e1 == '1') {
                            $('#teambillablehours').show();
                            $('#teamnonbillablehours').show();
                            $('#taskmineall').show();
                            $('#typeproject').show();
                        } else {
                            $('#teambillablehours').hide();
                            $('#teamnonbillablehours').hide();
                            $('#taskmineall').hide();
                            $('#typeproject').hide();
                        }

                        if (r.is_show_revenue == '1') {
                            $('#revenueByUnit').show();
                        } else {
                            $('#revenueByUnit').hide();
                        }
                    });

                    $('#tableListProjectThisWeek-body').empty();
                    $('#tableListProjectThisWeek-body').append(htmlTBody);
                    //drawSummary(data);

                    generateChart(datachart, dataTypeProjectName, dataTypeProjectCount, dataRevenueName, dataRevenueSum, dataJobThisWeekName, dataJobThisWeekCount, dataDivisionThisWeekName, dataDivisionThisWeekCount);
                },
                error: function (e, t, s) {
                    console.error('get info dashboard kanban getting error');
                }
            });
        };

