@Html.Partial("ModalSearchUser")
@Html.Partial("ModalSearchUserApproval")

<div class="uk-modal" id="content_task">
    <div class="uk-modal-dialog uk-modal-body">
        <div class="uk-modal-header">
            <h3 class="uk-modal-title">Create Assignment</h3>
        </div>
        <div class="uk-modal-body">
            <div class="uk-grid">
                <div class="uk-margin-medium-bottom">
                    <label for="task_priority" class="uk-form-label">Priority</label>
                    <div>
                        <span class="icheck-inline">
                            <input type="radio" name="task_priority" value="minor" id="task_priority_minor" data-md-icheck />
                            <label for="task_priority_minor" class="inline-label uk-badge uk-badge-success">LOW</label>
                        </span>
                        <span class="icheck-inline">
                            <input type="radio" name="task_priority" value="critical" id="task_priority_critical" data-md-icheck />
                            <label for="task_priority_critical" class="inline-label uk-badge uk-badge-warning">MEDIUM</label>
                        </span>
                        <span class="icheck-inline">
                            <input type="radio" name="task_priority" value="blocker" id="task_priority_blocker" data-md-icheck />
                            <label for="task_priority_blocker" class="inline-label uk-badge uk-badge-danger">HIGH</label>
                        </span>
                    </div>
                </div>
                <div class="uk-width-1-2">
                    <div class="uk-margin-medium-bottom">
                        <input id="title" class="md-input" placeholder="Title"/>
                    </div>
                    <div class="uk-margin-medium-bottom">
                        <div class="uk-grid">
                            <div class="uk-width-3-10">
                                <input type="text" class="md-input" id="time_estimation" name="time_estimation" />
                            </div>
                            <div class="uk-width-7-10">
                                <select class="uk-form-width-medium" id="selection_days" data-md-selectize-inline>
                                    <option>Hours</option>
                                    <option>Days</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="uk-margin-medium-bottom">
                        <div class="uk-input-group">
                            <div class="uk-grid">
                                <div class="uk-width-7-10">
                                    <label for="uk_dp_start">Start Date</label>
                                    <input class="md-input" type="text" id="Startdate" data-uk-datepicker="{format:'DD.MM.YYYY'}">
                                </div>
                                <div class="uk-width-3-10">
                                    <label for="uk_dp_start">Time</label>
                                    <input class="md-input" type="text" id="StartdateTime" data-uk-timepicker />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="uk-margin-medium-bottom">
                        <div class="uk-input-group">
                            <div class="uk-grid">
                                <div class="uk-width-7-10">
                                    <label for="uk_dp_start">Due Date</label>
                                    <input class="md-input" type="text" id="Deadline" data-uk-datepicker="{format:'DD.MM.YYYY'}">
                                </div>
                                <div class="uk-width-3-10">
                                    <label for="uk_dp_start">Time</label>
                                    <input class="md-input" type="text" id="DeadlineTime" data-uk-timepicker />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="uk-width-1-2">
                    <div class="uk-margin-medium-bottom">
                        <div class="uk-input-group">
                            <div class="uk-grid">
                                <div class="uk-width-8-10">
                                    <input type="text" class="md-input" placeholder="Assign To" id="AssignTo" />
                                </div>
                                <div class="uk-width-2-10">
                                    <button id="AssignName" onclick="SearchUser();">
                                        <i class="uk-icon-user"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="uk-margin-medium-bottom">
                        <div class="uk-input-group">
                            <div class="uk-grid">
                                <div class="uk-width-8-10">
                                    <input type="text" class="md-input" placeholder="Approve By" id="ApproveBy" />
                                </div>
                                <div class="uk-width-2-10">
                                    <button id="ApproveName" onclick="SearchUserApproval();"><i class="uk-icon-user"></i></button> @*data-uk-modal="{ center:true, target:'#ModalApproveName',modal: false }"><i class="uk-icon-user"></i></button>*@
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="uk-margin-medium-bottom">
                        <label for="description">Description</label>
                        <textarea class="md-input" id="description"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <div class="uk-modal-footer">
            <div class="uk-grid">
                <span class="uk-width-1-2">
                    <button type="button" class="btn-block uk-button uk-button-primary" onclick="addBoard()" id="snippet_new_save">Submit</button>
                    <button type="button" class="uk-button uk-button-default">Close</button>
                </span>
            </div>
        </div>
    </div>
</div>

@section Script {
    <script src="~/assets/plugins/dragula.js/dist/dragula.min.js"></script>
    <script src="~/assets/js/pages/page_scrum_board.min.js"></script>
    <script src="~/assets/js/Areas/ProjectManagement/Assignment/Index.js"></script>
}
