                                <li><input type="checkbox" data-md-icheck value="Udin" /> Udin</li>
                                <li><input type="checkbox" data-md-icheck value="Mamat" /> Mamat</li>
                            </ul>
                        </li>
                    </ul>
                </div>
                <div class="uk-width-1-3">
                    <ul>
                        <li>
