                                <li><input type="checkbox" data-md-icheck value="Rahmat" /> Rahmat</li>
                            </ul>
                        </li>
                        <li>
                            <input type="checkbox" id="c4" data-md-icheck onchange="checkAll(this,4)" /> Trade Marketing
                            <ul id="4">
                                <li><input type="checkbox" data-md-icheck value="Wahyu" /> Wahyu</li>
                                <li><input type="checkbox" data-md-icheck value="Rifqi" /> Rifqi</li>
                            </ul>
                        </li>
                    </ul>
