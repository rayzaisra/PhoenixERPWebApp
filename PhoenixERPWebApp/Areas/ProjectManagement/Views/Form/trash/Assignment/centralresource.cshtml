
@{
    ViewData["Title"] = "Central Resources Assignment";
}
<div id="page_content_inner">
    <div class="md-card uk-margin-medium-bottom">
        <div class="md-card-content ">
            <ul class="uk-breadcrumb" style="float:right">
                <li><a href="~/">Home</a></li>
                <li><a href="~/projectmanagement">PM</a></li>
                <li><span>@ViewBag.Title</span></li>
            </ul>
            <div style="float:left;font-size:30px;font-weight:bold;font-family:'Roboto'">@ViewBag.Title</div>
            <div style="clear:both"></div>
            <hr />
            <div class="uk-grid">
                <div class="uk-width-1-3">
                    <div class="uk-input-group">
                        <label for="campaignname">Campaign Name</label>
                        <input type="text" id="campaignname" name="campaignname" class="md-input label-fixed" data-uk-modal="{ center:true, target:'#ModalSearchCampaign',modal: false }" />
                        <span class="uk-input-group-addon"><i class="uk-input-group-icon uk-icon-search"></i></span>
                    </div>
                </div>
                <div class="uk-width-1-3">
                    <div class="uk-input-group">
                        <label for="jobnumber">Job Number</label>
                        <input type="text" id="jobnumber" name="jobnumber" class="md-input label-fixed" />
                        <span class="uk-input-group-addon"><i class="uk-input-group-icon uk-icon-search"></i></span>
                    </div>
                </div>
                <div class="uk-width-1-3">
                    <label for="centralresource">Central Resource</label>
                    <input type="text" id="centralresource" name="centralresource" class="md-input label-fixed" data-uk-modal="{ center:true, target:'#ModalSearchCR',modal: false }" />
                </div>
            </div>

            <br />
            <div class="uk-grid">
                <div class="uk-small-width-1-2">
                    <div class="uk-input-group">
                        <label for="jobname">Job Name</label>
                        <input type="text" id="jobname" name="jobname" class="md-input label-fixed" />
                    </div>
                    <div class="uk-input-group">
                        <label for="account">Account Management</label><br />
                        <span id="account"></span>
                    </div>
                </div>
                <div class="uk-small-width-1-2">
                    <div class="uk-grid">
                        <div class="uk-width-2-3">
                            <label for="uk_dp_start">Deadline</label>
                            <input class="md-input label-fixed" type="text" id="Deadline" disabled="disabled">
                        </div>
                        <div class="uk-width-1-3">
                            <input class="md-input" type="text" id="DeadlineTime" disabled="disabled">
                        </div>
                    </div>
                    <div class="uk-grid">
                        <div class="uk-width-2-3">
                            <label for="uk_dp_start">Final Delivery</label>
                            <input class="md-input label-fixed" type="text" id="FinalDelivery" disabled="disabled">
                        </div>
                        <div class="uk-width-1-3">
                            <input class="md-input" type="text" id="FinalDeliveryTime" disabled="disabled">
                        </div>
                    </div>
                </div>
            </div>
            <div>
                <button type="submit" class="md-btn md-btn-primary"> Submit</button>
            </div>
        </div>
    </div>
</div>

