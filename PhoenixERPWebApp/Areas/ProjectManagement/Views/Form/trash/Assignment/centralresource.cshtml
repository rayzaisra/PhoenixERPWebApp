                <div class="uk-width-1-3">
                    <ul>
                        <li>
                            <input type="checkbox" id="c5" data-md-icheck onchange="checkAll(this,5)" /> Digital
                            <ul id="5">
                                <li><input type="checkbox" id="51" data-md-icheck value="Anto" /> Anto</li>
                                <li><input type="checkbox" id="52" data-md-icheck value="Hanif" /> Hanif</li>
                            </ul>
                        </li>
                        <li>
                            <input type="checkbox" id="c6" data-md-icheck onchange="checkAll(this,6)" /> Activation
                            <ul id="6">
                                <li><input type="checkbox" data-md-icheck value="Erik" /> Erik</li>
                                <li><input type="checkbox" data-md-icheck value="Ulum" /> Ulum</li>
                                <li><input type="checkbox" data-md-icheck value="Asep" /> Asep</li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="uk-modal-footer">
            <button class="uk-button uk-button-primary" onclick="getCR()">Add</button>
        </div>
    </div>
</div>

