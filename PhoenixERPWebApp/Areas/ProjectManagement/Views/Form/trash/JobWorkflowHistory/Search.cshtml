@{
    ViewBag.ModalTitle = "JobWorkflowHistory";
    ViewBag.ModalId = "JobWorkflowHistoryModalSearch";
    Layout = "~/Views/Shared/altair/_ModalNormal.cshtml";
}
<form id="JobWorkflowHistoryFormSearch" method="post">
    
    <div class="uk-grid">
        <div class="uk-width-1-1">
            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="current_status_created_by">Current Status Created By</span></label>
                <input class="md-input" name="search_current_status_created_by" id="search_current_status_created_by"   maxlength="50" type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="current_status_created_date">Current Status Created Date</span></label>
                <input class="md-input" name="search_current_status_created_date" id="search_current_status_created_date"   type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="current_status_id">Current Status Id</span></label>
                <input class="md-input" name="search_current_status_id" id="search_current_status_id"   maxlength="50" type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="job_number">Job Number</span></label>
                <input class="md-input" name="search_job_number" id="search_job_number"   maxlength="50" type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="last_status_created_by">Last Status Created By</span></label>
                <input class="md-input" name="search_last_status_created_by" id="search_last_status_created_by"   maxlength="50" type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="last_status_created_date">Last Status Created Date</span></label>
                <input class="md-input" name="search_last_status_created_date" id="search_last_status_created_date"   type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="last_status_id">Last Status Id</span></label>
                <input class="md-input" name="search_last_status_id" id="search_last_status_id"   maxlength="50" type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="seq">Seq</span></label>
                <input class="md-input" name="search_seq" id="search_seq"   type="text">
            </div>        
        </div>
    </div>

    <div class="uk-modal-footer uk-text-right">
        <button type="button" onclick="fnJobWorkflowHistory.initsearch()" class="md-btn md-btn-primary"><i class="uk-icon-search"></i> Search</button>
        <button type="button" onclick="fnJobWorkflowHistory.initsearch('reset')" class="md-btn md-btn-success"><i class="uk-icon-times-circle"></i> Reset</button>
        <button type="button" class="md-btn md-btn-warning uk-modal-close"><i class="uk-icon-arrow-circle-o-left"></i>  Close</button>
    </div>
</form>