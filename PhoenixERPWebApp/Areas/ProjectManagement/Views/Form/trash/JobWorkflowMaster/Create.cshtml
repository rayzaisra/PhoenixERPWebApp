@{
    ViewBag.ModalTitle = "JobWorkflowMaster";
    ViewBag.ModalId = "JobWorkflowMasterModalCreate";
    Layout = "~/Views/Shared/altair/_ModalNormal.cshtml";
}
<form id="JobWorkflowMasterFormCreate" method="post">
    

    <div class="uk-grid">
        <div class="uk-width-1-1">
            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="description">Description</span> </label>
                <input class="md-input" name="description" id="description"  maxlength="250" type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="next_workflow">Next Workflow</span> </label>
                <input class="md-input" name="next_workflow" id="next_workflow"  maxlength="50" type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="screen_flow">Screen Flow</span> </label>
                <input class="md-input" name="screen_flow" id="screen_flow"  maxlength="250" type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="status">Status</span> </label>
                <input class="md-input" name="status" id="status"  maxlength="250" type="text">
            </div>        
        </div>
    </div>

    <div class="uk-modal-footer uk-text-right">
        <button type="submit" class="md-btn md-btn-primary"><i class="uk-icon-save"></i> Save</button>
        <button type="button" class="md-btn md-btn-warning uk-modal-close"><i class="uk-icon-arrow-circle-o-left"></i>  Close</button>
    </div>
</form>