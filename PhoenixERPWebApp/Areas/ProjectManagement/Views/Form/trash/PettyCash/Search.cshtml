@{
    ViewBag.ModalTitle = "PettyCash";
    ViewBag.ModalId = "PettyCashModalSearch";
    Layout = "~/Views/Shared/altair/_ModalNormal.cshtml";
}
<form id="PettyCashFormSearch" method="post">
    
    <div class="uk-grid">
        <div class="uk-width-1-1">
            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="petty_amount">Petty Amount</span></label>
                <input class="md-input" name="search_petty_amount" id="search_petty_amount"   type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="petty_date">Petty Date</span></label>
                <input class="md-input" name="search_petty_date" id="search_petty_date"   type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="task_id">Task Id</span></label>
                <input class="md-input" name="search_task_id" id="search_task_id"   maxlength="50" type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="transfer_bank_accname">Transfer Bank Accname</span></label>
                <input class="md-input" name="search_transfer_bank_accname" id="search_transfer_bank_accname"   maxlength="50" type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="transfer_bank_accno">Transfer Bank Accno</span></label>
                <input class="md-input" name="search_transfer_bank_accno" id="search_transfer_bank_accno"   maxlength="50" type="text">
            </div>            <div class="uk-form-row">
                <label class="label-block"><span class="translate"  data-args="transfer_status_id">Transfer Status Id</span></label>
                <input class="md-input" name="search_transfer_status_id" id="search_transfer_status_id"   maxlength="50" type="text">
            </div>        
        </div>
    </div>

    <div class="uk-modal-footer uk-text-right">
        <button type="button" onclick="fnPettyCash.initsearch()" class="md-btn md-btn-primary"><i class="uk-icon-search"></i> Search</button>
        <button type="button" onclick="fnPettyCash.initsearch('reset')" class="md-btn md-btn-success"><i class="uk-icon-times-circle"></i> Reset</button>
        <button type="button" class="md-btn md-btn-warning uk-modal-close"><i class="uk-icon-arrow-circle-o-left"></i>  Close</button>
    </div>
</form>