<form id="form-personal_info" class="m-form m-form--fit m-form--label-align-right m-form--group-seperator-dashed">
    <input hidden name="id" value="@ViewBag.RecordID" />
    <div class="m-portlet__body">
        <div class="m-form__group">
            <div class="row">
                <div class="col-lg-6 m-form__group-sub">
                    <div class="form-group">
                        <label>User Name:</label>
                        <input id="app_username" name="app_username" type="text" class="form-control form-control-sm m-input" placeholder="Enter user name">
                    </div>
                </div>
                <div class="col-lg-6 m-form__group-sub">
                    <div class="form-group">
                        <label>Full Name:</label>
                        <input id="app_fullname" name="app_fullname" type="text" class="form-control form-control-sm m-input" placeholder="Enter full name">
                    </div>
                </div>
                <div class="col-lg-6 m-form__group-sub">
                    <div class="form-group">
                        <label class="">Email:</label>
                        <input type="text" id="email" name="email" class="form-control form-control-sm m-input" placeholder="Enter email">
                    </div>
                </div>
                <div class="col-lg-6 m-form__group-sub">
                    <div class="form-group">
                        <label>Is Microsoft User:</label>
                        <div class="m-radio-inline">
                            <label class="m-radio m-radio--solid">
                                <input type="radio" name="is_msuser" value="true"> Yes
                                <span></span>
                            </label>
                            <label class="m-radio m-radio--solid">
                                <input type="radio" name="is_msuser" checked="" value="false"> No
                                <span></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12 m-form__group-sub">
                    <div class="form-group">
                        <label class="">Phone Number:</label>
                        <input id="phone" name="phone" class="form-control form-control-sm m-input" placeholder="Enter phone number">
                    </div>
                </div>
                <div class="col-lg-12 m-form__group-sub">
                    <div class="form-group">
                        <label class="">Employee :</label>
                        <input id="employee_id" name="employee_basic_info_id" style="width: 100%;height:100%" />
                    </div>
                </div>

            </div>
        </div>

        <div class="m-form__group">
            <div class="row">
                <div class="col-lg-6 m-form__group-sub">
                    <div class="form-group">
                        <label>System Administrator:</label>
                        <div class="m-radio-inline">
                            <label class="m-radio m-radio--solid">
                                <input type="radio" name="is_system_administrator" value="true"> Yes
                                <span></span>
                            </label>
                            <label class="m-radio m-radio--solid">
                                <input type="radio" name="is_system_administrator" checked="" value="false"> No
                                <span></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 m-form__group-sub">
                    <div class="form-group">
                        <label>Status:</label>
                        <div class="m-radio-inline">
                            <label class="m-radio m-radio--solid">
                                <input type="radio" name="is_active" checked="" value="true"> Active
                                <span></span>
                            </label>
                            <label class="m-radio m-radio--solid">
                                <input type="radio" name="is_active" value="false"> Not Active
                                <span></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="m-portlet__foot m-portlet__no-border m-portlet__foot--fit">
        <div class="m-form__actions m-form__actions--solid">
            <div class="row">
                <div class="col-lg-6">
                    <button type="button" id="btn-save" class="btn btn-primary">Save</button>
                    <a href="@Url.Content("~/Settings/User")" class="btn btn-secondary">Close</a>
                </div>
            </div>
        </div>
    </div>
</form>
