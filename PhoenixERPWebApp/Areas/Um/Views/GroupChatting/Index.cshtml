<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Manage Group Chat</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="#" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon la la-gear"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">System</span>
                    </a>
                </li>
                <li class="m-nav__separator">-</li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Application</span>
                    </a>
                </li>
                <li class="m-nav__separator">-</li>
                <li class="m-nav__item">
                    <a href="@Url.Content("~/Um/GroupChatting")" class="m-nav__link">
                        <span class="m-nav__link-text">Manage Group Chat</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div>
                                <a href="@Url.Content("~/Um/GroupChatting/Add")" class="m-btn btn btn-primary btn-sm m-btn--sm btnAdd-gc"><i class="la la-plus"></i></a>
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <div class="input-group">
                                    <div class="input-group-prepend"><span class="input-group-text input-group-sm sp-cari"><i class="la la-search"></i></span></div>
                                    <input autocomplete="off" type="text" name="q" class="form-control form-control-sm m-input searchbox" placeholder="Search">
                                </div>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list" style="max-height:500px;overflow-x:auto">
                    <!--begin: Datatable -->
                    <table class="table table-striped- table-bordered table-hover table-checkable" id="dt_basic">
                        <thead>
                            <tr>
                                <th>Group Name</th>
                                <th><i class="fa fa-cogs pull-right"></i></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>

                    <div class="clearfix"></div>
                </div>
                <div class="m-portlet__body">
                </div>
            </div>


        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Areas/Um/Scripts/groupChattingapp.js" asp-append-version="true"></script>
    <script>
        $(function () {
            var pun = $('#hidPageUniqueName').val();
            if (pun === '' || pun === undefined || pun === null) {
                sessionStorage.removeItem('uniquePage');
            }
            else {
                let urlApi = $.helper.resolveApi("~ManageUserAccess/GetMenuAccessByUniqueName/" + pun);
                $.ajax({
                    type: "GET",
                    dataType: 'json',
                    url: urlApi,
                    success: function (data) {
                        sessionStorage.setItem('uniquePage', JSON.stringify(data));
                        var dt = sessionStorage.getItem('uniquePage');
                        dt = JSON.parse(dt);
                        if (dt !== null) {
                            if (dt.isRead) {
                                loadData();
                                $('.sp-cari').on('click', function () { loadData(); });
                            }
                            if (dt.isAdd == false) {
                                $('.btnAdd-gc').hide();
                            }
                        }
                    },
                    error: function (e, t, s) {
                        console.error('Error Getting INformation Page Unique Name FOr User Access');
                        console.log(e);
                        console.log(t);
                        console.log(s);
                    }
                });
            }



        });
    </script>
}


