<div id="modalListTempApproval" class="modal fade" role="dialog" data-backdrop="static" data-keyboard="false"> 
    <div class="modal-dialog modal-lg" style="max-width:95%">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">LIST OF TEMPLATE APPROVAL</h4>
            </div>
            <div class="modal-body">
                <table class="table table-striped- table-bordered table-hover table-checkable" id="dtTempApproval">
                    <thead>
                        <tr>
                            <th rowspan="2">#SELECT TEMPLATE</th>
                            <th rowspan="2">TEMPLATE NAME</th>
                            <th colspan="2">NOTIFICATION</th>
                            <th colspan="2">REMINDER</th>
                            <th rowspan="2">TYPE</th>
                            <th rowspan="2">CATEGORY</th>
                            <th rowspan="2"><i class="fa fa-cogs pull-right"></i></th>
                        </tr>
                        <tr>
                            <th>WEB</th>
                            <th>EMAIL</th>
                            <th>DUE DATE</th>
                            <th>REMINDER</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

                <div class="clearfix"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn md-btn-danger" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>
</div>

