@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/bundles/css/datatable.min.css" rel="stylesheet" />
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">User Management</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="#" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon la la-gear"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">System</span>
                    </a>
                </li>
                <li class="m-nav__separator">-</li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Change Password</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">                            <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>                        </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <div class="form-group">
                        <label>New Password</label>
                        <input type="password" class="form-control in-pwd" maxlength="20"/>
                    </div>
                    <div class="form-group">
                        <label>Confirm New Password</label>
                        <input type="password" class="form-control in-pwd-confirm"  maxlength="20"/>
                    </div>
                    <div class="form-group">
                        <button class="btn btn-sm btn-primary btn-change-pwd">SUBMIT</button>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(function () {
            $('.btn-change-pwd').on('click', function () {
                if ($('.in-pwd').val().length === 0 || $('.in-pwd').val() === '') {
                    swal(
                        'Information',
                        'New Password cannot empty!',
                        'warning'
                    );
                    return false;
                }
                if ($('.in-pwd-confirm').val().length === 0 || $('.in-pwd-confirm').val() === '') {
                    swal(
                        'Information',
                        'Confirm New Password cannot empty!',
                        'warning'
                    );
                    return false;
                }

                if ($('.in-pwd').val() !== $('.in-pwd-confirm').val()) {
                    swal(
                        'Information',
                        'Confirm password not same with new password !',
                        'warning'
                    );
                    return false;
                }
                var model = { newpwd: $('.in-pwd').val(), confirmpwd: $('.in-pwd-confirm').val()};
                mApp.blockPage({
                    overlayColor: "#000000",
                    type: "loader",
                    state: "primary",
                    message: "Processing..."
                }),
                    $.ajax({
                    type: "POST",
                    dataType: 'json',
                    contentType: 'application/json',
                    url: $.helper.resolveApi("~/ManageUser/ChangePword"),
                    data: JSON.stringify(model),
                    success: function (r) {
                        Swal.fire({
                            title: 'Information?',
                            text: "Change Password has been successful,please login again",
                            type: 'success',
                            showCancelButton: false,
                            confirmButtonColor: '#3085d6',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'Logout!'
                        }).then((result) => {
                            if (result.value) {
                                window.location.href = "/core/authentication/logout";
                            }
                        });
                    },
                    error: function (r) {
                        console.log('masuk error');
                        console.log(r);
                        swal(
                            '' + r.status,
                            r.statusText,
                            'error'
                        );
                    }
                    }).then(setTimeout(function () {
                        mApp.unblockPage();
                    }, 2e3));
            });
        })
    </script>
}


