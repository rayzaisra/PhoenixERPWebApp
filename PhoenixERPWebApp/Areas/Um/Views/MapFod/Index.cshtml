                <div class="m-portlet__body" id="m_blockui_list">
                    <!--begin: Datatable -->
                    <div class="row">
                        <div class="input-group mb-3">
                            <input type="text" class="form-control txt-find-folder" placeholder="find folder name" aria-label="find folder name" aria-describedby="basic-addon2">
                            <div class="input-group-append">
                                <span class="input-group-text btn btn-sm btn-default" id="btn-find-folder">Searching</span>
                            </div>
                        </div>

                    </div>
                    <div class="row"  style="max-height:600px;overflow-x:auto">
                        <table class="table table-striped- table-bordered table-hover table-checkable" id="dt_basic">
                            <thead>
                                <tr>
                                    <th><b>#Nama</b></th>
                                    <th style="width:225px"><b>#Action</b></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            </div>
    </div>
</div>

@section Scripts{
    <script src="~/Areas/Um/Scripts/manage.fod.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var pun = $('#hidPageUniqueName').val();
            if (pun === '' || pun === undefined || pun === null) {
                sessionStorage.removeItem('uniquePage');
            }
            else {
                let urlApi = $.helper.resolveApi("~ManageUserAccess/GetMenuAccessByUniqueName/" + pun);
                $.ajax({
                    type: "GET",
                    dataType: 'json',
                    url: urlApi,
                    success: function (data) {
                        sessionStorage.setItem('uniquePage', JSON.stringify(data));
                        var dt = sessionStorage.getItem('uniquePage');
                        dt = JSON.parse(dt);
                        if (dt !== null) {
                            if (dt.isRead) loadData("");
                        }

                        var listFolder = [];
                        listFolder.push({ id: 0, name: 'ROOT', link: '' });
                        sessionStorage.setItem('breadcrumpod', JSON.stringify(listFolder));

                        $('#btn-find-folder').on('click', function () {
                            var key = $('.txt-find-folder').val();
                            loadData(key);
                        });
                    },
                    error: function (e, t, s) {
                        console.error('Error Getting INformation Page Unique Name FOr User Access');
                        console.log(e);
                        console.log(t);
                        console.log(s);
                    }
                });
            }


        });
    </script>

}


