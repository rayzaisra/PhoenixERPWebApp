@{
    ViewData["Title"] = "One Drive Office 365";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/bundles/css/datatable.min.css" rel="stylesheet" />
<link href="~/vendors/custom/datatables/datatables.bundle.css" rel="stylesheet" />
<style>
    .dataTables_wrapper .dataTables_paginate .pagination .page-item > .page-link {
        border: 1px solid #ddd;
        border-radius: 15px;
    }

    .pagination > .active, ul > .active {
        background-color: rgba(0,0,0,0.0);
    }
    .dataTables_wrapper {
        width:100%
    }
</style>
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">Sample</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="#" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon la la-gear"></i>
                    </a>
                </li>
                <li class="m-nav__separator">-</li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">Upload To One Drive And Priview Image</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <h3 class="h-title">NEW MESSAGE</h3>
                    </div>
                    <div class="m-portlet__head-tools">
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">
                                    <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list">
                    <div class="form-group">
                        <label class="label-block">SELECT FILE</label>
                        <input type="file" class="form-control" id="fu" placeholder="select file for upload to drive" />
                        <label class="label-block label-info-fu" style="font-weight:bold"></label>
                    </div>
                    <div class="form-group">
                        <button type="button" class="btn btn-sm btn-primary btnsave-uploadTodrive" style="display:block">Save</button>
                    </div>

                    <table class="table table-striped- table-bordered table-hover table-checkable" id="dt_list">
                        <thead>
                            <tr>
                                <th><b>#FILE NAME</b></th>
                                <th style="width:225px"><b>#Action</b></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/vendors/custom/datatables/datatables.bundle.js"></script>

    <script>
        $(function () {
            bindList();
            $('.btnsave-uploadTodrive').on('click', function () {
                uploadToDrive();
            });
        });

        let bindList = function () {
            let urlApi = $.helper.resolveApi("~odrive/GetUploadedFiles");
            mApp.blockPage({
                overlayColor: "#000000",
                type: "loader",
                state: "primary",
                message: "Processing..."
            }),
                $.ajax({
                    type: "GET",
                    dataType: 'json',
                    url: urlApi,
                    success: function (data) {
                        bindTable(data);
                    },
                    error: function (e, t, s) {
                        //swal(
                        //    'Information',
                        //    'Ooops, something went wrong !',
                        //    'info'
                        //);
                        console.log(e);
                    }
                }).then(setTimeout(function () {
                    mApp.unblockPage();
                }, 2e3));

        };

        let bindTable = function (data) {
            $('#dt_list> tbody').empty();
            let table = $('#dt_list > tbody:last-child');
            $.each(data, function (r, val) {
                if (typeof (val.folder) === 'undefined') {
                    var row = "<tr>";
                    row = row + "<td><i class='fa fa-file' style='color:#b54faa'></i> " + val.name + "</td>";
                    row = row + "<td><button class='btn btn-sm btn-small btn-default' title='preview file' onclick='prevFile(\"" + val.id + "\")'><i class='fa fa-folder-open' style='color:#ffd969'></i></button></td>";
                    row = row + "</tr>";
                    table.append(row);
                }
            });

        };

        let uploadToDrive = function () {
            var files = $("#fu").get(0).files;
            if (files.length === 0) {
                return swal(
                    'Information',
                    'Ooops, there is no file for upload, please select file first before upload!',
                    'warning'
                );
            }

            let fullPath = "UploadedFiles/" + files[0].name;
            var frmData = new FormData();

            frmData.append("File", files[0]);
            frmData.append("Path", "UploadedFiles");
            frmData.append("PathFullWithFileName", "UploadedFiles/" + );
            frmData.append("IsBig", true);
            let urlApi = $.helper.resolveApi("~odrive/uploadtodrive");

            $.ajax({
                url: urlApi,
                type: "POST",
                cache: false,
                processData: false,
                contentType: false,
                data: frmData,
                success: function (responseData) {
                    bindTable(responseData);
                },
                error: function (error) { console.log(error); }
            });


        };

    </script>

}


