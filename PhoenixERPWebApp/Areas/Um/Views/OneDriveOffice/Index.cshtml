@{
    ViewData["Title"] = "One Drive Office 365";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/bundles/css/datatable.min.css" rel="stylesheet" />
<!-- BEGIN: Subheader -->
<div class="m-subheader ">
    <div class="d-flex align-items-center">
        <div class="mr-auto">
            <h3 class="m-subheader__title m-subheader__title--separator">One Drive Office</h3>
            <ul class="m-subheader__breadcrumbs m-nav m-nav--inline">
                <li class="m-nav__item m-nav__item--home">
                    <a href="#" class="m-nav__link m-nav__link--icon">
                        <i class="m-nav__link-icon la la-gear"></i>
                    </a>
                </li>
                <li class="m-nav__item">
                    <a href="javascript:return;" class="m-nav__link">
                        <span class="m-nav__link-text">System</span>
                    </a>
                </li>
                <li class="m-nav__separator">-</li>
                <li class="m-nav__item">
                    <a href="@Url.Content("~/Um/OneDriveOffice")" class="m-nav__link">
                        <span class="m-nav__link-text">One Drive Office</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- END: Subheader -->

<div class="m-content">
    <div class="row">
        <div class="col-md-12">
            <div class="m-portlet m-portlet--head-sm" m-portlet="true">
                <div class="m-portlet__head">
                    <div class="m-portlet__head-caption">
                        <div class="m-portlet__head-title">
                            <div class="div-breadcump">
                                <ul class="m-subheader__breadcrumbs m-nav m-nav--inline ul-bredchild">
                                    <li class="m-nav__item">
                                        <a href="javascript:linkBreadCrump('ROOT')" class="m-nav__link">
                                            <i class="m-nav__link-icon la la-gear"></i>&nbsp;
                                            <span class="m-nav__link-text">ROOT</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="m-portlet__head-tools">
                        <div class="btn-group" role="group">
                            <div class="col-lg-12">
                                <button class="btn btn-sm btn-info btn-form-upload"><i class="fa fa-upload"></i> Upload</button>
                                <button class="btn btn-sm btn-warning btn-form-folder"><i class="fa fa-folder"></i> Create Folder</button>
                            </div>
                        </div>
                        <ul class="m-portlet__nav">
                            <li class="m-portlet__nav-item">
                                <a href="#" m-portlet-tool="fullscreen" class="m-portlet__nav-link m-portlet__nav-link--icon" aria-describedby="tooltip_d4ny9s36oh"><i class="la la-expand"></i></a>
                                <div class="m-tooltip m-tooltip--portlet tooltip bs-tooltip-top" role="tooltip" id="tooltip_d4ny9s36oh" aria-hidden="true" x-placement="top" style="position: absolute; will-change: transform; visibility: hidden; top: 0px; left: 0px; transform: translate3d(372px, -33px, 0px);">
                                    <div class="tooltip-arrow arrow" style="left: 48px;"></div>                            <div class="tooltip-inner">Fullscreen</div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="m-portlet__body" id="m_blockui_list" style="max-height:400px;overflow-x:auto">
                    <!--begin: Datatable -->
                    <table class="table table-striped- table-bordered table-hover table-checkable" id="dt_basic">
                        <thead>
                            <tr>
                                <th><b>#Nama</b></th>
                                <th><b>#Type</b></th>
                                <th><b>#Modified</b></th>
                                <th><b>#Modified By</b></th>
                                <th><b>#File Size</b></th>
                                <th><b>#<i class="fa fa-file-download"></i></b></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_FormUpload" />
<div id="modalCreateFolder" class="modal" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-sm" style="max-width:40%">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-body">
                <div class="col-md-12">
                    <h4 class="modal-title title-modal-tempApp">CREATE FOLDER</h4>
                    <div class="form-group">
                        <label class="label-block">Folder Name :</label>
                        <input type="text" class="form-control tb-folder-name" />
                    </div>
                    <div class="clearfix"></div>
                    <button type="button" class="btn btn-sm btn-default pull-right" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-sm btn-primary  pull-right btncreate-folder" style="display:block">Save</button>
                </div>
            </div>
        </div>

    </div>
</div>
@section Scripts{
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.22.2/moment.min.js"></script>
    <script src="~/Areas/Um/Scripts/onedriveapp.js" asp-append-version="true"></script>
    <script>
        moment().format('DD/MM/YYYY');
    </script>

}


