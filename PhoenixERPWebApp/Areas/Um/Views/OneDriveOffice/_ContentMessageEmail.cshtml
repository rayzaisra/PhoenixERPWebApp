<div class="m-portlet m-portlet--head-sm" m-portlet="true">

    <div class="col-md-12 form-group" style="min-height: 4.1rem; border-bottom: 1px solid #d0d0d0;padding-bottom:10px;">
        <span class="m-nav__link-text bold sp-from-to"></span><br />
        <div class="ul-list-receipt">
            <span class="m-nav__link-text la la-user sender-from"></span>
