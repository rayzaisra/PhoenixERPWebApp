<input type="hidden" id="HidMenuId" value="0" />
<input type="hidden" id="HidId" value="0" />
<input type="hidden" id="HidTypeUserApp" value="CURRENT" />
<input type="hidden" id="HidCurrentEmpId" value="0" />

<partial name="_popupEmployee" />

@section Scripts{
    <script src="~/Areas/Um/Scripts/AddTemplateApproval.js" asp-append-version="true"></script>
}



