@model object
@(Html.Kendo().DropDownListFor(m => m)
    .DataTextField("Text")
    .DataValueField("Value")
    .OptionLabel("-- Select --")
    .HtmlAttributes(new { style = "width:100%;", required = "required" })
    .Height(400)
    .Filter(FilterType.Contains)
     .Events(evt => evt.Select("GR_Select"))
    .DataSource(source => source
        .Custom()
        .Transport(transport => transport
        .Read(read =>
        {
            read.Action("GetFixedAssetByLocation", "Dropdown", new { area = "Finance" }).Data("grid_params");
        })))
//.Events(evt => evt.Change("FixedAssetIdOnChange"))
)
