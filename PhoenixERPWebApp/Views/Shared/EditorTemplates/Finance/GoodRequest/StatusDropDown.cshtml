@model object 
@(Html.Kendo().DropDownListFor(m => m)
                .DataTextField("Text")
                .DataValueField("Value")
                .OptionLabel("")
                .HtmlAttributes(new { style = "width:100%;"})
                .Filter(FilterType.Contains)
                                .BindTo(new List<SelectListItem>()
                                {
                                    new SelectListItem() {
                                    Text = "Yes", Value ="Yes"
                                    },
                                                                             
                                    new SelectListItem() {
                                    Text = "No", Value ="No"
                                    }
                                })
)