@model object
@{ }
@(Html.Kendo().DropDownListFor(m => m)
    .DataTextField("Text")
    .DataValueField("Value")
    .OptionLabel("Select Account Number..")
    .HtmlAttributes(new { style = "width:100%;", required = "required",@id="AccountAdditionalId" })
    .Height(400)
    .Filter(FilterType.Contains)
    .Events(evt=>evt.Select("AccountNumber_Select"))
    .DataSource(source => source
        .Custom()
        .Transport(transport => transport
        .Read(read =>
        {
            read.Action("GetCOALV5", "Dropdown", new { area = "Finance" });
        }))
        .ServerFiltering(true))
)
