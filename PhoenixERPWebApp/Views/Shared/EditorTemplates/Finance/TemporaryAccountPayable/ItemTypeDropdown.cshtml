@model object
@(Html.Kendo().DropDownListFor(m => m)
    .DataTextField("Text")
    .DataValueField("Value")
    .OptionLabel("Select Item Type..")
    .HtmlAttributes(new { style = "width:100%;", required = "required",@id="ItemTypeAdditionalId" })
    .Height(400)
    .Filter(FilterType.Contains)
    .Events(evt => evt.Select("ItemType_Select"))
    .DataSource(source => source
        .Custom()
        .Transport(transport => transport
        .Read(read =>
        {
            read.Action("GetDDLItemType", "Dropdown", new { area = "Finance" });
        }))
        .ServerFiltering(true))
)
