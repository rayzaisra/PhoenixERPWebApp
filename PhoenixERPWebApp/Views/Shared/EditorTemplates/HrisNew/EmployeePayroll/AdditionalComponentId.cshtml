@model object
@{ }
@(Html.Kendo().DropDownListFor(m => m)
    .DataTextField("Text")
    .DataValueField("Value")
    .OptionLabel("-- Select --")
    .HtmlAttributes(new { style = "width:100%;", required = "required"})
    .Height(400)
    .Filter(FilterType.Contains)
    .Events(evt=>evt.Select("ComponentTypeAdditional_Select"))
    .DataSource(source => source
        .Custom()
        .Transport(transport => transport
        .Read(read =>
        {
            read.Action("GetDDLComponentTypeAdditional", "Dropdown", new { area = "HrisNew" }).Data("ComponentTypeAdditional_params");
        }))
        .ServerFiltering(true))
    .Enable(false)
    .AutoBind(true)
    .CascadeFrom("AdditionalSalaryComponent")
)
