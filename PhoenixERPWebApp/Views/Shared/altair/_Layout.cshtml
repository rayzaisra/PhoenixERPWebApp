@using Microsoft.Extensions.Options;
@using CodeMarvel.Infrastructure.Options;
@inject IOptions<AppSettingsOption> OptionsApplicationConfiguration

@{
    var userSession = CodeMarvel.Infrastructure.Sessions.SessionManager.UserSession;
    var xlang = "en";
    if (userSession.Language != null)
    {
        xlang = userSession.Language;
    }
}
<!doctype html>
<!--[if lte IE 9]> <html class="lte-ie9" lang="en"> <![endif]-->
<!--[if gt IE 9]><!-->
<html lang="@xlang">
<!--<![endif]-->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Remove Tap Highlight on Windows Phone IE -->
    <meta name="msapplication-tap-highlight" content="no" />
    <meta name="JWT_TOKEN" content="@userSession.Token" />

    <link rel="icon" type="image/png" href="~/assets/img/favicon-16x16.png" sizes="16x16">
    <link rel="icon" type="image/png" href="~/assets/img/favicon-32x32.png" sizes="32x32">
    <title>Phoenix APP</title>


    <link href="~/assets/css/menu.css" rel="stylesheet" />
    <!-- uikit -->
    <link rel="stylesheet" href="~/assets/plugins/uikit/css/uikit.almost-flat.css" media="all">
    <!-- flag icons -->
    <link rel="stylesheet" href="~/assets/icons/flags/flags.css" media="all">
    <!-- style switcher -->
    <link rel="stylesheet" href="~/assets/css/style_switcher.min.css" media="all">

    <!-- altair admin -->
    <link rel="stylesheet" href="~/assets/css/main.min.css" media="all">
    <!-- themes -->
    <link rel="stylesheet" href="~/assets/css/themes/themes_combined.min.css" media="all">
    <link rel="stylesheet" href="~/assets/css/style.css" media="all">
    <!-- matchMedia polyfill for testing media queries in JS -->
    <!--[if lte IE 9]>
        <script type="text/javascript" src="~/assets/plugins/matchMedia/matchMedia.js"></script>
        <script type="text/javascript" src="~/assets/plugins/matchMedia/matchMedia.addListener.js"></script>
        <link rel="stylesheet" href="~/assets/css/ie.css" media="all">
    <![endif]-->
    <link rel="stylesheet" href="~/assets/plugins/select2/select2.min.css" media="all">
    <script src="~/assets/plugins/es6.promise/es6-promise.js"></script>
    <script src="~/assets/plugins/es6.promise/es6-promise.auto.js"></script>

    <link rel="stylesheet" href="~/assets/plugins/dropify/css/dropify.css">
    <link rel="stylesheet" href="~/assets/plugins/ion.rangeslider/css/ion.rangeSlider.css">
    <link rel="stylesheet" href="~/assets/plugins/roboto/roboto.css" media="all">
    <link rel="stylesheet" href="~/assets/plugins/custom/custom.css" media="all">
    <script src="~/assets/plugins/jquery/dist/jquery.min.js"></script>
    <script>        
        $(document).ajaxSend(function (event, jqxhr, settings) {
            jqxhr.setRequestHeader('Authorization', 'Bearer @userSession.Token');
        });

        var LayoutPageFunction = {
            init: function () {
                $.helper.setTokenData(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(userSession)));
                $.helper.setApiBasePath("@OptionsApplicationConfiguration.Value.ApiServerUrl");
            }
        };
        LayoutPageFunction.init();

        var WEB = 'http://localhost:19772';

        var WEB_GENERAL = WEB + "/General";
        var WEB_FINANCE = WEB + "/Finance";
        var WEB_HRIS = WEB + "/Hris";
        var WEB_PM = WEB + "/ProjectManagement";
        var API = '@OptionsApplicationConfiguration.Value.ApiServerUrl'
        var API_GENERAL = API+'General'
        var API_FINANCE = API +'Finance'
        var API_HRIS = API +'Hris'
        var API_PM = API +'Projectmanagement'
        var NOT_USING_AUTH_HEADER = false;
    </script>

    @if (IsSectionDefined("Style"))
    {
        @RenderSection("Style")
    }
</head>
<body class="sidebar_main_open sidebar_main_swipe uk-height-1-1 ">
    <div id="dloader">
        <div class="pwait bg-white" style="width:120px;text-align:center"><h4>Please Wait..</h4><img src="~/assets/img/loading.gif"></div>
    </div>
    @Html.Partial("altair/_header")
    @Html.Partial("altair/_menu")

    <div id="page_content" class="uk-height-1-1">


        @RenderBody()


    </div>
    <div id="chat-snippet" class="" style="display:none">
        <partial name="_TemplateChatting" />
    </div>
    <input type="hidden" value="@ViewBag.PageUniqueName" id="hidPageUniqueName" />


    <script src="~/assets/js/common.min.js"></script>
    <!-- uikit functions -->
    <script src="~/assets/js/uikit_custom.min.js"></script>
    <!-- altair common functions/helpers -->
    <script src="~/assets/js/altair_admin_common.js"></script>
    <script src="~/assets/plugins/moment/min/moment-with-locales.min.js"></script>
    <script src="~/assets/plugins/history/bundled/html4_html5/jquery.history.js"></script>
    <script src="~/assets/js/axios.min.js"></script>

    <script src="~/assets/plugins/jquery.i18n/jquery.i18n.js"></script>
    <script src="~/assets/plugins/jquery.i18n/jquery.i18n.messagestore.js"></script>
    <script src="~/assets/plugins/jquery.i18n/jquery.i18n.fallbacks.js"></script>
    <script src="~/assets/plugins/jquery.i18n/jquery.i18n.language.js"></script>
    <script src="~/assets/plugins/jquery.i18n/jquery.i18n.parser.js"></script>
    <script src="~/assets/plugins/jquery.i18n/jquery.i18n.emitter.js"></script>
    <script src="~/assets/plugins/jquery.i18n/jquery.i18n.emitter.bidi.js"></script>
    <script src="~/assets/module/core-ie.js?r=@ViewBag.NOW"></script>

    <!-- page specific plugins -->
    <script src="~/assets/plugins/custom/custom.js"></script>
    <script src="~/assets/plugins/jquery/validate/jquery.validate.min.js"></script>
    <script src="~/assets/plugins/jquery/validate/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/assets/plugins/push.js/push.min.js"></script>

    <script src="~/assets/plugins/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/plugins/datatables-buttons/js/dataTables.buttons.js"></script>
    <script src="~/assets/plugins/datatables-buttons/js/buttons.colVis.js"></script>
    <script src="~/assets/js/custom/datatables/buttons.uikit.js"></script>
    <script src="~/assets/js/custom/datatables/datatables.uikit.min.js"></script>
    <script src="~/assets/plugins/datatables/media/js/fnSetFilteringDelay.js"></script>
    <!-- ionrangeslider -->
    <script src="~/assets/plugins/ion.rangeslider/js/ion.rangeSlider.min.js"></script>
    <!-- htmleditor (codeMirror) -->
    <script src="~/assets/js/uikit_htmleditor_custom.min.js"></script>
    <script src="~/assets/plugins/parsleyjs/dist/parsley.min.js"></script>
    <script src="~/assets/plugins/select2/select2.js"></script>
    <!-- inputmask-->
    <script src="~/assets/plugins/jquery.inputmask/dist/jquery.inputmask.bundle.js"></script>
    <script src="~/assets/plugins/jquery.form/jquery.form.min.js"></script>

    <script src="~/signalr/dist/browser/signalr.js"></script>
    <script src="~/assets/js/nava-hub.js"></script>
    <script src="~/assets/js/chat-comment.js"></script>

    @if (IsSectionDefined("Script"))
    {
        @RenderSection("Script")
    }

    <script>
        $(function () {

            if (isHighDensity()) {
                $.getScript("@Url.Content("assets/plugins/dense/src/dense.js")", function () {
                    // enable hires images
                    altair_helpers.retina_images();
                });
            }
            if (Modernizr.touch) {
                // fastClick (touch devices)
                FastClick.attach(document.body);
            }
        });
        $window.load(function () {
            // ie fixes
            altair_helpers.ie_fix();
        });
    </script>

</body>
</html>


