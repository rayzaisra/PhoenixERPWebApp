<style>
    .modallargewidth {
        width: 90%;
        max-width: 1200px;
    }
</style>
<div id="@ViewBag.ModalId" class="modal fade"  role="dialog" aria-labelledby="confirm-modal" aria-hidden="true">
<div class="modal-dialog modallargewidth">
