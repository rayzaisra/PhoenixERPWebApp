      <BalanceSheet Ref="3" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
        <Alias>BalanceSheet</Alias>
        <Columns isList="true" count="13">
          <value>lv1_number,System.String</value>
