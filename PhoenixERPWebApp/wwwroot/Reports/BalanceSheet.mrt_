          <value>account_name,System.String</value>
          <value>debit,System.Decimal</value>
          <value>credit,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>BalanceSheet</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="1">
          <value>p_legal_entity_id,legal_entity_id,12,50</value>
        </Parameters>
        <SqlCommand>DECLARE 
@startDate Datetime2(7),
@endDate Datetime2(7);

SELECT TOP(1) 
@startDate = r.start_date, 
@endDate = r.end_date 
FROM [fn].[financial_year] r WHERE r.legal_entity_id='9b3e97e5-dd0a-4cd6-bbcd-ab9e8c9c8035' 
AND r.is_active=1 AND COALESCE(r.is_deleted,0)=0;


WITH ASSETS AS (
SELECT 
	lv1.account_number AS lv1_number,
	lv1.account_name AS lv1_name,
	lv2.account_number AS lv2_number,
	lv2.account_name AS lv2_name,
	lv3.account_number AS lv3_number,
	lv3.account_name AS lv3_name,
	lv4.account_number AS lv4_number,
	lv4.account_name AS lv4_name,
	a.id AS account_id,
	a.account_number,a.account_name,

	SUM(COALESCE(r.debit,0)) AS debit,
	SUM(COALESCE(r.credit,0)) AS credit
	FROM fn.financial_transaction_detail r
LEFT OUTER JOIN fn.financial_transaction ft ON ft.id=r.financial_transaction_id
LEFT OUTER JOIN fn.financial_transaction_type ftt ON ftt .id=ft.transaction_type_id
LEFT OUTER JOIN fn.account a ON a.id=r.account_id

LEFT OUTER JOIN fn.account lv1 ON lv1.id=[fn].[get_parent_account](a.id,1)
LEFT OUTER JOIN fn.account lv2 ON lv2.id=[fn].[get_parent_account](a.id,2)
LEFT OUTER JOIN fn.account lv3 ON lv3.id=[fn].[get_parent_account](a.id,3)
LEFT OUTER JOIN fn.account lv4 ON lv4.account_level=4 AND (lv4.id = [fn].[get_parent_account](a.id,4) OR lv4.id = [fn].[get_parent_account](a.id,5))

WHERE 
COALESCE(r.is_active,0)=1 AND COALESCE(r.is_deleted,0)=0  AND
COALESCE(ft.is_active,0)=1 AND COALESCE(ft.is_locked,0)=1 AND COALESCE(ft.is_deleted,0)=0 
AND a.account_level=5
AND SUBSTRING(a.account_number,0,2)='1' 
AND r.legal_entity_id=@p_legal_entity_id
AND ft.transaction_datetime &gt;= @startDate AND  ft.transaction_datetime &lt;= @endDate 
GROUP BY 
lv1.account_number,
	lv1.account_name,
	lv2.account_number,
	lv2.account_name,
	lv3.account_number,
	lv3.account_name,
	lv4.account_number,
	lv4.account_name,
	a.id,
	a.account_number,
	a.account_name
),
LIABILITIES AS (
SELECT 
	lv1.account_number AS lv1_number,
	lv1.account_name AS lv1_name,
	lv2.account_number AS lv2_number,
	lv2.account_name AS lv2_name,
	lv3.account_number AS lv3_number,
	lv3.account_name AS lv3_name,
	lv4.account_number AS lv4_number,
	lv4.account_name AS lv4_name,
	a.id AS account_id,
	a.account_number,a.account_name,

	SUM(COALESCE(r.debit,0)) AS debit,
	SUM(COALESCE(r.credit,0)) AS credit
	FROM fn.financial_transaction_detail r
LEFT OUTER JOIN fn.financial_transaction ft ON ft.id=r.financial_transaction_id
LEFT OUTER JOIN fn.financial_transaction_type ftt ON ftt .id=ft.transaction_type_id
LEFT OUTER JOIN fn.account a ON a.id=r.account_id

LEFT OUTER JOIN fn.account lv1 ON lv1.id=[fn].[get_parent_account](a.id,1)
LEFT OUTER JOIN fn.account lv2 ON lv2.id=[fn].[get_parent_account](a.id,2)
LEFT OUTER JOIN fn.account lv3 ON lv3.id=[fn].[get_parent_account](a.id,3)
LEFT OUTER JOIN fn.account lv4 ON lv4.account_level=4 AND (lv4.id = [fn].[get_parent_account](a.id,4) OR lv4.id = [fn].[get_parent_account](a.id,5))

WHERE 
COALESCE(r.is_active,0)=1 AND COALESCE(r.is_deleted,0)=0  AND
COALESCE(ft.is_active,0)=1 AND COALESCE(ft.is_locked,0)=1 AND COALESCE(ft.is_deleted,0)=0 
AND a.account_level=5
AND SUBSTRING(a.account_number,0,2)='2'
AND r.legal_entity_id=@p_legal_entity_id
AND ft.transaction_datetime &gt;= @startDate AND  ft.transaction_datetime &lt;= @endDate 
GROUP BY 
lv1.account_number,
	lv1.account_name,
	lv2.account_number,
	lv2.account_name,
	lv3.account_number,
	lv3.account_name,
	lv4.account_number,
	lv4.account_name,
	a.id,
	a.account_number,
	a.account_name
),
CAPITAL AS (
SELECT 
	
	lv1.account_number AS lv1_number,
	lv1.account_name AS lv1_name,
	lv2.account_number AS lv2_number,
	lv2.account_name AS lv2_name,
	lv3.account_number AS lv3_number,
	lv3.account_name AS lv3_name,
	lv4.account_number AS lv4_number,
	lv4.account_name AS lv4_name,
	a.id AS account_id,
	a.account_number,a.account_name,

	SUM(COALESCE(r.debit,0)) AS debit,
	SUM(COALESCE(r.credit,0)) AS credit
	FROM fn.financial_transaction_detail r
LEFT OUTER JOIN fn.financial_transaction ft ON ft.id=r.financial_transaction_id
LEFT OUTER JOIN fn.financial_transaction_type ftt ON ftt .id=ft.transaction_type_id
LEFT OUTER JOIN fn.account a ON a.id=r.account_id

LEFT OUTER JOIN fn.account lv1 ON lv1.id=[fn].[get_parent_account](a.id,1)
LEFT OUTER JOIN fn.account lv2 ON lv2.id=[fn].[get_parent_account](a.id,2)
LEFT OUTER JOIN fn.account lv3 ON lv3.id=[fn].[get_parent_account](a.id,3)
LEFT OUTER JOIN fn.account lv4 ON lv4.account_level=4 AND (lv4.id = [fn].[get_parent_account](a.id,4) OR lv4.id = [fn].[get_parent_account](a.id,5))

WHERE 
COALESCE(r.is_active,0)=1 AND COALESCE(r.is_deleted,0)=0  AND
COALESCE(ft.is_active,0)=1 AND COALESCE(ft.is_locked,0)=1 AND COALESCE(ft.is_deleted,0)=0 
AND a.account_level=5
AND SUBSTRING(a.account_number,0,2)='3'
AND r.legal_entity_id=@p_legal_entity_id
AND ft.transaction_datetime &gt;= @startDate AND  ft.transaction_datetime &lt;= @endDate 
GROUP BY 
lv1.account_number,
	lv1.account_name,
	lv2.account_number,
	lv2.account_name,
	lv3.account_number,
	lv3.account_name,
	lv4.account_number,
	lv4.account_name,
	a.id,
	a.account_number,
	a.account_name
),
REVENUE AS (
SELECT 
	
	lv1.account_number AS lv1_number,
	lv1.account_name AS lv1_name,
	lv2.account_number AS lv2_number,
	lv2.account_name AS lv2_name,
	lv3.account_number AS lv3_number,
	lv3.account_name AS lv3_name,
	lv4.account_number AS lv4_number,
	lv4.account_name AS lv4_name,
	a.id AS account_id,
	a.account_number,a.account_name,

	SUM(COALESCE(r.debit,0)) AS debit,
	SUM(COALESCE(r.credit,0)) AS credit
	FROM fn.financial_transaction_detail r
LEFT OUTER JOIN fn.financial_transaction ft ON ft.id=r.financial_transaction_id
LEFT OUTER JOIN fn.financial_transaction_type ftt ON ftt .id=ft.transaction_type_id
LEFT OUTER JOIN fn.account a ON a.id=r.account_id

LEFT OUTER JOIN fn.account lv1 ON lv1.id=[fn].[get_parent_account](a.id,1)
LEFT OUTER JOIN fn.account lv2 ON lv2.id=[fn].[get_parent_account](a.id,2)
LEFT OUTER JOIN fn.account lv3 ON lv3.id=[fn].[get_parent_account](a.id,3)
LEFT OUTER JOIN fn.account lv4 ON lv4.account_level=4 AND (lv4.id = [fn].[get_parent_account](a.id,4) OR lv4.id = [fn].[get_parent_account](a.id,5))

WHERE 
COALESCE(r.is_active,0)=1 AND COALESCE(r.is_deleted,0)=0  AND
COALESCE(ft.is_active,0)=1 AND COALESCE(ft.is_locked,0)=1 AND COALESCE(ft.is_deleted,0)=0 
AND a.account_level=5
AND SUBSTRING(a.account_number,0,2)='4'
AND r.legal_entity_id=@p_legal_entity_id
AND ft.transaction_datetime &gt;= @startDate AND  ft.transaction_datetime &lt;= @endDate 
GROUP BY 
lv1.account_number,
	lv1.account_name,
	lv2.account_number,
	lv2.account_name,
	lv3.account_number,
	lv3.account_name,
	lv4.account_number,
	lv4.account_name,
	a.id,
	a.account_number,
	a.account_name
),
COB AS (
SELECT 
	
	lv1.account_number AS lv1_number,
	lv1.account_name AS lv1_name,
	lv2.account_number AS lv2_number,
	lv2.account_name AS lv2_name,
	lv3.account_number AS lv3_number,
	lv3.account_name AS lv3_name,
	lv4.account_number AS lv4_number,
	lv4.account_name AS lv4_name,
	a.id AS account_id,
	a.account_number,a.account_name,

	SUM(COALESCE(r.debit,0)) AS debit,
	SUM(COALESCE(r.credit,0)) AS credit
	FROM fn.financial_transaction_detail r
LEFT OUTER JOIN fn.financial_transaction ft ON ft.id=r.financial_transaction_id
LEFT OUTER JOIN fn.financial_transaction_type ftt ON ftt .id=ft.transaction_type_id
LEFT OUTER JOIN fn.account a ON a.id=r.account_id

LEFT OUTER JOIN fn.account lv1 ON lv1.id=[fn].[get_parent_account](a.id,1)
LEFT OUTER JOIN fn.account lv2 ON lv2.id=[fn].[get_parent_account](a.id,2)
LEFT OUTER JOIN fn.account lv3 ON lv3.id=[fn].[get_parent_account](a.id,3)
LEFT OUTER JOIN fn.account lv4 ON lv4.account_level=4 AND (lv4.id = [fn].[get_parent_account](a.id,4) OR lv4.id = [fn].[get_parent_account](a.id,5))

WHERE 
COALESCE(r.is_active,0)=1 AND COALESCE(r.is_deleted,0)=0  AND
COALESCE(ft.is_active,0)=1 AND COALESCE(ft.is_locked,0)=1 AND COALESCE(ft.is_deleted,0)=0 
AND a.account_level=5
AND SUBSTRING(a.account_number,0,2)='5'
AND r.legal_entity_id=@p_legal_entity_id
AND ft.transaction_datetime &gt;= @startDate AND  ft.transaction_datetime &lt;= @endDate 
GROUP BY 
lv1.account_number,
	lv1.account_name,
	lv2.account_number,
	lv2.account_name,
	lv3.account_number,
	lv3.account_name,
	lv4.account_number,
	lv4.account_name,
	a.id,
	a.account_number,
	a.account_name
),
EXPENSES AS (
SELECT 
	
	lv1.account_number AS lv1_number,
	lv1.account_name AS lv1_name,
	lv2.account_number AS lv2_number,
	lv2.account_name AS lv2_name,
	lv3.account_number AS lv3_number,
	lv3.account_name AS lv3_name,
	lv4.account_number AS lv4_number,
	lv4.account_name AS lv4_name,
	a.id AS account_id,
	a.account_number,a.account_name,

	SUM(COALESCE(r.debit,0)) AS debit,
	SUM(COALESCE(r.credit,0)) AS credit
	FROM fn.financial_transaction_detail r
LEFT OUTER JOIN fn.financial_transaction ft ON ft.id=r.financial_transaction_id
LEFT OUTER JOIN fn.financial_transaction_type ftt ON ftt .id=ft.transaction_type_id
LEFT OUTER JOIN fn.account a ON a.id=r.account_id

LEFT OUTER JOIN fn.account lv1 ON lv1.id=[fn].[get_parent_account](a.id,1)
LEFT OUTER JOIN fn.account lv2 ON lv2.id=[fn].[get_parent_account](a.id,2)
LEFT OUTER JOIN fn.account lv3 ON lv3.id=[fn].[get_parent_account](a.id,3)
LEFT OUTER JOIN fn.account lv4 ON lv4.account_level=4 AND (lv4.id = [fn].[get_parent_account](a.id,4) OR lv4.id = [fn].[get_parent_account](a.id,5))

WHERE 
COALESCE(r.is_active,0)=1 AND COALESCE(r.is_deleted,0)=0  AND
COALESCE(ft.is_active,0)=1 AND COALESCE(ft.is_locked,0)=1 AND COALESCE(ft.is_deleted,0)=0 
AND a.account_level=5
AND SUBSTRING(a.account_number,0,2)='6'
AND r.legal_entity_id=@p_legal_entity_id
AND ft.transaction_datetime &gt;= @startDate AND  ft.transaction_datetime &lt;= @endDate 
GROUP BY 
lv1.account_number,
	lv1.account_name,
	lv2.account_number,
	lv2.account_name,
	lv3.account_number,
	lv3.account_name,
	lv4.account_number,
	lv4.account_name,
	a.id,
	a.account_number,
	a.account_name
)

SELECT * FROM ASSETS r
UNION ALL 
SELECT * FROM LIABILITIES r
UNION ALL 
SELECT * FROM CAPITAL r
UNION ALL 
SELECT * FROM REVENUE r
UNION ALL 
SELECT * FROM COB r
UNION ALL 
SELECT * FROM EXPENSES r
ORDER BY 
	r.lv1_number,
	r.lv2_number,
	r.lv3_number,
	r.lv4_number,
	r.account_number

	ASC
</SqlCommand>
