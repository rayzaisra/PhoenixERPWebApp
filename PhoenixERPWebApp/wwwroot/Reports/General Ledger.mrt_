    <DataSources isList="true" count="2">
      <Mutation Ref="3" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
        <Alias>Mutation</Alias>
        <Columns isList="true" count="7">
          <value>t_date,System.DateTime</value>
          <value>transaction_number,System.String</value>
          <value>account_id,System.String</value>
          <value>account_name,System.String</value>
          <value>account_number,System.String</value>
          <value>debit,System.Decimal</value>
          <value>credit,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>Mutation</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="2">
          <value>p_account_id,IIF_x0028_account_id_x003D__x003D__x0022__x0022__x002C__x0022__x0025__x0025__x0022__x002C_account_id_x0029_,12,50</value>
          <value>p_legal_entity_id,legal_entity_id,12,50</value>
        </Parameters>
        <SqlCommand>DECLARE 
@startDate Datetime2(7),
@endDate Datetime2(7);

SELECT TOP(1) 
@startDate = r.start_date, 
@endDate = r.end_date 
FROM [fn].[financial_year] r WHERE r.legal_entity_id='9b3e97e5-dd0a-4cd6-bbcd-ab9e8c9c8035' 
AND r.is_active=1 AND COALESCE(r.is_deleted,0)=0;


SELECT 
	CONVERT(DATE,ft.transaction_datetime) AS t_date,
	ft.transaction_number ,
	r.account_id,
	a.account_name AS account_name,
	a.account_number,
	COALESCE(r.debit,0) AS debit,
	COALESCE(r.credit,0) AS credit
	FROM fn.financial_transaction_detail r
LEFT OUTER JOIN fn.financial_transaction ft ON ft.id=r.financial_transaction_id
LEFT OUTER JOIN fn.financial_transaction_type ftt ON ftt .id=ft.transaction_type_id
LEFT OUTER JOIN fn.account a ON a.id=r.account_id
LEFT OUTER JOIN fn.account lv5 ON lv5.id = [fn].[get_parent_account](a.id,2)
WHERE 
COALESCE(r.is_active,0)=1 AND COALESCE(r.is_deleted,0)=0  AND 
COALESCE(ft.is_active,0)=1 AND COALESCE(ft.is_locked,0)=1 AND COALESCE(ft.is_deleted,0)=0 
AND ftt.transaction_type like '%mutation%' 
AND r.legal_entity_id=@p_legal_entity_id
AND r.account_id like COALESCE(@p_account_id,'%%') 
AND ft.transaction_datetime &gt;= @startDate AND  ft.transaction_datetime &lt;= @endDate 
</SqlCommand>
      </Mutation>
      <BeginingBalance Ref="4" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
        <Alias>BeginingBalance</Alias>
        <Columns isList="true" count="7">
          <value>t_date,System.DateTime</value>
          <value>transaction_number,System.String</value>
          <value>account_id,System.String</value>
          <value>account_name,System.String</value>
          <value>account_number,System.String</value>
          <value>debit,System.Decimal</value>
          <value>credit,System.Decimal</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Name>BeginingBalance</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="2">
          <value>p_account_id,IIF_x0028_account_id_x003D__x003D__x0022__x0022__x002C__x0022__x0025__x0025__x0022__x002C_account_id_x0029_,12,50</value>
          <value>p_legal_entity_id,legal_entity_id,12,50</value>
        </Parameters>
        <SqlCommand>
DECLARE 
@startDate Datetime2(7),
@endDate Datetime2(7);

SELECT TOP(1) 
@startDate = r.start_date, 
@endDate = r.end_date 
FROM [fn].[financial_year] r WHERE r.legal_entity_id='9b3e97e5-dd0a-4cd6-bbcd-ab9e8c9c8035' 
AND r.is_active=1 AND COALESCE(r.is_deleted,0)=0;


WITH BeginingBalance AS (
SELECT  
	r.t_date,
	r.transaction_number ,
	r.account_id ,
	r.account_name,
	r.account_number,
	r.debit,
	r.credit
	FROM (
SELECT 
	CONVERT(DATE,ft.transaction_datetime) AS t_date,
	ft.transaction_number ,
	r.account_id ,
	a.account_name,
	a.account_number,
	COALESCE(r.debit,0) AS debit,
	COALESCE(r.credit,0) AS credit
	FROM fn.financial_transaction_detail r
LEFT OUTER JOIN fn.financial_transaction ft ON ft.id=r.financial_transaction_id
LEFT OUTER JOIN fn.financial_transaction_type ftt ON ftt .id=ft.transaction_type_id
LEFT OUTER JOIN fn.account a ON a.id=r.account_id
LEFT OUTER JOIN fn.account lv5 ON lv5.id = [fn].[get_parent_account](a.id,2)
WHERE 
COALESCE(r.is_active,0)=1 AND COALESCE(r.is_deleted,0)=0  AND
COALESCE(ft.is_active,0)=1 AND COALESCE(ft.is_locked,0)=1 AND COALESCE(ft.is_deleted,0)=0 
AND ftt.transaction_type like '%BEGINNING BALANCE%' 
AND r.account_id LIKE COALESCE(@p_account_id,'%%')
AND r.legal_entity_id=@p_legal_entity_id
AND ft.transaction_datetime &gt;= @startDate AND  ft.transaction_datetime &lt;= @endDate 
) AS r
)
SELECT * FROM BeginingBalance</SqlCommand>
      </BeginingBalance>
